msgstr ""

#: assets_dev/engine/data_tables/items.txt:958
msgid "Warlock's Wand of Paralyzing"
msgstr ""

#: assets_dev/engine/data_tables/items.txt:959
msgid "Warlock's Wand of Clouds"
msgstr ""

#: assets_dev/engine/data_tables/items.txt:96
msgid ""
