msgstr ""

#: assets_dev/worlds/xeen/data_tables/items.txt:93
msgid "Elder Dagger"
msgstr ""

#: assets_dev/worlds/xeen/data_tables/items.txt:94
msgid "Elder Mace"
msgstr ""

#: assets_dev/worlds/xeen/data_tables/items.txt:94
msgid ""
