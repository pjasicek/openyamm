msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:100
msgid "A patch of fallen facing stone where a coat of arms once hung."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:103
msgid "A white tower on blue: the arms of Newcastle. Yours."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:107 assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:109
msgid "To the Newcastle site"
msgstr ""

