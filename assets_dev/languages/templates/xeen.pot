msgstr ""

#: assets_dev/worlds/xeen/data_tables/items.txt:91
msgid ""
"An impossibly light two-handed sword, the King's experiment, buried under Newcastle. It alone can harm Lord Xeen. (Effects: +15 Might, +15 Endurance)"
msgstr ""

#: assets_dev/worlds/xeen/data_tables/items.txt:91
msgid "Xeen Slayer Sword"
msgstr ""

#: assets_dev/worlds/xeen/data_tables/items.txt:92
msgid ""
