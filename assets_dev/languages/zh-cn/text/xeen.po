#: assets_dev/worlds/xeen/data_tables/english/awards.txt:26
msgid "A member of the Drawkcab"
msgstr "倒序僧一员"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:27
msgid "Helped Dreyfus, High Priest of Mok"
msgstr "帮助了莫克大祭司德赖弗斯"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:28
msgid "Disciple of Bark"
msgstr "树皮门徒"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:29
msgid "Royal Taste Tester to Bosco the Dwarf King"
msgstr "矮人王博斯科的御用试吃官"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:3
msgid "Received Vertigo's Outstanding Citizenship Award"
msgstr "获得弗蒂戈镇杰出市民奖"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:30
msgid "Liberated Lakeside"
msgstr "解放了湖畔镇"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:31
msgid "Dubbed Super Explorer by the statue on Cloudreach's highest rock"
msgstr "被云巅最高岩石上的雕像封为超级探险家"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:4
msgid "Received the Red Dwarf Badge of Courage"
msgstr "获得红矮人勇气勋章"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:5
msgid "Dubbed Crusaders by Old Valia of Toad Meadow"
msgstr "被蟾蜍草地的老瓦莉娅封为十字军"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:6
msgid "Master of Golems"
msgstr "魔像之主"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:7
msgid "Cheered Dimitri"
msgstr "让季米特里振作起来"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:8
msgid "Saved the Queen"
msgstr "救出了女王"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:9
msgid "Chosen One"
msgstr "天选之人"

#: assets_dev/worlds/xeen/data_tables/english/place_mon.txt:10
msgid "Mr Wobbles"
msgstr "沃布尔斯先生"

#: assets_dev/worlds/xeen/data_tables/english/place_mon.txt:11
msgid "Mrs Wobbles"
msgstr "沃布尔斯夫人"

#: assets_dev/worlds/xeen/data_tables/english/place_mon.txt:12
msgid "Chief Librarian"
msgstr "首席图书管理员"

#: assets_dev/worlds/xeen/data_tables/english/place_mon.txt:13
msgid "Gong Sentry"
msgstr "守锣卫兵"

#: assets_dev/worlds/xeen/data_tables/english/place_mon.txt:14
msgid "Schoolmistress"
msgstr "女教师"

#: assets_dev/worlds/xeen/data_tables/english/place_mon.txt:15
