#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:74 assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:82
msgid "Werewolf Bed"
msgstr "狼人的床"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:303 assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:305
msgid "Scroll of Fire"
msgstr "火焰卷轴"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:308 assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:310
msgid "Scroll of Electricity"
msgstr "电击卷轴"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:328 assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:330
msgid "Scroll of Weakness"
msgstr "虚弱卷轴"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:37
msgid "Under the straw: 260 gold."
msgstr "稻草下：260 金币。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:41 assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:49 assets_dev/worlds/xeen/events/maps/xeen_xd25.lua:172
#: assets_dev/worlds/xeen/events/maps/xeen_xd25.lua:174
msgid "Straw Bed"
msgstr "稻草床"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:48
msgid "Under the straw: 120 gold."
msgstr "稻草下：120 金币。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:59
msgid "Under the straw: 150 gold."
msgstr "稻草下：150 金币。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:70
msgid "Under the straw: 220 gold."
msgstr "稻草下：220 金币。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:81
msgid "Under the straw: 180 gold."
msgstr "稻草下：180 金币。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:87
msgid "The lever is down. The shut cell stands open."
msgstr "拉杆已拉下。关着的牢房敞开了。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd14.lua:94
msgid ""
"The lever creaks down. Out in the cell row, bars grind up into the ceiling."
msgstr "拉杆吱嘎地拉下。牢房那边，栏杆磨响着升进天花板。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:113
msgid "golux"
msgstr "golux"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:117 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:120 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:123
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:125 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:128 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:130
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:153 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:155
msgid "Stone slab"
msgstr "石板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:119
msgid ""
"The slab grinds up. On this side there is a handle; on the other, none."
msgstr "石板磨响着升起。这一侧有把手；另一侧没有。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:124
msgid "A carved slab with no handle on this side. It does not move."
msgstr "一块雕花石板，这一侧没有把手。它纹丝不动。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:133 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:140
msgid "Crown door"
msgstr "王冠之门"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:135
msgid "A sealed door carved with a crown. It does not move for you."
msgstr "一道刻着王冠的封死的门。它对你们纹丝不动。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:143 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:150
msgid "Door of legends"
msgstr "传奇之门"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:145
msgid ""
"A sealed door carved with a sun over a throne. It does not move for you."
msgstr "一道刻着太阳和王座的封死的门。它对你们纹丝不动。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:15
msgid ""
"Cool air, and the smell of old stone. Somewhere above, something very large breathes once and is still."
msgstr "凉爽的空气，旧石头的气味。上方某处，有什么极其巨大的东西呼吸了一次，又静止了。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:158 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:164
msgid "Veil door"
msgstr "面纱之门"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:160
msgid "A sealed door carved with a veil. It does not move for you."
msgstr "一道刻着面纱的封死的门。它对你们纹丝不动。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:167 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:169 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:172
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:174
msgid "Leave the Sphinx"
msgstr "离开狮身人面像"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:184
msgid "The scribes' lectern is bare."
msgstr "抄写员的讲台是空的。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:189
msgid "Gems: a sunstone on the scribes' lectern, where a book once lay."
msgstr "宝石：抄写员讲台上有一块太阳石，那里曾放着一本书。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:19 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:27
msgid "Book of the Heavens"
msgstr "诸天之书"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:207
msgid "An empty offering niche."
msgstr "一个空的供奉壁龛。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:21 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:32
msgid "The lectern is bare."
msgstr "讲台是空的。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:212
msgid "Gems: an emerald among the offerings."
msgstr "宝石：供品里有一颗祖母绿。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:216 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:219
msgid "Loose panel"
msgstr "松动的嵌板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:218
msgid ""
"The panel with the carved mask gives under your hand and slides up. Behind it, a closet and a throne."
msgstr "带雕刻面具的嵌板在你们手下塌了下去，向上滑开。后面是一间壁橱和一把王座。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:223
msgid ""
"Hieroglyphics. The message reads: You're looking for my name, it's five letters long."
msgstr "象形文字。信息写着：You're looking for my name, it's five letters long."

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:228
msgid ""
"Hieroglyphics. The message reads: I think you'll like my name. Try not to get it wrong."
msgstr "象形文字。信息写着：I think you'll like my name. Try not to get it wrong."

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:245 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:250 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:256
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:266 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:271
msgid "There is nothing in the sarcophagus."
msgstr "石棺里什么也没有。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:26
msgid ""
"Book of the Heavens: a spellbook of Air magic, Starburst. You take it."
msgstr "诸天之书：一本风系魔法书，星爆术。你们拿走了。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:261
msgid "Gems! Somebody hid an amethyst under the wrappings."
msgstr "宝石！有人在裹布下藏了一颗紫水晶。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:276
msgid "Stairs down."
msgstr "向下的楼梯。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:281
msgid "Stairs up."
msgstr "向上的楼梯。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:285 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:293
msgid "Clay tablets"
msgstr "泥板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:287
msgid "Clay tablets, row on row. None of them is about you."
msgstr "泥板，一排又一排。没有一块是关于你们的。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:292
msgid "Gems: a sapphire tucked behind the tablets."
msgstr "宝石：泥板后面塞着一颗蓝宝石。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:296 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:298
msgid "King's throne"
msgstr "国王的王座"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:30 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:38
msgid "Book of the Sun"
msgstr "太阳之书"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:301 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:303
msgid "Throne of legends"
msgstr "传奇王座"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:306 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:308
msgid "Queen's throne"
msgstr "女王的王座"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:311 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:313
msgid "Thieves' throne"
msgstr "盗贼的王座"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:37
msgid ""
"Book of the Sun: a spellbook of Light magic, Divine Intervention. You take it."
msgstr "太阳之书：一本光明魔法书，神圣干预。你们拿走了。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:53
msgid "You aren't strong enough to open the sarcophagus."
msgstr "你们不够强壮，打不开石棺。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:62
msgid "Two flasks of red draught lie on top of the grave goods."
msgstr "两瓶红色药剂放在陪葬品上面。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:177 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:179 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:66
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:68 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:71 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:73
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:76 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:78 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:81
#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:83 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:86 assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:88
msgid "Hieroglyphs"
msgstr "象形文字"

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:67
msgid ""
"Hieroglyphs. The message reads: My first is in giant but not in defiant."
msgstr "象形文字。信息写着：My first is in giant but not in defiant."

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:72
msgid "Hieroglyphs. The message reads: My second is in mole but not in mule."
msgstr "象形文字。信息写着：My second is in mole but not in mule."

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:77
msgid ""
"Hieroglyphs. The message reads: My third is in lich but not in stitch."
msgstr "象形文字。信息写着：My third is in lich but not in stitch."

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:82
msgid ""
"Hieroglyphs. The message reads: My fourth is in guard but not in Girard."
msgstr "象形文字。信息写着：My fourth is in guard but not in Girard."

#: assets_dev/worlds/xeen/events/maps/xeen_xd15.lua:87
msgid "Hieroglyphs. The message reads: My fifth is in XEEN but not in Queen."
msgstr "象形文字。信息写着：My fifth is in XEEN but not in Queen."

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:117 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:132
msgid "Demon skull"
msgstr "恶魔头骨"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:131
msgid ""
"The skull of a demon grins wickedly at you, and you have a sudden desire to smash it.  Destroy?"
msgstr "恶魔的头骨对你们邪恶地咧嘴笑，你们突然很想把它砸烂。摧毁吗？"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:143 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:158
msgid "Devil skull"
msgstr "魔鬼头骨"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:15
msgid ""
"Heat on your face and a red glow far ahead. Behind you, daylight between a demon and a devil of black stone."
msgstr "脸上是热气，远处有红光。你们身后，日光落在一个恶魔和一个魔鬼的黑石像之间。"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:157
msgid ""
"The skull of a devil stares at you as though daring you to damage it.  Destroy?"
msgstr "魔鬼的头骨瞪着你们，仿佛在挑衅你们去破坏它。摧毁吗？"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:179 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:185
msgid "Bare rock"
msgstr "光秃秃的岩石"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:188 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:190
msgid "Leave the Volcano Cave"
msgstr "离开火山洞穴"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:193 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:203 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:245
#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:247
msgid "First slab"
msgstr "第一块石板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:206 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:216 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:258
#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:260
msgid "Second slab"
msgstr "第二块石板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:219 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:229 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:271
#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:273
msgid "Third slab"
msgstr "第三块石板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:232 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:242 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:284
#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:286
msgid "Fourth slab"
msgstr "第四块石板"

#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:246 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:259 assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:272
#: assets_dev/worlds/xeen/events/maps/xeen_xd16.lua:285
msgid "A slab of black rock fills the passage. It does not move for you."
msgstr "一块黑岩石板堵住了通道。它对你们纹丝不动。"

