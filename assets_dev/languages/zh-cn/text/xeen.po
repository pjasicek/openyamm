#: assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:87 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:90
msgid "Roosting rock"
msgstr "栖息石"

#: assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:101 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:124 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:147
#: assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:198 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:221 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:244
#: assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:267 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:290 assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:55
#: assets_dev/worlds/xeen/events/maps/xeen_dd23.lua:78
msgid "You leave the roosting rocks standing."
