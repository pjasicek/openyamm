#: assets_dev/worlds/xeen/events/maps/xeen_xd18.lua:196 assets_dev/worlds/xeen/events/maps/xeen_xd18.lua:198
msgid "Dragon Lore Volume 4"
msgstr "《龙学》第四卷"

#: assets_dev/worlds/xeen/events/maps/xeen_xd18.lua:201 assets_dev/worlds/xeen/events/maps/xeen_xd18.lua:203
