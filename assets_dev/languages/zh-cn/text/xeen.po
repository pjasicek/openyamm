msgstr "救出了罗兰王子"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:17
msgid "Made Xeen One World"
msgstr "使辛恩合为一个世界"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:18
msgid "Dubbed Ghostslayers Extraordinaire by Mayor Randon of Winterkill"
msgstr "被冬杀镇的兰登镇长封为超凡猎鬼者"

#: assets_dev/worlds/xeen/data_tables/english/awards.txt:19
