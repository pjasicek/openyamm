#: assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:54 assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:56
msgid "Command couch"
msgstr "指挥椅"

#: assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:55
msgid "Sheltem's command couch, empty. The harness hangs open."
msgstr "谢尔特姆的指挥椅，空的。束带敞开地挂着。"

#: assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:59 assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:61 assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:64
#: assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:66
msgid "Strange Alien Device"
msgstr "奇怪的外星装置"

#: assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:69 assets_dev/worlds/xeen/events/maps/xeen_dd22.lua:71
