msgstr "否则怎样？"

#: assets_dev/worlds/xeen/events/common/xeen_common.lua:762
msgid "Sky Bandits: \"Pay us 10,000 gold or else!\""
msgstr "天空强盗：“交出 10,000 金币，否则有你们好看！”"

#: assets_dev/worlds/xeen/events/common/xeen_common.lua:763
msgid ""
"Sky Bandits: \"You have invaded our territory. Appease us with 10,000 gold or face our wrath!\""
msgstr "天空强盗：“你们闯进了我们的地盘。拿 10,000 金币来平息我们的怒火，不然就等着挨揍！”"

#: assets_dev/worlds/xeen/events/common/xeen_common.lua:764
msgid "Bow down before us!"
msgstr "在我们面前跪下！"

#: assets_dev/worlds/xeen/events/common/xeen_common.lua:764
msgid "Take our money"
msgstr "拿走我们的钱"

#: assets_dev/worlds/xeen/events/common/xeen_common.lua:765
msgid ""
"Sky Bandits: \"Many apologies, good folks, but this is a robbery. I'm afraid we are going to have to ask you for 10,000 gold.\""
msgstr "天空强盗：“非常抱歉，各位好人，但这是抢劫。恐怕我们得向你们要 10,000 金币。”"

#: assets_dev/worlds/xeen/events/common/xeen_common.lua:766
