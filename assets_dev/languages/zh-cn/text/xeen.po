#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:324 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:326
msgid "Past of the Dragon"
msgstr "龙的过去"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:329 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:331 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:334
#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:336 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:339 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:341
#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:344 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:346
msgid "Ancient Book of the Dragon"
msgstr "龙的远古之书"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:349 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:351 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:354
#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:356 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:359 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:361
msgid "Dragon Power Crystal"
msgstr "龙能水晶"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:364 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:379
msgid "The Eye of the Dragon"
msgstr "龙之眼"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:37 assets_dev/worlds/xeen/events/maps/xeen_x9.lua:39
msgid "Speed booth"
msgstr "速度摊位"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:377
msgid ""
"\"Look into the eye of the Dragon and despair\"\n"
"\"Answer correctly or perish!\""
msgstr ""
"“凝视龙之眼，然后绝望吧”\n"
"“答对，否则就死！”"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:378
msgid "\"What is the secret of the Dragon?\""
msgstr "“龙的秘密是什么？”"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:378
msgid "Infinite"
msgstr "Infinite"

#: assets_dev/worlds/xeen/events/maps/xeen_x9.lua:378
