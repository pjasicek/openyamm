#: assets_dev/worlds/xeen/data_tables/npc.txt:105 assets_dev/worlds/xeen/data_tables/npc.txt:375 assets_dev/worlds/xeen/data_tables/npc.txt:81
#: assets_dev/worlds/xeen/data_tables/npc.txt:82
msgid "Fisherman"
