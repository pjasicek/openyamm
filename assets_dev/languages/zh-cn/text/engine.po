#: assets_dev/engine/data_tables/items.txt:2067 assets_dev/engine/data_tables/items.txt:2068 assets_dev/engine/data_tables/items.txt:2069
#: assets_dev/engine/data_tables/items.txt:626 assets_dev/engine/data_tables/items.txt:627 assets_dev/engine/data_tables/items.txt:628
msgid "Gem"
msgstr "宝石"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:626
msgid "Gem of Restoration"
msgstr "恢复宝石"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:626
msgid ""
"Quest Item: This large ruby is of perfect quality, clear throughout with an even pigeon blood red. It contains a powerful enchantment and pulses with a slumbering heartbeat rhythm."
msgstr "任务物品：这个巨大的红宝石毫无瑕疵，显现出一种纯净的鸽血颜色。里面隐藏着一个强大的法术，让整个红宝石也跟着如同心脏一般的脉动。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:627
msgid "Charged connector stone"
msgstr "充能连接石"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:627
msgid "Smooth half-transparent connector stone charged by time traveling."
msgstr "随着时间的流逝，这光滑而半透明的连接石充入了能量。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:628
msgid "Connector stone"
msgstr "连接石"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:628
msgid "Smooth stone without specific color."
msgstr "没有特定颜色的光滑的石头。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:629
msgid ""
"Quest Item: The writing inside this book reads like the ranting of a madman. Still, someone must have thought highly of it. The text is entirely hand scribed in a florid style. Inset illuminations bring to life scenes from the story which are, in turn, disturbing, outlandish or seemingly drawn from nightmare."
msgstr ""
"任务物品：这本书里面的记载看起来像是疯子的呓语一般。但依旧有人很重视这本书。书的文字内容是利用一种相当流畅的文句和娟秀的字体所写成的。里面的插画也让整个仿佛从恶梦中描述出来的场景和奇特故事变得栩栩如生。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:63
msgid ""
"Dark Elven bowsmiths have discovered that unusual characteristics of the Kreegan spinal column make it the best material for heavy bowstaves. A clever arrangement of composite pulleys make it possible for those of less than superhuman strength to pull these mighty weapons."
msgstr ""
"黑暗精灵的制弓工匠发现了克里根人的脊椎拥有不寻常的特性，最适合用来制作重型长弓的弓身。在额外增加了一些滑轮之后，即使是不具超人力量的使用者也可以拉开弓弦。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:63
msgid "Devilbone Bow"
msgstr "恶魔骨弓"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:630
msgid ""
"Quest Item: The remains of Korbu who some claim was the most powerful vampire of all times. He's not much to look at now, however. His skeleton has been almost completely dismantled--either by design or the ravages of time, and a wooden stake is nestled entirely within the ribcage."
msgstr ""
"任务物品：这是史上最伟大吸血鬼可布的骨骸。不过，他现在看起来可不怎么样。他的尸骨已经完全的被拆散了，这可能是岁月的蹂躏或是后人刻意的安排。它的胸骨上还牢牢的定着一根白木桩。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:630
msgid "Remains"
msgstr "尸骸"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:630
msgid "Remains of Korbu"
msgstr "可布的尸骸"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:1406 assets_dev/engine/data_tables/items.txt:1420 assets_dev/engine/data_tables/items.txt:1433
#: assets_dev/engine/data_tables/items.txt:631
msgid "Jar"
msgstr "坛子"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:1406 assets_dev/engine/data_tables/items.txt:1420 assets_dev/engine/data_tables/items.txt:631
msgid "Lich Jar"
msgstr "巫妖之瓶"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:631
msgid "Quest Item: A well made jar."
msgstr "任务物品：一个制作的相当好的瓶子。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:632
msgid ""
"Quest Item: Both the keys and ring are made of a metal you've never encountered before. The gemstones inset in the key heads are familiar to you. They are elemental heartstones like those incorporated in the conflux key Xanthor made for you."
msgstr ""
"任务物品：这柄钥匙和钥匙环都是用你以前从来没有看过的金属所制作的。镶嵌在钥匙上的宝石看起来相当的眼熟。它们原来就是萨索尔安装在汇流钥匙上的同类元素宝石。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:632
msgid "Ring of Keys"
msgstr "钥匙环"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:633
msgid "Idol"
msgstr "圣像"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:633
msgid "Idol of the Snake"
msgstr "蛇之圣像"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:633
msgid ""
"Quest Item: An Idol of the ancient snake god who was worshipped by the Serpentmen who used to dwell on the Dagger Wound Islands."
msgstr "任务物品：古老的蛇神圣像是曾经居住在匕伤岛上的蛇人所膜拜的对象。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:634
msgid "Big Brass Ring"
msgstr "巨型铜戒指"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:634
msgid ""
"Quest Item: A large ring of polished brass. It seems to be part of a door knocker."
msgstr "任务物品：这是个打磨光亮的黄铜环，看起来似乎是个门环。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:635
msgid "Hide"
msgstr "皮"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:635
msgid "Naga Hide"
msgstr "蛇女皮"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:635
msgid "The skinned and scraped hide of a naga."
msgstr "剥下来，经过打磨的半蛇女的皮。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:636
msgid "Dire Wolf Pelt"
msgstr "猛狼皮"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:636
msgid "Pelt"
msgstr "皮"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:636
msgid "The skinned and scraped hide of a dire wolf."
msgstr "拨下来，经过打磨的猛狼皮。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:2101 assets_dev/engine/data_tables/items.txt:637
msgid "Flute"
msgstr "长笛"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:637
msgid "Quest Item: A well crafted instrument."
msgstr "任务物品：一个制作精巧的乐器。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:638
msgid "A jar of royal wasp jelly."
msgstr "一瓶蜂王浆。"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:638
msgid "Jelly"
msgstr "胶状物"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:639
msgid "Dragonbane Flower"
msgstr "灭龙花"

# imported from packs (base v1.21)
#: assets_dev/engine/data_tables/items.txt:639
msgid "Quest Item: A fresh dragonbane flower. The petals are thick and waxy."
