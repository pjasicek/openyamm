# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:113 assets_dev/engine/data_tables/spells.txt:112
msgid ""
"This ability strikes its target blind. Affected creatures cannot perform missile attacks or cast spells, and wander aimlessly until the effect wears off."
msgstr ""
"Cette aptitude aveugle sa cible. Les créatures affectées ne peuvent jeter ni projectile, ni sort. Elles errent sans but jusqu’à dissipation de l’effet."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:114 assets_dev/engine/data_tables/spells.txt:113
msgid "Darkfire"
msgstr "Flèche de l’ombre"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:114 assets_dev/engine/data_tables/spells.txt:113
