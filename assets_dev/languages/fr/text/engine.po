msgstr "Jarre de liche"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:631
msgid "Quest Item: A well made jar."
msgstr "Objet de quête : jarre de bonne qualité."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:632
msgid ""
"Quest Item: Both the keys and ring are made of a metal you've never encountered before. The gemstones inset in the key heads are familiar to you. They are elemental heartstones like those incorporated in the conflux key Xanthor made for you."
msgstr ""
"Objet de quête : les clés et l’anneau sont constitués d’un métal qui vous est inconnu. Par contre, les gemmes incrustées dans la tête des clés vous sont familières. Ce sont des cœurs de gemme élémentaires comme ceux incorporés dans la Clé de la confluence fabriquée par Xanthor."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:632
msgid "Ring of Keys"
msgstr "Anneau de clés"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:633
msgid "Idol"
msgstr "Idole"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:633
msgid "Idol of the Snake"
msgstr "Idole du serpent"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:633
msgid ""
"Quest Item: An Idol of the ancient snake god who was worshipped by the Serpentmen who used to dwell on the Dagger Wound Islands."
msgstr ""
"Objet de quête : idole du dieu-serpent antique vénéré par les hommes-serpents, jadis habitants des îles de la Plaie de la Dague."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:634
msgid "Big Brass Ring"
msgstr "Grand anneau de cuivre"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:634
msgid ""
"Quest Item: A large ring of polished brass. It seems to be part of a door knocker."
msgstr ""
"Objet de quête : grand anneau de cuivre poli. Il semble faire partie d’un heurtoir."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:635
msgid "Hide"
msgstr "Cuir"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:635
