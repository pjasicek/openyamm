#: assets_dev/engine/events/Global.lua:4366
msgid ""
"Thanks for the cure! Be sure to deliver scrolls to those who still suffer from the Yellow Fever."
msgstr ""
"Merci pour le remède ! Faites bien en sorte de donner des parchemins aux personnes encore atteintes de la Fièvre jaune."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:1681 assets_dev/engine/events/Global.lua:4130 assets_dev/engine/events/Global.lua:4178
