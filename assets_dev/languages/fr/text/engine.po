#: assets_dev/engine/data_tables/items.txt:607
msgid ""
"Quest Item: This brazier emanates the unsettling vibrancy of dark magic. It smells strongly of pitch and sulfur."
msgstr ""
"Objet de quête : ce brasero émet l’éclat troublant de la magie de l’Ombre. Il dégage une forte odeur de poix et de soufre."

# imported from FR (MMMerge localization)
