#: assets_dev/engine/data_tables/town_portal_switch.txt:12
msgid "City of Steadwick"
msgstr "Cité de Steadwick"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/town_portal_switch.txt:13
msgid "Nighon"
msgstr "Nighon"

