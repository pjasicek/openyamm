# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1428
msgid "Roland Ironfist Painting"
msgstr "Portrait de Roland Ironfist"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1429
msgid ""
"Quest Item:  This small, porcelain vase has been etched with the inscription, \"To Lord Markham, for a great job in the war, Queen Catherine.\""
msgstr ""
"Objet de la Quête : ce petit vase de porcelaine est gravé de l'inscription \"Pour le Seigneur Markham en souvenir de ses exploits durant la guerre, Reine Catherine.\""

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1429
