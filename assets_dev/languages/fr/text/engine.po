msgid "Golem part"
msgstr "Elément de Golem"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1444
msgid ""
"Quest Item:  The broad torso of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : c'est le torse viril d'un puissant golem. Il faudra sans doute le réassembler avant qu'il ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1445
msgid "Abbey Normal Golem Head"
msgstr "Tête de Golem d'Abbaye Normale"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1445
msgid ""
"Quest Item:  The dented head of a mighty golem.  It looks a little…strange.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : la tête féroce d'un puissant golem. L'aspect en est un peu étrange. Il faudra sans doute la réassembler avant qu'elle ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1446
msgid "Golem head"
msgstr "Tête de Golem"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1446
msgid ""
"Quest Item:  The proud head of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : la tête fière d'un puissant golem. Il faudra sans doute la réassembler avant qu'elle ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1447
msgid "Golem left leg"
msgstr "Jambe gauche de Golem"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1447
msgid ""
"Quest Item:  The massive left leg of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : la jambe gauche trapue d'un puissant golem. Il faudra sans doute la réassembler avant qu'elle ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1448
msgid "Golem right leg"
msgstr "Jambe droite de Golem"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1448
msgid ""
"Quest Item:  The massive right leg of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : la jambe droite trapue d'un puissant golem. Il faudra sans doute la réassembler avant qu'elle ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1449
msgid "Golem right arm"
msgstr "Bras droit de Golem"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1449
msgid ""
"Quest Item:  The powerful right arm of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : le puissant bras droit d'un imposant golem. Il faudra sans doute le réassembler avant qu'il ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:145
msgid "Necromantic Ring"
msgstr "Anneau nécromancien"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:145
msgid ""
"Though made of semi-precious silver, this ring is highly valuable because it is well suited to holding enchantments of medium power."
msgstr ""
"Bien qu’en argent semi-précieux, cet anneau a une grande valeur car il peut détenir des enchantements de puissance moyenne."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1450
msgid "Golem left arm"
msgstr "Bras gauche de Golem"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1450
msgid ""
"Quest Item:  The powerful left arm of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Objet de la Quête : le puissant bras gauche d'un imposant golem. Il faudra sans doute le réassembler avant qu'il ne soit vraiment efficace."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1451
msgid ""
"This flawless horseshoe is made of silver.  To use, pick the horseshoe up and right-click over a character's portrait."
msgstr ""
"Ce fer à cheval parfait est d'argent. Pour l'utiliser, prenez-le et cliquez avec le bouton droit de la souris sur le portrait de votre personnage."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1452
msgid "Dragon Egg"
msgstr "Œuf de Dragon"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1452
msgid ""
"Quest Item:  Rough, leathery, and strangely warm, this egg appears nearly ready to hatch."
msgstr "Objet de la Quête : cet œuf imposant semble prêt à éclore."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid "Lantern"
msgstr "Lanterne"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid "Lantern of Light"
msgstr "Lanterne de Lumière"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid ""
"Quest Item:  This lantern shines with a faint, holy light, though no flame appears to be lit inside."
msgstr ""
"Objet de la Quête : cette lanterne luit d'une faible et sainte lueur quoique aucune flamme ne semble brûler à l'intérieur."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1454
msgid ""
"Quest Item:  This belt is worn to the point where it should only last about an hour.  Hopefully, that will be long enough."
msgstr ""
"Objet de la Quête : cette ceinture a été portée au point qu'elle ne paraît pas pouvoir survivre plus d'une heure. Mais, au fond, cela devrait suffire."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1454
msgid "Worn Belt"
msgstr "Ceinture Usagée"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1455
msgid ""
"A strangely shaped small building finely crafted inside a glass bottle.  Something about the bottle beckons you inside.  To use, pick the bottle up and click over the picture of your character in the inventory screen."
msgstr ""
"Une petite construction à la forme étrange est subtilement enchâssée dans cette bouteille de verre. Elle possède un étrange pouvoir de fascination. Pour l'utiliser, prenez-la et cliquez avec le bouton droit de la souris sur le portrait de votre personnage."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1455
msgid "Temple in a Bottle"
msgstr "Temple dans une Bouteille"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid "Arcomage Deck"
msgstr "Jeu d'ArcoMage"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid "Deck"
msgstr "Cartes"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid ""
"Quest Item: A deck of fancifully drawn cards used for a popular card game."
msgstr ""
"Objet de la Quête : c'est un joli jeu de cartes utilisé pour des parties d'ArcoMage."

