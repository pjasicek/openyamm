# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:138 assets_dev/engine/data_tables/spells.txt:137
msgid ""
"This ability allows a Dragon to push back opponents with wing generated wind--great for pushing them back before hitting them with a Flame Blast."
msgstr ""
"Cette aptitude permet à un dragon de repousser des adversaires à l’aide du vent généré par un coup d’aile. Elle est idéale pour les repousser avant de les frapper d’une Boule de flammes."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:138 assets_dev/engine/data_tables/spells.txt:137
msgid "Wing Buffet"
msgstr "Coup d’aile"

