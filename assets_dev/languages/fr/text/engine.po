msgstr "Jobber"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic_text.txt:1047 assets_dev/engine/events/Global.lua:4504
msgid ""
"Master Jobber can instruct students of the Dagger to Mastery.\n"
"He lives in the city of Ravenshore."
msgstr ""
"Le maître Jobber peut amener les élèves de la dague jusqu’au niveau de maître.\n"
"Il vit dans la ville de Ravenshore."

# kept in English: a proper name, as the language's MMMerge translation keeps it
#: assets_dev/engine/data_tables/npc.txt:128 assets_dev/engine/data_tables/npc_topic.txt:429 assets_dev/engine/events/Global.lua:4508
