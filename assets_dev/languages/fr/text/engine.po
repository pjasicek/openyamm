msgid "Ring"
msgstr "Anneau"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1405 assets_dev/engine/data_tables/npc_topic.txt:838 assets_dev/engine/data_tables/npc_topic.txt:839
msgid "Heart of the Wood"
msgstr "Cœur de la Forêt"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1405
msgid "Quest Item:  A jewel like none you have ever seen."
msgstr "Objet de la Quête : un joyau comme vous n'en avez jamais vu."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1406
msgid ""
"Quest Item:  A jar holding your physical and spiritual essence.  Don't lose the jar."
msgstr ""
"Objet de la Quête : une jarre contenant votre essence physique et spirituelle. Ne la perdez pas."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1407
msgid "Case of Jars"
msgstr "Caisse de Jarres"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1407
msgid "Case of Soul Jars"
msgstr "Caisse de Jarres de Liche"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1407
msgid ""
"Quest Item:  A rosewood case lovingly crafted to contain a set of Lich Jars.  This case appears to be full."
msgstr ""
"Objet de la Quête : un coffret de bois de rose amoureusement conçu pour contenir des jarres de liche. Il paraît plein."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1408
msgid "Parson's Quill"
msgstr "Plume de Parson"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1408
msgid ""
"Quest Item:  King Parson's hand employed this quill to sign the treaty ending the first Timber War."
msgstr ""
"Objet de la Quête : le roi Parson a signé le traité concluant la Guerre du Bois avec cette plume."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1408
msgid "Quill"
msgstr "Plume"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1409
msgid ""
"Quest Item:  This environmental suit handles not only respiration, but protection from the extreme pressure of deep sea diving.  It does not look like any other items may be worn while wearing the suit.  You must remove ALL equipment to wear the suit."
msgstr ""
"Objet de la Quête : cette combinaison permet de respirer sous l'eau en protégeant contre les pressions à basse profondeur. Il ne semble pas qu'on puisse porter cette combinaison avec d'autres objets, vous devez abandonner tout équipement pour porter cette tenue."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1409
msgid "Strange Suit"
msgstr "Costume étrange"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1409
msgid "Wetsuit"
msgstr "Combinaison de Plongée"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:141
msgid ""
"A ring of soft gold rendered with half-hearted craftsmanship as a means of conveniently carrying a small amount of wealth."
msgstr ""
"Anneau d’or tendre de fabrication sommaire ; moyen pratique de porter une maigre richesse."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:141
msgid "Gold Ring"
msgstr "Anneau d’or"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1410
msgid "Ancient Part"
msgstr "Objet Ancien"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1410
msgid "Oscillation Overthruster"
msgstr "Surchargeur d'Oscillation"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1410
msgid ""
"Quest Item:  This device has no visible symbols or parts.  Why it is so valuable is beyond your comprehension."
msgstr ""
"Objet de la Quête : cet objet n'a pas de marque ni de caractéristique notable, vous ne comprendrez jamais pourquoi il vaut autant."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1411
msgid ""
"Quest Item:  A highly stylized 'D' and 'P' intertwined by a snake with a crown above its head are engraved into the face of this ring.  This must certainly be Davrick's."
msgstr ""
"Objet de la Quête : deux lettres finement ouvragées mêlées à un serpent couronné sont gravées sur cet anneau. Il s'agit probablement de l'anneau de Davrick."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1411
msgid "Signet Ring"
msgstr "Chevalière"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1412
msgid "Letter from Johann Kerrid to the Faerie King"
msgstr "Lettre de Johann Kerrid au Roi des Fées"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1412
msgid ""
"Quest Item:  A letter from Johann Kerrid to the Faerie King.  Opening a sealed letter is in the poorest of taste, and would be frowned upon by both parties."
msgstr ""
"Objet de la Quête : c'est une lettre de Johann Kerrid au roi des Fées. Ouvrir une lettre scellée est du pire mauvais goût et pourrait indisposer l'expéditeur comme le destinataire."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1413 assets_dev/engine/data_tables/items.txt:1414 assets_dev/engine/data_tables/items.txt:1415
#: assets_dev/engine/data_tables/items.txt:1416 assets_dev/engine/data_tables/items.txt:1417 assets_dev/engine/data_tables/items.txt:1418
msgid "A sealed letter."
msgstr "Lettre cachetée."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1413
msgid "Sealed Letter 2"
msgstr "Lettre Cachetée 2"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1414
msgid "Sealed Letter 3"
msgstr "Lettre Cachetée 3"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1415
msgid "Sealed Letter 4"
msgstr "Lettre Cachetée 4"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1416
msgid "Sealed Letter 5"
msgstr "Lettre Cachetée 5"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1417
msgid "Sealed Letter 6"
msgstr "Lettre Cachetée 6"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1418
msgid "Sealed Letter 7"
msgstr "Lettre Cachetée 7"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1419
msgid "Letter from Norbert Thrush to Lord Markham"
msgstr "Lettre de Norbert Thrush au Seigneur Markham"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1419
msgid ""
"Quest Item:  A letter from Norbert Thrush to Lord Markham.  Opening a sealed letter is in the poorest of taste, and would be frowned upon by both parties."
msgstr ""
"Objet de la Quête : c'est une lettre de Norbert Thrush au Seigneur Markham. Ouvrir une lettre cachetée est du pire mauvais goûte et pourrait fâcher l'expéditeur comme le destinataire."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:142
msgid "A silver ring set with a good quality pearl."
msgstr "Anneau d’argent incrusté d’une perle de bonne qualité."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:142 assets_dev/engine/data_tables/items.txt:926
msgid "Pearl Ring"
msgstr "Anneau de perle"

# imported from FR (MMMerge localization)
