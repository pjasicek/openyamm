#: assets_dev/engine/data_tables/items.txt:608
msgid ""
"Quest Item: This Dragon egg is nearly ready to hatch. The small life inside makes its presence known with an occasional rustle."
msgstr ""
"Objet de quête : cet œuf de dragon est prêt à éclore. A l’intérieur, la petite vie se manifeste par un bruissement occasionnel."

# imported from FR (MMMerge localization)
