#: assets_dev/engine/data_tables/npc_topic.txt:95 assets_dev/engine/data_tables/npc_topic.txt:96 assets_dev/engine/events/Global.lua:1096
#: assets_dev/engine/events/Global.lua:1366 assets_dev/engine/events/Global.lua:1370 assets_dev/engine/events/Global.lua:1374
#: assets_dev/engine/events/Global.lua:2866 assets_dev/engine/events/Global.lua:2905 assets_dev/engine/events/Global.lua:419
#: assets_dev/engine/events/Global.lua:423
msgid "Thanks for your help!"
msgstr "Merci pour votre aide !"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic_text.txt:145 assets_dev/engine/events/Global.lua:420
msgid ""
"Thanks again for your assistance with the Basilisk curse!\n"
"Hurry back to Alvar!\n"
"We must do what we can to save Jadame."
msgstr ""
"Merci encore de m’avoir aidée à combattre la Malédiction des basilics !\n"
"Regagnez vite Alvar !\n"
"Nous devons faire notre possible pour sauver Jadame."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:148 assets_dev/engine/events/Global.lua:424
msgid ""
"Thanks for finding our Ancient Home, once the treat to Jadame has been handled we can begin to move there!"
msgstr ""
"Merci d’avoir retrouvé notre Ancienne demeure. Dès que la menace qui plane sur Jadame sera écartée, nous nous rendrons là-bas !"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:41 assets_dev/engine/events/Global.lua:427
msgid "Ancient Home"
msgstr "Ancienne demeure"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:149 assets_dev/engine/events/Global.lua:428
msgid ""
"Have you found the Ancient Home for our Clan?\n"
"Without its location, my people will surely perish!"
msgstr ""
"Avez-vous retrouvé l’Ancienne demeure de notre clan ? Sans elle, notre peuple périra à coup sûr !"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:7 assets_dev/engine/events/Global.lua:43
msgid "Caravan"
msgstr "Caravane"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic.txt:300 assets_dev/engine/events/Global.lua:4409
msgid "Rothnax"
msgstr "Rothnax"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:1700 assets_dev/engine/events/Global.lua:4410
msgid ""
"My brother Rohtnax lives!\n"
"And you have repaired the Portals of Stone?\n"
"I must return home to him, so that we can plan our family's survival!"
msgstr ""
"Mon frère Rohtnax est vivant ! Et vous avez réparé les Portes de pierre ? Je dois retourner chez nous pour que nous organisions la survie de notre famille !"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:301 assets_dev/engine/events/Global.lua:4416
msgid "Thank you again!"
msgstr "Merci encore !"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:42 assets_dev/engine/events/Global.lua:442
msgid "Deliver Report"
msgstr "Livrer rapport"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:151 assets_dev/engine/events/Global.lua:443
msgid ""
"Disaster in Dagger Wound, too? This is indeed disturbing. If one were to believe all the rumors, one would think that all of Jadame is in upheaval and chaos.I wish I knew more. I rely on our caravan masters for news, but all who were supposed to arrive here this month have not. What I do hear, troubles me. Hurricanes, floods, and now a volcano! The worst I've heard is that a sea of fire has appeared in the Ironsand Desert--and this from many sources.I wonder if this crystal in Ravenshore has something to do with it. Its appearance at the onset of the calamity seems to be more than a coincidence."
msgstr ""
"Une catastrophe également à la Plaie de la Dague ? C’est vraiment inquiétant. Si l’on devait croire toutes les rumeurs, on pourrait penser que Jadame tout entier est en proie au chaos et à l’agitation.  J’aimerais en savoir plus. Je compte sur nos maîtres de caravane pour avoir des nouvelles mais tous ceux qui devaient arriver ce mois-ci ne sont pas là. Ce que j’entends m’inquiète. Des ouragans, des inondations et, à présent, un volcan ! Mais le pire reste encore cette histoire de mer de feu apparue dans le Désert du sable de fer qui m’a été rapportée à maintes reprises.  Je me demande si ce cristal apparu à Ravenshore a un rapport avec ce phénomène. Son apparition qui a précédé cette série de catastrophes semble être plus qu’une simple coïncidence."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:302 assets_dev/engine/events/Global.lua:4430
msgid "Report!"
msgstr "Rapport !"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic_text.txt:1744 assets_dev/engine/events/Global.lua:4431
msgid ""
"You're new aren't you?\n"
"Tell Arion Hunter that I expect more of his rabble than the likes of you!\n"
"Give me the reports and leave my sight!\n"
"You make me sick!"
msgstr ""
"Vous êtes nouveaux, n’est-ce pas ?\n"
"Dites à Arion Hunter que j’attends mieux de sa racaille que des gens de votre espèce !\n"
"Donnez-moi les rapports et disparaissez de ma vue !\n"
"Vous me dégoûtez !"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:303 assets_dev/engine/events/Global.lua:4460
msgid "Fate of Jadame"
msgstr "Destin de Jadame"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic_text.txt:1760 assets_dev/engine/events/Global.lua:4462
msgid ""
"Who knows the fate of Jadame now.\n"
"Perhaps you will find a way to save us from destruction?"
msgstr ""
"Qui sait quel sera désormais le destin de Jadame ?\n"
"Peut-être trouverez-vous un moyen de nous sauver de la destruction ?"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic_text.txt:1762 assets_dev/engine/events/Global.lua:4465
msgid ""
"Jadame owes you a great debt!\n"
"You have saved the entire world from total destruction!"
msgstr ""
"Jadame vous doit beaucoup !\n"
"Vous avez sauvé le monde entier d’une destruction totale !"

