msgstr "Arbalète légère"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:640
msgid "Bone of Doom"
msgstr "Os du destin"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:640
msgid ""
"Quest Item: The arm bone of the legendary necromancer, Zacharia. It is infused with the death magician's evil energy."
msgstr ""
"Objet de quête : os du bras du nécromancien légendaire, Zacharia. Il est imprégné de l’énergie maléfique du magicien de la mort."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:641
msgid ""
"A legendary item rumored to be from the time of the Ancients.  Only someone with the power of a Grand Druid can wear this item."
msgstr ""
"Objet légendaire, on raconte qu’il date du temps des Anciens. Seule une personne au pouvoir d’un grand druide peut porter cet objet."

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:641
msgid "Circlet"
msgstr "Couronne"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:641
msgid "Druid Circlet of Power"
msgstr "Couronne de pouvoir des druides"

# imported from FR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:642
