# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:12
msgid ""
"That is the god they worship.  They believe everyone gets reincarnated as geese."
msgstr ""
"C'est le dieu qu'ils vénèrent. Ils croient que tout le monde se réincarne en oie."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:12
msgid "Who is The Great Honk?"
msgstr "Qui est le Grand Honk ?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:13
msgid "Do you have any interesting news?"
msgstr "Avez-vous des nouvelles intéressantes ?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:13
msgid ""
"I've heard that the Honkies are getting to be a real problem in Thronheim."
msgstr "On dit que les Honkies deviennent un vrai problème à Thronheim."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:5
