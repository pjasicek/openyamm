#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:345
msgid "Have a look around!"
msgstr "Jetez un coup d'œil !"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:1
