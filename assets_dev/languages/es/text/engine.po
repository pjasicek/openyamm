#: assets_dev/engine/data_tables/npc_topic.txt:1763 assets_dev/engine/data_tables/npc_topic.txt:1764 assets_dev/engine/data_tables/npc_topic.txt:1765
#: assets_dev/engine/data_tables/npc_topic.txt:1766 assets_dev/engine/data_tables/npc_topic.txt:1767 assets_dev/engine/data_tables/npc_topic.txt:1768
