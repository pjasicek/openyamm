# machine translation (Claude), review
#: assets_dev/engine/data_tables/npc_topic_text.txt:145 assets_dev/engine/events/Global.lua:420
msgid ""
"Thanks again for your assistance with the Basilisk curse!\n"
"Hurry back to Alvar!\n"
"We must do what we can to save Jadame."
msgstr ""
"¡Gracias otra vez por vuestra ayuda con la maldición del Basilisco!\n"
"¡Volved rápido a Alvar!\n"
"Debemos hacer lo que esté en nuestras manos para salvar Jadame."

# imported from SP (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:148 assets_dev/engine/events/Global.lua:424
msgid ""
"Thanks for finding our Ancient Home, once the treat to Jadame has been handled we can begin to move there!"
msgstr ""
"Gracias por encontrar nuestro Hogar Ancestral, una vez hayamos tratado el futuro de Jadame, podemos empezar a trasladarnos allí."

# imported from SP (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic.txt:41 assets_dev/engine/events/Global.lua:427
msgid "Ancient Home"
msgstr "Hogar Ancestral"

# imported from SP (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:149 assets_dev/engine/events/Global.lua:428
msgid ""
"Have you found the Ancient Home for our Clan?\n"
"Without its location, my people will surely perish!"
msgstr ""
"¿Habéis encontrado el Hogar Ancestral para nuestro clan? Si no lo encontramos, mi pueblo morirá con toda seguridad."

