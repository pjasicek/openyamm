# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1405
msgid "Quest Item:  A jewel like none you have ever seen."
msgstr "Objeto de misión: Una joya como ninguna que hayáis visto jamás."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1406
msgid ""
"Quest Item:  A jar holding your physical and spiritual essence.  Don't lose the jar."
msgstr ""
"Objeto de misión: Un frasco que contiene vuestra esencia física y espiritual. No perdáis el frasco."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1407
msgid "Case of Jars"
msgstr "Caja de Frascos"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1407
msgid "Case of Soul Jars"
msgstr "Caja de Frascos de Almas"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1407
msgid ""
"Quest Item:  A rosewood case lovingly crafted to contain a set of Lich Jars.  This case appears to be full."
msgstr ""
"Objeto de misión: Una caja de palisandro elaborada con mimo para guardar un juego de Frascos de Liche. La caja parece estar llena."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1408
msgid "Parson's Quill"
msgstr "Pluma de Parson"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1408
msgid ""
"Quest Item:  King Parson's hand employed this quill to sign the treaty ending the first Timber War."
msgstr ""
"Objeto de misión: La mano del rey Parson usó esta pluma para firmar el tratado que puso fin a la primera Guerra de la Madera."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1408
msgid "Quill"
msgstr "Pluma"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1409
msgid ""
"Quest Item:  This environmental suit handles not only respiration, but protection from the extreme pressure of deep sea diving.  It does not look like any other items may be worn while wearing the suit.  You must remove ALL equipment to wear the suit."
msgstr ""
"Objeto de misión: Este traje no solo permite respirar, sino que también protege de la presión extrema del buceo en aguas profundas. No parece que se pueda llevar ningún otro objeto con el traje puesto. Debéis quitaros TODO el equipo para poneros el traje."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1409
msgid "Strange Suit"
msgstr "Traje Extraño"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1409
msgid "Wetsuit"
msgstr "Traje de Neopreno"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:141
msgid ""
"A ring of soft gold rendered with half-hearted craftsmanship as a means of conveniently carrying a small amount of wealth."
msgstr ""
"Un anillo de oro blando, hecho sin mucho esmero, como forma cómoda de llevar encima una pequeña cantidad de riqueza."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:141
msgid "Gold Ring"
msgstr "Anillo de Oro"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1410
msgid "Ancient Part"
msgstr "Pieza Antigua"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1410
msgid "Oscillation Overthruster"
msgstr "Amplificador de Oscilaciones"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1410
msgid ""
"Quest Item:  This device has no visible symbols or parts.  Why it is so valuable is beyond your comprehension."
msgstr ""
"Objeto de misión: Este aparato no tiene símbolos ni piezas visibles. Por qué es tan valioso escapa a vuestra comprensión."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1411
msgid ""
"Quest Item:  A highly stylized 'D' and 'P' intertwined by a snake with a crown above its head are engraved into the face of this ring.  This must certainly be Davrick's."
msgstr ""
"Objeto de misión: En la cara de este anillo hay grabadas una 'D' y una 'P' muy estilizadas, entrelazadas por una serpiente con una corona sobre la cabeza. Sin duda debe de ser de Davrick."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1411
