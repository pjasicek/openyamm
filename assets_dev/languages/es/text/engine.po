#: assets_dev/engine/data_tables/items.txt:540
msgid "Berserker Belt"
msgstr "Cinturón del Berserker"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:540
msgid "Relic Belt"
msgstr "Cinturón Reliquia"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:541
msgid "Special Mace"
msgstr "Maza Especial"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:541
msgid ""
"Though at first it appears to be the same type of mace carried by Sun Temple clerics everywhere, this item seems to thrum with conflicting energies."
msgstr ""
"Aunque a primera vista parece el mismo tipo de maza que llevan los clérigos del Templo del Sol en todas partes, este objeto parece vibrar con energías contrapuestas."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:542
msgid ""
"Quest Item: Charles Quixote's personal spear of Dragon slaying, Ebonest is a fine weapon indeed. When used against a Dragon, it seems to aim unerringly for the chinks between its target's tough scales."
msgstr ""
"Objeto de Misión: Ebonest, la lanza Matadragones personal de Charles Quijote, es un arma excelente. Cuando se usa contra un Dragón, parece apuntar sin fallo a las rendijas entre las duras escamas de su objetivo."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:542
msgid "Special Spear"
msgstr "Lanza Especial"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:543
msgid ""
"Quest Item: That the Whistlebones would settle upon such a fierce weapon for their heirloom speaks much of their commitment to the family business of Dragon hunting."
msgstr ""
"Objeto de Misión: Que los Whistlebone eligieran un arma tan feroz como reliquia familiar dice mucho de su dedicación al negocio familiar de la Cacería de Dragones."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:543
