#: assets_dev/engine/data_tables/items.txt:54
msgid "Hayfork"
msgstr "Horca de Heno"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:54
msgid ""
"Though a common farming implement, this hayfork is of sturdy construction and could be an excellent, if improvised, weapon."
msgstr ""
"Aunque es un apero de labranza corriente, esta horca es de construcción robusta y podría ser un arma excelente, aunque improvisada."

