# imported from SP (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:92 assets_dev/engine/data_tables/spells.txt:91
msgid ""
"Temporarily increases all seven stats on all your characters by three times your skill in Light Magic.  This spell lasts until you rest."
msgstr ""
"Aumenta Temporalmente las Siete Estadísticas de vuestros personajes tres veces la Habilidad en Magia de la Luz. Este Hechizo dura hasta que se descansa."

# imported from SP (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:93 assets_dev/engine/data_tables/spells.txt:92
