#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:110
msgid "Castleview Guild of Water"
msgstr ""

#: assets_dev/worlds/xeen/data_tables/house_data.txt:15 assets_dev/worlds/xeen/events/maps/xeen_d1.lua:113 assets_dev/worlds/xeen/events/maps/xeen_d1.lua:115
#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:118
msgid "Castleview Guild of Earth"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:1131
msgid "The stable yard's gate is barred from inside."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:1157
msgid "The shrine is quiet. Come back tomorrow."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:1163
msgid "Mok bless your road. +10 Luck until you rest."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:1169
msgid "You pray, and the shrine is silent. Come back tomorrow."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_d1.lua:1181
msgid "You pray. +10 to every stat until you rest."
msgstr ""

