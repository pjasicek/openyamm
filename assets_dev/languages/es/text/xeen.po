#: assets_dev/worlds/xeen/data_tables/npc_topic_text.txt:11 assets_dev/worlds/xeen/events/common/xeen_quests.lua:712
msgid "Joe's gone. (hic) Good riddance. (hicup) Who's buying?"
msgstr ""

