msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:136 assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:138
msgid "Notebooks"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:137
msgid ""
"The scientists' notebooks, swollen with damp. One page survives: 'Blade tempered. Edge holds against the undead sample. Do NOT tell the castle. Password changed to something we will all remember.'"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:156 assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:158
msgid "New masonry"
msgstr ""

