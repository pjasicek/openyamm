msgid "Larder"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:125
msgid "You fill your packs from the larder."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:131
msgid "Food.  Fill pack?"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd13.lua:132
