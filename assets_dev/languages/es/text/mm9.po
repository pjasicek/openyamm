msgstr "¿Quizá podríamos preguntaros otra cosa?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:6
msgid "It's a person."
msgstr "Es una persona."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:6
msgid "Never met him."
msgstr "No lo conozco."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:18
msgid "Don't mention it."
msgstr "No hay de qué."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:13
msgid "Thank you for your time."
msgstr "Gracias por vuestro tiempo."

