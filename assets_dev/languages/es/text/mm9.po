# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:11
msgid "As Jarl of the Thronheim Clan, it must bother her to no end."
msgstr "Como Jarl del clan de Thronheim, debe de fastidiarla muchísimo."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:11
msgid "Kira must not like that."
msgstr "A Kira no debe de gustarle eso."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:12
msgid ""
"That is the god they worship.  They believe everyone gets reincarnated as geese."
msgstr ""
"Es el dios al que adoran. Creen que todo el mundo se reencarna en ganso."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:12
msgid "Who is The Great Honk?"
msgstr "¿Quién es el Gran Honk?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:13
msgid "Do you have any interesting news?"
msgstr "¿Tienes alguna noticia interesante?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:13
msgid ""
"I've heard that the Honkies are getting to be a real problem in Thronheim."
msgstr ""
"He oído que los honkis se están convirtiendo en un verdadero problema en Thronheim."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:4
msgid "We'd like to see what you have."
msgstr "Nos gustaría ver lo que tienes."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC13.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:4
msgid "We're closed.  Go away."
msgstr "Está cerrado. Marchaos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:15
msgid "We're not interested in buying anything right now."
msgstr "Ahora mismo no nos interesa comprar nada."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:1
