#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:165
msgid "Hello there!  How are you!"
msgstr "¡Hola! ¿Qué tal estáis?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:166 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:178 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:187
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:192 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:225 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:234
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:265 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:271 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:276
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:280 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:363 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:380
msgid "Hi!"
msgstr "¡Hola!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:169
msgid "The Guberland Players sure are good!"
msgstr "¡Qué buenos son los Comediantes de Guberland!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:175
msgid "I really wish they would get it right!"
msgstr "¡Ojalá lo hicieran bien de una vez!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:176
msgid "What a great bunch of actors!"
msgstr "¡Qué gran compañía de actores!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:179
msgid "The tree of life grant you wisdom, friends."
msgstr "Que el Árbol de la Vida os conceda sabiduría, amigos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:18 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:288
msgid "Do you be requiring passage, friend?"
msgstr "¿Requerís pasaje, amigos?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:181
msgid "Good day to you."
msgstr "Buenos días tengáis."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:184
msgid "Well!  What do you want?"
msgstr "¡Bueno! ¿Qué queréis?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:185
msgid "Greetings, my children."
msgstr "Saludos, hijos míos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:188
msgid "What do you want?  Why have you bothered me?"
msgstr "¿Qué queréis? ¿Por qué me molestáis?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:19
msgid "Greetings.  What can I help you with?"
msgstr "Saludos. ¿En qué puedo ayudaros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:2
msgid "Hello.  I am called Forad Darre.  Who are you?  How did you get here?"
msgstr ""
"Hola. Me llamo Forad Darre. ¿Quiénes sois? ¿Cómo habéis llegado hasta aquí?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:20
msgid "Shhh.  People are trying to study.  What can I help you with?"
msgstr "Chsss. Hay gente intentando estudiar. ¿En qué puedo ayudaros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:200
msgid "Looking for a sword?"
msgstr "¿Buscáis una espada?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:201
msgid "Looking for some armor?"
msgstr "¿Buscáis alguna armadura?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:206
msgid "No better place for your gold!"
msgstr "¡No hay mejor sitio para vuestro oro!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:207
msgid "Hello!  Come in!"
msgstr "¡Hola! ¡Pasad!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:208
msgid "Welcome, my children."
msgstr "Bienvenidos, hijos míos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:105 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:21 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:212
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:260 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:62
msgid "Looking for training?"
msgstr "¿Buscáis entrenamiento?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:210 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:258
msgid "May I help you?"
msgstr "¿Puedo ayudaros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:214
msgid "How's it going?"
msgstr "¿Qué tal va todo?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:215
msgid "You better watch out for your children!"
msgstr "¡Más vale que vigiléis a vuestros hijos!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:217
msgid "What are we going to do?"
msgstr "¿Qué vamos a hacer?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:218
msgid "Where are our next meals going to come from?"
msgstr "¿De dónde vamos a sacar la próxima comida?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:221
msgid "Welcome visitors!"
msgstr "¡Bienvenidos, visitantes!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:222 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:228
msgid "Good day"
msgstr "Buenos días"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:231
msgid "Hey."
msgstr "Eh."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:238
msgid "Fre sends her blessings to you, travellers"
msgstr "Fre os envía sus bendiciones, viajeros"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:239
msgid "Good day, travellers.  What can I help you with?"
msgstr "Buenos días, viajeros. ¿En qué puedo ayudaros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:241
msgid "Hello.  Did you need some healing?"
msgstr "Hola. ¿Necesitabais curación?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:242
msgid "Hey!  Come here!"
msgstr "¡Eh! ¡Venid aquí!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:243
msgid "You look like you would be handy!"
msgstr "¡Parecéis gente útil!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:244
msgid "What did you bring me!?"
msgstr "¡¿Qué me habéis traído?!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:246
msgid "Who are you?  What do you want?"
msgstr "¿Quiénes sois? ¿Qué queréis?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:247
msgid "You look like you could use a sword."
msgstr "Parece que os vendría bien una espada."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:253
msgid "I won't let you down!"
msgstr "¡No os defraudaré!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:254
msgid "Come!  Have a drink!"
msgstr "¡Venid! ¡Tomad un trago!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:255
msgid "Come in!  Have a look around."
msgstr "¡Pasad! Echad un vistazo."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:259
msgid "Come in.  Have a read."
msgstr "Pasad. Leed algo."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:26
msgid "Have you been to the mines?"
msgstr "¿Habéis estado en las minas?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:261
msgid "Death to the oppressors!"
msgstr "¡Muerte a los opresores!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:27
msgid "How can they expect us to work with poor equipment?"
msgstr "¿Cómo pretenden que trabajemos con un equipo tan malo?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:277
msgid "How are you."
msgstr "¿Qué tal estáis?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:28
msgid "Those refinery managers sure are stupid!"
msgstr "¡Qué estúpidos son los capataces de la refinería!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:281
msgid "May knowledge bless you, friend."
msgstr "Que el saber os bendiga, amigos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:282
msgid "Blessings upon you my children. How can I be of service?"
msgstr "Bendiciones, hijos míos. ¿En qué puedo serviros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:283
msgid ""
"You aren't from around here are you? Would you be willing to do a task for me?"
msgstr ""
"No sois de por aquí, ¿verdad? ¿Estaríais dispuestos a hacerme un encargo?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:284
msgid "I was told you would be taking me to my new congregation?"
msgstr ""
"Me dijeron que vosotros me llevaríais a mi nueva congregación, ¿no es así?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:285
msgid "Welcome! What can I show you?"
msgstr "¡Bienvenidos! ¿Qué puedo enseñaros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:286 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:292
msgid "What can I do for you?"
msgstr "¿Qué puedo hacer por vosotros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:289
msgid "Yes, can I help you my child?"
msgstr "Sí, ¿puedo ayudaros, hijos míos?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:29
msgid "What do you want?!  Leave me alone!"
msgstr "¡¿Qué queréis?! ¡Dejadme en paz!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:290
msgid "What is it?  I'm busy!"
msgstr "¿Qué pasa? ¡Estoy ocupado!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:291
msgid "Do you know anything about repairing fences?"
msgstr "¿Sabéis algo de arreglar cercas?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:293
msgid "Yes my child?"
msgstr "¿Sí, hijos míos?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:294
msgid "How can I help you child?"
msgstr "¿En qué puedo ayudaros, hijos?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:296 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:297 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:298
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:299 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:300 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:301
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:302 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:303 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:304
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:305 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:306 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:307
msgid "Bless you my child."
msgstr "Benditos seáis, hijos míos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:3
msgid "Well met, friends.  What may I do for you?"
msgstr "Bien hallados, amigos. ¿Qué puedo hacer por vosotros?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:30
msgid "These people think it's the foreman's fault!"
msgstr "¡Esta gente cree que la culpa es del capataz!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:308
msgid "Do you need healing?"
msgstr "¿Necesitáis curación?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:309
msgid "What now?"
msgstr "¿Y ahora qué?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:31
msgid "Hello!  A pleasant day today, is it not?"
msgstr "¡Hola! Hace un día agradable, ¿no os parece?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:312
msgid "I don't know what I'm going to do!"
msgstr "¡No sé qué voy a hacer!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:313
msgid "I am Forblaith, do you have the gift of magic?"
msgstr "Soy Forblaith. ¿Tenéis el don de la magia?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:314
msgid ""
"I've got all kinds of things to sell! What kind I help you with today?"
msgstr "¡Tengo toda clase de cosas para vender! ¿En qué puedo ayudaros hoy?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:32
msgid "What do you want?  Can't you see I'm busy?"
msgstr "¿Qué queréis? ¿No veis que estoy ocupado?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:322
msgid "Hm.  There's trouble in the wind.  I can smell it."
msgstr "Hum. Hay problemas en el aire. Puedo olerlos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:323
msgid "Got tend to the plowing, it won't get done by itself!"
msgstr "¡Tengo que ocuparme del arado, no se va a hacer solo!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:324 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:325
msgid "Lovely Day isn't it?"
msgstr "Un día precioso, ¿verdad?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:326
msgid "Maybe I should re-thatch the house today."
msgstr "Quizá debería rehacer hoy el tejado de paja de la casa."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:327
msgid "I've got to fix the chimney or the wife will have my hide!"
msgstr "¡Tengo que arreglar la chimenea o mi mujer me arrancará el pellejo!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:328
msgid "I wonder if I can borrow Broccan's plow…"
msgstr "Me pregunto si Broccan me prestaría su arado…"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:329
msgid "This is a day for being outside."
msgstr "Es un día para estar al aire libre."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:330
msgid "Where's that husband of mine?  He's supposed to fix the chimney!"
msgstr "¿Dónde se ha metido mi marido? ¡Tenía que arreglar la chimenea!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:331
msgid ""
"Hrumph! My family used to have a farm near here but now those Thronish have it."
msgstr ""
"¡Hum! Mi familia tenía una granja cerca de aquí, pero ahora es de esos throneses."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:332
msgid "Do you know anyone who could give me work?"
msgstr "¿Conocéis a alguien que pueda darme trabajo?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:333
msgid ""
"This village is crawling with Thronish!  How can a good Framish take this?"
msgstr ""
"¡Este pueblo está plagado de throneses! ¿Cómo va a soportarlo un buen framés?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:335
msgid "Who stands before Krohn?"
msgstr "¿Quién se presenta ante Krohn?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:336
msgid "Greetings, Mortals."
msgstr "Saludos, mortales."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:337
msgid "Blessings, my children."
msgstr "Bendiciones, hijos míos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:338
msgid "Come, sit.  Igrid shall comfort you."
msgstr "Venid, sentaos. Igrid os consolará."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:339
msgid "We make the best drinks in all of Arslegaard!"
msgstr "¡Hacemos las mejores bebidas de todo Arslegaard!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:340
msgid "You can not buy better weapons than this!"
msgstr "¡No encontraréis mejores armas que estas!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:341
msgid "You look like you could use a good suit!"
msgstr "¡Parece que os vendría bien una buena armadura!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:342
msgid "Come in!  Have a look!"
msgstr "¡Pasad! ¡Echad un vistazo!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:344
msgid "Come."
msgstr "Venid."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:346
msgid "There is no safer place for your money!"
msgstr "¡No hay lugar más seguro para vuestro dinero!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:348
msgid "How did you get injured up here?"
msgstr "¿Cómo os habéis herido aquí arriba?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:35
msgid "Hello.  Need some stones washed?"
msgstr "Hola. ¿Necesitáis que os lave unas piedras?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:350
msgid "Come in."
msgstr "Pasad."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:353
msgid "Boy!  What a grand death I had!"
msgstr "¡Madre mía! ¡Qué muerte más gloriosa tuve!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:354
msgid "It's so dull around here."
msgstr "Qué aburrido es esto."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:355
msgid "It's wonderful here!"
msgstr "¡Esto es maravilloso!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:356
msgid "The booze here is terrible!"
msgstr "¡El licor de aquí es malísimo!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:357
msgid "The drinks here are great!"
msgstr "¡Las bebidas de aquí son estupendas!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:358
msgid "I'm itching for some action!"
msgstr "¡Me muero por un poco de acción!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:359
msgid "I miss the days of drinking and fighting!"
msgstr "¡Echo de menos los días de bebida y peleas!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:36
msgid "Lindisfarne is a fine place to go!"
msgstr "¡Lindisfarne es un buen sitio al que ir!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:360
msgid "It's getting boring in here."
msgstr "Esto se está volviendo aburrido."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:37
msgid "Stand back!  I've got things to do!"
msgstr "¡Apartaos! ¡Tengo cosas que hacer!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:378
msgid "Pardon me.  I've got an important message for you."
msgstr "Disculpad. Tengo un mensaje importante para vosotros."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:379
msgid "Greetings, fellow traveller"
msgstr "Saludos, compañeros de viaje"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:38
msgid "May you always find warm flame, friend."
msgstr "Que siempre encontréis una llama cálida, amigos."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:387 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:392 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:397
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:402 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:407 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:412
msgid "Good Day."
msgstr "Buenos días."

# machine translation (Claude), review
