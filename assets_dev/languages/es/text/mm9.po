#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:3
msgid "Go to Thjorgard and find Hildigunna the Quick."
msgstr "Id a Thjorgard y buscad a Hildigunna la Rápida."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:3
msgid "Where can we become Grandmasters in Dodging?"
msgstr "¿Dónde podemos llegar a Grandes Maestros en Esquivar?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:4
msgid "We'd like to become Masters in Dodging."
msgstr "Queremos ser Maestros en Esquivar."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:5
msgid "Stay quick on your feet.  You should be ready for anything."
msgstr "Sed ligeros de pies. Debéis estar preparados para cualquier cosa."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:7
msgid "Where can we go to become Grandmasters in Repair Item?"
msgstr "¿Adónde podemos ir para llegar a Grandes Maestros en Reparación?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:7
