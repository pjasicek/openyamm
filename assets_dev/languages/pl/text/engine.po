# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/english/quests.txt:10
msgid ""
"Deliver Fellmoon's blackmail letter to Arion Hunter, leader of the wererat smugglers. Report back to Fellmoon."
msgstr ""
"Dostarczcie list napisany przez Fellmoona Arionowi Łowcy, przywódcy szczurołaków przemytników. Następnie wróćcie do Fellmoona."

# imported from PL (MMMerge localization)
# address made plural (Claude)
# fan text corrected (Claude)
#: assets_dev/engine/data_tables/english/quests.txt:102
msgid ""
"Deliver Cure Disease Scrolls to the six huts on the outer Dagger Wound Islands.  Return to Aislen on Dagger Wound Island."
msgstr ""
"Dostarczcie zwoje z zaklęciem ulecz chorobę do sześciu chatek na zewnętrznych wyspach archipelagu Krwawego Sztyletu. Wróćcie do Aislen z Wyspy Krwawego Sztyletu."

# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/english/quests.txt:110
msgid ""
"Find and return an Anointed Potion to Languid in the Dagger Wound Islands."
msgstr ""
"Znajdźcie błogosławiony olejek i przynieście go Languidowi z wysp Krwawego Sztyletu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1106
msgid "Show Sulman's letter to Andover Potbello in New Sorpigal."
msgstr "Pokażcie list Sulmana Andoverowi Potbello w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1107
msgid "Bring Sulman's letter to Regent Wilbur Humphrey at Castle Ironfist."
msgstr ""
"Przyieście list Sulmana do regenta Wilbura Humphreya na Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1108
msgid ""
"Find the Combination to the vault door in Goblinwatch and return to the Town Hall in New Sorpigal."
msgstr ""
"Znajdźcie kombinacje do drzwi skarbca w Goblińskiej Wachcie i powróćcie do Ratusza w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1109
msgid ""
"Get the Chime of Harmony from the Temple of Baa and return to the New Sorpigal Town Hall."
msgstr ""
"Przynieście Dzwonki Harmonii ze Świątyni Baa i powróćcie do Ratusza w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1111
msgid ""
"Find Lord Kilburn's Shield and return to Wilbur Humphrey in Castle Ironfist to report."
msgstr ""
"Znajdźcie Tarczę Lorda Kilburna i powróćcie do Wilbura Humphreya na Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1113
msgid ""
"Rescue a Damsel in Distress and return with her to Wilbur Humphrey in Castle Ironfist."
msgstr ""
"Uratujcie Pannę w Opałach i powróćcie z nią do Wilbura Humphreya na Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1114
msgid ""
"Slay Longfang Witherhide in his cave near Castle Darkmoor and return to Wilbur Humphrey in Castle Ironfist."
msgstr ""
"Zabijcie Longfanga Witherhide'a w jego jaskini niedaleko Zamku Darkmoor i powróćcie do Wilbura Humphreya na Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1115
msgid "Entertain Nicolai."
msgstr "Rozbawcie Nicolaia."

# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/english/quests.txt:112
msgid ""
"Bring Hiss on the Dagger Wound Islands the Idol of the Snake from the Abandoned Temple."
msgstr ""
"Przynieście Hissowi z wysp Krwawego Sztyletu posążek węża z opuszczonej świątyni."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1120
msgid "Find and return Prince Nicolai to Castle Ironfist."
msgstr ""
"Znajdźcie i przyprowadźcie z powrotem Księcia Nicolaia na Zamek Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1121
msgid "Find the Third Eye and bring it to Prince Nicolai in Castle Ironfist."
msgstr ""
"Odnajdźcie Trzecie Oko i przynieście je do Księcia Nicolaia na Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1123
msgid ""
"Capture the Prince of Thieves and bring him to Lord Anthony Stone at Castle Stone."
msgstr ""
"Schwytajcie Księcia Złodziei i przynieście go do Lorda Anthony'ego Stone'a na Zamku Stone."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1130
msgid ""
"Hire a Stonecutter and a Carpenter, bring them to Temple Stone in Free Haven to repair the Temple, and then return to Lord Anthony Stone at Castle Stone."
msgstr ""
"Najmijcie murarza i cieślę, przyprowadźcie ich do Świątyni Stone w Wolnej Przystani aby ją naprawić, a następnie powróćcie do lorda Anthony'ego Stone'a na Zamku Stone."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1132
msgid ""
"Take the Sacred Chalice from the monks in their island temple east of Free Haven, return it to Temple Stone in Free Haven, and then return to Lord Stone at Castle Stone."
msgstr ""
"Zabierzcie Święty Kielich od mnichów na ich wyspiarskiej świątyni na wschód od Wolnej Przystani, przynieście go do Świątyni Stone, a następnie powróćcie do lorda Stone'a na Zamku Stone."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1135
msgid "Find and return the Hourglass of Time to Lord Albert Newton in Mist."
msgstr ""
"Zajdźcie i oddajcie Klepsydrę Czasu lordowi Albertowi Netwonowi we Mgle."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1136
msgid ""
"Drink from the Fountain of Magic and return to Lord Albert Newton in Mist."
msgstr ""
"Napijcie się wody z Fontanny Magii i powróćcie do lorda Alberta Netwona we Mgle."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1137
msgid ""
"Retrieve the Crystal of Terrax and return to Lord Albert Newton in Mist."
msgstr ""
"Odzyskajcie Kryształ Terraxa i powróćcie do lorda Alberta Netwona we Mgle."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1138
msgid ""
"Destroy the Devil's Outpost and return to Lord Osric Temper at Castle Temper."
msgstr ""
"Zniszczcie Posterunek Diabłów i powróćcie do lorda Osrica Tempera na Zamku Temper."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1139
msgid ""
"Get Knight's nomination from Chadwick and return to Lord Osric Temper at Castle Temper."
msgstr ""
"Zdobąćcie nominację rycerzy od Chadwicka i powróćcie do lorda Osrica Tempera na Zamku Temper."

# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/english/quests.txt:114
msgid ""
"Bring Thistle on the Dagger Wound Islands the basic ingredients for a potion of Pure Speed."
msgstr ""
"Przynieście Thistle'owi z wysp Krwawego Sztyletu podstawowe odczynniki potrzebne do stworzenia eliksiru czystej szybkości."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1140
msgid "Defeat the Warlord and bring proof to Osric Temper"
msgstr "Pokonajcie Wodza i przynieście dowód zwycięstwa Osricowi Temperowi"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1141
msgid ""
"Fix the prices of all 9 stables in the Kingdom and return to Lady Fleise in Silver Cove."
msgstr ""
"Ustalcie ceny we wszystkich 9 stajniach w Królestwie i powróćcie do Pani Fleise w Srebrzystej Zatoczce."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1143
msgid ""
"Visit the Altar of the Sun in the circle of stones north of Silver Cove on an equinox or solstice (HINT:  March 20th is an equinox)."
msgstr ""
"Odwiedźcie Ołtarz Słońca w kamiennym kręgu na północ od Srebrzystej Zatoczki podczas równonocy lub przesilenia (WSKAZÓWKA:  20 marca nastąpi równonoc)."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1144
msgid ""
"Visit the Altar of the Moon in the Temple of the Moon at midnight of a full moon."
msgstr ""
"Odwiedźcie Ołtarz Księżyca w Świątyni Księżyca o północy podczas pełni księżyca."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1145
msgid ""
"End winter for Lord Stromgard at Castle Stromgard, and return to him with the good news."
msgstr ""
"Zakończcie zimę dla lorda Stormgarda na Zamku Stormgard i powróćcie do niego z dobrymi wieściami."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1146
msgid ""
"Retrieve the key to the Dragon Towers from Icewind Keep south of Whitecap, and bring it to Lord Stromgard at Castle Stromgard."
msgstr ""
"Odzyskajcie klucz do Smoczych Wież z Twierdzy Lodowego Wichru na południe od Białego Wzgórza i przynieście go do lorda Stromgarda na Zamku Stromgard."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1147
msgid ""
"Reset all of the Dragon Towers at each town and return to Lord Stromgard in Castle Stromgard."
msgstr ""
"Zresetujcie wszystkie Smocze Wieże w każdym mieście i powróćcie do lorda Stromgarda  na Zamku Stromgard."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1149
msgid ""
"Kill Snergle in Snergle's Caverns and return with his axe to Avinril Smythers at The Haunt tavern in the Mire of the Damned."
msgstr ""
"Zabijcie Snergle'a w Jaskiniach Snergle'a i powróćcie z jego toporem do Avinril Smythers w tawernie Speluna na Bagnach Potępionych."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1150
msgid ""
"Storm the Silver Helm Outpost near Mist and return with evidence of their corruption to the Constable of Mist."
msgstr ""
"Wedrzyjcie się do Posterunku Srebrnych Hełmów niedaleko Mgły i powróćcie z dowodem ich korupcji do konstabla Mgły."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1151
msgid ""
"Retrieve the candelabra from the Abandoned Temple for Andover Potbello in New Sorpigal."
msgstr ""
"Odzyskajcie kandelabr z Opuszczonej Świątyni i dajcie go Andoverowi Potbello w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1153
msgid ""
"Retrieve the harp from the Dragoon's Caverns south of Castle Ironfist and return it to Andrew Besper in Castle Ironfist."
msgstr ""
"Odzyskajcie harfę z Jaskiń Dragonów na południe od Zamku Ironfist i przynieście ją Andrewowi Besperowi na Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1154
msgid ""
"Retrieve Ethric's skull from his tomb west of Free Haven for Gabriel Cartman in Free Haven."
msgstr ""
"Odzyskajcie czaszkę Ethrica z jego grobowca na zachód od Wolnej Przystani dla Gabriela Cartmana w Wolnej Przystani."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1155
msgid ""
"Kill the Queen of the Spiders in the Abandoned Temple in New Sorpigal and return with her heart to Buford T. Allman in New Sorpigal."
msgstr ""
"Zabijcie Królową Pająków w Opuszczonej Świątyni w Nowym Sorpigalu i powróćcie z jej sercem do Buforda T. Allmana w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1156
msgid ""
"Deface the altar in the Monolith west of Silver Cove and return to Eleanor Vanderbilt in Silver Cove."
msgstr ""
"Zbezcześćcie ołtarz w Monolicie na zachód od Srebrzystej Zatoczki i powróćcie do Eleanor Vanderbilt w Srebrzystej Zatoczce."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1159
msgid ""
"Destroy the crystal in the Temple of the Fist and return to Winston Schezar in Bootleg Bay."
msgstr ""
"Zniszczcie kryształ w Świątyni Pięści i powróćcie do Winstona Schezara."

# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/english/quests.txt:116
msgid ""
"Bring Rihansi in Alvar the basic ingredients for a potion of Pure Luck."
msgstr ""
"Przynieście Rihansi z Alvar podstawowe odczynniki potrzebne do stworzenia eliksiru czystego szczęścia."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1161
msgid ""
"Rescue Emmanuel from the Temple of the Snake near Blackshire and return him to Joanne Cravitz in Blackshire."
msgstr ""
"Uratujcie Emmanuela ze Świątyni Węża niedaleko Czarnego Hrabstwa i powróćcie z nim do Joanne Cravitz w Czarnym Hrabstwie."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1162
msgid ""
"Find the lost artifact in the Dragoons' Keep near Castle Temper and return it to Zoltan Phelps in Free Haven."
msgstr ""
"Znajdźcie zaginiony artefakt w Twierdzy Dragonów niedaleko Zamku Temper i powróćcie z nim do Zoltana Phelpsa w Bezpiecznej Przystani."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1163
msgid ""
"Rescue Sharry from the Shadow Guild Hideout and return with her to Frank Fairchild in New Sorpigal."
msgstr ""
"Ocalcie Sharry z Kryjówki Gildii Cienia i powróćcie z nią do Granka Fairchilda w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1164
msgid ""
"Rescue Angela from the Abandoned Temple and return her to Violet Dawson in New Sorpigal."
msgstr ""
"Ocalcie Angelę Z Opuszczonej Świątyni i powróćcie z nią do Violet Dawson w Nowym Sorpigalu."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1165
msgid ""
"Rescue Sherell from the cannibals on the islands east of Free Haven and return with her to Carlo Tormini in Free Haven."
msgstr ""
"Ocalcie Sherell od kanibali na wyspach na wschód od Bezpiecznej Przystani i powróćcie z nią do Carla Torminiego w Bezpiecznej Przystani."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1166
msgid ""
"Destroy the Werewolf's altar in the Lair of the Wolf and return to Maria Trepan in Blackshire."
msgstr ""
"Zniszczcie ołtarz Wilkołaka w Wilczym legowisku i powróćcie do Marii Trepan w Czarnym Hrabstwie."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1168
msgid ""
"Find the Pearl of Putrescence in the Lair of the Wolf and bring it to the Ghost of Balthasar, also in the Lair of the Wolf."
msgstr ""
"Znajdźcie Perłę Zepsucia w Wilczym legowisku i przynieście ją Duchowi Baltazara, także w Wilczym legowisku."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1169
msgid ""
"Retrieve the jewelled egg from Castle Kriegspire and return it to Emil Lime in Kriegspire village."
msgstr ""
"Odzyskajcie jajo wysadzane klejnotami z Zamku Kriegspire i powróćcie do Emil Lime w wiosce Kriegspire."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/quests.txt:1170
msgid ""
"Unward the doors in the Hall of the Fire Lord and return to the Lord of Fire, also in the Hall of the Fire Lord."
msgstr ""
"Odbezpieczcie drzwi w Komnatach Władcy Ognia i powróćcie do Władcy Ognia."

