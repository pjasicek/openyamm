#: assets_dev/engine/data_tables/items.txt:14
msgid "Iron Broadsword"
msgstr "Żelazny pałasz"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:14
msgid ""
"Some swordsmen swear that the soft metal of an iron sword gives them certain combat advantages. Those swordsmen never seem to be very old."
msgstr ""
"Niektórzy szermierze twierdzą, że miękkie żelazo tego miecza daje im pewne przewagi podczas walki. Żaden z nich nie wydaje się być zbyt stary."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:140
msgid "A simple bauble of very little value."
msgstr "Zwykła ozdoba o niewielkiej wartości."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:140
msgid "Bronze Ring"
msgstr "Mosiężny pierścień"

