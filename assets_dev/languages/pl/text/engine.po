msgstr ""
"Przedmiot związany z misją: Z tego smoczego jaja wkrótce wykluje się pisklę. Mała, żywa istota zamknięta wewnątrz czasami przypomina o swojej obecności szelestem."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:609
msgid "Heart of Fire"
msgstr "Serce ognia"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:609 assets_dev/engine/data_tables/items.txt:610 assets_dev/engine/data_tables/items.txt:611
