#: assets_dev/engine/data_tables/items.txt:112 assets_dev/engine/data_tables/items.txt:113 assets_dev/engine/data_tables/items.txt:114
#: assets_dev/engine/data_tables/items.txt:115 assets_dev/engine/data_tables/items.txt:116 assets_dev/engine/data_tables/items.txt:1694
#: assets_dev/engine/data_tables/items.txt:1695 assets_dev/engine/data_tables/items.txt:1696 assets_dev/engine/data_tables/items.txt:1697
#: assets_dev/engine/data_tables/items.txt:1698 assets_dev/engine/data_tables/items.txt:894 assets_dev/engine/data_tables/items.txt:895
#: assets_dev/engine/data_tables/items.txt:896 assets_dev/engine/data_tables/items.txt:897 assets_dev/engine/data_tables/items.txt:898
msgid "Helm"
msgstr "Hełm"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:112
msgid ""
"This cap of soft iron and unhardened leather provides a small measure of protection from blows to the head."
msgstr ""
"Ten hełm z miękkiego żelaza i nieutwardzonej skóry zapewnia niewielką ochronę przed uderzeniami w głowę."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:113
msgid ""
"Iron and leather helms of this sort are produced by blacksmiths everywhere. This one is of Lizardman manufacture and sports genuine ram horns."
msgstr ""
"Żelazne i skórzane hełmy tego rodzaju produkowane są przez kowali na całym świecie. Ten egzemplarz został wykonany przez jaszczuroludzi i posiada prawdziwe baranie rogi."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:113
msgid "Lizardman Helm"
msgstr "Jaszczurzy hełm"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:114
msgid "Full Helm"
msgstr "Pełny hełm"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:114
msgid ""
"Steel helms of this design are commissioned in large numbers by the Merchants of Alvar who issue them to mounted caravan guards."
msgstr ""
"Stalowe hełmy tego rodzaju zamawiane są w wielkich ilościach przez kupców z Alvar, którzy przeznaczają je dla konnych strażników karawan."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:115
msgid "Battle Helm"
msgstr "Bojowy hełm"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:115
msgid ""
"This full helmet is of superior materials and workmanship. The structurally weaker areas around the eye and nose slits are reinforced with siertal."
msgstr ""
"Ten pełny hełm jest znakomicie wykonany, a do jego produkcji użyto materiałów doskonałej jakości. Strukturalnie słabsze okolice szczelin na oczy i nos wzmocnione zostały siertalem."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:116
msgid "Dragon Helm"
msgstr "Smoczy hełm"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:116
msgid ""
"The faceplate of this superior helmet hinges on nearly invisible seams so that when closed it provides a snug fit and full face coverage. Only the most well-aimed blows have a chance of penetrating through."
msgstr ""
"Przyłbica tego wspaniałego hełmu zamocowana jest na niemal niewidocznych zawiasach. Gdy zostanie zasunięta, zapewnia komfort i pełną ochronę twarzy. Tylko najcelniejsze ciosy mają szansę się przebić."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:117
msgid "A loose fitting hat made of sturdy cloth."
msgstr "Luźny kapelusz z mocnego materiału."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:117
msgid "Citizen Hat"
msgstr "Czapka"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:117 assets_dev/engine/data_tables/items.txt:118 assets_dev/engine/data_tables/items.txt:119
#: assets_dev/engine/data_tables/items.txt:1436 assets_dev/engine/data_tables/items.txt:1699 assets_dev/engine/data_tables/items.txt:1700
#: assets_dev/engine/data_tables/items.txt:1701 assets_dev/engine/data_tables/items.txt:645 assets_dev/engine/data_tables/items.txt:899
#: assets_dev/engine/data_tables/items.txt:900 assets_dev/engine/data_tables/items.txt:901
msgid "Hat"
msgstr "Kapelusz"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:118
msgid "Festival Hat"
msgstr "Impregnowana czapka"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:118
msgid ""
"Hats decorated with cheap glass gems are worn by Regnans on festival occassions--of which they have many."
msgstr ""
"Kapelusze ozdobione tanimi szklanymi świecidełkami noszone są przez Regnan podczas świąt - których obchodzą całe mnóstwo."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1186 assets_dev/engine/data_tables/items.txt:1286
msgid "Summon Elemental"
msgstr "Przyzwanie żywiołu"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:119
msgid "Merchantman's Hat"
msgstr "Kupiecki kapelusz"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:119
msgid ""
"This pleated cap of velvet, lined and edged with black rabbit fur is decorated with a small enameled medallion."
msgstr ""
"Ten pofałdowany kapelusz z aksamitu obszyty futrem czarnego królika ozdobiony jest małym emaliowanym medalionem."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:12
msgid ""
"A deep biting, perfectly balanced weapon designed for one purpose - the slaying of dragons."
msgstr ""
"Tnąca głęboko, doskonale wyważona broń zaprojektowana do jednego celu - zabijania smoków."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:12
msgid "Dragonning Blade"
msgstr "Smocze ostrze"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:120
msgid ""
"A simple belt of cured leather. It is decorated with iron studs and closes with a pinned hasp."
msgstr ""
"Prosty pas z garbowanej skóry. Ozdobiony żelaznymi guzami i zamykany prostą klamrą."

