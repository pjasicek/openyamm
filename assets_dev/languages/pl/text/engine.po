#: assets_dev/engine/data_tables/items.txt:153
msgid "Shadow Sect Medallion"
msgstr "Cienisty medalion"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1530
msgid "Journal Entry, 19th September"
msgstr "Wpis do dziennika, 19 września"

