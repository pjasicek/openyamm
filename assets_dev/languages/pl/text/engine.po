msgstr ""
"Lenord Skinner, mistrz rozbrajania pułapek, mieszka na południe od Harmondale, na wzgórzu, z którego roztacza się widok na miasto."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/english/autonote.txt:373 assets_dev/engine/data_tables/npc_topic_text.txt:3886 assets_dev/engine/events/Global.lua:11113
