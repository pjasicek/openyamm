#: assets_dev/engine/data_tables/items.txt:1420
msgid "Quest Item:  Empty Jar"
msgstr "Przedmiot związany z misją: Puste naczynie"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1421
msgid "Genie Lamp"
msgstr "Lampa dżinna"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1421
msgid "Lamp"
msgstr "Lampa"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1421
msgid ""
"The genies captured in these lamps will usually reward those who set them free, though sometimes they take cruel delight in punishing the first living beings they encounter.  To use the genie lamp, pick the lamp up and left-click over the picture of your character in the inventory screen."
msgstr ""
"Dżiny uwięzione w takich lampach zazwyczaj odwdzięczają się temu, kto je uwolni, choć czasami potrafią mścić się na pierwszym nieszczęśniku, który się im nawinie. Aby użyć lampy, podnieś ją i L-kliknij na wizerunku twojej postaci na ekranie ekwipunku."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1422
msgid "Knight Statuette"
msgstr "Statuetka rycerza"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1422
msgid ""
"Quest Item:  A small statuette of a knightly figure.  The statuette seems to radiate a faint magic."
msgstr ""
"Przedmiot związany z misją: Mała statuetka rycerza. Wydaje się, że promieniuje z niej słaba magia."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1422 assets_dev/engine/data_tables/items.txt:1423 assets_dev/engine/data_tables/items.txt:1424
msgid "Statuette"
msgstr "Statuetka"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1423
msgid ""
"Quest Item:  A small statuette of a proud eagle.  The statuette seems to radiate a faint magic."
msgstr ""
"Przedmiot związany z misją: Mała statuetka dumnego orła Wydaje się, że promieniuje z niej słaba magia."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1424
msgid "Angel Statuette"
msgstr "Statuetka anioła"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1424
msgid ""
"Quest Item:  A small statuette of an angel.  The statuette seems to radiate a faint magic."
msgstr ""
"Przedmiot związany z misją: Mała statuetka anioła. Wydaje się, że promieniuje z niej słaba magia."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1425
msgid "A large tapestry, suitable for hanging in castles."
msgstr "Duże obicie, nadające się do zawieszenia w zamku."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1425
msgid "Big Tapestry"
msgstr "Wielkie gobeliny"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1425
msgid "Tapestry"
msgstr "Gobelin"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1426
msgid "Angel Statue Painting"
msgstr "Obraz ze Statuą Anioła"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1426 assets_dev/engine/data_tables/items.txt:1427 assets_dev/engine/data_tables/items.txt:1428
msgid "Painting"
msgstr "Obraz"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1426
msgid ""
"Quest Item:  A painting of the angel fountain in the courtyard of Castle Ironfist."
msgstr ""
"Przedmiot związany z misją: Obraz anielskiej fontanny na dziedzińcu Zamku Ironfist."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1427
msgid "Archibald Ironfist Painting"
msgstr "Obraz Archibalda Ironfista"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1427
msgid ""
"Quest Item:  A painting of Archibald Ironfist just prior to his War of Succession in Enroth."
msgstr ""
"Przedmiot związany z misją: Obraz Archibalda Ironfista namalowany przed Wojną Sukcesorów w Enroth."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1428
msgid ""
"Quest Item:  A painting of Roland Ironfist just prior to the War of Succession in Enroth."
msgstr ""
"Przedmiot związany z misją: Obraz Rolanda Ironfista namalowany przed Wojną Sukcesorów w Enroth."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1428
msgid "Roland Ironfist Painting"
msgstr "Obraz Rolanda Ironfista"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1429
msgid ""
"Quest Item:  This small, porcelain vase has been etched with the inscription, \"To Lord Markham, for a great job in the war, Queen Catherine.\""
msgstr ""
"Przedmiot związany z misją: Na tym małym, porcelanowym flakonie widnieje napis, Lordowi Markhamowi, za jego wspaniałą postawę w czasie wojny, Królowa Katarzyna."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1429
msgid "Vase"
msgstr "Waza"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:143
msgid "Gemstone Ring"
msgstr "Pierścień z klejnotem"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:143
msgid ""
"This gold ring is decorated with a variety of tiny gems giving it a multicolored sparkle."
msgstr ""
"Ten złoty pierścień ozdobiony jest różnymi drobnymi klejnotami, które sprawiają, że mieni się wieloma kolorami."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1430
msgid "A red, red, rose."
msgstr "Czerwona róża."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1430
msgid "Flower"
msgstr "Kwiatek"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1430
msgid "Flower (Rose)"
msgstr "Kwiat (Róża)"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1431
msgid ""
"Quest Item:  The skull of the old Dwarf King, Zokarr IV.  It doesn't look particularly impressive."
msgstr ""
"Przedmiot związany z misją: Czaszka starego Króla Krasnoludów, Zakarra IV. Nie robi zbyt dużego wrażenia."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1431 assets_dev/engine/data_tables/items.txt:2087
msgid "Skull"
msgstr "Czaszka"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1431
msgid "Zokarr IV's Skull"
msgstr "Czaszka Zokarra IV"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1432
msgid "A human(?) thigh bone."
msgstr "Ludzka? kość udowa."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1432
msgid "Thigh Bone"
msgstr "Kość Udowa"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1433
msgid "Haldar's Remains"
msgstr "Szczątki Haldara"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1433
msgid ""
"Quest Item:  This strangely shaped jar resists all attempts to open or break.  Haldar apparently doesn't like to be disturbed."
msgstr ""
"Przedmiot związany z misją: To naczynie o dziwnym kształcie opiera się wszelkim próbom otwarcia lub rozbicia. Wygląda na to, że Haldar nie lubił gdy mu przeszkadzano."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1434 assets_dev/engine/data_tables/items.txt:1455
msgid "Bottle"
msgstr "Butelka"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1434
msgid "Elixir"
msgstr "Eliksir"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1434
msgid "Quest Item:  A glowing elixir of obviously magical properties."
msgstr ""
"Przedmiot związany z misją: Świecący eliksir, z pewnością posiadający magiczne właściwości."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1435
msgid ""
"Apples like these are produced by trees saturated by magic-- usually in the elven lands of Avlee and the Tularean Forest, though not restricted to these areas.  To use the apple, pick the apple up and left-click over the picture of your character in the inventory screen."
msgstr ""
"Takie jabłka, jak te, rodzą drzewa nasycone magią - zazwyczaj w elfickich krainach Avlee lub w Lesie Tulareańskim, choć nie tylko tam. Aby użyć jabłka, ponieś je i L-kliknij na wizerunku twojej postaci na ekranie ekwipunku."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1435
msgid "Red Apple"
msgstr "Czerwone jabłko"

# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/items.txt:1436
msgid ""
"Quest Item: This hat appears to belong to a more affluent member of society, the feather is genuine and the construction is solid.  Unfortunately, it doesn't seem to fit."
msgstr ""
"Przedmiot związany z misją: Wygląda na to, że ten kapelusz należał do jakiegoś bogacza. Piórko jest prawdziwe, a materiał solidny. Niestety, nie pasuje na wasze głowy."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1436
msgid "Wealthy Hat"
msgstr "Strojny kapelusz"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1437 assets_dev/engine/data_tables/items.txt:1438 assets_dev/engine/data_tables/items.txt:1439
msgid "Instrument"
msgstr "Instrument"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1437 assets_dev/engine/data_tables/npc_topic.txt:766
msgid "Lute"
msgstr "Lutnia"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1437
msgid ""
"Quest Item: This lute has been masterfully crafted and lovingly maintained.  This instrument clearly belongs to a Bard."
msgstr ""
"Przedmiot związany z misją: Ta lutnia została wykonana przez mistrza lutniczego i jest wspaniale utrzymana. Nie ma wątpliwości, że należy do Barda."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1438
msgid "Faerie Pipes"
msgstr "Piszczałki skrzatów"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1438
msgid ""
"Quest Item:  Though finely crafted and deceptively simple-looking, these Pipes are quite difficult to play; they seem to have a mind of their own."
msgstr ""
"Przedmiot związany z misją: Choć piszczałki są wspaniałej roboty i nie wygląda na to, żeby były zbyt skomplikowane, to jednak gra się na nich bardzo trudno, jakby miały swoją własną wolę."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1439
msgid "Gryphonheart's Trumpet"
msgstr "Trąbka Gryphonhearta"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1439
msgid ""
"Quest Item:  An artifact from a previous Elf/Human dispute, lost by Terrance Gryphonheart in a daring night-time raid by Elvish forces.  Rumor has it that no army that has fought on the side of this trumpet's music has ever been defeated.  Even if the rumor is false, it will certainly boost morale on either side."
msgstr ""
"Przedmiot związany z misją: Artefakt pochodzący z konfliktu pomiędzy Elfami a Ludźmi, zagubiony przez Terranca Gryphonhearta podczas nocnego najazdu na wojska Elfów. Krążą plotki, że armia, która idzie do ataku przy dźwiękach tej trąbki, nie da się pokonać. Nawet jeżeli nie ma w tym prawdy, to na pewno zwiększy to morale żołnierzy."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:144
msgid ""
"A ring set with three amethysts. The largest is an excellent stone - richly and evenly purple with a perfect cut."
msgstr ""
"Pierścień z trzema ametystami. Największy z nich jest doskonały - głęboko i jednolicie purpurowy, znakomicie oszlifowany."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:144
msgid "Amethyst Ring"
msgstr "Ametystowy pierścień"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1440
msgid ""
"Quest Item: Seashells this large are only found on the beaches of Emerald Island.  One of these might make a nice souvenir of your time here."
msgstr ""
"Przedmiot związany z misją: Tak duże muszle można znaleźć tylko na plażach Szmaragdowej Wyspy. Mogą być bardzo ładną pamiątką z wyspy."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1440 assets_dev/engine/data_tables/npc_topic.txt:769
msgid "Seashell"
msgstr "Muszla"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1441
msgid "Floor Tile (w/ moon insignia)"
msgstr "Płytka podłogowa"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1441
msgid ""
"Quest Item: This tile was apparently part of the library in a Temple of the Moon."
msgstr ""
"Przedmiot związany z misją: Ta płytka stanowiła część podłogi biblioteki w Świątyni Księżyca."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1441
msgid "Tile"
msgstr "Kafel"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1442
msgid ""
"(+100 Speed, +50 Accuracy, +50 Air Resistance, Regenerate SP and HP over time, and Feather Falling) Rumored to be the footwear of a god, the winged sandals confer enormous power on the wearer."
msgstr ""
"(+100 Szybkość, +50 Celność, +50 Odporność na Magię Ognia, Stopniowa Regeneracja PM i PŻ, Powolne Spadanie) Krąży plotka, że skrzydlate sandały należały kiedyś do pewnego boga, dlatego przekazują one olbrzymią moc swojemu właścicielowi."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1442
msgid "Winged Sandals"
msgstr "Skrzydlate sandały"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1443
msgid ""
"Quest Item: The Seasons' Stole is worn by priests during seasonal festivities.  Though it doesn't have any direct power, most commonfolk believe it grants luck in the planting or harvest."
msgstr ""
"Przedmiot związany z misją: Stułę Pór Roku noszą kapłani podczas świąt związanych z porami roku. Choć nie ma ona żadnych bezpośrednich mocy, większość pospólstwa uważa, że przynosi ona szczęście przy sadzeniu i żniwach."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1443
msgid "Scarf"
msgstr "Szal"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1443
msgid "Season's Stole"
msgstr "Stuła Pór Roku"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1444
msgid "Golem chest"
msgstr "Tułów golema"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1444 assets_dev/engine/data_tables/items.txt:1445 assets_dev/engine/data_tables/items.txt:1446
#: assets_dev/engine/data_tables/items.txt:1447 assets_dev/engine/data_tables/items.txt:1448 assets_dev/engine/data_tables/items.txt:1449
#: assets_dev/engine/data_tables/items.txt:1450
msgid "Golem part"
msgstr "Część golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1444
msgid ""
"Quest Item:  The broad torso of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr "Przedmiot związany z misją: Okazały tułów potężnego golema."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1445
msgid "Abbey Normal Golem Head"
msgstr "Wgnieciona głowa golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1445
msgid ""
"Quest Item:  The dented head of a mighty golem.  It looks a little…strange.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Przedmiot związany z misją: Głowa potężnego golema. Z tyłu ma spore wgniecenie."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1446
msgid "Golem head"
msgstr "Głowa golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1446
msgid ""
"Quest Item:  The proud head of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr "Przedmiot związany z misją: Dumna głowa potężnego golema."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1447
msgid "Golem left leg"
msgstr "lewa noga golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1447
msgid ""
"Quest Item:  The massive left leg of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr "Przedmiot związany z misją: Ogromna lewa noga potężnego golema."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1448
msgid "Golem right leg"
msgstr "prawa noga golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1448
msgid ""
"Quest Item:  The massive right leg of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr "Przedmiot związany z misją: Ogromna prawa noga potężnego golema."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1449
msgid "Golem right arm"
msgstr "prawa ręka golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1449
msgid ""
"Quest Item:  The powerful right arm of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr "Przedmiot związany z misją: Ogromna prawa ręka potężnego golema."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:145
msgid "Necromantic Ring"
msgstr "Nekromancki pierścień"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:145
msgid ""
"Though made of semi-precious silver, this ring is highly valuable because it is well suited to holding enchantments of medium power."
msgstr ""
"Chociaż ten pierścień wykonano ze srebra niskiej próby, jest bardzo ceniony, ponieważ świetnie nadaje się do utrzymywania zaklęć o średniej mocy."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1450
msgid "Golem left arm"
msgstr "lewa ręka golema"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1450
msgid ""
"Quest Item:  The powerful left arm of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr "Przedmiot związany z misją: Ogromna lewa ręka potężnego golema."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1451
msgid ""
"This flawless horseshoe is made of silver.  To use, pick the horseshoe up and right-click over a character's portrait."
msgstr ""
"Ta, nie posiadająca żadnych wad, podkowa jest wykonana ze srebra. Żeby jej użyć, podnieś ją i P-kliknij na wizerunku postaci."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1452
msgid "Dragon Egg"
msgstr "Smocze jajo"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1452
msgid ""
"Quest Item:  Rough, leathery, and strangely warm, this egg appears nearly ready to hatch."
msgstr ""
"Przedmiot związany z misją: Jajo jest skórzaste i dziwnie ciepłe. Wygląda, jakby zaraz miało się coś z niego wykluć."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1453
msgid "Lantern"
msgstr "Latarnia"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid "Lantern of Light"
msgstr "Latarnia Światła"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid ""
"Quest Item:  This lantern shines with a faint, holy light, though no flame appears to be lit inside."
msgstr ""
"Przedmiot związany z misją: Ta latarnia świeci słabym światłem, choć wewnątrz nie widać żadnego płomienia."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1454
msgid ""
"Quest Item:  This belt is worn to the point where it should only last about an hour.  Hopefully, that will be long enough."
msgstr ""
"Przedmiot związany z misją: Ten pas jest tak zniszczony, że nie wytrzyma dłużej niż godzinę. Może tyle ci wystarczy."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1454
msgid "Worn Belt"
msgstr "Zużyty pas"

# imported from PL (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/items.txt:1455
msgid ""
"A strangely shaped small building finely crafted inside a glass bottle.  Something about the bottle beckons you inside.  To use, pick the bottle up and click over the picture of your character in the inventory screen."
msgstr ""
"Mała budowla dziwnego kształtu zamknięta w szklanej butelce. Coś przywołuje was do wejścia do środka. Aby jej użyć, podnieście butelkę i kliknijcie na wizerunku waszej postaci na ekranie ekwipunku."

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1455
msgid "Temple in a Bottle"
msgstr "Świątynia w butelce"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid "Arcomage Deck"
msgstr "Talia Arcomage"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1456
msgid "Deck"
msgstr "Talia"

# imported from PL (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid ""
"Quest Item: A deck of fancifully drawn cards used for a popular card game."
msgstr ""
"Przedmiot związany z misją: Talia malowanych kart, używana do popularnej gdy karcianej."

