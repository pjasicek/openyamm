# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:139
msgid "The magic of the spirit."
msgstr "Magia ducha."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:14
msgid "Come in my friends!  Have a drink!"
