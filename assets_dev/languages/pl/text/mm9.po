msgstr "Tu właśnie są pieniądze."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:141
msgid "Come in, come in!"
msgstr "Wejdźcie, wejdźcie!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:142
