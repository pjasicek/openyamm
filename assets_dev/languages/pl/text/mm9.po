# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:10
msgid "Have I got a weapon for you!"
msgstr "Mam dla was broń w sam raz!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:100
msgid "No better place for your money!"
msgstr "Nie ma lepszego miejsca dla waszych pieniędzy!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:101
msgid "Ready to tip one back?"
msgstr "Gotowi wychylić kufelek?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:102
msgid "Welcome.  Please come in."
msgstr "Witajcie. Proszę, wejdźcie."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:104
msgid "What may I help you with?"
msgstr "W czym mogę wam pomóc?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:106
msgid "What do you want?!"
msgstr "Czego chcecie?!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:108
msgid "Mommy said not to talk to strangers."
msgstr "Mama mówiła, żeby nie rozmawiać z obcymi."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:109
msgid "Go away.  Alfrigg does not want to talk to you."
msgstr "Odejdźcie. Alfrigg nie chce z wami rozmawiać."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:11
msgid "Have you come to fix the machine?"
msgstr "Przyszliście naprawić maszynę?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:111
msgid "Greetings.  What may I do for you?"
msgstr "Witajcie. Co mogę dla was zrobić?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:112
msgid "Oh, I should have clobbered him one!"
msgstr "Och, powinienem był mu przyłożyć!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:113
msgid "Have you come to help us?"
msgstr "Przyszliście nam pomóc?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:114
msgid "Good morrow!"
msgstr "Dzień dobry wam!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:12 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:134 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:17
msgid "Come in!  Have a look around!"
msgstr "Wejdźcie! Rozejrzyjcie się!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:120
msgid "Have you heard the Gospels of Honk?"
msgstr "Słyszeliście Ewangelie Honka?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:121
msgid "The day's blessings upon you!"
msgstr "Niech błogosławieństwa dnia spłyną na was!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:125
msgid "Better clear off before trouble finds you."
msgstr "Lepiej się stąd wynoście, zanim kłopoty was znajdą."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:127
msgid "Behold the famous Markel the Great!"
msgstr "Oto słynny Markel Wielki!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:128
msgid "You look the brave sort."
msgstr "Wyglądacie na odważnych."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:129
msgid "What a noble group I see!"
msgstr "Cóż za szlachetną grupę widzę!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:13
msgid "Good day!  The bank is the safest place for your money, you know!"
msgstr ""
"Dzień dobry! Bank to najbezpieczniejsze miejsce dla waszych pieniędzy, wiecie?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:130
msgid "I am the smartest man EVER!"
msgstr "Jestem najmądrzejszym człowiekiem W HISTORII!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:131
msgid "Hey!  Come'ere"
msgstr "Hej! Chodźcie no tu!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:132
msgid "What?!  Why have you bothered me?"
msgstr "Co?! Czemu mi przeszkadzacie?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:133
msgid "Come!  Play a game!"
msgstr "Chodźcie! Zagrajcie!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:136
msgid "Welcome.  Vita is the magic of life."
msgstr "Witajcie. Vita to magia życia."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:137
msgid "The magic of death."
msgstr "Magia śmierci."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:138 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:202 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:204
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:205 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:250 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:388
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:393 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:398 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:403
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:408 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:413
msgid "Welcome."
