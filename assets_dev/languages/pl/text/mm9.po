#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:4
msgid "We'd like to see what you have."
msgstr "Chcielibyśmy zobaczyć, co masz."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC10.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC13.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:4
