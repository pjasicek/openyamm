# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1214
msgid "Cures and prevents Weakness and induced Sleep for 6 hours."
msgstr "Излечивает и предотвращает Слабость и наведенный Сон на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1215
msgid "Cures and prevents Disease and Poison for 6 hours."
msgstr "Излечивает и предотвращает Болезнь и Отравление на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1216
msgid "Cures and prevents Curse and Paralysis for 6 hours."
msgstr "Излечивает и предотвращает Проклятие и Паралич на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1217
msgid "Cures and prevents Fear and Insanity for 6 hours."
msgstr "Излечивает и предотвращает Ужас и Безумие на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1218
msgid "Increases your Attack Speed by {haste:1}% for 6 hours."
msgstr "Увеличивает вашу скорость атаки на {haste:1}% на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1219
msgid "Increases your Melee Damage by {heroism:1}% for 6 hours."
msgstr "Увеличивает ваш урон в ближнем бою на {heroism:1}% на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1220
msgid "Increases your Attack, and your Accuracy by {stat}%, for 6 hours."
msgstr "Повышает вашу Атаку, а также Меткость на {stat}%, на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1221
msgid ""
"Reduces magic damage taken by {shield:1}% and grants Preservation for 6 hours.\n"
"Requires 20 power to work."
msgstr ""
"Снижает получаемый магический урон на {shield:1}% и дает Ангела - хранителя на 6 часов.\n"
"Действует при силе от 20."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1222
msgid "Grants <mana>{meditation}</> bonus to Meditation skill for 6 hours."
msgstr "Дает <mana>{meditation}</> к умению Медитация на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1223
msgid "Regenerates hit points for 6 hours."
msgstr "Восстанавливает здоровье в течение 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1224
msgid "Increases your Armor Class for 6 hours."
msgstr "Повышает ваш Класс защиты на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1225
msgid ""
"Prevents drowning damage for 6 hours.\n"
"Requires 20 power to work."
msgstr ""
"Предотвращает урон от утопления на 6 часов.\n"
"Действует при силе от 20."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1226
msgid "Hardens an item so that it breaks less easily."
msgstr "Закаляет предмет, чтобы он реже ломался."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1227
msgid ""
"Grants 5 charges of Protection from Magic, plus 1 for every 10 points of potion power, for 6 hours.\n"
"From 50 power it also protects from death and eradication."
msgstr ""
"Дает 5 зарядов Защиты от Магии и еще 1 за каждые 10 единиц силы зелья на 6 часов.\n"
"С силы 50 также защищает от смерти и уничтожения."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1229
msgid ""
"Adds one enchantment to an item that has none; the potion's power decides how strong it is.\n"
"Needs at least 20 power to work."
msgstr ""
"Добавляет одно зачарование предмету, у которого их нет; сила зелья определяет, насколько оно сильное.\n"
"Действует при силе не меньше 20."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1231
msgid ""
"Cures and prevents the Stoned condition for 6 hours.\n"
"Requires 20 power to work."
msgstr ""
"Излечивает и предотвращает Окаменение на 6 часов.\n"
"Действует при силе от 20."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1232
msgid "Raises Might and Accuracy by 10 plus the potion's power for 6 hours."
msgstr "Повышает Мощь и Меткость на 10 плюс сила зелья на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1233
msgid ""
"Raises Intellect and Personality by 10 plus the potion's power for 6 hours."
msgstr "Повышает Интеллект и Лидерство на 10 плюс сила зелья на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1234
msgid ""
"Raises Endurance, Speed and Luck by 10 plus the potion's power for 6 hours."
msgstr ""
"Повышает Выносливость, Скорость и Удачу на 10 плюс сила зелья на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1235
msgid ""
"Adds a random tier 2 elemental damage enchant to a weapon.\n"
"Requires 40 power to work."
msgstr ""
"Добавляет оружию случайное зачарование стихийного урона 2-го уровня.\n"
"Действует при силе от 40."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1236
msgid ""
"Gives a weapon with no enchantment the 'of Swiftness' property.\n"
"Needs 40 power to work."
msgstr ""
"Дает оружию без зачарований свойство 'Скорости'.\n"
"Действует при силе от 40."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1237
msgid ""
"Grants Haste (+{haste:1}% Attack Speed), Heroism (+{heroism:1}% Melee Damage) and Bless (+{stat}% Accuracy) for 6 hours."
msgstr ""
"Дает Ускорение (+{haste:1}% к скорости атаки), Мужество (+{heroism:1}% к урону в ближнем бою) и Благословение (+{stat}% к Меткости) на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1239
msgid ""
"Removes and prevents all conditions, except Dead and Eradication, for 6 hours.\n"
"Requires 40 power to work."
msgstr ""
"Снимает и предотвращает все состояния, кроме смерти и уничтожения, на 6 часов.\n"
"Действует при силе от 40."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1240
msgid ""
"<value>Heals {heal_large} Hit Points</>\n"
"The amount grows with the potion's power."
msgstr ""
"<value>Восстанавливает {heal_large} ед. здоровья</>\n"
"Количество растет с силой зелья."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1241
msgid ""
"<value>Restores {mana_large} Spell Points</>\n"
"The amount grows with the potion's power."
msgstr ""
"<value>Восстанавливает {mana_large} ед. маны</>\n"
"Количество растет с силой зелья."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1242
msgid ""
"Raises your Fire, Air, Water and Earth Resistance, and Intellect, Speed, Luck and Endurance by {stat}%, for 6 hours."
msgstr ""
"Повышает вашу Устойчивость к Огню, Воздуху, Воде и Земле, а также Интеллект, Скорость, Удачу и Выносливость на {stat}% на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1244
msgid ""
"Raises your Mind and Body Resistance, and Personality and Might by {stat}%, for 6 hours."
msgstr ""
"Повышает вашу Устойчивость Разума и Тела, а также Лидерство и Мощь на {stat}% на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1245
msgid ""
"Grants Shield (-{shield:1}% magic damage taken), Stone Skin and Preservation for 6 hours."
msgstr ""
"Дает Щит (-{shield:1}% получаемого магического урона), Каменную кожу и Ангела - хранителя на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1246
msgid ""
"Permanently raises Might and Accuracy by 20 for every 50 points of potion power. Only the part above the strongest potion of this kind already drunk is added.\n"
"\n"
"At this power: step {step}. Best step already drunk: {best_step}."
msgstr ""
"Навсегда повышает Мощь и Меткость на 20 за каждые 50 единиц силы зелья. Добавляется только то, что превышает самое сильное уже выпитое зелье этого вида.\n"
"\n"
"При этой силе: ступень {step}. Лучшая выпитая ступень: {best_step}."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1249
msgid ""
"Permanently raises Intellect and Personality by 20 for every 50 points of potion power. Only the part above the strongest potion of this kind already drunk is added.\n"
"\n"
"At this power: step {step}. Best step already drunk: {best_step}."
msgstr ""
"Навсегда повышает Интеллект и Лидерство на 20 за каждые 50 единиц силы зелья. Добавляется только то, что превышает самое сильное уже выпитое зелье этого вида.\n"
"\n"
"При этой силе: ступень {step}. Лучшая выпитая ступень: {best_step}."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1252
msgid ""
"Permanently raises Endurance, Speed and Luck by 20 for every 50 points of potion power. Only the part above the strongest potion of this kind already drunk is added.\n"
"\n"
"At this power: step {step}. Best step already drunk: {best_step}."
msgstr ""
"Навсегда повышает Выносливость, Скорость и Удачу на 20 за каждые 50 единиц силы зелья. Добавляется только то, что превышает самое сильное уже выпитое зелье этого вида.\n"
"\n"
"При этой силе: ступень {step}. Лучшая выпитая ступень: {best_step}."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1255
msgid ""
"Permanently adds a random tier 3 elemental damage enchant to a weapon.\n"
"Requires 50 power to work."
msgstr ""
"Навсегда добавляет оружию случайное зачарование стихийного урона 3-го уровня.\n"
"Действует при силе от 50."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1256
msgid ""
"Permanently gives a weapon with no enchantment the 'of Darkness' property.\n"
"Needs 100 power to work."
msgstr ""
"Навсегда дает оружию без зачарований свойство 'Тьмы'.\n"
"Действует при силе от 100."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1257
msgid "Increases all seven of your Statistics by {stat_light}% for 6 hours."
msgstr "Повышает все семь ваших характеристик на {stat_light}% на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1258
msgid ""
"Fixes the character's age at 60.\n"
"Requires 50 power to work."
msgstr ""
"Закрепляет возраст персонажа на 60 годах.\n"
"Действует при силе от 50."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1259
msgid ""
"Permanently grants {skill_points} skill points (step {step}; one step for every 50 points of potion power).\n"
"Only the part above the strongest potion of this kind already drunk is added.\n"
"\n"
"Best step already drunk: {best_step} ({best_skill_points} skill points)"
msgstr ""
"Навсегда дает пункты умения: {skill_points} (ступень {step}; одна ступень за каждые 50 единиц силы зелья).\n"
"Добавляется только то, что превышает самое сильное уже выпитое зелье этого вида.\n"
"\n"
"Лучшая выпитая ступень: {best_step} (пункты умения: {best_skill_points})"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:126
msgid ""
"Discharges electricity from the caster's hand to a single target. It always hits and does {add} points plus 1-{dice} points of damage per point of skill in Air Magic, then leaps to the nearest monster within reach."
msgstr ""
"Выпускает из руки мага электрический разряд в одну цель. Всегда попадает и наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Воздуха, а затем перескакивает на ближайшего монстра в пределах досягаемости."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1262
msgid ""
"Fixes the character's age at 20.\n"
"Requires 50 power to work."
msgstr ""
"Закрепляет возраст персонажа на 20 годах.\n"
"Действует при силе от 50."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1263
msgid ""
"Permanently raises Fire, Air, Water and Earth Resistance by 30 for every 50 points of potion power. Only the part above the strongest potion of this kind already drunk is added.\n"
"\n"
"At this power: step {step}. Best step already drunk: {best_step}."
msgstr ""
"Навсегда повышает Устойчивость к Огню, Воздуху, Воде и Земле на 30 за каждые 50 единиц силы зелья. Добавляется только то, что превышает самое сильное уже выпитое зелье этого вида.\n"
"\n"
"При этой силе: ступень {step}. Лучшая выпитая ступень: {best_step}."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1266
msgid ""
"Permanently raises Mind and Body Resistance by 30 for every 50 points of potion power. Only the part above the strongest potion of this kind already drunk is added.\n"
"\n"
"At this power: step {step}. Best step already drunk: {best_step}."
msgstr ""
"Навсегда повышает Устойчивость Разума и Тела на 30 за каждые 50 единиц силы зелья. Добавляется только то, что превышает самое сильное уже выпитое зелье этого вида.\n"
"\n"
"При этой силе: ступень {step}. Лучшая выпитая ступень: {best_step}."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:1269
msgid "Increases every one of your Resistances by {protection} for 6 hours."
msgstr "Повышает каждую вашу Устойчивость на {protection} на 6 часов."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:129
msgid "Hits one monster"
msgstr "Поражает одного монстра"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:130
msgid "Hits up to 2 monsters"
msgstr "Поражает до 2 монстров"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:131
msgid "Hits up to 3 monsters"
msgstr "Поражает до 3 монстров"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:132
msgid "Hits up to 4 monsters"
msgstr "Поражает до 4 монстров"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:134
msgid "Duration 22.5 minutes + 1.5 minutes per point of skill"
msgstr "Длительность 22.5 минуты + 1.5 минуты за пункт умения"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:135
msgid "Duration 45 minutes + 3 minutes per point of skill"
msgstr "Длительность 45 минут + 3 минуты за пункт умения"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:137
msgid ""
"Implosion destroys the air around a single target, causing a sudden inrush from the surrounding air, a thunderclap, and {add} points plus 1-{dice} points of damage per point of skill in Air Magic."
msgstr ""
"Коллапс уничтожает воздух вокруг одной цели, вызывая внезапный приток окружающего воздуха, раскат грома и {add} урона плюс 1-{dice} за каждый пункт умения Магия Воздуха."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:141
msgid ""
"Grants the power of flight to your characters! This spell is very expensive and only works outdoors, but it is very useful. Fly will drain one spell point every five minutes it is in use (i.e. when you aren't touching the ground). On Hard and harder difficulties, and in Austerity, attacking a monster ends it, except on a few maps."
msgstr ""
"Дает вашим персонажам способность летать! Заклинание стоит очень дорого и работает только под открытым небом, но очень полезно. Полет отнимает 1 пункт маны за каждые пять минут в воздухе (когда вы не касаетесь земли). На Трудной и более высокой сложности, а также в Аскезе атака на монстра прерывает полет, кроме нескольких карт."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:146
msgid ""
"Calls stars from the heavens to smite and burn your enemies. Twenty stars are called, and the damage for each star is {add} points plus {dice} per point of skill in Air Magic. Try not to get caught in the blast! This spell only works outdoors."
msgstr ""
"Обрушивает на головы врагов звезды с неба. Падает двадцать звезд, и каждая наносит {add} урона плюс {dice} за каждый пункт умения Магия Воздуха. Постарайтесь не оказаться под ударом сами! Заклинание работает только под открытым небом."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:153
msgid ""
"Sprays poison at monsters directly in front of your characters. Damage is low, but few monsters have resistance to Water Magic, so it usually works. Each shot does {add} points of damage plus 1-{dice} per point of skill."
msgstr ""
"Распыляет яд на монстров прямо перед вашими персонажами. Урон невелик, но мало у каких монстров есть устойчивость к Магии Воды, так что обычно оно срабатывает. Каждый выстрел наносит {add} урона плюс 1-{dice} за каждый пункт умения."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:157
msgid ""
"An aura: raises your party's Water Resistance by <good>{aura_flat}</> and Luck by <good>{aura_stat}</> %. Grows with your Water Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает Устойчивость к Воде вашего отряда на <good>{aura_flat}</> и Удачу на <good>{aura_stat}</> %. Растет с умением Магия Воды (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:165
msgid ""
"Fires a bolt of ice at a single target. The missile does {add} + 1-{dice} points of damage per point of skill in Water Magic."
msgstr ""
"Выпускает в одну цель ледяную стрелу. Стрела наносит {add} + 1-{dice} урона за каждый пункт умения Магия Воды."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:169
msgid ""
"An aura: only useful outdoors, Water Walk lets your characters walk along the surface of water without sinking."
msgstr ""
"Аура: полезна только под открытым небом; Хождение по Воде позволяет вашим персонажам ходить по воде, не погружаясь."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:176
msgid "Empower Magic"
msgstr "Усиление Магии"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:177
msgid ""
"An aura: your party's damage spells deal <good>{aura_percent:1}</> % more damage. Grows with your Water Magic skill (counted up to 50)."
msgstr ""
"Аура: атакующие заклинания вашего отряда наносят на <good>{aura_percent:1}</> % больше урона. Растет с умением Магия Воды (учитывается до 50)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:185
msgid ""
"Acid Burst squirts a jet of extremely caustic acid at a single victim. It always hits and does {add} points of damage plus 1-{dice} per point of skill."
msgstr ""
"Всплеск Кислоты выбрызгивает струю едкой кислоты в одну жертву. Всегда попадает и наносит {add} урона плюс 1-{dice} за каждый пункт умения."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:189
msgid ""
"Fires a ball of ice in the direction the caster is facing. The ball shatters when it hits something, launching 7 shards of ice in all directions except the caster's. Each shard does {add} points of damage plus 1-{dice} per point of skill in Water Magic."
msgstr ""
"Выпускает ледяной шар в направлении, куда смотрит маг. Попав во что-нибудь, шар разлетается на 7 ледяных осколков во все стороны, кроме стороны мага. Каждый осколок наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Воды."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:196
msgid ""
"Slaps a monster with magical force, forcing it to recover from the stun spell before it can do anything else. Stun also knocks monsters back a little. The greater your skill in Earth Magic, the more likely it takes hold of strong monsters."
msgstr ""
"Бьет монстра магической силой, и тот должен оправиться от оглушения, прежде чем сможет что-либо сделать. Шок также немного отбрасывает монстров. Чем выше ваше умение Магия Земли, тем вероятнее, что заклинание подействует на сильных монстров."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:201
msgid ""
"Halves the walking speed and doubles the recovery rate of a single monster. Ascension lengthens it; the monster's Earth resistance shortens it."
msgstr ""
"Вдвое снижает скорость передвижения одного монстра и вдвое увеличивает его время восстановления. Возвышение продлевает действие, устойчивость монстра к Земле сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:204 assets_dev\engine\rulesets\maw\data\texts.yml:205 assets_dev\engine\rulesets\maw\data\texts.yml:266
#: assets_dev\engine\rulesets\maw\data\texts.yml:267 assets_dev\engine\rulesets\maw\data\texts.yml:268 assets_dev\engine\rulesets\maw\data\texts.yml:269
#: assets_dev\engine\rulesets\maw\data\texts.yml:333 assets_dev\engine\rulesets\maw\data\texts.yml:334 assets_dev\engine\rulesets\maw\data\texts.yml:335
#: assets_dev\engine\rulesets\maw\data\texts.yml:341 assets_dev\engine\rulesets\maw\data\texts.yml:342 assets_dev\engine\rulesets\maw\data\texts.yml:343
#: assets_dev\engine\rulesets\maw\data\texts.yml:350 assets_dev\engine\rulesets\maw\data\texts.yml:351 assets_dev\engine\rulesets\maw\data\texts.yml:360
#: assets_dev\engine\rulesets\maw\data\texts.yml:437 assets_dev\engine\rulesets\maw\data\texts.yml:438 assets_dev\engine\rulesets\maw\data\texts.yml:439
#: assets_dev\engine\rulesets\maw\data\texts.yml:440 assets_dev\engine\rulesets\maw\data\texts.yml:494 assets_dev\engine\rulesets\maw\data\texts.yml:507
#: assets_dev\engine\rulesets\maw\data\texts.yml:508 assets_dev\engine\rulesets\maw\data\texts.yml:509 assets_dev\engine\rulesets\maw\data\texts.yml:521
#: assets_dev\engine\rulesets\maw\data\texts.yml:522 assets_dev\engine\rulesets\maw\data\texts.yml:552 assets_dev\engine\rulesets\maw\data\texts.yml:553
#: assets_dev\engine\rulesets\maw\data\texts.yml:561 assets_dev\engine\rulesets\maw\data\texts.yml:562
msgid "Lasts <good>{cc_seconds:1}</> seconds"
msgstr "Длится <good>{cc_seconds:1}</> сек."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:206
msgid "Lasts <good>{cc_seconds:1}</> seconds, monster slows to 1/4 speed"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., монстр замедляется до 1/4 скорости"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:207
msgid "Lasts <good>{cc_seconds:1}</> seconds, monster slows to 1/8 speed"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., монстр замедляется до 1/8 скорости"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:209
msgid ""
"An aura: raises your party's Earth Resistance by <good>{aura_flat}</> and Endurance by <good>{aura_stat}</> %. Grows with your Earth Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает Устойчивость к Земле вашего отряда на <good>{aura_flat}</> и Выносливость на <good>{aura_stat}</> %. Растет с умением Магия Земли (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:217
msgid ""
"Summons a swarm of biting, stinging insects to bedevil a single target. The swarm does {add} points of damage plus 1-{dice} per point of skill in Earth Magic."
msgstr ""
"Призывает рой кусачих, жалящих насекомых, чтобы извести одну цель. Рой наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Земли."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:221
msgid ""
"An aura: raises your party's Armor Class by <good>{aura_flat}</>. Grows with your Earth Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает Класс защиты вашего отряда на <good>{aura_flat}</>. Растет с умением Магия Земли (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:229
msgid ""
"Fires a rotating, razor-thin metal blade at a single monster. The blade does {add} + 1-{dice} points of damage per point of skill in Earth Magic. Blades is the only spell that deals physical damage."
msgstr ""
"Выпускает в одного монстра вращающееся, тонкое как бритва металлическое лезвие. Лезвие наносит {add} + 1-{dice} урона за каждый пункт умения Магия Земли. Лезвия — единственное заклинание, наносящее физический урон."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:233
msgid ""
"Releases a magical stone that explodes when it comes into contact with a creature or enough time passes. The explosion causes {add} points of damage plus 1-{dice} per point of skill in Earth Magic."
msgstr ""
"Выпускает волшебный камень, который взрывается при соприкосновении с существом или по прошествии времени. Взрыв наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Земли."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:237
msgid ""
"Launches a magical stone which bursts in air, sending shards of explosive earth raining to the ground. Each shard does {add} + 1-{dice} points of damage per point of skill in Earth Magic. This spell only works outdoors."
msgstr ""
"Запускает волшебный камень, который разрывается в воздухе и обрушивает на землю дождь взрывчатых осколков. Каждый осколок наносит {add} + 1-{dice} урона за каждый пункт умения Магия Земли. Заклинание работает только под открытым небом."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:241
msgid ""
"Increases the weight of a single target enormously for an instant, causing internal damage of <good>{hp_share:1}</> % of the monster's current hit points: 15 % plus 0.5 % per point of skill in Earth Magic. Harder difficulties lessen it. The bigger they are, the harder they fall."
msgstr ""
"На мгновение невероятно увеличивает вес одной цели, нанося внутренний урон в размере <good>{hp_share:1}</> % текущего здоровья монстра: 15 % плюс 0.5 % за каждый пункт умения Магия Земли. Более высокая сложность ослабляет эффект. Чем больше шкаф, тем громче падает."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:248
msgid ""
"An aura: raises your party's attack by <good>{aura_flat}</> and Accuracy by <good>{aura_stat}</> %, and their chance to hit. Grows with your Spirit Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает атаку вашего отряда на <good>{aura_flat}</> и Меткость на <good>{aura_stat}</> %, а также шанс попасть. Растет с умением Магия Духа (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:256
msgid ""
"An aura: raises your party's chance of a critical hit by <good>{aura_percent:1}</> %. Grows with your Spirit Magic skill (counted up to 50)."
msgstr ""
"Аура: повышает шанс критического удара вашего отряда на <good>{aura_percent:1}</> %. Растет с умением Магия Духа (учитывается до 50)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:26
msgid ""
"An aura: increases the radius of light surrounding your party in the dark, brighter with each mastery of Fire Magic."
msgstr ""
"Аура: увеличивает радиус света вокруг вашего отряда в темноте; свет ярче с каждым рангом мастерства Магии Огня."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:264
msgid ""
"Forces all visible undead monsters to flee. Ascension lengthens it; the monsters' Spirit resistance shortens it."
msgstr ""
"Заставляет всю видимую нежить обратиться в бегство. Возвышение продлевает действие, устойчивость монстров к Духу сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:271
msgid ""
"Heals a character and removes the cursed condition if you cast it in time: Expert works if cursed less than one hour per point of skill, Master one day per point, Grandmaster at any time."
msgstr ""
"Исцеляет персонажа и снимает проклятие, если применить заклинание вовремя: Эксперт — если проклятие длится меньше часа за каждый пункт умения, Магистр — дня за пункт, Великий Мастер — в любое время."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:275 assets_dev\engine\rulesets\maw\data\texts.yml:276 assets_dev\engine\rulesets\maw\data\texts.yml:277
#: assets_dev\engine\rulesets\maw\data\texts.yml:304 assets_dev\engine\rulesets\maw\data\texts.yml:366 assets_dev\engine\rulesets\maw\data\texts.yml:367
#: assets_dev\engine\rulesets\maw\data\texts.yml:368 assets_dev\engine\rulesets\maw\data\texts.yml:369 assets_dev\engine\rulesets\maw\data\texts.yml:405
#: assets_dev\engine\rulesets\maw\data\texts.yml:406 assets_dev\engine\rulesets\maw\data\texts.yml:422
msgid ""
"Heals <good>{heal_base}</> + <good>{heal_per}</> hit points per point of skill"
msgstr ""
"Исцеляет <good>{heal_base}</> + <good>{heal_per}</> ед. здоровья за каждый пункт умения"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:279
msgid ""
"An aura: tightly binds every character's soul to the body. This delays death due to massive hit point loss, but will not stop a character from going unconscious."
msgstr ""
"Аура: крепко привязывает душу каждого персонажа к телу. Это отсрочивает смерть от большой потери здоровья, но не спасает персонажа от потери сознания."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:287
msgid ""
"An aura: your characters' melee attacks deal <good>{aura_percent:1}</> % more damage. Grows with your Spirit Magic skill (counted up to 50)."
msgstr ""
"Аура: атаки ваших персонажей в ближнем бою наносят на <good>{aura_percent:1}</> % больше урона. Растет с умением Магия Духа (учитывается до 50)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:295
msgid ""
"Weakens the link between a target's body and soul, causing {add} + 2-{dice} points of damage per point of skill in Spirit Magic to all monsters near the caster."
msgstr ""
"Ослабляет связь между телом и душой, нанося {add} + 2-{dice} урона за каждый пункт умения Магия Духа всем монстрам рядом с магом."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:299
msgid "Removes death and eradication with no time limit"
msgstr "Снимает смерть и уничтожение без ограничения по времени"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:301 assets_dev\engine\rulesets\maw\data\texts.yml:302
msgid ""
"Adds <good>{heal_base}</> + <good>{heal_per}</> hit points per two points of skill to the pool"
msgstr ""
"Добавляет в общий запас <good>{heal_base}</> + <good>{heal_per}</> ед. здоровья за каждые два пункта умения"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:307
msgid ""
"An aura: your party regains spell points over time. The rate grows with each character's mana pool, with your level and with your Mind Magic skill (counted up to 50), and quickens out of combat."
msgstr ""
"Аура: ваш отряд со временем восстанавливает ману. Скорость растет с запасом маны каждого персонажа, с вашим уровнем и с умением Магия Разума (учитывается до 50) и увеличивается вне боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:317
msgid ""
"An aura: raises your party's Mind Resistance by <good>{aura_flat}</> and Personality by <good>{aura_stat}</> %. Grows with your Mind Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает Устойчивость Разума вашего отряда на <good>{aura_flat}</> и Лидерство на <good>{aura_stat}</> %. Растет с умением Магия Разума (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:325
msgid ""
"Fires a bolt of mental force which damages a single target's nervous system. Mind Blast does {add} points of damage plus 1-{dice} per point of skill in Mind Magic."
msgstr ""
"Выпускает сгусток ментальной силы, поражающий нервную систему одной цели. Телепатический Удар наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Разума."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:329
msgid ""
"Calms a single targeted creature and removes any hostile feelings it has towards your characters. If it takes damage, it becomes hostile again. Ascension lengthens it; the monster's Mind resistance shortens it."
msgstr ""
"Успокаивает выбранное существо и снимает всякую враждебность к вашим персонажам. Получив урон, оно снова становится враждебным. Возвышение продлевает действие, устойчивость монстра к Разуму сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:337
msgid ""
"Causes a single monster to go mad with battle lust, attacking the nearest living creature until the spell wears off. Ascension lengthens it; the monster's Mind resistance shortens it."
msgstr ""
"Пробуждает в одном монстре безумную жажду битвы: он нападает на ближайшее живое существо, пока действие заклинания не закончится. Возвышение продлевает действие, устойчивость монстра к Разуму сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:34
msgid ""
"Launches a burst of fire at a single target. Damage is {add} + 1-{dice} points per point of skill in Fire Magic. Fire Bolt is safe, effective and has a low casting cost."
msgstr ""
"Выпускает в одну цель сгусток огня. Урон: {add} + 1-{dice} за каждый пункт умения Магия Огня. Огненная Стрела безопасна, эффективна и дешева."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:345
msgid ""
"All creatures in the caster's sight fear the caster and flee. Ascension lengthens it; the monsters' Mind resistance shortens it."
msgstr ""
"Все существа в поле зрения мага боятся его и бегут. Возвышение продлевает действие, устойчивость монстров к Разуму сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:353
msgid ""
"Targets a single creature with mind damaging magic. Psychic Shock does {add} points of damage plus 1-{dice} per point of skill in Mind Magic."
msgstr ""
"Поражает одно существо магией, разрушающей разум. Психошок наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Разума."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:357
msgid ""
"Takes control of a target's mind; enslaved creatures fight monsters that are hostile to the caster. Ascension lengthens it; the monster's Mind resistance shortens it."
msgstr ""
"Подчиняет себе разум цели; порабощенные существа сражаются с монстрами, враждебными магу. Возвышение продлевает действие, устойчивость монстра к Разуму сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:364
msgid "Heals a single character. Your Personality adds to every heal."
msgstr "Исцеляет одного персонажа. Ваше Лидерство усиливает каждое исцеление."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:371
msgid ""
"An aura: raises your party's Body Resistance by <good>{aura_flat}</> and Might by <good>{aura_stat}</> %. Grows with your Body Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает Устойчивость Тела вашего отряда на <good>{aura_flat}</> и Мощь на <good>{aura_stat}</> %. Растет с умением Магия Тела (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:379
msgid ""
"Directly inflicts magical damage upon a single creature. Harm does {add} points of damage plus 1-{dice} per point of skill in Body Magic."
msgstr ""
"Напрямую наносит одному существу магический урон. Вред наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Тела."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:38
msgid ""
"An aura: raises your party's Fire Resistance by <good>{aura_flat}</> and Intellect by <good>{aura_stat}</> %. Grows with your Fire Magic skill (counted up to 50) and with your level."
msgstr ""
"Аура: повышает Устойчивость к Огню вашего отряда на <good>{aura_flat}</> и Интеллект на <good>{aura_stat}</> %. Растет с умением Магия Огня (учитывается до 50) и с вашим уровнем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:383
msgid ""
"An aura: your party regains hit points over time. The rate grows with each character's hit points, with your level and with your Body Magic skill (counted up to 50), and quickens out of combat."
msgstr ""
"Аура: ваш отряд со временем восстанавливает здоровье. Скорость растет со здоровьем каждого персонажа, с вашим уровнем и с умением Магия Тела (учитывается до 50) и увеличивается вне боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:391
msgid ""
"An aura: your characters' unarmed blows deal <good>{aura_percent:1}</> % more damage. Grows with your Body Magic skill (counted up to 50)."
msgstr ""
"Аура: удары ваших персонажей без оружия наносят на <good>{aura_percent:1}</> % больше урона. Растет с умением Магия Тела (учитывается до 50)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:400
msgid ""
"Heals a single character and cures disease if you cast it in time: Master works if diseased less than one day per point of skill, Grandmaster at any time."
msgstr ""
"Исцеляет одного персонажа и излечивает болезнь, если применить заклинание вовремя: Магистр — если болезнь длится меньше дня за каждый пункт умения, Великий Мастер — в любое время."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:408
msgid ""
"An aura: your whole party is immune to spells and monster abilities that cause Poison, Disease, Stone, Paralysis, Weakness, Death and Eradication."
msgstr ""
"Аура: весь ваш отряд невосприимчив к заклинаниям и способностям монстров, вызывающим Отравление, Болезнь, Окаменение, Паралич, Слабость, Смерть и Уничтожение."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:416
msgid ""
"Flying Fist throws a heavy magical force at a single opponent that does {add} points of damage plus 1-{dice} per point of skill in Body Magic."
msgstr ""
"Летающий Кулак обрушивает на одного противника тяжелую магическую силу, нанося {add} урона плюс 1-{dice} за каждый пункт умения Магия Тела."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:420
msgid ""
"Heals every character in your party at once. Your Personality adds to every heal."
msgstr ""
"Исцеляет сразу всех персонажей вашего отряда. Ваше Лидерство усиливает каждое исцеление."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:426
msgid ""
"Fires a bolt of light at a single target that does {add} + 1-{dice} points of damage per point of skill in Light Magic. Damage against undead is doubled."
msgstr ""
"Выпускает в одну цель стрелу света, наносящую {add} + 1-{dice} урона за каждый пункт умения Магия Света. Урон по нежити удваивается."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:430
msgid ""
"Undoes the evil magic that extends the lives of the undead, inflicting {add} points of damage plus 1-{dice} per point of skill in Light Magic upon a single target. This spell only works on the undead."
msgstr ""
"Разрушает злую магию, продлевающую жизнь нежити, нанося одной цели {add} урона плюс 1-{dice} за каждый пункт умения Магия Света. Заклинание действует только на нежить."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:434
msgid ""
"Paralyze prevents a monster from moving or attacking. Ascension lengthens it; the monster's Light resistance shortens it; bosses are held half as long."
msgstr ""
"Паралич не дает монстру двигаться и атаковать. Возвышение продлевает действие, устойчивость монстра к Свету сокращает его; боссы парализуются вдвое короче."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:442
msgid ""
"An aura: raises all seven stats of your characters by <good>{dog_stat:1}</> %. Grows with your Light Magic skill (counted up to 75); the resistance auras' stat bonuses do not add to it."
msgstr ""
"Аура: повышает все семь характеристик ваших персонажей на <good>{dog_stat:1}</> %. Растет с умением Магия Света (учитывается до 75); бонусы аур устойчивости к характеристикам к нему не прибавляются."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:450
msgid ""
"Inflicts {add} points of damage plus {dice} per point of skill in Light Magic on all creatures in sight. This spell can only be cast indoors."
msgstr ""
"Наносит {add} урона плюс {dice} за каждый пункт умения Магия Света всем существам в поле зрения. Заклинание можно применять только в помещении."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:454
msgid ""
"An aura: raises all six of your party's resistances by <good>{dop_flat}</>. Grows with your Light Magic skill (counted up to 75) and with your level; a stronger resistance aura counts instead."
msgstr ""
"Аура: повышает все шесть устойчивостей вашего отряда на <good>{dop_flat}</>. Растет с умением Магия Света (учитывается до 75) и с вашим уровнем; если аура устойчивости сильнее, действует она."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:46
msgid ""
"An aura: your party's weapons burn with a magical fire on top of their other enchantments. Every blow and arrow adds a share of the weapon's level damage as fire, more on slow weapons, and the weapons in hand add it to every damage spell (40 % of it on area spells). The minimum is doubled on two-handed weapons."
msgstr ""
"Аура: оружие вашего отряда горит магическим огнем поверх прочих зачарований. Каждый удар и каждая стрела добавляют огнем долю урона по уровню оружия, больше у медленного оружия, а оружие в руках добавляет его к каждому атакующему заклинанию (40 % от него для заклинаний по области). У двуручного оружия минимум удваивается."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:462
msgid ""
"An aura: gives your party Haste (<good>{hop_haste:1}</> %), Shield (<good>{hop_shield:1}</> %), Stone Skin (+<good>{hop_armor}</> Armor Class) and Fate (<good>{hop_fate:1}</> %) at two thirds of your Light Magic skill (counted up to 75); a stronger aura of its own counts instead."
msgstr ""
"Аура: дает вашему отряду Ускорение (<good>{hop_haste:1}</> %), Щит (<good>{hop_shield:1}</> %), Каменную кожу (+<good>{hop_armor}</> к Классу защиты) и Рок (<good>{hop_fate:1}</> %) в размере двух третей вашего умения Магия Света (учитывается до 75); если собственная аура сильнее, действует она."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:471
msgid ""
"Concentrates the light of the sun on one unfortunate creature, doing {add} points of damage plus 1-{dice} per point of skill in Light Magic. Indoors it can be cast at any time; outdoors it only works during the day."
msgstr ""
"Сосредотачивает солнечный свет на одном несчастном существе, нанося {add} урона плюс 1-{dice} за каждый пункт умения Магия Света. В помещении заклинание можно применять в любое время, под открытым небом — только днем."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:477
msgid ""
"A poisonous cloud of noxious gases is formed in front of the caster and moves slowly away from your characters. The cloud does {add} points of damage plus 1-{dice} per point of skill in Dark Magic and lasts until something runs into it."
msgstr ""
"Перед магом образуется ядовитое облако вредоносных газов и медленно удаляется от ваших персонажей. Облако наносит {add} урона плюс 1-{dice} за каждый пункт умения Магия Тьмы и существует, пока на него кто-нибудь не наткнется."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:483
msgid ""
"An aura: your party's attacks heal the attacker by part of the damage they deal, up to his or her normal hit point maximum: 5 % of melee damage, 2.5 % of missile and spell damage."
msgstr ""
"Аура: атаки вашего отряда исцеляют атакующего на часть нанесенного урона, но не выше его обычного максимума здоровья: 5 % урона в ближнем бою, 2.5 % урона снарядами и заклинаниями."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:491
msgid ""
"Shrinks even the grandest of monsters down to more manageable sizes. Ascension lengthens it; the monster's Dark resistance shortens it."
msgstr ""
"Уменьшает даже величайших монстров до более удобных размеров. Возвышение продлевает действие, устойчивость монстра к Тьме сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:495
msgid ""
"Lasts <good>{cc_seconds:1}</> seconds, also shrinks 1 more monster near the target"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., также уменьшает еще 1 монстра рядом с целью"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:496
msgid ""
"Lasts <good>{cc_seconds:1}</> seconds, also shrinks 2 more monsters near the target"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., также уменьшает еще 2 монстров рядом с целью"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:497
msgid ""
"Lasts <good>{cc_seconds:1}</> seconds, also shrinks 3 more monsters near the target"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., также уменьшает еще 3 монстров рядом с целью"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:499
msgid ""
"Fires a blast of hot, jagged metal in front of the caster, striking any creature that gets in the way. Each piece inflicts {add} + 1-{dice} points of damage per point of skill in Dark Magic."
msgstr ""
"Выпускает перед магом заряд раскаленного зазубренного металла, поражающий всех существ на пути. Каждый осколок наносит {add} + 1-{dice} урона за каждый пункт умения Магия Тьмы."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:50
msgid "10 % of the weapon's level damage, at least 3"
msgstr "10 % урона по уровню оружия, не меньше 3"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:503
msgid ""
"Takes control of an undead target's mind; controlled undead fight monsters that are hostile to the caster. Ascension lengthens it; the monster's Dark resistance shortens it."
msgstr ""
"Подчиняет себе разум нежити; подчиненная нежить сражается с монстрами, враждебными магу. Возвышение продлевает действие, устойчивость монстра к Тьме сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:51
msgid "15 % of the weapon's level damage, at least 6"
msgstr "15 % урона по уровню оружия, не меньше 6"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:511
msgid ""
"An aura: when a monster hits a character, the monster takes damage equal to what it inflicted."
msgstr ""
"Аура: когда монстр бьет персонажа, монстр получает столько же урона, сколько нанес."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:518
msgid ""
"Surrounds its target with the power of raw darkness, rendering it unable to fire missile attacks or cast spells, and slowing it. Ascension lengthens it; the monster's Dark resistance shortens it."
msgstr ""
"Окутывает цель силой чистой тьмы, лишая ее возможности стрелять и колдовать, и замедляет ее. Возвышение продлевает действие, устойчивость монстра к Тьме сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:52
msgid "20 % of the weapon's level damage, at least 12"
msgstr "20 % урона по уровню оружия, не меньше 12"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:524
msgid ""
"Dragon Breath empowers the caster to exhale a cloud of toxic vapors that targets a single monster and damages all creatures nearby, doing {add} + 1-{dice} points of damage per point of skill in Dark Magic."
msgstr ""
"Дыхание Дракона позволяет магу выдохнуть облако ядовитых паров, которое поражает выбранного монстра и всех существ поблизости, нанося {add} + 1-{dice} урона за каждый пункт умения Магия Тьмы."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:528
msgid ""
"This spell is the town killer. Armageddon inflicts {add} points of damage plus {dice} for every point of Dark skill to every creature on the map, including all your characters. It can only be cast three times per day and only outdoors."
msgstr ""
"Это заклинание — убийца городов. Армагеддон наносит {add} урона плюс {dice} за каждый пункт умения Магия Тьмы всем существам на карте, включая всех ваших персонажей. Его можно применять только три раза в день и только под открытым небом."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:53
msgid "25 % of the weapon's level damage, at least 24"
msgstr "25 % урона по уровню оружия, не меньше 24"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:533
msgid ""
"Sucks the life from all creatures in sight, friend or enemy, and gives it to your party in much the same fashion as Shared Life. Damage and healing are {add} + 1-{dice} per point of skill."
msgstr ""
"Высасывает жизнь из всех существ в поле зрения, друзей и врагов, и передает ее вашему отряду, почти как Разделение Жизни. Урон и исцеление: {add} + 1-{dice} за каждый пункт умения."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:539
msgid ""
"Grants the Dark Elf the power to wield Darkfire, a combination of the powers of Dark and Fire. The target resists with its Fire or Dark resistance, whichever is lower. Damage is {add} points plus 1-{dice} per point of skill."
msgstr ""
"Дает Темному Эльфу власть над Темным Огнем — сочетанием сил Тьмы и Огня. Цель сопротивляется своей устойчивостью к Огню или к Тьме, смотря какая ниже. Урон: {add} плюс 1-{dice} за каждый пункт умения."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:543
msgid ""
"Lifedrain damages the target and heals the vampire by a third of the damage done. It does {add} + 1-{dice} points of damage per point of skill."
msgstr ""
"Вытягивание Жизни ранит цель и исцеляет вампира на треть нанесенного урона. Наносит {add} + 1-{dice} урона за каждый пункт умения."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:546 assets_dev\engine\rulesets\maw\data\texts.yml:547
msgid "Damage {mastery_add} + 1-<good>{mastery_dice}</> per point of skill"
msgstr "Урон {mastery_add} + 1-<good>{mastery_dice}</> за пункт умения"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:549
msgid ""
"A vampire using this ability can charm a small group of targets in close proximity. Ascension lengthens it; the monsters' resistance shortens it."
msgstr ""
"Вампир с этой способностью может очаровать небольшую группу целей, стоящих рядом. Возвышение продлевает действие, устойчивость монстров сокращает его."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:55
msgid ""
"An aura: your characters recover <good>{aura_percent:1}</> % faster from attacks and spells. Grows with your Fire Magic skill (counted up to 50)."
msgstr ""
"Аура: ваши персонажи быстрее на <good>{aura_percent:1}</> % восстанавливаются после атак и заклинаний. Растет с умением Магия Огня (учитывается до 50)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:555
msgid ""
"Mistform cuts the physical damage the vampire takes by 75 %. A vampire in Mistform cannot perform physical attacks but can use spells and abilities."
msgstr ""
"Превращение в Туман снижает получаемый вампиром физический урон на 75 %. Вампир в облике тумана не может совершать физические атаки, но может применять заклинания и способности."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:559
msgid "Strikes fear into the dragon's opponents, which flee in panic."
msgstr "Вселяет ужас в противников дракона, и те в панике бегут."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:563
msgid "Lasts <good>{cc_seconds:1}</> seconds, affects all creatures nearby"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., действует на всех существ поблизости"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:564
msgid ""
"Lasts <good>{cc_seconds:1}</> seconds, affects all creatures within view"
msgstr ""
"Длится <good>{cc_seconds:1}</> сек., действует на всех существ в поле зрения"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:566
msgid ""
"An upgraded version of the dragon's breath. It acts much like a fireball, striking its target and exploding out to hit everything near it."
msgstr ""
"Усиленная версия дыхания дракона. Действует почти как огненный шар: поражает цель и взрывается, задевая всех вокруг."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:569 assets_dev\engine\rulesets\maw\data\texts.yml:570
msgid "Deals 70 % of breath damage"
msgstr "Наносит 70 % урона дыхания"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:571
msgid "Deals 85 % of breath damage"
msgstr "Наносит 85 % урона дыхания"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:572
msgid "Deals the full breath damage"
msgstr "Наносит полный урон дыхания"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:578
msgid ""
"Exclusive to Death Knights: deals <good>{percent}</> % of your weapon damage to a single target and slows it."
msgstr ""
"Только для Рыцарей смерти: наносит одной цели <good>{percent}</> % урона вашего оружия и замедляет ее."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:580 assets_dev\engine\rulesets\maw\data\texts.yml:582 assets_dev\engine\rulesets\maw\data\texts.yml:589
#: assets_dev\engine\rulesets\maw\data\texts.yml:590 assets_dev\engine\rulesets\maw\data\texts.yml:618 assets_dev\engine\rulesets\maw\data\texts.yml:619
#: assets_dev\engine\rulesets\maw\data\texts.yml:624 assets_dev\engine\rulesets\maw\data\texts.yml:625 assets_dev\engine\rulesets\maw\data\texts.yml:626
#: assets_dev\engine\rulesets\maw\data\texts.yml:641
msgid "Deals <good>{percent}</> % of weapon damage"
msgstr "Наносит <good>{percent}</> % урона оружия"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:581
msgid "Monster slows to 1/2 speed"
msgstr "Монстр замедляется до 1/2 скорости"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:585
msgid ""
"The strongest single-target spell of the Death Knight: deals <good>{percent}</> % of your weapon damage."
msgstr ""
"Сильнейшее заклинание Рыцаря смерти против одной цели: наносит <good>{percent}</> % урона вашего оружия."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:592
msgid ""
"Throws an ice bomb that shatters on hitting something, best against big foes or groups. Each hit deals <good>{percent}</> % of your weapon damage."
msgstr ""
"Бросает ледяную бомбу, которая разлетается при попадании; лучше всего против крупных врагов или групп. Каждое попадание наносит <good>{percent}</> % урона вашего оружия."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:598
msgid "Each hit deals <good>{percent}</> % of weapon damage"
msgstr "Каждое попадание наносит <good>{percent}</> % урона оружия"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:600
msgid ""
"A switch: while it is on, your attacks leech life, at 6 spell points a hit."
msgstr ""
"Переключатель: пока он включен, ваши атаки похищают жизнь, по 6 пунктов маны за удар."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:602 assets_dev\engine\rulesets\maw\data\texts.yml:603 assets_dev\engine\rulesets\maw\data\texts.yml:604
#: assets_dev\engine\rulesets\maw\data\texts.yml:605
msgid "Leeches <good>{blood_leech}</> hit points"
msgstr "Похищает <good>{blood_leech}</> ед. здоровья"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:607
msgid ""
"A switch: while it is on, your attacks leech twice as much life as Blood Leech, at 12 spell points a hit."
msgstr ""
"Переключатель: пока он включен, ваши атаки похищают вдвое больше жизни, чем Кровавая Пиявка, по 12 пунктов маны за удар."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:612
msgid "Leeches <good>{blood_leech*2}</> hit points"
msgstr "Похищает <good>{blood_leech*2}</> ед. здоровья"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:614
msgid ""
"Asphyxiates the target, dealing <good>{percent}</> % of your weapon damage and leaving it unable to act for a moment."
msgstr ""
"Душит цель, нанося <good>{percent}</> % урона вашего оружия, и на мгновение лишает ее возможности действовать."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:621
msgid ""
"A deadly bolt that deals <good>{percent}</> % of your weapon damage and heals you on a hit by twice your life leech."
msgstr ""
"Смертоносный снаряд, который наносит <good>{percent}</> % урона вашего оружия и при попадании лечит вас на удвоенную величину вашего похищения жизни."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:628
msgid ""
"A switch: while it is on, your attacks weaken the monsters you hit, at 15 spell points a hit."
msgstr ""
"Переключатель: пока он включен, ваши атаки ослабляют монстров, по которым вы попадаете, по 15 пунктов маны за удар."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:63
msgid ""
"Fires a ball of fire at a single target. When it hits, the ball explodes damaging all those nearby, including your characters if they're too close. Fireball does 1-{dice} points of damage per point of skill in Fire Magic."
msgstr ""
"Выпускает огненный шар в одну цель. При попадании шар взрывается, поражая всех поблизости, включая ваших персонажей, если они слишком близко. Огненный Шар наносит 1-{dice} ед. урона за каждый пункт умения Магии Огня."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:635
msgid ""
"A lethal explosion dealing <good>{percent}</> % of your weapon damage to every monster in the area. Safe to use in close combat."
msgstr ""
"Смертоносный взрыв, наносящий <good>{percent}</> % урона вашего оружия всем монстрам в области. Безопасен в ближнем бою."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:645
msgid ""
"Fires a ball of fire at a single target. When it hits, the ball explodes damaging all those nearby. Fireball deals <good>{percent}</> % of a melee blow's damage."
msgstr ""
"Выпускает огненный шар в одну цель. При попадании шар взрывается, поражая всех поблизости. Огненный Шар наносит <good>{percent}</> % урона удара ближнего боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:653
msgid ""
"Drops a Fire Spike on the ground that waits for a creature to get near it before exploding. Fire Spike deals <good>{percent}</> % of a melee blow's damage."
msgstr ""
"Оставляет на земле Огненный Шип, который ждет, пока к нему приблизится существо, и тогда взрывается. Огненный Шип наносит <good>{percent}</> % урона удара ближнего боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:661
msgid ""
"Discharges electricity from the caster's hand to a single target. It always hits and deals <good>{percent}</> % of a melee blow's damage, then leaps to the nearest monster within reach."
msgstr ""
"Посылает электрический разряд из руки заклинателя в одну цель. Всегда попадает и наносит <good>{percent}</> % урона удара ближнего боя, а затем перескакивает на ближайшего монстра в пределах досягаемости."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:665
msgid ""
"Sprays poison at monsters directly in front of you. Each shot deals <good>{percent}</> % of a melee blow's damage."
msgstr ""
"Распыляет яд на монстров прямо перед вами. Каждый выстрел наносит <good>{percent}</> % урона удара ближнего боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:67
msgid ""
"Drops a Fire Spike on the ground that waits for a creature to get near it before exploding. Fire Spikes last until you leave the map or they are triggered."
msgstr ""
"Оставляет на земле Огненный Шип, который ждет, пока к нему приблизится существо, и тогда взрывается. Огненные Шипы остаются, пока вы не покинете карту или пока они не сработают."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:672
msgid ""
"Squirts a jet of extremely caustic acid at a single victim. It always hits and deals <good>{percent}</> % of a melee blow's damage."
msgstr ""
"Выпускает в одну жертву струю чрезвычайно едкой кислоты. Всегда попадает и наносит <good>{percent}</> % урона удара ближнего боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:680
msgid ""
"Slaps a monster with magical force, stunning it and knocking it back a little. Stun deals <good>{percent}</> % of a melee blow's damage."
msgstr ""
"Бьет монстра магической силой, оглушая его и слегка отбрасывая назад. Шок наносит <good>{percent}</> % урона удара ближнего боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:688
msgid ""
"Fires a rotating, razor-thin metal blade at a single monster that deals <good>{percent}</> % of a melee blow's damage as physical damage."
msgstr ""
"Выпускает в одного монстра вращающееся тончайшее металлическое лезвие, которое наносит <good>{percent}</> % урона удара ближнего боя в виде физического урона."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:696
msgid ""
"Increases the weight of a single target enormously for an instant, dealing <good>{percent}</> % of a melee blow's damage."
msgstr ""
"На мгновение чудовищно увеличивает вес одной цели, нанося <good>{percent}</> % урона удара ближнего боя."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:70 assets_dev\engine\rulesets\maw\data\texts.yml:71 assets_dev\engine\rulesets\maw\data\texts.yml:72
msgid ""
"Causes 1-<good>{mastery_dice}</> points of damage per point of skill, 5 spikes maximum"
msgstr ""
"Наносит 1-<good>{mastery_dice}</> ед. урона за пункт умения, не более 5 шипов"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:723
msgid ""
"Each point raises the damage of the staff by 2 % (never less than 1 per point). At Grandmaster, Unarmed adds half its skill to a staff's damage. From Expert, a staff in hand also adds Armor Class, and as much to the whole party's resistances: the percent below of the staff's guard (it grows with the staff's power) for each point of skill, counted as if you had 10 more points. {stun_line}{guard_line}"
msgstr ""
"Каждый пункт увеличивает урон посоха на 2 % (не меньше 1 за пункт). На уровне Великого Мастера Рукопашная добавляет к урону посоха половину своего умения. С уровня Эксперта посох в руках также добавляет Класс защиты и столько же к устойчивостям всей группы: указанный ниже процент от блока посоха (он растет вместе с силой посоха) за каждый пункт умения, считая так, будто у вас на 10 пунктов больше. {stun_line}{guard_line}"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:728 assets_dev\engine\rulesets\maw\data\texts.yml:739 assets_dev\engine\rulesets\maw\data\texts.yml:747
#: assets_dev\engine\rulesets\maw\data\texts.yml:756 assets_dev\engine\rulesets\maw\data\texts.yml:773 assets_dev\engine\rulesets\maw\data\texts.yml:781
#: assets_dev\engine\rulesets\maw\data\texts.yml:788
msgid "Attack +1 per point"
msgstr "Атака +1 за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:729
msgid ""
"Attack +2 per point; Armor Class and party resistances 2 % of the guard per point"
msgstr ""
"Атака +2 за пункт; Класс защиты и устойчивость группы — 2 % от блока за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:730
msgid ""
"Attack +3 per point; Armor Class and party resistances 3 % of the guard per point; a chance to paralyse for 2 s"
msgstr ""
"Атака +3 за пункт; Класс защиты и устойчивость группы — 3 % от блока за пункт; шанс парализовать на 2 сек."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:732
#| msgid ""
msgid ""
"Attack +4 per point; Armor Class and party resistances 4 % of the guard per point; usable with Unarmed, paralysis lasts 4 s"
msgstr ""
"Атака +4 за пункт; Класс защиты и устойчивость группы — 4 % от блока за пункт; работает с Рукопашной, паралич длится 4 сек."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:735
msgid ""
"Each point raises the damage of the sword, Armsmaster and special abilities by 2 % (never less than 1 per point). From Master, a sword in hand also adds Armor Class: the percent below of the sword's guard (it grows with the sword's power) for each point of skill, counted as if you had 10 more points.{guard_line}"
msgstr ""
"Каждый пункт увеличивает урон меча, Владения оружием и особых способностей на 2 % (не меньше 1 за пункт). С уровня Магистра меч в руках также добавляет Класс защиты: указанный ниже процент от блока меча (он растет вместе с силой меча) за каждый пункт умения, считая так, будто у вас на 10 пунктов больше.{guard_line}"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:74
msgid ""
"An aura: surrounds your characters with a very hot fire that is only harmful to others. It deals {add} + 1-{dice} points of damage per point of skill in Fire Magic to every nearby monster for as long as they remain in the area."
msgstr ""
"Аура: окружает ваших персонажей очень жарким огнем, опасным только для других. Наносит {add} + 1-{dice} ед. урона за каждый пункт умения Магии Огня каждому монстру поблизости, пока он остается в области."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:740 assets_dev\engine\rulesets\maw\data\texts.yml:757 assets_dev\engine\rulesets\maw\data\texts.yml:774
#: assets_dev\engine\rulesets\maw\data\texts.yml:796
msgid "Attack +2, speed +1 % per point"
msgstr "Атака +2, скорость +1 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:741
#| msgid "Attack +3, speed +1 %, Armor Class +1 per point; can dual wield"
msgid ""
"Attack +3, speed +1 % per point; Armor Class 1 % of the guard per point; can dual wield"
msgstr ""
"Атака +3, скорость +1 % за пункт; Класс защиты — 1 % от блока за пункт; можно держать во второй руке"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:742
msgid ""
"Attack +4, speed +2 % per point; Armor Class 2 % of the guard per point"
msgstr ""
"Атака +4, скорость +2 % за пункт; Класс защиты — 2 % от блока за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:744
msgid ""
"Each point raises the damage of the dagger, Armsmaster and special abilities by 2 % (never less than 1 per point). Critical chance falls as monsters grow stronger, up to level 600."
msgstr ""
"Каждый пункт увеличивает урон кинжала, Владения оружием и особых способностей на 2 % (не меньше 1 за пункт). Шанс критического удара снижается по мере усиления монстров, вплоть до 600-го уровня."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:748
msgid "Attack +2 per point; can dual wield"
msgstr "Атака +2 за пункт; можно держать во второй руке"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:749
msgid "Attack +3 per point; critical chance 5 % + 1 % per point"
msgstr "Атака +3 за пункт; шанс критического удара 5 % + 1 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:750
msgid "Attack +4, speed +1 % per point"
msgstr "Атака +4, скорость +1 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:752
msgid ""
"Each point raises the damage of the axe, Armsmaster and special abilities by 2 % (never less than 1 per point). Dwarves and Minotaurs can wield a one-handed axe in the off hand from Expert; Minotaurs hold a two-handed axe in one hand, and in the off hand from Master."
msgstr ""
"Каждый пункт увеличивает урон топора, Владения оружием и особых способностей на 2 % (не меньше 1 за пункт). Гномы и Минотавры начиная со Специалиста могут держать одноручный топор во второй руке; Минотавры держат двуручный топор одной рукой, а начиная с Магистра — и во второй руке."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:758 assets_dev\engine\rulesets\maw\data\texts.yml:797
msgid "Attack +3, speed +1 % per point"
msgstr "Атака +3, скорость +1 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:759
msgid "Attack +4, speed +1 % per point; critical damage +1 % per point"
msgstr "Атака +4, скорость +1 % за пункт; критический урон +1 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:761
msgid ""
"Each point raises the damage of the spear, Armsmaster and special abilities by 2 % (never less than 1 per point). From Expert, a spear in hand also adds Armor Class: the percent below of the spear's guard (it grows with the spear's power) for each point of skill, counted as if you had 10 more points.{guard_line}"
msgstr ""
"Каждый пункт увеличивает урон копья, Владения оружием и особых способностей на 2 % (не меньше 1 за пункт). С уровня Эксперта копье в руках также добавляет Класс защиты: указанный ниже процент от блока копья (он растет вместе с силой копья) за каждый пункт умения, считая так, будто у вас на 10 пунктов больше.{guard_line}"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:765 assets_dev\engine\rulesets\maw\data\texts.yml:782 assets_dev\engine\rulesets\maw\data\texts.yml:789
#: assets_dev\engine\rulesets\maw\data\texts.yml:795
msgid "Attack +2 per point"
msgstr "Атака +2 за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:766
msgid "Attack +4 per point; Armor Class 4 % of the guard per point"
msgstr "Атака +4 за пункт; Класс защиты — 4 % от блока за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:767
#| msgid "Attack +6, Armor Class +6 per point; can hold with one hand"
msgid ""
"Attack +6 per point; Armor Class 6 % of the guard per point; can hold with one hand"
msgstr ""
"Атака +6 за пункт; Класс защиты — 6 % от блока за пункт; можно держать одной рукой"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:768
#| msgid ""
msgid ""
"Attack +8 per point; Armor Class 8 % of the guard per point; each blow makes the target take {spear_stack}% more physical damage, stacking until it dies (half again with a halberd)"
msgstr ""
"Атака +8 за пункт; Класс защиты — 8 % от блока за пункт; после каждого удара цель получает на {spear_stack}% больше физического урона, накапливается до ее смерти (с алебардой — в полтора раза больше)"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:771
msgid ""
"Each point adds 1 to the bow's damage and raises it by 4 % (never less than 1 per point)."
msgstr ""
"Каждый пункт добавляет 1 к урону лука и увеличивает его на 4 % (не меньше 1 за пункт)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:775
msgid "Attack +3, speed +1 % per point; shoots 2 arrows"
msgstr "Атака +3, скорость +1 % за пункт; выпускает 2 стрелы"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:776
msgid ""
"Attack +4, speed +2 % per point; shoots fire arrows, dealing the higher of fire and physical damage"
msgstr ""
"Атака +4, скорость +2 % за пункт; стреляет огненными стрелами, нанося больший из двух уронов: огнем или физический"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:778
msgid ""
"Each point raises the damage of the mace, Armsmaster and special abilities by 2 % (never less than 1 per point). {stun_line}"
msgstr ""
"Каждый пункт увеличивает урон булавы, Владения оружием и особых способностей на 2 % (не меньше 1 за пункт). {stun_line}"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:783
msgid "Attack +3 per point; a chance to paralyse for 2 s"
msgstr "Атака +3 за пункт; шанс парализовать на 2 сек."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:784
msgid "Attack +4 per point; paralysis lasts 4 s"
msgstr "Атака +4 за пункт; паралич длится 4 сек."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:786
msgid ""
"Each point raises the blaster's damage by 4 % (never less than 1 per point)."
msgstr "Каждый пункт увеличивает урон бластера на 4 % (не меньше 1 за пункт)."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:790
msgid "Attack +3 per point"
msgstr "Атака +3 за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:791
msgid "Attack +4 per point"
msgstr "Атака +4 за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:793
msgid "Unarmed blows deal 2 extra damage per point."
msgstr "Удары без оружия наносят на 2 ед. урона больше за каждый пункт."

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:798
msgid "Attack +3, speed +2 % per point"
msgstr "Атака +3, скорость +2 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:800
msgid ""
"Shield skill raises the Armor Class and resistances your shield gives by a percent per point.{armor_items}"
msgstr ""
"Умение Щит увеличивает Класс защиты и устойчивость, которые дает ваш щит, на определенный процент за каждый пункт.{armor_items}"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:802
msgid "Armor Class +4 %, resistances +4 % per point"
msgstr "Класс защиты +4 %, устойчивость +4 % за пункт"

# machine translation (Claude), review
#: assets_dev\engine\rulesets\maw\data\texts.yml:803
