#: assets_dev\engine\data_tables\npc_topic_text.txt:6350
msgid ""
"%07 %02!\n"
"What an honor!\n"
"Everyone is talking about how you %08!\n"
"What can I do for you?"
msgstr ""
"%07 %02!\n"
"Какая честь!\n"
"Все только и говорят о том, как ты %08!\n"
"Чем я могу тебе помочь?"

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
