#: assets_dev\engine\data_tables\npc_topic_text.txt:6354
msgid ""
"Oh No!\n"
"%06 %02!\n"
"I didn't do it!\n"
"It was the other guy!\n"
"I wasn't there!\n"
"I'll tell you anything--anything, just don't hurt me!"
msgstr ""
"О нет!\n"
"%06 %02!\n"
"Это не я!\n"
"Это был тот парень!\n"
"Меня там не было!\n"
"Я расскажу вам всё — что угодно, только не делайте мне больно!"

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\npc_topic_text.txt:6360
msgid ""
"Oh…you people.\n"
"I can't even bear to think of things people are saying about you!\n"
"Go away and leave me alone!"
msgstr ""
"Ой, вы, люди.\n"
"Мне даже думать не хочется о том, что о вас говорят!\n"
"Уйдите и оставьте меня в покое!"

# imported from LocRU_Maslyonok_anims (MMMerge localization)
