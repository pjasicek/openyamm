# imported from LocRU_Maslyonok_anims (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:92 assets_dev/engine/data_tables/english/spells.txt:94 assets_dev/engine/data_tables/english/spells.txt:95
