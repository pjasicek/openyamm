msgstr "Ускоренное восстановление очков здоровья"

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\english\skill_des.txt:32
msgid "Largest increase of hit points regained over time"
msgstr "Максимальное восстановление очков здоровья"

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\english\skill_des.txt:33
msgid "Skill increases chance to disarm traps on chests"
msgstr "Повышает шанс обезвредить ловушку"

