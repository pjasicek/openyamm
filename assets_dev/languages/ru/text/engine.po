# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\npc_greet.txt:113
msgid ""
"I am Duroth the Eternal. By besting the guards you have earned the right of speaking to me. What do you want?"
msgstr ""
"Я Дурот Вечный. Победив стражу, вы заслужили право говорить со мной. Что ты хочешь?"

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\npc_greet.txt:113
msgid "What brings you again to Duroth the Eternal?"
msgstr "Что привело вас снова к Дуроту Вечному?"

# imported from LocRU_Maslyonok_anims (MMMerge localization)
#: assets_dev\engine\data_tables\npc_greet.txt:1132
msgid ""
"Care to trade for some extra gold?\n"
"I buy crates of Sand and I sell crates of Glass Bottles at the best prices around."
