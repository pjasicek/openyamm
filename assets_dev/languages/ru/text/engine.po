# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\english\Global.txt:368 assets_dev\engine\data_tables\npc_professions.txt:66
msgid "Stone Cutter"
msgstr "каменотёс"

