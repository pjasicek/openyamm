#: assets_dev\engine\data_tables\npc_topic_text.txt:2382 assets_dev\engine\data_tables\npc_topic_text.txt:5121
msgid "Join the Mind Guild for 50 gold"
msgstr "Вступите в Гильдию Ума за 50 золотых"

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\npc_topic_text.txt:2383 assets_dev\engine\data_tables\npc_topic_text.txt:5122
msgid "Join the Spirit Guild for 50 gold"
msgstr "Вступите в гильдию «Дух» за 50 золотых"

