# machine translation (ru_local AI-assisted translations; partial playtesting)
#: assets_dev\engine\data_tables\npc_topic_text.txt:1155 assets_dev\engine\events\Global.lua:4724
msgid ""
"Zevah Poised, Expert instructor of the arcane skills of Body Magic, lives with his people on the Islands of Dagger Wound in the Ifarine Sea."
msgstr ""
"Зева Пойзд обучает магии Тела на уровне эксперта. Он живёт со своим народом на Островах Кинжальной Раны в Ифаринском море."

# imported from ru_local playtesting checkpoint 7429884d0 (AI-assisted translations)
