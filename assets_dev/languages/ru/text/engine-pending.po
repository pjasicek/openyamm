# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid ""
"Any Vampires among you will be promoted to Nosferatu!  I remember those who helped in the recovery of the Remains of Korbu."
msgstr ""
"Все вампиры среди вас станут носферату! Я помню тех, кто помог вернуть Останки Корбу."

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Appearance"
msgstr "Внешность"

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Apply the cinematic colour treatment."
msgstr "Применять кинематографичную цветокоррекцию."

