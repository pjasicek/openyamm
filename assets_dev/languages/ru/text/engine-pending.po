msgid "Jack Osorno"
msgstr "Джек Озорно"

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Jadam - Automatic"
msgstr "Джадам — автоматическое"

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Jadam - Begin in Dagger Wound Islands"
msgstr "Джадам — начать на островах Кинжальной Раны"

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Jadam - Manual"
msgstr "Джадам — ручное"

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
