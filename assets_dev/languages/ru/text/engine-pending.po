# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid ""
"Gilad Dreamwright, Grand Master of Mind Magic, has joined many other Grand Masters of Magic in the Murmurwoods region.  Here they work with the Temple of the Sun to further their combined skills and knowledge.  Gilad can instruct you to Grand Master skill level in Mind Magic."
msgstr ""
"Гилад Кузнец Снов, Великий мастер Магии Разума, присоединился ко многим другим Великим мастерам магии в краю Шепчущего Леса. Здесь они вместе с Храмом Солнца совершенствуют свое общее мастерство и знания. Гилад может обучить вас Магии Разума до уровня Великого мастера."

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Gillian"
msgstr "Джиллиан"

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Gizmo Bertram "
msgstr "Джизмо Бертрам "

# imported from engine_localization_ru_strings.tsv, engine_localization_ru_game_text.tsv
msgid "Glow intensity"
