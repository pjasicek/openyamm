msgstr "Вы пришли нам помочь?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:114
msgid "Good morrow!"
msgstr "Доброго утра!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:12 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:134 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:17
