# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC16.rude:1
msgid "Of course, my children."
msgstr "Конечно, дети мои."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:1
msgid "We are in need of healing."
msgstr "Нам нужно исцеление."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:2
msgid "Fre thanks you, my children."
msgstr "Фре благодарит вас, дети мои."

