# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:3
msgid "Keep fear from your heart children, and hold the course."
msgstr "Не пускайте страх в свое сердце, дети, и держитесь избранного пути."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:4
msgid "I am sorry friends.  I cannot help."
msgstr "Простите, друзья. Я не могу помочь."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:4
msgid "We're looking for a priest to take to Guberland"
msgstr "Мы ищем священника, который отправится с нами в Губерланд"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC102.rude:5
msgid "Keep yourselves well, children."
msgstr "Берегите себя, дети."

