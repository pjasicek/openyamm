#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:17
#: assets_dev/worlds/mm9/dialogue/rude/NPC69.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC72.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:1
msgid "Okay."
msgstr "Fajn."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC111.rude:4
msgid ""
"A Sword-Brother is an important thing to have.  You watch each other's backs.  Having a sword brother is like having an extra set of arms on yourself."
msgstr ""
"Je důležité mít svého bratra v meči. Vzájemně si kryjete záda. Mít svého bratra v meči je jako mít ještě jeden pár paží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC111.rude:4
msgid "What do you know about Sword-Brothers"
msgstr "Víš něco o bratrství v meči?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC112.rude:2
msgid ""
"I'm picking up rocks!  You never know when a good rock will come in handy!"
msgstr "Dobývám kameny! Nikdy nevíš, kdy se ti takový balvan může hodit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC112.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC434.rude:1
msgid "What are you doing?"
msgstr "Co děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC112.rude:3
msgid "Can we ask you some questions."
msgstr "Smím se tě na něco otázat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC112.rude:4
msgid "I can't believe he did that to me!  Oh, but is he going to get it!"
msgstr "Nemohu uvěřit, že mi něco takovýho proved'! Ale brzy to schytá!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC112.rude:5
msgid "I should have whupped his hide!"
msgstr "Měl jsem mu dát pořádnou nakládačku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC112.rude:6
msgid ""
"He's going to get it from me.  I'm going to clobber his head with this rock!"
msgstr "Chce mi to sebrat. A já mu rozbiju hlavu tímhle šutrákem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC113.rude:1
msgid "Those mean nasty Yobboes need to get a what for from someone!"
msgstr "Ti odporní chuligáni potřebují, aby jim někdo pořádně zmaloval zadek!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC113.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC408.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC423.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:2
msgid "Of course."
msgstr "Samozřejmě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC113.rude:2
msgid "Perhaps.  Can we ask you some questions?"
msgstr "Snad. Smím se tě na něco optat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC113.rude:3
msgid ""
"They're those nasty criminals that keep coming here and stealing things!  We need to get them out of here!!!"
msgstr ""
"Jsou to hnusní kriminálníci, co sem lezou a kradou nám věci! Musíme je odsud dostat!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC113.rude:3
msgid "What do you know about Yobboes?"
msgstr "Co víš o těch chuligánech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC113.rude:4
msgid "If you won't help, then you're just as bad as them!"
msgstr "Jestli nechcete pomoct, jste stejný hajzlové jako oni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:3
msgid "I can help you, if you possess the skills."
msgstr "V tom vám mohu pomoci, máte-li potřebné vědomosti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:1
msgid "We'd like to become Experts in Bow."
msgstr "Toužím se stát expertem ve střelbě z luku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:2
msgid "I've heard that dragons are afraid of chicken soup."
msgstr "Draci prý mají strach z kuřecí polévky."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:5
msgid "We'd like to become Masters in Bow."
msgstr "Rádi bychom ovládali luk na úrovni mistra."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:4
msgid ""
"I'm glad I don't live there!  I don't think I could stand to listen to that guy Markel who thinks he is in charge!"
msgstr ""
"Jsem ráda, že tam nežiju! Myslím si, že bych nemohla pořád poslouchat toho chlápka Markela, kterej se pokládá za vládce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC131.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC131.rude:7
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:8
msgid "What do you know about Guberland?"
msgstr "Co víš o Guberlandu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:4
msgid "Go to Thjorgard.  Seek out Muadhnait A'Tryht."
msgstr "Vydej se do Thjorgardu. Vyhledej Muadhnaita A'Tryhta."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:4
msgid "Where can we become Grandmasters in Bow?"
msgstr "Jak můžeme dosáhnout velmistrovství ve střelbě z luku?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC114.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC116.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC117.rude:2
