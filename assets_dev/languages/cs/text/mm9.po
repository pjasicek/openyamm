#: assets_dev/worlds/mm9/dialogue/rude/NPC361.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC385.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC387.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC62.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:25 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:28 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:29
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:36 assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:14
msgid "Very well."
msgstr "Dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC133.rude:9
msgid ""
"The Gathering?  Well I've only been coming here for ten years!  What do you think I know about it?  Everything, that's what!"
msgstr ""
"O shromáždění? No, chodím tam pouze asi deset let! Tak co si myslíš, že o tom vím? Úplně všechno, to je přece jasné! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC133.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:10
#: assets_dev/worlds/mm9/dialogue/rude/NPC151.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC168.rude:3
msgid "What do you know about the Gathering?"
msgstr "Co víš o shromáždění?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:2
msgid ""
"Nutty Nurtigan used to be our strongest warrior.  It's a shame he went crazy.  I don't know what we'll do if we get attacked."
msgstr ""
"Nutty Nurtigan býval náš nejsilnější bojovník. Je to smůla, že se zbláznil. Nevím, co budeme dělat, až nás někdo napadne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:4
msgid "We'd like to see your weapons."
msgstr "Rádi bychom viděli tvé zbraně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:9
msgid "Sorry, We're closed."
msgstr "Omlouvám se, ale máme zavřeno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:5
msgid ""
"Not much, I'm afraid.  Nutty Nurtigan was the one who was supposed to protect us.  But now he's so crazy, they had to put him away just to protect him from himself!"
msgstr ""
"Obávám se, že ne moc. Nutty Nurtigan byl tím, od koho se očekávalo, že nás ochrání. Ale se natolik pomátl, že ho museli zavřít, aby si sám neublížil!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:5
msgid "What do you know about defense?"
msgstr "Co víš o obraně?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC134.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC342.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC349.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:345
msgid "Have a look around!"
msgstr "Porozhlédni se tu kolem."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC998.rude:91
msgid "adsf"
msgstr "adsf"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:2
msgid ""
"Not especially.  Well, unless you count the prize I won at the Gathering.  I played against Ivan the Smart.  I answered two questions right!"
msgstr ""
"Nic zvláštního. Tedy pokud se ovšem nepočítá cena, kterou jsem vyhrál na shromáždění. Hrál jsem s Ivanem Mazaným. Odpověděl jsem dvakrát správně!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:3
msgid "Take a look!"
msgstr "Tak se podívej!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC251.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC343.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC349.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:5
msgid "We'd like to see your wares."
msgstr "Rádi bychom viděli tvé zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:10
#: assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC259.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:4
msgid "Sorry, we're closed."
msgstr "Omlouvám se, ale máme zavřeno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:5
msgid ""
"It's the place where the wizards gather on the beach.  They go there and often challenge each other to contests.  Did I tell you about the prize I won at Ivan the Smart's booth?"
msgstr ""
"Je to místo na pobřeží, kde se shromažďují čarodějové. Chodí tam a často se navzájem utkávají v soubojích. Říkal jsem ti o té ceně, kterou jsem vyhrál u stánku Ivana Mazaného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC148.rude:2
msgid "Very well.  Ask your questions."
msgstr "Dobře. Tak se ptej."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC135.rude:7
msgid "Come back when you're ready to spend some money."
msgstr "Vraťte se zpět, až budete připraveni utratit své peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:2
msgid ""
"What do I think he was?  A Lich!!  They say he lived for almost three hundred years!  How else could he do that?"
msgstr ""
"Kdo si myslím, že to byl? Lich!! Říkají, že žil skoro 300 let! Jak jinak by to mohl udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:2
msgid "What do you think he was?"
msgstr "Kdo si myslíš, že to byl?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:3
msgid ""
"I've heard that Verhoffin left a diary behind after the caused the Great Cataclysm.  What I wouldn't give to have that in my shop!"
msgstr ""
"Slyšel jsem, že když Verhoffin způsobil Velkou pohromu, zanechal po sobě deník. Co bych za to dal, kdybych jej měl ve svém obchodě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:4
msgid "Wonderful!  Have a look."
msgstr "Výborně! Podívej se."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:6
msgid ""
"He was one of the most powerful mages of all time.  He single handedly kept the Ursanian Empire at bay for years!  But if you want to know what I think, I think he wasn't a mage at all."
msgstr ""
"Byl to jeden z nejsilnějších mágů všech dob. Bez cizí pomoci držel Ursanskou říši v šachu po několik let! Ale jestli chcete vědět, co si myslím já, tak já osobně si myslím, že to vůbec nebyl mág."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:30
msgid "What do you know about Verhoffin?"
msgstr "Co víš o Verhoffinovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:8
msgid "Maybe next time you could buy something."
msgstr "Možná si něco koupíš příště."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC136.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:8 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:349
msgid "Have a look around."
msgstr "Porozhlédni se tu kolem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:2
msgid ""
"I hear the Dook is recruiting soldiers into his army.  I've been thinking of selling my shop and joining!  He couldn't be half as bad as Markel is!"
msgstr ""
"Slyšel jsem, že Dook najímá vojáky do své armády. Přemýšlel jsem, že bych prodal obchod a přidal se k němu! Nebyl by ani z poloviny tak špatnej jako je Markel! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:3
msgid "Great.  Have a look."
msgstr "Skvěle. Podívej se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:5
msgid ""
"That monkeyface?  I think he's probably the worst ruler we have had in a long time.  Maybe if he spent his time trying to improve Guberland's reputation instead of his own, we might be as prominent as Thjorgard!"
msgstr ""
"O tom bláznivým šaškovi? Myslím, že je to pravděpodobně ten nejhorší vládce, jakého jsme kdy měli. Možná kdyby věnoval svůj čas tomu, aby zlepšil pověst Guberlandu, než aby se staral jen sám o sebe, mohli bychom být stejně významní, jako je Thjorgard!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:26
msgid "What do you know about Markel the Great?"
msgstr "Co víš o Markelovi Velikém?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC137.rude:7
msgid "Come back when you're ready to buy something."
msgstr "Vraťte se zpátky, až budete připraveni si něco koupit. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC138.rude:2
msgid ""
"I spend too much of my time swabbing my decks at night.  I never get enough sleep!"
msgstr ""
"Trávím příliš mnoho času vytíráním podlahy. Nikdy se pořádně nevyspím! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC138.rude:3
msgid "Alright!"
msgstr "V pořádku!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC138.rude:3
msgid "We'd like passage."
msgstr "Chtěli bychom se přepravit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC138.rude:4
msgid ""
"I've been thinking about retiring there.  I've heard they are very poor there.  With all the money I have here, I'd be a king!"
msgstr ""
"Přemýšlel jsem, že bych tam odjel na odpočinek. Slyšel jsem, že jsou tam velice chudí. Se všemi těmi penězi, které tu mám, bych byl král!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC138.rude:6
msgid "Come back when you have some money you're willing to spend."
msgstr ""
"Vraťte se zpátky, až budete mít nějaké peníze, které budete ochotni utratit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC138.rude:7 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:103 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:209
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:257
msgid "Looking for passage?"
msgstr "Potřebujete přepravit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:2
msgid "I Haven't been out lately.  Why?  Is there any news I should know?"
msgstr ""
"Poslední dobou jsem nebyl na cestách. Proč? Máte nějaké zprávy, o kterých bych měl vědět?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:3
msgid "Very well.  Have a look."
msgstr "Dobře. Porozhlédni se tu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:5
msgid ""
"How dare you say that name in my shop!!  He is called the Meddler.  He is the thorn in the side of all the gods.  It is said that one day he will bind Krohn.  When that happens, the Day of Reckoning will be at hand."
msgstr ""
"Jak se odvažuješ vyslovit to jméno v mém obchodě?!! Říká se mu Kibic. Je osinou v zadku snad všech bohů. Říká se, že jednoho dne se spojí s Krohnem. A pokud se to stane, nadejde brzy Den zúčtování."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:5
msgid "What do you know about Njam?"
msgstr "Co bys mi pověděl o Njamovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:6
msgid "Perhaps you'd like to buy something?"
msgstr "Snad by sis rád něco koupil?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC139.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:7
msgid "Cheapskate!"
msgstr "Držgrešle!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:1
msgid "Then why tell us?"
msgstr "Tak proč nám to tedy říkáš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:1
msgid ""
"You look the sort of people who would believe such things.  Perhaps you should have a drink?"
msgstr ""
"Vypadáš jako člověk, kterej by takovým věcem mohl věřit. Třeba by sis dal i něco k pití?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:2
msgid ""
"Nothing.  He looked quite taken with madness. I wouldn't pay much heed to the words of a madman."
msgstr ""
"Nic. Vypadal, že ho zachvátilo šílenství. Nepřikládal bych slovům toho blázna nijak velkou váhu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:2
msgid "What else did he say?"
msgstr "Co ještě říkal?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:3
msgid ""
"He was Framish.  He said he saw an army large enough to swallow the world crossing the borders into Framon."
msgstr ""
"Pocházel z Framonu. Povídal, že viděl armádu dost velkou na to, aby přemohla celý svět, jak překračuje framonské hranice."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:3
msgid "Who was he?"
msgstr "Kdo to byl?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:19 assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:6
msgid "We'd like to do business."
msgstr "Rádi bychom se věnovali obchodu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:5
msgid "Do you have any special advice?"
msgstr "Máš nějakou zvláštní radu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:5
msgid ""
"Shhhh!  If you're looking to train up, or buy some items a little cheaper than most places around here, head upstairs.  Don't tell anyone though!  If Sven found out, we'd be finished for sure!!"
msgstr ""
"Psssst! Jestli se chcete vytrénovat nebo si pořídit věci trochu levněji než na většině zdejších míst, vystoupejte nahoru po schodech. Ale nikomu o tom neříkejte! Kdyby se toho Sven dopídil, určitě by se mnou pořádně zatočil!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:6
msgid ""
"A man came through here the other day preaching death and destruction."
msgstr "Před nedávnem tudy prošel muž, jenž s sebou přinášel zmar a zkázu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:6
msgid "Any news?"
msgstr "Nějaké novinky?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC14.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC70.rude:1
msgid "Sorry.  Goodbye."
msgstr "Promiň. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:11
msgid "Would you like to do some banking?"
msgstr "Nechtěl bys učinit nějaké bankovní transakce?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:2
msgid ""
"I've heard of these things called Orbs of Linking.  They would link my safety deposit boxes to all the banks across Chedian.  I sure wish I had one of those!"
msgstr ""
"Slyšel jsem o věcičkách nazývaných orby přenosu. Měly by propojit mé bezpečnostní úložné schránky se všemi bankami v Chedianu. Určitě bych si přál mít jeden z nich! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:5
msgid ""
"I wish I knew where one was!  They were made during the Old Ursanian Empire.  I've heard that they were in some magical storehouse somewhere."
msgstr ""
"Přál bych si vědět, kde se nachází aspoň jeden z nich! Byly vytvořeny v dobách staré Ursanské říše. Slyšel jsem, že byly uloženy v nějakých magických skladištích. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:5
msgid "What do you know about the Orb of Linking?"
msgstr "Co mi můžeš říci o orbu přenosu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:7
msgid ""
"An Orb of Linking!  Of course you can install it, but I have to watch!"
msgstr ""
"Orb přenosu! Samozřejmě že ho můžete namontovat, ale musím u toho být!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:7
msgid "We have an Orb of Linking we'd like to install."
msgstr "Máme orb přenosu a rádi bychom ho namontovali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:8
msgid "I don't have much time.  Ask your questions, but be quick about it."
msgstr "Nemám moc času. Ptej se, ale pospěš si."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:14
msgid "How are the Orbs of Linking working out?"
msgstr "Jak fungují orby přenosu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC140.rude:9
msgid "Wonderful!  Thank you!"
msgstr "Skvěle! Díky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:1
msgid "Yes.  No if you don't mind, I've got other customers to attend to."
msgstr ""
"Ano. No, pokud ti to nebude vadit, mám tu další zákazníky, které musím obsloužit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:1
msgid "You're sure?"
msgstr "Víš to jistě?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:10
msgid "Oh!  Well in that case, I don't want to buy any.  Sorry."
msgstr "Ou! Tak v tom případě nechci koupit žádné. Promiň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:10
msgid "Uh, no.  It was made by his apprentices."
msgstr "Ó, to ne. Vyrobili je jeho učňové."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:11
msgid "Is that so?  And what makes you think that I want to buy your beer?"
msgstr "Opravdu? A proč si myslíte, že bych chtěla koupit vaše pivo?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:11
msgid "We have some beer we'd like to sell."
msgstr "Máme nějaké pivo, které bychom rádi prodali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:12
msgid ""
"It's the place where I grew up!  My father used to say that we were actually descended from Ursanian Nobility.  Wouldn't that be great if it were true?  I could have been an emperor!"
msgstr ""
"Je to místo, kde jsem vyrostla! Můj otec říkával, že ve skutečnosti pocházíme z ursanské šlechty. Nebylo by to skvělé, kdyby to byla pravda? Mohla jsem se stát královnou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:9
msgid "What do you know about Chedian?"
msgstr "Co bys mi řekla o Chedianu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:15
msgid "Maybe you'd like to buy a drink?"
msgstr "Možná by sis rád koupil něco k pití?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:3
msgid "It's a deal then.  Thanks for doing business."
msgstr "Tomu říkám obchod. Díky za skvělý kšeft."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:3
msgid "Sounds good."
msgstr "To zní dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:4
msgid "Er,..Yes."
msgstr "Oh... Ano."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:4
msgid ""
"In that case, I would be happy to purchase it from you!  Say 500 gold?"
msgstr ""
"V tom případě bych byla šťastná, kdybych ho od vás mohla koupit! Řekněme za 500 zlatých?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:5
msgid ""
"From Frosgard?  You mean it was made by the legendary Brewmaster Smith?"
msgstr ""
"Z Frosgardu? Tvrdíš, že jej připravil Smith, legendární mistr ve vaření piva?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:8
msgid "It's a special brew from Frosgard."
msgstr "Je to speciální nápoj z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:6
msgid ""
"This is the place for news, that's for sure!  I've been looking for a new brew to try!  My clientele grow tired of my same old brews.  It would be wonderful if I could find something new to serve to them!"
msgstr ""
"Buď si jistý, že tady je pořád něco nového! Pokouším se sehnat nějaký nový drink! Mým zákazníkům už nechutná žádný z těch mých starých. Bylo by to skvělé, kdybych objevila něco nového, co bych jim mohla nabídnout!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC250.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC251.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:7
#: assets_dev/worlds/mm9/dialogue/rude/NPC306.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:12
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC341.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC342.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:4
msgid "Of course!"
msgstr "Samozřejmě!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:8
msgid ""
"You're not going to fool me.  I know you're trying to sell that same beer you were selling last time you were in here.  Now if you don't mind, I've got other customers."
msgstr ""
"Mě jen tak neoblafnete. Vím, že se mi pokoušíte prodat to samé pivo, které jste mi podstrkovali minule, když jste tu byli. A teď už mě neobtěžujte, mám tu i další zákazníky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:9
msgid "That's not enough."
msgstr "To je málo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC141.rude:9
msgid "Well that's all I'm going to offer.  Take it or leave it."
msgstr "To je všechno, co ti mohu nabídnout. Ber to, nebo to nechej být."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:11
msgid ""
"Ah, so you did.  Come back in two hours, and I'll have the potion for you."
msgstr ""
"Ach, tak jste to přece dokázali. Přijďte za dvě hodiny a já budu mít pro vás ten lektvar hotový."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:11
msgid "We've got a lock of the hag's hair."
msgstr "Máme ten pramínek vlasů od čarodějnice."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:12
msgid "We've returned for the potion."
msgstr "Vrátili jsme se pro lektvar."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:12
msgid ""
"Yes, here it is.  Just go use it on Nutty Nurtigan, and he should be good as new!"
msgstr ""
"Ano, tady je. Hned ho běž dát Nuttymu Nurtiganovi a měl by být zase v pořádku jako předtím!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:2
msgid ""
"If all goes well, I should be thanking you.  He's our strongest warrior, and we've been very vulnerable since he went crazy."
msgstr ""
"Pokud se všechno podaří, měl bych ti hodně poděkovat. Je to náš nejsilnější bojovník a od té doby, co se zbláznil, jsme byli hodně zranitelní."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:3
msgid "Don't thank me yet, we're still not sure it will work."
msgstr "Ještě mi neděkuj, stále ještě jistě nevíme, zdali to bude fungovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:4
msgid ""
"That poor man in the pillory.  He's gone crazy, and there's nothing I can do to heal him."
msgstr ""
"Ten ubožák na pranýři. Zbláznil se a není tu nic, čím bych ho mohl uzdravit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:5
msgid "I hear she lives in a cave somewhere along the beach."
msgstr "Slyšel jsem, že žije v jeskyni někde u pobřeží."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:5
msgid "It will be done.  Where can we find the Old Hag?"
msgstr "Uděláme to. Kde bychom našli tu starou čarodějnici?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:6
msgid ""
"I could have made a potion to cure him already, but I need a lock from the Old Hag's head.  If you can bring me that, I will give you the potion for free."
msgstr ""
"Mohl bych ti namíchat léčivý lektvar již teď, ale k tomu potřebuji pramínek vlasů z hlavy staré čarodějnice. Pokud mi ho přineseš, dám ti ten lektvar zadarmo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:6
msgid "We need a way to cure him. Tjolnir told us you might help."
msgstr "Potřebujeme ho nějak uzdravit. Tjolnir nám řekl, že nám můžeš pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:7
msgid "Ah yes, the crazy old soldier in the Idiot's Box.  What about him?"
msgstr "Aha, o tom starém bláznivém vojákovi v kleci. Co s ním má být?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:7
msgid "We've come to speak to you about Nutty Nurtigan."
msgstr "Přišli jsme si s tebou promluvit o Nuttym Nurtiganovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:8
msgid "What do you know about potions?"
msgstr "Co mi můžeš říci o lektvarech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:8
msgid ""
"You want to stay alive?  Get yourself a bunch of them.  They'll come in handy more often than you think!"
msgstr ""
"Chcete zůstat naživu? Několik si jich vezměte. Budou se vám hodit mnohem častěji, než si myslíte!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC142.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC250.rude:2
msgid "We would like to see your wares."
msgstr "Rádi bychom se podívali na tvoje zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:1
msgid ""
"I'm afraid not.  I spend most of my time in worship, not at the tavern."
msgstr ""
"Obávám se, že ne. Většinu času jsem strávil bohoslužbami, ne chozením do hospody."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:2
msgid "We need healing."
msgstr "Potřebujeme uzdravit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:3
msgid ""
"The first temples in this area were dedicated to Igdrasa.  She was the nature goddess of earlier times.  There are still a few shrines dedicated to her scattered around Rysh."
msgstr ""
"První chrámy v této oblasti byly zasvěceny Igdrase. Byla to bohyně přírody z pradávných dob. Stále se v okolí Ryshu nachází několik svatyní, které jsou zasvěcené právě jí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:4
msgid "The blessings of Fre upon you!"
msgstr "Kéž vás provází požehnání Fré!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:4
msgid "We'd like to make a donation."
msgstr "Rádi bychom něco darovali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:17
msgid "Is there anything else I can help you with?"
msgstr "Je tu něco jiného, s čím ti mohu pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:6
msgid "I will try to answer your questions."
msgstr "Pokusím se odpovědět na vaše otázky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC143.rude:7
msgid "Have a care, children.  It is a dangerous world out there."
msgstr "Dej na sebe pozor, dítě. Tam venku je nebezpečný svět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:1
msgid ""
"The people in Lachmon Cove are infected with some sort of plague!  The last thing I wanted to do was to catch it!  Besides, if I stayed any longer, I could have brought it back here!"
msgstr ""
"Lidé v Lachmonské zátoce jsou nakaženi nějakým druhem moru! Úplně poslední věc, kterou si člověk může přát, je být nakažen tímhle svinstvem! Navíc kdybych tam zůstal o trochu déle, mohl jsem to zavléct i sem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:1
msgid "Why did you leave so quickly?"
msgstr "Proč jsi odjel tak rychle?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:2
msgid ""
"I hear one of my comrade-in-arms was attacked by pirates on his way to Frosgard.  He survived, but he had to dump his cargo to stop his boat from sinking!"
msgstr ""
"Slyšel jsem, že jeden z mých spolubojovníků byl na cestě do Frosgardu přepaden piráty. Sice přežil, ale musel se vzdát svého nákladu, aby zachránil loď před potopením!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:3
msgid "All aboard!"
msgstr "Všichni společně!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:3
msgid "I think we shall be traveling with you today."
msgstr "Myslím, že dneska pocestujeme s tebou. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:5
msgid ""
"I've been in port there a few times.  The last time I was there, I left as quick as the easterly winds could take me!"
msgstr ""
"Byl jsem tam v přístavu několikrát. Když jsem tam byl naposled, odjel jsem tak rychle, jak mi to jen východní větry dovolily! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:8
msgid "I'll be here for a spell, yet, if you change your mind."
msgstr "Budu tu teď odpočívat, kdyby sis to rozmyslel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:7
msgid "Only if you promise to buy me a drink the next time I'm in port."
msgstr "Pouze když mi slíbíš, že až budu příště v přístavu, koupíš mi pití."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC144.rude:8
msgid "Maybe another time."
msgstr "Možná někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:1
msgid ""
"Well, I heard that Markel is planning some sort of festival soon.  He'd better hurry up with it!  I think some of the people around here are starting to dislike him!"
msgstr ""
"No, zaslechl jsem, že Markel plánuje uspořádat nějaký festival. Radši by si s tím měl pospíšit! Myslím, že někteří lidé tady ho začínají docela slušně nenávidět! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:11
msgid "You can find the weapon shop in the southwestern section of town."
msgstr "Obchod se zbraněmi se nalézá v jihozápadní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC147.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:7
msgid "Very well"
msgstr "Dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:19
msgid "The tavern is in the northwestern section of town."
msgstr "Hospoda se nachází v severozápadní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:20
msgid ""
"The Jarls are the clan leaders for each clan.  Ours is Markel Gusmundssen.  He calls himself Markel the Great all the time, but I don't really think he's that special."
msgstr ""
"Jarlové jsou vůdcové každého z klanů. Naším jarlem je Markel Gusmundssen. Říká si celou dobu Markel Veliký, ale já si nemyslím, že je zas tak výjimečný."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:20
msgid "What do you know about the Jarls?"
msgstr "Co víš o jarlech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:22
msgid "You can find the armor shop in the southwestern section of town."
msgstr "Obchod s brněním najdete v jihozápadní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:27
msgid "The magic shop is in the northeastern section of town."
msgstr "Obchod s magií se nachází v severovýchodní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:28
msgid "Not especially."
msgstr "Nic mimořádného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:30
msgid "The temple is in the northwestern section of town, near the tavern."
msgstr "Chrám je v severozápadní části města, blízko hospody. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:33
msgid "The apothecary is in the southeastern section of town."
msgstr "Lékárna se nachází v jihovýchodní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:33 assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:36 assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:32
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:32
msgid "The apothecary."
msgstr "Lékárnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:35
msgid "The training hall is in the sothern section of town."
msgstr "Tréninkovou místnost najdete v jižní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:39 assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:49
msgid "Go through the northern gates to find the dock."
msgstr "Abys našel doky, projdi severní branou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:44
msgid "The library is in the southeastern section of town."
msgstr "Knihovna se nachází v jihovýchodní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:44 assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:43 assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:43
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:43 assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:52
msgid "The library."
msgstr "Knihovnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:5
msgid "The bank is in the northeastern section of town."
msgstr "Banku najdete v severovýchodní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC145.rude:7
msgid "You can find Markel the Great in the room behind me."
msgstr "Markela Velikého můžete najít v pokoji za mnou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC20.rude:4
msgid "I am a librarian.  I don't deal in rumors."
msgstr "Jsem knihovníkem. Neroznáším klepy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:4
msgid "We'd like to look at your books."
msgstr "Rádi bychom se podívali na tvoje knihy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:5
msgid ""
"If you want to learn a skill, buy the books from me.  I have books that teach  all sorts of skills."
msgstr ""
"Pokud se chcete naučit nějakou dovednost, kupte si ode mne knihy. Mám knihy, které vyučují všechny druhy dovedností. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:5
msgid "What do you know about skills?"
msgstr "Co bys mi řekl o dovednostech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC146.rude:6
msgid "I am very busy, but I have a few moments."
msgstr "Jsem sice zaneprázdněný, ale mám chvilku času."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC147.rude:2
msgid "Sorry.  I don't have time for that."
msgstr "Promiň. Na to nemám čas."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC148.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC148.rude:5
msgid "See that you don't do it again."
msgstr "Věřím, že už se to příště nestane."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC148.rude:4
msgid ""
"I can tell you this much, They never conquered Chedian, that's for sure!"
msgstr "Mohu ti říci pouze tolik, že nikdy nedobyli Chedian, to je jisté!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC148.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC149.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC158.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC160.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC175.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:10
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:10
msgid "What do you know about the Ursanian Empire?"
msgstr "Co víš o Ursanské říši?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC149.rude:2
msgid "Well you've interrupted me already.  Might as well."
msgstr "No už jste mě vyrušili. Dalo se to čekat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC149.rude:3
msgid ""
"More than that monkey brain Muata, that's for sure!  He doesn't think that Chedian was ever conquered by the Ursanian Empire.  I don't understand how he can believe that!  The evidence is all around us!"
msgstr ""
"Rozhodně víc než ten hňup Muata, to je teda jistý! On si nemyslí, že byl Chedian vůbec někdy přemožen Ursanskou říší. Vůbec nechápu, jak tomu může věřit! Důkaz toho je všude kolem nás!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:10
msgid ""
"A Sil?  That's the clans within the Great Clans.  In the days before the Great Cataclysm, each Clan had a hundred Sils.  These days most clans have fewer than five.  Some have none.  Poor Devils."
msgstr ""
"Sil? To jsou klany uvnitř velkých klanů. V dobách před Velkou pohromou měl každý klan na stovky silů. Dnes jich má většina klanů méně než pět. Někteří žádné. Chudáci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:10
msgid "What is a Sil?"
msgstr "Co je to sil?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:11
msgid "Destinies have a way of coming true."
msgstr "Osudy se obvykle nějak vyplní."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:11
msgid ""
"If you say so.  Personally I don't believe in them.  Would you like to buy something?"
msgstr ""
"Když to říkáš. Já osobně tomu nevěřím. Nechtěl by sis radši něco koupit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:12
msgid ""
"The Prophecy of the Elves, of course!  The great Elvish prophet Mairearad de Sitheag A'Tryht a'greatbow said the A'Rikdun Clan would carry the elves out of oppression."
msgstr ""
"Proroctví elfů, samozřejmě! Velký elfí prorok Mairearad de Sitheag Aťryht a'greatbow pravil, že kmen A'Rikdun vyvede elfy z útisku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:12
msgid "What Prophecy?"
msgstr "Jaké proroctví?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:13
msgid ""
"My mother used to tell me stories of the lost 14th clan of the Elves.  How they survived the Great Cataclysm by moving south.  She said they had to have survived.  The Prophecy depends on them."
msgstr ""
"Matka mi často vyprávěla příběhy o ztraceném 14. klanu elfů. Jak jeho příslušníci přežili Velkou pohromu tak, že odešli k jihu. Pravila, že museli přežít, neboť na nich závisí proroctví."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:15
msgid "Perhaps you would like to buy something?"
msgstr "Co kdyby sis něco koupil?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:2
msgid "That is very interesting."
msgstr "To je převelice zajímavé."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:3
msgid ""
"That's their First Name and their Clan.  Take me for instance.  My Regal Name is Muiredach de Cicilia A'Lanth a'relti.  But I usually only go by my Common Name, Muiredach A'Lanth"
msgstr ""
"Je to křestní jméno a jejich rod. Dám ti příklad: mé královské jméno zní Muiredach de Cicilia A'Lanth a'relti. Ale obvykle používám své obecné jméno - Muiredach A'Lanth."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:3
msgid "What is a Common Name?"
msgstr "Co je to obecné jméno?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:4
msgid ""
"Oh!  That's her Regal Name.  All elves with traditional names have names like that.  All it means is that Mairearad was born to Sitheag, and is a member of the A'Tryht Clan, and the a'greatbow Sil.  Most Elves go by their Common Name."
msgstr ""
"Ó, to je královské jméno! Všichni elfové s tradičními jmény si tak říkají. Všechno to znamená, že Mairearad se narodil v Sitheagu, je členem kmene A'Tryht a silu a'greatbow. Většina elfů se ale drží obecných jmen."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:4
msgid "That's some name."
msgstr "To je mi ale jméno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:5
msgid "Krohn willing, they will.  Perhaps you would like to buy something?"
msgstr "Dá-li Krohn, pak ano. Ale možná by sis teď chtěl něco koupit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:5
msgid "Perhaps they will be found someday."
msgstr "Možná na to jednoho dne přijdou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:6
msgid "Of course they survived."
msgstr "Samozřejmě že přežili."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:6
msgid ""
"We don't know that.  Even if they did survive, I wonder if they know there are other elven clans."
msgstr ""
"To netušíme. I kdyby přežili, rád bych věděl, jestli mají povědomost, kde jsou ostatní elfí kmeny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:7
msgid "The Lost Clan?"
msgstr "Ztracený klan?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:7
msgid ""
"Yes.  The A'Rikdun Clan.  They were one of the most prominent clans before the Great Cataclysm.  After the Great Cataclysm, people said they fled to the south.  I wonder if they ever lived.  Poor souls."
msgstr ""
"Ano. Kmen A'Rikdun. Před Velkou pohromou náležel k jednomu z nejpřednějších kmenů. Po katastrofě prý jeho členové uprchli na jih. Zajímalo by mne, zda ještě vůbec žijí. Ubožáci!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC15.rude:9
msgid "Perhaps.  We would like to see your wares."
msgstr "Snad. Teď bychom si ale rádi prohlédli tvé zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:1
msgid ""
"Oh, uhh, I guess you don't want to hear any more about my game.  Did you want to talk about something else?"
msgstr ""
"Och, hmm, myslím, že už nechceš nic víc slyšet o mojí skvělé hře. Chtěl bys mluvit o něčem jiném? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:1
msgid "SHUT UP!"
msgstr "DRŽ UŽ HUBU!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:10
msgid ""
"Those people think they know everything!  I told one of them about my game idea, and he said it was stupid!  Can you believe that?  He though MY idea was stupid.  Like his was any better!"
msgstr ""
"Ti lidé si myslí, že znají úplně všechno! Pověděl jsem jednomu z nich o mém nápadu s hrou a on mi řekl, že je to hloupé! Věřil bys tomu? Myslel si, že MŮJ nápad je hloupý. Jako by ten jeho byl snad nějaký lepší!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:12
msgid "Hey, no problem!  Any time!"
msgstr "To nebyl problém! Kdykoliv!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:2
msgid "We don't really have time for this."
msgstr "Na tohle opravdu nemáme čas."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:2
msgid ""
"When your piece gets on the same square as another piece, combat begins.  That's where the real fun begins.  You know why?  Because you and the other players can act out the real combat to decide who wins!  Isn't that cool?.."
msgstr ""
"Když se váš kámen dostane na to samé políčko, na kterém je již váš spoluhráč, začíná boj. A tady je to teprve opravdová zábava. Víte proč? Protože vy a ten druhý hráč můžete sehrát skutečný souboj, který rozhodne, kdo vyhraje! Není to skvělé? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:3
msgid "Ummm, is that so?"
msgstr "Hmmm, opravdu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:3
msgid ""
"Yeah.  And they don't ever think I know what I'm talking about.  It's ridiculous!  Those idiots!  Anyway, back to the game.  The goal is to collect more Thjorad than anyone else in the game.  You do that by moving your pieces around the board."
msgstr ""
"Jasně. A přitom vůbec netuší, že dobře vím, o čem mluvím. Je to směšné! Ti idioti! Takže, zpátky ke hře. Cílem každého hráče je nasbírat více thjoradu než kdokoliv jiný ve hře. Toho dosáhnete tak, že budete pohybovat svými kameny po hrací desce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:4
msgid "Then what?"
msgstr "A pak co?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:4
msgid ""
"Then you get to pick your game piece.  It can be a sword, an axe, or a rock.  The rock is my favorite.  You know why?  Because it's not stupid like those other games.  You know, like the ones at the gathering?  Those are ridiculous."
msgstr ""
"Pak si vyberete své hrací kameny. Může to být meč, sekyra, nebo kámen. Kámen je můj oblíbený. A víte proč? Protože není tak hloupý, jako jsou ty ostatní hry. Víte, jako ty hry na shromáždění. Ty jsou opravdu k smíchu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:5
msgid "Are you sure?  It's a great idea!"
msgstr "Víte to jistě? Je to skvělý nápad!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:5
msgid "Umm, no thanks."
msgstr "Hmm, ne díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:6
msgid ""
"Of course I do!  Why I've been working on this design for a board game for fifteen years!  Would you like to hear about it?"
msgstr ""
"Samozřejmě že mám! Pracuji na návrhu této deskové hry již patnáct let! Chtěl by sis to poslechnout?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:7
msgid "Fire away!"
msgstr "Tak ven s tím!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:8
msgid ""
"Yeah.  And they don't ever think I know what I'm talking about.   It's ridiculous!  Those idiots!    Anyway, back to the game.  The goal is to collect more Thjorad than anyone else in the game.  You do that by moving your pieces around the board."
msgstr ""
"Jasně. A přitom vůbec netuší, že dobře vím, o čem mluvím. Je to směšné! Ti idioti! Takže, zpátky ke hře. Cílem každého hráče je nasbírat více thjoradu než kdokoliv jiný ve hře. Toho dosáhnete tak, že budete pohybovat svými kameny po hrací desce."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:8
msgid "You know, we're kind of busy."
msgstr "Víš, my tak trochu spěcháme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:9
msgid ""
"Okay, so it starts out at the beginning, where you get to pick the player you want to play.  You can either be A Framon, who aren't very good, a Thjorgardian who are the worst, a Guberlandian, who are the best, an elf, or a dragon."
msgstr ""
"Dobře, takže začněme od začátku, kde si vyberete hráče, za kterého chcete hrát. Může to být Framonský, ti nejsou moc dobří, Thjorgardský, ti jsou nejhorší, Guberlandský, ti jsou nejlepší, elf nebo třeba drak."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC150.rude:9
msgid "Sure, go ahead."
msgstr "Jistě, pojďme na to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC151.rude:1
msgid ""
"Okay.  But I'm telling you you're talking to the next Sidfre Meirssen!"
msgstr "Dobře. Ale říkám ti, že mluvíš s dalším Sidfre Meirssenem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC151.rude:1
msgid "Uhh, maybe some other time."
msgstr "Hmm, možná někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC151.rude:2
msgid ""
"Those jerks at the Gathering threw me out!  Can you believe that!  They don't know that one day, I will be the next Halfdan the Game-wise!  Would you like to hear about my game?"
msgstr ""
"Ti pitomci mě ze shromáždění vyhodili! Věřil bys tomu? Oni neví, že jednoho dne budu další Halfdan Průkopník her! Chtěl bys slyšet něco o mé hře?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC151.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC213.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC222.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:14
msgid "Okay"
msgstr "Dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC151.rude:4
msgid ""
"They're all as dumb as Scandlan!  That guy just will not shut up and let anyone else talk!"
msgstr ""
"Jsou to všechno blbci, jako je Scandlan! Ten chlap nezavře hubu a nepustí nikoho ke slovu! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC152.rude:1
msgid "I got to kiss Tort'l Pau'hk last night!  Wow!  What a great night."
msgstr ""
"Dostal jsem minulou noc polibek od Tort'li Pau'hky! Jupí! To byla skvělá noc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC152.rude:2
msgid ""
"Last night I went out with Tort'l Pau'hk.  I took her to the Gathering!  It was an expensive night, but it was worth it!  I got to kiss her!!"
msgstr ""
"Minulou noc jsem byl na schůzce s Tort'li Pau'hkou. Vzal jsem ji na shromáždění! Byla to sice drahá noc, ale stálo to za to! Dostal jsem od ní polibek!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC152.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:11
msgctxt "said by the party"
msgid "What is that?"
msgstr "Co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC152.rude:3
msgid ""
"He's the guy in charge.  I wish I was him!  I bet he gets lots of girls!"
msgstr ""
"Je to velmi zodpovědný muž. Přál bych si být jako on! Vsadím se, že má spousty holek!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC152.rude:3
msgid "What do you know about the Jarl?"
msgstr "Co víš o jarlovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC153.rude:1
msgid ""
"Have I?  Of course I do!  Why last night I went out with Hekja Bjarnidotir, Ragnara Leifdotir, and Helga the Hands!  I tell you what, it was a long night!"
msgstr ""
"Jestli mám? Samozřejmě že mám! Byl jsem minulou noc s Hekjou Bjarnidotir, Ragnarou Leifdotir a Helgou Zručnou! Řeknu ti, byla to ale dlouhá noc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC153.rude:1
msgid "Have you got any news?"
msgstr "Máš nějaké nové zprávy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC153.rude:3
msgid ""
"Not much!  I hardly get any at all!  What with all the girls I've been out with.  But if you want my advice, don't go to long without it!  If you do, you'll be sorry!"
msgstr ""
"Moc ne! Nemám na něj čas! Asi jako vy nemáte čas na ženské. Ale jestli chcete dobrou radu, dlouho s tím neotálejte! Pokud budete, bude to vaše smůla! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC153.rude:3
msgid "What do you know about resting?"
msgstr "Co víš o odpočinku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:1
msgid ""
"Well, what news Haven't I got?  Last night I had to turn down dates with three girls, just to get some sleep!"
msgstr ""
"No, jaké zprávy bych měl mít? Minulou noc jsem musel odmítnout schůzku se třemi dívkami, abych se aspoň trochu vyspal! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:2
msgid ""
"Well, It's mostly because I'm irresistible to girls.  They just can't seem to get enough of me.  I'm in a whole other league than these two guys."
msgstr ""
"No, prostě jsem pro ženy neodolatelný. Vypadá to, že se mě nemohou nabažit. Jsem prostě jiná třída než tamti dva chlápci. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:7
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:7
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:7
msgid "Why is that?"
msgstr "Proč je tomu tak?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:3
msgid ""
"This is the place to be, that's it!  Around here, I'm well known, that's for sure!  There isn't anywhere else I'd rather be!"
msgstr ""
"To je přesně tohle místo! Tady v okolí jsem dobře známej, to je jistý! Neexistuje jiný místo, kde bych chtěl být raději! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:5
msgid ""
"Oh, her?  Um, er, yeah, uhh, we went out before.  She wasn't quite my type."
msgstr ""
"Ó, o ní? Hm, no, jo, hmm, už jsme se před časem setkali. Nebyla tak docela můj typ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC154.rude:5
msgid "What do you know about Lina Friggdotir?"
msgstr "Co víš o Lině Friggdotir?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC155.rude:1
msgid ""
"Did you see my wonderful performance?  I am an actor!  I play Emperor Trislan!"
msgstr ""
"Viděli jste už moje skvělé představení? Jsem herec! Hraju císaře Trislana!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC155.rude:3
msgid ""
"I am a wonderful actor!  Come back at 2:30 or 4:30.  You can see me perform!"
msgstr ""
"Jsem opravdu báječný herec! Přijďte sem ve 2:30 nebo ve 4:30. můžete vidět moje představení!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC155.rude:3
msgid "What do you know about acting?"
msgstr "Co víš o hraní?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC156.rude:1
msgid "I'm afraid I can't!  I've got to rehearse for my audition!"
msgstr "Obávám se, že na takové věci nemám čas. Musím si nazkoušet svou roli!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC157.rude:1
msgid ""
"I heard that Eyjolf has been trying to get an audition with the Guild of Thjoradric Actors.  I Haven't the heart to tell him it's hopeless.  He's a hack!"
msgstr ""
"Slyšel jsem, že se Eyjolf přihlásil do konkurzu ke spolku thjoradských herců. Neměl jsem to srdce mu říct, že nemá žádnou naději. Musel na to přijít sám!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC157.rude:3
msgid ""
"That's where the Guild of Thjoradric Actors are!  That's where anyone who's anyone goes when they've become someone!  I hope to get there someday!"
msgstr ""
"Tam odtud spolek thjoradských herců pochází! To je místo, kam jdou všichni ti, kteří chtějí, aby se z nich něco pořádného stalo! Doufám, že se tam taky někdy dostanu! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC157.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC230.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC250.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC251.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:5
msgid "What do you know about Thjorgard?"
msgstr "Co bys mi řekla o Thjorgardu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC158.rude:1
msgid ""
"Just last week I was the understudy to Hralof Boldtalker.  But he got himself into a fight and broke his jaw!  Now here I am!  My mamma would be so proud."
msgstr ""
"Právě minulý týden jsem dělala náhradníka Hralofu Boldtalkerovi. Jenže on se zapletl do nějaké šarvátky a zlomil si čelist! A teď jsem tu já! Moje máma by byla na mě tak pyšná."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC158.rude:3
msgid ""
"Have you seen the play?  Our writer did a lot of research to get everything right.  From what I understand, Captain Ralof really did kill Emperor Trislan."
msgstr ""
"Už jste viděli tu naši hru? Její autor hodně zkoumal dějiny, aby všechno odpovídalo skutečnosti. Z toho, co jsem pochopila, kapitán Ralof skutečně zabil císaře Trislana."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC159.rude:1
msgid ""
"I've got some advice for you.  Stay away from the fish.  It'll make you sick up something fierce!"
msgstr "Chci ti dát radu. Drž se dál od lovu ryb. Každý na to nemá žaludek!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC159.rude:2
msgid "Uh-huh.  Ask away."
msgstr "Ech. Ptej se hned."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC159.rude:3
msgid "I don't think I know much about that."
msgstr "Nemyslím si, že o tom něco o vím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC16.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:8
msgid "We would like some healing."
msgstr "Potřebovali bychom vyléčit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC16.rude:2
msgid "We thank you, my children."
msgstr "Děkuji ti, dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC16.rude:3
msgid "The gods look kindly on a penitent heart."
msgstr "Bohové vlídně shlížejí na kajícné srdce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC16.rude:4
msgid "I wish I could help you, my children, but we do not have any extra."
msgstr "Ráda bych ti pomohla, mé dítě, ale teď nemůžu nikoho postrádat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC16.rude:4
msgid "We are looking for a priest to take to a new church."
msgstr "Hledáme kněze, který by se ujal nového chrámu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC160.rude:2
msgid ""
"Did you like the play?  I commissioned the famous playwright Woolan Sheer to write it right!"
msgstr ""
"Líbila se ti ta hra? Pověřil jsem slavného dramatika Woolana Sheera, aby to napsal správně!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC160.rude:3
msgid ""
"Woolan was the real expert when writing the play.  I did have him add a few things for the play's sake, you understand.  A pure history lesson would have been boring!  It's our job to entertain first, and educate second."
msgstr ""
"Woolan byl opravdový odborník, když psal nějakou hru. Přinutil jsem ho přidat do hry pár věcí, jestli mi rozumíš. Skutečná lekce historie by byla nudná! Naším úkolem je na prvním místě pobavit a na druhém místě teprve šířit osvětu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:1
msgid ""
"Do you believe that you are ready?  Very well, here is your task:  There is a rare creature in this region known as the Magreeb.  You must find one and study it.  Return to me when you are finished and give a report."
msgstr ""
"Věříte, že jste připraveni? Nu, zde je váš úkol: V této oblasti žije vzácný tvor známý jako magríb. Musíte jednoho najít a prostudovat. Vraťte se ke mně, až budete hotovi, a podejte mi hlášení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:13
#: assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:28 assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:13
msgid "Perhaps later."
msgstr "Snad později."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:10
msgid "Very well.  Come back when you think you are ready."
msgstr "Dobře. Vraťte se zpátky, až si budete myslet, že jste připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:11
msgid ""
"Have you now?  Well, perhaps you can answer some questions I've had of it.  And this is for posterity, so please, be honest."
msgstr ""
"Skutečně? No, snad bys mi mohl odpovědět na několik otázek, které ohledně toho mám. A je to pro naše budoucí generace, takže prosím, buď poctivý."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:11
msgid "We studied the Magreeb."
msgstr "Prostudovali jsme magríba."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:12
msgid "Very well.  Was there anything else?"
msgstr "Dobře. Bylo tam něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:13
msgid ""
"It is not my time, but yours.  Perhaps there is something else you need guidance in?"
msgstr ""
"Není to můj čas, ale váš. Snad máte ještě něco jiného, s čím potřebujete poradit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:14
msgid "Green"
msgstr "Zelenou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:14
msgid ""
"Green?  Are you sure?  That means the ancient texts were wrong!  I will have to correct those.  Thank you for your help.  You are now promoted to Scholars."
msgstr ""
"Zelenou? Víte to jistě? To znamená, že starobylé texty jsou chybné! Budu to muset opravit. Díky za pomoc. Nyní jste povýšeni na učence."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:15
msgid "How do we get to Hallenhalt?"
msgstr "Jak se dostanu do Hallenhaltu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:15
msgid "The only people who get to Hallenhalt are dead heroes."
msgstr "Jediní lidé, kteří se dostanou do Hallenhaltu, jsou mrtví hrdinové."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:16
msgid "They carve the Fatestones.  It is they who create Writs of Fate."
msgstr "To ony vytesaly Osudové kameny. Jsou to ony, kdo stvořil Písmo osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:16
msgid "What do you know about the three Wyrdes?"
msgstr "Co víš o třech Wyrdách?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:17
msgid "Perhaps there is something else you need guidance on?"
msgstr "Snad máte něco jiného, s čím potřebujete poradit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:18
msgid ""
"Here are some words of advice.  He starts to stink, who outstays his welcome in a hall that is not his own."
msgstr ""
"Zde máte pár rad. Začíná smrdět ten, jenž se zdržuje v sídle, které není jeho vlastní."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:18
msgid "We need your advice."
msgstr "Potřebujeme tvoji radu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:19
msgid "We'd like you to answer some questions."
msgstr "Rádi bychom ti položili pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:19
msgid "What questions would you like answered?"
msgstr "Jaké otázky bys chtěl zodpovědět?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:2
msgid "The 11th direct descendant of Jevar the Bastard"
msgstr "11. přímý potomek Jevara Bastarda"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:2
msgid "Who is Tamur Leng?"
msgstr "Kdo je to Tamur Leng?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:20
msgid "Do you have any words of wisdom?"
msgstr "Nemáš nějaká moudrá slova?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:20
msgid ""
"When faced with overwhelming odds, remember this: Cattle die, kindred die, death comes to us all.  The one thing that will never die is the glory of a great deed."
msgstr ""
"Až budete čelit záplavě úderů, zapamatujte si toto: Dobytek umírá, příbuzní umírají, smrt přichází k nám všem. Jedna věc, která však nikdy nezemře, je sláva velkých činů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:21 assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:8
msgid "Go in peace."
msgstr "Jdi v míru."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:21
msgid "We don't need anything right now."
msgstr "Právě teď nic nepotřebuji."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC82.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:1
msgid "Can we ask you something else?"
msgstr "Můžeme se tě zeptat na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:3
msgid "You may ask.  The answers you seek are within."
msgstr "Můžete se ptát. Odpovědi, které hledáte, jsou nadosah."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:4
msgid "We are seeking promotion to Scholar"
msgstr "Hledáme někoho, kdo by nás povýšil na učence."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:4
msgid "We shall see.  Have you any initiates amongst your group?"
msgstr "Uvidíme. Máte ve svých řadách nějakého novice?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:6
msgid "If you want your promotion, of course you will!"
msgstr "Pokud chcete povýšit, tak budete muset!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:10
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:12
msgid "We will do this."
msgstr "Udělám to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:7
msgid "Firstly, what color was this creature?"
msgstr "Takže nejdříve, jakou barvu měl ten tvor?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:8
msgid ""
"Ah, red!  That is exactly what was said in the texts.  Wonderful.  Thank you for your help.  You are now promoted to Scholars."
msgstr ""
"Ach, červenou! Tak to je přesně tak, jak bylo psáno ve starých textech. Skvělé! Díky za pomoc. Nyní jste povýšeni na učence."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:8
msgid "Red"
msgstr "Červenou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC161.rude:9
msgid "You are welcome.  Now I've work to do.  Farewell."
msgstr "Nemáte zač. A teď mám něco na práci. Sbohem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC162.rude:1
msgid "Not really."
msgstr "Ve skutečnosti ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC162.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC166.rude:2
msgid "Hello.  We'd like to ask you some questions."
msgstr "Rádi bychom ti položili pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC162.rude:3
msgid "What do you know about Jevar the Bastard?"
msgstr "Co mi můžeš říct o Jevarovi Bastardovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC163.rude:1
msgid ""
"I've been working real hard to try and get myself into the play at the Akl'ai's tavern.  I think I'm really close.  The director has seen me, and I think he likes my work.  Of course he isn't paying me lip service.  No one of my talent gets that!"
msgstr ""
"Opravdu jsem na sobě tvrdě pracoval, abych se dostal do hry, co se hraje v Akl'aiho hospodě. Myslím, že jsem opravdu blízko. Principál mě viděl a něco mi dává tušit, že se mu má práce líbí. Samozřejmě mě neplatí za vykecávání. Nikdo, kdo nemá můj talent, to nedostane!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC163.rude:2
msgid "Well alright.  Go ahead, ask your questions."
msgstr "No dobře. Tak dělej, ptej se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC163.rude:3
msgid ""
"Well I know a lot about that.  But I don't have time to get into it right now.  Maybe some other time when We can sit around for hours, I can share my thoughts on that."
msgstr ""
"No, vím o tom celkem dost. Ale právě teď nemám čas ti to povědět. Možná někdy jindy, až si budeme moci sednout na pár hodin, pak ti budu moci sdělit své poznatky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC163.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC222.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC342.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC343.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC344.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC349.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC354.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC359.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC360.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC364.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC365.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC368.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC371.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC374.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC376.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:25
msgid "What do you know about Arslegard?"
msgstr "Co víš o Arslegardu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC163.rude:4
msgid "No, it was no bother at all, really!"
msgstr "Vůbec jste mě neotravovali, skutečně!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC163.rude:5
msgid "Sure, certainly.  It was no problem."
msgstr "Jistě, zajisté. To nebyl problém."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC164.rude:1
msgid ""
"I dropped my boom boom on my toe yesterday.  It ouched very bad.  Daddy says I only 'upposed to use the boom boom for pounding nails, but it's fun to play with."
msgstr ""
"Včera jsem si upustil kladívko na nohu. Hrozně to bolelo. Tatínek říká, že bych měl používat kladivo pouze na zatloukávání hřebíků, ale je to švanda, když si s ním hraju."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC164.rude:3
msgid "Nuthin'"
msgstr "Nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC164.rude:3
msgid "What do you know about hammers?"
msgstr "Co víš o kladivech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC164.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC164.rude:5
msgid "Okay.  Bye-bye."
msgstr "Ahoj."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:1
msgid ""
"Find yourself a partner.  If you do, love them well!  If everyone in the world did this, the world would be a better place!"
msgstr ""
"Najděte si partnera. A až si ho najdete, mějte se rádi! Kdyby to udělal každý, svět by byl mnohem krásnějším místem!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:2
msgid "Hello!  We'd like to ask you some questions."
msgstr "Rádi bychom ti položili pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:2
msgid "Of course!  That you may certainly do!"
msgstr "Samozřejmě! To zajisté můžete."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:3
msgid ""
"If you couldn't tell, I love food!  My favorite dish is the stew over at Akl'ai's Spirits.  I could eat a hundred pounds of that stuff in one day!  He won't sell that much to me, though.  He says I need to watch my weight."
msgstr ""
"Pokud to nevíš, tak já miluju jídlo! Nejradši mám dušené maso na Akl'aiho alkoholu. Mohl bych toho sníst stovky liber denně! Nicméně on mi tolik ani neprodá. Říká mi, že bych si měl hlídat váhu. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:3
msgid "What do you know about food?"
msgstr "Co mi můžeš říct o jídle?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:4
msgid "No trouble at all!"
msgstr "To vůbec nebyl problém!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC165.rude:5
msgid "It was my pleasure.  Farewell."
msgstr "Bylo mi potěšením. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC166.rude:1
msgid ""
"I asked Lina Friggdotir out the other day.  She turned me down, though.  She handed me a stick with bristles on it, and said she might consider going out if I used it.  I don't know what it's for, though."
msgstr ""
"Požádal jsem nedávno Linu Friggdotir o schůzku. Ale ona mě odmítla. Podala mi nějakou hůlku, na které byly štětiny, a řekla mi, že může pouvažovat o naší schůzce, pokud ji použiju. I když vůbec nevím, na co to je."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC166.rude:3
msgid ""
"My Dad was an adventurer.  He did a lot of things for the last Jarl of Guberland.  His boat sank on the way to Thronheim.  I didn't want to follow in his footsteps.  Drowning is no way to live!"
msgstr ""
"Můj otec byl dobrodruh. Udělal spoustu věcí pro předešlého jarla Guberlandu. Jeho loď se potopila na cestě do Tronheimu. Nechci následovat jeho kroky. Utopit se není způsob, jak žít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC166.rude:3
msgid "What do you know about quests?"
msgstr "Co mi můžeš říci o hostech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC166.rude:5
msgid "Have you ever washed your teeth?"
msgstr "Už sis někdy čistil zuby?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC166.rude:5
msgid "Why do you ask?"
msgstr "Proč se ptáš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC167.rude:1
msgid ""
"This place is just creepy.  I think it's getting time for me to leave.  The men around here are just so gross!  I mean, they hardly bathe, they don't brush their teeth, and then they come over and ask me for a date!  I really need to get out of here."
msgstr ""
"Tohle místo mi nahání hrůzu. Asi bych měla odejít. Ti muži tady v okolí jsou tak nechutní! Myslím si, že se vůbec nekoupají, ani si nečistí zuby a pak se najednou u mě zastaví a zeptají se mě, kolikátého je! Potřebuju odtud vypadnout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC167.rude:3
msgid ""
"That boy is a jerk!  Can you believe that he told his friends that we went to the Gathering together?  Only in his dreams, I can tell you that!  If he does it again, my brother is going to give him the what for!"
msgstr ""
"Ten kluk je opravdovej hňup! Věřil bys tomu, že řekl svým přátelům, že jsme šli na shromáždění spolu? Pouze v jeho snech, to ti teda říkám! Jestli to udělá ještě jednou, můj bratr mu dá co proto! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC167.rude:3
msgid "What do you know about Aso Stinkshirt?"
msgstr "Co víš o Aso Stinkshirtovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC168.rude:1
msgid "I won a prize at the Gathering!"
msgstr "Vyhrál jsem cenu na shromáždění!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC168.rude:3
msgid "It's a fun place to go to win prizes!"
msgstr "Je to pěkné místo, kde můžete vyhrát skvělé ceny!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC169.rude:1
msgid ""
"The Guberland Players are a fine bunch of actors, but sometimes I wonder if they're accurately portraying Ursanian History."
msgstr ""
"Guberlandští hráči jsou výborná skupinka herců, ale někdy vážně uvažuji o tom, zdali skutečně věrně zobrazují ursanskou historii."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC169.rude:3
msgid "Not very much.  Probably as much as any other person."
msgstr "Ne příliš mnoho. Asi tolik, co jakákoliv jiná osoba."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC169.rude:3
msgid "What do you know about Ursanian History?"
msgstr "Co mi můžeš říci o ursanské historii?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:1
msgid "Goodbybe."
msgstr "Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:10
msgid "I would recommend that you do.  Would you like to buy something?"
msgstr "Doporučuji vám, abyste tak učinili. Chcete si teď něco koupit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:10
msgid "Sounds like a bad place to be.  We'll try to avoid it."
msgstr "To vypadá jako pěkně nepříjemné místo. Pokusím se toho vyvarovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:11
msgid ""
"Hallenhalt is the exalted place where the worthy go when they die.  From what I've heard about it, Skraelos keeps them fit and happy.  They stay in Hallenhalt until the time comes when Krohn needs his army."
msgstr ""
"Hallenhalt je nádherné místo, kam po smrti odcházejí ti spravedliví. Podle toho, co jsem slyšel, jim Skraelos zajišťuje zdraví a štěstí. V Hallenhaltu setrvají, dokud nenadejde čas a Krohn nebude potřebovat jejich armádu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:11
msgid "What is Hallenhalt?"
msgstr "Co je to Hallenhalt?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:12
msgid "Of course.  Please, have a look around!"
msgstr "Zajisté. Prosím, jen se tu porozhlédni!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:2
msgid "Thanks for the tip."
msgstr "Díky za tip."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:13
msgid ""
"Watch where you sleep!  You never know when Skraelos will come for you."
msgstr ""
"Dávejte na sebe ve spánku pozor! Nikdy nevíte, kdy si pro vás přijde Skraelos!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:24
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:6
msgid "No thanks."
msgstr "Ne, děkuji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:2
msgid ""
"For the day of the Great Reckoning!  The day when even the gods must atone for their lives."
msgstr ""
"Pro Den velkého zúčtování! Den, kdy se dokonce i bohové budou muset zodpovídat za své činy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:2
msgid "What would Krohn need with an army?"
msgstr "K čemu Krohn potřebuje armádu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:3
msgid "Thanks for the info!"
msgstr "Díky za informace!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:3
msgid "You're welcome.  Perhaps you would like to buy something?"
msgstr "Není zač. Nechceš si teď třeba něco koupit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:4
msgid ""
"Well I am no theologian, but as I understand it, they are Guilt, Confession, Suffering, Retribution, Absolution, Rebirth.  Once they are lit, you are free to choose your destination."
msgstr ""
"Nu, nejsem žádný teolog, ale pokud tomu dobře rozumím, je to Vina, Přiznání, Utrpení, Odplata, Rozhřešení, Znovuzrození. Až dosáhnou osvícení, mohou si zvolit svůj cíl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:9
msgid "What are the Six Fires of Penance?"
msgstr "Co je to těch Šestero ohňů pokání?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:5
msgid ""
"Did you not learn your religion?  They must light the Six Fires of Penance.  If they can manage that, Skraelos will deem them worthy to ascend to Hallenhalt."
msgstr ""
"Cožpak ses neseznámil s naším náboženstvím? Musí rozsvítit Šestero ohňů pokání. Až se jim to podaří, mohou se vznést ke Skraelovi do Hallenhaltu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:5
msgid "How do they work off their debts?"
msgstr "Jak si odpracovávají své dluhy?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:6
msgid ""
"The Afterworld is where the unworthy go when they die.  It is a troublesome place, where the fallen souls work off the debts they earned in life."
msgstr ""
"Do posmrtného světa jsou po smrti uvrženi ti nehodní. Je to nepříjemné místo, kde si padlé duše odpracovávají dluhy svého původního života."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:6
msgid "What is the Afterworld?"
msgstr "Co je to posmrtný svět?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:7
msgid ""
"Skraelos is the god of the Afterworld.  He is the one who decides whether someone goes to the Afterworld, or if they are worthy of Hallenhalt."
msgstr ""
"Skraelos je bohem posmrtného světa. Je jedním z těch, kdož rozhodují, zda dotyčný půjde do posmrtného světa anebo zda je hoden Hallenhaltu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:7
msgid "Who is Skraelos?"
msgstr "Kdo je to Skraelos?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:8
msgid "Certainly.  Please take a look"
msgstr "Jasně. Jen se porozhlédni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:9
msgid "We would like to look at your wares."
msgstr "Rádi bychom se podívali na tvé zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC17.rude:9
msgid "We're closed."
msgstr "Máme zavřeno."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:3
msgid "IF you are skilled enough, I might help you."
msgstr "Pokud máte dostatek zkušenosti, mohu vám pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:1
msgid "We'd like to become Experts in Elemental Magic."
msgstr "Rádi bychom se stali experty v živelné magii."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:2
msgid ""
"Magic is the glue of life.  Without it, the whole world would unravel."
msgstr "Magie je tmelem života. Bez ní by se celý svět rozpadl."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:3
msgid "We'd like to become Masters in Elemental Magic."
msgstr "Rádi bychom se stali mistry v živelné magii."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:4
msgid "I am a mage.  Why would I know anything about swords?"
msgstr "Jsem mág. Proč bych měl cokoliv vědět o mečích?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:4
msgid "What do you know about swordmastery?"
msgstr "Co víš o mistrovství meče?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:5
msgid "Seek Gudlaug Eitrissen in Lindisfare."
msgstr "Vyhledej Gudlauga Eitrissena z Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC170.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:5
msgid "Where can we become Grandmasters in Elemental Magic?"
msgstr "Kde bychom se mohli stát velmistry živelné magie?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:3
msgid "Possess you the skill?"
msgstr "Ovládáš tuto dovednost?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:1
msgid "We'd like to become Experts in Light Magic."
msgstr "Rádi bychom se stali experty v magii světla."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:2
msgid ""
"I'm not sure, but I think I had a vision of Hallenhalt during yesterday's meditation."
msgstr ""
"Nejsem si jistý, ale myslím si, že jsem měl během včerejší meditace sen o Hallenhaltu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:3
msgid "We'd like to become Masters in Light Magic."
msgstr "Rádi bychom se stali mistry v magii světla."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:4
msgid ""
"It's a valuable skill to know!  The more practice you have, the more spells you can cast."
msgstr ""
"Pokud ji ovládáte, je to velmi cenná dovednost! Čím více cviku máte, tím více kouzel můžete sesílat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:4
msgid "What do you know about meditation?"
msgstr "Co mi můžeš říci o meditaci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:5
msgid ""
"In Lindisfarne, seek one named Annabel A'Tryht.  She will put you on the right course."
msgstr ""
"V Lindisfarnu vyhledej ženu jménem Annabel A'Tryht, která ti dá ten správný výcvik."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC171.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:5
msgid "Where can we become Grandmasters in Light Magic?"
msgstr "Kde bychom se mohli stát velmistry v magii světla?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:3
msgid "And you think you are skilled enough?"
msgstr "A myslíte si, že máte dostatek zkušeností?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:1
msgid "We'd like to become Experts in Dark Magic."
msgstr "Rádi bychom se stali experty v magii temnoty."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:3
msgid "We'd like to become Masters in Dark Magic."
msgstr "Rádi bychom se stali mistry v magii temnoty."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:4
msgid "Nothing I wish to share with you."
msgstr "Nic, co bych si přál ti sdělit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:5
msgid ""
"Go to Lindisfarne.  There is one named Alanna Etzeldotir who can help you."
msgstr ""
"Jdi do Lindisfarnu. Je tam žena jménem Alanna Etzeldotir, která ti může pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:5
msgid "Where can we become Grandmasters in Dark Magic?"
msgstr "Kde bychom se mohli stát velmistry v magii temnoty?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC172.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:40 assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:40
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:10
msgid "If you must."
msgstr "Když to musí být."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:3
msgid "Very well.  If you have the skills, I will train you."
msgstr "Dobře. Pokud máte tyto dovednosti, budu vás trénovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:1
msgid "We'd like to become Experts in Spirit Magic."
msgstr "Rádi bychom se stali experty v magii ducha."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:2
msgid ""
"Spirit is the key to the self.  Take care to learn it, and you will find yourself rewarded."
msgstr ""
"Duše je klíčem k sobě samému. Pokud budete dávat pozor, co vám sděluje, budete odměněni. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:3
msgid "We'd like to become Master in Spirit Magic."
msgstr "Rádi bychom se stali mistry v dovednosti magie ducha."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:4
msgid ""
"If you choose the path of magic, do not stray from it.  Your studies will bring you greatness."
msgstr "Pokud si vybereš cestu magie, nesejdi z ní. Učení ti přinese slávu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:4
msgid "What do you know about magic?"
msgstr "Co víš o magii?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:5
msgid "Find Gymir Lokissen in Lindisfarne."
msgstr "Najdi Gymira Lokissena z Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC173.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:5
msgid "Where can we become Grandmasters in Spirit Magic?"
msgstr "Kde bychom se mohli stát velmistry v magii ducha?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:3
msgid ""
"Many seek such training.  I ask you, do you possess the skill to become so?"
msgstr ""
"Mnozí hledají právě tento trénink. Ptám se, ovládáš tuto dovednost, aby ses jím mohl stát?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:1
msgid "We'd like to become Experts in Meditation."
msgstr "Rádi bychom se stali experty v meditaci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:2
msgid ""
"Look inward for your answers, children.  For the external quest only matters as a reflection of inner growth."
msgstr ""
"Pro odpovědi nahlédni do svého nitra, mé dítě. Vnější úkol je důležitý pouze pro odraz vnitřního růstu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:3
msgid "We'd like to become Masters in Meditation."
msgstr "Rádi bychom se stali mistry v dovednosti meditace."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:4
msgid ""
"That is a place to the south of us.  For more answers, you should consult with a cartographer."
msgstr ""
"Je to místo jižně odtud. Pokud by ses o něm chtěl dozvědět víc, měl by sis promluvit se zeměpiscem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:5
msgid ""
"Seek out Lindisfarne.  There is one who can help you there named Delano A'Lanth."
msgstr ""
"Dojeď do Lindisfarnu. Je tam jeden muž, který ti může pomoci. Jmenuje se Delano A'Lanth."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:5
msgid "Where can we become Grandmasters in Meditation?"
msgstr "Kde bychom se mohli stát velmistry v meditaci?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:6
msgid "Many people seek answers.  Perhaps I can help you find yours."
msgstr "Mnoho lidí hledá odpovědi. Snad můžu najít ty vaše."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:7
msgid "It was not a bother enough to be sorry for."
msgstr "Neotravovali jste mě tolik, abyste se mi museli omlouvat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC174.rude:8
msgid "May you fare well on your journeys, friend."
msgstr "Ať se vám daří na vašich cestách, přátelé."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC175.rude:1
msgid ""
"The actors.  That's not how it really happened.  I have evidence to prove it, too.  But the actors say, \"it's all craft!\"  And don't listen to my advice.  I don't understand this desire to change history based on \"artistic license\"!"
msgstr ""
"Takhle se to ve skutečnosti nestalo. Taky to můžu dokázat. Ale herci říkají, \"to je všechno umění!\" A neposlouchají mé rady. Nerozumím té touze měnit historii na základě \"umělecké koncese\"!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC175.rude:1
msgid "What do you mean, get it right?"
msgstr "Jak to myslíš to \"opravit\"?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC175.rude:3
msgid ""
"I've spent years researching it!  In fact, it wasn't Captain Ralof who killed Trislan at all!  It was Aklan'dor!  The one who conquered the Xisis!  At least they got that part right!"
msgstr ""
"Strávil jsem roky zkoumáním její historie! Ve skutečnosti to vůbec nebyl kapitán Ralof, kdo zabil Trislana! Byl to Aklan'dor! Ten, který dobyl Xisis! Alespoň tuhle část by mohli opravit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC175.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC265.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC380.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:20
#: assets_dev/worlds/mm9/dialogue/rude/NPC72.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC72.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:4
msgid "Bye."
msgstr "Ahoj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC176.rude:1
msgid ""
"I really like spending my time watching the plays.  It takes my mind off the work I do.  They let me escape into a world of adventure and excitement!"
msgstr ""
"Opravdu rád trávím čas sledováním divadelních her. Rozptyluje to mou mysl od práce, kterou dělám. Dovolí mi utéct do světa plného dobrodružství a vzrušení!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC176.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC187.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC252.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:18 assets_dev/worlds/mm9/dialogue/rude/NPC332.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC343.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC344.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:6
msgid "Sure!"
msgstr "Jasně!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC176.rude:3
msgid ""
"That's what I do!  Whenever someone asks for a rock, I go and get it for them.  It's hard work!  Those rocks can be heavy!"
msgstr ""
"To je to, co dělám! Kdykoliv mě někdo požádá o kameny, jdu a přinesu mu je. Je to těžká práce! Ty kameny mohou být hodně těžké!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC176.rude:3
msgid "What do you know about getting rocks?"
msgstr "Co víš o získávání kamenů?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:1
msgid ""
"I'm ready to get out of here.  These Guberlandians are driving me crazy!"
msgstr ""
"Jsem připravenej odtud vypadnout. Tihle Guberlanďani mě dohání k šílenství!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:10
msgid "Very well.  See you later."
msgstr "Dobře. Uvidíme se později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:2
msgid "Great!  Get me off this rock!"
msgstr "Skvěle! To mi spadne kámen ze srdce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:2
msgid "Sounds good.  You're hired."
msgstr "To zní dobře. Beru tě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:3
msgid "My fee is 500 gold per month plus 2% of all the gold we find."
msgstr "Má cena je 500 zlatých měsíčně plus 2% ze všeho zlata, které najdeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:4
msgid "So you're for hire?"
msgstr "Takže jsi pořád k najmutí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:4
msgid ""
"Yes.  As I said, I'm a merchant.  I have a keen eye for quality, and a quick tongue.  I could help you get better prices for all the things you buy and sell."
msgstr ""
"Ano. Jak už jsem řekl, jsem obchodník. Mám postřeh na kvalitu a mám mrštný jazyk. Mohl bych ti pomoci se smlouváním cen u všech věcí, které koupíš nebo prodáš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:5
msgid ""
"I seem to have lost all my money in a bar bet.  I've been trying to hire out my services to raise some cash."
msgstr ""
"Vypadá to, že jsem prohrál všechny svoje peníze v sázkách u baru. Pokoušel jsem se nabídnout své služby, abych si něco vydělal. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:5
msgid "Why Haven't you left?"
msgstr "Proč jsi tedy neodešel?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:7
msgid "I know I've seen enough of it!  These people are making me nuts!"
msgstr "Vím, že už ho mám plné zuby! Tihle lidé mi připadají úplně praštění!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:8
msgid "Alright, but you're losing money as long as I'm not around."
msgstr "No dobře, ale přicházíš o peníze, jakmile nejsem nablízku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:6
msgctxt "said by the party"
msgid "Maybe some other time."
msgstr "Možná někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:9
msgid ""
"I'm a merchant.  I've been stranded here in Guberland for weeks.  It's beginning driving me crazy."
msgstr ""
"Jsem obchodník. Trčím tady v Guberlandu už dva týdny. Začíná mě to dohánět k šílenství."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC177.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:19
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC423.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:4
msgid "What are you doing here?"
msgstr "Co tu děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:1
msgid ""
"Alfrigg Halfdanssen asked me to mend his sword, but before he gave it to me he changed his mind.  I still don't know why."
msgstr ""
"Alfrigg Halfdanssen mě požádal, abych mu opravil jeho meč, ale ještě předtím, než mi ho dal, si to najednou rozmyslel. Stále ještě nevím proč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:2
msgid "Alright.  You're hired!"
msgstr "V pořádku. Jsi přijat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:2
msgid "Great!  I won't let you down!"
msgstr "Skvěle! Nezklamu vás!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:3
msgid ""
"For the price of 600 gold per month, I would be willing to be your traveling repairman.  I'd go where you go, and fix all your stuff for free."
msgstr ""
"Za cenu 600 zlatých měsíčně bych byl ochotný s vámi cestovat jako opravář. Šel bych tam, kam byste šli vy, a zadarmo bych opravoval všechny vaše věci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:3
msgid "How much do you charge?"
msgstr "Kolik si účtuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:5
msgid "How's business?"
msgstr "Jak jdou obchody?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:4
msgid ""
"Slow.  People around here never want to let me fix their things.  They usually would rather do it themselves."
msgstr ""
"Špatně. Lidé tady v okolí nikdy nechtějí, abych jim něco opravil. Obvykle si své věci raději opraví sami."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:6
msgid "I can fix just about anything you give me, that's all!"
msgstr "Umím opravit skoro všechno, co mi dáte, co chcete víc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:6
msgid "What do you know about mending things?"
msgstr "Co víš o opravování věcí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:7
msgid "Okay.  Bye."
msgstr "Dobře. Ahoj."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:7
msgid "Sorry, we don't need anyone to fix our things."
msgstr "Promiň, ale my zrovna nikoho na opravu věcí nepotřebujeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:8
msgid "I'm a tinker.  I mend things."
msgstr "Já jsem kutil. Opravuju věci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:6
msgid "What do you do here?"
msgstr "Co tu děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:9
msgid "Alright.  I'll be around if you need me."
msgstr "V pořádku. Budu nablízku, kdybys mě potřeboval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC178.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:14
msgid "We no longer need your services."
msgstr "Už více nepotřebuji tvých služeb."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:10
msgid "I understand, friends.  May the gods bless your endeavors."
msgstr "Rozumím vám, přátelé. Ať bohové žehnají vašemu úsilí. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:11
msgid "Did you call it my time?  What a strange way to put it!"
msgstr "Nazvali jste to mým časem? Jak neobvyklý způsob, jak to říct!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:12
msgid "My time?  Why should I own time?"
msgstr "Můj čas? Proč bych měla vlastnit čas? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:2
msgid ""
"I have heard that on the plains of Grimknak, the Oozli have started a coup against the Hatoi.  I pray that the Hatoi sqorl their Narfti and not give in."
msgstr ""
"Slyšela jsem, že na planinách Grimknaku Oozlové začali státní převrat proti Hatoiským. Modlím se, aby Hatoiští rozprášili jejich Narfti a nevzdali se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:3
msgid "A bargain.  You're hired."
msgstr "Dobrá nabídka. Bereme tě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:3
msgid "Your travel just got much easier."
msgstr "Vaše cesta teď bude mnohem jednodušší."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:4
msgid "Yes.  I charge 1000 gold per month plus 15% of the gold you find."
msgstr ""
"Ano. Účtuji si 1000 zlatých měsíčně plus 15% ze všeho zlata, které najdeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:4
msgid "You're for hire?"
msgstr "Ty jsi k najmutí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:5
msgid "Gods willing, I will have your answers."
msgstr "Dají-li bohové, odpovím ti. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:6
msgid "A strange place this is.  I often long for my home in the Tizkak."
msgstr "Je to opravdu zvláštní místo. Často toužím po svém domovu v Tizkaku. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:6
msgid "What do you know about Chedian"
msgstr "Co bys mi řekla o Chedianu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:7
msgid "Perhaps you will find a time when money isn't so important."
msgstr "Snad nastane čas, kdy pro vás peníze nebudou tak důležité. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:7
msgid "That's too deep for our pockets."
msgstr "To je příliš mnoho na naše kapsy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:8
msgid ""
"In your language I am called a Gate Master.  I can teleport you to any nearby city in Chedian, for a price."
msgstr ""
"Ve vašem jazyce mi říkají Paní dveří. Mohu vás za určitou cenu teleportovat do blízkosti jakéhokoliv města v Chedianu. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:6
msgid "What do you do?"
msgstr "Co děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC179.rude:9
msgid "We'd like you to cast Town Portal."
msgstr "Chtěli bychom, abys vykouzlila Městskou bránu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:1
msgid "Glad to hear it.  Were you looking for passage?"
msgstr "To rád slyším. Hledali jste cestu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:1
msgid "Perhaps we will."
msgstr "Možná tak učiním."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:11
msgid "And what sort of info would that be?"
msgstr "A jaká informace by to měla být?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:4
msgid "No thanks, I was hoping you might have some information."
msgstr "Ne, děkuji. Doufal jsem, že bys mohl mít nějakou informaci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:13
msgid ""
"He is the Jarl of the Thjorgard Clan.  As long as he keeps the Thjoradric Mines running, I'll never know starvation."
msgstr ""
"Je vládcem thjorgardského kmene. Dokud udržuje v chodu thjoradské doly, budou žít Thjorgardští v blahobytu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:27 assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:10
msgid "What do you know about Sven Forkbeard?"
msgstr "Můžeš nám prozradit něco o Svenu Vidlobradovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:14
msgid ""
"Good and bad.  Ever since the mountain pass between Thjorgard and Thronheim has been lost, we ship captains have made a great deal of money."
msgstr ""
"Dobře i špatně. Od té doby, co jsme přišli o horský průsmyk mezi Thjorgardem a Thronheimem, vydělali jsme si my lodní kapitáni pěkné peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:15
msgid "Certainly.  Anything else?"
msgstr "Jistě. Ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:2
msgid ""
"If there was something to be done about it, Tryygva Ravenlocks would have found it by now.  He wouldn't let his people starve.  Perhaps you should talk to him about it."
msgstr ""
"Pokud se v tom dá něco dělat, Tryygva Havraních kadeří už na to přišel. Nenechal by svůj lid trpět hladem. Možná by sis s ním měl o tom promluvit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:2
msgid "No one can do anything about it?"
msgstr "A nikdo s tím nemůže nic dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:3
msgid ""
"The port in Frosgard has been frozen solid.  It used to be a lucrative place to put in, but now, no ship captain in their right mind would try to brave those treacherous waters.  The poor souls who live there must be starving by now."
msgstr ""
"Přístav ve Frosgardu je kompletně zamrzlý. Bývalo to lukrativní místo, kam bylo radost vplouvat, ale nyní se tam žádný kapitán, který má všech pět pohromadě, neodváží. Ti chudáci, co tam žijí, už musí pořádně hladovět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:3
msgid "What's bad then?"
msgstr "Co je tedy špatně?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:4
msgid "Could you take us there?"
msgstr "Mohl bys nás tam dopravit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:4
msgid ""
"I don't know why you would be wanting me to take you there.  It's somewhere in the hills of Thjorgard.  That's all I know."
msgstr ""
"Nevím, proč chcete zrovna po mně, abych vás tam vzal. Je to kdesi v thjorgardských horách. To je vše, co vím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:1
msgid "And what would that be?"
msgstr "A co to bude?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:5
msgid "Perhaps we should ask you about something else."
msgstr "Mohli bychom se zeptat ještě na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:6
msgid "Nothing.  Who is that?"
msgstr "Nic. Kdo je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:7
msgid "I think that we will."
msgstr "Myslím, že tak učiníme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:8
msgid "Yes, please."
msgstr "Ano, prosím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:9
msgid "Aye, I've heard of that place."
msgstr "Jo, o tom jsem slyšel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC18.rude:9
msgid "Have you heard of a place known as The Training Hall?"
msgstr "Slyšel jsi někdy o tréninkových halách?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:5
msgid "Tell them we will be meeting in Thronheim in two weeks."
msgstr "Řekni jim, že se sejdeme za dva týdny v Tronheimu. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:1
msgid "The message is as good as sent!  I will see you at the war council."
msgstr ""
"Dobře tedy, pošlu zprávu i ostatním jarlům! Uvidíme se na válečné poradě. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:10
msgid ""
"Farewell, adventures, and thank you.  You have raised the hearts and saved the lives of thousands."
msgstr ""
"Sbohem, dobrodruzi, a děkuji vám. Vy všichni jste zachránili životy tisíců. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:10
msgid "We have more to do, but when that is done, we shall."
msgstr ""
"Musíme toho ještě mnoho vykonat, ale až se tak stane, budeme spojenci. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:11
msgid ""
"That is indeed good news.  Here is a small reward.  It may not be much, but behind it is the thanks and love of the thousands of lives you have saved."
msgstr ""
"To jsou vskutku skvělé zprávy. Tady je malá odměna. Možná to není mnoho, ale skrývá se za tím poděkování a láska tisíců životů, které jste zachránili. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:11
msgid "The boats should be coming very soon."
msgstr "Lodě by měly dorazit velmi brzy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:12
msgid "A promise?  What sort of promise?"
msgstr "Slib? Jaký slib?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:12
msgid "He wants you to make a promise."
msgstr "Chce od tebe slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:13
msgid ""
"For as long as anyone can remember, there has been a frost giant who lives in Yanmir's Sky Fort.  When we were young we all heard stories of how he would come down at night and eat children.  Well the stories have turned out to be true."
msgstr ""
"Již celá staletí žije v Nebeské tvrzi mrazivý obr Yanmir. Když jsme byli mladí, všichni jsme slýchávali příběhy o tom, jak jednou sejde v noci dolů a začne požírat děti frosgardského národa. No a příběhy se staly skutečností. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:13
msgid "Tell us about the frost giant."
msgstr "Pověz nám o mrazivém obrovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:14
msgid ""
"Only if you could defeat the Frost Giant, or somehow break up the ice so the ships can put in to our port."
msgstr ""
"Pouze kdybys dokázal porazit mrazivého obra nebo nějakým způsobem rozbít led tak, aby se mohly lodě dostat do našeho přístavu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:14
msgid "Perhaps we could help?"
msgstr "Snad bychom mohli pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:15
msgid "But without your help, the Chedian will perish!"
msgstr "Ale bez tvé pomoci se Chedian rozpadne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:15
msgid ""
"We are already perishing up here.  I have done all I can, and it is still not enough."
msgstr ""
"Ale my se už rozpadáme. Udělal jsem, co jsem mohl, a stále to ještě není dost. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:16
msgid ""
"I am sorry.  I have no more help to give.  My nation is in shambles.  The people are starving because the boats can't get through.  Yanmir the Frost Giant is eating our children.  I have my hands full.  I cannot give any more."
msgstr ""
"Je mi líto, ale nemohu ti pomoci. Můj národ pomalu vymírá. Lidé hladovějí, přístav je dočista zamrzlý a mrazivý obr Yanmir požírá naše děti. Mám plné ruce práce. Nemůžu více pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:17
msgid "A promise to remember to celebrate him."
msgstr "Slib toho, že ho neopomenete oslavovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:17
msgid ""
"If he brings the crops back, of course I will make that promise.  How does he want it?  A declaration?  I PROMISE!!  Is that good enough?"
msgstr ""
"Pokud to postačí, aby se na nás přestal hněvat, pak mu ten slib samozřejmě dám. A jak to chce? Jako prohlášení? SLIBUJI!! Stačí to takto?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:18
msgid ""
"A runestone promise?  I can think of nothing more binding than that.  If it brings my people back from the brink of starvation, I shall carve that runestone myself!"
msgstr ""
"Do kamene? Není nic jednoduššího! Jestliže to můj lid zachrání před hladomorem, vytesám ten slib do kamene sám! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:18
msgid "He wants you to carve it on a runestone."
msgstr "Chce od vás, abyste mu ten slib vytesali do kamene."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:19
msgid "I appreciate that.  Thank you for all your help."
msgstr "To bych opravdu ocenil. Děkuji ti za pomoc. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:19
msgid "We will tell him that for you."
msgstr "My mu to od tebe vzkážeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:2
msgid ""
"News?  I only seem to deal in bad news.  My people are starving, and our children are being eaten by the Frost Giant.  How could things get any worse?"
msgstr ""
"Nové zprávy? Vypadá to, že jediné nové zprávy jsou špatné zprávy. Moji lidé hladoví a naše děti jsou požírány mrazivým obrem. Jak by to mohlo být ještě horší? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:20
msgid ""
"No, I mean it!  You have done more for Frosgard than I ever have.  Perhaps it is you who should be Jarls.  I'm sorry; I shouldn't put that weight on you.  Was there anything else?"
msgstr ""
"Ne, myslím, že ano! Vykonali jste pro Frosgard více, než jsem kdy vykonal já. Možná jste to vy, kdo by měl být jarly. Omlouvám se, neměl bych na vás vkládat takové břímě. Potřebujete ještě něco jiného? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:20 assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:16
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:7
msgctxt "said by the party"
msgid "You're welcome."
msgstr "Rádo se stalo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:22
msgid ""
"I've heard that an army is marching towards us.  Good.  I won't put up a fight.  Maybe they will be able to rule Frosgard better than I have."
msgstr ""
"Zaslechl jsem, že k nám pochoduje armáda. Dobře. Nebudeme bojovat. Možná její vůdce dokáže vládnout Frosgardu lépe, než jsem vládl já. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:22 assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:5
msgid "What do you know about the hordes?"
msgstr "Co víš o hordách?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:23
msgid ""
"Frosgard used to have a thriving port, but in the last few years, the ice that comes in the winter has never gone away.  Since the boats can't get through, they can't bring enough food to feed our people."
msgstr ""
"Frosgard míval velice prosperující přístav, jenže tentokrát se stalo, že led, který se sem dostává při jarním tání, znovu zamrzl. Od té doby se sem nedostane žádná loď s potravinami a můj lid hladoví. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:23
msgid "Tell us about the frozen sea."
msgstr "Řekni nám něco více o zamrzlém moři."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:24
msgid "Is there anything else you needed?"
msgstr "Je tu něco jiného, co bys potřeboval?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:25 assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:37
msgid ""
"Great!  You have done a wonderful thing!  I shall send word to all the Jarls immediately!"
msgstr ""
"Skvěle! Vykonali jste báječnou věc! Ihned pošlu zprávu všem ostatním jarlům! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:26
msgid "About those things you need done...."
msgstr "Ty věci, které jsi potřeboval splnit..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:27
msgid ""
"Sven Svenssen you mean?  He's the Jarl of Thjorgard.  I wish I were in his shoes.  Maybe I should talk to him for some advice.  He's the most powerful man in Chedian!"
msgstr ""
"Máte na mysli Svena Svenssena? Je to thjorgardský jarl. Přál bych si být na jeho místě. Možná bych si s ním měl promluvit a vyslechnout si nějaké jeho rady. Je to nejsilnější muž Chedianu! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:28
msgid "Good luck in your travels."
msgstr "Hodně štěstí na vašich cestách."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:29 assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:30 assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:39
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:33
msgid "We've already done that."
msgstr "Už jsme to udělali."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:29
msgid ""
"You have?  Wonderful!  You have put the first smile on this old face in many years!"
msgstr ""
"Opravdu? Báječné! Po mnoha letech jste do mé staré tváře vrátili úsměv! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:3
msgid "May Krohn himself take an interest in your success!  Good luck!"
msgstr "Ať se sám Krohn zajímá o váš úspěch! Hodně štěstí! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:30
msgid "What?  How?  Even my strongest men couldn't do such a feat!"
msgstr "Cože? Jak? Dokonce ani mí nejsilnější muži to nedokázali! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:31
msgid "Yanmir the Frost Giant is dead."
msgstr "Mrazivý obr Yanmir je mrtev."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:31
msgid ""
"You have slain him?  How can that be?  He has killed some of my best soldiers before you?"
msgstr ""
"Vy jste ho zabili? Jak se vám to podařilo? Zabil ještě před vámi několik mých nejlepších vojáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:32
msgid "I don't blame you.  It's an impossible task."
msgstr "Já ti to nevyčítám. Vlastně ani nevěřím, že se ti to podaří. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:32
msgid "We need more time before we can take that on."
msgstr "Potřebujeme trochu více času, než budeme moci splnit ten úkol."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:33
msgid ""
"I have heard!!  What wonderful news!  You have put a smile on this old face for the first time in years!"
msgstr ""
"Slyšel jsem!! Jak skvělé zprávy! Díky vám se na mé staré tváři poprvé za poslední léta objevil úsměv!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:33
msgid "The ice has been cleared from the docks."
msgstr "Vyčistil jsem doky od ledových ker."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:34
msgid "I know it's an impossible task.  I don't blame you for not taking it."
msgstr ""
"Vím, že je to nesplnitelný úkol. Nevyčítám ti, že se ho nechceš zhostit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:34
msgid "We can't do that right now."
msgstr "Nemohu to splnit hned teď."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:35
msgid "We have done as you asked.  Will you help us now?"
msgstr "Udělali jsme, oč jsi nás žádal. Teď nám již pomůžeš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:36
msgid "It's running out for me you know.  Time that is."
msgstr "Už se mi krátí, víte. To je přesně čas. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:37
msgid "The Clans have united.  It is time for the war council."
msgstr "Klany se sjednotily. Je čas na válečnou poradu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:38
msgid ""
"Maybe you should talk to Soxolf Tryygvassen.  He built the one we have in the first place.  I'm sure he'll be able to help."
msgstr ""
"Možná by sis měl promluvit se Soxolfem Tryygvassenem. On postavil tu, kterou tu máme. Jsem si jist, že ti bude schopen pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:38
msgid "The Green Man asked us to fix the maypole."
msgstr "Zelený mužíček nás požádal o opravu májky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:39
msgid "The Green Man asked you to do something for him."
msgstr "Zelený mužíček vás žádá, abyste pro něho něco udělali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:39 assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:11
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:3
msgid "What is that?"
msgstr "Co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:4
msgid ""
"If you could help me, you would find a way to break up that ice, so the boats could travel again.  If you would do that, the skalds would make sure your names lived forever!"
msgstr ""
"Pokud byste mi chtěli pomoci, najděte nějaký způsob, jak rozbít led, aby lodě mohly znovu vplouvat do přístavu. Pokud by se vám to povedlo, místní lidé by se postarali, aby vaše jména žila navždy!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:4
msgid "What can we do?"
msgstr "Co můžeme udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:41
msgid "We failed you Tryygva, and we are sorry."
msgstr "Zklamali jsme tě, Tryygvo, a za to se ti omlouváme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:41
msgid ""
"You may yet have the chance to save my people again, warriors.  Go, and rescue us."
msgstr ""
"Nyní máte šanci zachránit můj lid znovu, bojovníci. Běžte a zachraňte nás."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:5
msgid "May the gods look kindly upon you for all your days!"
msgstr "Kéž by k vám byli bohové shovívaví po všechny vaše dny! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:6
msgid ""
"But I see you were.  That is great news!  I am certain all the families throughout Frosgard will be thanking you!  Here is a reward.  It is a pittance, I know, but we are poor here.  Think of it more as a symbol of our gratitude."
msgstr ""
"Ale koukám, že vy ano. To jsou skvělé zprávy! Jsem si jistý, že vás budou velebit všechny rodiny po celém Frosgardu! Zde je odměna. Je to jen almužna, vím, ale jsme bohužel velmi chudí. Považujte to za více než pouhý symbol naší vděčnosti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:6
msgid "Perhaps they were not strong enough."
msgstr "Možná nebyli dost silní."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:35 assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:7
msgid ""
"It would seem there is nothing you cannot accomplish.  I would be proud to call you allies."
msgstr ""
"Vypadá to, že neexistuje nic, co by vás zastavilo. Byl bych pyšný, kdybych vás mohl nazývat spojenci. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:7
msgid "Now that we have done as you asked, will you join us?"
msgstr "Teď, když jsme splnili, oč jsi nás žádal, připojíš se k nám? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:8
msgid ""
"If you are to help me, find a way into the Sky Fort, and slay the Frost Giant.  As far as I know, it would be impossible to kill him outright.  But the Sky Fort is old and rickety.  I'm sure there is a way you could trick him into killing himself."
msgstr ""
"Pokud mi chcete pomoci, najděte cestu do Nebeské tvrze a zabijte mrazivého obra. Pokud vím, je nemožné ho zabít přímo na místě. Ale Nebeská tvrz je stará a zchátralá. Jsem si jistý, že existuje způsob, jak byste ho mohli napálit tak, aby se zabil sám. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:4
msgid "What can we do to help?"
msgstr "S čím ti můžeme pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:9
msgid "Send the word, and Frosgard shall be ready."
msgstr "Pošli zprávu a Frosgard bude připraven."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC180.rude:9
msgid "We shall be having a war council soon."
msgstr "Brzy by se měla uskutečnit válečná porada."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:1
msgid "The Ranger's Trial consist of two separate tasks."
msgstr "Zkouška hraničáře sestává ze dvou samostatných úkolů."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:11
msgid "Come back to me when you do."
msgstr "Vraťte se ke mně, až budete připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:12
msgid "Tell us about the second task."
msgstr "Řekni nám o druhém úkolu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:12
msgid ""
"There is a place in Frosgard known as the Dungeon of Secrets.  To pass the second test, you must go from one end of the dungeon to the other.  If you survive, you pass."
msgstr ""
"Ve Frosgardu je místo známé jako Žalář tajemství. K tomu, abyste splnili druhou zkoušku, musíte projít z jednoho konce žaláře na druhý. Pokud přežijete, splnili jste."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:13
msgid "Perhaps you are not yet worthy."
msgstr "Asi nejste takoví hrdinové."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:14
msgid "Maybe you are not worthy just yet."
msgstr "Možná nejste takoví hrdinové. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:15
msgid ""
"All of Frosgard has neglected nature.  It's no wonder the people are starving!"
msgstr ""
"Všichni zdejší obyvatelé zanedbávali přírodu. Vůbec se nedivím, že nyní hladovějí! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:13
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:7
msgctxt "said by the party"
msgid "Perhaps another time."
msgstr "Snad někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:16
msgid "You will return when you are braver."
msgstr "Vraťte se, až budete statečnější."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:17
msgid "About the Ranger's Trial."
msgstr "O zkoušce hraničáře.."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:18
msgid ""
"Chadwick already informed me of your success.  Congratulations.  I hereby promote you to Rangers."
msgstr ""
"Chadwick mě již informoval o vašem úspěchu. Gratuluji. Tímto vás povyšuji na hraničáře."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:18
msgid "We've completed the Ranger's Trial."
msgstr "Splnili jsme zkoušku hraničáře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:19
msgid "Good Luck"
msgstr "Hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:19
msgid "We will do these tasks"
msgstr "Splním tyto úkoly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:2
msgid "Carry yourselves with pride and honor.  Farewell."
msgstr "Kráčej s hrdostí a ctí. Sbohem. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:3
msgid "Tell us about the first task."
msgstr "Pověz nám o prvním úkolu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:3
msgid ""
"There is a bow known as Everstrike.  It is the greatest bow ever made.  It never misses.  To pass the first test, you need to find this bow.  The last I heard, someone named the Dook had been looking for it also.  You'd better find it before he does."
msgstr ""
"Existuje luk známý jako Přesnostříl. Je to ten největší luk, jaký byl kdy vyroben. Nikdy nemine cíl. Abyste prošli první zkouškou, musíte ho najít. Zaslechla jsem, že kdosi jménem Dook hledá tento luk také. Měli byste jej raději najít dříve než on."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:5
msgid "Very good."
msgstr "Velmi dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:6
msgid ""
"Frosgard is facing a plight of nature.  It's horrible.  I wish Tryygva would do something about it!"
msgstr ""
"Celý Frosgardu směřuje k zániku. Je to hrozné. Přála bych si, aby s tím Tryygva něco udělal! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:8
msgid "Very well.  Good luck."
msgstr "Dobře. Hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:9
msgid ""
"The Ranger's Test is quite an ordeal.  Do you have any that are worthy?"
msgstr ""
"Zkouška hraničáře je docela tvrdá. Máte v družině někoho tak schopného?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC181.rude:9
msgid "We've heard you can promote Crusaders to Rangers."
msgstr "Zaslechli jsme, že můžeš povýšit křižáka na hraničáře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:2
msgid "How do we find the Green Man?"
msgstr "Jak najdeme Zeleného mužíčka?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:2
msgid ""
"There is a man who might be able to help you.  He is a tracker named Fland de Allasan A'Lanth a'rysha.  The last I saw of him, he was hanging around Frosgard City."
msgstr ""
"Existuje muž, který by měl být schopen ti pomoci. Je to stopař jménem Fland de Allasan A'Lanth a'rysha. Naposledy jsem ho viděla, když se potloukal v okolí města. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:3
msgid ""
"It's a travesty how the people here have neglected the Green Man!  It's no wonder he's abandon us!"
msgstr ""
"Je opravdu hrozné, jak tady lidé zanedbávají Zeleného mužíčka! Vůbec se nedivím, že se od nás odvrátil! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:20
msgid "I wish you luck."
msgstr "Přeji ti štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:4
msgid "We will find the Green Man."
msgstr "Najdu Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:5
msgid ""
"To have your worth truly measured, you must find the Green Man.  The people of Frosgard have long neglected him, and he has not been seen much anymore.  If you can find the Green Man and gain his approval, you will not need me to promote you."
msgstr ""
"Abych vyzkoušela vaše opravdové schopnosti, musíte najít Zeleného mužíčka. Lidé Frosgardu ho dlouho zanedbávali a již léta ho nikdo neviděl. Pokud jej dokážete najít a získat jeho uznání, nebudete mne potřebovat, abych vás povýšila. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:6
msgid "Our Healers are looking for promotion."
msgstr "Naši léčitelé hledají povýšení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:6
msgid ""
"The Druidical Endeavor is not for the weak.  Not all Healers are worthy of becoming Druids.  Do you have any who are worthy of this promotion?"
msgstr ""
"Druidská námaha není pro slabochy. Ne všichni léčitelé jsou schopni stát se druidy. Máte v družině někoho, kdo je tohoto povýšení hoden? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:7
msgid "He's a very difficult person to find!"
msgstr "Je to bytost, kterou je velmi těžké najít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:7
msgid "What do you know about the Green Man?"
msgstr "Co víš o Zeleném mužíčkovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:8
msgid "Maybe you are not as worthy as you thought you were."
msgstr "Možná nejste tak schopní, jak jste si prvně mysleli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:8
msgid "Perhaps we will do this later."
msgstr "Snad to splním později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC182.rude:9
msgid "Come back when you have."
msgstr "Vrať se zpátky, až tomu tak bude."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:1
msgid "Thanks for the advice."
msgstr "Díky za radu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:2
msgid ""
"Only if you wish to become a Lich.  Here, I have the first half of it.  Only by finding the second half will you be able to become a lich."
msgstr ""
"Jen v případě, že si přejete stát se lichem. Tady mám jeho první polovinu. Pouze pokud naleznete druhou polovinu, budete schopni proměnu v licha podstoupit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:2
msgid "We have to get this document?"
msgstr "Musíme získat ten dokument?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:3
msgid ""
"Then I shall tell you of the Lich's Transmutation.  In the place known as Chasm of the Dead, an ancient burial ground in Drangheim lies a parchment that contains the instructions on how to become a Lich."
msgstr ""
"Pak ti tedy povím o proměně v licha. V místě zvaném Rokle smrti, na starobylé pohřební posvátné půdě Drangheimu, leží pergamen, který obsahuje postup, jak se stát lichem. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:4
msgid ""
"Perhaps one day there will be a Scholar among you who will wish to become a Lich?"
msgstr ""
"Možná se jednoho dne najde ve vaší družině učenec, který si bude přát stát se lichem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:4
msgid "What sort of information is that?"
msgstr "Co je to za informaci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:5
msgid ""
"You have the look of someone who might be interested in the information I have."
msgstr "Vypadáš jako někdo, koho by mohla zajímat informace, kterou mám. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC388.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:3
msgid "Ask your questions."
msgstr "Tak se ptej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:7
msgid "That is too bad.  There is gold to be had there, also."
msgstr "Tak to je špatné. Také by tam mělo být zlato. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC183.rude:8
msgid "More than I shall share with you."
msgstr "Více než ti mohu sdělit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:1
msgid "Sorry"
msgstr "Promiň."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:1
msgid ""
"Well no sense in getting upset over it.  Here's a little bit for your effort.  I appreciate you trying at least.  Farewell."
msgstr ""
"No, nedělejte si z toho žádnou hlavu. Tady máte něco málo za svou námahu. Cením si toho, že jste se aspoň trochu snažili. Sbohem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:10
msgid ""
"As a matter of fact, there is.  You see my apprentices have created a new brew that doesn't seem to be popular here.  It's a strange color, and there's not much of the foam on it, but I have a feeling the Guberlandians will like it."
msgstr ""
"Ve skutečnosti ano. Jak vidíš, moji učňové vytvořili nové pivo, které tady asi nebude příliš oblíbené. Má zvláštní barvu a moc nepění, ale mám takový pocit, že Guberlandským by mohlo chutnat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:11
msgid "Alright.  Ask your questions."
msgstr "V pořádku! Ptej se."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:12
msgid "That's great news!  How much did you get for it?"
msgstr "To jsou skvělé zprávy! Kolik jste za ně utržili? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:12
msgid "We sold the beer."
msgstr "Prodali jsme to pivo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:13
msgid "We couldn't sell the beer."
msgstr "Nemohli jsme prodat to pivo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:13
msgid ""
"You dolts!  I bet you told them my apprentices made it, didn't you!  Now what am I going to do with all this stuff?  I'll have to throw it out!"
msgstr ""
"Vy hlupáci! Vsadil bych se, že jste jim řekli, že to pivo dělali mí učňové, že ano! Co teď budu se vším tím pivem dělat? Budu ho muset vylít! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:2
msgid "500 gold."
msgstr "500 zlatých."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:2
msgid ""
"Great!  Tell you what, why don't you keep that.  If they like it, I'm sure they'll want to order more.  Thanks for your help.  I really appreciate it."
msgstr ""
"Skvělé! A víte co, proč byste si je nakonec nemohli nechat. Pokud jim pivo chutnalo, jsem si jistý, že si budou chtít objednat více. Děkuji vám za pomoc. Opravdu to oceňuji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:5
msgid ""
"Two of my apprentices have come up with a new concoction, and it's horrible!  Just the thing I can sell to the Guberland Clan."
msgstr ""
"Dva z mých učňů uvařili nové pivo, které je opravdu příšerné! Což je přesně něco, co můžu výhodně prodat guberlandskému rodu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:6
msgid "Very good.  Once you've sold the keg, return to me for your reward."
msgstr ""
"Velmi dobře. Až budete mít jeden soudek prodaný, vraťte se ke mně pro odměnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:6
msgid "We will be happy to do that for you."
msgstr "Rádi to pro tebe uděláme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:7
msgid ""
"I want you to go to the tavern in Guberland and convince them to purchase this brew.  If they like what you give them, tell them there will be more where that came from!"
msgstr ""
"Chci, abys zašel do hospody v Guberlandu a přesvědčil jejího majitele, aby tohle pivo koupil. Pokud se mu bude zamlouvat, řekni mu, že tam, odkud to pivo pochází, je ho mnohem více!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:8
msgid ""
"They're all pretty much suckers.  If I find a brew I've had for too long, or something that's gone bad, I can usually sell it in Guberland for outrageous profits."
msgstr ""
"Jsou to všichni v podstatě důvěřivci. Pokud najdu pivo, které jsem měl už příliš dlouhou dobu, nebo něco, co se moc nepovedlo, obvykle to můžu prodat v Guberlandu za přemrštěnou cenu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:9
msgid "Alright.  Well I guess I'll hang on to it a little longer then."
msgstr "V pořádku. No, myslím si, že s tím budu muset ještě chvíli počkat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC184.rude:9
msgid "We don't have time to peddle beer."
msgstr "Nemáme čas prodávat pivo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:10
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:2
msgid "Good luck!"
msgstr "Hodně štěstí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:8
msgid "Thanks for the tip!"
msgstr "Díky za tip!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:2
msgid "Of course you may."
msgstr "Samozřejmě že můžete."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:3
msgid ""
"Find yourself a healer.  They will save your behind more often than any plain old fighter could!"
msgstr ""
"Najdi si léčitele. Ochrání ti záda mnohem častěji, než by mohl kdejaký řadový starý bojovník!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:20
msgid "Go in peace, children."
msgstr "Odejdi v míru, mé dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC187.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:7
msgid "Have you heard anything interesting?"
msgstr "Neslyšela jsi něco zajímavého?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC185.rude:5
msgid "I heard Skulkil the Dark knows how to become a lich."
msgstr "Zaslechl jsem, že Lebkoun Temný ví, jak se stát lichem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:2
msgid "Well thanks for your help.  Farewell."
msgstr "No, děkuji ti za pomoc. Sbohem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:2
msgctxt "said by the party"
msgid "Yeah."
msgstr "Jo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:3
msgid ""
"Business has been pretty bad around here.  It's time for me to move on to greener pastures, I think.  I'd like to go to Thronheim, but it is a dangerous journey, and I couldn't do it alone."
msgstr ""
"Obchody zde v okolí vůbec nejdou. Myslím, že nastal čas, abych se přestěhoval na zelenější pastvinu. Rád bych zamířil do Thronheimu, ale je to nebezpečná cesta a sám to nejspíš nezvládnu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:4
msgid "We've come to guard your boat."
msgstr "Přišli jsme ti pohlídat loď."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:4
msgid ""
"You have?!  Great! I plan on leaving at six tomorrow morning.  Show up at the dock at 3 am and relieve the late guard.  I'll come and relieve you myself around 6."
msgstr ""
"Opravdu?! Skvělé! Mám v plánu vyplout v šest hodin ráno. Ukažte se v docích o třetí hodině ranní a vystřídejte stráž. Přijdu a vystřídám vás sám okolo šesté. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:5
msgid "Thronheim is a wonderful place!  I'm sure it will make me a fortune!"
msgstr "Thronheim je nádherné místo! Jsem si jistý, že tam zbohatnu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC187.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:10
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC252.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC280.rude:3
msgid "What do you know about Thronheim?"
msgstr "Co víš o Thronheimu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:7
msgid "Three to six AM!"
msgstr "Od tří do šesti ráno!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:7
msgid "When is our shift again?"
msgstr "Kdy je tedy ještě jednou naše směna?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:8
msgid "Great, thanks to you!"
msgstr "Skvěle, díky za optání!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:9
msgid "Good luck on your journey."
msgstr "Hodně štěstí na tvé cestě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC186.rude:9
msgid ""
"Thank you!  Thorfinn told me to pay you this gold for your help.  I guess this makes you a Mercenary now?"
msgstr ""
"Děkuji vám! Thorfinn mi řekl, abych vám za pomoc dal toto zlato. Myslím, že to z vás nyní dělá žoldáky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC187.rude:1
msgid ""
"My father's business is not doing well.  We want to move to Thronheim."
msgstr ""
"Obchody se mému otci vůbec nedaří. Chceme se přestěhovat do Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC187.rude:3
msgid "My father says that moving there will make us rich!"
msgstr ""
"Můj otec říká, že pokud se tam přestěhujeme, tak se z nás stanou boháči!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC187.rude:5
msgid ""
"I heard Skulkil the Dark in Frosgard teaches people how to become Liches."
msgstr ""
"Zaslechla jsem, že Lebkoun Temný z Frosgardu učí lidi, jak se stát lichem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:2
msgid ""
"Good luck!  It's been a long time since there was a temple to Igdrasa in Guberland."
msgstr ""
"Hodně štěstí! Už je to dlouhá doba, co byl v Guberlandu chrám zasvěcený Igdrase. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:9
msgctxt "said by the party"
msgid "Great!"
msgstr "Skvělé!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:3
msgid ""
"Here, that should do it.  Now don't lose it, I don't want you to keep bothering me!"
msgstr ""
"Tady to je, mělo by to fungovat. A buď tak laskav a neztrať ten dokument, nechci, abys mě znovu otravoval!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:4
msgid "News?  Me?  What sort of news do you think an old priest has?"
msgstr "Nové zprávy? Já? Jaké zprávy asi může mít starý kněz, co myslíš? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:5
msgid ""
"Ahh never mind.  You'll just forget it if I teach it to you.  Let me write it down."
msgstr ""
"Óóó, na to zapomeňte. Vy byste ho zapomněli, kdybych vás ho naučil. Ale napíšu vám ho. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:5
msgid "Yes, please teach us."
msgstr "Ano, prosím, nauč nás ho."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:6
msgid ""
"Ah, is that so?  Someone's finally replacing that Guberland Temple, eh?  I suppose I could teach you."
msgstr ""
"Ach, opravdu? Někdo konečně přemístil ten guberlandský chrám, prosím? Domnívám se, že bych vás ho mohl naučit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:2
msgid "We need to learn the Ritual of Consecration."
msgstr "Potřebujeme se naučit Rituál zasvěcení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:7
msgid "We're looking for a priest."
msgstr "Hledáme kněze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:7
msgid ""
"Well I'd say you found one.  An old one, but I've still got enough rocks in this braincase to do."
msgstr ""
"No, řekl bych, že jste jednoho našli. Nejsem sice nejmladší, ale snad v té své staré hlavě ještě pořád něco mám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:8
msgid ""
"If you are seeking to be promoted to priest, seek out Gray Slemnir in Guberland."
msgstr ""
"Pokud hledáte někoho, kdo by vás povýšil na kněze, vyhledejte Graye Slemnira z Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC188.rude:8
msgid "What do you know about priests?"
msgstr "Co víš o kněžích?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:2
msgid ""
"Great!  Just remember these things.  Follow the path you had been going, always go left, and don't enter the tunnel.  Good luck."
msgstr ""
"Skvěle! Takže si zapamatuj tyto věci. Následuj pěšinku, po které půjdeš, pořád se drž po levé straně a nevstupuj do tunelu. Hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:3
msgid ""
"You're in luck.  I've tracked him before.  It shouldn't be too hard to find him again.  Unfortunately, I am unable to lead you to him.  I could tell you the path I took though.  Would that be alright?"
msgstr ""
"Máte štěstí. Už jsem ho předtím stopoval. Nemělo by být tak těžké ho znovu najít. Bohužel nejsem schopný vás k němu zavést. I když bych vám mohl popsat cestu, po které jsem šel. Bude vám to stačit? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:4
msgid "Not that I'm willing to share."
msgstr "Ne ty, o které bych byl ochoten se podělit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:5
msgid "Ah, and you need a tracker.  Very well.  I think I can help you."
msgstr "A potřebujete stopaře. Dobře. Myslím, že vám mohu pomoci. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:5
msgid "We've been charged with finding the Green Man."
msgstr "Byli jsme pověřeni, abychom našli Zeleného mužíčka"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:6
msgid "How is that?"
msgstr "Jak to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:7
msgid ""
"He is the spirit of the forest.  Maybe if people around here paid more attention to him, we might not be starving."
msgstr ""
"Je to lesní bytost. Možná že kdyby mu lidé ze zdejšího okolí věnovali větší pozornost, nemuseli bychom hladovět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC189.rude:9
msgid "I heard Skulkil the Dark knows how to become a Lich."
msgstr "Slyšel jsem, že Lebkoun Temný ví, jak se stát lichem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:12
msgid ""
"Isn't that the truth.  Those two clans had better put aside their differences."
msgstr "Není-liž pravda. Ty dva klany by raději měly odložit své rozpory."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:12
msgid "The world has worse things to worry about."
msgstr "Jsou horší věci na světě, pro které je nutno se trápit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:2
msgid ""
"Johannes Bem right here in Thjorgard can help you.  You can find him in the Bembridge University."
msgstr ""
"V tom ti pomůže Johannes Bern, přímo tady v Thjorgardu. Nalezneš jej v Bembridgské univerzitě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:20
msgid "The tavern is the first building south of the eastern entrance."
msgstr "Hospoda je hned první stavení na jih od východního vchodu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:21
msgid ""
"You can find the armor shop just east of the training hall in the western part of town."
msgstr ""
"Obchod se zbrojí můžete najít východně od tréninkové haly v západní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:22
msgid ""
"I've heard that Sturmford and Drangheim have not spoken to each other in at least ten years.  It's a wonder they don't go to war!"
msgstr ""
"Doslechla jsem se, že Sturmford a Drangheim už spolu posledních deset let nemluví. Je to zázrak, že ještě nevypukla válka!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:25
msgid "The magic shop is on the very next street to the west of us."
msgstr "Magický obchod leží v první ulici přímo na západ od nás."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:27
msgid "Not anymore than usual."
msgstr "O nic víc než obvykle."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:28
msgid "The temple is in the most southeasterly part of town."
msgstr "Chrám se tyčí v jihovýchodní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:29
msgid ""
"Seek out Tymon the Nord right here in Thjorgard.  He can be found in the Bembridge University."
msgstr ""
"Tady v Thjorgardu vyhledej Tymona Seveřana. Nalezneš ho v Bembridgské univerzitě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:3
msgid ""
"Sven lives in the castle on the hill in the westernmost section of town."
msgstr "Sven žije v hradišti na kopci v západní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:32 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:18
msgid "No thank you."
msgstr "Ne, děkuji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:35
msgid ""
"The training hall is in the western section of town, to the north of the gates to Sven's Hall."
msgstr "Cvičiště leží v západní části města, severně od bran do Svenovy síně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:36
msgid ""
"The apothecary is between the armor shop and the magic shop, west of here."
msgstr ""
"Lékárna se nalézá západně odsud, mezi mečířovým krámkem a magickým krámkem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:39
msgid "The general store is just east of the weapon shop, west of here."
msgstr ""
"Smíšené zboží najdete přímo na východ od zbrojířova obchodu západně odsud."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:39 assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:50
msgid "The general store."
msgstr "Smíšené zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:4
msgid "Do you have any other news?"
msgstr "Nemáš nějaké jiné zprávy?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:4
msgid "I'm afraid not.  Was there anything I could help you with?"
msgstr "Obávám se, že ne. Mohu ti ještě s něčím pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:43
msgid "The library is in the southwest section of town, next to the bank."
msgstr "Knihovna stojí v jihozápadní části města, hned vedle banky."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:44
msgid ""
"The Arena is in the northwest section of town, just north of the Bembridge University."
msgstr ""
"Do arény se dostanete, vydáte-li se do severozápadní části města, hned na sever od Bembridgské univerzity."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:44
msgid "We're looking for The Arena."
msgstr "Chtěli bychom se podívat do arény."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:5
msgid ""
"You can find the weapon shop just east of the training hall in the western part of town."
msgstr ""
"Prodejnu zbraní najdete přímo na východ od tréninkové haly v západní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC19.rude:6
msgid ""
"You can find the bank in the southwest section of town, next to the library.  It is near the gates to Sven's Hall."
msgstr ""
"Banku nalezneš v jihozápadní části města, hned vedle knihovny. Je to poblíž bran do Svenovy síně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:1
msgid "Thank you."
msgstr "Díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:11
msgid ""
"That's that awful place floating above Frosgard.  There's a big bad giant who lives in there.  If you're not careful, he'll eat your small children!  I've heard that he can't be killed!"
msgstr ""
"Je to hrozné místo, nacházející se u Frosgardu. Žije tam velký zlý obr. Pokud bys nebyl opatrný, sežral by ti před nosem i malé dítě! Slyšel jsem, že ho nelze zabít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:11
msgid "What do you know about the Sky Fort?"
msgstr "Co mi můžeš říci o Nebeské tvrzi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:13
msgid "That's okay.  Come back when you do."
msgstr "Dobře. Přijďte, až budete mít dost."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:13
msgid "We don't have that much right now."
msgstr "V tuhle chvíli u sebe tolik nemáme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:5
msgid "Frosgard needs your help."
msgstr "Frosgard potřebuje pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:14
msgid "Huh?"
msgstr "Hm?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:15
msgid ""
"Skulkil the Dark got into another tavern fight.  If you ask me, he spends too much time in the tavern."
msgstr ""
"Lebkoun Temný se zapletl do další hospodské bitky. Když už se ptáš, tráví příliš mnoho času vysedáváním po hospodách. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:2
msgid "The Green Man requires a pledge from Frosgard."
msgstr "Zelený mužíček vyžaduje slib od Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:5
msgid "What sort of pledge?"
msgstr "Jaký slib?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:3
msgid ""
"Great!  I've got a few orders to take care of first, but as soon as those are done, I'll get right on the maypole."
msgstr ""
"Skvělé! Dostal jsem několik úkolů, o které se teď musím postarat, ale jakmile budou hotové, dám do pořádku tu májku. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:3
msgid "Sure.  That's no problem."
msgstr "Jistě. To nebude problém."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:4
msgid "A pledge to not neglect him again."
msgstr "Slib, aby se na něho zase nezapomínalo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:4
msgid ""
"If it will help our harvests return to normal, I'll give you that pledge!"
msgstr "Pokud nám to prospěje, dám ti ten slib!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:5
msgid "We'd like you to fix it."
msgstr "Byli bychom rádi, kdybys to opravil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:5
msgid ""
"You would?  I'd be happy to!  I'll have to charge you 500 gold for materials."
msgstr ""
"Byl bys? Taky bych byl šťastnej! Musím si ale naúčtovat 500 zlatých za materiál."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:6
msgid ""
"I am a poster.  I make posts.  You know the maypole in the center of town?  I made that a few years ago.  It's a little worse for the wear these days, but no one has asked me to fix it."
msgstr ""
"Jsem pošťák. Roznáším poštu. Viděli jste tu májku uprostřed města? Vyrobil jsem ji před několika lety. Dneska už vypadá trochu hůř, ale nikdo mě dodnes nepožádal, abych ji opravil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:8
msgid "Tell the Green Man something for us.  Tell him we're sorry."
msgstr "Vyřiď Zelenému mužíčkovi něco za nás. Řekni mu, že se omlouváme. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC190.rude:9
msgid ""
"Our harvests have been horrible lately.  If nothing is done soon, we'll all starve!"
msgstr ""
"Naše sklizeň byla v poslední době strašná. Pokud se brzy něco neudělá, všichni budeme hladovět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:2
msgid "News?  Yes!  My crops are failing!"
msgstr "Zprávy? Ano! Přišli jsme o veškerou úrodu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:3
msgid ""
"If I remember him?  I suppose that's better than starving.  Alright.  I'll give you my pledge."
msgstr ""
"Pokud si ho budu připomínat? Myslím, že je to lepší než hladovět. V pořádku. Dávám ti ten slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:3
msgid "The Green Man will fix your crops."
msgstr "A právě v tom vám může Zelený mužíček pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:4
msgid "My crops are already failing."
msgstr "S mojí úrodou to jde z kopce už teď."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:4
msgid "Without him, your crops will fail."
msgstr "Bez něho budete mít špatnou úrodu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:5
msgid "That you will remember the Green Man."
msgstr "Že si budete připomínat Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:5
msgid "The Green Man?  Why would we need to remember him?"
msgstr "Zeleného mužíčka? Proč bychom si ho měli připomínat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:4
msgid "A pledge?  What sort of pledge?"
msgstr "Slib? Jaký slib?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:6
msgid "We need a pledge from you."
msgstr "Potřebujeme od tebe slib."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:7
msgid "What do you need?"
msgstr "Co potřebujete?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:8
msgid "What do I know about it?  Here's what:  it's making my crops fail!"
msgstr ""
"Co o něm vím? Vím toto: kvůli němu se na našich polích neurodilo téměř nic! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC191.rude:8
msgid "What do you know about weather?"
msgstr "Co víš o počasí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:1
msgid "If you succeed, we'll have you to thank.  Farewell."
msgstr "Pokud uspěješ, budeme ti zavázáni. Sbohem. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:2
msgid ""
"I went out to pray to Fre last night to help my crops.  Do you know what happened?  That darned frost giant in the Sky Fort dumped his bucket out on my head!  I wish someone would do something about him!"
msgstr ""
"Minulou noc jsem se šla modlit k Fré, aby nám pomohla. Víte, co se stalo? Ten zatracenej mrazivej obr z Ledové tvrze po mně hodil kbelíkem! Přála bych si, aby s ním někdo už konečně něco udělal!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:3
msgid "The Green Man does not wish to be forgotten again."
msgstr "Zelený mužíček si nepřeje, aby se na něj zase zapomnělo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:3
msgid ""
"The Green Man spoke to you?  He wants a pledge from me?  Of course!  I will give it right now!"
msgstr ""
"Zelený mužíček s vámi mluvil? Chce můj slib? Samozřejmě! Dám mu ho hned teď!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:4
msgid "We've come to get a pledge from you."
msgstr "Přišli jsme na tobě vyžádat slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:4
msgid "What for?"
msgstr "Jaký slib?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:5
msgid "She's my favorite goddess!  I wish she would help us!"
msgstr "Je to má oblíbená bohyně! Přála bych si, aby nám pomohla!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:5
msgid "What do you know about Fre?"
msgstr "Co víš o Fré?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC192.rude:7
msgid ""
"I'm afraid of going to the tavern.  That Skulkil the Dark is always in there.  He scares me."
msgstr ""
"Bojím se jít do hospody. Ten Lebkoun Temný tam je v jednom kuse. Děsí mě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:2
msgid "I'm hungry.  Got a sandwich?"
msgstr "Mám hlad. Nemáte kousek chleba?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:3
msgid ""
"Oh!  Well, I've never liked going hungry.  I will give you that pledge."
msgstr "Ou! Nikdy se mi nelíbilo mít hlad! Dám ti ten slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:3
msgid "You won't starve anymore."
msgstr "Už nebudete hladovět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:4
msgid "To not forget to celebrate him again."
msgstr "Že ho zase nezapomenete oslavovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:4
msgid "What do we get in return?"
msgstr "Co z toho budeme mít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC222.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC227.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC228.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC229.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC232.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC236.rude:4
msgid "The Green Man needs a pledge from you."
msgstr "Zelený mužíček potřebuje tvůj slib."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:6
msgid "What sort of help do you need?"
msgstr "Jakou pomoc potřebujete?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:7
msgid ""
"It's been getting harder to find food around here.  I'm going to have to move soon just to find something to eat!"
msgstr ""
"Ještě horší. Je čím dál těžší najít tady v okolí něco k jídlu. Budu se muset brzy přestěhovat, jestli nechci umřít hlady! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC193.rude:7
msgid "What do you know about starving?"
msgstr "Je to s tím nedostatkem jídla tak hrozné?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:2
msgid ""
"Starve?  Hah!  I doubt that's going to happen.  And I think I don't like the attitude you've been giving me.  This conversation is over."
msgstr "Hlady? Cha! Pochybuju, já se o sebe umím postarat. A zmiz mi z očí. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:2
msgid "You'd rather starve?"
msgstr "Radši zemřeš hlady?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:3
msgid "The Green Man wants a promise from you!"
msgstr "Zelený mužíček chce od tebe slib!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:3
msgid ""
"What has he done for me?  Oh yeah!  Nothing!  He's not going to get a promise from me."
msgstr "Co pro mě udělal? No! Nic! Nedostane ode mě žádnej slib. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:4
msgid "We need your help!"
msgstr "Potřebujeme tvoji pomoc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:4
msgid "Well you're not going to get it!"
msgstr "Na to zapomeň!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:5
msgid "No!"
msgstr "Ne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC194.rude:6
msgid "Well then leave me alone!"
msgstr "Dobře, tak už mě nechej na pokoji!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:1
msgid "You are a brave and noble group.  You are most welcome.  Farewell."
msgstr "Jste statečná a vznešená skupina Budete tu vždycky vítáni. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:2
msgid "I will give that pledge!"
msgstr "Dám ti ten slib!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:2
msgid "That you will continue to have the festivals."
msgstr "Že budete pokračovat v tradici festivalů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:3
msgid "A pledge?  For what?"
msgstr "Slib? Jaký slib?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:3
msgid "It's time for another one.  He wants a pledge."
msgstr "Přišel čas na další. Chce slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC196.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:5
msgid "The Green Man needs your help."
msgstr "Zelený mužíček potřebuje tvoji pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:4
msgid ""
"Why would the Green Man need our help?  Or want it?  We Haven't had a festival in years!"
msgstr ""
"Proč by Zelený mužíček potřeboval naši pomoc? Ostatně, neměli jsme slavnosti již celá léta!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:5
msgid ""
"I am searching for a fair maiden to rescue.  Then I can marry her and settle down like a proper warrior!"
msgstr ""
"Hledám krásnou pannu, kterou bych zachránil. A pak jako správný bojovník si ji můžu vzít a usadit se! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:6
msgid ""
"Is there a fair maiden that needs to be rescued?  I shall fetch my sword and get right on it!"
msgstr ""
"Je tu snad nějaká panna, která potřebuje zachránit? Přinesu si meč a půjdu hned na věc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:7
msgid "What do you know about rescuing fair maidens?"
msgstr "Co víš o zachraňování krásných panen?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC195.rude:7
msgid ""
"When a young warrior is ready to hang up his sword and settle down, he must find a fair maiden to rescue."
msgstr ""
"Když je mladý bojovník připraven pověsit meč na hřebík a usadit se, musí najít krásnou pannu, kterou by zachránil. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC196.rude:2
msgid ""
"My cabbage froze solid last night.  I don't think I'll be able to harvest it at all."
msgstr "Moje zelí minulou noc úplně zmrzlo. Nehodí se ani pro prasata."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC196.rude:3
msgid "He needs a pledge that we won't forget him again."
msgstr "Potřebuje slib, že na něj znovu nezapomenete."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC196.rude:3
msgid ""
"Yes, of course!  I will give that pledge.  We have neglected him for far too long!"
msgstr ""
"Ano, samozřejmě! Dám ti ten slib. Zanedbávali jsme ho už příliš dlouho!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC196.rude:4
msgid "The Green Man?  How can I help?"
msgstr "Zelený mužíček? Jak můžu pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC196.rude:5
msgid ""
"I know that if things don't get better soon, I'm going to have to move!"
msgstr "Vím, že pokud se věci brzy nezlepší, budu se muset odstěhovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:2
msgid ""
"Yesterday my cat caught a rat in my pantry!  You know what he did then?  He left it on my pillow!"
msgstr ""
"Včera můj kocour chytil ve spíži krysu! Víte, co s ní pak udělal? Položil mi ji na polštář!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:3
msgid "He wants a pledge that he won't be forgotten again."
msgstr "Chce slib, že nebude znovu zapomenut."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:3
msgid "You spoke to him?  He's come back?  Of course I'll give a pledge!"
msgstr "Mluvili jste s ním? Vrátil se? Samozřejmě mu dám slib!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:4
msgid "It's about the Green Man."
msgstr "Slyšela jsi o Zeleném mužíčkovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:4
msgid ""
"The Green Man?  He abandon us long ago, and I don't blame him!  In fact, we abandon him, more like!"
msgstr ""
"O Zeleném mužíčkovi? Opustil nás už dávno, ale nekladu mu to za vinu! Ve skutečnosti jsme my opustili jeho, a více než to!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:6
msgid "I know the farmers are having some trouble with their crops!"
msgstr "Vím, že farmáři mají nějaké problémy s úrodou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:6
msgid "What do you know about harvesting?"
msgstr "Co víš o sklizni?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC197.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:6
msgid "Thanks for you time."
msgstr "Dík za ochotu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:1
msgid "Don't bother me again."
msgstr "Už mě znovu neotravuj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:2
msgid ""
"Maybe if these farmers would get out of the taverns and back to work, there wouldn't be a food shortage!"
msgstr ""
"Možná že kdyby tihle farmáři vylezli z hospod a vrátili se ke svojí práci, nebyl by nedostatek jídla!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:3
msgid ""
"Now you're just deluding yourself.  He's not real, and you're not going to make a fool of me.  Now be off with you!"
msgstr ""
"Děláte si zbytečné iluze. On není skutečný a vy ze mě nebudete dělat blbce. Takže teď hezky vypadněte!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:3
msgid "We spoke to him.  He needs a pledge."
msgstr "Mluvili jsme s ním. Potřebuje slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:4
msgid "The Green Man needs it."
msgstr "Zelený mužíček to potřebuje."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:4
msgid "The Green Man?  Ha!  He doesn't even exist."
msgstr "Zelený mužíček? Cha! Vždyť vůbec neexistuje."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:5
msgid "My help?  Why should I give you my help?"
msgstr "Moji pomoc? Proč bych ti měl já pomáhat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:6
msgid "I don't have time for those things."
msgstr "Nemám čas na tyhle věci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC198.rude:7
msgid "See that it doesn't happen again."
msgstr "Vidím, že už se to nestane."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:1
msgid ""
"When I was younger, a playmate of mine pulled a fish from a stream.  He said it looked like me.  Ever since then they've called me Erik the Fish-head."
msgstr ""
"Když jsem byl mladší, můj kamarád chytil v potoce rybu. Říkal, že vypadá přesně jako já. Od té doby mi začali říkat Erik Rybí tlama."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:3
msgid "A pledge to have a party?  Of course!  I will give that."
msgstr "Slib uskutečňovat oslavy? Samozřejmě! Dám ten slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:3
msgid "That he won't be forgotten again.  To celebrate him again."
msgstr "Aby nebyl znovu zapomenut. Abyste ho znovu oslavovali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:4
msgid "He needs a pledge."
msgstr "Potřebuje slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:5
msgid ""
"The Green Man has returned?  Frankly I was beginning to think he didn't exist anymore.  What does he need of us?  A sword?  Is there a man I need to kill?"
msgstr ""
"Zelený mužíček se vrátil? Upřímně řečeno, začal jsem si myslet, že nikdy neexistoval. Co od nás potřebuje? Meč? Je tu nějaký muž, kterého potřebuje zabít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:7
msgid "Nothing.  I'm a soldier, not a farmer."
msgstr "Nic. Já jsem voják. Ne farmář."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC199.rude:7
msgid "What do you know about farming?"
msgstr "Co víš o farmaření?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:1
msgid ""
"Very well.  If you intend to stand in the way of the Beldonian conquest, then there is nothing more we have to say to each other."
msgstr ""
"Výborně. Jestliže mi chcete bránit v dobytí Beldonie, pak už si spolu nemáme co říci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:1
msgid "We could never rule alongside a traitor!"
msgstr "Nikdy nebudu vládnout po boku zrádce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:11
msgid ""
"There is only one lane in which boats can reach this dock.  Unfortunately, Bone Thrashers have been coming from one of those islands and are preventing the boat from leaving.  If we are to get off this island, we'll have to take care of them first."
msgstr ""
"Existuje pouze jediná cesta, kudy se lodi dostávají do doků. Naneštěstí však z jednoho z ostrovů přicházejí kostomlati a nedovolí žádné lodi vyplout. Jestliže se chceme dostat z tohoto ostrova, musíme se s nimi nejprve vypořádat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:12
msgid "Fair enough.  We'll take care of them then."
msgstr "To zní čestně. Tak se o ně tedy postaráme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:12
msgid ""
"Great.  I would be more than happy to come with you on this quest.  And you know what?  I bet there's something behind that locked door that will help us!"
msgstr ""
"Skvělé. Budu více než potěšen, pokud se k vám budu moci na této výpravě přidat. A víte co? Vsadil bych se, že tamhle za těmi zamčenými dveřmi je něco, co nám pomůže!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:13
msgid "Welcome Aboard."
msgstr "Vítej na palubě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:14
msgid ""
"It is not as bad a place as people make it out.  In the summer time, it's actually quite nice."
msgstr ""
"Není to tak špatné místo, za jaké je lidé považují. V létě je tam vskutku velmi pěkně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:15
msgid "No.  Who is that?"
msgstr "Ne. Kdo to je?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:15
msgid ""
"She is the sage who lives on one of these islands.  She may want to speak to you."
msgstr ""
"Je to moudrá žena, jež přebývá na jednom z těchto ostrovů. Možná si s vámi bude chtít promluvit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:16
msgid "It is our destiny to unite the six clans against Tamur Leng."
msgstr ""
"Je mým údělem zajistit, aby se šest klanů spojilo proti Tamuru Lengovi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:16
msgid ""
"Tamur Leng?  The leader of the Beldonian Hordes sweeping across Rysh?  If it is your job to kill him, then I am at your disposal.  I would like to leave as soon as you are ready, however, there is something that must be done first."
msgstr ""
"Tamur Leng? Vůdce beldonských hord, co se ometají po celém Ryshu? Pokud máte za úkol je vybít, pak jsem vám plně k dispozici. Rád bych vyplul ihned, jak budete připraveni, avšak ještě předtím musí být něco vykonáno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:17
msgid "See you soon."
msgstr "Brzy nashle!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:17
msgid "We have a few things to do first."
msgstr "Ještě předtím si musíme pár věcí zařídit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:19
msgid "Not much, really.  He is the Prince of Beldonia."
msgstr "Nic moc, opravdu. Je to princ z Beldonie."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:20
msgid ""
"As I recall, Bjarni is quite taken with Kira the Cold.  If she asked, I'm certain that he would put his sword into his own chest, and smile while doing it."
msgstr ""
"Pokud si vzpomínám, Bjarni je nyní zcela zahleděn do Kiry Chladné. Kdyby ho požádala, jsem si jist, že by si vrazil vlastní meč do prsou a přitom se ještě usmíval."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:20
msgid "Where are we going to find someone to write a treaty?"
msgstr "Kde bychom našli někoho, kdo může sepsat smlouvu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:21
msgid ""
"This is Thjorgard, the seat of power for Clan Thjorgard.  Without at doubt, they are the most powerful clan in Chedian.  Their Jarl, Sven Forkbeard makes most of his money off of taxing the production, refining, and smithing of Elemental Thjorad."
msgstr ""
"To je Thjorgard, sídlo moci klanu Thjorgard. Bezpochyby je to ten nejmocnější rod v Chedianu. Jejich jarl, Sven Vidlobrad, si své peníze vydělal na daních z těžby, vylepšování a opracovávání thjoradské rudy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:21 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:22 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:25
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:27 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:28 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:29
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:30 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:31 assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:32
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:33 assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:10
msgid "What do you know about this place?"
msgstr "Můžeš mi prozradit něco o tomto místě?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:22
msgid ""
"This is Sturmford, the seat for Clan Sturmford.  The Jarl of this region is named Bjarni Thorvaldssen, a straightforward, if a bit simple man.  Sturmford and their neighbor Drangheim have been fighting for centuries."
msgstr ""
"Jsme ve Sturmfordu, sídle klanu Sturmford. Jarl této oblasti se jmenuje Bjarni Thorvaldssen. Je to upřímný, ale poněkud jednoduchý muž. Sturmford a sousední Drangheim spolu po staletí válčily."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:23
msgid ""
"I think you have misjudged me.  In the eyes of my master, Tamur Leng, I have just done a great service to my nation!  He has rewarded me by making me Lord of Chedian!"
msgstr ""
"Domnívám se, že jste mne špatně odhadli. V očích mého pána Tamura Lenga jsem právě prokázal velkou službu svému národu! Odměnil mne tím, že mi propůjčil titul lorda Chedianu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:23
msgid "There you are, Traitor!!!"
msgstr "Dostal jsem tě. Zrádče!!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:24
msgid ""
"Those are the Verhoffin Ruins.  I wouldn't advise you to enter them.  All that's in there for you is your death."
msgstr ""
"To jsou Verhoffinovy ruiny. Neradil bych vám, abyste tam vkročili. Jediné, co vás tam potká, je smrt."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:25
msgid ""
"This is the seat for Clan Drangheim.  Their Jarl, Sigmund the Stressed while perhaps not the most elegant of men is a competent ruler.  They have been at odds with Sturmford ever since they broke off from them to start their own clan centuries ago."
msgstr ""
"Zde sídlí kmen Drangheim. Jejich jarl Sigmund Skrček sice není žádný fešák, ale je to schopný vládce. Se Sturmfordem se nesnášejí už od dob, kdy před staletími založili svůj vlastní klan."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:26
msgid ""
"I bet that there's a way to beat the skeletoids behind it.  Maybe we should ask Yrsa."
msgstr ""
"Vsadím se, že existuje způsob, jak zdolat ty kostlivce, kteří za tím stojí. Snad bychom se mohli zeptat Yrsy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:26
msgid "What was that you said about a locked door?"
msgstr "Co jsi to povídal o zavřených dveřích?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:27
msgid ""
"This is Guberland, probably the most unpopular Clan in Chedian.  Their Jarl, a man named Markel, chose for himself the nickname \"the Great\" however unproven that title may be.  He is a somewhat abrasive man with a flair for self-flattery."
msgstr ""
"Guberland pravděpodobně představuje ten nejméně populární klan v Chedianu. Jejich jarl, muž jménem Markel, si sám dal přídomek \"Veliký\", i když tohoto titulu snad nikdy nedosáhl. Je to tak trochu samolibý neomalenec."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:28
msgid ""
"Frosgard is in bad shape.  Their ruler, Tryygva Ravenlocks, has been unable to cope with the region's problems no matter how hard he tries.  I'm fairly certain that it would take little effort to encourage the citizens to revolt."
msgstr ""
"Frosgard je na tom bídně. Jejich vládce Tryygva Havraních kadeří se nedokázal vypořádat s místními problémy bez ohledu na to, jak dlouho se o to pokoušel. Jsem si téměř jist, že by nedalo moc práce povzbudit měšťany k revoltě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:29
msgid ""
"Thronheim is probably the second most powerful clan in Chedian, after Thjorgard.  Kira the Cold is a competent, no-nonsense ruler.  She has it in her the potential to make Thronheim more successful than it has been in a hundred years."
msgstr ""
"Thronheim je pravděpodobně hned po Thjorgardu druhý nejmocnější klan v Chedianu. Vládne mu Kira Chladná, a je velice schopnou panovnicí. Její moc může Thronheim pozvednout tak, jak tomu nebylo už po celá staletí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:3
msgid "A quest?  What sort of quest?"
msgstr "Úkolem? Jakým úkolem?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:3
msgid "She has charged us with a quest, and we need your help."
msgstr "Pověřila nás úkolem, při němž potřebujeme tvou pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:30
msgid ""
"Lindisfarne is a remote monastic village that is technically part of the Nation of Framon.  Its seclusion from the mainland and ready sea access has made it a popular target for the Chedian raiders."
msgstr ""
"Lindisfarn je vzdálenou klášterní osadou, jež je v podstatě součástí národa Framon. Je oddělená od pevniny a přímý přístup k moři z ní činí oblíbený cíl pro chedijské nájezdníky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:31
msgid ""
"This is the region of Yorwick, the most easterly part of the Nation of Framon.  There has been increasing emigration from Thronheim to this region, and the mixing of cultures has created tension between the residents."
msgstr ""
"Nyní se nacházíme v oblasti Yorvick, nejvýchodnějším sídle framonského národa. Začíná se sem však stěhovat mnoho lidí z Thronheimu a střet jednotlivých kultur způsobil mezi obyvatelstvem poněkud napjatou situaci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:32
msgid ""
"This is the Isle of Ashes.  This is where Verhoffin's Tower stood.  Now it is all a mess of ruins, and a dangerous place to boot."
msgstr ""
"Toto je Ostrov popela. Zde stávala Verhoffinova věž. Nyní je to hromada sutin, a taky pěkně nebezpečné místo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:33
msgid "I don't know anything.  I've never been here before."
msgstr "Nic nevím. Nikdy předtím jsem tu nebyl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:36
msgid "Welcome aboard."
msgstr "Vítej na palubě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:4
msgid "Climb Aboard!"
msgstr "Vzhůru na palubu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:4
msgid "We are ready to go now."
msgstr "Jsme připraveni vyrazit hned."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:5
msgid "Have you seen Yrsa the Troll?  You may want to speak to her."
msgstr "Neviděli jste Yrsu Trol? Snad byste si s ní měli promluvit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:5
msgid "Our boat crashed on its way to Mendossus."
msgstr "Naše loď cestou do Mendossusu ztroskotala."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:6
msgid "I am a sailor who has traveled much.  I am new to Chedian."
msgstr "Jsem námořníkem, jenž mnoho cestoval. V Chedianu jsem nový."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:7
msgid "Yes, Kira!  Great thinking, Forad!"
msgstr "Ano, Kiro! Skvělá myšlenka. Kupředu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:7
msgid "You're welcome.  I am here to help."
msgstr "Rádo se stalo. Jsem tu, abych pomohla."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:8
msgid "She did?  What for?"
msgstr "Vskutku? A proč?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:8
msgid "Yes.  Yrsa sent us to find you"
msgstr "Ano. Yrsa nám řekla, abychom tě vyhledali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:9
msgid "Not without killing us, he hasn't!"
msgstr "Neudělá to, aniž by nás zabil!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC2.rude:9
msgid ""
"Why waste your time on such things?  Join us!  We can rule all of Chedian together!"
msgstr ""
"Proč ztrácíme čas takovými věcmi? Přidej se k nám! Společně můžeme ovládnout celý Chedian!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC20.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC20.rude:3
msgid "We would like to look at your books"
msgstr "Chtěli bychom nahlédnout do tvých knih."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC20.rude:3
msgid "Sorry, We're closed"
msgstr "Promiň, ale máme zavřeno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:1
msgid ""
"I heard that Eva A'Washadi lost one of her children to the Frost Giant a couple nights ago.  Darn that Tryygva Ravenlocks!  He should be doing something about that!"
msgstr ""
"Slyšel jsem, že Eva A'Washadi ztratila jedno ze svých dětí před několika dny u mrazivého obra. Ten zatracený Tryygva Havraních kadeří! Měl by s tím něco udělat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:4
msgid "Yes.  We'd like to see your weapons."
msgstr "Ano. Rádi bychom viděli tvé zbraně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:3
msgctxt "said by the party"
msgid "Anything else?"
msgstr "Ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:3
msgid ""
"I've heard that he can't be killed.  If you're thinking of trying to get rid of him, you'd better think of another way!"
msgstr ""
"Slyšel jsem, že nemůže být zabit. Pokud přemýšlíš o tom, že by ses pokusil zbavit se ho, měl bys na to jít lstí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:5
msgid ""
"They call him Yanmir the Frost Giant.  From what I've heard, he's the last of the frost giants who lived in the city called the Sky Fort.  After the Great Cataclysm, the Sky Fort plunged from the sky and almost landed right on top of Frosgard!"
msgstr ""
"Říkají mu mrazivý obr Yanmir. Z toho, co jsem zaslechl, je posledním z mrazivých obrů, kteří žili ve městě zvaném Nebeská tvrz. Po Velké pohromě Nebeská tvrz spadla z nebe a přistála skoro téměř na vrcholku Frosgardu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:5
msgid "What do you know about the frost giant?"
msgstr "Co víš o mrazivém obrovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC200.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:8
msgid "Would you like to see a weapon?"
msgstr "Chtěl bys vidět zbraně?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:2
msgid ""
"Business has been bad since the docks froze over.  I don't understand why Tryygva hasn't done anything about it yet!"
msgstr ""
"Obchody se zhoršily od té doby, co doky zamrzly. Nechápu, proč s tím Tryygva dosud nic neudělal!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:4
msgid "Yes.  We'd like to see your wares."
msgstr "Ano. Rádi bychom viděli tvé zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:5
msgid ""
"I've been barely scraping by.  I've had to pay people to bring stuff through the mountains just to keep my stock up!"
msgstr ""
"Sotva jsem si vystačil. Musel jsem si zaplatit lidi, aby mi přinesli zboží přes hory tak, abych měl dostatek zásob! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:5
msgid "What do you know about trade?"
msgstr "Co mi řekneš o obchodech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC201.rude:7
msgid "Next time, why don't you buy something."
msgstr "Příště, jo proč si něco nekoupíš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:2
msgid ""
"My sister's son in Frosgard hasn't been home in two days.  She's afraid that the Frost Giant got him!"
msgstr ""
"Syn mé sestry z Frosgardu nebyl už dva dny doma. Sestra se bojí, že ho mrazivý obr dostal!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:5
msgid ""
"The frost giant in Frosgard?  He eats small children!  I heard Tryygva sent some soldiers to try and kill him.  One of them came back saying he can't be killed!"
msgstr ""
"O tom mrazivém obrovi? On žere malé děti! Slyšela jsem, že Tryygva poslal několik vojáků, aby se ho pokusili zabít. Jeden z nich se vrátil zpátky se slovy, že nemůže být zabit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:5
msgid "What do you know about  Yanmir?"
msgstr "Co bys mi řekla o Yanmirovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:7
msgid "Come back soon."
msgstr "Brzy přijď zase."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC202.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC203.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC205.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC251.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC260.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC307.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC307.rude:5
msgid "You're welcome."
msgstr "Rádo se stalo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC203.rude:2
msgid ""
"I've heard there are instructions on how to become a lich buried somewhere in Chasm of the Dead."
msgstr ""
"Slyšela jsem pokyny, jakým způsobem se dostat k lichovi, který je pohřbený někde v Rokli smrti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC203.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC203.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC344.rude:2
msgid "We'd like to see your stuff."
msgstr "Rádi bychom viděli tvé zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC203.rude:4
msgid "Sorry, but we're closed for the evening."
msgstr "Omlouvám se, ale večer máme zavřeno."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC203.rude:5
msgid ""
"The best way to keep yourself alive is to get the best spells you can afford.  If your enemy is dead, how are they supposed to fight?"
msgstr ""
"Nejlepší způsob, jak se udržet naživu, je získat ta nejlepší kouzla, jaká si jen můžete dovolit. Pokud je váš nepřítel mrtvý, jak jinak byste s ním mohli bojovat? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:1
msgid ""
"No!  They went to raid a place called Farndale.  Apparently the Mendossian army was waiting for them there and..well you can guess the rest."
msgstr ""
"Ne! Jeli vyplenit místo zvané Farndale. Vypadá to, že tam na ně mendossuská armáda již čekala a ... zbytek můžete hádat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:1
msgid "They didn't?"
msgstr "Oni se nevrátili?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:3
msgid ""
"Ravensford will be a lonely place without you here.  I'm going to miss you."
msgstr "Ravensford bude bez vás osamělým místem. Budete mi chybět."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:4
msgid ""
"Watch your spell points carefully.  There is nothing more dangerous than being attacked when you are out of them!"
msgstr ""
"Sledujte pozorně svoji manu. Není nic nebezpečnějšího než být přepaden ve chvíli, kdy žádnou nemáte!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:5
msgid ""
"That's where the next raid is going.  I'd be careful, the last time a raiding party went there, they didn't come back!"
msgstr ""
"To je místo, kam se připravuje příští útok. Byla bych opatrná, skupiny nájezdníků, které tam naposledy odjely, se nevrátily zpět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC204.rude:8
msgid "You're welcome"
msgstr "Rádo se stalo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC205.rude:1
msgid ""
"Watch out for the undead.  They can do more to you than just hurt you."
msgstr ""
"Dávejte si pozor na nemrtvé. Mohou vám udělat mnohem víc než jen to, že by vás zranili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC205.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC342.rude:2
msgid "We'd like to see some spells."
msgstr "Rádi bychom viděli nějaká kouzla."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC205.rude:2
msgid "Yes, of course."
msgstr "Ano, samozřejmě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC205.rude:3
msgid ""
"My friend claims to have been to there.  She says she swam up a backwards waterfall to get there.  I think she's lying.  How can a waterfall go backwards?"
msgstr ""
"Má přítelkyně tvrdí, že tam byla. Říká, že plavala až dozadu za vodopád, aby se tam dostala. Myslím, že lže. Jak může vodopád téct obráceně? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC205.rude:3
msgid "What do you know about Yanmir's Fort?"
msgstr "Co víš o Yanmirově tvrzi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:10
msgid ""
"It's dangerous business, that's what!  If I were you, I'd stay away from it!"
msgstr ""
"Je to nebezpečná práce, to teda jo! Kdybych byl na tvém místě, šel bych od toho! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:11
msgid "An Orb of Linking?  Great!  Go ahead and install it!"
msgstr "Orb přenosu?? Skvěle! Pojď hned dál a namontuj ho!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:11
msgid "We have an Orb of Linking."
msgstr "Máme orb přenosu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:12
msgid ""
"I think it's high time we sent another raiding party to Farndale!  It's time for revenge!  That's what I say!"
msgstr ""
"Myslím, že je nejvyšší čas, abychom vyslali další skupiny nájezdníků, které by vyplenily Farndale! Je čas na pomstu! To říkám já!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:3
msgid ""
"Apparently Hanndl charges quite a penny to cross the bridge to the Great Gate."
msgstr ""
"Zdá se, že Hanndl za překročení mostu k Velké bráně vybírá celou penny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:4
msgid ""
"I've heard rumors of a place called the Inventa Storca where there are many wonderful things!"
msgstr ""
"Slyšel jsem zvěsti o místě zvaném Inventa Storca, kde se nachází mnoho nádherných věcí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:7
msgid ""
"Not much, I'm afraid.  I spend most of my time here.  I can tell you this, however.  Many of my customers have been pleased as tickles when they got kicked out of Arslegard, because I still had all their money."
msgstr ""
"Obávám se, že ne moc. Strávil jsem většinu času tady. I když ti můžu říct toto. Mnoho mých zákazníků bylo šťastných jako blecha, když byli vypovězeni z Arslegardu, protože jsem stále měl všechny jejich peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC206.rude:9
msgid ""
"Well, I don't really think that you're ready to go off on some adventure, but if the old man thinks so, good luck!"
msgstr ""
"No, opravdu si nemyslím, že jste připraveni odejít za nějakým dobrodružstvím, ale pokud si to ten starý muž myslí, no tak hodně štěstí! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:2
msgid ""
"I warned him not to, but my brother invoked the name of Njam last month.  He's been cursed ever since!"
msgstr ""
"Já jsem ho varoval, aby to nedělal, ale můj bratr minulý měsíc stejně vyvolal Njamovo jméno. Od té doby je prokletý!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC207.rude:5
msgid "Shhh!  Don't say that name!  You're liable to become cursed!"
msgstr ""
"Pssst! Nevyslovujte to jméno! Mohlo by se vám stát, že budete prokleti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:1
msgid "Good luck, children."
msgstr "Hodně štěstí, mé dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:2
msgid ""
"The Ritual of Consecration?  I've never heard of that.  It must be one of those strange Igdrasa rituals.  You'll need to find him.  He lives around here somewhere."
msgstr ""
"Rituál zasvěcení? Nikdy jsem o něm neslyšel. Musí to být jeden z těch Idgrasiných tajemných rituálů. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:3
msgid "Of course, children."
msgstr "Samozřejmě, mé dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:2
msgid "We need some healing."
msgstr "Potřebujeme trochu vyléčit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:4
msgid "Fre's blessing upon you, my children."
msgstr "Fré ti za to požehná, mé dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:5
msgid ""
"I have others to attend to, children.  I don't have time for questions."
msgstr ""
"Jsou tu ještě jiní, o které musím pečovat, mé dítě. Nemám čas na otázky. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:6
msgid "I am sorry, my children.  We do not have any."
msgstr "Omlouvám se, mé dítě. My tu nemáme žádného."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:6
msgid "We are looking for a priest for a new church."
msgstr "Hledáme kněze pro nový kostel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:7
msgid ""
"That old freak?  I'm sorry, children but he's retired.  Was there something I could help you with?"
msgstr ""
"Toho starého blázna? Omlouvám se, mé dítě, ale ten je na odpočinku. Je tu něco, s čímpak ti můžu pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:7
msgid "We're looking for a priest named Nath'I A'Mor"
msgstr "Hledáme kněze, který se jmenuje Nath'I A'Mor"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC208.rude:8
msgid "Farewell, my children."
msgstr "Sbohem, mé dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:1
msgid "Thanks!"
msgstr "Díky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:2
msgid ""
"A friend of mine sailed through Hanndl's Grasp.  He said he was attacked by a giant sea monster that sunk his boat.  I think he just doesn't know how to navigate the shallows!"
msgstr ""
"Můj přítel se plavil přes Hanndlovo sevření. Říkal, že byl napaden obrovskou mořskou nestvůrou, která potopila jeho loď. Myslím si, že prostě jen neumí navigovat loď v mělčinách! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:3
msgid "Yes, I think we will."
msgstr "Ano, myslím, že ano."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:5
msgid ""
"Well I'm afraid I can't help you.  You see, I'm frozen in.  If someone were to clear all the ice out from the docks, I would be glad to take you anywhere you want to go."
msgstr ""
"No, obávám se, že vám nemohu pomoci. Jak vidíte, zamrzl jsem. Pokud by se někomu podařilo vyčistit tyhle doky od toho všeho ledu, rád bych vás vzal kamkoliv, kam budete chtít. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:6
msgid ""
"Hanndl's Grasp is the name our fathers gave to the collection of islands that surround the Verhoffin Sea.  The islands Guberland and Sturmford are on are part of it.  The islands from eastern Thjorgard all the way to Lachmon Cove in Mendossus."
msgstr ""
"Hanndlovo sevření je název, který naši otcové dali skupince ostrovů, jež obklopují Verhoffinovo moře. Guberland a Sturmford jsou součástí těchto ostrovů. Nacházejí se po celé cestě od východního Thjorgardu až po Lachmonskou zátoku v Mendossusu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:6
msgid "What do you know about Hanndl's Grasp?"
msgstr "Co mi řekneš o Hanndlově sevření?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:8
msgid ""
"I see that!  I really appreciate all that you've done.  Here, take this dock schedule as my gift for helping me out like that!"
msgstr ""
"To vidím! Opravdu si cením všeho, co jste udělali. Tady, vezměte si tento jízdní řád lodí jakožto můj dar za vaši pomoc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:8
msgid "The ice is clear from the docks."
msgstr "Doky jsou vyčištěné od ledu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC209.rude:9
msgid "We're looking for some information."
msgstr "Hledáme nějaké informace."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC21.rude:2
msgid ""
"I think I could make it worth your while.  Did you need training or not?"
msgstr "Myslím, že vám to mohu vynahradit. Chtěli jste trénovat, nebo ne?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC21.rude:2
msgid "Well if we had it, we wouldn't give it to you!"
msgstr "A kdybychom to měli my, stejně bychom ti to nedali!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC21.rude:3
msgid "Do you know where it could be found?"
msgstr "Máš ponětí, kde se to dá najít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC21.rude:3
msgid ""
"HA!  If I knew where it could be found, I wouldn't be sitting here dreaming about it, that's for sure.  And trust me, if I knew where it was, I wouldn't tell you!"
msgstr ""
"Ha! Kdybych to věděl, určitě bych tu neseděl a jen tak o tom nesnil. A věř mi, že kdybych tušil, kde to je, stejně bych ti to neřekl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC21.rude:4
msgid ""
"I've heard rumors about a sword known as the Sing Sword.  It is supposed to make its wearer stronger in battle.  What I would give to have that sword in my hands!"
msgstr ""
"Slyšel jsem vyprávět o meči známém jako Zpívající meč. Prý svému nositeli v boji dodával sílu. Co bych jenom za to dal, kdyby se mi dostal do rukou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC21.rude:5
msgid "Not today, thank you."
msgstr "Ne, dnes ne, děkuji."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:10
msgid ""
"Tryygva is looking for brave men to take on the Frost Giant.  If you thing you have the courage, you can find him in the Palace."
msgstr ""
"Tryygva se poohlíží po statečných mužích, kteří by mu pomohli s mrazivým obrem. Pokud si myslíte, že máte dostatek odvahy, můžete ho najít v paláci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:17 assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:11
msgid "We would like to ask you some questions."
msgstr "Moc rádi bychom ti položili několik dotazů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:19
msgid ""
"You can find the armor shop on the western end of town, just north of the training yard."
msgstr ""
"Obchod se zbrojí nalezneš na západním konci města na sever od tréninkového dvora."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:21
msgid "The tavern is just northeast of the maypole."
msgstr "Hospoda se nachází přesně severovýchodně od májky. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:22
msgid ""
"That poor man!  He's having such a hard time being in charge right now!  It's no wonder he's so depressed."
msgstr ""
"Ten ubohý muž! Musí zrovna teď v těchto těžkých časech tady tomu všemu velet! Vůbec se nedivím, že je tak sklíčený."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:22
msgid "What do you know about Tryygva"
msgstr "Co mi můžeš říci o Tryygvovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:26
msgid ""
"The magic shop is on the western end of town, just east of the training yard."
msgstr ""
"Obchod s magií se nachází na západním konci města na východ od tréninkového dvora. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:27
msgid "No, not really."
msgstr "Ne, opravdu ne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:28
msgid "The temple is just south of the maypole."
msgstr "Chrám se nachází přesně na jih od májky. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:3
msgid ""
"You can find the weapon shop on the western end of town, just north of the training yard."
msgstr ""
"Obchod se zbraněmi nalezneš na západním konci města na sever od tréninkového dvora."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:32
msgid ""
"The apothecary is on the southwestern section of town.  It is one of the hovels built into the hill."
msgstr ""
"Lékárna se nachází v jihozápadní části města. Je to jedna z chatrčí, jež jsou vestavěny do svahu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:34
msgid ""
"The training hall is in the westerly section of town, south of the weapon shop."
msgstr ""
"Tréninková místnost je v západní části města, jižně od obchodu se zbraněmi. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:38
msgid "The dock is the northernmost point from the maypole."
msgstr "Doky jsou ten nejsevernější bod od májky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:43
msgid ""
"The library is in the southern section of town.  It is one of the hovels built into the hill."
msgstr ""
"Knihovna se nachází v jižní části města. Je to jedna z chatrčí vestavěných do svahu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:6
msgid "If you're looking for Tryygva, you can find him behind me."
msgstr "Jestli hledáte Tryygvu, můžete ho najít za mnou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC210.rude:8
msgid ""
"You can find the bank in the southern section of town.  It is one of the hovels built into the hill."
msgstr ""
"Banka se nachází v jižní části města, je to jedna z chatrčí vestavěných do svahu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:2
msgid ""
"I am a collector of old tomes, friends.  Nothing I am interested in has happened in the last three hundred years."
msgstr ""
"Jsem sběratelem prastarých knih, příteli. V posledních třech stech letech se nestalo nic, co by mě zajímalo. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC350.rude:2
msgid "We'd like to see some books."
msgstr "Rádi bychom viděli nějaké knihy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:5
msgid ""
"They say you have to swim up a waterfall to get to the Sky Fort.  They also say he's invincible.  But I'm convinced there is another way to kill him."
msgstr ""
"Říká se, že musíte plavat nahoru proti proudu vodopádu, abyste se dostali do Nebeské tvrze. Také se říká, že je nepřemožitelný. Ale já jsem přesvědčený, že existuje nějaký způsob, jak ho zabít. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:5
msgid "what do you know about the frost giant?"
msgstr "Co mi můžeš říci o mrazivém obrovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC211.rude:6
msgid "Very well, but be quiet about it."
msgstr "Dobře, ale nikomu o tom neříkej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC212.rude:1
msgid ""
"Tryygva asked me to step up the training of his solders.  I wonder why?"
msgstr ""
"Tryygva mě požádal, abych zintenzívnil výcvik jeho vojáků. Rád bych věděl proč?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC212.rude:3
msgid ""
"There's not many of them around any more.  I'd say they're nearly extinct.  If you somehow found one to fight, I wouldn't go against it directly.  They're too powerful.  I'd find some way to trick it into killing itself."
msgstr ""
"Už jich tu v okolí moc není. Dokonce bych řekl, že jsou téměř vyhlazeni. Ale kdybyste náhodou na nějakého narazili, nešel bych, být vámi, proti němu přímo. Jsou příliš silní. Našel bych nějaký způsob, jak ho obelstít tak, aby se sám zabil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC212.rude:3
msgid "What do you know about fighting frost giants?"
msgstr "Víš něco o boji s mrazivými obry?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC213.rude:1
msgid ""
"My brother and I came up with a great new brew!  I don't know why Brewmaster Smith isn't selling it.  I'm sure he could make a fortune!"
msgstr ""
"Můj bratr a já jsme přišli na nové skvělé pivo! Nevím, proč ho pivovarník Smith neprodává. Jsem si jistej, že by na tom mohl vydělat jmění!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC213.rude:3
msgid ""
"Look out for the fleshy headed mutants.  Radiation has made them enemies to civilization."
msgstr ""
"Poohlídni se po mutantech se silnou hlavou. Radiace z nich udělala nepřátele civilizace."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC213.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:16
msgid "See ya."
msgstr "Měj se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC213.rude:5
msgid "See ya!"
msgstr "Uvidíme se!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC214.rude:1
msgid ""
"Yeah, don't listen to my brother.  I was the one who came up with the recipe!  He just watched.  He drank most of the first batch, too."
msgstr ""
"Jo, neposlouchej mého bratra. Byl jsem to já, kdo přišel s tím receptem! On jen přihlížel. Taky vypil většinu první várky. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC214.rude:3
msgid "Yeah, oh.  See you"
msgstr "Jo, dobře. Nashle."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC214.rude:4
msgid "Don't listen to my brother.  He doesn't know what he's talking about."
msgstr "Neposlouchej mého bratra. Neví, o čem mluví."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC214.rude:5
msgid "Yeah, ok.  See you"
msgstr "Jo, dobře. Nashle."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:2
msgid "I'll have the barrel sent right over!"
msgstr "Asi vyšlu jeden soudek hned nahoru!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:3
msgid "On the ice just outside the dock."
msgstr "Na okraj doků, přímo na led."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:3
msgid ""
"On the ice?  Okay, but here's some advice:  If you're planning a special show, the sunflowers shine the brightest at night."
msgstr ""
"Na led? Dobře, ale dám ti jednu radu: Pokud chystáš speciální podívanou, slunečnice svítí nejjasněji v noci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:4
msgid ""
"I make sunflowers!  They're barrels of magic powder that explode when you shoot them!  I have a demonstration rigged up if you would like to see one!  Just go ahead and shoot that barrel."
msgstr ""
"Vyrábím slunečnice! Jsou to soudky s magickým prachem, které vybuchují, když do nich střelíš! Mám tu jeden speciálně připravený na ukázku! Takže se neostýchej a vystřel si na něj. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:4
msgid "What do you do all the way out here?"
msgstr "Co tu děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:5
msgid ""
"Watch out for your children!  The Frost Giant that lives in the sky will come down at night and eat them!  It happened to me!"
msgstr ""
"Dávej si pozor na své děti! Mrazivý obr, který žije v Nebeské tvrzi, v noci sejde dolů a sežere je! To se stalo mně! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:6
msgid "Certainly!  Where would you like it delivered?"
msgstr "Ale samozřejmě! Kam ho mám dát?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:6
msgid "Say, you wouldn't mind making a delivery would you?"
msgstr "Bylo by možné dopravit ten soudek o kus dál?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:7
msgid "Watch out for him.  He can't be killed."
msgstr "Dávej si na něho pozor. Prý je nesmrtelný."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC215.rude:7
msgid "What do you know about the Frost Giant?"
msgstr "Co mi povíš o mrazivém obrovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC216.rude:1
msgid ""
"My children told me that the Frost Giant came for them, and threw them back!  Can you believe that?  They said the giant thought they taste bad!"
msgstr ""
"Mé děti mi řekly, že je unesl mrazivý obr, ale pak je nechal jít! Věřil bys tomu? Říkaly, že si myslel, že mu nebudou chutnat! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC216.rude:3
msgid ""
"They're frozen over.  I wish there was someone who was strong enough to break up all the ice."
msgstr ""
"Jsou zamrzlé. Přál bych si, aby tu byl někdo dost silnej na to, aby rozbil všechen ten led. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC216.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:7
msgid "What do you know about the docks?"
msgstr "Co víš o docích?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:2
msgid ""
"A pledge?   That's it?  If that's all that is required, then you have it!"
msgstr "Slib? Určitě? Jestli to je vše, oč se žádá, pak ho máte mít!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:2
msgid "Give us your pledge."
msgstr "Dej nám slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:3
msgid "How?  If there is a way, I shall do it!"
msgstr "Jak? Pokud existuje nějaký způsob, udělám to!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:3
msgid "You could bring back the Green Man."
msgstr "Mohl bys dopomoci návratu Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:4
msgid ""
"The docks are all frozen!  I don't know what we're going to do!  Without the docks, the boats can't dock!  We're all going to starve!"
msgstr ""
"Doky jsou úplně zamrzlé! Nevím, co budeme dělat! Bez doků sem nemohou připlout lodě! Všichni budeme hladovět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:6
msgid "What sort of help could I give?"
msgstr "Jak bych ti mohl pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC217.rude:7
msgid ""
"They are all frozen over.  Maybe we could get a big battering ram and break up all the ice!  Oh!  What are we going to do?"
msgstr ""
"Jsou skrznaskrz zamrzlé. Možná bychom mohli vzít velké beranidlo a rozbít všechen ten led! Ach! Co budeme dělat? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:2
msgid "Give him a pledge that you won't forget to celebrate him."
msgstr "Dej mu slib, že ho nezapomenete oslavovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:2
msgid "I will not ever forget to celebrate him again!  You have my word!"
msgstr "Už nikdy ho nezapomenu oslavovat! Máte mé slovo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:3
msgid ""
"Without the boats coming in, we'll all starve!  Our crops are failing, and our farmers can't seem to produce enough food for us all to eat!  What are we going to eat?"
msgstr ""
"Pokud se sem nedostanou lodě se zásobami, budeme hladovět! Úroda se letos nevydařila a už teď nemá mnoho lidí ve městě co do úst! Co jen s námi bude?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:5
msgid "My help?  How can I help the Green Man?"
msgstr "Moji pomoc? Jak já mohu pomoci Zelenému mužíčkovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:6
msgid "I don't know how we're going to break up all that ice!"
msgstr "Ne, myslím, že to bude velmi obtížné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC218.rude:6
msgid "What do you know about breaking up the ice?"
msgstr "Nenapadá tě způsob, jak se zbavit toho ledu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC219.rude:1
msgid "The army is coming, I tell you!  It will mean destruction for us all!"
msgstr "Prý na nás pochoduje cizí armáda! To bude znamenat zkázu nás všech!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC219.rude:3
msgid ""
"I know that I heard someone talking about the invading army to the west.  Once they conquer Thronheim, it will be destruction for us all!"
msgstr ""
"Vím pouze to, že někdo mluvil o vpádu barbarských hord. Až dobudou Tronheim, je s námi konec!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC219.rude:3
msgid "What do you know about invasions?"
msgstr "Co víš o té invazi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:1
msgid ""
"From what I have heard an army  is supposedly marching in the west.   That's trouble for certain.  I'm not sure I would call it a war, though.  More like a slaughter."
msgstr ""
"Dolehly ke mně zvěsti, že na západ pochoduje jakási armáda. To bude určitě znamenat problémy. Ale nevím jistě, zda se to dá nazvat válkou. Možná spíš masakrem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:2
msgid "Good day to you sir."
msgstr "Přeji hezký den, pane."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:3
msgid "All one could ask is that you fight."
msgstr "Otázka zní, zda bys bojoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:3
msgid "I have but only my life to give."
msgstr "V sázku mohu dát pouze svůj život."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:4
msgid ""
"I would fight, for sure.  But I am a farmer, not a soldier.  The word is, this is the largest army since before the Great Cataclysm.  In the face of that,  I'm sure that I wouldn't be the only one to end up dead."
msgstr ""
"Jistěže bych bojoval. Ale jsem farmář, ne voják. A tohle je prý ta největší armáda od dob Velké pohromy. Jsem si jistý, že nebudu sám, kdo tváří v tvář něčemu takovému potká pouze svou smrt."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:4
msgid "Would you not take up arms in defense of your homeland?"
msgstr "To bys k obraně své vlasti ani nepozdvihl zbraň?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:6
msgid ""
"Well, I know that Framon is the nearest nation to us, not counting Thronheim, that is.  I've heard that they are not in the best shape.  I guess they don't have much left after all the raids we've done there."
msgstr ""
"Inu, vím, že nejblíže od nás sídlí národ Framon, pomineme-li Thronheim. Doslechl jsem se, že na tom nejsou zrovna nejlíp. Počítám, že jim po těch nájezdech, co jsme tam podnikli, toho už moc nezbývá."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:6
msgid "What do you know about the west?"
msgstr "Co víš o západě?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC22.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC67.rude:2
msgid "Nothing, sorry."
msgstr "Promiň, ale nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC220.rude:1
msgid ""
"I don't put much faith in rumors.  Like the one about the army coming to conquer us all.  I haven't seen any evidence of this!  How do we know that the army even exists?"
msgstr ""
"Já těm kolujícím fámám moc nevěřím. Jako té o blížící se armádě, která si nás všechny podrobí. Neviděl jsem o tomto tvrzení jediný důkaz! Jak máme vědět, že ta armáda vůbec existuje? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC220.rude:4
msgid ""
"Tjorvi seems to think that they're going to hit Thronheim first.  But I think Thronheim is too well defended.  My first target would be Thjorgard.  Once I secured a foothold in the least defended city in Chedian, I'd..wait!  That's Frosgard!  Oh no!"
msgstr ""
"Tjorvi si nejspíš myslí, že nejdříve zaútočí na Thronheim. Ale ten je příliš dobře opevněný. Můj první cíl by byl Thjorgard. Kdysi jsem zabezpečoval důležitá místa v nejméně chráněném městě Chedianu, já bych... počkej! Je to určitě Frosgard! Och, to ne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC220.rude:4
msgid "What do you know about invaders?"
msgstr "Co bys mi řekl o útočnících?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:1
msgid ""
"This place is my home.  When I am not restoring nature, I take pleasure in taking walks here."
msgstr ""
"Toto místo je můj domov. Když zrovna nevylepšuji přírodu, nacházím tady potěšení v dlouhých procházkách. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:10
msgid ""
"I mourn for Frosgard, for they have forgotten me.  Perhaps one day, someone will remind them of that."
msgstr ""
"Truchlím pro Frosgard za to, že na mě zapomněli. Jednoho dne jim to snad někdo připomene."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:11
msgid ""
"That is indeed good news!  I thank you for your help.  You have saved more lives than you know.  I have a gift for you, so that all who come upon you know you have received the blessings of the green man."
msgstr ""
"To jsou skutečně dobré zprávy! Děkuji vám za pomoc. Zachránili jste více životů, než myslíte. Mám pro vás dar, takže všichni ti, které na cestě potkáte poznají, že jste dostali požehnání od Zeleného mužíčka. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:11
msgid "We have completed your tasks."
msgstr "Dokončili jsme tvé úkoly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:13
msgid "Of course, friends."
msgstr "Samozřejmě, příteli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:14
msgid "Farewell.  Come back soon!"
msgstr "Sbohem. Brzy se vrať!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:2
msgid "You are welcome, visitors.  Farewell."
msgstr "Není zač, návštěvníku. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:4
msgid ""
"Once those things are all done, I will return.  I thank you for your visit, friends."
msgstr ""
"Až všechny tyto úkoly budou hotové, vrátím se. Děkuji ti za návštěvu, příteli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:4
msgid "We will do that."
msgstr "Udělám to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:5
msgid ""
"And finally, as a symbol of their pledge to me, the Frosgard leader has to carve and place a runestone near the maypole.  The stone should declare the promise made, and the Frosgardian's intent to keep it."
msgstr ""
"A nakonec, jako symbol jejich závazku ke mně, musí frosgardský vůdce nechat vytesat kámen s nápisem a umístit jej poblíž májky. Kámen by měl vyjadřovat stanovený slib a Frosgardští by měli být rozhodnuti jej dodržovat. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:5
msgid "That can be done."
msgstr "I toto se může zařídit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:6
msgid ""
"I also need a promise from the Frosgardians that they will not neglect the festivals.  I think promises from six townsfolk would be enough."
msgstr ""
"Také potřebuju slib od Frosgardských, že nebudou zanedbávat festivaly. Myslím, že sliby od šesti obyvatel města budou stačit. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:6
msgid "We can do that."
msgstr "To můžeme udělat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:7
msgid "How can we help?"
msgstr "Jak můžeme pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:7
msgid ""
"There are three things that must be done.  Firstly, the maypole in the center of town is in a sad state of repair.  If I am to return, the maypole needs to be repaired."
msgstr ""
"Jsou tu tři věci, které se musí udělat. Zaprvé májka, jež stojí uprostřed města, je v ubohém stavu. Pokud se mám vrátit, májka musí být opravena. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:8
msgid ""
"I'm afraid that they will have one celebration in my honor, and then forget about me again."
msgstr ""
"Obávám se, že uspořádají na moji počest jednu oslavu a pak na mne zase zapomenou. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:8
msgid "We think the Frosgardians are eager for your return."
msgstr "Myslíme si, že Frosgardští se nemohou dočkat tvého návratu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:9
msgid ""
"It has been a long time since someone from Frosgard remembered who I was.  It pleases me to know that they have not totally forgotten me.  I long to return to Frosgard."
msgstr ""
"Již v řekách proteklo hodně vody od té doby, co si někdo ve Frosgardu vzpomněl, co jsem zač. Mám radost z toho, že na mě nezapomněli úplně. Toužím po návratu do Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC221.rude:9
msgid "We've come on behalf of Frosgard."
msgstr "Přišli jsme jako zástupci Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC222.rude:2
msgid ""
"I've heard that Brewmaster Smith is looking for someone to take a shipment of ale over to Guberland."
msgstr ""
"Zaslechl jsem, že pivovarník Smith hledá někoho, kdo by dopravil várku jeho piva až do Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC222.rude:4
msgid "He does?  If that will bring back the harvests, I will give it!"
msgstr "Ano opravdu? Pokud nás to zachrání před hladomorem, dám mu ho!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC222.rude:5
msgid "That's the city of the gods.  That's where Hallenhalt is."
msgstr "Je to město bohů. Místo, kde je Hallenhalt."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:2
msgid ""
"A pledge?  You mean one that would bring him back?  I will give that for certain!"
msgstr "Slib? Myslíš ten, který ho přivede zpět? Určitě ti ho dám!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:2
msgid "Give a pledge for the Green Man."
msgstr "Dej slib Zelenému mužíčkovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:3
msgid ""
"Robert and Douglas have come up with a new concoction.  I tasted it, and it's awful!"
msgstr ""
"Robert a Douglas vymysleli nový nápoj. Ochutnal jsem ho a bylo to pěkně hnusné!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:5
msgid "Frosgard?  What can I do for Frosgard that the Jarl can't do?"
msgstr "Frosgard? Co já mohu udělat pro Frosgard?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:6
msgid "I am an expert at it!  I spend a lot of time practicing!"
msgstr "Jsem na to expert! Hodně času strávím při tréninku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC223.rude:6
msgid "What do you know about drinking?"
msgstr "Co víš o pití?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC224.rude:2
msgid ""
"I wonder what happened to the Green Man.  He used give us great bounty!"
msgstr ""
"Rád bych se dozvěděl, co se stalo Zelenému mužíčkovi. Zajišťoval nám hojnou úrodu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC224.rude:4
msgid "The Green Man wants a pledge from you."
msgstr "Zelený mužíček chce od tebe slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC224.rude:4
msgid ""
"The Green Man?  Will it bring him back?  Of course it will.  Very well.  I will give that pledge."
msgstr ""
"Zelený mužíček? Přivede ho to zpět? Samozřejmě, že ano. Dobře. Dám ti ten slib."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC224.rude:5
msgid "He hasn't come around in a long time.  I wonder what happened to him?"
msgstr ""
"Nepřišel sem do okolí již dlouhou dobu. Rád bych věděl, co se s ním stalo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC224.rude:5
msgid "What do you know about The Green Man?"
msgstr "Co víš o Zeleném mužíčkovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC225.rude:2
msgid ""
"I wish my wife would let me go adventuring again.  I long to have those days back again."
msgstr ""
"Přeju si, aby mi má žena dovolila zase jít za nějakým dobrodružstvím. Toužím po tom, aby byly zase ty časy zpátky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC225.rude:4
msgid "A Pledge?  For the Green Man, I would give any pledge"
msgstr "Slib? Zelený mužíček mi je ukradený."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC225.rude:4
msgid "We need your pledge for the Green Man."
msgstr "Potřebujeme tvůj slib pro Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC225.rude:5
msgid ""
"Get yourself the repair skill.  That'll save your hide more than a heal spell ever could."
msgstr ""
"Nauč se dovednosti opravování. To ti zachrání kůži mnohem víc, než by kdy mohlo nějaké uzdravovací kouzlo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC225.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC226.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC226.rude:7
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC69.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC71.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:9
msgid "Bye!"
msgstr "Pa!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC226.rude:2
msgid ""
"I long for the days Brand and I used to spend on adventures.  He's married these days, and his wife hardly lets him go out any more."
msgstr ""
"Vzpomínám na dny, které jsme Brand a já strávili na dobrodružstvích. Dneska je už ženatý a jeho žena mu sotva dovolí vyjít ven z domu. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC226.rude:4
msgid ""
"If I can do anything that will bring him back, I shall.  I will give you that pledge."
msgstr ""
"Pokud můžu udělat něco, co ho přivede zpátky, tak to udělám. Dám ti ten slib. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC226.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC230.rude:4
msgid "We are collecting pledges for the Green Man."
msgstr "Sbírám sliby pro Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC226.rude:5
msgid ""
"Make sure you have someone who can cast spells in your group.  They're worth their weight in Thjorad!"
msgstr ""
"Ujistěte se, že máte ve své skupině někoho, kdo umí sesílat kouzla. V Thjoradu se to ohromně vyplatí!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC227.rude:1
msgid "blka"
msgstr "blka"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC227.rude:2
msgid ""
"Where's that no good husband of mine?  He's always running around trying to go on adventures again."
msgstr ""
"Neviděli jste mého muže? Stále ještě jej neopustila touha po dobrodružství a já se bojím, že se jednoho dne probudím a on bude pryč! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC227.rude:4
msgid "A pledge?  Of course!  We have neglected him for too long."
msgstr "Slib? Samozřejmě! Příliš dlouhou dobu jsme ho zanedbávali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC227.rude:5
msgid ""
"I know I don't like it!  Too many of my friends have not come back from it!"
msgstr "Vím, že se mi to nelíbí! Příliš mnoho mých přátel se nevrátilo zpět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC228.rude:2
msgid ""
"I've been sick lately.  I finally got enough money to go to the temple to get healed."
msgstr ""
"V poslední době jsem byl skoro pořád nemocný. Konečně mám dostatek peněz na to, abych se šel nechat do chrámu vyléčit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC228.rude:4
msgid ""
"The Green Man?  Of course!  Should he need my help, I shall always be around to answer his call!"
msgstr ""
"Zelený mužíček? Samozřejmě! Kdyby potřeboval moji pomoc, vždy budu nablízku, abych odpověděl na jeho volání! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC228.rude:5
msgid "They are good places to get healed if you have the money."
msgstr ""
"Jsou to dobrá místa, kde se můžete nechat uzdravit, pokud máte peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC228.rude:5
msgid "What do you know about temples."
msgstr "Co víš o chrámech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC229.rude:2
msgid "I've been studying how to repair items with Hervor Etzeldotir."
msgstr "Učil jsem se u Hervora Etzeldotira, jak opravovat předměty."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC229.rude:4
msgid "A pledge?  Of course!  If you ask, I shall give it!"
msgstr "Slib? Samozřejmě! No, když se ptáš, tak mu ho dám!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC229.rude:5
msgid ""
"Hervor Etzeldotir is the one to go to if you want to be an expert in it!"
msgstr ""
"Hervor Etzeldotir je ta pravá osoba, za kterou byste měli zajít, pokud se chcete stát experty v opravování! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC229.rude:5
msgid "What do you know about repairing items?"
msgstr "Co mi můžeš říct o opravování předmětů?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:1
msgid ""
"If there is an army marching towards Thjorgard, then there is going to be a war.  It as simple as that."
msgstr ""
"Na Thjorgard táhne nějaké vojsko, takže se asi schyluje k válce. Je to tak prosté."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:10
msgid "Would you fight?"
msgstr "Pustil by ses do boje?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:11
msgid ""
"For the Elemental Thjorad, of course!  Any army with the weapons Elemental Thjorad could make would be invincible."
msgstr ""
"Samozřejmě kvůli thjoradské rudě! Každé vojsko se zbraněmi z takového kovu by bylo neporazitelné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:11
msgid "Why do you think this army is marching towards Chedian?"
msgstr "Proč se domníváš, že ta armáda pochoduje na Chedian?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:12
msgid "Nothing, Sorry"
msgstr "Nic. Promiň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:2
msgid ""
"Me?  I am not a soldier.  That is what I pay taxes to Sven Forkbeard for!"
msgstr ""
"Já? Já nejsem voják. Odvádím Svenu Vidlobradovi daně, tak ať se stará on!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:2
msgid "Perhaps you should do something about it."
msgstr "Možná bys s tím měl něco dělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:3
msgid "He's the leader of the army."
msgstr "Je to velitel armády."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:3
msgid ""
"The army really is marching?  Oh!  Does Sven know?  He should be preparing our defenses!"
msgstr ""
"Armáda už je skutečně na pochodu? No teda! A Sven to ví? Měl by shromáždit naše obranné síly!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:4
msgid "Tamur Leng?  Who is that?"
msgstr "Tamur Leng? Kdo je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:4
msgid "You think that his army is strong enough to defeat Tamur Leng?"
msgstr ""
"Domníváš se, že jeho armáda je dostatečně silná, aby porazila Tamura Lenga?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:5
msgid "May you and your fear be long lived."
msgstr "Nechť se ty i tvůj strach dočkáte dlouhého žití."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:5
msgid "Thank you!  Wait a minute!  I think that might have been an insult!"
msgstr "Děkuji ti! Ale momentík! Myslím, že to je urážka!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:6
msgid ""
"If his army were defeated, you mean?  I am an intelligent person.  I am sure that the new Jarl would spare someone like me."
msgstr ""
"Máte na mysli, že by mohla být poražena? Já jsem velmi chytrý a vzdělaný. Jsem si jist, že nový jarl někoho takového jako já ušetří."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:6
msgid "What if Sven's army isn't large enough?"
msgstr "A co když Svenova armáda není tak silná?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:7
msgid ""
"Of course not.  Sven Forkbeard has a strong army.  I am certain that he could defeat any army that would attack Thjorgard."
msgstr ""
"Samozřejmě že ne. Sven Vidlobrad má silné vojsko. Nepochybuji, že dokáže zničit jakoukoliv armádu, která by se chtěla přiblížit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:7
msgid "Will you fight?"
msgstr "Budeš bojovat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:9
msgid ""
"I'm not really the one to ask.  I'm not much of a fighter.  There's plenty of teachers around here, if you're looking for them to show you a thing or two."
msgstr ""
"Na to opravdu nejsem ten pravý. Nejsem zrovna bojovník. Tady v okolí je učitelů víc než dost, poohlédni se po nich."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC23.rude:9
msgid "What do you know about fighting?"
msgstr "Máš nějakou povědomost o boji?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC230.rude:2
msgid ""
"Nope.  Well, except I heard my brother stopped working.  According to him, the condition in the Thjorad mines are getting worse.  I told him he should just quit and come out here!"
msgstr ""
"Nemám. Snad kromě toho, že jsem zaslechl, že můj bratr přestal pracovat. Podle něho se podmínky v thjoradských dolech hodně zhoršily. Já mu říkal, že by tam měl skončit a přijít sem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC230.rude:4
msgid ""
"The Green Man has come back?  He needs a pledge?  I shall be happy to give it."
msgstr "Zelený mužíček se vrátil? Potřebuje slib? Má ho mít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC230.rude:5
msgid ""
"My brother works in the mines there.  He says it's very difficult work.  He's always complaining about the bad conditions for the workers and the low pay."
msgstr ""
"Můj bratr tam pracuje v dolech. Tvrdí, že je to velmi namáhavá práce. Pořád si stěžuje na špatné podmínky a nízký plat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:2
msgid ""
"I was out looking at the ice covering our docks the other day.  It doesn't look that bad.  I bet a resourceful individual could find a way to break it all up."
msgstr ""
"Byl jsem se nedávno podívat na tu ledovou krustu v docích. Nevypadá to tak zle. Vsadím se, že nějaký vynalézavý jedinec by mohl najít způsob, jakým by všechen ten led rozbil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:4
msgid ""
"The Green Man wants a pledge from me?  Wow!  Of course I'll give a pledge."
msgstr "Zelený mužíček by chtěl ode mě slib? Jů! Samozřejmě mu dám slib. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:4
msgid "We need a pledge for the Green Man."
msgstr "Potřebujeme slib pro Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:5
msgid ""
"I think the only way to break up ice is to find something large enough to chop at it with."
msgstr ""
"Myslím, že jediná cesta, jak rozbít ten led, je najít něco dostatečně velkého, čím by se to rozsekalo. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC231.rude:5
msgid "What do you know about breaking up ice."
msgstr "Napadá tě nějaký způsob, jak se toho ledu zbavit?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC232.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC431.rude:1
msgid "asd"
msgstr "asd"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC232.rude:2
msgid "It will keep your people from starving."
msgstr "Zelený mužíček může frosgardský klan zachránit před hladomorem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC232.rude:2
msgid ""
"Sure it will.  Very well.  If giving it will make you leave me alone, I will give it to you."
msgstr ""
"Aha, dobře. Pokud to znamená, že mi pak dáš pokoj a přestaneš mě otravovat, tak ti ho dám. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC232.rude:4
msgid ""
"From me?  What does the Green Man do for me?  Why should I give him my pledge."
msgstr ""
"Ode mě? A co Zelený mužíček pro mne za to udělá? Proč bych mu měl něco slibovat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC232.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:7
msgid "Don't do it again."
msgstr "Už to podruhé nezkoušej."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:7
msgid "If you are ready, I can help you with that."
msgstr "Pokud jste připraveni, mohu vám s tím pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:2
msgid "We'd like to become Experts in Bodybuilding."
msgstr "Rádi bychom se stali experty v posilování."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:1
msgid "Nope."
msgstr "Nemám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:7
msgid "We'd like to become Masters in Bodybuilding."
msgstr "Chtěli bychom dosáhnout mistrovství v posilování."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:4
msgid "Nothing"
msgstr "Nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:4
msgid "What do you know about Yanmir?"
msgstr "Co bys mi řekla o Yanmirovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:1
msgid ""
"To become Grandmasters, you must be taught by Stev Palac.  Seek him out in Yorwick."
msgstr "Velmistrovství ti pomůže dosáhnout Stev Palac. Hledej ho v Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:1
msgid "Where can we become Grandmasters in Bodybuilding?"
msgstr "Kde se můžeme stát velmistry v posilování?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC233.rude:6
msgid "Why?"
msgstr "Proč?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:22
msgid "I can help you with that."
msgstr "S tím ti můžu pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:2
msgid "We'd like to improve our Merchant skill to Expert."
msgstr "Rádi bychom si zdokonalili dovednost obchodování na experta."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:2
msgid "One day, I shall find the lost elvish clan."
msgstr "Jednoho dne najdu ztracený elfí rod."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:4
msgid "If you are able, I can help you with that."
msgstr "Pokud máte dostatek zkušeností, můžu vám s tím pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:4
msgid "We'd like to improve our Merchant skill to Master."
msgstr "Rádi bychom si zdokonalili dovednost obchodování na mistra."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:4
msgid ""
"I know that after the Great Cataclysm, one clan of elves escaped, and are hidden somewhere in bondage.  One day I will find them and free them."
msgstr ""
"Vím, že po Velké pohromě jeden z elfích kmenů utekl a je držen někde v otroctví. Jednoho dne je najdu a osvobodím je."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:4
msgid "What do you know about elves?"
msgstr "Co mi můžeš říct o elfech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:3
msgid "If you are able, you must seek out Bren Haukdotir in Yorwick."
msgstr "Pokud jste dost schopní, musíte najít Brena Haukdotira v Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC234.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:3
msgid "Where can we become Grandmasters in Merchant?"
msgstr "Kde bychom se mohli stát velmistry v obchodování?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:4
msgid "If you have the required skill, I can help you."
msgstr "Pokud máte požadovanou dovednost, mohu vám pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:2
msgid "We'd like to become Experts in our Perception Skill."
msgstr "Rádi bychom se stali experty v dovednosti vnímání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:2
msgid ""
"Well, let me tell you about my husband.  He was exploring an abandon cave, and wasn't paying attention.  He fell into a pit and nearly got speared to death!"
msgstr ""
"Dobře, řeknu ti něco o svém manželovi. Prozkoumával jednu opuštěnou jeskyni a zaplatil za svoji nepozornost. Spadl do jedné jámy a nabodnul se na hroty!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:4
msgid "We'd like to become Masters in our Perception Skill."
msgstr "Rádi bychom se stali mistry v dovednosti vnímání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:4
msgid "Keep your eyes peeled.  A watchful eye beats quick reflexes any day."
msgstr "Měj oči na stopkách. Pozorné oko kdykoliv překoná rychlé reflexy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:3
msgid ""
"If you fit the requirements, you must go to Yorwick and find Broccan A'Ghrie.  She will help you become Grandmasters."
msgstr ""
"Pokud splňujete požadavky, musíte jít do Yorwicku a najít Broccanu A'Ghrii. Ona vám pomůže stát se velmistry."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC235.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:3
msgid "Where can we become Grandmasters in Perception?"
msgstr "Kde bychom se mohli stát velmistry v dovednosti vnímání?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC236.rude:4
msgid "A pledge?  Sure!  I'll give him a pledge."
msgstr "Slib? Jistě! Dám mu slib!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC236.rude:5
msgid ""
"Go to Thjorgard and find yourself some goat's milk tea.  It will protect you from being turned to stone."
msgstr ""
"Jděte do Thjorgardu a sežeňte si trochu odvaru z kozího mléka. Ochrání vás před zkameněním."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:2
msgid "If you are able, I can train you."
msgstr "Jestli jste zdatní, můžu vás trénovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:2
msgid "We'd like to improve our Disarm Trap Skill to Expert."
msgstr "Rádi bychom si zdokonalili dovednost zneškodňování pastí na experta."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:2
msgid "I nearly lost my hand trying to disarm a trap once."
msgstr ""
"Málem jsem přišel o ruku, když jsem se jednou pokoušel odstranit past."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:4
msgid "If you are capable I can help you with that."
msgstr "Jestli jste zdatní, můžu vám s tím pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:4
msgid "We'd like to improve our Disarm Trap Skill to Master."
msgstr "Rádi bychom si zdokonalili dovednost zneškodňování pastí na mistra."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:4
msgid ""
"There is no better thing to have in your group than someone who can disable traps.  It'll save your life more often than a brainsmasher any day."
msgstr ""
"Není žádné lepší věci než mít ve své družině někoho, kdo umí zneškodňovat pasti. Ten ti zachrání život mnohem častěji než jakýkoliv drtič lebek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:3
msgid ""
"If you possess the necessary requirements, you must find Marshall Hanford in Yorwick."
msgstr ""
"Pokud splňujete nezbytné požadavky, musíte najít Marshalla Hanforda z Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC237.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:3
msgid "Where can we become Grandmasters in Disarm Trap?"
msgstr "Kde bychom se mohli stát velmistry v dovednosti zneškodňování pastí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:8
msgid "Very well.  Farewell."
msgstr "Dobře. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:10
msgid "We no longer require your help."
msgstr "Už více nepotřebuji tvou pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:2
msgid "I will be happy to accompany you."
msgstr "Budu šťastná, když vás budu moci doprovázet."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:2
msgid "We want to take advantage of Fre's blessings.  You're hired."
msgstr "Chtěli bychom využít požehnání Fré. Najímáme tě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:3
msgid ""
"For a small donation of 1000 gold per month plus a tithe of 10% of all gold you find, I can travel with you and heal your of all your injuries and conditions once per day."
msgstr ""
"Za malý poplatek 1000 zlatých měsíčně plus desátek 10% ze všeho zlata, které najdete, s vámi mohu cestovat a jednou denně vyléčit všechna vaše zranění a nemoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:3
msgid "What sort of services?"
msgstr "Jaké služby nabízíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:4
msgid "Fre smiles kindly upon the penitent."
msgstr "Fré se vlídně usmívá na kajícníky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:5
msgid "And what else did Fre say?"
msgstr "A co dalšího Fré řekla?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:5
msgid ""
"She has commanded me to be available for you, should you require my services."
msgstr "Nařídila mi, abych ti byla k dispozici, kdybys vyžadoval mých služeb."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:6
msgid "Very well.  Should you need me, I will be available."
msgstr "Dobře. Kdybys mě potřeboval, budu k dispozici."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:6
msgid "We don't need a healer right now."
msgstr "Právě teď nepotřebuji žádného léčitele."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:7
msgid ""
"Fre is the wife of Krohn, who is the king of the gods.  It is said that he will die on the day of the Great Reckoning."
msgstr ""
"Fré je manželkou Krohna, a ten je králem bohů. Traduje se, že zemře v den Velkého zúčtování."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC341.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC350.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC363.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC370.rude:3
msgid "What do you know about the gods?"
msgstr "Co víš o bozích?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC238.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:7
msgid "We'd like to be healed"
msgstr "Chtěli bychom uzdravit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:1
msgid ""
"She told you that, did she.  Then I guess you're not just subjects looking for reassurance.  She's right.  They'll be here soon, and despite the fight we put up, they will overrun us.  Perhaps you'd like to lend your swords to the battle?"
msgstr ""
"Řekla ti to, že ano. Pak asi nebudeš poddaný, který hledá útěchu. Yrsa má pravdu. Budou tu již brzy a i když že se jim postavíme v boji, oni nás porazí a zotročí. Snad bys rád propůjčil svůj meč do bitvy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:1
msgid "We've been to see Yrsa the Troll on the Isle of Ashes."
msgstr "Byli jsme u Yrsy Trol na Ostrově popela."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:10
msgid ""
"Oh dear.  Bjarni's been enamored with me for some time.  He's a good Jarl and a strong warrior, but not my type.  This sort of thing can be very touchy, especially with Bjarni.  He's had some people's hides for dancing around the bush with him."
msgstr ""
"Ach jo. Bjarni byl po nějakou dobu do mne zahleděn. Je to dobrý vůdce a silný válečník, ale není to můj typ. Tato záležitost může být velmi citlivá, zvláště pro Bjarniho. Stáhl z některých lidí kůži za to, že ho nebrali moc vážně. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:10
msgid "What should we tell him for you?"
msgstr "Co bychom mu měli od tebe vzkázat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:11
msgctxt "said by the party"
msgid "How?"
msgstr "Jak?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:11
msgid "I don't know.  Just don't kill them."
msgstr "To nevím. Hlavně je nepobij."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:12
msgid ""
"Is that so?  Yes, I suppose that all of us fighting together would be enough to stop them, drive them back to the hole they came from.  Who's going to lead this army?"
msgstr ""
"Opravdu? Ano, domnívám se, že kdybychom všichni bojovali společně, tak by to stačilo k tomu, abychom je zastavili a přinutili je vrátit se do té díry, ze které vylezli. Kdo povede tuto armádu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:12
msgid "Yrsa sent us to unite the Six Clans against them."
msgstr "Yrsa nás poslala sjednotit šest klanů, které by se mu postavily."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:13
msgid ""
"Great!  I'm sure it is somewhere to the east.  For people as skilled as you, it shouldn't be too difficult to find."
msgstr ""
"Skvělé! Jsem si jistá, že je to někde na východě. Pro zkušené lidi, jako jste vy, by nemělo být tak obtížné to najít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:13
msgid "We will find the Mountain Pass for you."
msgstr "Najdu ten horský průsmyk."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:14
msgid "They are too strong for you."
msgstr "Jsou na tebe příliš silní."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:14
msgid "Who are you?  What makes you think such things."
msgstr "Kdo jste? Proč si myslíte takové věci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:15
msgid ""
"I have heard the reports.  Fear not, I have been preparing our defenses.  They'll not catch us off guard."
msgstr ""
"Slyšela jsem to hlášení. Neboj se, naše obrana je v pohotovosti. Nepřekvapí nás."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:15
msgid "There is an army marching towards Thronheim as we speak."
msgstr "Jak už jsme řekli, směrem k Tronheimu pochoduje armáda."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:16
msgid "Tell them to meet here in two weeks."
msgstr "Řekni jim, že se tu sejdeme za dva týdny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:16
msgid "That I shall.  We will see you then."
msgstr "To udělám. Uvidíme se později."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:17
msgid ""
"Let me guess who that would be for.  That's pretty crafty of you!  Have me compose it so you will be assured that Bjarni will sign it.    Very well, I shall write the peace treaty."
msgstr ""
"Nechte mě hádat, kdo by to měl být. Je to od vás velmi mazané! Necháte mě to sepsat, takže si budete jisti, že to Bjarni podepíše. Velmi dobře, sepíšu tu mírovou dohodu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:17
msgid "We need someone to write a peace treaty."
msgstr "Potřebujeme někoho, kdo by napsal mírovou dohodu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:18
msgid ""
"You and I shall bring peace to Sturmford and Drangheim for the first time in a hundred years!  Come back tomorrow, and I shall have the treaty for you."
msgstr ""
"Vy a já přineseme mír do Sturmfordu a Drangheimu poprvé po sto letech! Zítra se vraťte zpátky, budu mít pro vás tu dohodu sepsanou. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:19
msgid "We appreciate your hospitality."
msgstr "Velmi oceňuji tvoji pohostinnost."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:19
msgid ""
"You're welcome.  I'm not so sure about letting that Jarl from Guberland in, but if you say I must, so I shall.  Farewell."
msgstr ""
"Nemáte zač. Nejsem si moc jistá, zda mám dovolit, aby sem přišel i jarl z Guberlandu, ale pokud říkáte, že musím, tak ho sem pustím. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:2
msgid "Excellent!  Many of the Thronish will thank you, I can assure you."
msgstr "Skvělé! Mnoho Thronských vám poděkuje, to vás mohu ujistit. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:20
msgid "Thank you.  We will be back very soon."
msgstr "Díky. Budu brzy zpátky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:20
msgid ""
"They are not very trusting of each other, so I would recommend you have them sign it in a neutral place.  If you wish, they may come here to sign it before all the Jarls.  Good luck!"
msgstr ""
"Oni si navzájem moc nedůvěřují, takže bych ti doporučila, aby to podepsali na neutrální půdě. Jestli si to přeješ, mohou přijet sem, aby to podepsali před zraky všech vůdců. Hodně štěstí! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:21
msgid "We will see you tomorrow."
msgstr "Uvidíme se zítra."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:22
msgid ""
"I will be happy to host it.  When you are ready, bring all the Jarls here."
msgstr ""
"Byla bych šťastná, kdybych ji mohla pořádat. Až budete připraveni, přiveďte sem všechny vůdce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:22
msgid "We will be having a war council soon."
msgstr "Brzy se bude konat válečná rada."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:24
msgid "Alright.  So we should tell him the truth."
msgstr "Dobře. Takže bychom mu měli říct pravdu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:24
msgid ""
"If you break his heart that abruptly, that could start a war!  Tell him whatever you want, just be careful.  Try not to offend him.  Is there anything else you've come here for?"
msgstr ""
"Jestli mu zlomíte náhle srdce, mohlo by to rozpoutat válku! Řekněte mu, co chcete, ale buďte opatrní. Nepokoušejte se ho urazit. Máte ještě něco jiného na srdci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:25
msgid ""
"In some of the historical books, there are stories of a mountain pass that used to connect Thronheim with Thjorgard.  It is said to have made the Thronish very rich at the time.  I want you to find this pass, and reopen it for trade."
msgstr ""
"V některých starých knihách jsou příběhy o horském průsmyku, jenž kdysi spojoval Thronheim s Thjorgardem. Prý ho vytvořili Thronheimští, kteří byli v té době velmi bohatí. Najdi jej a znovu ho otevři, aby se opět mohl začít používat pro obchodní účely."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:25
msgid "What is the second task?"
msgstr "Jaký je druhý úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:26
msgid "Was there anything else I can help with?"
msgstr "Je tu něco jiného, s čím ti mohu pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:27
msgid "I understand.  The Honkies are unpleasant to deal with."
msgstr "Rozumím. Kejhovité jsou při jednáních hrozně nepříjemní. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:27
msgid "Perhaps we could do that later."
msgstr "Snad bychom to mohli udělat později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:28
msgid ""
"Wonderful.  I shall be happy to host it.  I shall send word to the other Jarls immediately."
msgstr ""
"Nádhera. Jsem šťastná, že ji budu moci pořádat. Ihned obešlu všechny ostatní vůdce. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:29
msgid ""
"I think that is the man who is leading the army marching on us.  He will be the first to get it, I assure you."
msgstr ""
"Myslím, že je to ten muž, který na nás vede onu armádu. On bude první, který to schytá, to vás ujišťuju. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:3
msgid "We have done as you asked.  Now will you join us?"
msgstr "Udělali jsme, oč jsi nás požádala. Teď se k nám připojíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:3
msgid "You have proven your worth to me.  I will join you."
msgstr "Dokázali jste mi své schopnosti. Připojím se k vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:30 assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:48
msgid "About those things you asked us to do.."
msgstr "K tomu, o co jsi nás požádala."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:31
msgid "We've already found it!"
msgstr "Už jsme to našli!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:31
msgid ""
"You have?  That is wonderful news.  Here is a small token of my appreciation."
msgstr ""
"Ano, opravdu? To jsou moc dobré zprávy. Tady je malý důkaz mého uznání. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:32
msgid ""
"So I have heard.  You have done a fine job.  Here is something for your troubles."
msgstr ""
"Už jsem to slyšela. Odvedli jste dobrou práci. Zde máte něco za způsobené potíže."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:32
msgid "The Honkies have left."
msgstr "Kejhovité jsou pryč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:34
msgid ""
"I understand.  The mountain pass is said to be a very dangerous place.  Not at all for the squeamish."
msgstr ""
"Rozumím ti. Říká se, že ten horský průsmyk je velmi nebezpečné místo. Není to nic pro citlivky. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:34
msgid "Perhaps we can find it another time."
msgstr "Snad bychom to mohli najít někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:35
msgid ""
"That is what I am told.  You have done a great service to Thronheim.  Thank you.  Here is a little reward for your efforts."
msgstr ""
"Výborně. Prokázali jste Tronheimu velkou službu. Děkuji vám. Zde je malá odměna za vaši snahu. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:35
msgid "We have found the Mountain Pass."
msgstr "Našli jsme ten horský průsmyk."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:36
msgid "We've done as you asked.  Now will you join us?"
msgstr "Udělali jsme, oč jsi nás požádala. Teď se k nám připojíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:36
msgid ""
"You have proven your worth and loyalty.  I shall be honored to join you."
msgstr ""
"Prokázali jste statečnost a oddanost. Bude mi ctí, když se k vám připojím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:37
msgid "Bjarni?  What does he want?"
msgstr "Bjarni? Co chce?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:37
msgid "We've been sent by Bjarni Thorvaldssen"
msgstr "Vyslal nás Bjarni Thorvaldssen."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:38 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:9
msgid "You are welcome."
msgstr "Není zač."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:39
msgid "Wonderful.  I shall send word to summon all the clans."
msgstr "Skvělé. Pošlu zprávu a povolám všechny klany."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:4
msgid ""
"Lately the Honkies have been getting more forceful in their attempts to convert people.  It's been causing a ruckus, and upsetting many of the Thronish.  I want you to get rid of them."
msgstr ""
"V poslední době jsou kejhovité nadmíru aktivní ve svých pokusech obracet lidi na svoji víru. Mnoho místních obyvatel je kvůli tomu velmi rozhořčeno. Chci, abys nás té sekty zbavil. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:4
msgid "What is the first task?"
msgstr "Jaký je první úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:41
msgid "What, again?  What do you need this time?"
msgstr "Už zase? Co potřebujete tentokrát?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:42
msgid ""
"As promised, here it is.  All the other Jarls are here awaiting the start of the war council.  As soon  as Bjarni and Sigmund have signed it, we shall convene for the war council"
msgstr ""
"Jak jsem slíbila, tady ji máte. Všichni ostatní vůdci zde již čekají na zahájení válečné porady. Jakmile ji Bjarni a Sigmund podepíší, měli bychom ihned začít s jednáním."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:42
msgid "We've returned for the treaty."
msgstr "Vrátili jsme se pro mírovou dohodu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:43
msgid "Do not be too distraught, friends.  Perservere, and you will succeed."
msgstr "Nebuď tak rozrušený, příteli. Pokud vytrváš, pak uspěješ."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:43
msgid "Kira, you are dead, and we are responsible for it."
msgstr "Kiro, jsi mrtvá a my jsme za to zodpovědní."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:44 assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC82.rude:6
msgid "Sorry to bother you"
msgstr "Omlouvám se za vyrušení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:5
msgid ""
"I really wish that Bjarni would just leave me alone, but I can't just tell him off!  It's a very delicate situation, and I don't want to start a war with Sturmford.  My soldiers have their hands full already."
msgstr ""
"Opravdu bych si přála, aby mě Bjarni nechal na pokoji, ale nemůžu mu to takhle otevřeně říci! Je to velmi choulostivá situace a já nechci začít válku se Sturmfordem. Moji vojáci už tak mají plné ruce práce."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:6
msgid "Name your task.  We shall prove our worth."
msgstr "Zadej nám svůj úkol. Dokážeme ti své schopnosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:6
msgid ""
"Very well.  I do have two things that I wish were done.  If you succeed in completing both of them, I will trust you to lead my soldiers."
msgstr ""
"Velmi dobře. Mám tu dvě věci, které mě momentálně nejvíce tíží. Pokud se úspěšně zhostíte obou dvou úkolů, pak vám uvěřím a můžete vést mé vojsko."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:7
msgid ""
"And you think that I will just automatically trust your leadership?  That's doubtful.  You'd have to prove your worth, first."
msgstr ""
"A vy si myslíte, že já snad bezděčně uvěřím vašim vůdcovským schopnostem? To je nepravděpodobné. Budete mi muset nejdříve dokázat své schopnosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:7
msgid "We will."
msgstr "My ji povedeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:8
msgid "A letter?  Let me see it.  Hmmm.  Ha!  He's written me a poem!"
msgstr "Dopis? Ukaž mi ho. Hmmm. Cha! Napsal mi báseň!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:8
msgid "He gave us this letter to give to you."
msgstr "Dal nám pro tebe tento dopis."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:9
msgid "He seems quite taken with you."
msgstr "Vypadá to, že je do tebe velmi zamilovaný."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC239.rude:9
msgid ""
"Yeah.   Kiss a tree?  What's wrong with him?  Looks better than his horse?  He couldn't woo a lion out of a cage with this stuff!"
msgstr ""
"Aha, ano. Co, přirovnává mě ke svojí kobyle! Tyhle nesmysly nejsou dobré ani na podpal!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:1
msgid ""
"The miners have stopped working.  If Sven Forkbeard does not get them working soon, we'll starve!"
msgstr ""
"Horníci zastavili všechny práce. Pokud je Sven Vidlobrad opět nepřiměje k nějaké činnosti, čeká nás hladomor!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:3
msgid "Perhaps we will go talk to Sven Forkbeard about it."
msgstr "Možná bychom si o tom měli promluvit se Svenem Vidlobradem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:3
msgid "What a grand idea!  I hope you are successful"
msgstr "Jak skvělá myšlenka! Doufám, že se ti to podaří."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:4
msgid "That's terrible."
msgstr "To je hrozné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:4
msgid "Yes.  I wish someone would do something about it!"
msgstr "Ano. Ráda bych, aby s tím někdo něco udělal!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:5
msgid ""
"Most of our economy is based on the exportation of magical good created by the Thjoradric Smiths, that's why!  With no Elemental Thjorad, the smiths will have nothing to make their goods with!"
msgstr ""
"Hospodářství je zde většinou založeno na vývozu magického zboží, které je dílem thjoradských kovářů, proto! Bez thjoradské rudy nebudou mít z čeho vyrábět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:7
msgid ""
"Nothing, really.  That's the stuff they pull out of the mines.  They send it to the smiths, and it becomes magic items!"
msgstr ""
"Nic, opravdu. Je to surovina, která se těží v místních dolech. Kováři z ní pak zhotovují magické předměty!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:31 assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:11
msgid "What do you know about Elemental Thjorad?"
msgstr "Co mi můžeš prozradit o thjoradské rudě?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:8
msgid "Sven has already told us to inspect the mines."
msgstr "Sven nám už nakázal, abychom to v dolech prošetřili."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC24.rude:8
msgid "Well it's about time!  Go make sure those miners get back to work!"
msgstr ""
"No, už by bylo načase! Měl bys dohlédnout na to, aby ti horníci začali zase pracovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:11
msgid "About the promotion?"
msgstr "O povýšení?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:12
msgid "Atli's on his way to Thronheim."
msgstr "Atli je na cestě do Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:12
msgid "So I've heard.  Congratulations!"
msgstr "Už jsem to zaslechl. Gratuluji!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:2
msgid ""
"Find Atli Sigmundssen in Guberland and guard his caravan until he's ready to leave."
msgstr ""
"Najdi Atli Sigmundssena v Guberlandu a ochraň jeho náklad, dokud nebude připraven odjet."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:2
msgid "What were we supposed to do again?"
msgstr "Co se od nás očekává, že budeme dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:3
msgid ""
"When I was younger, I took a trip to Framon.  Those people really worship their queen, I can tell you that!"
msgstr ""
"Když jsem byl mladší, podniknul jsem výlet do Framonu. Tamti lidé opravdu zbožňují svoji královnu, to ti fakt mohu říci!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:5
msgid ""
"Great!  There is a merchant in Guberland by the name of Atli Sigmundssen who wishes to move to Thronheim.  He's packing up, and needs someone to guard bis boat until he leaves.  To gain your promotion, find him in Guberland.  He'll tell you what to do."
msgstr ""
"Skvělé! V Guberlandu je obchodník jménem Atli Sigmundssen, který se chce přestěhovat do Tronheimu. Balí si věci a potřebuje někoho, kdo by mu pohlídal jeho loď, dokud neodjede. Pro získání povýšení ho vyhledejte v Guberlandu. Řekne vám, co máte dělat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:5
msgid "We have."
msgstr "Máme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:6
msgid ""
"I can promote any worthy Fighters you have to Mercenaries.  Do you have anyone who fits that description?"
msgstr ""
"Mohu povýšit jakékoliv schopné bojovníky, které máte ve své družině, na žoldáky. Máte někoho, kdo splňuje tyto podmínky? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:6
msgid "We'd like to know about promotions."
msgstr "Rádi bychom něco věděli o povýšení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:7
msgid "It's the nation to the west of us.  They have very strange customs."
msgstr "Je to národ na západ od nás. Mají velmi zvláštní zvyklosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:9
msgid "Perhaps you will."
msgstr "Snad budete."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC240.rude:9
msgid "We don't."
msgstr "Nemáme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:1
msgid ""
"My mentor passed on before she could teach me everything she knew.  I could have been the best midwife in years!"
msgstr ""
"Má učitelka zemřela ještě předtím, než mi mohla předat všechno, co znala. Mohla jsem být za poslední roky nejlepší porodní bábou! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:10
msgid ""
"Kira the Cold is a wonderful ruler.  She is an inspiration to women everywhere!"
msgstr ""
"Kira Chladná je nádherná panovnice. Je inspirací pro všechny ostatní ženy!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:11
msgid "Okay.  Come back when you do!"
msgstr "Dobře. Vraťte se zpátky až ho najdete!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:11
msgid "We haven't found the Black Orb yet."
msgstr "Ještě jsme nenašli Černý orb! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:12
msgid "Mad Wizard Robinsson had it?"
msgstr "A opravdu ho u sebe měl ten šílený Robinsson?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:12
msgid "We've got the Black Orb."
msgstr "Získali jsme Černý orb."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:13
msgid "Oh, alright.  Thanks anyway."
msgstr "V pořádku. Stejně díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:9
msgid "Okay!"
msgstr "Fajn!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:2
msgid ""
"Well, I'm afraid my mentor passed on before I could complete my training.  My training was nearly finished, and she said I could be the best midwife Thronheim has had in years!"
msgstr ""
"No, obávám se, že moje učitelka skonala ještě předtím, než jsem mohla dokončit svůj kurs. Už byl skoro u konce a ona mi řekla, že bych mohla být tou nejlepší porodní bábou, jakou Tronheim za ta léta měl!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:5
msgid "Why not?"
msgstr "Proč ne?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:3
msgid ""
"There are some gaps in my knowledge.  I don't want to begin working and making mistakes."
msgstr ""
"Mám mezery ve vědomostech. Nechci začít pracovat a dělat přitom chyby."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:3
msgid "What's stopping you?"
msgstr "A co ti stojí v cestě?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:4
msgid ""
"There is a device called the Black Orb of Knowledge.  All you have to do is ask it a question, and it will give you a correct answer."
msgstr ""
"Existuje takový přístroj nazvaný Černý orb vědění. Všechno, co musíte udělat, je položit mu otázku, a on vám poví správnou odpověď."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:5
msgid ""
"I think the Mad Wizard Robinssen in Yorwick has one.  If you find one and bring it to me, I will reward you well!"
msgstr ""
"Myslím, že šílený čaroděj Robinssen v Yorwicku jeden má. Pokud ho najdete a přinesete mi ho, dobře se vám odměním!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:5
msgid "Where can we find one?"
msgstr "Kde bychom něco takového mohli najít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:6
msgid "I'm afraid that I can't do that right now."
msgstr "Obávám se, že teď to nemůžu udělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:7
msgid "Oh, wonderful!  Thank you!"
msgstr "O skvělé! Díky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:7
msgid "We will find it for you."
msgstr "Najdu ti ho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:9
msgid "Not only did he have it, he invented it."
msgstr "Nejenom měl, on jej také vyrobil. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC241.rude:9
msgid ""
"Thank you so much!  You don't know what wonderful news this is!  Thank you!"
msgstr "Mockrát ti děkuji! Ani nevíš, jak skvělé zprávy to jsou! Děkuji!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:11
msgid "The Temple of Honk and I thank you.  Here is your reward.  Farewell."
msgstr "Chrám kejhovitů i já vám děkujeme. Zde je vaše odměna. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:11
msgid "We delivered the message."
msgstr "Doručili jsme ten vzkaz."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:13
msgid "Bye"
msgstr "Ahoj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:2
msgid "No.  In fact, forget that I allowed you to ask me any questions."
msgstr ""
"Ne. Opravdu zapomeň na to, že jsem ti dovolil položit mi nějaké otázky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:3
msgid "Great!  Come back when you've finished."
msgstr "Skvělé! Vrať se, až to uděláš."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:3
msgid "We can handle it.  Give us the message."
msgstr "Můžeme ho předat. Dej nám ten vzkaz."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:4
msgid ""
"It may not be as easy as you think.  If the Temple of Ratatosk discovers your intent, they will probably become hostile towards you."
msgstr ""
"To nebude tak lehké, jak si myslíte. Pokud v chrámu Ratatosku odhalí váš záměr, pravděpodobně potom k vám budou nepřátelští."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:4
msgid "Sounds easy."
msgstr "To zní jednoduše."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:12
msgid "So what's the problem?"
msgstr "A v čem je problém?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:5
msgid ""
"The problem is, the Temple of Ratatosk doesn't want the message.  They've barred me, and any member of the Temple of Honk from entering their temple.  I will pay you to go into the Temple of Ratatosk and deliver this message to them."
msgstr ""
"Problém je v tom, že členové Ratatoskova chrámu nechtějí můj vzkaz převzít. Uvěznili mě a také každého kejhovitu, který vstoupil do jejich chrámu. Zaplatím ti, pokud se do Ratatoskova chrámu vydáš a doručíš jim můj vzkaz."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:6
msgid ""
"Have you heard of the Temple of Honk?  I've been asked by them to deliver a message to the Temple of Ratatosk."
msgstr ""
"Už jste někdy slyšeli o chrámu kejhovitů? Požádali mě, abych doručil vzkaz do Ratatoskova chrámu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:6
msgid "What sort of favor?"
msgstr "Jakou službu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:7
msgid "I need someone to do me a favor."
msgstr "Potřebuju někoho, kdo by pro mě vykonal jednu službu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:10
msgid "What can we help you with?"
msgstr "S čím ti můžeme pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:8
msgid "It's an okay place."
msgstr "Je to příjemné místo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:9
msgid "Sounds too dangerous for our blood."
msgstr "To je pro nás příliš nebezpečné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC242.rude:9
msgid "Very well.  Come back when you've got a spine."
msgstr "Dobře. Vrať se, pokud by sis to rozmyslel."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:1
msgid ""
"Great!  Just remember that you have to install them in the banks, also!"
msgstr ""
"Skvělé! Hlavně nezapomeňte, že je pak musíte namontovat do všech bank v Chedianu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:1
msgid "We will find these orbs for you."
msgstr "Najdu pro tebe ty orby."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:10
msgid ""
"Well, I have this problem.  You see, the banks of all the major cities of the Chedian are linked together so that a customer of my bank can get their money in Frosgard, or Guberland, and vise versa."
msgstr ""
"Dobře, mám následující problém. Vidíš, banky všech velkých měst Chedianu jsou spolu propojené, takže zákazníci mé banky mohou získat své peníze ve Frosgardu nebo Guberlandu a zase naopak."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:11
msgid "You found them?  Wonderful!  Please, be my guest!"
msgstr "Vy jste ho našli? To je skvělé! Prosím, buďte mými hosty!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:14
msgid "Wonderfully, thanks to you!"
msgstr "Skvěle, děkuji ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:3
msgid ""
"Many of my customers have asked to be able to do the same thing with their deposit boxes.  Unfortunately, in order to do that, I would need someone to find six devices known as Orbs of Linking."
msgstr ""
"Mnoho mých zákazníků se mě ptalo, zda by bylo možno provést tuto věc s jejich úložnými schránkami. Z tohoto důvodu bych ráda našla někoho, kdo by pro mě získal šest zařízení jinak známých jako orby přenosu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:4
msgid "Sounds easy.  Where are these Orbs of Linking?"
msgstr "To zní jednoduše. Kde se nachází ty orby přenosu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:4
msgid ""
"The only place they've ever been found in Chedian is in a place known as the Inventa Storca, here in Thronheim."
msgstr ""
"Jediné místo, kde se v Chedianu dají nalézt, je místo známé jako Inventa Storca, zde v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:5
msgid "I sure wish someone could put an Orb of Linking in this bank!"
msgstr "Přála bych si získat pro svou banku orb přenosu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:7
msgid ""
"If I had an Orb of Linking, I could sell space in my bank for storage of all sorts of items, and then people could go to any bank in the land and pick them up!"
msgstr ""
"Kdybych měla orb přenosu, mohla bych pronajmout místo v mé bance pro ukládání všech druhů předmětů a pak by lidé mohli přijít do jakékoliv banky v zemi a vzít si je!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:9
msgid "Perhaps we will be able to do this later."
msgstr "Snad budu schopen to splnit později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC243.rude:9
msgid ""
"The Inventa Storca is certainly a dangerous place.  I myself am also afraid to go there."
msgstr ""
"Inventa Storca je samozřejmě nebezpečné místo. Já sama mám strach tam jít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC244.rude:2
msgid "Not too well behaved, are you?"
msgstr "Ty nejsi moc dobře vychovaná, že?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC244.rude:2
msgid "Shush!  Go away."
msgstr "Kšá! Jdi pryč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC244.rude:3
msgid "Gimme gimme!!"
msgstr "Dej dej!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC244.rude:3
msgid "We've got all the stuff you asked for."
msgstr "Máme všechno, oč jsi nás žádala. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC244.rude:4
msgid "Go away, then!!"
msgstr "Tak tedy jdi pryč!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC244.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:63
msgctxt "said by the party"
msgid "Nothing."
msgstr "Nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:2
msgid "A dying messenger."
msgstr "Měl ho u sebe umírající posel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:2
msgid ""
"What do you plan to do, then?  I'll not be wearing a rope necklace!  You'll have to kill me first!"
msgstr ""
"Co teda hodláš dělat? Chytit se nenechám! To bys mě musel nejdřív zabít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:3
msgid "Sven is going to find out about this.  We suggest leaving town."
msgstr "Sven se o tomhle dozví. Radím ti, abys opustil město. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:3
msgid ""
"The best assassins can always disappear.  I assure you, you will never see me again.  Farwell."
msgstr ""
"Nejlepší vrazi se umí vždycky vytratit. Ujišťuju vás, že už mě nikdy neuvidíte. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:4
msgid ""
"I don't really know.  Something about raising the import taxes, I think."
msgstr "Opravdu nevím. Asi něco kvůli zvýšení dovozních daní, myslím. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:4
msgid "Why did he want Sven dead?"
msgstr "Proč chce, aby byl Sven mrtev?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:5
msgid ""
"I can't tell you that!  He'll kill me!..Well, I guess so will you, won't you.  His name is Harris Willington.  He lives in Thjorgard, but I don't know exactly where."
msgstr ""
"To vám nemohu říci! On by mě zabil! No, ale řekl bych, že vy asi taky, že jo. Dobře. Jmenuje se Harris Willington. Žije v Thjorgardu, ale nevím přesně kde. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:5
msgid "Who put you up to this?"
msgstr "Kdo ti to nařídil?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:6
msgid "How?"
msgstr "Jak?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:6
msgid "I'm sure we could come to an arrangement."
msgstr "Jsem si jistý, že bychom se mohli dohodnout."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:7
msgid "How did you get that?"
msgstr "Jak jste ho získali?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:7
msgid "This letter."
msgstr "Nelži, mám u sebe tento dopis!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC95.rude:1
msgid "Then leave me alone."
msgstr "Tak mě nech odejít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:9
msgid "We're not going to allow you to murder Sven."
msgstr "Nedovolím ti zavraždit Svena."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC245.rude:9
msgid "What?  How could you know that?"
msgstr "Cože? Vůbec nevím, o čem mluvíš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:2
msgid ""
"Thankfully, no.  I do not like to receive bad news, and the news I usually receive is always bad!"
msgstr ""
"Díkybohu, ne. Nerad dostávám špatné zprávy a zprávy, které obvykle dostávám, jsou vždycky špatné! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:3
msgid ""
"Fine, let me see.  Oh!  This is terrible news!  Why did you bring this to me?  Leave at once!"
msgstr ""
"Dobře, nechte mě se podívat. Och! To jsou špatné zprávy! Proč jste mi to přinesli? Okamžitě vypadněte!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:3
msgid "We don't care if you want it.  You will take it."
msgstr "Nás nezajímá, jestli to chceš. Ty si to vezmeš."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:4
msgid "We've come to deliver this message."
msgstr "Přišli jsme doručit tento vzkaz."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:4
msgid "What message?  What makes you think I want this message?"
msgstr "Jaký vzkaz? Proč si myslíš, že ten vzkaz budu chtít? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:5
msgid ""
"I do not like them very much.  They are usually the ones who send us bad news!"
msgstr "Nemám je moc rád. Jsou to obvykle oni, kdo nám posílá špatné zprávy!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC246.rude:5
msgid "What do you know about Honkies?"
msgstr "Co víš o kejhovitech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:2
msgid ""
"I moved here from Framon a few years ago.  I am glad to be away from that place, I can tell you!  Those people there, they are getting crazy!"
msgstr ""
"Přistěhoval jsem se sem z Framonu před několika lety. A jsem rád, že jsem odtamtud pryč, to ti mohu říci! Ti lidé tam začínají být střelení! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:4
msgid "We'd like to look at your wares."
msgstr "Rádi bychom se podívali na tvoje zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:5
msgid ""
"That's where I was born.  The king and queen are right off their rockers!  I could hardly sell my swords without some government official coming in to inspect all my swords for \"violations\".  I was glad when they exiled me!"
msgstr ""
"Narodil jsem se tam. Král a královna jsou tam úplně šílení! Jen stěží jsem si tam vydělal na živobytí, protože ke mně pořád chodili vládní úředníci, kteří prozkoumávali všechny meče kvůli \"porušení zákona\". Jsem šťastný, že jsem odtud pryč! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:7
msgid "Maybe you will buy something next time."
msgstr "Možná si něco koupíš příště."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC247.rude:8
msgid "You look like you need a sword."
msgstr "Vypadáš, jako bys potřeboval meč."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:2
msgid "I was having trouble killing the Lich King.  Do you have any tips?"
msgstr "Měl jsem problémy se zabitím krále lichů. Nemáte nějaké rady?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:5
msgid ""
"Once I visited Vishi Island, but I couldn't find the Lantern.  I even visited the Golden Dragon.  I wonder what I did wrong?"
msgstr ""
"Jednou jsem navštívil ostrov Vishi, ale nemohl jsem najít Lucernu. Dokonce jsem viděl Zlatého draka. Rád bych věděl, kde jsem udělal chybu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:7
msgid "Come back when you have money!"
msgstr "Vraťte se sem až budete mít peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC248.rude:8 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:248
msgid "Do you want some armor?"
msgstr "Chcete nějakou zbroj?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:2
msgid ""
"I've been very busy lately.  I haven't been able to keep up on all the news I've been getting.  Maybe you could come back later?"
msgstr ""
"V poslední době jsem měl hodně práce. Nebyl jsem schopen zapamatovat si všechny zvěsti, které ke mně dolehly. Možná bys mohl přijít později? "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:5
msgid ""
"Have you seen the Scepter of Gaak?  I've been looking for it.  I don't think it really exists."
msgstr ""
"Neviděli jste někdy Gaakovo žezlo? Hledal jsem ho. Nemyslím si, že ta věc skutečně existuje. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:8
msgid "Thanks for your time!"
msgstr "Díky za ochotu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC249.rude:8
msgid "You're welcome!"
msgstr "Rádo se stalo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:1
msgid "The Refinery in the Thjorad Mine has shut down!"
msgstr "Rafinerie v thjoradských dolech je mimo provoz!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:2
msgid "Perhaps we will.  Goodbye"
msgstr "Snad ano. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:4
msgid ""
"I don't know!  Why don't you go talk to Sven Forkbeard and get him to do something about it?"
msgstr ""
"To nevím! Proč radši nezajdeš za Svenem Vidlobradem, aby s tím něco dělal on?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:4
msgid "Why isn't anyone doing anything about it?"
msgstr "Proč s tím nikdo nic nedělá?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:5
msgid ""
"If the Refinery isn't refining Elemental Thjorad, the Thjoradric Smiths will have nothing to work with and we'll all starve!!"
msgstr ""
"Pokud se v rafinerii nebude čistit thjoradská ruda, thjoradští kováři nebudou mít na čem pracovat a všichni budeme hladovět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:5
msgid "Why is that a problem?"
msgstr "Proč je to takový problém?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:7
msgid ""
"That's the place in the Thjorad Mine where they refine the Elemental Thjorad so that it can be used by the Thjoradric Smiths."
msgstr ""
"Je to místo, kde se v thjoradských dolech čistí thjoradská ruda, aby ji mohli kováři opracovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:5
msgid "What do you know about the refinery?"
msgstr "Co víš o té rafinerii?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:8
msgid "Bless him!  Why are you wasting your time talking to me?"
msgstr ""
"Zaplať mu to pánbůh! A proč tedy ztrácíš čas tím, že se tu se mnou vybavuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC25.rude:8
msgid "Sven Forkbeard has instructed us to inspect the Refinery."
msgstr "Sven Vidlobrad nám poručil, abychom rafinerii řádně prozkoumali."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC250.rude:1
msgid ""
"Don't tell anyone where you found this merchandise.  Sven would have us hanged if he found out."
msgstr ""
"Nikomu neříkejte, odkud jste sehnali tohle zboží. Sven by nás nechal pověsit, kdyby to zjistil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC250.rude:3
msgid "I kinow that everything here is way overpriced!!"
msgstr "Vím, že je tam všechno hrozně předražené! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC251.rude:1
msgid ""
"While I was in the marketplace buying fruit the other day, I heard someone talking about Kira the Cold and Sven Forkbeard.  What on earth could she want with Sven?  Isn't she seeing Bjarni?"
msgstr ""
"Když jsem si nedávno na tržišti kupovala ovoce, slyšela jsem někoho mluvit o Kiře Chladné a Svenu Vidlobradovi. Co by proboha mohla čekat od Svena? Cožpak nevidí Bjarniho? "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC251.rude:3
msgid ""
"It's a wonderful place to live.  I used to live in Frosgard, but things are getting real bad there.  It won't be long before everyone leaves Frosgard and comes here."
msgstr ""
"Je to pro život nádherné místo. Pokoušela jsem se žít ve Frosgardu, ale věci se tam začaly měnit k horšímu. Nebude to dlouho trvat a všichni z Frosgardu přijedou sem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC252.rude:1
msgid ""
"My grandfather used to tell me about the Mountain Pass that ran from here to Thronheim.  One day, I am going to go find it."
msgstr ""
"Můj dědeček mi vyprávěl o horském průsmyku, který vedl odtud do Tronheimu. Jednoho dne ho půjdu hledat. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC252.rude:2
msgid "We'd like some training."
msgstr "Rádi bychom si trochu zatrénovali."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC252.rude:3
msgid ""
"If you're looking for armor, Go visit Gunnar Thjorsmith.  He's get some of the best stuff around."
msgstr ""
"Pokud hledáte brnění, běžte navštívit Gunnara Thjorsmitha. Dělá ty nejlepší věci v okolí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:1
msgid ""
"I once carried stuff for Kira the Cold's sister!  Oh, it was wonderful.  She was so kind."
msgstr ""
"Jednou jsem nesl věci pro sestru Kiry Chladné! Ach, bylo to tak nádherné. Byla tak laskavá."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:2
msgid "With all the stuff we find, that's a bargain!  You're hired!"
msgstr "Vypadá to, že by ses nám mohl hodit! Jsi přijat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:3
msgid ""
"I can increase your carrying capacity by 30 things!  I charge 500 gold a month, plus 20% of all the gold you find!"
msgstr ""
"Mohu zvýšit vaši nosnou kapacitu až o 30 věcí! Beru si 500 zlatých měsíčně, plus 20% z veškerého zlata, které najdete!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:3
msgid "Sounds interesting.  What do you charge?"
msgstr "To zní zajímavě. Jaká je tvoje cena?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:4
msgid ""
"If I say so myself, I am the most useful person you can hire.  There's nothing worse than finding something really neat and not being able to carry it back!"
msgstr ""
"Když to tak řeknu, jsem ta nejužitečnější osoba, jakou si jen můžete najmout. Není nic horšího než najít něco opravdu krásného a nebýt schopen to již unést!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:4
msgid "What do you know about items?"
msgstr "Co mi můžeš říci o předmětech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:5
msgid "Sorry, we don't need your services."
msgstr "Promiň, ale my nepotřebujeme tvé služby."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC253.rude:5
msgid "Very well.  Come back when you're smarter!"
msgstr "Dobře. Vraťte se, až budete chytřejší!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC254.rude:1
msgid ""
"I've heard that there is some guy named Nicolai running around Drangheim preaching disaster and destruction.  Poor soul.  He seems to think that he's a king and that devils are going to take over the world.  I wonder what happened to him?"
msgstr ""
"Slyšela jsem, že v okolí Drangheimu pobíhá chlapík jménem Nikolaj, který zvěstuje neštěstí a zkázu. Ubohá duše. Vypadá to, že si myslí, že on je král a že démoni se chystají ovládnout celý svět. Ráda bych věděla, co se mu přihodilo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC254.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:5
msgctxt "said by the party"
msgid "Okay."
msgstr "Fajn."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC254.rude:3
msgid ""
"Some kid named Nicolai came through here a while back.  Poor guy seems to be really afraid of the devils.  I really don't know what he's talking about.  Personally, I'd be more worried about the army coming from the west."
msgstr ""
"Nedávno sem přišel chlapec jménem Nikolaj. Vypadá to, že se chudák kluk opravdu bojí démonů. Opravdu nevím, o čem to vlastně mluví. Pokud jde o mne, mnohem více by mne znepokojovalo to, že ze západu sem přichází armáda."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC254.rude:3
msgid "What do you know about disaster?"
msgstr "Co mi můžeš říct o pohromách?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC254.rude:4
msgid "Would you like a drink?"
msgstr "Nechtěl by ses napít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:2
msgid ""
"I recently got a sword from William the Framish.  Kira ordered all able bodied men to arm themselves.  I guess she's getting ready to fight the invaders."
msgstr ""
"Nedávno jsem dostal meč od Williama Framonského. Kira přikázala všem zdatným mužům, aby se vyzbrojili. Odhadoval bych, že je připravena bojovat proti útočníkům."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:5
msgid ""
"I'm not about to let the invaders take over here.  Kira's worked too hard to bring prosperity to us.  If they want to conquer someone, they'd better go to Frosgard, because they're not getting anything here!"
msgstr ""
"Nehodlám dovolit těm barbarům, aby vstoupili do města. Kira pracovala velmi těžce na tom, aby nám zajistila blahobyt. Pokud si chtějí někoho podrobit, radši by měli odtáhnout do Frosgardu, protože tady nic nedostanou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC255.rude:7
msgid "Why don't you buy something next time."
msgstr "Proč by sis nemohl koupit něco příště."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:1
msgid ""
"Kira came and visited me in person last week.  She said she may need to call upon me for my special skills soon.  I wonder why she would want that?"
msgstr ""
"Kira mě osobně navštívila minulý týden. Řekla mi, že by mě chtěla o něco brzy požádat kvůli mým speciálním dovednostem. Přemýšlím, co asi měla na mysli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:3
msgid ""
"Kira is a wonderful leader!  She actually cares about her subjects!  I hope that she marries Sven Forkbeard, and together they can give birth to a Chedian king!"
msgstr ""
"Kira je skvělý vůdce! Opravdu se stará o své poddané! Doufám, že se provdá za Svena Vidlobrada a společně pak zplodí chedianského krále!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC265.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC269.rude:3
msgid "What do you know about Kira?"
msgstr "Co víš o Kiře?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:4
msgid "Blessings upon you, friends!"
msgstr "Budu se za vás modlit, přátelé!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:6
msgid ""
"Gray Slemnir is finally retiring, eh?  I wish I could help.  Perhaps there is someone in Lindisfarne who could help."
msgstr ""
"Gray Slemnir už je konečně na odpočinku, víte? Kéž bych mohl pomoci. Snad je v Lindisfarnu někdo, kdo by vám mohl být nápomocen."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC256.rude:6
msgid "We are looking for a priest to take to Guberland."
msgstr "Hledáme kněze, který by se vydal do Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:1
msgid "And where would you like to send these \"passengers\"?"
msgstr "A kam bys rád poslal tyto \"cestující\"?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:1
msgctxt "said by the party"
msgid "Perhaps."
msgstr "Možná."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:10
msgid ""
"I'm the best sailor that ever lived!  I've traveled unscathed through storms that would have wrecked ships ten times my size!"
msgstr ""
"Jsem ten nejlepší námořník, jaký kdy žil! Proplul jsem skrze strašlivé bouře, které by úplně zničily lodě desetkrát větší, než byla ta moje!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:12
msgid "Perhaps another time."
msgstr "Snad někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:13
msgid ""
"That's just plain mean!  Those Mendossians don't deserve that!  Send all the honkies over here to the docks.  I'll take care of the rest."
msgstr ""
"To je naprosto hanebné! Tohle si ti Mendossuští nezaslouží! Pošlete mi všechny ty kejhaly sem do doků. Postarám se o zbytek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:13
msgid "We'd like to send them to Mendossus."
msgstr "Rádi bychom je poslali do Mendossusu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:14
msgid "We'd like to ask you a favor."
msgstr "Chtěli bychom tě požádat o laskavost."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:11
msgid "What's that?"
msgstr "O co jde?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:17
msgid "How'd that Honky thing work out?"
msgstr "Jak se vyřešila ta věc s kejhovity?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:15
msgid ""
"They never knew what hit them!  They're well on their way to Beldonia.  I don't envy those Beldonians, that's for sure!"
msgstr ""
"Nikdy se nedozvědí, kdo je potrestal! Jsou zdraví na své cestě do Beldonie. Nezávidím těm Beldonianským, to je teda jistý!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:16
msgid ""
"They never knew what hit them!  They're well on their way back to Guberland where they belong!"
msgstr ""
"Nikdy se nedozvědí, kdo je potrestal! Jsou na cestě zpátky do Guberlandu, tam kam patří!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:17
msgid ""
"They never knew what hit them!  They're well on their way to Mendossus.  That Mendossian king sure is going to hate us for that!  Heh, heh.  He might even declare war on us!"
msgstr ""
"Nikdy se nedozvědí, kdo je potrestal! Jsou na cestě do Mendossusu. Ten mendossuský král nás za tohle bude určitě nenávidět! He, he. Dokonce by nám mohl vyhlásit válku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:3
msgid ""
"I got caught in a storm crossing the Verhoffin Sea recently.  I lost half my cargo!"
msgstr ""
" Když jsem nedávno křižoval Verhoffinovým mořem, zastihla mě obrovská bouře. Ztratil jsem polovinu svého nákladu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:4
msgid "Interested in leaving?"
msgstr "Mohl bys nás přepravit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:4
msgid "Yes."
msgstr "Ano."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:5
msgid ""
"Is that so?  And might these people worship a certain temple devoted to geese?"
msgstr "Opravdu? A uctívají tito lidé jistý chrám zasvěcený huse?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:5
msgid "We need to send some people away."
msgstr "Potřebujeme poslat nějaké lidi pryč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:7
msgid ""
"If what I've heard about the army marching towards us is true, those Beldonians deserve it!  Just send them over here to the docks.  I'll take care of the rest."
msgstr ""
"Pokud je to, co jsem zaslechl o blížící se armádě, pravda, tak si to ti Beldonští zaslouží! Pošli je sem do doků. Postarám se o zbytek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:7
msgid "We'd like to send them to Beldonia."
msgstr "Rádi bychom je poslali do Beldonie."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:8
msgid "Trust me.  You're doing us ALL a favor.  Farewell."
msgstr "Věř mi. Prokazuješ nám VŠEM velkou laskavost. Sbohem. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:9
msgid ""
"A fitting destination if any.  Just send them all over here to the docks.  I'll take care of the rest."
msgstr "Tomu říkám správný cíl. Pošli je sem do doků. Postarám se o zbytek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC257.rude:9
msgid "We'd like to send them back to Guberland."
msgstr "Rádi bychom je poslali zpátky do Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:10
msgid ""
"Kira has been very nervous lately.  I wonder if it has anything to do with Bjarni.  He's quite taken with her, I hear."
msgstr ""
"Kira byla v poslední době velmi roztržitá. Rád bych věděl, jestli to má něco společného s Bjarnim. Slyšel jsem, že je do ní úplný blázen."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:19
msgid ""
"You can find the armor shop on the northern wall in the southern section of town."
msgstr "Obchod s brněním můžete najít u severní zdi v jižní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:21
msgid ""
"The tavern is along the southern wall in the northern section of town, near the guard's barracks."
msgstr ""
"Hospoda se nachází podél jižní zdi v severní časti města, blízko ubytoven stráží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:22
msgid ""
"He's the Jarl of Sturmford.  He's been trying to woo Kira the Cold for years.  I wonder why he hasn't gotten the hint yet?"
msgstr ""
"Je to sturmfordský jarl. Uchází se o Kiru Chladnou již celá léta. Divím se, proč stále ještě nedostal příležitost."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:22 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:34
msgid "What do you know about Bjarni?"
msgstr "Co mi můžeš říct o Bjarnim?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:26
msgid ""
"The magic shop is near the eastern gate.  Just take the alley behind this building."
msgstr "Obchod s magií je blízko východní brány. Jdi do uličky za budovami."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:27
msgid "No.  Why do you ask?"
msgstr "Ne. Proč se ptáš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:28
msgid "The temple is in northwestern part of the western section of town."
msgstr "Chrám najdete v severozápadě západní části města. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:3
msgid ""
"You can find the weapon shop in the southeast corner of the middle section of town."
msgstr "Obchod se zbraněmi nalezneš v jihovýchodním rohu střední části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:32
msgid "The apothecary is in the middle of the northern section of town."
msgstr "Lékárna se nachází uprostřed severní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:34
msgid ""
"The training hall is along the southern wall of the southern section of town."
msgstr "Tréninkovou halu najdete podél jižní zdi v jižní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:43
msgid "The library is in the northeast corner of the middle section of town."
msgstr "Knihovna se nachází v severovýchodním rohu střední části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:45 assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:6
msgid "No problem."
msgstr "To nebyl problém."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:6
msgid ""
"Kira the Cold lives in the castle in the southeasterly section of town."
msgstr "Kira Chladná žije na zámku v jihovýchodní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC258.rude:8
msgid ""
"You can find the bank on the northern wall in the northern section of town."
msgstr "Banku můžete najít u severní zdi v severní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC259.rude:2
msgid ""
"One day when I'm braver, I will go into the Inventa Storca.  The books that are in there must be unbelievably fabulous!"
msgstr ""
"Jednoho dne, až budu silnější, se vydám do míst zvaných Inventa Storca. Knihy, které tam jsou, musí být neuvěřitelně skvostné!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC259.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC259.rude:4
msgid "We'd like to see your books."
msgstr "Zajímaly by nás tvé knihy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC259.rude:5
msgid ""
"That's my favorite subject!  I've found some text that date back to before the Great Cataclysm!  I just wish I could find some from before.  I'm sure they exist!  I can feel it in my bones!  They are out there!!"
msgstr ""
"To je mé oblíbené téma! Našel jsem nějaké texty, které byly napsány ještě před Velkou pohromou! Přál bych si vlastnit ještě starší svitky. Jsem si jist, že existují! Cítím to v kostech! Někde tam jsou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC259.rude:5
msgid "What do you know about ancient texts?"
msgstr "Co víš o prastarých textech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:8
msgctxt "said by the party"
msgid "Good luck."
msgstr "Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:3
msgid "Hmm, that's not a bad idea.  Maybe I will do that."
msgstr "Hmm, to není špatný nápad. Možná to udělám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:3
msgid "Why don't you go work at the East Mine, then?"
msgstr "Proč tedy nejdeš pracovat do Východního dolu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:4
msgid "Maybe you should have a look before you go preaching!"
msgstr ""
"Možná by ses měl rozhlídnout kolem sebe, než mi tu začneš dělat kázání!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:4
msgid "You don't care if the people here starve?"
msgstr "Tobě nevadí, že zdejší lid hladoví?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:5
msgid "But people are depending on the Elemental Thjorad!"
msgstr "Ale lidé tu jsou na thjoradské rudě závislí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:5
msgid ""
"They can depend on it all they want!  I'm not going risking my neck for a few greedy merchants!"
msgstr ""
"Můžou si záviset, na čem chtějí! Nemíním riskovat krk pro pár hamižnejch obchodníků!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:6
msgid ""
"The conditions are horrible!  In the Thjorad Mine there's certainly going to be a cave-in!  The workers are right to stop working!"
msgstr ""
"Podmínky jsou přímo strašlivé! V thjoradském dole to vypadá na zával! Dělníci mají pravdu, když zastavili všechny práce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:7
msgid ""
"I don't know what they East Miners have to complain about, their necks aren't on the line!"
msgstr ""
"Nemám ponětí, na co si havíři z Východního dolu stěžují - jejich krky nejsou v sázce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:7
msgid "What about the East Mine?"
msgstr "A co je s Východním dolem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC26.rude:8
msgid "Sorry, goodbye."
msgstr "Promiň, sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC260.rude:1
msgid ""
"I competed in a strength competition at The Thing last year.  I won it by pulling a cart full of rocks!"
msgstr ""
"Loni jsem se zúčastnil soutěže v síle. Vyhrál jsem, podařilo se mi utáhnout káru plnou kamení!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC260.rude:3
msgid ""
"Get as strong as you possibly can.  There's nothing more humiliating than watching a weakling swing a sword!"
msgstr ""
"Musíte být co nejsilnější. Není nic horšího než sledovat slabocha, jak se snaží máchat kolem sebe mečem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:9
msgid "Carry on the fight, brother!"
msgstr "Pokračuj v boji, bratře!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:1
msgid "Well, good luck."
msgstr "No tak hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:2
msgid ""
"Stop the rich few from using the backs of the working class to make themselves rich!  We should be making ourselves rich!  Down with the oppressors!  Down, down, down!!"
msgstr ""
"Zastavit několik bohatých, kteří využívají těžkou robotu pracujících k vlastnímu obohacení! Měli bychom pracovat na své vlastní bohatství! Svrhnout utiskovatele! Svrhnout, svrhnout!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:2
msgid "Stop what?"
msgstr "Zastavit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:3
msgid ""
"Do you realize that a very few rich people own almost every bit of wealth here?  They own the stores, the lands, they have all the money!  And they use this power to control the people!  It's time to stop I say!"
msgstr ""
"Uvědomuješ si, že velmi bohatí lidé vlastní téměř každý kousek půdy tady kolem? Vlastní obchody, zemi, mají všechny peníze! A používají tuto moc na ovládání lidí! A já říkám, je čas je zastavit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:3
msgctxt "said by the party"
msgid "What are you talking about?"
msgstr "O čem to mluvíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:4
msgid ""
"I am on a crusade to stop the oppressive controlling governments!  It is time the people rose up and joined together to run this nation!"
msgstr ""
"Organizuju hnutí, které zastaví utiskovatelskou vládu! Je na čase, aby lid povstal, spojil se a sám vládl tomuto národu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:5
msgid "Those who have bound you blindly in your servitude!"
msgstr "Těm, kterým slepě sloužíš!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:5
msgid "What oppressors?"
msgstr "Jakým utlačovatelům?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:6
msgid ""
"I am the founder of the Chedian Liberation Party!  We only have two members, but we are growing!  And one day the CLP will be the ones in charge of Chedian!"
msgstr ""
"Jsem zakladatelem Strany za osvobození Chedianu. Máme zatím jenom dva členy, ale rosteme. A jednoho dne bude SOC vládnout Chedianu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC261.rude:6
msgid "What do you know about oppression?"
msgstr "Co ty víš o utiskování?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC262.rude:1
msgid ""
"I've heard Kira the Cold wants someone to reopen the mountain pass.  It's about time, I say!  She'll make us rich one day, I tell you!"
msgstr ""
"Kira Chladná prý chce, aby někdo zprůchodnil horský průsmyk. Už je na čase! Říkám ti, díky ní budeme jednou bohatí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC262.rude:3
msgid ""
"It was built hundreds of years ago by the rulers of Thjorgard and Thronheim while they enjoyed a brief time of peace."
msgstr ""
"Před stovkami let ho postavili vládci Thjorgardu a Thronheimu během krátké doby, kdy spolu oba národy žily v míru."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC262.rude:3
msgid "What do you know about the Mountain Pass?"
msgstr "Víš něco o horském průsmyku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC263.rude:1
msgid ""
"If Kira manages to reopen the mountain pass, it's death for us all!  Who knows what sort of monsters lay on the other side!  Does it really go to Thjorgard?  Is Thjorgard really a place?  I bet it doesn't even exist!"
msgstr ""
"Pokud se Kiře podaří otevřít průsmyk v horách, znamená to smrt pro nás všechny! Kdo ví, jaké příšery čekají na druhé straně?! Vede ten průchod vůbec do Thjorgardu? Existuje vůbec Thjorgard? Ne, já se vsadím, že takové místo vůbec není!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC263.rude:3
msgid ""
"Don't go anywhere!  How do we really know that those other places exist?  What if they don't?  What if the Verhoffin Sea is just a glass of water for a giant?  He'd drink us all to oblivion!"
msgstr ""
"Nikam nechoď! Jak si můžeme být jistí, že ostatní místa vůbec existují? Co když ne? Co když je Verhoffinovo moře jenom sklenicí vody pro giganta? Vypije nás a to bude náš konec!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC264.rude:2
msgid ""
"It's high time Kira the Cold got married.  She's single, you know!  She needs to provide Thronheim with an heir!  She may lead us to greatness, but without a successor, we'll be lost!  I've heard that Bjarni is a nice fellow!"
msgstr ""
"Už je načase, aby se Kira Chladná vdala. Je svobodná, víte?! Musí Thronheimu dát dědice! Možná nás vede k velikosti a zářným zítřkům, ale bez následníka bude vše ztraceno. A Bjarni je prý fajn chlap!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC264.rude:4
msgid "Bjarni is their ruler.  I think he would be a fine match for Kira!"
msgstr "Bjarni je jejich vůdce. Myslím, že by to byla pro Kiru skvělá partie!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC264.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:5
msgid "What do you know about Sturmford?"
msgstr "Co víš o Sturmfordu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC265.rude:1
msgid ""
"Any man who wants to stay that way would be crazy to marry Kira!  Why, the minute he put his back to her, she would tear him to bits!  Crazy, I tell you!"
msgstr ""
"Každý chlap, který chce zůstat při rozumu, by si měl dvakrát rozmyslet svatbu s Kirou. Ve chvíli, kdy si nedá pozor, ho ta saň roztrhá na kusy. Je šílená, to ti povídám!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC265.rude:3
msgid ""
"I don't know how she's going to find a husband.  No Jarl in their right mind would give in to her, and everyone else is beneath her station.  There's going to be quite the trouble when she dies, that's for sure!"
msgstr ""
"Nevím, jestli si někdy najde manžela. Žádný jarl, kterému zbývá trocha soudnosti, si ji nevezme a kdokoli jiný je pod její úroveň. Až zemře, bude tady spousta problémů, to mi věř!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC266.rude:1
msgid ""
"That Knut is out of his mind!  Without the ruling class, this world would fall into anarchy!  The people just aren't smart or responsible enough to handle their own freedom!  If we controlled our own lives, all that would happen is starvation and death!"
msgstr ""
"Ten Knut zešílel! Bez vládnoucí třídy svět ovládne anarchie! Lidé nejsou dost chytří ani zodpovědní, aby se mohli starat sami o sebe a být svobodní! Pokud se budeme všichni řídit jenom sami podle sebe, budeme hladovět a zemřeme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC266.rude:3
msgid ""
"I think the Jarls are doing just fine, thank you!  They've all been educated, and have learned how to rule!  Besides that, they're just naturally smarter than the rest of us."
msgstr ""
"Myslím, že jarlové dělají, co se dá! Všichni jsou odmalička vychováváni pro vládu a naučili se, jak stát řídit! Kromě toho jsou od přírody chytřejší než my ostatní..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC266.rude:3
msgid "What do you know about politics?"
msgstr "Co víš o politice?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:1
msgid ""
"Those miners better get back to work!  Why I haven't seen cowardice like that since Markel the Great was made Jarl of Guberland!"
msgstr ""
"Ti horníci by měli radši rychle zase začít makat! Takovou zbabělost jsem neviděla od dob, co z Markela udělali jarla Guberlandu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC267.rude:5
msgid ""
"It's a good time, if you are brave enough.  If you're careful enough, it can also be profitable."
msgstr ""
"Je na to vhodná doba, pokud máte dost odvahy. A budete-li dost opatrní, tak to může přinést slušný zisk."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC268.rude:1
msgid ""
"I heard from a friend that Sven Forkbeard sent a shipment of swords to Kira.  I wonder if he's trying to win her heart?  What a romantic gesture that is!"
msgstr ""
"Slyšela jsem od přítele, že Sven Vidlobrad poslal Kiře náklad mečů. Zajímalo by mě, jestli se tak pokouší získat její srdce? To je tedy romantické gesto!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC268.rude:3
msgid ""
"I think that Kira should marry Sven.  Not only is he better looking than Bjarni, but he's also in charge of Thjorgard.  What a great noble family that would make!"
msgstr ""
"Myslím, že by si Kira měla vzít Svena. Kromě toho, že vypadá lépe než Bjarni, navíc také velí Thjorgardu. No nedali by dohromady skvělý šlechtický páreček?!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC268.rude:3
msgid "What do you know about romance?"
msgstr "Co víš o romantice?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC268.rude:5
msgid ""
"If I could have my way, I would tie them up, and put them on a ship bound anywhere but here!  I bet I would get away with it, too!  Moenach the Dockmaster dislikes them as much as anyone!"
msgstr ""
"Kdyby bylo po mém, tak bych je dala svázat a strčit na loď plovoucí hodně daleko! A vsadím se, že by mi to prošlo! Správce doků Moenach je nesnáší stejně jako všichni ostatní!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC268.rude:5
msgid "What do you know about the Honkies?"
msgstr "Co víš o kejhovitech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC269.rude:1
msgid ""
"Poor Bjarni.  I think he's really in love with Kira, and she really doesn't want anything to do with him.  A few months ago he came to visit, and she treated him like the greatest person on earth.  No wonder he's infatuated with her."
msgstr ""
"Chudák Bjarni. Myslím, že je do Kiry opravdu zamilovaný, a ona s ním ve skutečnosti nechce nic mít. Před pár měsíci ji navštívil a ona se k němu chovala, jako by byl ta nejúžasnější bytost pod sluncem. Nedivím se, že se do ní zbláznil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC269.rude:3
msgid ""
"I wish she would make up her mind and settle down with a husband!  It's shameful that she's unmarried at her age!  She claims to be too busy running Thronheim, but I don't think that's it at all!"
msgstr ""
"Přála bych si, aby se konečně rozmyslela, našla si manžela a usadila se! Je to ostuda, že je ve svém věku ještě svobodná! Tvrdí, že na to nemá čas, že má moc práce s řízením Thronheimu, ale já si myslím, že to není všechno!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC269.rude:5
msgid ""
"I hate them!  I wish someone would send them away!  In fact, I bet that the Dockmaster would take them anywhere in the world but here.  All he'd need is for someone to convince them to go to the docks!"
msgstr ""
"Nenávidím je! Přeju si, aby je někdo poslal pryč! Vlastně bych se vsadila, že by je správce doků nechal odvézt kamkoli, jenom aby odtud zmizeli. Jenomže je musí někdo přesvědčit, aby šli do doků!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC269.rude:5
msgid "What do you think of the Honkies?"
msgstr "Co si myslíš o kejhovitech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:10
msgid "I'm sorry about your plight.  Goodbye."
msgstr "Je mi líto, že jste na tom tak bídně. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:2
msgid "Aright then.  Goodbye"
msgstr "Tak tedy dobrá. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:3
msgid ""
"And maybe Sven will admit to taking bribe money to release his prisoners!  I don't think you'll understand until you've been in the mines."
msgstr ""
"A možná Sven přijme nějaký úplatek, aby propustil vězně! Nemyslím si, že to pochopíš, dokud se nepodíváš do dolů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:3
msgid "Maybe someday an ex-miner will become a Jarl."
msgstr "Jednoho dne se možná jarlem stane bývalý horník."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:4
msgid "I'm sure Sven cares about you men."
msgstr "Jsem si jistý, že Svenovi na vás záleží."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:4
msgid ""
"You can be sure all you want.  But I know the truth.  Jarls never care about the miners.  We're just a resource for them to manage!  Maybe we should get them into the mines for a day."
msgstr ""
"Můžete si být jistí, jak chcete, ale já znám pravdu. Jarlové se nikdy o horníky nestarali. Jsme pro ně jenom prostředky, s jejichž pomocí něco získávají! Možná bychom je měli aspoň na jeden den poslat do dolů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:5
msgid ""
"He just wants his ore to get to the refinery.  He doesn't care how many miner's lives are taken in the process."
msgstr ""
"Touží jenom po tom, aby se ruda dostala do rafinerie. Nezajímá ho, kolik hornických životů to bude stát."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:5
msgid "Why wouldn't Sven pay for it?"
msgstr "Proč by za to měl Sven platit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:6
msgid ""
"Now there is a fine idea!  Maybe Sven Forkbeard would even pay for it!  HA!"
msgstr ""
"To zní jako dobrý nápad! Sven Vidlobrad za to možná dokonce zaplatí! Ha!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:6
msgid "Why don't you have the Thjoradric Smiths make you something?"
msgstr "Proč nepoprosíte thjoradské kováře, aby vám něco takového vyrobili?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:7
msgid ""
"That's just the problem!  We don't just need new tools, we need new kinds of tools.  Something that will blow that rock to smithereens!"
msgstr ""
"To je právě ten problém! Nepotřebujeme jen nové nástroje, potřebujeme nějaké nové udělátko! Něco, co rozbije ten kámen napadrť!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:7
msgid "Why don't you get some new tools?"
msgstr "Proč si neopatříte nějaké nové nástroje?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:8
msgid "The picks and shovels we have just won't cut through that new rock!"
msgstr "S krumpáči a lopatami se přes ten kámen nedostaneme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC322.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:9
msgid "What do you mean?"
msgstr "Co tím myslíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:9
msgid "Have you joined the United Group of Thjoradric Miners?"
msgstr "Přidal ses ke Svazu thjoradských horníků?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC27.rude:9
msgid ""
"No!  Those people are gonna spell nothing but trouble for us honest miners!  You're with them, aren't you!  I'm not saying another word!"
msgstr ""
"Ne! Ty lidi nejsou pro poctivý horníky nic než problém! A vy jste s nimi, že jo! Neřeknu vám ani slovo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC270.rude:1
msgid ""
"The Honkies have been around here for weeks!  I wish Kira would do something about them!"
msgstr ""
"Kejháci už tady straší několik týdnů! Přál bych si, aby s nimi Kira něco udělala!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC270.rude:3
msgid ""
"Their worshippers have been coming around here lately.  They've been trying to get donations from us to build a church.  If they manage to get one built, I can guarantee it'll be burned down its first night open!"
msgstr ""
"Ti náboženští šílenci nás v poslední době hodně obtěžují. Snaží se získat dost milodarů, aby si tady mohli postavit chrám. Pokud se jim to podaří, vsadím se, že ho někdo vypálí hned první noc po dokončení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:2
msgid "Oh!  Alright then.  I shall see you at the docks."
msgstr "Aha! Dobrá tedy. Setkáme se v docích."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:2
msgid "Some friends of ours also want to hear."
msgstr "Někteří moji přátelé by si to určitě také rádi poslechli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:3
msgid "Great! Why don't you meet us at the docks?"
msgstr "Skvělé! Takže se setkáme v docích?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:3
msgid "The docks?  Why can't you listen now?"
msgstr "Doky? A proč nemůžete poslouchat hned teď a tady?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:4
msgid "The Temple of Honk is the true path to rebirth!"
msgstr "Uctívání Velkého Kejhovy je tou pravou cestou ke znovuzrození!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:6
msgid "We'd like you to tell us about the Great Honk."
msgstr "Chtěli bychom se dozvědět něco o Velkém Kejhovitovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:6
msgid "Wonderful!  I can weave hours of enlightenment on that subject!"
msgstr "Skvělé! Na toto povznášející téma mohu hovořit hodiny a hodiny!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:7
msgid ""
"There is no greater adventure than the path of the Great Honk!  Praise the Great Honk!  Praise Philacte Canagica!"
msgstr ""
"Není žádné větší dobrodružství než sledování cesty Velkého Kejhovity! Veleb Velkého Kejhovitu! Veleb Philacta Canagica!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC271.rude:8
msgid "May the Great Honk bless you!."
msgstr "Ať ti žehná Velký Kejhovita!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:2
msgid "The glory of Honk be praised to you for enlightening these souls!"
msgstr "Ať ti žehná sám Velký Kejhovita za to, že budou tyto duše osvíceny!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:3
msgid ""
"Ah, glorious hard labor.  I shall be happy to meet them there and breathe ease into their difficult lives."
msgstr ""
"Ach, mocná dělnická třída. Velice rád se tam s nimi setkám a trochu jim svou duševní podporou ulehčím jejich těžký život."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:3
msgid "They work on the docks."
msgstr "Pracují v docích."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:4
msgid "Our friends also would like to hear."
msgstr "Moji přátelé by si to také rádi poslechli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:4
msgid "That is wonderful news indeed.  Where, pray tell are these friends?"
msgstr ""
"To jsou vskutku skvělé zprávy. A můžete mi prosím říct, kde jsou vaši přátelé?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:5
msgid ""
"I eagerly await the day I am reborn as a goose!  Did you know our prophet Philacte Canagica was reborn?  Praise the Great Honk!"
msgstr ""
"Nemohu se dočkat dne, kdy se znovuzrodím jako husa! Víte, že byl náš prorok Philacte Canagica znovuzrozen? Velebte Velkého Kejhovu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:6
msgid "Should Honk wish it."
msgstr "Pokud si to tak bude přát Kejhova..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:7
msgid ""
"If you please, we prefer to call ourselves Honkers!  I shall be happy to enlighten you."
msgstr ""
"Pokud ti to nebude vadit, my dáváme přednost názvu kejhovité! Bude mi potěšením, pokud ti budu moci osvětlit cokoli, co se týká naší víry."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:7
msgid "We want to know more about the Honkies."
msgstr "Chtěli bychom se dozvědět něco víc o kejhácích."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC272.rude:8
msgid ""
"We are here to raise the awareness of the Temple of Honk, and should Honk wish it, build a temple to him here."
msgstr ""
"Jsme tady, abychom vzbudili v obyvatelstvu zájem o víru kejhovitů a pokud si tak Velký Kejhova bude přát, vystavíme mu zde chrám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:3
msgid "If you possess the skill, I shall help you."
msgstr "Pokud na to máte dostatečné schopnosti, rád vám pomohu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:2
msgid ""
"I overheard the dockmaster complaining about the Honkies recently.  He said he wished he could conscript them to serve on one of the ships.  He said that would teach them some manners!"
msgstr ""
"Nedávno jsem zaslechl, jak si šéf doků stěžuje na kejhovity. Říkal, že by je strašně rád naverboval na jednu z lodí, že to by je naučilo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:4
msgid "The elements surround us.  It is through their study we gain power."
msgstr "Živly nás obklopují. To skrze jejich studium získáváme moc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC273.rude:5
msgid "Seek Gudlaug Eitrissen in Lindisfarne."
msgstr "Vyhledej Gudlauga Eitrissena v Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:3
msgid "If you have the skills."
msgstr "Pokud na to máte schopnosti..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:2
msgid ""
"Seek the light friend.  It is through its study we gain self-sovereignty."
msgstr "Následuj světlo. To skrze jeho studium získáváme samostatnost."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC274.rude:4
msgid "Study hard.  An uneducated adventurer is a dead one."
msgstr ""
"Tvrdě studuj. Nevzdělaný dobrodruh je mrtvý dobrodruh. Nebo brzy bude."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:3
msgid "Are you skillful enough?"
msgstr "Máte na to dost zkušeností?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:2
msgid "Not that I shall share."
msgstr "O ničem, o čem bych se s vámi chtěla bavit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC275.rude:4
msgid "Dark is the way to power.  The only way to power."
msgstr "Temnota je moc. Je to jediná správná cesta k moci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:3
msgid "Do you have the skills?"
msgstr "Máte na to dost schopností?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:2
msgid ""
"I was in meditation, and I had a vision.  Two swords, touched each other, and then there was destruction.  I wonder what it means?"
msgstr ""
"Meditoval jsem a měl jsem vizi. Dva meče se vzájemně dotkly a pak nastalo ničení. Zajímalo by mě, co to znamenalo?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:3
msgid "We'd like to become Masters in Spirit Magic."
msgstr "Chtěli bychom se stát mistry v magii ducha."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC276.rude:4
msgid ""
"Look for the spirit within.  For life may be varied and adventurous, but the true adventure is the journey of the spirit."
msgstr ""
"Hledej ducha uvnitř sebe. Život může být zábavný a dobrodružný, ale pravým dobrodružstvím je cesta ducha."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:3
msgid "Perhaps if you have the skills, you shall find what you seek."
msgstr "Pokud máte schopnosti, možná jste našli to, co hledáte."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:2
msgid "Stay the course friends.  You will attain your destiny."
msgstr "Drž se své cesty, příteli. Dosáhneš svého osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC277.rude:4
msgid ""
"Adventuring is a hollow activity.  It is both dangerous and foolhardy.  One cannot attain enlightenment while on the hard road.  If you are adventuring, I suggest you quit."
msgstr ""
"Život dobrodruha je tak prázdný. Je jak nebezpečný, tak hloupý. Při cestování nelze dosáhnout osvícení. Pokud jste na dobrodružné výpravě, doporučuji vám, nechte toho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:1
msgid "Goodbye!  Good luck!"
msgstr "Na shledanou! Hodně štěstí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:1
msgid "We shall.  Farewell."
msgstr "Uděláme to tak. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:2
msgid "Which way were they headed?"
msgstr "Kam přesně směřovali"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:2
msgid ""
"Your man Forad said they were probably going to meet the army in Yorwick.  You must hurry!!  Take the Connecting Tunnels west of here.  It's dangerous, but it's the fastest way to Yorwick!"
msgstr ""
"Forad řekl, že se pravděpodobně setkají s armádou v Yorwicku. Musíte si pospíšit!! Jděte spojovacím tunelem západně odtud. Je to nebezpečné, ale je to nejrychlejší cesta do Yorwicku!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:3
msgid ""
"Gone milords?  Why your man Forad claimed to know where the Beldonian army was camped!  He led them out of here days ago!  You must hurry if you are to catch them before the battle!"
msgstr ""
"Odešli. Váš muž Forad tvrdil, že zná místo, kde táboří beldonská armáda! Odvedl je tam před několika dny! Musíte si pospíšit, pokud je chcete dostihnout ještě před bitvou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:3
msgid "Where have they gone?"
msgstr "Kde jsou všichni?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:4
msgid ""
"Only the words on the street, milords.  There is an army marching towards us.  We will be prepared to meet them, I assure you."
msgstr ""
"Pouze to, co se povídá na ulicích. Táhne na nás armáda. Ale ujišťuji vás, budeme na ně připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC278.rude:5
msgid ""
"They are large in numbers.  But we are prepared.  They shall not sneak up upon us like they did to Framon."
msgstr ""
"Je jich mnoho, ale my jsme připraveni. Ti bastardi se k nám nepřiplíží, jako to udělali ve Framonu. Největší problém bude najít místo, kam pohřbíme všechny jejich mrtvoly."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:2
msgid "May Honk bless your souls for your kindness, friends!"
msgstr "Ať Kejhovita požehná vašim duším za vaši úžasnou dobrotu, přátelé!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:3
msgid ""
"Glory be to Honk!  I shall be on my way immediately to those poor souls.  Fear not, they shall soon be saved!"
msgstr ""
"Sláva Kejhovitovi! Okamžitě zamířím za těmi ubohými dušemi. Neboj se, budou spaseni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:3
msgid "We have friends at the docks who would like to hear about you."
msgstr "V docích jsou moji přátelé, kteří by si to také rádi vyslechli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:4
msgid "Sorry.  I don't have time for that,"
msgstr "Je mi líto, na to nemám čas."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:5
msgid "Thanks for the answer.  A donation to what?"
msgstr "Díky za odpověď. Na co má být ten dar?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:5
msgid ""
"To erect a temple to our glorious master!  Only through the glory of Honk will we be reborn!  That is what our Prophet says.  We shall praise the glory of Honk and be reborn."
msgstr ""
"Na stavbu chrámu našeho úžasného mistra! Pouze skrze slávu Kejhovitovu budeme znovuzrozeni! To říká náš prorok. Budeme velebit slávu Kejhovity a budeme znovuzrozeni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:6
msgid "Why are you here?"
msgstr "Proč jsi tady?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:6
msgid "Would you care to make a donation?"
msgstr "Nechceš dát milodar?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC279.rude:7
msgid ""
"My help?  May the Great Honk be praised!  I shall be honored to offer my assistance."
msgstr ""
"Mou pomoc? Ať je veleben Velký Kejhovita! Je mi ctí, že ti mohu nabídnout svou pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:2
msgid ""
"Of course!  I'm through with letting the linemen walk all over my brothers!  Down with the linemen!"
msgstr "Samozřejmě! Už jsem se na to bezpráví nemohl déle dívat! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:2
msgid "You're a member too?"
msgstr "Ty jsi také členem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:3
msgid "Alright.  Goodbye"
msgstr "Dobře. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:4
msgid ""
"He took me on a long walk, and showed me the door.  Can you believe that?  He fired me!  Now leave me alone.  I want to forget the rest of this day."
msgstr ""
"Doprovodil mě k východu a ukázal mi dveře. Věřil bys tomu? Vyrazil mě! Teď mě nech o samotě. Chci na to pro zbytek dne zapomenout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:11
msgid "What happened?"
msgstr "Co se stalo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:5
msgid ""
"I did!  That's why I'm here.  I went to the foreman and demanded to know why they fired our repair staff!"
msgstr ""
"To jsem udělal! Proto jsem taky tady. Zašel jsem za předákem a chtěl vědět, proč vyhodil všechny naše opraváře!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:5
msgid "Why don't you do something about it?"
msgstr "Proč s tím tedy něco neuděláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:6
msgid "It broke, didn't it?"
msgstr "Rozbilo se to, že ano?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:6
msgid ""
"Yes, and in a big way!  And now there's no one who remembers how to fix it.  How they expect us to work so understaffed is beyond me!  They just care about their profits."
msgstr ""
"Ano, a pořádně! A není tu nikdo, kdo by si pamatoval, jak to spravit. Jak si představují, že teď budeme pracovat, to teda netuším! Starají se jenom o svoje zisky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:7
msgid ""
"They fired Hjarrand Fixer just because they thought the refiner would never break!"
msgstr ""
"Hjarranda Opraváře vykopli prostě proto, že si mysleli, že se rafinér nemůže nikdy porouchat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:8
msgid ""
"I can't.  I'm on strike!  The UGTM won't let me work until my brothers-in-arms are unoppressed!"
msgstr ""
"Nemůžu. Stávkuju! STH mi nedovolí pracovat, dokud budou moji bratři utlačováni!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC28.rude:8
msgid "Why don't you do something?"
msgstr "Proč nic neděláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC280.rude:1
msgid ""
"I think reopening the Mountain Pass would be great for business!  I plan to go look for it as soon as I have enough money for supplies."
msgstr ""
"Myslím, že znovuotevření horského průsmyku bude pro obchod skvělé! Plánuju se tam zajít podívat, jakmile budu mít dost peněz na nákup zásob."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC280.rude:3
msgid ""
"I think we could be as powerful as Thjorgard.  Kira the Cold is a great start, too!  She's smart enough, and strong enough, and she has the support of the people."
msgstr ""
"Myslím, že by mohl být stejně silný jako Thjorgard. Kira Chladná je skvělý vůdce! Je dost chytrá a silná a také má podporu lidu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:10
msgid "You will be sorry about that, for certain!"
msgstr "Budete toho litovat, to je jisté!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:2
msgid "Sounds good.  You're hired!"
msgstr "To zní dobře. Jsi najat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:2
msgid "You shall not regret it."
msgstr "Nebudeš litovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:3
msgid ""
"I am an Illuminate.  For the price of 1000 gold per month and 20% of all gold we find, I will travel with you, identify anything, and add 10% to your experience."
msgstr ""
"Jsem iluminátor. Za 1000 zlatých měsíčně a 20% všeho zlata, které najdeme, s vámi budu cestovat, vše identifikovat a přidám 10% k vašim zkušenostem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:3
msgid "So you're for hire.  What do you do?"
msgstr "Takže je možné si tě najmout. Co umíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:4
msgid ""
"I do not share my knowledge for free.  If you wish, for a fee, I shall travel with you and share my knowledge."
msgstr ""
"Nedělím se o své znalosti zadarmo. Pokud chcete, mohu s vámi za drobný poplatek cestovat a podělit se o své rozsáhlé znalosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:5
msgid "Perhaps you could bless us with some knowledge?"
msgstr "Možná by ses s námi mohl podělit o své znalosti?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:5
msgid "That will cost you, my friend."
msgstr "To vás bude něco stát, přátelé."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:6
msgid ""
"News is a relative term, friends.  What I would consider interesting news, you would no doubt consider it a trifle boring."
msgstr ""
"Novinky, to je relativní pojem, přátelé. Co považuji za zajímavé já, bude pro vás zřejmě naprosto nudné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:7
msgid "Perhaps some other time."
msgstr "Snad někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:7
msgid "We don't really need an illuminate right now."
msgstr "Momentálně iluminátora opravdu nepotřebuju."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC281.rude:8
msgid "I am worth every penny you would spend on me."
msgstr "Stojím za každou penci, kterou za mě utratíš."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:1
msgid ""
"It is not too far from the Monastery. Be careful. May the Gods smile upon you as you go."
msgstr ""
"Není to příliš daleko od kláštera. Buďte opatrní. Ať se na vás bohové při vaší cestě usmívají."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:1
msgid "Where is this place?"
msgstr "Kde je to místo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:11
msgid "Good luck out there, brothers.  Farewell."
msgstr "Hodně štěstí. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:13
msgid "What family do I have to ruin?"
msgstr "Jakou rodinu je třeba zničit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:13
msgid ""
"You will know when the time has come. Perhaps you should consult with the clerks in the Town Halls of Chedian.  They may know of a troubled family.  Have strength candidates, you will need it."
msgstr ""
"Poznáte to, až nastane správný čas. Možná byste se měli poptat úředníků na radnicích Chedianu. Možná budou vědět o problémové rodině. Vyberte si silné kandidáty, budete je potřebovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:15
msgid ""
"Do not be drawn to the easy path.  For true enlightenment comes through trials.  Face the trials with courage, honor, and nobility, and you shall come out rewarded."
msgstr ""
"Nenechte se stáhnout k jednoduché cestě. Pravé osvícení přichází skrze zkoušky. Postavte se zkouškám s odvahou, ctí a ušlechtilostí a budete odměněni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:16
msgid "How are we going to do that?"
msgstr "Jak to máme udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:16
msgid ""
"Take this letter.  It is all we have to go on right now.  We found it on the body of a dying raider.  He claimed to only be the messenger.  When we asked him where he was going, he only laughed.  We can only assume he was headed to Thjorgard."
msgstr ""
"Vezmi si tento dopis. Je to jediná stopa, kterou momentálně máme. Měl ho u sebe umírající nájezdník. Tvrdil, že je jenom posel. Když jsme se ho ptali, kam jede, vysmál se nám. Můžeme jenom předpokládat, že mířil do Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:17
msgid ""
"A Crusader who wishes to go through the Three Crusades is on the path of the true Holy Warrior. All three tasks must be completed and then you must return here to receive the blessings of the Gods. Would you like to hear the first task?"
msgstr ""
"Křižák, který chce splnit tři křížové výpravy, je na správné cestě stát se pravým svatým válečníkem. Musíte splnit všechny tři úkoly a pak se vrátit sem, kde obdržíte požehnání bohů. Chcete si vyslechnout, v čem spočívá první výprava?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:17
msgid "Tell us of the Three Crusades."
msgstr "Řekni nám o třech křížových výpravách."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:18
msgid "No. There are no Crusaders in our group"
msgstr "Ne, v mojí družině nejsou žádní křižáci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:18
msgid ""
"Well, if you ever need to hear of them, I will be here to help you. Go with the gods."
msgstr ""
"No, pokud si o nich budete chtít někdy něco vyslechnout, budu tady. Jděte s bohem..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:19
msgid "We have completed our Crusades."
msgstr "Splnili jsme vše, co bylo zapotřebí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:19
msgid ""
"You wear the experience on your faces like badges of honor.  I can tell already you will do the order proud.  It gives me great pleasure to promote you to Paladins!"
msgstr ""
"Ano, vidím to ve vašich tvářích. Už teď vám mohu říci, že na vás řád bude pyšný. S velkým potěšením vás povyšuji na paladiny!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:2
msgid ""
"For those Crusaders who would wish to become Paladins, they must face the trials of the Three Crusades."
msgstr ""
"Ti křižáci, kteří by se chtěli stát paladiny, musí podstoupit zkoušku tří křížových výprav."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:2
msgid "Yes. Please tell us what you have for us."
msgstr "Ano. Prosím, řekni nám, co pro tebe můžeme vykonat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:20
msgid ""
"The Gauntlet of Fire is an ancient place. Built before the great cataclysm to test the heart of the candidates for the rank of Paladin. We have other methods for that now.  The Gauntlet of Fire has been lost to time."
msgstr ""
"Zkouška ohněm je název pradávného místa, jež vzniklo před Velkou pohromou, aby vyzkoušelo srdce kandidátů na hodnost paladina. Teď už máme jiné metody. Zkouška ohněm je minulostí..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:20
msgid "What do you know about  the Gauntlet of Fire?"
msgstr "Co víš o zkoušce ohněm?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:21
msgid "No need to apologize."
msgstr "Netřeba se omlouvat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:21
msgid "No thank you sir, sorry to have bothered you."
msgstr "Ne, díky pane, omlouvám se za vyrušení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:22
msgid "Farewell.  May the gods smile upon you."
msgstr "Sbohem. Ať se na vás bohové usmívají."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:3
msgid ""
"The first task is to save the life of a man. At this time, we have heard of a possible attempt to assassinate the Jarl of Thjorgard. He is a very important man, if he dies all hopes of a united Chedian die with him. You must save his life."
msgstr ""
"Prvním úkolem je zachránit lidský život. Nedávno jsme se dozvěděli, že možná dojde k pokusu zavraždit jarla Thjorgardu. Je to velmi důležitý muž a pokud zemře, spolu s ním zhyne i všechna naděje na sjednocený Chedian. Musíte zachránit jeho život."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:4
msgid "Alright, what are the other crusades?"
msgstr "Dobrá, jaké jsou další křížové výpravy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:4
msgid ""
"The other crusades are that you must damn a family, and then you must save them."
msgstr ""
"Další křížové výpravy jsou tyto: Musíte odsoudit jednu rodinu k prokletí a pak ji zachránit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:5
msgid ""
"The life of a Paladin is made of very difficult decisions. You must prove that you have the power to do the right thing, even when it's not the best thing to do."
msgstr ""
"Život paladina často znamená nutnost provádět těžká rozhodnutí, Musíte dokázat, že máte moc udělat správnou věc, i když to není ta nejlepší věc, která se může udělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:5
msgid "What? That's terrible!"
msgstr "Co? To je hrozné!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:6
msgid "Do you have any interesting tasks for a party of adventurers?"
msgstr "Nevíš o nějakém zajímavém úkolu pro partu dobrodruhů?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:6
msgid ""
"Well, I have many tasks for any among you who are Crusaders. Are there any among your party?"
msgstr ""
"No, mám mnoho úkolů pro ty z vás, kteří patří mezi křižáky. Jsou takoví u vás v družině?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:7
msgid ""
"A crusader who wishes to go through the three crusades is on the path of the true Holy Warrior. All three tasks must be completed and then you must return here to receive the blessings of the Gods. Would you like to hear the first task?"
msgstr ""
"Křižák, který chce splnit tři křížové výpravy, je na správné cestě stát se pravým svatým válečníkem. Musíte splnit všechny tři úkoly a pak se vrátit sem, kde obdržíte požehnání bohů. Chcete si vyslechnout, v čem spočívá první výprava?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:7
msgid "What other methods?"
msgstr "Co je třeba učinit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC282.rude:9
msgid ""
"I hear the abbot of the monastery is looking for someone to do a task for him."
msgstr ""
"Slyšel jsem, že opat kláštera hledá někoho, kdo by pro něj vykonal nějakou práci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:1
msgid ""
"You are most welcome, my children.  Was there anything else you needed?"
msgstr "Není zač děkovat, děti. Potřebujete ještě něco?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:12
msgid ""
"Well, a long time ago our Saint's relic went missing.  It was a very distressing time for us, but we were able to fool the pilgrim's by replacing it with a sheep's ankle bone.  No one gets close enough to be able to tell the difference anyway."
msgstr ""
"Inu, před dávnými časy se ztratila relikvie našeho světce. Bylo to pro nás velmi zlé období, ale podařilo se nám oklamat poutníky tím, že jsme ji nahradili ovčí kůstkou z kotníku. Stejně se nikdo nedostane tak blízko, aby poznal rozdíl."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:13
msgid "No, thank you!  Was there anything else you needed?"
msgstr "Ne, já děkuji! Potřebujete ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:14
msgid ""
"I see.  Gray Slemnir is finally going to retire, is he?  Well you may be in luck.  As I understand it, Robert Aefgil, though a pious soul, is not taking well to monastic life.  I will speak to him.  I believe he'll be returning from his penance tonight."
msgstr ""
"Aha. Gray Slemnir se konečně chystá odejít na odpočinek, že? No, možná máte štěstí. Pokud vím, tak Robertu Aefgilovi, i když je to zbožná duše, život v klášteře moc nesvědčí. Promluvím si s ním, myslím, že se vrací ze svého pokání dnes v noci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:14
msgid "We need to take a priest to Guberland."
msgstr "Potřebujeme najít kněze, jenž by s námi odešel do Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:16
msgid "No I don't think so.  Good luck!"
msgstr "Bohužel teď nemáme čas. Sbohem!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:17
msgid "No, we don't want to get involved in this crazy mix-up."
msgstr "Ne, do takové šílenosti se rozhodně nechceme zaplést."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:17
msgid "Oh what shall I do?!"
msgstr "Oh, co já jenom budu dělat?!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:18
msgid ""
"He was one crazy old wizard!  He came down to study a few of the artifacts and relics we have in our possession here at the monastery.  It seems that he made off with one of our more important ones."
msgstr ""
"Je to šílený starý kouzelník. Přišel sem do kláštera prostudovat několik artefaktů, které zde máme. Vypadá to, že utekl s naším nejdůležitějším vlastnictvím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:18 assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC298.rude:3
msgid "What do you know about Ramnivar?"
msgstr "Co víš o Ramnivarovi?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:2
msgid "We're here to summon the dragon."
msgstr "Přišli jsme vyvolat draka."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:2
msgid ""
"Well, we seem to be having a problem, one that requires the utmost delicacy.  Could you handle that?"
msgstr ""
"Inu, zdá se, že máme problém, který vyžaduje nejvyšší diskrétnost. Zvládli byste to?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:20
msgid ""
"Besides summoning the dragon?  All the great monasteries have a saint's relic.  That is how we attract pilgrims.  Donations from the pilgrims is how we make a living!  Otherwise we are destitute!  Will you help?"
msgstr ""
"Kromě vyvolání draka? Všechny velké kláštery mají relikvii světce. Tak přitahujeme poutníky. Z darů poutníků se živíme! Jinak jsme bez prostředků! Pomůžete nám?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:20
msgid "What do you need a relic for anyway?"
msgstr "K čemu vůbec tu relikvii potřebujete?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:21
msgid "Actually we're looking for a priest."
msgstr "My vlastně hledáme kněze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:21
msgid ""
"Are you?  I'd say you found one.  Or are you looking for someone in particular?"
msgstr ""
"Ale? Řekl bych, že jste právě jednoho našli. Nebo hledáte někoho určitého?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:22
msgid "We've returned for the priest."
msgstr "Vrátili jsme se pro kněze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:22
msgid "Yes of course.  He is waiting in the yard."
msgstr "Ano, jistě. Je připravený, čeká na dvoře."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:23
msgid ""
"That's it!  How did you know we were looking for it?  Oh, thank you!  Here, I prepared a reward for whoever returned it!  Was there anything else you needed?"
msgstr ""
"To je ona! Jak jste věděli, že ji hledáme? Oh, děkuji mnohokrát! Tady, máme připravenou odměnu pro kohokoli, kdo by ji vrátil! Tak... potřebujete ode mě ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:23
msgid "We found a bone fragment in the Wizard's Lab."
msgstr "V čarodějově laboratoři jsme našli tento úlomek kosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:24
msgid "We've found your relic."
msgstr "Našli jsme relikvii."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:24
msgid ""
"You have!  Oh, well done!  We here at the monastery thank you!  Here.  I've prepared a reward for whoever returned it to us."
msgstr ""
"Dokázali jste to! Výborně! Celý klášter vám děkuje. Tady je odměna, kterou jsme připravili pro kohokoli, kdo by nám ji vrátil zpět."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:25
msgid "Maybe you can help us?"
msgstr "Možná byste nám mohli pomoct?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:26
msgid "Not right now."
msgstr "Teď ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:26
msgid "Oh dear. Well, if you change your mind we could really use your help!"
msgstr ""
"Oh... no, pokud byste změnili názor, opravdu by se nám vaše pomoc hodila!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:3
msgid ""
"He's a nutter that's what he is!  His name is Ramnivar and he was determined to prove that the relic was a phony!  And currently it IS a phony!  Will you help us?"
msgstr ""
"Je to šílenec, to je důležité! Jmenuje se Ramnivar a chce dokázat, že je naše relikvie podvrh! A teď momentálně to podvrh JE! Pomůžete nám?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:3
msgid "Who is he?"
msgstr "Kdo to je?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:4
msgid ""
"The dragon?  He hasn't been around since....  Well you see, there's the problem.  You need the Saint's Relic to summon the dragon."
msgstr ""
"Draka? Nebyl tady v okolí už od... no vidíte, to je problém. Potřebujete svatou relikvii, abyste vyvolali draka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:4
msgid "Whatever it takes to summon the dragon."
msgstr "Uděláme cokoliv pro vyvolání draka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:5
msgid ""
"We think that a scholar stole it from us and took it back to his laboratory in Yorwick."
msgstr ""
"Domníváme se, že ji ukradl jeden učenec a odnesl si ji do své laboratoře v Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:5
msgid "Where do you think the relic is?"
msgstr "Kde myslíš, že teď ta relikvie je?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:6
msgid "Oh thank you!  His laboratory is somewhere in Yorwick.  Please hurry!"
msgstr "Oh, děkuji vám! Má laboratoř někde v Yorwicku! Prosím, pospěšte si!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:6
msgid "We will retrieve the real relic for you.  Where is this lab?"
msgstr "Získáme pro tebe tu pravou relikvii. Kde je ta laboratoř?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:7
msgid "Come back tomorrow morning.  I will see to it that he is ready to go."
msgstr "Vraťte se zítra ráno. Dohlédnu na to, aby byl připraven na cestu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:7
msgid "Sounds great!"
msgstr "To zní skvěle!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:8
msgid ""
"Do I?  We've lost our relic!  But keep it quiet.  We've replaced it with a sheep's ankle bone."
msgstr ""
"Nevím? Vím! Ztratila se nám naše relikvie! Ale nikomu o tom neříkejte. Prozatím jsme ji nahradili ovčí kostí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:9
msgid "How long do you think you can fool these poor pilgrims!"
msgstr "Jak dlouho si myslíš, že můžete ještě podvádět ty ubohé poutníky?!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC283.rude:9
msgid ""
"I don't think we can fool them much longer at all!  That's why we need your help!"
msgstr ""
"Já si myslím, že bychom je neměli vůbec podvádět! Proto potřebuji vaši pomoc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:2
msgid "Alright.  Perhaps we'll see you there.  Farewell."
msgstr "Dobře. Snad se tam později setkáme. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:3
msgid ""
"I see.  I know the way.  Please continue with your important work.  I will gather the things I will need and travel there on my own."
msgstr ""
"Aha. Znám cestu. Setkáme se tam. Pokračuj prosím ve své důležité práci. Vezmu si věci, které budu potřebovat, a pojedu tam sám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:3
msgid "To a new temple we're helping to build in Guberland."
msgstr "K novému chrámu, pomáháme ho budovat v Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:4
msgid ""
"I just reached the rank of Priest.  Abbot Leffery himself conducted the ceremony!"
msgstr ""
"Právě jsem byl vysvěcen na kněze. Samotný opat Leffery řídil ceremonii!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:5
msgid "Where exactly is it that I am to be going?"
msgstr "Kam přesně to mám odejít?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:5
msgid "Yes, we are ready to take you if you are ready to leave."
msgstr "Ano, jsme připraveni vzít tě sebou, pokud můžeš hned odejít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:6
msgid "That dirty rat stole our relic!"
msgstr "Ta špinavá krysa ukradla naši relikvii!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:8
msgid "Alright.  I will be here when you are ready to go."
msgstr "Dobrá, budu tady čekat, než se rozhodneš odejít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC284.rude:8
msgid "Not quite yet."
msgstr "Ještě ne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:2
msgid ""
"I've heard those soldiers in the Ta'Sar Academy have some really good stuff.  Boy what I wouldn't give to lift a few pieces from their collection!"
msgstr ""
"Slyšel jsem, že vojáci v Ta'Sarské akademii mají fakt dobré věci. Teda, hrozně rád bych si z jejich sbírky pár věcí půjčil!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:3
msgid "Sure! Let me know if you have any questions."
msgstr "Jasně! Jestli budete mít nějaké otázky, klidně se zeptejte."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:4
msgid "We'd like to see what you have for sale."
msgstr "Zajímalo by nás, co máš na prodej."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:5
msgid ""
"There's really not much here.  Most of the shops that have sprung up here are in support of the monastery or the pilgrims."
msgstr ""
"Tady se opravdu nic moc neděje. Většina obchodů, které tady najdete, je tu kvůli klášteru a poutníkům."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC292.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC296.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC299.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC300.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC301.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC305.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC306.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC307.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:20 assets_dev/worlds/mm9/dialogue/rude/NPC379.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC380.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC381.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC383.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC422.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:17 assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:6
msgid "What do you know about Lindisfarne?"
msgstr "Co víš o Lindisfarnu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:6
msgid "Let me know when you are ready. Go with the Gods."
msgstr "Dejte mi vědět, až budete připraveni. Buďte s bohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:6
msgid "No. We are not ready to embark upon this journey."
msgstr "Ne. Ještě nejsem připraven vydat se na cestu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:8
msgid "Anytime."
msgstr "Kdykoli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC285.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:8
msgid "Nothing, thanks."
msgstr "Nic, díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:2
msgid ""
"I'm thinking of selling my store and moving to someplace a little quieter."
msgstr ""
"Přemýšlím, o tom, že prodám obchod a přestěhuju se na nějaké klidnější místo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:3
msgid "Ah yes, I have many good things to sell!"
msgstr "Ach ano, mám mnoho zajímavých věcí na prodej!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:4
msgid "We'd like to see your items for sale"
msgstr "Zajímalo by nás, co máš na prodej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:5
msgid ""
"It is a great place to study and worship.  It's getting a little to busy for me, personally.  I wish all the pilgrims would stop coming here."
msgstr ""
"Je to skvělé místo pro studium a uctívání bohů. Ale mně osobně se to zde v poslední době zdá až příliš uspěchané. Kdyby sem tak nepřicházelo tolik těch poutníků..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:5
msgid "What do you know about Lindisfarne"
msgstr "Co víš o Lindisfarnu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:7
msgid "Let me know if I can help."
msgstr "Pokud budete s čímkoli potřebovat pomoct, stačí říct."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC286.rude:7
msgid "Nothing thank you."
msgstr "Nic, díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:2
msgid ""
"I really don't know why the Ta'Sar Academy doesn't send soldiers to guard the monastery.  It is a war college, after all!"
msgstr ""
"Opravdu nechápu, proč Ta'Sarská akademie nepošle vojáky strážit klášter! Je to přece vojenská škola!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:3
msgid "Many things, take a look!"
msgstr "Mnoho věcí, jenom se podívej!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:4
msgid "What do you have for sale?"
msgstr "Co máš na prodej?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:5
msgid ""
"Well there's pretty much two things besides this village.  There's the monastery, a popular tourist spot for raiders and pilgrims alike, and there's the Ta'Sar Academy.  That's not so popular."
msgstr ""
"No, kromě vesnice jsou tady jenom dvě místa. Klášter, velmi oblíbený cíl jak pro poutníky, tak pro nájezdníky, a pak Ta'Sarská akademie. Ta už není tak vyhledávaná."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:7
msgid "No, not today."
msgstr "Ne, dneska ne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC287.rude:8
msgid "Would you like to see my wares?"
msgstr "Nechceš si prohlédnout mé zboží?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:1
msgid ""
"Not especially.  I haven't spent enough time in port to pick up on the latest gossip."
msgstr ""
"Ani ne. Neměl jsem dost času potulovat se po přístavu a poslouchat čerstvé drby."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:2
msgid "Come aboard then! We'll be on our way."
msgstr "Tak tedy nastup! Vyplujeme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:2
msgid "Yes, we will."
msgstr "Ano."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:4
msgid ""
"Ah, there be no information in this here noggin about that then. Wish I could help you."
msgstr ""
"No, tak o tom ti nic zajímavého nepovím. Rád bych ti pomohl, ale nevím nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:4
msgid "What do you know about Lindisfarne Monastery?"
msgstr "Co víš o Lindisfarnu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:5
msgid "The next ship will be here soon."
msgstr "Další loď brzy dorazí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:6
msgid "And what would that be about then?"
msgstr "A na copak?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:7
msgid "Certainly.  Were you looking to travel today?"
msgstr "Jistě. Chcete dnes někam odcestovat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC288.rude:8
msgid "Perhaps another day."
msgstr "Tak možná jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC289.rude:1
msgid ""
"I'm just worried about when the next raid is going to come.  They happen so often.  Perhaps this time it will be me that is killed.  I wish they would stop."
msgstr ""
"Mám jenom strach, kdy dojde k dalšímu nájezdu. Stává se to tak často. Možná tentokrát zabijí zrovna mě... Kdy tomu bude konec!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC289.rude:3
msgid ""
"Those awful people!  They come here, kill people, and try to steal our valuable artifacts!"
msgstr ""
"Ti odporní bastardi! Zabíjejí naše lidi a pokouší se ukrást naše cenné artefakty!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC289.rude:3
msgid "What do you know about raiders?"
msgstr "Co víš o nájezdnících?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC29.rude:1
msgid "Good luck"
msgstr "Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC29.rude:2
msgid ""
"I'm a member of the United Group of Thjoradric Miners!  I refuse to work until the conditions in the mines improve!"
msgstr ""
"Jsem členem Svazu thjoradských horníků! Odmítám pracovat, dokud se poměry v dolech nezlepší!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC29.rude:2
msgid "Why aren't you working?"
msgstr "Pročpak nepracuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC29.rude:3
msgid "Go away!"
msgstr "Vypadni!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC29.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:24
msgid "Sorry.  Goodbye"
msgstr "Omluv mě. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC290.rude:1
msgid ""
"The last raid killed my brother Wulfgan.  When is the next going to come?  Who will be killed this time?"
msgstr ""
"Při posledním nájezdu zabili mého bratra Wulfgana. Kdy dojde k dalšímu přepadu? Koho zabijí tentokrát?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC290.rude:2
msgid "Oh, very well!  Ask your questions."
msgstr "Oh, no tak dobrá! Ptej se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC290.rude:3
msgid ""
"They killed my brother.  I will not ever forgive them for that.  Ever."
msgstr "Zabili mého bratra. Neodpustím jim. Nikdy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC290.rude:3
msgid "What do you know about the Chedian?"
msgstr "Co víš o Chedianu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC290.rude:4
msgid "If you want to help, pick up a rake!  Otherwise, leave me alone!"
msgstr "Pokud chcete pomoct, vezměte si hrábě! Jinak mě nechte na pokoji!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC290.rude:5
msgid "If you want to help, pick up a rake!"
msgstr "Pokud chcete pomoct, vezměte si hrábě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC291.rude:1
msgid ""
"I'm starting to worry about the relic.  I know Master Leffery told us not to speak about it, but I can't help worrying.  What if we never see it again?"
msgstr ""
"Začínám mít strach o relikvii. Vím, že nám mistr Leffery řekl, ať o tom nemluvíme, ale já si nemůžu pomoct, mám strach. Co když už ji nikdy neuvidíme?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC291.rude:2
msgid "Sorry.  Can we ask you some questions?"
msgstr "Promiň. Můžeme ti položit pár otázek?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC291.rude:3
msgid ""
"It's missing.  I don't know where it's gone to, but we can't fool these pilgrims like this.  It's absolutely shameful."
msgstr ""
"Zmizela. Jsme zoufalí, ale takhle nemůžeme nebohé poutníky dál podvádět. Je to velice hanebné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC291.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC302.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC303.rude:3
msgid "What do you know about the relic?"
msgstr "Co víš o relikvii?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC291.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:13
msgid "No, sorry."
msgstr "Ne, promiň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC292.rude:1
msgid ""
"How long will we let the pilgrims think we still have the relic?  It's a travesty!  I think Master Leffery should just be honest with them!"
msgstr ""
"Jak dlouho necháme poutníky myslet si, že máme stále naši relikvii? Je to podvod! Myslím, že by k nim měl být mistr Leffery upřímný!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC292.rude:3
msgid ""
"Lindisfarne has been a pillar of honesty and righteousness for years.  People look to us for their example.  We must remember that, and set the best example we can."
msgstr ""
"Lindisfarn bylo po léta místo poctivosti a spravedlnosti. Lidé se na nás dívali jako na příklad. Musíme na to pamatovat a dávat jim ten nejlepší možný příklad, jaký jen můžeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC293.rude:1
msgid ""
"I've heard rumors that the king of Mendossus to the south has been having troubles keeping himself on the throne."
msgstr "Král Mendossusu na jihu má prý problémy udržet se na trůně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC293.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC410.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:7
msgid "Go ahead."
msgstr "Pokračuj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC293.rude:3
msgid ""
"That's the nation to the south.  I hear there has been some sort of trouble brewing down there."
msgstr "To je národ na jihu. Prý jsou tam v poslední době nějaké nepokoje."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC293.rude:4
msgid "No bother at all."
msgstr "Vůbec neobtěžuješ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC294.rude:1
msgid ""
"The Mendossians have always had a strong government.  There is no way that the king could ever be dethroned.  Why, the Ichvan dynasty has lasted since the Great Cataclysm!"
msgstr ""
"Mendosané měli vždy silnou vládu. V žádném případě nebude tamější král sesazen! Ichvanská dynastie vytrvala od dob Velké pohromy!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC294.rude:3
msgid ""
"My family was living there when I was born.  They were originally from Framon, but were on a pilgrimage to the University.  We spent ten years there."
msgstr ""
"Když jsem se narodil, má rodina tam žila. Pocházejí z Framonu, ale putovali na univerzitu. Strávili jsme tam deset let."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:1
msgid ""
"I've heard the ships have been getting attacked if they sail too far away from Chedian."
msgstr ""
"Pokud se prý lodě vzdálí příliš daleko od Chedianu, někdo na ně zaútočí..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:5
msgid ""
"Chances are, you will find a lot of stuff in your adventures.  Do yourself a favor and get your merchant skill as high as you can.  You'll get the best prices for your stuff that way."
msgstr ""
"Je docela pravděpodobné, že při svých dobrodružstvích nalezneš spoustu věcí. Radím ti, vycvič se co nejvíce v obchodování. Získáš tak za své zboží lepší ceny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC295.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:11
#: assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC404.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC407.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC410.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC412.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:11
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:6
msgctxt "said by the party"
msgid "Farewell."
msgstr "Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC296.rude:1
msgid "I'm afraid not."
msgstr "Obávám se, že ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC296.rude:3
msgid ""
"Are you a pilgrim?  If you are looking for the relic, it's near the altar."
msgstr "Vy jste poutníci? Pokud hledáte relikvii, je blízko oltáře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC297.rude:1
msgid "I've heard that we and Thjorgard were once on better terms."
msgstr "Slyšel jsem, že jsme se dohodli s Thjorgardem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC297.rude:3
msgid "We are a monastery devoted to worshipping Igdra."
msgstr "Jsme klášter zasvěcený uctívání Igdry."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC297.rude:3
msgid "What do you know about Linidsfarne?"
msgstr "Co víš o Lindisfarnu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC298.rude:1
msgid ""
"You're not a pilgrim are you?  Of course not.  Our relic has gone missing.  Abbot Leffery is worrying himself sick over it."
msgstr ""
"Vy nejste poutníci že? Jistěže ne. Naše relikvie se ztratila. Opat Leffery je z toho velmi sklíčený, má spoustu starostí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC298.rude:3
msgid ""
"He has come here from time to time to study some of our artifacts.  I think he has a keep in Yorwick."
msgstr ""
"Čas od času sem přichází studovat naše artefakty. Myslím, že má sídlo v Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC299.rude:1
msgid ""
"I've just come here from Freetown.  Soon I will be taking my vows.  I'm so excited!"
msgstr ""
"Právě jsem dorazil z Freetownu. Brzy budu skládat přísahu... Jsem tak rozechvělý!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC299.rude:3
msgid "Not very much.  I just got here."
msgstr "Moc ne. Právě jsem se sem dostal."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:1
msgid "Gather the army.  We shall make for Frosgard immediately!"
msgstr "Shromáždi armádu. Okamžitě se odebereme do Frosgardu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:1
msgid "I will see to it personally!  See you there!"
msgstr "Osobně na to dohlédnu! Uvidíme se tam!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:10
msgid ""
"There is an artifact that has been in the hands of the Lindisfarne Monastery that belongs to us.  I want you to return it."
msgstr ""
"Lindisfarnský klášter má v držení jeden artefakt, který náleží nám. Chci, abys nám jej vrátil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:13
msgid "Thank you.  Farewell."
msgstr "Děkuji ti. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:14
msgid "He is a Beldonian Warlord on his way to conquer the Chedian."
msgstr "Je to beldonský diktátor, který se snaží ovládnout Chedian."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:14
msgid "What do you want me to do about it?"
msgstr "A co s tím mám podle vás dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:15
msgid "We will retrieve it."
msgstr "Získám jej."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:16
msgid ""
"Against the hordes?  What a noble idea.  And of course you want the Thjorgard Clan to join you."
msgstr ""
"Proti hordám? Jaký to vznešený nápad. A samozřejmě chcete, aby se k vám přidal i thjorgardský klan."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:16
msgid "We are trying to unite the six Clans of the Chedian."
msgstr "Snažím se spojit šest chedijských kmenů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:17
msgid "How so?"
msgstr "Jak to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:17
msgid ""
"I will send my stand-in to the arena in my place.  I will arrange to have you as the competitors.  During your bout, keep an eye out for someone with a bow.  Do what you can to stop them, but do not kill them.  We need to find out who's behind this."
msgstr ""
"Pošlu do arény místo sebe svého dvojníka a zařídím, abyste se protivníky toho vraha stali vy. Během zápasu mějte obě oči otevřené a hledejte někoho, kdo má u sebe luk. Dělejte, co budete moci, abyste ho zastavili, ale nezabíjejte ho. Musíme zjistit, kdo za tím stojí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:18
msgid ""
"Very well.  I will do this for you.  But only after you do two things for me."
msgstr "Výborně. Udělám to pro vás. Ale až potom, co vykonáte něco vy pro mě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:18
msgid "Yes.  We need to unite ALL the Clans."
msgstr "Ano. Musíme spojit VŠECHNY klany."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:19
msgid "Be careful, and good luck."
msgstr "Buď opatrný, a hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:19
msgid "Sounds like a plan."
msgstr "To zní jako promyšlený plán."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:2
msgid "Here you are."
msgstr "Tady máš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:2
msgid ""
"What a wonderful item this is!  Here is a small token of my appreciation!"
msgstr "Jaká překrásná věcička! A zde je malý výraz mé vděčnosti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:21
msgid ""
"I have been having trouble with the Thjorad production lately.   I would like for you to go to the Thjorad Mine find out why they have stopped working."
msgstr ""
"Poslední dobou jsme měli problémy s produkcí thjoradské rudy. Rád bych, aby ses vydal do thjoradských dolů a vyzvěděl, proč horníci přestali pracovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:22
msgid "We've retrieved it already!"
msgstr "Už jsme jej získali!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:22
msgid "You have?  Let me see!"
msgstr "Vskutku? Ukaž!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:23 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:37
msgid ""
"Ah yes, so you have.  You've proved yourselves both noble and worthy.  I shall be glad to join your coalition of clans."
msgstr ""
"Ano, zvládli jste to. Dokázali jste, že jste ušlechtilí a vznešení. Bude mi ctí přidat se k vašemu kmenovému svazku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:23 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:37
msgid "We've completed both your quests.  Will you join us now?"
msgstr "Splnili jsme oba tvé úkoly. Teď už se k nám připojíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:24 assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:38
msgid ""
"That is fantastic news!  I shall send word to all the Jarls immediately."
msgstr "To je fantastická zpráva! Okamžitě obešlu všechny ostatní jarly!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:24
msgid "The clans are united.  It is time for the war council."
msgstr "Klany jsou spojeny. Nastal čas na válečnou poradu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:25
msgid "Certainly, friends."
msgstr "Samozřejmě, příteli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:26
msgid ""
"The wind in his lungs bore too much hot air about himself.  It is good that he is dead."
msgstr ""
"Vzduch z jeho plic příliš otravoval okolní vzduch. Je dobré, že je mrtev."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:27
msgid "Perhaps Later."
msgstr "Možná později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:27
msgid "The offer will remain open until you return.  Farewell."
msgstr "Nabídka zůstává platná, dokud se nevrátíš. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:28
msgid "The offer will remain open until you return."
msgstr "Nabídka zůstává platná, dokud se nevrátíš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:29
msgid "That is great news!  Here is a small token of my appreciation!"
msgstr "To je skvělá zpráva! Zde je malý důkaz mé přízně!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:29
msgid "That is working also."
msgstr "Ta už také funguje."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:3
msgid "Was there something else you needed?"
msgstr "Potřebovali jste ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:30
msgid ""
"Fix my mines and get Thjorad back from the monastery!  Now don't dally.  Get moving!"
msgstr ""
"Vyřešte problém v dolech a z kláštera mi přineste Thjorad! A neztrácejte čas a pohněte sebou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:30
msgid "We're still working on them.  What did you want us to do?"
msgstr "Zatím na tom stále pracuju. Co jsi to po mně chtěl?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:31
msgid ""
"It's what has kept Thjorgard the most prosperous clan in Chedian.  I am certain if we didn't have a strong army, someone would try to take it from us."
msgstr ""
"Právě díky ní se Thjorgard stal nejúspěšnějším klanem v Chedianu. Jsem si jist, že kdybychom neměli silnou armádu, někdo by se nám ji hned pokusil ukrást."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:32 assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:49
msgid "Farewell, adventurers."
msgstr "Sbohem, dobrodruhu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:33
msgid "About those things you wanted us to do."
msgstr "O tom, co chceš, abych udělal."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:35
msgid "Marvelous!  Let me see it!"
msgstr "Úžasné! Dovol mi, ať se podívám!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:35
msgid "We've retrieved Thjorad."
msgstr "Získali jsme zpět Thjorad."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:36
msgid "Wonderful!  And the Refinery?"
msgstr "Báječné! A rafinérie?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:36
msgid "Your mine is once again producing Thjorad"
msgstr "Tvůj důl již opět produkuje thjoradskou rudu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:38
msgid "The Clans have been united.  It is time for the war council."
msgstr "Klany byly spojeny. Nastal čas k válečné poradě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:39
msgid ""
"Aye, it's good to be seen!  We have no time to waste!  After we were massacred, Tamur Leng's army turned north and is attacking Frosgard as we speak!"
msgstr ""
"Jo, já taky! Ale nesmíme ztrácet čas! Potom, co nás zmasakrovaly, obrátily se armády Tamura Lenga k severu a zatímco se tu vybavujeme, už útočí na Frosgard!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:39
msgid "Sven!  It is good to see you!"
msgstr "Svene! Rád tě vidím!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:4
msgid "We've come to speak to you about Tamur Leng."
msgstr "Přišli jsme si s tebou promluvit o Tamuru Lengovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:40
msgid ""
"Hmm.  Looks like someone doesn't like my leadership.  I was planning on attending tomorrow.  Maybe we can use that to our advantage."
msgstr ""
"Hmm. Vypadá to, že se někomu nelíbí mé vedení. Na zítřek jsem plánoval, že se na to podívám. Možná bychom toho mohli využít ve svůj prospěch."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:40
msgid "We have found a disturbing letter that you need to read."
msgstr "Objevili jsme jeden znepokojující dopis, který si musíš přečíst."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:41
msgid "I see.  Go find him.  I'll not tolerate insurrection in my capital!"
msgstr ""
"Chápu. Tak běž a najdi ho. Ve svém hlavním městě nemíním tolerovat žádnou vzpouru!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:41
msgid "The assassin fingered a man named Harris Willington."
msgstr "Má v tom prsty vrah jménem Harris Willington."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:42
msgid "Harris Willington is the accountant at the General Store."
msgstr "Harris Willington je účetním v obchodě se smíšeným zbožím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:42
msgid ""
"What?  I would have thought Hreidmar a better judge of character than that.  Very well.  Thank you for your assistance.  I owe you my life.  Here's a small token of my gratitude."
msgstr ""
"Cože? Myslel jsem si, že Hreidmar má lepší nos na lidi. Nu dobrá. Děkuji vám za pomoc. Zachránili jste mi život. A tady je malý důkaz mé vděčnosti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:43
msgid "Harris Willington is dead."
msgstr "Harris Willington je mrtev."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:43
msgid ""
"Killed him, did you?  Congratulations.  I would have preferred to make an example of him, but perhaps the word on the streets will do that.  Thank you.  I owe my life to you.  It isn't much, but here's a little appreciation."
msgstr ""
"Zabili jste ho, že? Blahopřeji. Byl bych dal sice přednost tomu učinit z něj odstrašující příklad, ale snad nám tu samou službu prokáže šuškanda, jež se šíří ulicemi. Děkuji vám. Zachránili jste mi život. Není to nic moc, ale tady máte něco na oplátku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:44
msgid ""
"So I am told.  Fear not, brave souls.  Perservere and we shall succeed!"
msgstr "Byl jsem o tom zpraven. Nebojte se, hrdinové. Vytrvejte a uspějeme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:44
msgid "Sven.  It is our fault you are dead."
msgstr "Svene. Je to naše vina, že jsi mrtev."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:45
msgid "Sorry to bother you.  Goodbye."
msgstr "Odpusť, že jsem tě vyrušil. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:5
msgid "That I shall.  See you at the council."
msgstr "Učiním tak. Uvidíme se na poradě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:6
msgid "Certainly, but we have much work to do before then."
msgstr "Jasně, ale ještě předtím nás čeká mnoho práce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:6
msgid "I shall see you at the council, then.  Farewell."
msgstr "Tak se tedy uvidíme na poradě. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:7
msgid ""
"The preparation for the war council goes well.  Give the word, and Thjorgard will be there."
msgstr ""
"Přípravy k válečné poradě pokračují dobře. Stačí říci a Thjorgard dorazí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:8
msgid ""
"Yes.  One of my predecessors loaned the Monastery an artifact called Thjorad.  It was the first item found made of Elemental Thjorad.  We and Lindisfarne were on better terms then.  Now is another story.  Getting this item will not be easy."
msgstr ""
"Ano. Jeden z mých předků klášteru zapůjčil artefakt zvaný Thjorad. Byla to první věc vyrobená z thjoradské rudy. Tenkrát jsme měli s Lindisfarnem poněkud jiné vztahy - to je ale jiný příběh. Získání onoho předmětu nebude žádná procházka růžovým sadem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:8
msgid "You want us to retrieve it?"
msgstr "Chceš jej získat zpátky?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC3.rude:9
msgid ""
"My army is at your disposal.  I assume we shall be having a war council when the clans are together?"
msgstr ""
"Mé vojsko je ti k dispozici. Počítám, že až budou všechny klany spojeny, svoláme válečnou poradu, ne?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:1
msgid "Fine.  Goodbye"
msgstr "Fajn. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:2
msgid "Glad we could help."
msgstr "Rádi jsme pomohli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:3
msgid "It's too bad you all can't work together like this more often."
msgstr "Škoda že takhle nemůžete spolupracovat častěji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:3
msgid ""
"Yeah, then we'd really have the linemen sweat..Wait!  Why can't we?  We should form a group!  A miner's group!  The United Group of Thjoradric Miners!  UGTM!  Yeah!  I like that.  Thanks!"
msgstr ""
"Jo, připravili bysme těm dozorcům perný chvilky... počkej! A proč bysme vlastně nemohli? Založíme svaz! Hornickej svaz! Svaz thjoradských horníků! Jo! To se mi líbí! Díky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:4
msgid ""
"The linemaster!  They're always telling the foremen and the crew chiefs the crews have to work harder.  They have to meet the quota.  Never mind that the quotas are twice as large as last month's!"
msgstr ""
"Může za to hlavní pochůzkář! Vždycky říká předákům a mistrům, že musí víc makat, aby se splnily normy. Ale fakt, že ty normy se každej měsíc zdvojnásobujou, je jim už úplně šumafuk!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:4
msgid "Who's fault is it then?"
msgstr "A čí je to tedy vina?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:5
msgid ""
"Because all the miners have stopped working.  They can't fire one when all of them are not working, and they can't fire all of us!"
msgstr ""
"Protože všichni horníci zastavili práci. Nemůžou vyrazit ani jednoho, když nepracuje nikdo, a všechny nás vyhodit taky nemůžou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:6
msgid "Have you said this to the linemaster?"
msgstr "A řekl jsi to tomu pochůzkáři?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:6
msgid ""
"Of course not!  You think I want to get fired?  They already tell all of us that we can easily be replaced!  Why if it weren't for the cave-in threat, the linemasters would have all of our hides!  They're already going crazy as it is!"
msgstr ""
"Samozřejmě že ne! Myslíš, že se chci mermomocí nechat vyhodit? Už nám všem naznačili, že jsme snadno nahraditelní! Kdyby nebylo toho závalu, hlavní pochůzkáři by už dávno měli všechny naše skalpy! Už takhle z toho všichni blbnou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:7
msgid ""
"The pressure to produce Elemental Thjorad, of course!  They always think we get sadistic pleasure out of telling our crews they have to work twice as hard."
msgstr ""
"Samozřejmě za ten tlak na výrobu thjoradské rudy! Vždycky se domnívají, že máme zvrhlé potěšení z toho, že musíme naše party nutit pracovat ještě dvakrát tolik."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:7
msgid "What's the foreman's fault?"
msgstr "Za co může ten předák?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:8
msgid "Either put up or shut up!  You're whining won't solve problems."
msgstr "Buď se zvedni, nebo drž hubu! Tvý nářky nic nevyřeší!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:8
msgid "You're just like them!  I don't want to talk to you anymore."
msgstr "Jste zrovna jako oni! Už se s vámi nemíním bavit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC30.rude:9
msgid "Sorry to hear it.  Goodbye"
msgstr "To nerad slyším. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC300.rude:1
msgid "Isham and I just arrived.  I think we'll be taking the vows together."
msgstr ""
"Isham a já jsme právě dorazili. Myslím, že budeme skládat přísahu společně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC300.rude:3
msgid "I've wanted to come here all my life."
msgstr "Celý život jsem toužil dostat se sem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC301.rude:1
msgid ""
"My wife was killed in Thronheim.  My home was burned in Yorwick.  With that much tragedy, what else am I to do?"
msgstr ""
"Mou ženu zabili v Thronheimu. V Yorwicku mi vypálili dům. Taková tragédie, co mám jenom dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC301.rude:3
msgid "It's a sad end to my miserable life."
msgstr "Je to smutný konec mého ubohého života."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC302.rude:1
msgid "Not that you haven't heard elsewhere."
msgstr "Nevím o ničem, co by ti už někdo neřekl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC302.rude:3
msgid ""
"We are forbidden to speak of it.  If you wish to see it, it is by the altar."
msgstr "Nesmíme o tom mluvit. Pokud si ji přeješ vidět, je u oltáře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC303.rude:1
msgid ""
"That Aikin took my robes this morning, I'm sure of it!  When Abbot Leffery hears of this, Aikin will be doing penance for certain!"
msgstr ""
"Aikin si vzal dnes ráno moje roucho, jsem si tím jistý! Až se o tom dozví opat Leffery, Aikin bude muset určitě činit pokání!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC303.rude:3
msgid "I am sorry, child.  I cannot speak of the relic."
msgstr "Je mi líto, poutníku. O relikvii nesmím mluvit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC304.rude:2
msgid ""
"I am sorry, child.  I am on penance.  I am forbidden to speak to pilgrims."
msgstr "Je mi líto, poutníku. Činím pokání. Nesmím s nikým mluvit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC305.rude:1
msgid "My family disowned me for choosing this path."
msgstr "Má rodina mě vydědila, protože jsem si zvolil tento život."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC305.rude:3
msgid "It is all that I know now.  The monks are my family."
msgstr "Klášter je můj domov a ostatní bratři má rodina."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC306.rude:1
msgid ""
"Ezhno is doing penance for sneaking food into his room.  He is forbidden from talking to pilgrims."
msgstr ""
"Ezhno činí pokání, protože si do své místnosti propašoval jídlo. Má zakázáno mluvit s poutníky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC306.rude:3
msgid ""
"It is home.  It is a hard life, but the trials we face in this life will make us stronger in the next."
msgstr ""
"Je to domov. Život je tvrdý, ale díky zkouškám, kterými procházíme v tomto životě, budeme v příštím silnější."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC306.rude:4
msgid "No bother."
msgstr "Neobtěžuješ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC306.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:9
msgid "It was a pleasure."
msgstr "Bylo mi potěšením."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC307.rude:1
msgid ""
"You look like a strong group.  Abbot Leffery might have a job for you."
msgstr ""
"Vypadáte jako silná družina. Opat Leffery by pro vás možná mohl mít práci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC307.rude:3
msgid ""
"If you're looking to earn some money, find Abbot Leffery.  He might have a job for you."
msgstr ""
"Pokud si chcete vydělat nějaké peníze, najděte opata Lefferyho. Mohl by pro vás mít nějakou práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:1
msgid "Alright, you're hired!"
msgstr "Dobrá, najímám tě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:1
msgid "You won't be sorry."
msgstr "Nebudeš litovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:2
msgid "How much are we talking about here?"
msgstr "O jaké sumě se tady bavíme?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:2
msgid ""
"It's a bargain!  For 2000 gold to start, 1000 gold per month plus 20% of all the gold we find I will heal your parties injuries and conditions once per day!"
msgstr ""
"Dohodneme se! 2000 zlatých do začátku, 1000 zlatých měsíčně plus 20% všeho zlata, které najdeme, a já jednou denně všechny vyléčím ze zranění a nemocí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:3
msgid ""
"Well, I am ready to leave this place.  I have learned all I am going to but I cannot travel alone.  If you will take me with you, I will heal your party for a portion of the gold you find along the way."
msgstr ""
"No, jsem připravená opustit toto místo. Už jsem se naučila vše, co potřebuji, ale sama cestovat nemohu. Pokud mě vezmeš s sebou, budu vás léčit za drobný podíl na zlatě, které najdeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:4
msgid "Perhaps I can help you then."
msgstr "Tak to ti možná můžu pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:5
msgid "Maybe some other time."
msgstr "Možná někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:10
msgid "As you wish."
msgstr "Jak si přeješ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC308.rude:6
msgid "No thanks. Maybe some other time."
msgstr "Ne, díky. Možná příště."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:1
msgid "Come with us!"
msgstr "Pojď s námi!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:3
msgid "That is impossible!  We must get to the bottom of this!!"
msgstr "To není možné! Musím zjistit, o co tady jde!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:3
msgid "WE have a Writ of Fate!!"
msgstr "MY máme Písmo osudu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:4
msgid "That cannot be!  We are destined to stop you!"
msgstr "To není možné! Mým osudem je zastavit tě!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:4
msgid "What!?  How can you stop me when I have a Writ of Fate?"
msgstr "Co!? Jak mě můžete zastavit, když mám Písmo osudu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:5
msgid "Destiny?  What are you talking about?"
msgstr "Osud? O čem to mluvíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:5
msgid ""
"It was there Igrid gave me my Writ of Fate.  It told of how I am fated to conquer the world!  That is why you cannot stop me!"
msgstr ""
"To Igrid mi dala mé Písmo osudu! A v něm stojí, že mým osudem je dobýt svět! Proto mě nemůžete zastavit!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:6
msgid ""
"Ha!  If you only knew!  Well, I suppose I shall tell you.  You see, I have been to the place you call Arslegard.  I have spoken to Igrid.  It was there she informed me of my destiny!"
msgstr ""
"Ha! Kdybyste jenom věděli! Ale co, můžu vám to říct. Víte, byl jsem na místě, kterému říkáte Arslegard. Mluvil jsem s Igrid. To ona mi řekla o mém osudu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:6
msgid "You are beaten!  What makes you think you will escape?"
msgstr "Jsi poražen! Proč si myslíš, že se ti podaří utéct?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:7
msgid ""
"It seems that I underestimated your abilities.  I can assure you that will never happen again!  You may have won this battle, but in time my hordes will overrun Chedian, and I will see you all enslaved!"
msgstr ""
"Vypadá to, že jsem podcenil vaše schopnosti. Ale ujišťuju vás, že to už se nestane! Možná jste vyhráli tuto bitvu, ale za nějakou dobu hordy dobudou celý Chedian a vy skončíte v otroctví!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:7
msgid "The traitor is finished."
msgstr "S tím zrádcem jsem skoncoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:8
msgid "We have come to end this, Tamur Leng!"
msgstr "Přicházím to skončit, Tamure Lengu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:8
msgid ""
"You!  Forad had instructions to kill you!  How is it that you are still alive?"
msgstr "Vy! Forad vás měl přece zabít! Jak je možné, že stále žijete?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC309.rude:9
msgid "We will get to the bottom of this!!"
msgstr "Zjistím, o co tady jde!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:1
msgid "Tell me about The Great Cataclysm."
msgstr "Řekni mi něco o Velké pohromě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:1
msgid ""
"The Great Cataclysm is when Verhoffin cast his spell atop his castle in the Isle of Ashes that nearly destroyed us all!"
msgstr ""
"Velká pohroma začala, když Verhoffin seslal z vrcholku své věže na Ostrově popela kouzlo, které nás skoro všechny zničilo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:3
msgid "How do I visit Arslegard?"
msgstr "Jak se dostanu do Arslegardu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:3
msgid "The only way to see Arslegard is if you're dead."
msgstr "Jediný způsob, jak se dostat do Arslegardu, je zemřít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:4
msgid ""
"Elemental Thjorad is used by the Thjoradric Smiths to make powerful and magical weapons and items."
msgstr ""
"Thjoradskou rudu používají thjoradští kováři k výrobě magických zbraní a předmětů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:6
msgctxt "said by the party"
msgid "What is it?"
msgstr "Co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:5
msgid "We are so fortunate to have found Elemental Thjorad in the mountains!"
msgstr "Máme to štěstí, že jsme v horách nalezli thjoradskou rudu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:5
msgid "Why are you so happy?"
msgstr "Proč máš takovou radost?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:8
msgid ""
"Arslegard is the city where the gods live.  It is supposed to be the most beautiful city in the world.  I hope to visit it one day."
msgstr ""
"Arslegard je město, kde přebývají bohové. Prý je to to nejkrásnější místo na světě. Doufám, že se tam jednoho dne také podívám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:8
msgid "Where is Arslegard?"
msgstr "Kde leží Arslegard?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:9
msgid ""
"Verhoffin was an evil, evil man!  He is the one that caused the Great Cataclysm!"
msgstr "Verhoffin byl zlý, zlý muž! Právě on zavinil Velkou pohromu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC31.rude:9
msgid "Who is Verhoffin?"
msgstr "Kdo je to Verhoffin?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC310.rude:1
msgid ""
"Keep your eyes peeled, friend.  That is the best advice anyone can have."
msgstr ""
"Měj oči otevřené a uši nastražené. To je nejlepší rada, jakou ti kdo kdy může dát!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:1
msgid ""
"I've just returned from Framon.  The conditions there are getting worse by the day!"
msgstr ""
"Právě se vracím z Framonu. Podmínky jsou tam každým dnem horší a horší!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:4
msgid "If you meet the requirements, I can help you with that."
msgstr "Pokud na to máte dostatečné schopnosti, mohu vám pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:2
msgid "We'd like to become Experts in Identify Item."
msgstr "Chtěli bychom se stát experty v identifikaci věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:6
msgid ""
"In Yorwick, there is an elf named Laina Wilan.  She will be able to help you."
msgstr "V Yorwicku je elfka jménem Laina Wilan. Měla by ti pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:6
msgid "Where can we become Grandmasters in Identify Item?"
msgstr "Kde se můžeme stát velmistry v identifikaci věcí?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC311.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:4
msgctxt "said by the party"
msgid "We'd like to become Masters in Identify Item."
msgstr "Chtěli bychom se stát mistry v identifikaci věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:1
msgid "No, we haven't seen him yet."
msgstr "Ne, ještě jsme ji nenašli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:1
msgid "Oh OK, thank you for helping me!"
msgstr "Ach, ale i tak děkuju za pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:10
msgid ""
"Mommy says that we are Framish, and no matter how many Thronish settle were we have to remember that!"
msgstr ""
"Maminka říká, že jsme Framonští a ať už se tady usadí Thronských, kolik chce, musíme na to pamatovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC324.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC328.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC333.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:5
msgid "What do you know about Yorwick?"
msgstr "Co víš o Yorwicku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:11
msgid ""
"I had him on the east side of the village. I only turned to talk to my friend for one second and when I turned back he was gone!"
msgstr ""
"Na východ od vesnice... Jenom jsem se na chviličku otočila, abych si mohla promluvit s kamarádkou, a když jsem se otočila, už byla pryč!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:11
msgid "Where did you take your sheep?"
msgstr "Kam jsi vedla svou ovečku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:12
msgid "Oh, what am I going to do?"
msgstr "Oh, co jenom budu dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:12
msgid "We can't help you right now, little girl."
msgstr "Teď zrovna ti pomoct nemůžu, holčičko."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:13
msgid "We havn't found your sheep yet."
msgstr "Ještě jsme tvou ovečku nenašli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:13
msgid "Well Hurry!"
msgstr "Tak si pospěš!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:14
msgid "Sorry to have bothered you, you old meanie!"
msgstr "Tak promiňte, že jsem vás obtěžovala, vy staří otravové!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:14
msgid "We don't have time to go looking for your silly sheep."
msgstr "Nemáme čas hledat nějakou blbou ovci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:15
msgid "Here's your sheep."
msgstr "Tady je tvá ovce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:15
msgid "Thank you!  Thank you!  Oh I thought she never was going to be found!"
msgstr "Děkuju! Děkuju! Už jsem si myslela, že ji nikdy nenajdu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:17
msgid "Oh, what will I do!"
msgstr "Oh, co budu dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:17
msgid "We're sorry, we can't help you right now"
msgstr "Je nám to líto, teď ti pomoct nemůžeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:2
msgid "I can't find my sheep! What will mother say?"
msgstr "Nemůžu najít svou ovečku! Co mi jenom řekne máma?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:2
msgid "What's the matter?"
msgstr "O co jde?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:3
msgid ""
"I was herding him near the old gate. But mother said not to go outside of our village."
msgstr ""
"Pásla jsem ji nedaleko staré brány. Ale máma mi říkala, abych nevycházela ven z vesnice."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:3
msgid "Where did you see your sheep last?"
msgstr "Kde jsi viděla svou ovečku naposledy?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:4
msgid ""
"Mother won't tell me. It must be a stupid rule so that I won't get out of her site. I just wanted my sheep to have some fresh grazing! So I took him to the east side of town where no one ever goes, and the grass is fresh and not trampled on."
msgstr ""
"Matka mi to nechce říct. Je to jistě jenom nějaký hloupý rozkaz, abych se jí nedostala z dohledu. A já jen chtěla, aby se moje ovečka napásla čerstvé trávy! Tak jsem ji vzala na východ od vesnice, kam nikdo nechodí a kde je tráva čerstvá a nepošlapaná."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:4
msgid "Why can't you go outside of the village?"
msgstr "Proč nemůžeš jít ven z vesnice?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:5
msgid "That's wonderful! Wait until I tell the others!"
msgstr "To je skvělé! Počkej, až tohle řeknu ostatním!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:5
msgid "You are welcome Mary. Now you can play outside the village."
msgstr "Nemáš zač, Mary. Teď si můžeš hrát venku za vesnicí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:6
msgid "Oh thank you! I will wait here for you."
msgstr "Ó, děkuju vám! Počkám tady na vás!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:6
msgid "We will try to find your sheep"
msgstr "Zkusím najít tvou ovečku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:7
msgid "My sheep is missing!"
msgstr "Moje ovečka se ztratila!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:9
msgid ""
"Oh you horrible people! You were supposed to save him! My mother's going to make you pay for him!"
msgstr ""
"Ó vy hrozní lidé! Měli jste ji zachránit! Má matka se postará, abys za to zaplatil!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC312.rude:9
msgid "We found your sheep, but he was killed by a magic mine."
msgstr "Našli jsme tvou ovečku, ale zabila ji magická mina."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:3
msgid ""
"I hear those children have been playing near the magic mines.  Don't they know those things are dangerous?  What's wrong with parents today?"
msgstr ""
"Slyšela jsem, že si děti hrají blízko magických min. Copak nevědí, jak jsou ty věci nebezpečné? Rodiče dneska nemají ke svým potomkům žádnou zodpovědnost!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:5
msgid "See that you do."
msgstr "Postarej se o to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:5
msgid "We will try to find this place!"
msgstr "Pokusím se to místo najít!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:3
msgid "We'd like to talk to you about the mines."
msgstr "Rádi bychom si s tebou promluvili o minách."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:4
msgid ""
"We put them in to protect the town.  It was a very necessary safety precaution.  Parents today don't teach their children the proper fear of those pastures!"
msgstr ""
"Umístili jsme je venku, abychom ochránili městečko. Bylo to nezbytné bezpečnostní opatření. Ale rodiče dnes své děti nepoučují o nebezpečí, které na pastvinách hrozí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:4
msgid "What do you know about the mines?"
msgstr "Co víš o minách?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:6
msgid "Uh, no. We aren't looking for anything like that."
msgstr "Uh, ne. My nic takového prostě neděláme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:6
msgid "You aren't? Oh. Well, I will be on my way then."
msgstr "Ne? Oh... no tak já tedy půjdu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:8
msgid "No, none of us are magic beings.  Goodbye."
msgstr "Ne, nikdo z nás není magická bytost. Na shledanou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC313.rude:8
msgid "Pity. Good day then."
msgstr "Smůla. Tak tedy sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:4
msgid "Show us what you have for sale"
msgstr "Ukaž nám, co máš na prodej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:3
msgid ""
"Sure! Sure! I can sell you anything you want. Highest quality, just for my special customers!"
msgstr ""
"Jistě, jistě! Můžu ti prodat cokoliv! Nejvyšší kvalita pro mé oblíbené zákazníky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC314.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:8
msgid "Nothing, thanks. Just looking."
msgstr "Nic, díky. Jen se koukám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC315.rude:1
msgid ""
"I'm a fugitive!  I escaped from my captors in Framon who accused me of treason!  Me!  Can you believe that?"
msgstr ""
"Jsem uprchlík! Utekl jsem z Framonu, kde mě obvinili z velezrady! Mě! No věříš tomu? Mě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC315.rude:2
msgid "Alright, I suppose."
msgstr "Dobrá tedy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC315.rude:3
msgid ""
"I was about to be promoted to senior hall guard, then the Sergeant of the Watch opened his fat mouth.  He lied to the Queen about me!  He said I snuck into the treasury on my watch.  That I went into the queens chamber!  All lies, every last word!"
msgstr ""
"Měl jsem být povýšen na staršího strážného, pak si ale otevřel svou hnusnou hubu seržant hlídky! Lhal mé královně! Tvrdil, že jsem se na své hlídce vloupal do pokladnice. A pak jsem šel do královniných komnat! Všechno jsou to lži, jedno každé slovo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC315.rude:4
msgid "Nothing, sorry"
msgstr "Nic, díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC315.rude:4
msgid "humph."
msgstr "Hmfff."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC316.rude:1
msgid "Nevermind. Sorry to bother you."
msgstr "To nic. Promiň, že jsem obtěžoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC316.rude:1
msgid "No trouble."
msgstr "Žádný problém."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC317.rude:1
msgid "Ah. That is alright."
msgstr "Ah. To je v pořádku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC317.rude:1
msgid "Didn't mean to interrupt you. Nevermind"
msgstr "Nechtěl jsem obtěžovat. Promiň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC318.rude:1
msgid "No trouble at all."
msgstr "Žádný problém."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC318.rude:1
msgid "Oh nothing. Sorry to bother you."
msgstr "Oh nic. Promiň, že jsem obtěžoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC319.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:12
msgid "Alright then."
msgstr "Dobrá tedy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC319.rude:1
msgid "We'll leave you to your drink."
msgstr "Jen klidně pij dál."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:1
msgid "Actually we would like to ask you something else."
msgstr "Teď bychom se tě rádi optali na něco jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:10
msgid "It's not a dish.  It's....  Never mind.  Another question."
msgstr "To není žádné jídlo. Je to... ale nic. Další otázka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:2
msgid "Maybe we can ask you something else."
msgstr "Snad bychom se tě mohli zeptat na něco jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:12
msgid ""
"Yea.  He's the guy who wins the mud shoveling championship every year!"
msgstr ""
"Jo. Je to ten chlápek, co každej rok vyhraje turnaj v odklízení bláta!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:12
msgid "You've heard of him?"
msgstr "Slyšel jsi o něm?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:13
msgid "I think that's someone else."
msgstr "Domnívám se, že jde o někoho jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:13
msgid "No, I wouldn't forget him!  He's my arch enemy!"
msgstr "Ne, nezapomenu na něj! Je to můj úhlavní nepřítel!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:14
msgid "Maybe there's something else we can ask you"
msgstr "Možná bychom se tě mohli otázat na něco jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:15
msgid ""
"Who cares!  If it weren't for him, I wouldn't have a job!  Thank heavens for him!"
msgstr ""
"Kdo se o to stará! Nebýt jeho, neměl bych žádnou práci! Děkuju za něj nebesům!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:15
msgid "You don't even know his name?"
msgstr "Cožpak neznáš ani jeho jméno?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:16
msgid "And what was that?"
msgstr "A co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:16
msgid "We wanted to ask you about something"
msgstr "Chtěli jsme se tě na něco dotázat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:17
msgid "We'll let you get back to your shoveling."
msgstr "Už tě nebudu rušit v odklízení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:18
msgid "We'll let you get back to your shoveling"
msgstr "Necháme tě, aby ses mohl vrátit k odklízení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:19
msgid "We won't bother you anymore."
msgstr "Už tě víc nebudu vyrušovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:2
msgid ""
"Of course it's important!  Why without any mud shovelers, the mud would just pile up!"
msgstr ""
"Jistěže je to důležité! Nebýt odhazovačů bláta, ten marast by se tu nakupil!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:2
msgid "We didn't realize mud shoveling was so important."
msgstr "Nevšimli jsme si, že by odhazování bláta bylo tak důležité."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:20
msgid "Isn't that some sort of dish made out of pig's intestines?"
msgstr "Není to takové to jídlo, co se vyrábí z prasečích střívek?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:21
msgid "It's not a dish, it's a place.  Nevermind.  Goodbye"
msgstr "To není jídlo, ale místo. No nic. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:22
msgid "Right.  We'll let you get back to the shoveling."
msgstr "Správně. Jen zase pěkně odklízej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:23
msgid "We'll let you get back to your mud shoveling."
msgstr "Tak se tedy vrať k odklízení bláta."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:25
msgid "I think I heard of that guy.  He's a real jerk!"
msgstr "Myslím, že jsem o tom hochovi už slyšel. Je to fakt kretén!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:26
msgid ""
"I know the guy that did it gave us a lot of shoveling to do.  All hail the Great Cataclysm Maker!"
msgstr ""
"Znám toho chlápka, co nám dal spoustu věcí k odklízení. Všichni chvalme tvůrce Velké pohromy!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:26
msgid "What do you know about the Great Cataclysm"
msgstr "Co je ti známo o Velké pohromě?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:27
msgid "Sorry, nevermind."
msgstr "Promiň, to nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:3
msgid ""
"Would it be a problem?  Of course it would be a problem!  Don't you know anything?  If the mud were to pile up, there'd be huge piles of mud all over the place!"
msgstr ""
"Že by to byl nějaký problém? Samozřejmě že by to byl problém! Copak nic nevíš? Kdyby se tu nakupilo bláto, byly by ho tu za chvíli celé hromady!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:3
msgid "Would that be a problem?"
msgstr "A to by byl nějaký problém?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:4
msgid ""
"If the mud piled up, who would shovel it?  No one!  Because there wouldn't be any mud shovelers!"
msgstr ""
"Kdyby se tu hromadilo bláto, kdo by je pak odklízel? Nikdo! Protože by tu nebyl ani jeden odhazovač bláta!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:4
msgid "So...."
msgstr "Takže..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:5
msgid "And what is that?"
msgstr "A co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:5
msgid "We'd like to ask you something"
msgstr "Rádi bychom se tě na něco zeptali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:6
msgid "I heard the miners haven't been working lately."
msgstr "Slyšel jsem, že horníci poslední dobou nepracují."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:6
msgid "What do you know about the Mines?"
msgstr "Co víš o dolech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:7
msgid "What is it that you're doing?"
msgstr "Co to děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:7
msgid ""
"What's it look like I'm doing?  I'm shoveling mud!  And I was making good progress before you bothered me!"
msgstr ""
"Copak nevidíte, co dělám? Odklízím bláto! A dařilo se mi to docela dobře, dokud jste mě nevyrušili!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:8
msgid ""
"How should I know?  I'm a mud shoveler, not a miner!  And I need to get back to it!"
msgstr ""
"Jak to mám vědět? Jsem odklízeč bláta, žádný horník! A rád bych se ke svý práci vrátil!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:9
msgid "No.  It's a place."
msgstr "Ne. To je místo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC32.rude:9
msgid "Who would name a place after plate of pig intestine?"
msgstr "Jak někdo může něco pojmenovat po prasečích střívkách?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:11
msgid "Yeah, ok."
msgstr "Jo, v pohodě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:12
msgid "Sorry to bother you, nevermind."
msgstr "Promiň, že obtěžuju, to nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:12
msgid "You shouldn't bother busy people!"
msgstr "Neobtěžuj zaměstnané lidi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:2
msgid ""
"I used to live there.  They have those awful magic mines! They were left behind after the Framish wars. Our side thought they would help keep the Framish out and all it does is keep our folk IN!"
msgstr ""
"Dřív jsem tam žila. Mají kolem ty hnusné magické miny. Zůstaly tam po framonských válkách. Mysleli jsme si, že to pomůže udržet Framonské venku, a zatím to akorát drží naše lidi UVNITŘ!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:2
msgid "We'd like to become Experts in Identify Monster."
msgstr "Chtěli bychom se stát experty v identifikaci nestvůr."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:3
msgid "You think you fit the requirements?  If so, I can help you."
msgstr "Myslíte si, že na to máte? Pokud ano, mohu vám pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:8
msgid "What kind of magic was used to make them?"
msgstr "Jaká magie byla na jejich vytvoření použita?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:4
msgid ""
"You should ask old Forblaith A'Mor, she would remember, she helped make them!"
msgstr ""
"Zeptej se na to staré Forblaith A'Mor, ona by si to měla pamatovat, protože je pomáhala vyrobit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:5
msgid "Hasn't anyone tried to remove them?"
msgstr "Pokoušel se je někdo odstranit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:5
msgid ""
"Well, none of the menfolk around here are brave enough to try! So we have to be so careful if we leave the village. The poor children can't even be allowed to play."
msgstr ""
"No, žádný chlap tady na to nemá dost odvahy! Tak musíme dávat pozor, když opouštíme vesnici. Ubohé děti si tam ani nemohou hrát."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:5
msgid ""
"To become Grandmasters in Identify Monster, you must find Ragfreid Manslayer in Yorwick."
msgstr ""
"Pokud se chcete stát velmistry v identifikaci nestvůr, musíte vyhledat Ragfreida Zabijáka v Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:5
msgid "Where can we find the Grandmaster in Identify Monster?"
msgstr "Kde bychom se mohli stát velmistry v identifikaci nestvůr?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC401.rude:3
msgid "We'd like to become Master in Identify Monster."
msgstr "Chtěli bychom se stát mistry v identifikaci nestvůr."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:8
msgid "You should ask old Forblaith, he would remember, he helped make them!"
msgstr ""
"Zeptej se na to staré Forblaith, ona by si to měla pamatovat, protože je pomáhala vyrobit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC320.rude:9
msgid ""
"They've been fighting with Thronheim for centuries.  The Thronish have slowly been settling there for ages."
msgstr ""
"Bojují s Thronheimem po staletí. Thronští se tam pomalu začínají usazovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:1
msgid ""
"Oh yes, I used to be able to play in the fields outside of the Yorwick when I was a little girl. I remember the joy and happiness of being able to run free with out a care in the world!"
msgstr ""
"Ó ano, jako malá holčička jsem si mohla hrát na polích kolem Yorwicku. Pamatuju si na tu radost, kterou jsem cítila, když jsem mohla jenom tak běhat kolem a nestarat se o svět!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:5
msgid "If you think you are qualified, I can help you."
msgstr "Pokud si myslíte, že na to máte, můžu vám pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:3
msgid "We'd like to become Experts in Learning."
msgstr "Chtěli bychom se stát experty ve vzdělávání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:3
msgid "It would be lovely if the children could play as I did."
msgstr "Bylo by to skvělé, kdyby si děti mohly hrát tak jako kdysi já."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:3
msgid "Thank you.  We will."
msgstr "Díky, udělám to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:4
msgid ""
"Oh I don't know. If I remember correctly old Forbhlaith A'Mor had to help make the awful things. Maybe you should ask her."
msgstr ""
"Tak to nevím. Pokud si dobře pamatuju, stará Forbhlaith A'Mor pomáhala dělat ty odporné věci. Zkuste se zeptat jí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:4
msgid "What can be done about it?"
msgstr "Co se s tím dá dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:7
msgid "Where can we become Grandmasters in Learning?"
msgstr "Kde se můžeme stát velmistry ve vzdělávání?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:7
msgid "You must find Jenne Harrise in Yorwick."
msgstr "Musíte najít Jenne Harrise z Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:5
msgid "We'd like to become Masters in Learning."
msgstr "Chtěli bychom se stát mistry ve vzdělávání."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC321.rude:9
msgid "You are so kind.  You're welcome.  Farewell."
msgstr "Jste tak hodní. Není zač děkovat. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC322.rude:1
msgid "Um. Not really."
msgstr "Uhm... Ani ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC322.rude:1
msgid "What would you know?"
msgstr "Co by vás zajímalo?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC322.rude:2
msgid "I feel it in my bones. Can't you?"
msgstr "Cítím to v kostech. Vy ne?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC322.rude:3
msgid "That's interesting."
msgstr "To je zajímavé."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC322.rude:3
msgid "What do you know about it?"
msgstr "Co o tom víte vy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:1
msgid "Do you think you're ready?"
msgstr "Myslíte si, že jste na to připraveni?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:1
msgid "We'd like to become Grandmasters in Perception"
msgstr "Chtěli bychom se stát velmistry ve vnímání"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:2
msgid "Yeah!  I got to get back to my plowing!"
msgstr "Jo! Musím se vrátit zpátky k práci!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:3
msgid ""
"If you paid more attention, you wouldn't have to ask questions like that."
msgstr "Kdybys dával lepší pozor, nemusel by ses ptát na takové blbosti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:4
msgid "Alright, but be quick about it!"
msgstr "Dobrá, ale pospěš si!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:6
msgid "See that you don't!"
msgstr "To ti radím!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC323.rude:6
msgid "We won't stop you then!"
msgstr "Tak to tě nebudu zdržovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC324.rude:1
msgid ""
"It's terrible about those magic mines!  I wish that someone would do something about them!"
msgstr ""
"S těmi magickými minami je to hrozné! Kdyby s nimi tak mohl někdo něco udělat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC324.rude:3
msgid ""
"I've lived here since I was a child.  We've never had much problem with Framon.  Why do we still need the mines?"
msgstr ""
"Žiju tady od dětství. S Framonem jsme nikdy neměli problémy. Na co pořád potřebujeme ty miny?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC324.rude:4
msgid "Yes, it is."
msgstr "Ano, to je."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC325.rude:1
msgid ""
"I think it's high time we sent those Framish settlers back to where they came from!"
msgstr "Myslím, že je načase poslat framonské osadníky tam, odkud přišli!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC325.rude:3
msgid ""
"Yorwick used to be part of Framon.  It's not anymore!  Why can't those Framish just leave?"
msgstr ""
"Yorwick býval součástí Framonu. Ale už to tak není! Tak proč Framonští neodejdou?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC325.rude:4
msgid "It sure is.  Good day."
msgstr "Určitě. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:1
msgid ""
"I really don't want to thatch the house.  It's a very unpleasant task, but the wife insist that it must be done."
msgstr ""
"Opravdu se mi nechce pokrývat střechu domu. Je to nepříjemná práce, ale moje žena trvá na tom, že je to třeba udělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:2
msgid "Make it quick."
msgstr "Ale pospěš si."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:3
msgid ""
"I'm originally from Thronheim.  Things were getting pretty bad there, though when I left.  That was before Kira became a Jarl."
msgstr ""
"Já pocházím z Thronheimu. Začínalo to tam vypadat dost špatně, než jsem odešel. To bylo předtím, než se Kira stala jarlou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:4
msgid "Don't suppose you'd help, would ya?  Didn't think so."
msgstr "Asi mi nechceš pomoct, co? Myslel jsem si to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:4
msgid "Good luck with the house."
msgstr "Hodně štěstí s domem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC326.rude:5
msgid "Anything to keep me from thatching the house."
msgstr "Cokoli, co mě na chvilku zdrží od té zatracené práce."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC329.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC409.rude:2
msgid "Are you skilled enough?"
msgstr "Máte na to dost zkušeností?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:1
msgid "We'd like to become Grandmasters in Repair Item"
msgstr "Chtěli bychom se stát velmistry v opravování věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:2
msgid "The wife will have my hide if I don't fix the chimney."
msgstr "Žena mě stáhne z kůže, jestli neopravím komín."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:3
msgid "Ask someone else!  I've got to fix my chimney!"
msgstr "Zeptej se někoho jiného, já musím opravit ten komín!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:3
msgid "What do you know about Framon."
msgstr "Co víš o Framonu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:4
msgid "Okay, but hurry!"
msgstr "Fajn, ale pohni s tím!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC327.rude:5
msgid "Good luck with the chimney."
msgstr "Hodně štěstí s komínem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC328.rude:1
msgid ""
"I need to get my plowing done, if I want my planting to be ready come harvest."
msgstr "Musím zorat pole včas, jestli chci mít nějakou úrodu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC328.rude:2
msgid "Huh?  Oh, all right."
msgstr "Huh? Oh, no dobrá."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC328.rude:3
msgid ""
"The farmlands here are great!  We're not starving like I was in Frosgard."
msgstr ""
"Půda je tady skvělá! Nehladovíme tak, jako když jsme byli ve Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC328.rude:4
msgid "Now where does Broccan live again..?"
msgstr "Kde žije ten Broccan..?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC328.rude:5
msgid "I wonder if Broccan will lend me the plow?"
msgstr "Zajímalo by mě, jestli mi Broccan půjčí pluh?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC329.rude:1
msgid "We'd like to become Grandmasters in Merchant"
msgstr "Chtěli bychom se stát velmistry v obchodování"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC329.rude:2
msgid ""
"Don't forget that the merchants you deal with also have skills of their own.  You can bet if they have a fancy shop, they know the worth of the stuff their selling."
msgstr ""
"Nezapomínejte, že obchodníci, se kterými budete jednat, mají také své zkušenosti. Pokud najdete nějaký slušný obchod, můžete se vsadit, že obchodník bude dobře znát cenu svého zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC329.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:2
msgid "I guess."
msgstr "Asi ano."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:1
msgid "Whatever you say."
msgstr "Nepovídej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:2
msgid "He wouldn't have made an error!  He was too good."
msgstr "Nemohl udělat chybu! Byl příliš dobrý!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:2
msgid "Maybe he just made an error."
msgstr "Možná prostě udělal chybu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:3
msgid "He was a great warrior!  There's no way he could die in battle!"
msgstr "Byl to velký válečník! V boji nikdy nemohl podlehnout!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:3
msgid "What makes you think that he was murdered?"
msgstr "Co tě vede k domněnce, že byl zavražděn?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:4
msgid ""
"My great grandfather was murdered so he wouldn't become Jarl of Thjorgard.  Everyone said at the time he died in battle, but I know the truth.  Sven's great-grandpa killed mine."
msgstr ""
"Můj velký praděd padl, takže se nemohl stát jarlem Thjorgardu. Všichni sice tvrdí, že položil život na bojišti, ale já znám pravdu. Mého pradědečka zabil Svenův praděd."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:5
msgid "I should be in the palace with the Jarl."
msgstr "Budu v paláci s jarlem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC33.rude:6
msgid "Hello.  Goodbye"
msgstr "Zdravím tě a sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC330.rude:1
msgid "Will do."
msgstr "Dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC330.rude:2
msgid "That husband of mine had better come home and fix the chimney!"
msgstr "Můj manžel už by se měl vrátit domů a spravit ten komín!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC330.rude:4
msgid "I know that whoever built our house here couldn't make a chimney!"
msgstr "Vím, že ať už stavěl náš dům kdokoli, komíny dělat neuměl!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC330.rude:5
msgid "We haven't seen him."
msgstr "Nikde jsme na něj nenarazili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC330.rude:5
msgid "Well if you do, tell him to come home and fix the chimney!"
msgstr "No pokud ho uvidíte, řekněte mu, ať nakluše domů a spraví komín!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC331.rude:1
msgid "These Thronish invaders are here to stay, I expect."
msgstr "Ti Thronští tady podle mě zůstanou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC331.rude:3
msgid ""
"My father used to tell me stories of the days when we were really part of Framon.  We had Framish guards here and everything!"
msgstr ""
"Můj otec mi vyprávěl o dobách, kdy jsme patřili k Framonu. Měli jsme tady framonské stráže a tak!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC331.rude:4
msgid "Tragic!  Sorry to bother you."
msgstr "To je tragédie! Promiň, že jsem obtěžoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC331.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:9
msgid "See you."
msgstr "Měj se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC332.rude:1
msgid ""
"I came here from Framon expecting to get a job easy.  For a Framish city, there's a lot of people here who don't like me!"
msgstr ""
"Přišel jsem sem z Framonu a čekal jsem, že snadno seženu práci. Na framonské město je tady až moc lidí, kterým se nelíbím!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC332.rude:3
msgid "Sorry.  We don't know anyone who is looking to hire you."
msgstr "Bohužel nevíme o nikom, kdo by si tě chtěl najmout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC332.rude:3
msgid "That's a shame.  I'm a good worker, you know!"
msgstr "To je ostuda. Jsem dobrý pracant!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC333.rude:1
msgid "If you have quick fingers, I may teach you."
msgstr "Pokud máte dost rychlé prsty, můžu vás učit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC333.rude:1
msgid "We'd like to become Grandmasters in Disarm Trap"
msgstr "Chtěli bychom se stát velmistry ve zneškodňování pastí"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC333.rude:2
msgid ""
"I'm ready to get rid of all these Thronish visitors.  I think they have outstayed their welcome."
msgstr ""
"Chci se zbavit těch thronských návštěvníků! Podle mě už tady nejsou vítáni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC333.rude:3
msgid ""
"It is a part of the nation of Framon.  And it will stay a part of Framon!"
msgstr "Je to součást Framonu! To se nikdy nezmění!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC333.rude:4
msgid "I suppose so."
msgstr "Snad ano."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:1
msgid ""
"On the day Krohn foresaw the coming of the Great Reckoning, he demanded that we all fashion weapons.  Gungnir was the spear I made for myself.  Of course I lost it, and I can't go off looking for it, can I?"
msgstr ""
"Když Krohn předpověděl Velké zúčtování, chtěl, abychom si všichni vyrobili zbraně. Gungnir bylo kopí, které jsem si udělal pro sebe. Ztratil jsem je, ale nemůžu je jít hledat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:1
msgid "What's Gungnir?"
msgstr "Co je to Gungnir?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:10
msgid ""
"It's also called The Day of Wrath.  There will come a day when Njam will break out...umm...."
msgstr "Taky se mu říká Den hněvu. Nastane tehdy, až se Njam uvolní... uhmm."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:10
msgid "What's the Great Reckoning?"
msgstr "Co je to Velké zúčtování?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:11
msgid "How could you help?"
msgstr "Jak bys mohl pomoct?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:11
msgid "Maybe we could help?"
msgstr "Možná bychom mohli pomoct?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:12
msgid ""
"Well what do you expect of me?  I sit here day after day after day.  From the beginning of time until the Great Reckoning.  I've seen your kind come through here millions of times."
msgstr ""
"A co ode mě čekáte? Sedím tady den za dnem. Od začátku času až do doby Velkého zúčtování. Takové, jako jste vy, už jsem tady viděl milionkrát."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:12
msgid "You don't seem to like us very much."
msgstr "Vypadá to, že se ti moc nelíbím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:13
msgid "Does your spear look like this?"
msgstr "Nevypadá tvé kopí nějak takhle?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:13
msgid ""
"Where did you find that?  Give that here.  No mortal should have the use of that."
msgstr "Kde jste ho našli? Dejte to sem. Žádný smrtelník by ho neměl mít!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:14
msgid "I trust it wasn't too easy to find.  A fine job.  Here's your reward."
msgstr "Věřím, že ho nebylo lehké najít. Dobrá práce. Tady je vaše odměna."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:14
msgid "We found your spear."
msgstr "Našli jsme to kopí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:15
msgid "What do I look like, a tour guide?  No!"
msgstr "Připadám ti snad jako nějaký zdejší průvodce? Ne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:16
msgid "That's right!  Now get lost!"
msgstr "V pořádku! A teď zmiz!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:3
msgid ""
"Like I told you!  You're not on my list.  If you want to get in here, you need to visit the Wyrdes and get a Writ of Fate!"
msgstr ""
"Jak už jsem vám říkal! Nejste na mém seznamu! Jestli se sem chcete dostat, musíte navštívit Wyrdy a získat Písmo osudu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:3
msgid "We need to get into Arslegard."
msgstr "Potřebujeme se dostat do Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:4
msgid ""
"Perhaps I displeased him once.  But the wrath he has shown me in the past isn't going to match what happens when he finds out I lost Gungnir!  What am I going to do when the Great Reckoning comes?"
msgstr ""
"Snad jsem ho jednou trochu zklamal. Ale zášť, kterou ke mně cítí teď, nebude nic v porovnání s tím, co bude, až zjistí, že jsem ztratil Gungnir! Co budu dělat, až nastane Velké zúčtování?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:4
msgid "That's unfortunate.  You must have really upset Krohn."
msgstr "To je nešťastné. To jsi musel Krohna opravdu naštvat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:5
msgid ""
"I mean, there will come a day when Njam will lead a revolt against the gods.  On that day a great battle is fated to be fought.  Krohn demanded that we gods fashion weapons for ourselves.  Of course I lost mine."
msgstr ""
"Chci říct, že nastane den, kdy Njam povede válku proti bohům. Toho dne má být vybojována velká bitva. Krohn chtěl, abychom si my bohové vyrobili pro sebe zbraně. A já svou ztratil."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:6
msgid "We could find it for you."
msgstr "Možná bychom ho pro tebe mohli najít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:6
msgid ""
"Yes!  I suppose you could.  I think you may want to ask Fre.  She might have some idea where you can start looking.  Now don't dawdle!"
msgstr ""
"Ano! To bys mohl. Myslím, že bude vhodné zeptat se Fré. Mohla by mít tušení, kde začít. Tak neváhej!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:7
msgid ""
"Don't get impertinent with me!  Seeing as how you did find it, however, I will give you a small reward."
msgstr "Nebuďte drzí! Ale když už jste ho našli, tak vám dám malou odměnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:7
msgid "Not even a thank you?"
msgstr "To ani nepoděkuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:8
msgid "Maybe we couldn't.  Never mind."
msgstr "A možná ne. Tak nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:8
msgid "That's what I figured.  Goodbye."
msgstr "To jsem si myslel. Na shledanou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:9
msgid ""
"Oh yes, you HAVE to wander around and show off your Writ of Fate, don't you?  Very well, I shall let you in."
msgstr ""
"Oh ano, MUSÍTE se poflakovat kolem a ukazovat své Písmo osudu, co? Dobře, pustím vás dovnitř."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC334.rude:9
msgid "We want to get in to Arslegard."
msgstr "Chceme se dostat do Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:10
msgid "About Njam again.."
msgstr "Znovu k tomu Njamovi..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:11
msgid ""
"I am aware.  Congratulations.  I do not have time to speak with mortals.  Farewell."
msgstr "To vím. Gratuluji. Nemám čas bavit se se smrtelníkem. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:11
msgid "We have imprisoned Njam."
msgstr "Uvěznili jsme Njama."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:12
msgid "Step easy around here, mortals."
msgstr "Dávej si pozor, smrtelníku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:2
msgid "What are we to do again?"
msgstr "Co máme zase udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:2
msgid ""
"You are to find a way to lure Njam to the Tomb of a Thousand Terrors and imprison him there."
msgstr ""
"Musíte najít způsob, jak nalákat Njama do Hrobky tisíce hrůz a uvěznit ho tam."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:3
msgid "Njam the Meddler?"
msgstr "Njama Kibice?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:3
msgid ""
"Yes.  He is the god of mischief.  It is high time he has paid for the problems he has caused.  You are a brave group.  This task I will give to you."
msgstr ""
"Ano. Je to bůh zlomyslnosti. Je na čase, aby zaplatil za problémy, které způsobil. Jste odvážná družina. Tento úkol dávám vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:4
msgid ""
"Of course you will.  Be wary, Njam the Meddler is a very tricky individual.  Again if you find yourself face to face with him, run.  Remember that he still is a god.  When you are finished return to me, I will have something for you.  Good luck."
msgstr ""
"Samozřejmě. Dejte si pozor, Njam Kibic je lstivý. Jak jsem říkal, pokud mu stanete tváří v tvář, vezměte nohy na ramena. Pamatujte, že je to bůh. Až se vám to podaří, vraťte se ke mně, budu pro vás něco mít. Hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:5
msgid "How are we supposed to get him to follow us?"
msgstr "Jak ho máme přesvědčit, aby nás sledoval?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:5
msgid ""
"I don't know.  There must be something you can find.  Go to his house here in Arslegard.  Take this key, you will need it to unlock the door.  But beware of him.  He is certain to know what you are up to.  If you happen to stumble onto him, run."
msgstr ""
"Nevím. Musíte něco najít. Jděte do jeho domu tady v Aslegardu. Vezměte si tenhle klíč - budete ho potřebovat. Ale dejte si na Njama pozor. Určitě bude vědět, na co se chystáte. Pokud na něj narazíte, utíkejte."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:6
msgid "What task?"
msgstr "Jaký úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:6
msgid ""
"You are to get Njam to follow you into the Tomb of a Thousand Terrors.  Once there, lead him to the heart of the tomb and imprison him in it."
msgstr ""
"Musíte přesvědčit Njama, aby vás sledoval do Hrobky tisíce hrůz. Jakmile bude tam, zaveďte ho dovnitř a uvězněte ho tam."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:7
msgid ""
"Hmmm.  These are obviously not real.  They look to be the work of Njam the Meddler."
msgstr ""
"Hmmm. Je jasné, že nejsou pravá. Vypadá to, že je to práce Njama Kibice."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:7
msgid "Yes sir!"
msgstr "Ano, pane!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:8
msgid "And I see that he has a Writ of Fate also.  Let me see those!"
msgstr "A jak vidím, on má také Písmo osudu! Ukaž mi je!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:8
msgid "We have a Writ of Fate!  It says we're supposed to stop him!"
msgstr "Máme Písmo osudu! A podle písma ho máme zastavit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:9
msgid ""
"Ah yes, Tamur Leng and the band of noble adventurers!  Just what do you think you are all doing?  Are you trying to make Hallenhalt burst at the seams?!"
msgstr ""
"Ach ano, Tamur Leng a parta šlechetných dobrodruhů! A co si myslíš, že děláš? Pokoušíš se rozmlátit Hallenhalt?!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC335.rude:9
msgid "As you have summoned us, so we have come."
msgstr "Když jsi nás přivolal, tak jsme přišli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:25
msgid "I shall see you again, mortals."
msgstr "Ještě se uvidíme, smrtelníku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:12
msgid ""
" I shall warn you, however.  Should they die again, I will keep them.  You will find their leader, Sven Forkbeard waiting for you outside the gates to Hallenhalt."
msgstr ""
"Ale musím vás varovat. Pokud znovu zemřou, nechám je tady. Najděte jejich vůdce Svena Vidlobrada, čeká na vás před branami do Hallenhaltu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:13
msgid "Very well.  Let us travel to the Afterworld."
msgstr "Velmi dobře. Odcestuji tedy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:14
msgid ""
"You need help from me?  Not that I would give it, but what do you need?"
msgstr ""
"Potřebujete pomoc ode mě? Ne, že bych se vám snad chystal pomoct, ale co potřebujete?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:15
msgid "As I figured."
msgstr "To jsem si myslel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:15
msgid "Maybe we'll do this another time."
msgstr "Možná to udělám jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:16
msgid "Behold, Your Guilt."
msgstr "Sledujte. Vaše vina."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:16
msgid "What do we do now?"
msgstr "Co máme dělat teď?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:17
msgid "Farewell, mortals."
msgstr "Sbohem, smrtelníci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:18
msgid "No, it was not our fault."
msgstr "Ne, to nebyla naše vina."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:18
msgid "Why must you waste my time?  Begone with you!"
msgstr "Proč musíte plýtvat mým časem? Táhněte!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:19
msgid ""
"Do not defend your actions, mortals, for that is a certain path to failure.  Now answer me this.  Are you resposible for what we have just seen?"
msgstr ""
"Nehajte své činy, smrtelníci, jelikož to je cesta, která vede k selhání. A teď mi zodpovězte tuto otázku: Jste zodpovědní za to, co jsme právě viděli?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:19
msgid "How were we to know that Forad Darre was a traitor?"
msgstr "Jak jsme mohli vědět, že je Forad Darre zrádce?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:2
msgid "Yes, but how...?"
msgstr "Ano, ale jak...?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:20
msgid "So you have.  Now go, and suffer."
msgstr "Ano. A teď běž a zažij utrpení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:20
msgid "We have confessed our guilt."
msgstr "Vyzpovídali jsme se z viny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:21
msgid ""
"Perhaps you have.  Scattered here are the soldiers who helped in your betrayal.  Retribution demands that you slay them."
msgstr ""
"Možná. Na tomto místě jsou přítomni vojáci, kteří pomáhali při zradě. Odplata žádá jejich smrt."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:21
msgid "We have known suffering."
msgstr "Poznali jsme utrpení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:22
msgid ""
"Retribution is yours.  Beware, these were just ghosts, reflections of reality.  Forad Darre still exists.  Your next task is to face your absolution.  Out there is the battlefield.  Find the weapons of the fallen Jarls and bring them back to me."
msgstr ""
"Odplata je vaše. Buďte si ale vědomi, že to byli pouze duchové, odrazy reality. Forad Darre stále žije. Vaším dalším úkolem bude získat rozhřešení. Tam venku je bitevní pole. Najděte zbraně padlých jarlů a přineste mi je sem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:22
msgid "We have slain the soldiers."
msgstr "Zabili jsme vojáky."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:23
msgid "We have collected the swords."
msgstr "Získali jsme meče."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:23
msgid ""
"You have been absolved.  Out there is a blazing inferno.  Step through to be reborn."
msgstr ""
"Získali jste rozhřešení. Tam venku je žhnoucí peklo. Vstupte dovnitř a budete znovuzrozeni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:24
msgid ""
"I must admit, I had little faith in you, but the Six Fires are blazing.  Very well, I shall let you take your soldiers back to your world."
msgstr ""
"Musím se přiznat, že jsem ve vás moc důvěru neměl, ale šestero ohňů plane. Velmi dobře, dovolím vám odvést si své vojáky zpět na svět."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:24
msgid "We have lit the Six Fires of Penance."
msgstr "Zapálili jsme šestero ohňů pokání."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:3
msgid "Our Guilt?!"
msgstr "Naše vina?!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:4
msgid ""
"They are the fires a soul must light in order to progress to Hallenhalt.  They are Guilt, Confession, Suffering, Retribution, Absolution, and Rebirth."
msgstr ""
"Jsou to ohně, které musí duše při vstoupení na Hallenhalt zapálit. A je to Vina, Vyznání, Utrpení, Odplata, Rozhřešení a Znovuzrození. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:4
msgid "What are they again?"
msgstr "Co že to vlastně je?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:5
msgid "We've come to ask for the return of our warriors."
msgstr "Přicházím žádat o návrat mých válečníků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:5
msgid ""
"You've lost a battle and you want me to return your slain army back to life?  Is that how things are done down there now?"
msgstr ""
"Prohráli jste bitvu a chcete po mně, abych oživil vaši poraženou armádu? Tak se nyní řídí věci tam u vás dole?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:6
msgid ""
"Is that so now?  Well, I could do as you ask, but are you prepared to do what is required?"
msgstr ""
"Takže tak? No, mohl bych to udělat, ale jste připraveni splnit to, co je žádáno?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:6
msgid "Our Writ of Fate says it is our destiny to stop Tamur Leng!"
msgstr "Mé Písmo osudu tvrdí, že je mým osudem zastavit Tamura Lenga!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:7
msgid ""
"Very well.  The task that will be laid before is to light the Six Fires of Penance."
msgstr "Velmi dobře. Musíte zapálit šestero ohňů pokání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:7
msgid "We will do whatever is required."
msgstr "Udělám cokoli, co je třeba."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:8
msgid ""
"Very well, then.  If you are truly responsible, then find those who you have failed.  Confess to them your guilt.  Go, and return to me."
msgstr ""
"Velmi dobře tedy. Pokud to tedy opravdu chcete, pokuste se najít ty, které jste zklamali. Vyzpovídejte se jim ze své viny. Jděte a pak se vraťte ke mně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC336.rude:9
msgid ""
"If a soul wishes to progress in the Afterworld and ascend to Hallenhalt, they may try to light the Six Fires of Penance.  These are Guilt, Confession, Suffering, Retribution, Absolution, and Rebirth.  Are you willing to light these in their stead?"
msgstr ""
"Pokud chtějí duše vstoupit na Hallenhalt, musí se pokusit o zapálení šesti ohňů pokání. Jsou to Vina, Vyznání, Utrpení, Odplata, Rozhřešení a Znovuzrození. Jste ochotni zapálit je za ně?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:1
msgid ""
"I cannot answer that.  Besides, what makes you think he is not acting of his own accord?"
msgstr ""
"Na to nemůžu odpovědět. Kromě toho, proč si myslíš, že nejedná sám za sebe?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:1
msgid "Who is behind Tamur Leng?"
msgstr "Kdo je za Tamurem Lengem?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:10
msgid ""
"I have a task for you.  If you can complete the task, I will answer three questions for you."
msgstr "Mám pro vás úkol. Pokud ho splníte, odpovím vám na tři otázky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:11
msgid "Perhaps we can do your task another time."
msgstr "Možná to pro tebe udělám příště."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:11
msgid "Should you wish your questions answered, return."
msgstr "Pokud budete chtít odpověď na své otázky, vraťte se."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:12
msgid "We have retrieved the Golden Honk."
msgstr "Získali jsme tu modlu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:12
msgid "Wonderful.  As a reward, I shall answer three questions."
msgstr "Skvělé. Za odměnu ti odpovím na tři otázky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:13
msgid "If you persevere?  Yes."
msgstr "Pokud vytrváš? Ano."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:13
msgid "Will we succeed in stopping Tamur Leng?"
msgstr "Uspějeme? Podaří se nám zastavit Tamura Lenga?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:14
msgid "You are welcome children.  Farewell."
msgstr "Nemáte zač děkovat, děti. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:14
msgid "Does it look like this?"
msgstr "Vypadalo to takhle nějak?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:15
msgid ""
"That's it!  You must have read my mind!  Very well.  I shall answer three questions for you."
msgstr ""
"To je ono! Museli jste mi číst myšlenky! Velmi dobře. Odpovím vám na tři otázky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:16
msgid "The answers have not changed, children, but very well."
msgstr "Odpovědi se nezměnily, mé dítě, ale dobrá."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:17
msgid ""
"Should you succeed, I see the clans united.  A leader shall emerge, borne of two Jarls.  She shall draw the sword and become Queen of all Chedian."
msgstr ""
"Pokud uspěješ, budou klany sjednoceny. A objeví se vůdkyně, zrozená ze dvou jarlů. Vytasí meč a stane se královnou celého Chedianu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:17
msgid "What does the future hold for Chedian?"
msgstr "Jaká budoucnost čeká Chedian?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:18
msgid "You are welcome, mortals."
msgstr "Není zač děkovat, smrtelníci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:19
msgid ""
"Gungnir?  That old fool lost it!  As if that's a surprise.  Good thing Krohn doesn't know.  I don't envy Hanndl's punishment for that!"
msgstr ""
"Gungnir? Ten starý hlupák ho ztratil! Jako by to někoho překvapovalo. Dobře že to Krohn neví. Nechtěla bych být na Hanndlově místě, až na to přijde."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:19
msgid "What happened to Hanndl's spear?"
msgstr "Co se stalo s Hanndlovým kopím?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:2
msgid "In western Chedian?  You mean Thronheim?"
msgstr "Západní Chedian? Myslíš Thronheim?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:2
msgid ""
"That was before that fool Verhoffin resurfaced the geography.  Who knows where those ruins are now."
msgstr ""
"To bylo předtím, než ten blbec Verhoffin poničil celý povrch. Kdo ví, kde jsou ty ruiny teď."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:3
msgid "Any idea where it is?"
msgstr "Nemáš tušení, kde teď je?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:3
msgid ""
"Well, it wasn't that long ago, at least for us, only 800 years ago or so.  Some group of soldiers for the Ursanian Empire picked it up, and took it to their storehouse in the western part of the land you now call Chedian."
msgstr ""
"No, nebylo to zase tak dávno, alespoň pro nás, jenom před nějakými osmi sty léty nebo tak nějak. Vzala ho skupina vojáků Ursanské říše a odnesla ho do západní části země, které teď říkáte Chedian."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:4
msgid ""
"There is a new religious group called Honkies, or Honkers or something of that nature.  They have begun to worship Philip, our pet goose."
msgstr ""
"Vzniklo nové náboženství, říkají si kejháci, kejhovité, nebo tak nějak. Začali uctívat Philipa, naše domácí zvířátko, husu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:4
msgid "We would be glad to do your task."
msgstr "S potěšením splním tvůj úkol."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:5
msgid ""
"This is becoming a problem, as it is taking their time away from those that they should be worshipping, namely us!  I wish to teach them a lesson.  Go back down there, get into the Temple of Honk, and bring back to me the icon they worship."
msgstr ""
"Začíná se z toho stávat problém, jelikož je to zdržuje od pravého uctívání, čili uctívání nás! Chci jim uštědřit lekci. Vraťte se tam dolů, běžte do chrámu kejhovitů a přineste mi zpátky modlu, kterou uctívají."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:5
msgid "We've heard of them."
msgstr "Neslyšeli jsme o nich."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:7
msgid "Those are questions I cannot answer."
msgstr "To jsou věci, na něž nemohu odpovědět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:7
msgid "What sword?  What two Jarls?"
msgstr "Jaký meč? Jací dva jarlové?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:8
msgid ""
"It is a golden statue of Philip, an artifact which they have named the Golden Honk.  Bring it back to me.  And if they should put up some resistance, give them some divine justice.  Once they get here, they will pay for their neglect."
msgstr ""
"Je to zlatá soška Philipa, artefakt, kterému říkají Velký Kejhova. Přineste mi ji. A pokud by snad kladli odpor, seznamte je s božskou spravedlností! Jakmile se dostanou sem, zaplatí za to, co udělali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:8
msgid "What does it look like?"
msgstr "Jak ta modla vypadá?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:9
msgid "See that you do it quickly.  Now be off with you."
msgstr "Udělej to rychle. A teď běž."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC337.rude:9
msgid "Thank you for this opportunity."
msgstr "Díky za příležitost."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:2
msgid ""
"How can you save the world when you can't find your way around a place as simple as this?  Go through the magic portal behind me.  It will take you where you need to go."
msgstr ""
"Jak můžete zachránit svět, když se nedokážete dostat ani z tak jednoduchého místa, jako je tohle? Projděte magickým portálem za mnou. Odnese vás tam, kam potřebujete jít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:3
msgid "Stop wasting time with your flowery speeches.  Get on with it!"
msgstr "Přestaň plýtvat časem nesmyslnými květnatými proslovy! Pohni sebou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:3
msgid "We will do this.  Thank you for your time."
msgstr "Udělám to. Díky za ochotu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:4
msgid ""
"It's a convenient place to store it until I need it later.  Take it to Verhoffin's Ruins, and place it on the pedestal in the Lab Room.  Once the Capstone of Order is placed, your Writ of Fate will present itself."
msgstr ""
"Je to vhodné místo, kam takovou věc schovat, než ji budu potřebovat. Odneste ji do Verhoffinových ruin a umístěte ji na podstavec v laboratoři. Jakmile umístíte Kámen řádu na správné místo, objeví se vaše Písmo osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:4
msgid "Why the Isle of Ashes?"
msgstr "Proč Ostrov popela?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:5
msgid ""
"I am rather fond of the Capstone of Order, a magical device that insures orderliness.  It seems to have fallen from Arslegard and landed in Guberland.  Go to The Gathering in Guberland, retrieve the Capstone, and take it to the Isle of Ashes."
msgstr ""
"Kámen řádu je magický prostředek zajišťující řád. Spadl z Arslegardu a přistál v Guberlandu. Jdi na Shromáždění v Guberlandu, získej Kámen a odnes ho na Ostrov popela."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:6
msgid "We've come seeking a Writ of Fate."
msgstr "Přišli jsme si pro Písmo osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:6
msgid ""
"Yes, yes, I know.  That wort Hanndl won't let you in without one.  I can assure you that there is a Writ of Fate with your names on it.  I shall give it to you.  But first, there is something you will do for me."
msgstr ""
"Ano, ano, vím. Ten mladíček Hanndl vás bez něj nepustí. Mohu vás ujistit, že existuje Písmo osudu s vašimi jmény. Dám vám ho. Ale nejdřív pro mě musíte něco udělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:7
msgid "Uhh, one more thing?"
msgstr "Uh, ještě jedna věc?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC338.rude:8
msgid "Farewell, Adventurers."
msgstr "Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:10
msgid "We'd like a room."
msgstr "Chceme pokoj."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:11
msgid "My plans for the bathhouse are going well now, thanks to you."
msgstr "Mé plány s lázněmi vycházejí, díky vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:13
msgid "We cleaned out your bathhouse."
msgstr "Vyčistili jsme tvé lázně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:13
msgid ""
"You succeeded?  You must be very strong!  Thank you.  Here's your reward."
msgstr ""
"Uspěli jste? Tak to musíte být hodně silní! Díky. Tady je vaše odměna."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:2
msgid "Thanks!  Come back here for your money!"
msgstr "Díky! Přijď si pak pro peníze!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:2
msgid "Why not?  We'd be happy to!"
msgstr "Proč ne? S radostí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:3
msgid ""
"Say, you look like the strong type!  I don't suppose you'd want to go in there and show those monsters who owns that place would you?  I'd pay you well!"
msgstr ""
"Hele, vy vypadáte na docela silnou družinu. Asi by se vám nechtělo vlézt do toho zatraceného místa a ukázat monstrům, zač je toho loket? Dobře vám zaplatím!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:3
msgid "Sounds like you're in a heap of trouble alright."
msgstr "Vypadá to, že jsi po krk v problémech."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:4
msgid "Why doesn't he help you?"
msgstr "Proč vám nepomůže?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:4
msgid ""
"You ever try asking a god for anything?  Didn't think so.  Krohn says it's my problem and I have to deal with it.  But I'm not going in there!  That Ebora and her concubines would tear me to shreds."
msgstr ""
"Už ses někdy ptal na něco boha? To si nemyslím. Krohn říká, že je to můj problém a já si s tím musím poradit. Ale já  tam nepůjdu! Ta Ebora a její konkubíny by mě roztrhaly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:5
msgid ""
"Well, the guy I bought it from didn't secure the doors before he closed down for good.  Now some creature called Ebora has taken up residence there.  Krohn himself is anxious to take a bath, and wants the thing operational."
msgstr ""
"No, ten chlapík, od kterého jsem to koupil, nezabezpečil dveře předtím, než zavřel. Teď se tam nějaká bytost jménem Ebora usadila. Krohn sám silně touží po koupeli a chce tyto lázně zprovoznit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:5
msgid "What sort of problem?"
msgstr "Co je to za problém?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:6
msgid ""
"I've got this bathhouse I bought which seems to have a little problem."
msgstr "Koupil jsem si lázně a vypadá to, že s nimi mám malý problém."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:7
msgid "That old place?  We already cleaned it out."
msgstr "To staré místo? To už jsme vyčistili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:7
msgid ""
"You did?  That's wonderful!  Here, I've got a reward for you.  Thank you!"
msgstr ""
"Dokázali jste to? To je skvělé! Tady mám pro vás odměnu. Děkuju mockrát!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:8
msgid "We're too busy for that sort of thing."
msgstr "Na něco takového nemáme čas."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:8
msgid ""
"Well alright.  Maybe you'd like to contribute to my wealth by buying a drink?"
msgstr "Tak dobře. Nechceš mi přispět na důchod a koupit si drink?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC339.rude:9
msgid ""
"You've got to be on your toes around here if you own anything.  If the gods don't like your service, they'll send you to the Afterworld."
msgstr ""
"Pokud tady máte nějaké řízení, musíte si dávat pozor. Pokud se bohům nebudou zamlouvat vaše služby, pošlou vás do podsvětí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:1
msgid ""
"Dunno.  Maybe he hasn't found the right group of people to go get it yet."
msgstr ""
"Nevím. Možná ještě nenašel tu pravou partu lidí, kteří by ho pro něj získali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:1
msgid "Why hasn't Sven got Thjorad back already?"
msgstr "Proč Sven Thjorad ještě nezískal zpět?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:10
msgid ""
"Our Jarl?  His real name is Sven Svenssen.  I heard that he wants to get Thjorad back."
msgstr ""
"O našem Jarlovi? Jeho pravé jméno je Sven Svenssen. Slyšel jsem, že chce Thjorad získat zpět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:10
msgid "Nothing.  Goodbye"
msgstr "Nic. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:2
msgid "How could a bunch of monks steal a precious artifact?"
msgstr "Jak by mohla skupinka mnichů ukrást mocný artefakt?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:2
msgid ""
"I don't know, but I think they did!  There's no way we would have let them have it!"
msgstr "Nevím, ale mám za to, že mohla! Jak by k němu jinak přišli!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:3
msgid "Maybe we could ask you something else"
msgstr "Možná bychom se tě mohli zeptat na něco jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:4
msgid "Forget it!  I wouldn't want to work there!"
msgstr "Zapomeň na to! Nechtěl bych tam pracovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:4
msgid "Maybe you should try to get a job as a foreman."
msgstr "Možná by sis měl zkusit pracovat jako předák."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:5
msgid ""
"I know those lazy miners have stopped working for some reason!  I tell you, If I was in charge, they would be working as hard as can be!"
msgstr ""
"Vím, že ti líní horníci z nějakého důvodu přestali pracovat! Povídám ti, kdybych se do toho mohl vložit, makali by tak tvrdě, jak to jen jde!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:3
msgid "We wanted to ask you about something."
msgstr "Chtěli jsme se tě na něco optat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:10
msgid "Nice talking to you."
msgstr "Rád jsem si s tebou pohovořil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:8
msgid ""
"That is a mighty artifact.  My father used to tell me that once Lindisfarne and Thjorgard were friends!  Ha!  He said that we loaned Thjorad to them.  Personally, I think they stole it!"
msgstr ""
"To je mocný artefakt. Můj otec mi jednou vyprávěl, že Lindisfarn a Thjorgard spolu kdysi žili v míru! Prý jsme jim Thjorad pronajali. Já osobně si ale myslím, že jej ukradli!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC34.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:6
msgid "What do you know about Thjorad?"
msgstr "Pověděl bys mi něco o Thjoradu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:1
msgid ""
"I hear Hanndl lost the spear he's supposed to have for the Great Reckoning.  I'm sure Krohn is not pleased with him.  Hanndl can't be happy either!  It's not like he can go out and look for it!"
msgstr ""
"Hanndl prý ztratil kopí, které má mít na Velké zúčtování. Krohn s tím určitě nebude spokojený a Hanndl sám taky moc radost mít nebude! Nemůže se jen tak sebrat a jít to kopí hledat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:3
msgid "Watch out for Hanndl.  He's a grump!"
msgstr "Dávej si pozor na Hanndla. Je to starý mrzout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:5
msgid "Come back soon, cheapskates!"
msgstr "Zase někdy přijď, lakomče..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC340.rude:6
msgid "Take a look at my weapons!"
msgstr "Podívej se na mé zbraně!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC341.rude:1
msgid ""
"I hear the bartender is having a heck of a time with that new bathhouse he's bought.  I told him he wasn't going to have anything but trouble with it.  But he insisted on buying it, and now he's got Krohn himself breathing down his neck!"
msgstr ""
"Hostinský má prý strašné problémy s těmi lázněmi, které nedávno koupil. Říkal jsem mu, že s nimi budou jenom nesnáze. Ale on trval na tom, že si je prostě musí koupit, a teď už na něj doráží samotný Krohn!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC341.rude:2
msgid "We'd like to see your armor."
msgstr "Chtěli bychom vidět tvé zbroje."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC341.rude:3
msgid ""
"Well, they generally stay away from us.  We don't really have anything they can't get themselves.  But don't go looking for them.  They might just send you to the Afterworld!"
msgstr ""
"No, většinou se nám vyhýbají. Vlastně nemáme nic, co by si nemohli obstarat sami. Ale moc jim raději na oči nechoďte. Pokud se naštvou, mohou vás poslat pryč, do podsvětí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC341.rude:6
msgid "Have a look at some armor!"
msgstr "Podívej se na mé zbroje!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC342.rude:1
msgid ""
"I hear Fre is really upset at the Honkies down in Guberland.  She's upset that they're paying more attention to that goose than to her!  Those poor souls!  I don't envy them when she finds someone to take care of them!"
msgstr ""
"Fré prý opravdu štvou kejhovité dole v Guberlandu. Je hrozně rozčilená, že věnují víc pozornosti husám než jí! Ubohé dušičky! Nechtěla bych být v jejich kůži, až najde někoho, kdo to s nimi vyřídí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC342.rude:3
msgid ""
"I can't believe they won't let me into Hallenhalt!  I was a brave and noble person in life!"
msgstr ""
"Nemůžu uvěřit, že mě nechtějí pustit do Hallenhaltu! Zaživa jsem byla odvážná a šlechetná!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC343.rude:1
msgid ""
"In life, I was one of the greatest mages in all of Chedian.  Look at me now!  I have to sell magic books just to get by!"
msgstr ""
"Zaživa jsem byla jedním z nejmocnějších mágů v celém Chedianu. A  teď musím prodávat magické knihy, abych se vůbec protloukla!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC343.rude:2
msgid "Of course!  Take a look."
msgstr "Jistě! Jen se tady rozhlédni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC343.rude:3
msgid "Don't upset the gods."
msgstr "Nenaštvi bohy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC344.rude:1
msgid ""
"I saw Fre walk through here the other day as angry as can be.  She was mumbling something about honkies.  I wonder what she was upset about?"
msgstr ""
"Nedávno jsem viděla Fré, byla bez sebe vzteky. Mumlala si něco o kejhovitech. Zajímalo by mě, co jí to tak rozčílilo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC344.rude:3
msgid ""
"Fre is the best of the gods.  She always is around whenever I need some help."
msgstr "Fré je nejlepší z bohů. Vždycky mi pomůže, když to potřebuju."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:1
msgid "I was killed in a storm, when the boat I was on sank."
msgstr "Zahynul jsem v bouři, která potopila mou loď."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC350.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:3
msgid "Have a look!"
msgstr "Tak se podívej!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:3
msgid "It's hard work having a job up here.  Dead people are very demanding."
msgstr "Práce tady je strašně těžká. Mrtví mají velké nároky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC345.rude:5
msgid "See you later!"
msgstr "Na viděnou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC346.rude:1
msgid ""
"When most people arrive here, they're shocked that there's a bank.  I don't know why.  It's not like we don't have an economy or anything!"
msgstr ""
"Když sem lidi dorazí, většinou je šokuje, že je tady banka. Nechápu proč. Vždyť máme taky nějakou ekonomii, a tak potřebujeme banku, ne?!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC346.rude:3
msgid "They are the ones who decide the fates of mortals."
msgstr "To ony rozhodují o osudu smrtelníků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC346.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC367.rude:3
msgid "What do you know about the Wyrdes?"
msgstr "Co víš o Wyrdách?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC346.rude:4
msgid "Already got one, thanks!"
msgstr "Už tu jeden mám, díky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC346.rude:7
msgid "A pleasure!  Anything else?"
msgstr "Těšilo mě! Ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC347.rude:1
msgid ""
"Is that so?   I think I will be the one who makes the choice of whether or not you are ready."
msgstr ""
"Tak? Já myslím, že to já rozhodnu, jestli jste nebo nejste připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC347.rude:1
msgid "We'd like to become Blade Grandmasters."
msgstr "Chtěli bychom se stát velmistry v ovládání meče."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC347.rude:2
msgid "Waste them on someone else."
msgstr "Jdi plýtvat časem někoho jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC347.rude:3
msgid "Yeah.  See you."
msgstr "Jo. Zdar."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:1
msgid "What sort of news do you think a dead priest has?"
msgstr "Jaké novinky podle vás může mít mrtvý kněz?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:2
msgid "We'd like some healing."
msgstr "Potřebovali bychom vyléčit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:3
msgid "It's a wonderful place!"
msgstr "Je to skvělé místo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:4
msgid "Blessings upon you!"
msgstr "Žehnám ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC348.rude:7
msgid "A pleasure, my children.  Was there something else you needed?"
msgstr "Těšilo mě, mé děti. Potřebujete ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC349.rude:1
msgid ""
"The other day, I hear that Hanndl was stomping around complaining about people who aren't dead who keep trying to get in to Arslegard.  He said he finally told them they needed a Writ of Fate just to get rid of them."
msgstr ""
"Nedávno jsem slyšela, jak si Hanndl stěžoval na lidi, kteří nejsou mrtví a stále se snaží dostat do Arslegardu. Říkal, že jim nakonec pověděl, že potřebují Písmo osudu, aby se jich zbavil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC349.rude:3
msgid ""
"It's a fine place, as long as you don't talk to the gatekeeper.  He's a little, umm..unpleasant."
msgstr ""
"Je to slušné místo, dokud se nezačneš bavit se strážcem brány. Je tak trochu... hm... nepříjemný."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC349.rude:6
msgid "Of course!  Anything else you needed?"
msgstr "Jistě! Potřebujete ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:1
msgid "Can we ask you about something else?"
msgstr "Můžeme se tě otázat ještě na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:11
msgid "Actually, We thought we might ask you about something?"
msgstr "Ve skutečnosti jsme si mysleli, že bychom se tě mohli na něco zeptat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:12
msgid "Never heard of that kind of rock."
msgstr "O tomhle kameni jsem ještě nikdy neslyšela."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC63.rude:4
msgid "Never mind.  Goodbye."
msgstr "To nic. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:2
msgid "Nothing, really.  It's just a place where I live, and wash stones."
msgstr "Nic mě nenapadá. Je to prostě místo, kde bydlím a omývám kameny."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:4
msgid "Instead of waiting for someone to ask me to?  What a brilliant idea!"
msgstr ""
"Opravdu, skvělá rada. Nechápu, jak jsem mohla bez vašich úžasných nápadů vůbec existovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:4
msgid "Perhaps you should sell stones you wash."
msgstr "Možná bys ty kameny měla radši prodávat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:5
msgid ""
"Slow.  People have been taking their stones out to the beach, instead of me.  How can I compete with that?"
msgstr ""
"Pomalu. Lidi svý kameny nosí na pláž místo ke mně. Nevím, jak jim to mám sakra vysvětlit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:6
msgid ""
"Some people around here don't like to get their hands dirty.  So I do it for them."
msgstr "Někteří lidi z okolí si tím neradi špiní ruce. A tak to pro ně dělám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:6
msgid "Why wouldn't they do it themselves?"
msgstr "Proč to neudělají sami?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:7
msgid ""
"Well, when someone has a stone that's dirty, they bring it to be.  I shine it up real good."
msgstr ""
"No, když má někdo takhle špinavej kámen, snaží se ho vylepšit. A naleštit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:7
msgid "Why would anyone want to wash a stone?"
msgstr "Proč by měl někdo chtít omývat kámen?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:8
msgid "Beg pardon?"
msgstr "Prosím?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:8
msgid ""
"Stones.  Do you need any washed?  I do the best job in all of Thjorgard"
msgstr "Kameny. Potřebujete nějaké umýt? Dělám to nejlíp z celého Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC35.rude:9
msgid ""
"That's some good rock!  What I wouldn't do to be able to wash some of that!"
msgstr ""
"To je skvělý kámen! Co bych neudělala proto, abych mohla něco takového omývat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC350.rude:1
msgid ""
"In life I was a mother of six!  I never had time to do anything!  Now, I can do pretty much anything I want.  It's great!"
msgstr ""
"Když jsem ještě žila, měla jsem šest dětí! Nikdy jsem neměla na nic čas! A teď si můžu dělat skoro všechno, co mě napadne. Je to skvělé!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC350.rude:3
msgid ""
"I try to stay away from them.  They don't seem like they like us very much."
msgstr "Snažím se jim vyhýbat. Nevypadá to, že by nás měli zrovna v oblibě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC351.rude:1
msgid ""
"Krohn himself came down here to work out the other day.  It was amazing!  If he comes back, you should stick around and watch him."
msgstr ""
"Sám Krohn sem přišel nedávno pracovat. Bylo to úžasné! Pokud se vrátí, radím ti, zůstaň tady a sleduj ho."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC351.rude:3
msgid ""
"He's a true warrior-god.  When the Great Reckoning comes, you can bet I'll be by his side!"
msgstr ""
"Je to pravý bůh válečník. Až přijde Velké zúčtování, můžete se vsadit, že mu budu stát po boku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC351.rude:3
msgid "What do you know about Krohn?"
msgstr "Co víš o Krohnovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC352.rude:1
msgid ""
"I was killed by a beaten warrior!  He had no more fight in him, and I got sloppy.  I moved in to finish him off, and he stabbed me with his sword!  I don't know where that fight came from, he was beaten!"
msgstr ""
"Zabil mě téměř mrtvý válečník! Už neměl sílu bojovat, všechny kosti v těle měl polámané, tak jsem ho šel dorazit. Jenže jsem si nedal pozor a on mě probodl! "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC352.rude:3
msgid ""
"I bet that I would have gone there if I hadn't been so sloppy.  When I tried to get in, Skraelos, he just laughed at me!"
msgstr ""
"Vsadím se, že bych se tam dostal, kdybych si dával větší pozor a nebyl takový nepořádný. Když jsem se tam pokoušel proklouznout, tak se mi Skraelos vysmál!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC352.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC355.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC356.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/NPC357.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:7
msgid "What do you know about Hallenhalt?"
msgstr "Co víš o Hallenhaltu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC353.rude:1
msgid ""
"I was the last survivor on our raiding party when I was killed.  I faced ten Framish swords alone.  I fought them down to four before they finally finished me off!"
msgstr ""
"Zůstal jsem naživu jako poslední z celé naší hordy. Sám jsem stál proti deseti framonským mečům! Než se jim podařilo mě zdolat, zabil jsem ještě čtyři!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC353.rude:3
msgid ""
"He is the god of death.  It's his job to make sure only the worthy get into Hallenhalt."
msgstr ""
"Je to bůh smrti. Musí zajistit, aby se do Hallenhaltu dostali jenom ti, kteří jsou toho hodni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC353.rude:3
msgid "What do you know about Skraelos?"
msgstr "Co víš o Skraelovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC354.rude:1
msgid "Did I ever tell you about how I killed a dragon?"
msgstr "Už jsem vám vyprávěl, jak jsem zabil draka?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC354.rude:3
msgid ""
"Sweet mercy is it dull around here!  I've been sitting around for like fifty years!  You know what I'm ready for?  I'm ready for a raid!  Yeah!  That's what I need!"
msgstr ""
"Je to tady zatraceně nudné! Už tu takhle posedávám padesát let! Víte, na co mám chuť? Mám chuť na pořádný nájezd, trochu si zarabovat! Jo, to potřebuju!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC355.rude:1
msgid ""
"That infernal Beowulf!  He always claims he was some mighty fighter!  He could barely hold a sword, much less use one!"
msgstr ""
"Ten zatracený Beowulf! Stále tvrdí, že byl mocný bojovník! Sotva dokázal udržet meč, natož s ním šermovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC355.rude:3
msgid ""
"Beowulf always claims that's where he belongs.  I always have to remind him that we starved to death!  You know why?  Because he could farm a field about as well as he could lasso the sky!"
msgstr ""
"Beowulf pořád tvrdí, že patří zrovna tam. Musím mu pokaždé připomenout, že zemřel hlady. A víte proč? Protože dokázal stejně dobře farmařit, jako prase lítat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC356.rude:1
msgid ""
"This is the worst beer I have ever had!  Why don't the good bartenders ever end up here?"
msgstr ""
"Tohle je to nejhnusnější pivo, jaké jsem kdy měla! Proč se sem nedostanou nějací dobří hospodští?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC356.rude:3
msgid ""
"I know they get all the good bartenders!  Why does Skraelos think those people in Hallenhalt are so special?  Why do they deserve all the good bartenders?"
msgstr ""
"Vím, že mají všechny dobré krčmáře a pivovarníky! Proč si Skraelos myslí, že jsou lidé v Hallenhaltu tak zvláštní? Proč si jenom oni zaslouží dobré pivo a obsluhu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC357.rude:1
msgid ""
"I don't know what Mjoll over there is complaining about!  The beer here is fine!"
msgstr "Nevím, na co si támhle Mjoll stěžuje! To pivo je dost dobré!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC357.rude:3
msgid "That's where the really good bars are."
msgstr "To je místo, kde jsou fakt dobré hospody."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC358.rude:1
msgid ""
"What do I look like?  Bother me again, and I'll wallop you a good one!"
msgstr ""
"Připadám vám jako informační ústředna? Zkuste mě otravovat ještě jednou a vyběhnu s vámi!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC358.rude:2
msgid "That's right you are!"
msgstr "To jste přesně dělali!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC359.rude:1
msgid ""
"You see that guy Moyol around here?  I'm the one who killed him.  He keeps trying to start a fight with me."
msgstr ""
"Neviděli jste někde Moyola? To já ho zabil. Pořád se se mnou pokouší bojovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC359.rude:3
msgid "It beats being in the Afterworld, that's for sure!"
msgstr "Je to tu rozhodně lepší než v podsvětí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:10
msgid ""
"Hmmm.  And then I wouldn't have to kill them.  I wouldn't have to risk the lives of my fellow raiders.  Sounds risky."
msgstr ""
"Hmmm. A pak bych je nemusel zabíjet. Nemusel bych dávat v sázku životy ostatních kumpánů. Hm, to mě nikdy nenapadlo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:10
msgid "Maybe if you helped them, they could help you become rich."
msgstr "Kdybys jim pomohl, třeba by ti na oplátku poradili, jak zbohatnout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:11
msgid "Perhaps you should think about it."
msgstr "Snad by sis to mohl nechat projít hlavou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:11
msgid "That I will."
msgstr "To udělám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:13
msgid "Maybe someone should help them."
msgstr "Nejspíš by jim měl někdo pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:13
msgid ""
"Why would anyone do that?  Then we would lose a prime raiding location!"
msgstr "Proč by to kdo dělal? To bychom přišli o nejlepší místo pro rabování!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:14
msgid "What's so special about the Monastery at Lindisfarne?"
msgstr "Co je na klášteru v Lindisfarnu tak zvláštního?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:14
msgid ""
"You mean besides its riches?  I don't know.  I don't really care, as long as they stay rich!"
msgstr ""
"Myslíš ještě kromě jejich pokladů? To nemám zdání. A ani mě to nezajímá!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:15
msgid ""
"If they aren't strong enough to defend themselves, it is our duty to show them the might!"
msgstr ""
"Nejsou-li dost zdatní, aby ubránili sami sebe, je naší povinností ukázat jim sílu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:15
msgid "Why would you do such a thing?"
msgstr "Proč bys měl něco takového dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:16
msgid "I'm sure it is.  Goodbye"
msgstr "Nepochybuji, že tomu tak je. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:17
msgid ""
"No!  They have tried to build bigger walls to stop us from entering, but that is the extent of their fortifications!"
msgstr ""
"Ne! Už se pokusili zvýšit zdi, aby nám zabránili ve vstupu, ale to je také vrchol jejich snažení!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:17
msgid "They haven't built defenses for themselves?"
msgstr "To si sami nevybudují žádnou obranu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:2
msgid "And there are still men there?"
msgstr "A jsou tam ještě nějací lidé?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:2
msgid ""
"Oh yes!  Lindisfarne is one of the most prestigious schools for monks in all of Framon!  There is a huge waiting list of monks who want to study there."
msgstr ""
"Jistěže! Lindisfarn je jednou z nejvyhledávanějších mnišských kolejí v celém Framonu! Seznam mnichů, kteří by tam rádi studovali, je pořádně dlouhý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:3
msgid ""
"They seem incapable of the concept of defense!  Perhaps it's part of their monkish vows."
msgstr ""
"Vypadá to, že o obraně nemají ani ponětí! Je to možná součástí jejich mnišského slibu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:3
msgid "Why don't they defend themselves?"
msgstr "Proč se nebrání sami?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:4
msgid ""
"Because they're rich!  They always seem to have great treasures!  Why, I've raided the monastery there at least five times!"
msgstr ""
"Protože jsou bohatí! Vždycky se u nich najdou velký poklady! Proto jsem se taky účastnil aspoň pěti nájezdů!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:5
msgid "How do we get in on this raiding action?"
msgstr "Jak se můžeme přidat k takovému nájezdu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:5
msgid ""
"Just take a boat to Lindisfarne!  Most ships would be happy to take you there."
msgstr ""
"Prostě si najměte loď do Lindisfarnu! Většina kapitánů vás tam ráda dopraví!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:6
msgid "Who cares about that stuff!  They have money!  I want to be rich!"
msgstr "Koho by takové věci zajímaly? Mají prachy! A já chci bejt bohatej!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:6
msgid "You don't think they may possess important knowledge?"
msgstr "Nemyslíš si, že mohou vědět něco důležitého?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:7
msgid ""
"Ha!  And I suppose that's why Lindisfarne Monastery is always being raided, right?  Cause they're so smart?"
msgstr ""
"Ha! A počítám, že to je důvodem, proč je lindisfarnskej klášter vždycky vyrabovanej, že jo? Protože jsou tak chytří?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:7
msgid "Knowledge could make you rich, friend."
msgstr "Vědění tě může velmi obohatit, příteli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:8
msgid "That's right!"
msgstr "To je fakt!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:8
msgid "They're raided because they're rich."
msgstr "Jsou přepadáváni, protože jsou bohatí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:9
msgid "Right!  Er, uhh, yeah.  Hmmm."
msgstr "Pravda! Teda vlastně, ale, jaksi... hmmm."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC36.rude:9
msgid "They're rich because they're smart."
msgstr "A jsou bohatí, protože jsou chytří."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC360.rude:1
msgid ""
"Nope.  Nothing exciting has happened around here for a long time.  It's terribly boring."
msgstr "Ne-e. Tady se už strašně dlouho nic nestalo. Je tady hrozná nuda."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC360.rude:3
msgid "It's so quiet here.  Too quiet."
msgstr "Je tady klid. Až moc klidu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC361.rude:1
msgid "Would you like to hear how I tamed a dragon?"
msgstr "Nechceš si poslechnout, jak jsem si ochočil draka?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC361.rude:2
msgid "If you are ready, then I shall help."
msgstr "Pokud jste připraveni, pomohu vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC361.rude:2
msgid "We'd like to Grandmaster in Spear."
msgstr "Máme zájem o získání velmistrovského titulu v ovládání kopí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC361.rude:3
msgid ""
"There's an artifact called Einherjar that is rumored to exist.  If you find yourself with it, be careful.  It is said that it can cause you to lose your mind."
msgstr ""
"Povídá se, že existuje artefakt jménem Einherjar. Pokud ho najdete, dejte si na něj pozor. Prý dokáže způsobit šílenství."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:1
msgid "Do you know where it is?"
msgstr "Víš, kde je?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:1
msgid ""
"No.  The time I held it in my hands I was in Guberland.  I heard that someone named the Dook was looking for it, though"
msgstr ""
"Ne. Tenkrát dávno jsem žila v Guberlandu. Slyšela jsem, že ho prý hledá také nějaký Dook."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:2
msgid ""
"I once held Everstrike in my hands.  Me!  I held Everstrike!  I should have kept it."
msgstr ""
"Kdysi jsem držela Přesnostříl v rukou! Já! Měla jsem v rukou Přesnostříl! Měla jsem si ho nechat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:3
msgid "If you think you are ready, I can help."
msgstr "Pokud si myslíte, že jste připraveni, pomůžu vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:3
msgid "We'd like to Grandmaster in Bow"
msgstr "Máme zájem o získání velmistrovského titulu ve střelbě z luku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:4
msgid ""
"If you can find it, Everstrike is the best bow that exists!  It never misses!"
msgstr ""
"Pokud se vám podaří najít Přesnostříl, máte vyhráno. Je to nejlepší luk, jaký existuje. Nikdy nemine cíl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:6
msgid "I held it in my hands!  Me!  I wish I would have kept it."
msgstr ""
"Kdysi jsem ho držela v rukou! Já! Měla jsem v rukou Přesnostříl! Měla jsem si ho nechat..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC362.rude:6
msgid "What do you know about Everstrike?"
msgstr "Co víš o Přesnostřílu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC363.rude:1
msgid ""
"In life, for a time I followed the Temple of Honk.  When I got here, I actually got to meet The Great Honk.  You can too!  He's in the Hall of the Gods!"
msgstr ""
"Zaživa jsem patřil k církvi kejhovitů. Když jsem se dostal sem, dokonce jsem spatřil Velkého Kejhovitu! A vy můžete taky! Je v Síni bohů!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC363.rude:3
msgid ""
"I can't really say much about them, except The Great Honk was a little overrated."
msgstr ""
"Opravdu o nich moc říct nemůžu, snad jenom že Velkého Kejhovitu lidé trochu přeceňují..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC364.rude:1
msgid ""
"What happens now?  I mean what's after death?  Is there anything more to us than this?"
msgstr "Co se děje teď? Myslím po smrti? Čeká nás něco víc než tohle?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC364.rude:3
msgid ""
"I often spend my time talking philosophy with the other patrons.  I really would like to discuss it with Skraelos, but he'll never give me any of his time."
msgstr ""
"Často trávím čas filozofickými debatami s ostatními návštěvníky. Opravdu bych si rád popovídal se Skraelem, ale on mi nikdy nechce věnovat ani chvilku času."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC365.rude:1
msgid ""
"I can't believe I'm here!  I thought I was going to have to light the Six Fires!"
msgstr ""
"Nemůžu uvěřit, že jsem tady! Myslel jsem si, že budu muset zapálit šestero ohňů!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC365.rude:3
msgid ""
"When I was laying on my deathbed I feared that I was going to go to the Afterworld.  That is a horrible place.  I was afraid of lighting the Six Fires of Penance."
msgstr ""
"Když jsem ležel na smrtelném loži, měl jsem strach, že půjdu do podsvětí. To je hrozné místo. Bál jsem se zapálení šestera ohňů!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC366.rude:1
msgid ""
"I came here with my father Dain.  We were both taken with the same illness.  I think Skraelos had a reason for bringing us here.  He won't tell us, though."
msgstr ""
"Přišla jsem sem se svým otcem Dainem. Oba nás zahubila stejná nemoc. Podle mě nás sem Skraelos přivedl schválně, ale nechtěl nám říct proč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC366.rude:3
msgid "I'm certain that he has a reason for bringing my father and me here."
msgstr "Určitě má nějaký důvod, proč sem přivedl mého otce a mě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC366.rude:3
msgid "What do you know about Skarelos?"
msgstr "Co víš o Skraelovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC367.rude:1
msgid ""
"I tried to go through the Dark Passageway.  It was too dark for me!  I was afraid of getting eaten!"
msgstr ""
"Pokoušela jsem se projít Temným průchodem. Ale byla tam na mě moc tma! Bála jsem se, že mě něco sežere!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC367.rude:3
msgid ""
"I really want to visit them!  They are the ones who decide fate.  I want to know what is my fate?"
msgstr ""
"Opravdu je chci navštívit! To ony rozhodují, jaký kdo bude mít osud. Chci vědět, co je mým osudem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC368.rude:1
msgid ""
"Believe it or not, when I was alive, I was a historian for the Half-Orcs."
msgstr "Věř nebo ne, ale zaživa jsem byl historikem poloskřetů."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC368.rude:3
msgid "Nothing you can't learn from being here for twenty years."
msgstr "Nic, co se sami nenaučíte, když tady budete žít nějakých dvacet let."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC369.rude:3
msgid "Nothing.  I was a clerk!"
msgstr "Nic. Byla jsem úřednice!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC369.rude:5
msgid "My pleasure."
msgstr "Těšilo mě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:1
msgid ""
"Is that what you think?  IF you think you're ready, Then we shall see."
msgstr ""
"To by mohl říct každý! Ale JESTLI si myslíte, že jste připraveni, tak se o tom přesvědčíme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:1
msgid "We'd like to become Grandmasters in Cudgel."
msgstr "Rádi bychom se stali velmistry v ovládání palice."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:20
msgid "Maybe we could ask you something else."
msgstr "Možná bychom se tě mohli zeptat na něco jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:2
msgid "Ok."
msgstr "Dobrá."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:3
msgid "Who cares!"
msgstr "Co je komu do toho!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:4
msgid "Sorry.  Could we ask you something?"
msgstr "Promiň, ale mohli bychom se tě na něco otázat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:4
msgid "You could ask.  Don't think I'll answer it, though"
msgstr "Ptát se můžete, ale nemyslete si, že vám na všechno odpovím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:5
msgid "Shove off!"
msgstr "Vymajzni!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:6
msgid "That'll make you rich quick!"
msgstr "Dá se z ní rychle zbohatnout!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:7
msgid "None of your business!"
msgstr "Do toho ti nic není!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:7
msgid "What is it that you have to do?"
msgstr "Co musíš udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:8
msgid "If you don't leave me alone, You'll be finding all about it!"
msgstr "Jestli mě nenecháš o samotě, brzy se o něm dozvíš všechno!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:8
msgid "What do you know about the Afterworld?"
msgstr "Můžeš mi říct něco o posmrtném světě?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:9
msgid "Could we ask you something?"
msgstr "Mohli bychom na tebe mít pár dotazů?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC37.rude:9
msgid "You could ask.  Don't expect me to answer!"
msgstr "Ptát se můžete, ale nečekejte, že vám odpovím!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC370.rude:1
msgid ""
"I've heard that when Njam is here, most of the gods refuse to talk to him."
msgstr "Když je prý Njam tady, tak se s ním většina bohů odmítá bavit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC370.rude:3
msgid ""
"They seem to get along with each other.  All of them except for Njam.  He's rarely here, though."
msgstr ""
"Vypadá to, že spolu docela vychází. Všichni kromě Njama. Ale ten je tady jenom málokdy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC371.rude:1
msgid ""
"Do you think Krohn and Fre are married?  I remember my mother saying something about that when I was little.  I don't remember though, and I'm afraid to ask them."
msgstr ""
"Myslíš, že jsou Krohn a Fré svoji? Jako manželé? Vzpomínám si, že když jsem byl malý, matka o tom něco povídala. Ale nepamatuju si to přesně a bojím se zeptat přímo jich."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC371.rude:3
msgid ""
"It's nothing like my mother described.  I looked for her when I first got here, but I never found her.  I wonder if she went to Hallenhalt?"
msgstr ""
"Není to vůbec tak, jak to popisovala matka. Když jsem se sem dostal, hledal jsem ji, ale nikde jsem ji nenašel. Zajímalo by mě, jestli se dostala do Hallenhaltu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC372.rude:1
msgid ""
"Oh, I miss the days of battle.  I long for the clang of swords!  Old age didn't treat me well!"
msgstr ""
"Oh, chybí mi bitvy. Toužím po řinčení nabroušených mečů! Stáří se ke mně zachovalo nehezky!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC372.rude:3
msgid ""
"If you wrote down everything I knew about adventuring in life, the volumes would fill all of Hallenhalt.  Alas, old age caught up with me, and I cannot remember any of it."
msgstr ""
"Pokud byste sepsali vše, co vím o dobrodružném životě, ty knihy by zaplnily celý Hallenhalt. Ale stáří si u mě vybralo svou daň a já už si z toho nic nepamatuju."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC373.rude:1
msgid ""
"I wrestled with Old Angus last week.  He wupped me good!  I didn't think someone that old could wrestle like that!"
msgstr ""
"Minulý týden jsem zápasila se starým Angusem. Pěkně mi to nandal! Nenapadlo mě, že takový starý dědek může tak dobře zápasit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC373.rude:3
msgid ""
"I was a soldier in life.  I was killed in Lachmon Cove.  I don't know if you want advice from me!"
msgstr ""
"Zaživa jsem byla v armádě. Zabili mě v Lachmonské zátoce. Pochybuju, že stojíš o nějakou radu ode mě!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC374.rude:1
msgid "Not unless you want to hear about the crosshook."
msgstr "Ne, pokud vás nezajímá moje práce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC374.rude:3
msgid ""
"I can get a lot of work done now that I don't have my children bothering me every five minutes."
msgstr ""
"Teď, když mě každých pět minut neotravují děcka, mám spoustu času na práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC375.rude:1
msgid ""
"I was murdered by my own staff!  Oooh, when they get here, they will pay a lifetime for what they did to me!"
msgstr ""
"Zabili mě mí vlastní lidé! Oh, až se sem dostanou, zaplatí za to, co mi udělali! A budou platit hodně dlouho!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC375.rude:3
msgid ""
"I was a linesman for a Thjorad mine in life.  I've heard that the men who pushed me down the shaft say it gave way and I fell.  Those dirty liars!  I can't wait until they get here!"
msgstr ""
"Celý život jsem dělal předáka v Thjoradském dole. Slyšel jsem, jak chlapi, kteří mě shodili, tvrdí, že se to propadlo... Hnusní lháři! Nemůžu se dočkat, až se sem dostanou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC375.rude:3
msgid "What do you know about life?"
msgstr "Co víš o životě?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC376.rude:1
msgid ""
"I worked in the Refinery in the Thjorad Mine for years.  I still can't get all the soot off my face, and I'm dead!"
msgstr ""
"Léta jsem pracovala v Thjoradském dole. Ještě pořád mám na obličeji saze, nemůžu se jich zbavit, a to jsem mrtvá!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC376.rude:3
msgid ""
"I need a good bath!  I wish there was a place to take one around here!"
msgstr ""
"Potřebovala bych pořádnou koupel! Kdyby tady tak bylo místo, kde bych se mohla vykoupat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC377.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC377.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC377.rude:3
#: assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:377
msgid "Honk!"
msgstr "Gá, gá!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC377.rude:1
msgid "We'll take that as a yes."
msgstr "Beru to jako ano."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC377.rude:2
msgid "Are you the Great Honk?"
msgstr "Ty jsi Velký Kejhovita?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:2
msgid "Very well.  We shall go."
msgstr "Velmi dobře. Půjdu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:3
msgid ""
"It is not for you to ask why!  Your duty is to go!  From what I understand, however, all of you are to answer to him for what you have done!"
msgstr ""
"Vy se nemáte ptát proč! Vy máte jít, je to vaše povinnost! Podle toho, jak tomu rozumím, se mu musíte zodpovídat za to, co jste provedli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:3
msgid "What?  Why?"
msgstr "Co? Proč?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:4
msgid "Great news!  I will tell her!"
msgstr "Skvělé zprávy! Vyřídím jí to!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:4
msgid "We must stop this!  Tell Kira we'll find a way to stop the war!"
msgstr "Tohle musí skončit! Řekni Kiře, že najdu způsob, jak zastavit válku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:5
msgid ""
"I've been sent by Kira the Cold.  It's about Sturmford and Drangheim.  They've gone to war against each other."
msgstr ""
"Posílá mě sem Kira Chladná. Jde o Sturmford a Drangheim. Začaly spolu válčit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:6
msgid "Your group and Tamur Leng have been summoned to stand before Krohn."
msgstr "Tamur Leng a vaše družina jste byli předvoláni před Krohna."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:7
msgid ""
"They both claim that the other committed acts of war against them while under the guise of uniting against the Beldonian Hordes."
msgstr ""
"Oba tvrdí, že to ten druhý zaútočil proti němu pod záminkou sjednocování se proti beldonským tlupám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC378.rude:7
msgid "What?!  Why?"
msgstr "Cože?! Proč?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC379.rude:1
msgid ""
"I've come here to pray for the release of my family.  The invaders attacked my town and took them captive!  I was lucky to escape!"
msgstr ""
"Přišel jsem se modlit za svou rodinu! Nájezdníci zaútočili na naše město a všechny zajali! Já měl štěstí a podařilo se mi uprchnout!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC379.rude:3
msgid ""
"Nothing!  I just got here!  But I've heard that the things you pray for here often come true."
msgstr ""
"Nic! Zkrátka jsem se sem dostal! Ale slyšel jsem, že věci, za které se zde modlíš, se často stanou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:10
msgid ""
"Not much of our history is left from before the Great Cataclysm.  Our culture and our clans were all scattered to the Great Winds.  If it weren't for Ekan'dia and the Great Migrations, we probably would have been destroyed."
msgstr ""
"Z časů před Velkou pohromou se toho moc nedochovalo. Jak naši kulturu, tak naše kmeny rozfoukal vítr. Nebýt Ekan'die a Velkého putování, snad bychom byli zničeni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:6
msgid "What do you know about the history of the Half-Orcs?"
msgstr "Znáš něco o historii poloskřetů?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:11
msgid ""
"Thjorgard is my home now.  Though once in a while I feel a great longing to be back to the Half-Orc lands."
msgstr ""
"Thjorgard je nyní mým domovem. I když jednou za čas cítím mocnou touhu vrátit se zpátky do poloskřetích zemí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:11
msgid "What can you tell us about Thjorgard?"
msgstr "Co nám můžeš povědět o Thjorgardu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:12
msgid "Can we ask you something?"
msgstr "Smím se tě na něco optat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:12
msgid "Go ahead"
msgstr "Pokračuj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:13
msgid "Is that some sort of fish?"
msgstr "To je nějaká ryba?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:3
msgid ""
"Many cultures were destroyed in the Great Cataclysm.  I consider us fortunate to have survived at all."
msgstr ""
"Při Velké pohromě zahynulo mnoho národů. Myslím, že máme velké štěstí, že jsme nakonec přežili."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:3
msgid "That is very sad indeed."
msgstr "To je opravdu velmi smutné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:4
msgid ""
"Most of what was the Half-Orc lands is now buried under the sea.  The rest is lost.  Even if we knew where our ancestral lands were, I doubt we could live there anymore."
msgstr ""
"Většina bývalých poloskřetích zemí je nyní pohřbena pod mořem. Zbytek je ztracen. I kdybychom věděli, kde se země našich předků nacházejí, pochybuji, že bychom tam ještě mohli žít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:4
msgid "Why don't you go back?"
msgstr "Proč se nevrátíte zpátky?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:5
msgid ""
"She is the leader of what was called the Dia Clan.  They were the only clan who's name survived the Great Cataclysm.  She lead us out from the brink of destruction."
msgstr ""
"Je to vůdkyně, jejíž jméno nese kmen Dia. Je to jediný klan, který přežil Velkou pohromu. To ona nás vyvedla ze zkázy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:5
msgid "Who is Ekan'dia?"
msgstr "Kdo je to Ekan'dia?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:8
msgid ""
"The Great Migration is what we named the exodus from the dying Half-Orcish lands.  After the Great Cataclysm, our farmlands turned to dust, our forests were emptied and our rivers dried up.  Ekan'dia led us out of all of that."
msgstr ""
"Velkým putováním nazýváme exodus z vymírajících poloskřetích zemí. Po Velké pohromě se naše pole obrátila v prach, naše lesy lehly popelem a naše řeky vyschly. Ekan'dia nás z toho všeho vyvedla."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:8
msgid "What is the Great Migration?"
msgstr "Co je to Velké putování?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:9
msgid "May your flame never be snuffed."
msgstr "Nechť váš plamen nikdy nevyhasne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC38.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:7
msgid "Thanks for the chat."
msgstr "Díky za popovídání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC380.rude:1
msgid ""
"I've heard that the relic can do some miraculous things!  I've seen it, and it's beautiful!"
msgstr ""
"Slyšel jsem, že relikvie dokáže úžasné věci! Viděl jsem ji a je nádherná!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC380.rude:3
msgid ""
"I'm here to see the relic.  I've got a bad case of leg cramps, and I hope that the relic will cure me."
msgstr ""
"Jdu se podívat na relikvii. Chytil jsem naprosto odporného vlka, skoro ani nemůžu chodit. Doufám, že mě relikvie vyléčí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC381.rude:1
msgid ""
"That relic just didn't look right.  It's been a long time since I saw it last, but I don't remember it looking like that.  I wonder if I'm going crazy?"
msgstr ""
"Na té relikvii se mi něco nezdá. Už jsem ji sice dlouho neviděl, ale nevzpomínám si, že by vypadala takhle. Že bych už bláznil?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC381.rude:3
msgid ""
"This is my third pilgrimage.  I think maybe I should pray to keep my sanity.  I think I'm going crazy."
msgstr ""
"Tohle je moje třetí pouť. Myslím, že bych se měl modlit, aby mi zůstal zdravý rozum. Mám pocit, že začínám šílet."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:2
msgid ""
"Wonderful!  Here's your money.  I have it, I have it!  I have the Fizbin of Good Fortune!!"
msgstr "Skvělé! Tady jsou vaše peníze. Mám ho! Mám ho! Mám Fizbin štěstí!!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:3
msgid ""
"You've got the Fizbin!!  You wanna sell it?  Huh, do ya?  How much?  I'll give you a lot!  I've got some saved up.  How's 40,000 sound to you?  Good?"
msgstr ""
"Vy máte Fizbin!! Nechcete ho prodat? Co? Kolik? Dám vám spoustu zlata! Dost jsem si našetřila. Co takhle 40 000, jak se vám to líbí? Berete?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:4
msgid ""
"I've come from a long way away!  I'm here to pray for the health of my father.  He's been sick, and I don't know what I would do without him!"
msgstr ""
"Přicházím z velké dálky! Jdu se modlit za zdraví svého otce. Je hodně nemocný a já si nedovedu představit, co budu dělat bez něj!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:5
msgid "Suit yourself, but I still think it's a lot of money!"
msgstr "Jak chcete, ale já si stejně myslím, že je to spousta peněz!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC382.rude:6
msgid ""
"My father asked me to come here.  He's very sick, and I am going to pray for him to get well.  He always told me it was beautiful, but his words didn't do it justice.  I think this is the most beautiful place I have ever been to."
msgstr ""
"Můj otec mě požádal, ať se sem vydám. Je velmi nemocný a já se chci modlit za jeho zdraví. Vždycky mi říkal, že je to tady překrásné, ale jeho slova byla nedostačující. Podle mě je to nejnádhernější místo, na kterém jsem kdy byla."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC383.rude:1
msgid "It's a long trip from Freetown!  I hope this relic is worth it!"
msgstr ""
"Z Freetownu je to dlouhý výlet! Doufám, že mi za to relikvie bude stát!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC383.rude:3
msgid "Nothing!  I'm from Framon."
msgstr "Nic! Jsem z Framonu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC383.rude:4
msgid "Farewell, traveler!"
msgstr "Sbohem, poutníci!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC384.rude:1
msgid ""
"I fought in the arena once.  I was nearly killed!  It would figure that the thing I fought was ten times stronger than me.  The only reason I lived was because I jumped into the stands and ran away!"
msgstr ""
"Jednou jsem bojoval v aréně. Málem mě zabili! Odhaduju, že ta věc, se kterou jsem bojoval, byla tak desetkrát silnější než já! Podařilo se mi přežít jenom proto, že jsem přeskočil zábradlí a utekl!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC384.rude:2
msgid "If you are qualified, very well."
msgstr "Pokud na to máte..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC384.rude:2
msgid "We'd like to become Grandmaster in Thrown Weapons."
msgstr "Chtěli bychom se stát velmistry ve vrhacích zbraních."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC384.rude:3
msgid ""
"Trolleri is the dagger you want.  It has enchantments on it that the Thjoradric smiths only dream of."
msgstr ""
"Potřebujete dýku Trolleri. Jsou v ní kouzla, o kterých si mohou thjoradští kováři nechat jenom zdát."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC385.rude:1
msgid ""
"Fjarkskafinn the Still-alive challenged me to a duel.  Boy is she going to get it!"
msgstr "Fjarkskafinn Ještě-živá mě vyzvala na souboj! Ta to ode mě schytá!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC385.rude:2
msgid "If you are worthy, I shall help you with that."
msgstr "Pokud na to máte zkušenosti, pomohu vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC385.rude:2
msgid "We'd like to become Grandmasters in Unarmed."
msgstr "Chtěli bychom se stát velmistry v boji beze zbraně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC385.rude:3
msgid ""
"The true adventurer needs neither steel nor spell to survive.  What he was born with is enough."
msgstr ""
"Pravý dobrodruh nepotřebuje k přežití ani ocel, ani magii. Stačí mu to, s čím se narodil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC386.rude:1
msgid ""
"That Sigre Bjarnidotir said I smelled like a goat!  What else could I do?  I challenged her to a duel.  Boy is she going to pay!"
msgstr ""
"Sigre Bjarnidotir řekla, že smrdím jako koza! Co jsem měla dělat? Vyzvala jsem ji na souboj! Ta to ode mě schytá!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC386.rude:2
msgid "If you are worthy, I shall help you."
msgstr "Pokud na to máte, pomohu vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC386.rude:2
msgid "We'd like to become Grandmasters in Armor."
msgstr "Chtěli bychom se stát velmistry ve zbroji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC386.rude:3
msgid ""
"I've heard of this magical armor known as Poltergeist it is said to be made of the chains that bind ghosts to this world."
msgstr ""
"Magické brnění Poltergeist je prý vyrobené z řetězů, které poutají duchy k tomuto světu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC386.rude:6
msgid "lank"
msgstr "No jo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC387.rude:1
msgid ""
"I was in the tavern the other day, and I had some beer from Frosgard.  Boy was it awful!"
msgstr ""
"Nedávno jsem byl v taverně a dostal jsem nějaké pivo z Frosgardu. Fuj, to byl hnus!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC387.rude:2
msgid "If you are worthy, I can help."
msgstr "Pokud na to máte, můžu vám pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC387.rude:2
msgid "We'd like to become Grandmasters in Shield."
msgstr "Chtěli bychom se stát velmistry v používání štítu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC387.rude:3
msgid ""
"There is a shield called Arrowfoe that was carried by Hrothgar Krohnssen.  With it, it is said you cannot be harmed by arrows."
msgstr ""
"Existuje štít jménem Šípuzmar, který nosil Hrothgar Krohnssen. S ním vás nemohou zasáhnout šípy!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC387.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:7
msgid "What do you know about artifacts?"
msgstr "Co víš o artefaktech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC388.rude:1
msgid "Do you really want to know who I was dating last night?"
msgstr "Opravdu chcete vědět, s kým jsem měla včera rande?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC388.rude:2
msgid "We'd like to become Grandmasters in Dodge."
msgstr "Chtěli bychom se stát velmistry v uhýbání."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC388.rude:2
msgid "You think you're quick enough for that, do you?  We shall see!"
msgstr "Myslíte si, že jste dost rychlí? Uvidíme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC388.rude:3
msgid "Stay on your toes, and you will stay alive."
msgstr "Dej si bacha a přežiješ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:1
msgid "No kidding."
msgstr "Nekecej."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:1
msgid ""
"Yeah!  Unless you are modulating, but then you would have to borrow a chord from another key to become the tonic in the new key.  But then you would still resolve to the dominant of the new key!"
msgstr ""
"Jo! Jasně! Pokud nemodulujete, ale pak je třeba vypůjčit si akord z jiného klíče, aby se stal přízvukem v novém klíči. Ale pak stále musíte vyřešit, co bude dominantní v novém klíči!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:2
msgid "Did you learn anything?"
msgstr "Naučil ses něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:2
msgid ""
"Of course!  Did you know that the tonic in its second inversion is supposed to resolve to the dominant?"
msgstr ""
"Jistě! Věděli jste, že se má přízvučná slabika v druhé inverzi stát dominantní?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:3
msgid ""
"I wanted to be a musician, but my father wouldn't have it.  I snuck out while he was gone and went to music school anyway."
msgstr ""
"Chtěl jsem být hudebníkem, ale můj otec to nechtěl dovolit. Když byl jednou pryč, utekl jsem z domova a šel jsem na hudební školu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:6
msgid "If you have quick hands and good eyes, I can help you."
msgstr "Pokud máte rychlé ruce a dobré oči, můžu vám pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:2
msgid "We'd like to become Experts in Thrown Weapons."
msgstr "Chtěli bychom se stát experty v boji s vrhacími zbraněmi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:3
msgid "Find Thorfinn Quickeye in Thjorgard.  He will help."
msgstr "Najdi Thorfinna Bystrookého v Thjorgardu. Pomůže ti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:3
msgid "Where can we become Grandmasters in Thrown Weapons?"
msgstr "Kde se můžeme stát velmistry v boji s vrhacími zbraněmi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:4
msgid "We'd like to become Masters in Thrown Weapons."
msgstr "Chtěli bychom se stát mistry v boji s vrhacími zbraněmi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC389.rude:7
msgid ""
"It gets lonely out there.  If I were you, I'd hire a musician to keep me company."
msgstr ""
"Na výpravách to bývá nudné. Na vašem místě bych si najal hudebníka, který by vás po večerech rozptyloval."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:1
msgid "Do you think you're ready?  If so, I can help."
msgstr "Domníváte se, že jste připraveni? Pak vám mohu pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:1
msgid "We'd like to become Grandmasters in Armsmaster."
msgstr "Rádi bychom se stali velmistry v ovládání zbraní."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:10
msgid ""
"They resent the people of Thronheim for invading their lands.  I have a cousin who lives in Thronheim.  She says the Framish are trying to push out all the Thronish out of Framon and back to Thronheim."
msgstr ""
"Nesnášejí obyvatele Thronheimu, protože pustoší jejich země. Mám v Thronheimu sestřenici, která říká, že Framonští se pokoušejí všechny Thronheimské vyhostit z Framonu zpátky do Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:11
msgid "May your flame never die."
msgstr "Nechť váš plamen nikdy nevyhasne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:2
msgid ""
"I don't know.  Maybe they have richer lands there.  My father always said that the Pa'pans were farmers before the Great Cataclysm.  I'm not sure I believe him, though."
msgstr ""
"Nevím. Snad tamější země oplývají větším bohatstvím. Můj otec mi vždycky vyprávěl o Pa'panech, kteří farmařili ještě před Velkou pohromou. Ale nevím, jestli mu věřím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:2
msgid "Why are the Thronish moving into Framon?"
msgstr "Proč se Thronheimští stěhují do Framonu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:3
msgid "Further than Thronheim?  I've got a cousin who lives in Thronheim."
msgstr "Dále od Thronheimu? Tam mám sestřenici!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:3
msgid "It's a place far to the west."
msgstr "To místo leží daleko na západě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:5
msgid ""
"She taught them to survive without their farmlands.  She taught them their native tongue.  If it weren't for her, the flame of the Half-Orc would have been snuffed forever."
msgstr ""
"Naučila je přežít bez jejich farem. Naučila je jejich rodný jazyk. Kdyby nebylo jí, oheň poloskřetů by navždy vyhasl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:6
msgid ""
"Most of their culture has been destroyed.  They are blessed to have Ekan'dia, who led them out of the dying Half-Orc lands."
msgstr ""
"Většina jejich kultury byla zničena. Jsou obdařeni moudrostí Ekan'die, která je vyvedla z umírající země poloskřetů. "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:7
msgid "May your flame never go out, friend."
msgstr "Nechť váš plamen nikdy nevyhasne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:8
msgid "Never heard of it.  What is it?"
msgstr "O tom jsem nikdy neslyšela. Co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC39.rude:9
msgid "We'd like to ask you about something."
msgstr "Rádi bychom se tě na něco optali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC390.rude:1
msgid ""
"I've heard that you can use grapes to fight nagate.  Apparently they can't really digest the grape seeds."
msgstr ""
"Slyšela jsem, že s nagáty se dá bojovat hrozny. Zřejmě nejsou schopní strávit jejich semínka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC390.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC390.rude:4
msgid "You think you are ready?  Very well."
msgstr "Myslíte si, že jste připraveni? Velmi dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC390.rude:3
msgid "Where can we become Grandmasters in Armsmaster"
msgstr "Kde se můžeme stát velmistry v ovládání zbraní?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC391.rude:1
msgid "Stay away from those sewers!  There's nasty stuff down there!!"
msgstr "Vyhýbej se kanálům! Tam dole jsou hnusné věci!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC391.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC391.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:2
#: assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:4
msgid "If you are skilled enough."
msgstr "Pokud máte dost zkušeností."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC391.rude:5
msgid ""
"Plenty.  I can show you how to make your fists as powerful as someone else's swords!"
msgstr ""
"Hodně. Mohu ti ukázat, jak používat pěsti se stejným účinkem, s jakým jiní používají meče!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:1
msgid ""
"When I woke up yesterday, there was a snake in my bed.  I picked it up and put it in my brother's bed.  He screamed like a baby!!"
msgstr ""
"Když jsem se předevčírem probudil, měl jsem v posteli hada! Zvedl jsem ho a strčil ho do postele bratrovi! Ječel jako malé děcko!!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:3
msgid "If you are skilled, I shall help you."
msgstr "Pokud máte dost zkušeností, pomohu vám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:2
msgid "We'd like to become Experts in Armor."
msgstr "Chtěli bychom se stát experty v používání zbroje."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:4
msgid "We'd like to become Masters in Armor."
msgstr "Chtěli bychom se stát mistry v používání zbroje."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:3
msgid "Go to Thjorgard and find Fjarkskafinn the Still-alive."
msgstr "Jdi do Thjorgardu a najdi Fjarkskafinn Ještě-živou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:3
msgid "Where can we become Grandmasters in Armor?"
msgstr "Kde se můžeme stát velmistry ve zbroji?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC392.rude:5
msgid ""
"The more you practice in your armor, the more it will become like a second skin."
msgstr ""
"Čím více se budete cvičit ve zbroji, tím více vám bude připadat jako druhá kůže."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:1
msgid ""
"I heard that the docks were built by giants!  Do you think that's true?"
msgstr "Doky prý postavili obři! Myslíš si, že je to pravda?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:4
msgid "If you meet the qualifications."
msgstr "Pokud jste dostatečně schopní..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:2
msgid "We'd like to become Experts in Shield."
msgstr "Chtěli bychom se stát experty v používání štítu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:3
msgid "Halfdan the Hidden in Thjorgard will help you."
msgstr "V tom ti pomůže Halfdan Skrytý z Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:3
msgid "Where can we become Grandmasters in Shield?"
msgstr "Kde se můžeme stát velmistry v používání štítu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:4
msgid "We'd like to become Masters in Shield."
msgstr "Chtěli bychom se stát mistry v používání štítu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:5
msgid ""
"Don't waste your time putting a weapon in your off hand.  It makes your attacks too slow."
msgstr "Neberte si zbraň do druhé ruky. Zbytečně vás to zpomalí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC393.rude:7
msgid "Farwell."
msgstr "Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:1
msgid "You make fun of my height and I'll wallop you one."
msgstr "Zkus si udělat legraci z mé výšky a hned ti jednu přišiju."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:4
msgid "I might be able to help."
msgstr "Snad bych ti mohl pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC394.rude:5
msgid "Attacking from range is the safest way to fight."
msgstr "Střelba z dálky je bezpečnější formou boje."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:1
msgid ""
"I fought against Sturmford's General Ivsar during the war.  I think it's a shame that we've kept such an able soldier in prison for so long."
msgstr ""
"Během války jsem bojoval proti sturmfordskému generálu Ivsarovi. Myslím, že je hanba držet ve vězení schopného vojáka tak dlouho."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:4
msgid "I can help you, if you possess the skill."
msgstr "Snad bych vám mohl pomoct, pokud máte dost dovedností."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC395.rude:5
msgid "If you want to stay alive, get the best armor you can afford."
msgstr ""
"Pokud chcete zůstat na živu, sežeňte si nejlepší brnění, jaké si jen můžete dovolit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:1
msgid ""
"Keep that shield between you and your opponent.  It doesn't do you any good on the ground."
msgstr "Štít drž vždy mezi sebou a protivníkem. Na zemi je ti k ničemu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:6
msgid "Certainly.  Farewell."
msgstr "Jistě. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC396.rude:7
msgid "My pleasure.  Farewell."
msgstr "Těšilo mě. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:1
msgid ""
"I was at the bar last night!  I got so drunk I can hardly stand anymore."
msgstr ""
"Včera jsem byl v hospodě! Ožral jsem se tak, že jsem skoro nemohl chodit!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:2
msgid "We'd like to become Experts in Dodging."
msgstr "Chtěli bychom se stát experty v uhýbání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:3
msgid "Go to Thjorgard and find Hildigunna the Quick."
msgstr "Jdi do Thjorgardu a vyhledej Hildigunnu Hbitou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:3
msgid "Where can we become Grandmasters in Dodging?"
msgstr "Kde se můžeme stát velmistry v uhýbání?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:4
msgid "We'd like to become Masters in Dodging."
msgstr "Chtěli bychom se stát mistry v uhýbání."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC397.rude:5
msgid "Stay quick on your feet.  You should be ready for anything."
msgstr "Buďte neustále v pohybu. Musíte být připraveni na cokoli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:7
msgid "Where can we go to become Grandmasters in Repair Item?"
msgstr "Kde bychom se mohli stát velmistry v opravování věcí?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:7
msgid "You must find Halvar Davinssen in Yorwick."
msgstr "Musíte vyhledat Halvara Davinssena z Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:1
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:8
msgid "If you fit the requirements, I can help you with that."
msgstr "Pokud splňuješ požadavky, mohu ti s tím pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:1
msgid "We'd like to become Experts in Repair Item."
msgstr "Chtěli bychom se stát experty v opravování věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:3
msgid ""
"I lost my set of tools.  I'm going to have to go to the blacksmith to get new ones."
msgstr ""
"Ztratila jsem své nářadí. Budu muset zajít za kovářem a koupit si nové."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:8
msgid "We'd like to become Masters in Repair Item."
msgstr "Toužím se stát mistrem v opravování věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC398.rude:5
msgid ""
"There's nothing worse than getting your stuff broken in the middle of combat.  A broken sword doesn't do you any good."
msgstr ""
"Není nic horšího, než když se ti uprostřed boje něco rozbije. Zlomený meč je úplně k ničemu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:1
msgid ""
"I've heard that the Sky Fort used to have an entire city full of giants."
msgstr "Nebeská tvrz prý kdysi bývala plná obrů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:2
msgid "We'd like to become Masters in Identify Item."
msgstr "Chtěl bych se stát mistrem v identifikaci věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:3
msgid "They're very tough.  Too tough for most people to kill."
msgstr "Jsou tvrdí. Na některé lidi až moc tvrdí, nedají se snadno zabít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC399.rude:3
msgid "What do you know about giants?"
msgstr "Co víš o obrech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:10
msgid "This is it!!  This is the book!"
msgstr "To je ono!! To je ta kniha!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:10
msgid "We found a gold one."
msgstr "Našli jsme zlatou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:11
msgid "You were as bothersome as you are uncultured.  Good day."
msgstr "Byli jste stejně otravní jako nekulturní. Hezký den."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:12
msgid ""
"The Great Cataclysm tore the Old Ursanian Empire apart, and killed thousands of its inhabitants.  Who knows what wondrous things we lost?"
msgstr ""
"Velká pohroma rozdělila staré Ursanské impérium a zabila tisíce jeho obyvatel. Kdo ví, o kolik úžasných věcí jsme přišli!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:13
msgid "Why must you bother me then?  Be off with you!"
msgstr "Proč mne tedy rušíš? Zmizte!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:14
msgid "About that book you were looking for."
msgstr "O té knize, po které pátráš."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:14
msgid "Yes, what is it?"
msgstr "Ano, zjistili jste něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:29
msgid "Nevermind."
msgstr "Ale nic."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:16
msgid ""
"No!  This is the wrong book!  But it does say that the right one is locked in some building in Drangheim Village.  Take this key, hopefully it will unlock the right door.  The book says something about being underneath a floor."
msgstr ""
"Ne! Tohle je špatná kniha! Což znamená, že ta správná je zamčená v nějaké budově ve vesnici Drangheimu. Vemte si tento klíč, doufám, že otevře ty správné dveře. Kniha upozorňuje na něco, co se nachází pod podlahou. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:16
msgid "So did that book work for you?"
msgstr "Pomohla vám ta kniha?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:17
msgid "Did that book work out for you?"
msgstr "Byla ti ta kniha k něčemu dobrá?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:17
msgid ""
"Oh yes, it worked out wonderfully.  A very intriguing volume that is.  You were here for something, weren't you.  Oh yes!  The promotion.  Very well.  You are now promoted to Mages.  Congratulations.  Now go away!  I have work to do!"
msgstr ""
"Ano, posloužila báječně. Je to velmi zajímavý svazek. Ale vy jste sem pro něco přišli, že. Aha! Povýšení. Skvělé. Nyní jste povýšeni na mágy. Blahopřeji vám. A nyní odejděte! Mám spoustu věcí na práci!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:18
msgid "You are not sorry, but certainly bothersome.  Be on your way!"
msgstr "Není vám to líto, ale jste pěkně otravní! Jděte si po svém!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:2
msgid ""
"Somewhere on the Isle of Ashes, inside the ruins of Verhoffin's Tower is his diary.  We are very interested in what the diary might contain regarding what he did.  Retrieve this for us, and you shall become Mages."
msgstr ""
"Kdesi na Ostrově popela, v ruinách Verhoffinovy věže, je ukryt jeho deník. Velmi nás zajímá, co mohou ty zápisky vypovědět o jeho aktivitách. Získejte je pro nás a stanete se mágy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:2
msgid "We have one of those."
msgstr "Jednoho mezi sebou máme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:3
msgid "You are not sorry, but certainly bothersome.  Good day."
msgstr "Už je po prominutí - jste pěkně nepříjemní. Hezký den."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:4
msgid "Our tasks are reserved for those Scholars who would become Mages."
msgstr ""
"Naše úkoly jsou určeny jen a pouze pro učence, kteří se touží stát mágy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:4
msgid "We wish to become Mages."
msgstr "Rádi bychom se stali mágy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:5
msgid "Then do not dally.  Good luck."
msgstr "Pak se už nezdržuj. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:7
msgid ""
"Oh my!  This is terribly interesting.  We better get to work on this right away!"
msgstr "Och! To je hrozně zajímavé. Radši bychom se měli hned dát do práce! "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:7
msgid "We found a silver one."
msgstr "Našli jsme stříbrnou knihu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:8
msgid ""
"Yes.  There are some reports that it may not be in the Verhoffin Ruins at all, and that it is actually in Drangheim.  Wherever it is, find it and bring it here."
msgstr ""
"Ano. Mám zprávy, že možná už neleží ve Verhoffinových ruinách, ale že se v současnosti nachází kdesi v Drangheimu. Ať je, kde je, najděte ji a přineste ji sem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:8
msgid "You want us to get it for you?"
msgstr "Chceš, abych ti tu knihu přinesl?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:9
msgid "Our tasks are reserved for Scholars only."
msgstr "Naše úkoly jsou určeny výhradně pro učence."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC4.rude:9
msgid "We don't have one of those, but perhaps we could work for you."
msgstr "Nemáme žádného, ale snad bychom pro tebe mohli pracovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:10
msgid "Isn't that a nation far to the west?"
msgstr "Není to ten národ daleko na západě?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:11
msgid ""
"Once upon a time, every elf could weave hours of tales on our history.  Since the Great Cataclysm however, not much of our history is left."
msgstr ""
"Každý správný elf dokáže hodiny a hodiny vyprávět o naší historii. Ale od Velké pohromy toho z našich dějin moc nezbylo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:15
msgid "What do you know about Elvish History?"
msgstr "Znáš něco z elfích dějin?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:12
msgid "Certainly.  Ask away."
msgstr "Zajisté. Jen se ptej."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:12
msgid "We would like to ask you a few questions."
msgstr "Moc rádi bychom ti položili několik otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:13
msgid "That's a place I think I'd like to visit someday.  But not today."
msgstr "Na to místo bych se někdy ráda podívala. Ale teď ne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:22
msgid "Nevermind.  Goodbye."
msgstr "To nic. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:2
msgid "Is there anything you could tell us?"
msgstr "Můžeš nám prozradit ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:2
msgid ""
"Once, the elves were the most civilized culture on the planet.  We helped the Emperors of Ursana create great and wonderful things.  If we could only recover a piece of that knowledge, think of what we could accomplish!"
msgstr ""
"Elfové kdysi měli tu nejcivilizovanější kulturu na planetě. Pomáhali jsme ursanským císařům vyrábět skvělé a úžasné věci. Kdybychom tak mohli získat zpět aspoň střípek toho vědění, pomysli, co všechno bychom mohli dělat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:3
msgid "Oh, I'm sure he's around here somewhere."
msgstr "No, jsem si jistá, že bude někde tady poblíž."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:4
msgid ""
"Not much, I'm afraid.  Perhaps you should ask Comhghan A'Dorad.  He has spent a great deal of time studying old maps."
msgstr ""
"Obávám se, že moc ne. Možná by ses mohl zeptat Comghana A'Dorada. Strávil spoustu času studiem starých map."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:4
msgid "Yes!  What do you know about it?"
msgstr "Ano! Víš o tom něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:2
msgid "Certainly"
msgstr "Samozřejmě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:11
msgid "Maybe we could ask you something else?"
msgstr "Nemohli bychom se tě zeptat na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:6
msgid "It's a person."
msgstr "To je osoba."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:6
msgid "Never met him."
msgstr "Nikdy jsem se s ním nesetkala."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:18
msgid "Don't mention it."
msgstr "Už o tom nemluvme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC40.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:13
msgid "Thank you for your time."
msgstr "Děkuji ti, že ses mi věnovala."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:1
msgid "Clans are united!!"
msgstr "Klany jsou sjednoceny!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:1
msgid "Unite the clans"
msgstr "Sjednoť všechny kmeny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:10
msgid "Got rid of the Dook!!"
msgstr "Dook zlikvidován!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPCNAME.rude:418
msgid "The Dook"
msgstr "Dook"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:11
msgid "The Frost Giant"
msgstr "Mrazivý obr"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:11
msgid "The frost giant is dead"
msgstr "Mrazivý obr je mrtvý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:12
msgid "the docks are clear!!"
msgstr "Doky jsou vyčištěny!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:12
msgid "the icy docks"
msgstr "Ledové doky"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:13
msgid "Honky quest"
msgstr "Úkol s kejhovity"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:13
msgid "honkies are gone"
msgstr "Kejhovité jsou pryč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:14
msgid "mountain pass"
msgstr "Horský průsmyk"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:14
msgid "pass is cleared"
msgstr "Průchod je čistý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:15
msgid "Sturm and Drang have gone to war"
msgstr "Sturm a Drang válčí"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:15
msgid "gone to war!"
msgstr "Jdeme do války!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:16
msgid "peace!"
msgstr "Mír!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:16
msgid "war quest is complete"
msgstr "Válečný úkol splněn"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:17
msgid "Player won prize"
msgstr "Hráč vyhrál cenu"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:17
msgid "Won prize!!"
msgstr "Získána cena!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:18
msgid "Betrayed Party!!"
msgstr "Družina zrazena!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:18
msgid "Forad has betrayed the party"
msgstr "Forad zradil družinu"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:19
msgid "Player imprisoned Njam"
msgstr "Hráč uvěznil Njama"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:19
msgid "Put that bastard in prison!!"
msgstr "Ten bastard je ve vězení!!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:2
msgid "When the script stuff works, Ill be the found the party"
msgstr "Až budou skripty fungovat, budu nalezená parta..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:2
msgid "found all members of the party."
msgstr "Všichni členové nalezeni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:20
msgid "6 fires of penance are lit"
msgstr "Šestero ohňů pokání zapáleno"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:20
msgid "Player lit the 6 fires of penance"
msgstr "Hráč zapálil 6 ohňů pokání"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:21
msgid "When the script stuff works, I'll be Luwdwig's Manuscript"
msgstr "Až budou skripty fungovat, budu Luwdwigův rukopis"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:21
msgid "got the manuscript!"
msgstr "Rukopis získán!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:22
msgid "Player got writ of fate"
msgstr "Hráč získal Písmo osudu"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:22
msgid "writ of fate!!"
msgstr "Písmo osudu!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:3
msgid "Got Thjorad!"
msgstr "Thjorad získán!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:3
msgid "When the script stuff works, Ill be The artifact Thjorad"
msgstr "Až budou skripty fungovat, budu artefakt Thjorad"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:4
msgid "Cleared out the keep!"
msgstr "Pevnost vyčištěna!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:4
msgid "Player cleared out Anskram Keep"
msgstr "Hráč vyčistil Anskramskou tvrz."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:5
msgid "Got Kira's response!"
msgstr "Kiřina odpověď získána!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:5
msgid "I'm kira's response from Bjarni"
msgstr "Jsem Kiřina odpověď Bjarnimu"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:6
msgid "Fixed the mines and refinery!"
msgstr "Doly a rafinérie vyřízeny!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:6
msgid "When the script stuff works I be the refinery quest."
msgstr "Až budou skripty fungovat, budu úkol v rafinérii"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:7
msgid "Disabled the defenses!!"
msgstr "Obrana zrušena!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:7
msgid "I'm the defenses in Stenig"
msgstr "Jsem obrany ve Stenig"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:8
msgid "Got the Crona Kiga!"
msgstr "Crona Kiga získána!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:8
msgid "I'm the crona Kiga."
msgstr "Jsem Crona Kiga."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:9
msgid "Book of rules"
msgstr "Kniha pravidel"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:9
msgid "Got the book!!"
msgstr "Kniha získána!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:1
msgid ""
"It is impossible to know all that is knowable.  Life is just too short!"
msgstr ""
"Je nemožné obsáhnout vše, je nemožné získat všechny vědomosti! Život je příliš krátký!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC402.rude:4
msgid ""
"Spend your time carefully.  Pay close attention to things and learn them well."
msgstr ""
"Nakládej se svým časem pozorně. Dávej si pozor a ber si ponaučení ze všeho kolem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC403.rude:1
msgid "I am not in the business of sharing my information."
msgstr "Já se obchodováním s informacemi nezabývám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC403.rude:2
msgid ""
"If you would be an assassin, step carefully.  It doesn't do you any good if your mark hears you approach."
msgstr ""
"Pokud chcete být dobrými vrahy, věnujte pozornost tomu, jak chodíte. Musíte být zticha. Pokud oběť uslyší, jak se blížíte, je to zlé."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC404.rude:1
msgid ""
"I came to Lindisfarne to be away from the noise and bustle of the city."
msgstr ""
"Přišel jsem do Lindisfarnu, abych unikl všemu tomu zmatku a hluku, který panuje ve městě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC404.rude:2
msgid "Is that so?  Well perhaps I can help."
msgstr "Tak? No, možná ti můžu pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC404.rude:2
msgid "We'd like to become Grandmasters in Elemental Magic."
msgstr "Chtěli bychom se stát velmistry v živelné magii."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC404.rude:3
msgid ""
"The best way to prevent yourself from getting hurt is to hit them before they hit you."
msgstr ""
"Nejlepší způsob, jak se vyhnout zranění, je praštit nepřítele dřív, než vás praští on."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC404.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC407.rude:4
msgid "Perhaps."
msgstr "Možná."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC405.rude:1
msgid "I've heard that Arslegard is the most beautiful city in the world!"
msgstr "Arslegard je prý nejkrásnější město na světě!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC405.rude:2
msgid "I may be able to help, if you posses the skills."
msgstr "Pokud máte dovednosti, mohu vám s tím pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC405.rude:2
msgid "We'd like to become Grandmasters in Light Magic"
msgstr "Chtěli bychom se stát velmistry v magii světla."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC405.rude:3
msgid "Don't be dragged down by hate.  It will destroy you."
msgstr "Nenechejte se ovládat nenávistí. Zničila by vás."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC405.rude:5
msgid "No bother.  Goodbye."
msgstr "To nic. Na shledanou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC405.rude:6
msgctxt "said by the party"
msgid "Farewell"
msgstr "Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC406.rude:1
msgid ""
"That promotion is for only the most skilled in Dark Magic.  Do you possess the skills?"
msgstr ""
"Tento titul je pouze pro ty, kteří dosáhli nejvyšší úrovně znalostí v magii temnoty. Patříte mezi ně?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC406.rude:1
msgid "We'd like to become Grandmaster in Dark Magic."
msgstr "Chtěli bychom se stát velmistry v magii temnoty."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC407.rude:1
msgid ""
"But what is news?  Would you consider flowers opening up this morning news?"
msgstr ""
"Co nazýváte novým? To, že se ráno květy rozevřely, je to pro vás novinka?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC407.rude:2
msgid "I can help with that.  Are you certain you are skilled enough?"
msgstr "S tím vám můžu pomoct. Opravdu na to máte dost zkušeností?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC407.rude:2
msgid "We'd like to become Grandmasters in Spirit Magic"
msgstr "Chtěli bychom se stát velmistry v magii ducha"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC407.rude:3
msgid ""
"Adventuring is not about the destination.  It is about the growth of the journey."
msgstr ""
"Dobrodružství není o cíli. Je to o cestě za cílem. A oním cílem může být i sama cesta."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC408.rude:1
msgid ""
"In a meditation recently, I came across the City of Golden Purity.  It was the most beautiful thing I ever saw!"
msgstr ""
"Při meditaci jsem se nedávno dostal do města Zlaté čistoty. Bylo to to nejkrásnější místo, jaké jsem kdy viděl!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC408.rude:2
msgid "We'd like to become Grandmasters in Meditation."
msgstr "Chtěli bychom se stát velmistry v meditaci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC408.rude:2
msgid "You have come to the right place.  I may help you."
msgstr "Jste na správném místě.  Můžu vám pomoct."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC408.rude:3
msgid "Save your money, and buy the most powerful spells you can cast."
msgstr "Šetři si peníze a kup si ta nejsilnější kouzla, jaká dokážeš použít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC409.rude:1
msgid ""
"I really like old books.  I've heard there's a place in Mendossus where they've found a huge collection of them!  I want to go!"
msgstr ""
"Mám opravdu ráda staré knihy. V Mendossusu je prý místo, kde jich našli velkou sbírku! Chci se tam dostat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC409.rude:2
msgid "We'd like to become Grandmasters in Identify Item."
msgstr "Chtěli bychom se stát velmistry v identifikaci věcí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC409.rude:3
msgid ""
"I haven't spent much time on the road, but I can tell you it'll save you a lot of money if you can identify the things you find."
msgstr ""
"Na cestách jsem moc času nestrávila, ale mohu vám říct, že ušetříte spoustu peněz, pokud si dokážete sami identifikovat věci, které najdete."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:1
msgid "Perhaps we could ask you something else?"
msgstr "Snad bychom se tě mohli dotázat na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:11
msgid "If you think you are qualified."
msgstr "Domníváte-li se, že jste dostatečně schopní."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:1
msgid "We'd like to become Experts in Spear."
msgstr "Rádi bychom se stali experty v dovednosti kopí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:5
msgid "We'd like to become Masters in Spear."
msgstr "Mohli bychom postoupit na mistrovskou úroveň v dovednosti kopí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:12
msgid "Beldonia is a nation far to the west."
msgstr "Beldonia je národ daleko na západě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:15
msgid ""
"The elves have a long and cultured history.  Most which is lost.  My ancestors didn't keep their records in the safest place, and most of those documents are now at the bottom of the Verhoffin Sea."
msgstr ""
"Elfové mají dlouhou a ušlechtilou historii, ale většina z ní je ztracena. Moji předkové nechovali záznamy na sdostatek bezpečném místě a většina oněch dokumentů nyní leží na dně Verhoffinova moře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:16
msgid "If I am not mistaken, Tamur Leng is the Prince of Beldonia."
msgstr "Jestli se nepletu, Tamur Leng je princ z Beldonie."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:17 assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:5
msgid "Never mind."
msgstr "To nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:2
msgid "The prince?"
msgstr "Princ?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:2
msgid ""
"Yes.  From what I can discover, all Beldonian princes can trace their lines back to Jevar the Bastard, the man who tore the Ursanian Empire apart."
msgstr ""
"Ano. Podle toho, co vím, pocházejí všichni beldonští princové z Jevara Bastarda, muže, jenž rozdělil celé Ursanské impérium."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:3
msgid ""
"He certainly contributed to it, yes.  But the Great Cataclysm was not the only cause of the fall of the Empire.  In fact, the Ursanian Empire lasted another thirteen years after the Great Cataclysm.  Did you know that?"
msgstr ""
"Zajisté k tomu přispěl, to ano. Ale Velká pohroma nebyla jedinou příčinou pádu této říše. Ve skutečnosti Ursanské impérium přetrvalo ještě dalších třináct let po Velké pohromě. To jste nevěděli?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:3
msgid "We thought Verhoffin tore the Ursanian Empire apart."
msgstr ""
"Mysleli jsme, že rozdělení Ursanského impéria má na svědomí Verhoffin."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:4
msgid ""
"Oh yes.  It was not until Jevar the Bastard finally slew his father, Emperor Trandis in 13 AC that the empire finally fell apart."
msgstr ""
"Ano, bylo tomu tak. Až do chvíle, kdy Jevar Bastard r. 13 po VP konečně zavraždil svého otce, císaře Trandise. Teprve to zavinilo rozpad impéria."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:5
msgid ""
"To become Grandmasters, you must seek out Hrrapp Spearhands in Thjorgard."
msgstr ""
"K dosažení hodnosti velmistra se musíte poohlédnout po Hrrappovi Kopirukém z Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:4
msgid "Where can we become Grandmasters in Spear?"
msgstr "Kde se lze vycvičit na velmistra v kopí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:6
msgid ""
"It is said that Beldonia is the only province on the continent of Rysh that was not touched by the Great Cataclysm."
msgstr ""
"Říká se, že Beldonia je jedinou provincií na kontinentě Rysh, která zůstala nedotčena Velkou pohromou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:6
msgid "What else can you tell us about it?"
msgstr "Co nám o tom ještě můžeš povědět?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:7
msgid ""
"Certainly their architecture is the same, and many of the cultural traditions are unchanged.  However, I think the collapse of the Ursanian Empire would have had a serious effect on Beldonia's economy."
msgstr ""
"Jejich stavební sloh zůstal určitě stále stejný a nezměnily se ani mnohé kulturní tradice. Avšak rozpad Ursanského impéria těžce dolehl na beldonské hospodářství."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:7
msgid "You mean they are the same as they were back then?"
msgstr "Tím myslíš, že jsou pořád stejní, jako byli tenkrát?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC41.rude:8
msgid ""
"Despite that there were no physical changes to Beldonia, I am certain they were plunged into the same dark age in which we now live."
msgstr ""
"Přestože se Beldonia napohled vůbec nezměnila, jsem si jistý, že poklesla do stejného temného věku, v jakém nyní žijeme my."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC410.rude:1
msgid ""
"I found a nagate in my cellar yesterday.  What on earth was it doing there?"
msgstr "Nedávno jsem ve sklepě našel nagata. Co tam zatraceně dělal?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC410.rude:2
msgid "Do you have the skill?"
msgstr "Máte na to zkušenosti?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC410.rude:2
msgid "We'd like to become Grandmasters in Identify Monster."
msgstr "Chtěli bychom se stát velmistry v identifikaci nestvůr."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC410.rude:3
msgid ""
"Listen, the only way to really save your hide out there is to be able to identify the monster that you are fighting."
msgstr ""
"Poslyš, jediný způsob, jak si zachránit kůži, je dokázat zjistit, s čím vlastně bojuješ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC411.rude:1
msgid ""
"My father always used to tell me that the only way to do something is the right way.  Otherwise you're just wasting your time."
msgstr ""
"Otec mi vždycky říkal, že jediný způsob, jak něco udělat, je ten správný způsob. Jinak jenom plýtváš časem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC411.rude:2
msgid "If you think you're ready."
msgstr "Pokud si myslíte, že jste připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC411.rude:2
msgid "We'd like to become Grandmasters in Learning."
msgstr "Chtěli bychom se stát velmistry ve vzdělávání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC411.rude:3
msgid "Study, and study hard.  That's the only way to succeed."
msgstr "Studuj a uč se. To je jediná cesta, která vede k úspěchu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC412.rude:1
msgid ""
"Stand back!  I've got news alright.  I've been working out for weeks on end.  Pretty soon I'll be strong enough to try out for the city guard."
msgstr ""
"Ustup mi z cesty! Posiluju už týdny! Brzy budu tak silný, že se budu moct klidně porvat s městskou gardou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC412.rude:2
msgid "We'd like to become Grandmasters in Body Building."
msgstr "Chtěli bychom se stát velmistry v posilování."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC412.rude:2
msgid "You think you're ready?"
msgstr "Pokud si myslíte, že jste připraveni..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC412.rude:3
msgid ""
"The stronger your body is, the tougher you get.  Work on making your body tough, and you'll stay alive."
msgstr ""
"Čím silnější je vaše tělo, tím odolnější jste. Pracujte na svém těle a přežijete."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC413.rude:1
msgid "I don't share my news."
msgstr "O své informace se nedělím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC413.rude:2
msgid ""
"The successful adventurers are the ones who can sneak up on their opponents.  If they can't see the blow coming, they can't defend against it."
msgstr ""
"Úspěšní dobrodruzi jsou ti, kteří se dokáží nepozorovaně připlížit ke svým protivníkům. Pokud nepřítel nevidí ránu, která na něj míří, nemůže se jí bránit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:1
msgid ""
"I am King of Enroth!  And the devils will be descending upon us at any minute!  As king, it's my duty to stop them!!"
msgstr ""
"Jsem král Enrothu! A ti ďáblové se na nás mohou vrhnout každou chvíli! Je mou královskou povinností je zastavit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:1
msgid "You're not our king.  This isn't..where'd you say you're from?"
msgstr "Ty nejsi náš král. Odkud že to vlastně jsi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:10
msgid "How did you get here?"
msgstr "Jak ses sem dostal?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:10
msgid ""
"Well, I was in the courtyard of Castle Ironfist, talking with my general about how best to handle the devil problem, when the ground started shaking.  This wasn't a normal earthquake, either.  Something felt..wrong."
msgstr ""
"No, byl jsem na nádvoří hradu Ironfistu a bavil jsem se s generálem, jak vyřešit problém s ďáblem, když se najednou začala třást země. A nebylo to normální zemětřesení. Něco bylo... špatně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:11
msgid ""
"The shaking got more violent, and the walls to the castle started falling down.  I was buried under a mountain of rubble.  I got hit in the head with something, and when I woke up, I was here.  I can only assume that the devils took the capital city."
msgstr ""
"Zemětřesení bylo stále silnější a stěny hradu se začaly rozpadat. Během okamžiku jsem byl pohřbený pod hromadou suti. Pak mě něco silně udeřilo do hlavy a když jsem se probral, byl jsem tady. Mohu se jen domnívat, že ďáblové obsadili hlavní město."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:12
msgid ""
"Yes.  My father Roland always told me it's my duty to put my wishes aside, and lookout for the welfare of the people!"
msgstr ""
"Ano. Můj otec Roland mi říkal, že je mou povinnosti starat se o dobro svého lidu a zapomenout na svá vlastní přání!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:12
msgid "Your duty?"
msgstr "Tvá povinnost?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:13
msgid ""
"When I was little, a group of adventurers just like you helped me sneak out of Castle Ironfist.  While they weren't looking, I got away from them and joined the circus!"
msgstr ""
"Když jsem byl malý, skupinka dobrodruhů, jako jste vy, mi pomohla dostat se z hradu ven. Když chvíli nedávali pozor, utekl jsem jim a dal jsem se k cirkusu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:4
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:16
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:23 assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:20
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:7 assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:25
msgid "We'd like to ask you a few questions."
msgstr "Chtěli bychom ti položit pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:15
msgid "Sorry, Nicolai.  We don't have time for that."
msgstr "Je nám líto, Nikolaji. Na tohle nemáme čas."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:15
msgid "Well, alright.  Keep an eye out for the devils!"
msgstr "No, dobrá tedy. Dávej si pozor na ďábly!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:16
msgid ""
"My father always said it was my job to do my duty and put the well being of the people ahead of my own."
msgstr ""
"Můj otec vždycky tvrdil, že musím plnit svou povinnost a klást dobro svého lidu nad svůj vlastní prospěch."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:16
msgid "What do you know about duty?"
msgstr "Co víš o povinnostech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:17
msgid "Okay!  I appreciate you helping out your king!"
msgstr "Fajn! Děkuju, že pomáháš svému králi!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:17 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:15
msgid "We're still trying to find you a job."
msgstr "Snažím se ti sehnat tu práci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:18
msgid ""
"It's boring being king.  I really want to join the circus!  I could be a trapeze artist!  Or the strong man!  Or I could run a game booth!  Hey!  I bet you could find me a job at a circus!  What do you say?"
msgstr ""
"Být králem je nudné! Opravdu jsem se chtěl přidat k cirkusu! Chtěl jsem být akrobatem na hrazdě! Nebo silákem! Nebo bych mohl aspoň vést stánek nebo něco. Hej! Určitě byste mi mohli najít práci v cirkusu! Co vy na to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:18
msgid "You don't sound especially fond of your duty."
msgstr "Nepřipadá mi, že bys byl svou povinností zrovna nadšený."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:19
msgid ""
"I have to stop the devils before they take over the world!  As King, it's my duty!"
msgstr ""
"Musím zastavit ďábly, než ovládnou svět! Je to má královská povinnost!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:2
msgid ""
"It's hard being king when you have no money.  If I worked at the circus, I could raise money for an army!  Then we could send the devils back to where they came from!"
msgstr ""
"Je těžké být králem, když nemáš peníze. Kdybych pracoval v cirkusu, našetřil bych si peníze na armádu! A pak bych mohl poslat ty ďábly tam, odkud přišli!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:2
msgid "What happened to duty?"
msgstr "A co se stalo s tvou povinností?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:20 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:18
msgid "We've found you a job."
msgstr "Máme pro tebe práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:20 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:18
msgid "You have?  Where?"
msgstr "Fakticky? A kde?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:21
msgid "Great!  I love it!  Thanks for all your help."
msgstr "Skvělé! Miluju ji! Děkuju za pomoc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:21 assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:19
msgid "How's the job?"
msgstr "Jak jde práce?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:22
msgid "Bye!  Come back soon!  Thanks for visiting your king!"
msgstr "Ahoj! Vraťte se brzy! Díky, že jste navštívili svého krále!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:23
msgid "See you later!  Thanks for visiting your king!"
msgstr "Na viděnou! Díky, že jste navštívili svého krále!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:3
msgid "Alright.  We'll find you a job."
msgstr "Dobrá. Najdu ti práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:3
msgid "Great!  No, really!  Thanks!"
msgstr "Skvělé! Ne, fakt! Díky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:4
msgid "At the Gathering in Guberland."
msgstr "Na shromáždění v Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:4
msgid ""
"Super!  Thank you very much!  We've just taken our first step in ridding the world of the devils!"
msgstr ""
"Super! Děkuju mnohokrát! Právě jsme udělali první krůček, brzy zbavíme svět ďáblů!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:5
msgid ""
"I am King Nicolai I, Defender of the Land, Bringer of Hope, King of Enroth!"
msgstr "Jsem král Nikolaj I., Obránce země, Nositel naděje, král Enrothu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:6
msgid "If you're a king, what are you doing here?"
msgstr "Pokud jsi král, tak co děláš tady?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:6
msgid ""
"What do you mean?  I am your king!  Now if you'd let me be, I'm busy trying to stop the devils from taking over our world!"
msgstr ""
"Co tím myslíte? Jsem váš král! A teď mě nechte na pokoji, pokouším se zabránit ďáblům v ovládnutí našeho světa!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:8
msgid "The Kr..  Never mind.  You don't seem to understand anyway."
msgstr "Kr... To nic. Stejně bys to nepochopil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:8
msgid "What devils?  What are you talking about?"
msgstr "Jací ďáblové? O čem to mluvíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC414.rude:9
msgid "Maybe we can ask you some questions?"
msgstr "Možná bychom se tě mohli na něco zeptat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:11
msgid ""
"Not yet!  I'm hurrying as fast as I can.  I assure you I will be out of here soon."
msgstr ""
"Ještě ne! Spěchám, co mi síly stačí. Ujišťuji vás, že odsud brzo zmizím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:11
msgid "You finished yet?"
msgstr "Už jsi hotov?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:2
msgid "We'll pass that on to Markel."
msgstr "Vyřídím to Markelovi!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:2
msgid "You do that!  Tell him I'm the one who's in charge!"
msgstr "To udělej! A řekni mu, že já jsem ten, na kom leží zodpovědnost!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:3
msgctxt "said by the party"
msgid "Make it quick."
msgstr "Ale pospěš si."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:3
msgid "Okay, I will!  I promise!"
msgstr "Ano, pohnu, slibuju!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:4
msgid ""
"Okay!  I will!  I promise.  Just give me some time to get my things!  Boy, I'm never going to find Everstrike now!"
msgstr ""
"Dobrá! Půjdu! Slibuju! Jenom mi dej chvilku, ať si můžu sbalit své věci! Ach, a já se domníval, že zde najdu Přesnostříl!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:4
msgid "Then leave."
msgstr "Pak tedy běž."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:5
msgid ""
"Yieeee!  Please don't hurt me!  Okay?  Okay okay?  I'll do whatever you want me to!  I just don't want to get hurt!"
msgstr ""
"Nééé! Prosím, neubližujte mi! Jo? Jo, jo? Udělám, co budete chtít! Jenom mi, prosím, neubližujte!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:6
msgid "Well there's always the sword."
msgstr "No, pak je tady vždycky meč."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:6
msgid "You would use force against me?"
msgstr "Vy byste proti mně použili sílu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:7
msgid "He wants you to leave."
msgstr "Chce, abys odešel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:7
msgid ""
"Well I ain't gonna!  You tell him that I'm in charge here and there's nothing he can do to make me leave!"
msgstr ""
"Ne, já nepůjdu! Řekni mu, že já tomu tady velím a on nemůže udělat nic, co by mě přesvědčilo odejít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:8
msgid "Him?  What does he want?"
msgstr "Ten? A co chce?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:8
msgid "We've been sent by Markel the Great."
msgstr "Posílá nás Markel Veliký."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:9
msgid "Of course not!"
msgstr "Samozřejmě že ne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC415.rude:9
msgid "There's no way you'd leave?"
msgstr "To fakt nemůžeš odejít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:2
msgid "No I'm not!  You'll never cage me!"
msgstr "Ne, já ne! Nikdy mě nechytíš!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:2
msgid "Not you.  You're going to jail."
msgstr "Na tebe ne. Půjdeš do vězení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:3
msgid "Unfortunately, Sven survived."
msgstr "Sven je živý a zdravý."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:3
msgid "You stopped it?  You pigs!  He's going to tax us all into oblivion!"
msgstr "Za to můžete vy! Vy jste ale svině! Takhle se na nás brzo zapomene!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:4
msgid "Seen this letter before?"
msgstr "Už jsi někdy viděl tenhle dopis?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC416.rude:4
msgid "Who are you?  Where did you get that?"
msgstr "Kdo jste? Jak jste k tomu přišli?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:1
msgid "Wonderful.  Good luck"
msgstr "Báječné. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:10
msgid "Very well.  Come back when you are ready."
msgstr "Tak se tedy vraťte, až budete připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:11
msgid ""
"The course is normally reserved as a testing grounds for those who would be Rangers.  I can allow you to practice, but you will not get a reward for completing it.  Is that alright?"
msgstr ""
"Tyto prostory jsou obvykle vyhrazeny pro ty, kdo se chtějí stát hraničáři. Mohu vás tu nechat trénovat, ale za splnění nedostanete žádnou odměnu. Platí?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:11
msgid "We'd like to run the course."
msgstr "Rádi bychom si to tu prošli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:12
msgid "Very well.  Come back when you are ready to practice."
msgstr "Tak se vraťte, až budete připraveni ke cvičení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:13
msgid "Very well.  Return when you are."
msgstr "Tak dobrá. Vraťte se, až budete."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:14
msgid "Congratulations.  You have successfully completed the course."
msgstr "Blahopřeji. Úspěšně jste prošli zkouškou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:15
msgid "No.  Sorry."
msgstr "Ne, je mi líto."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:2
msgid ""
"You must throw the lever, and make it to the door without setting off the traps, and before the time expires.  If you fail, you must return and start over.  Good luck."
msgstr ""
"Ve stanoveném čase musíte stisknout páku a dojít až ke dveřím, aniž byste přitom spustili nějakou past. Pokud se vám to nepodaří, musíte se vrátit a začít znovu od začátku. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:3
msgid ""
"Ah yes.  Wonderful.  Let me explain the procedure.  The Dungeon of Secrets is divided into nine sections, each starts with a lever, and ends with a door."
msgstr ""
"Ach tak. Skvělé. Hned ti celý postup vysvětlím: Žalář tajemství je rozdělen do devíti částí, z nichž každá začíná pákou a končí dveřmi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:3
msgid "We are here for the trial."
msgstr "Jsme tu kvůli zkoušce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:4
msgid ""
"Very well, let me explain the procedure.  The Dungeon of Secrets is divided into nine sections, each starts with a lever, and ends with a door."
msgstr ""
"Tak ti tedy vysvětlím celý postup. Žalář tajemství je rozdělen do devíti částí, z nichž každá začíná pákou a končí dveřmi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:5
msgid ""
"You must throw the lever, and make it to the door without setting off the traps, and before the time expires.  If you fail, you must return and start over.  When you are finished, return to me.  Are you ready to begin?"
msgstr ""
"Ve stanoveném čase musíte stisknout páku a dojít až ke dveřím, aniž byste přitom aktivovali nějakou past. Pokud se vám to nepodaří, musíte se vrátit a začít znovu od začátku. Až skončíte, vraťte se ke mně. Jste připraveni začít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:7
msgid "Welcome to the Dungeon of Secrets.  Can I help you?"
msgstr "Vítej v Žaláři tajemství. Mohu ti být něčím nápomocen?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:9
msgid "I'm afraid you set off a trap.  Would you like to try again?"
msgstr ""
"Obávám se, že jste spustili nějakou past. Chcete si to vyzkoušet znovu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC417.rude:9
msgid "We'd like our reward."
msgstr "Chtěli bychom si vyzvednout odměnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:1
msgid ""
"I've always been fond of tinkering with magic items.  My old master didn't like it, and tried to make me stop.  One time my experiments went horribly wrong, and his shop exploded.  To save myself from his wrath, I fled to Lindisfarne."
msgstr ""
"Vždycky jsem měl slabost pro magické věci. Můj starý mistr je však rád neměl a snažil se mi v tom všelijak bránit. Jednou se mi pokus strašlivě nevydařil a mistrův obchod vyletěl do povětří. Abych se zachránil před jeho hněvem, uchýlil jsem se do Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:1
msgctxt "said by the party"
msgid "Sure!"
msgstr "Jasně!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:3
msgid "We'd like you to make something for us."
msgstr "Rádi bychom, abys pro nás něco udělal."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:4
msgid ""
"I know a great deal.  I've been experimenting with combining things for years.  I have nearly perfected the ability to make better magic items from two other ones."
msgstr ""
"Vím toho spoustu. Po léta jsem s kombinací různých věcí experimentoval. Dosáhl jsem téměř dokonalosti v tom, že dokážu spojením dvou věcí zhotovit jedinou, jež ve všem předčí ty dvě první."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:4
msgid "What do you know about magic items?"
msgstr "Co je ti známo o magických předmětech?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:5
msgid "Okay, was there something else I could help you with?"
msgstr "Mohu pro vás tedy ještě něco udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC418.rude:6
msgid ""
"I'm a tinker!  If you give me any two magic items of the same type, for 500 gold, I will try to combine them into a new, better item.  Would you like me to try to make something for you?"
msgstr ""
"Jsem dráteník! Pokud mi dáš dvě jakékoliv magické věci, za 500 zlaťáků ti z nich mohu složit předmět nový, daleko lepší. Chtěl bys můj um vyzkoušet?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:11
msgid "busted!"
msgstr "Zajat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:11
msgid "None of your business.  Farewell."
msgstr "Do toho ti nic není. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:12
msgid ""
"Thank you!  Don't worry about me, I'll be alright, and I won't blow your cover."
msgstr ""
"Děkuji ti! O mne se nestrachuj, jsem v pořádku a nepoženu se hned za vámi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:12
msgid "We've freed your brother."
msgstr "Osvobodili jsme tvého bratra."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:2
msgid ""
"Alright.  Inside the cow's cage is a secret door that I made, and haven't the nerve to use.  That will take you all the way to the top.  Here, let me unlock it for you."
msgstr ""
"Tak dobrá. V tamhleté kravské kleci jsou tajné dveře, které jsem vyrobil, ale nemám nervy na to, abych jich použil. Ty vás dovedou až nahoru. Hned vám je otevřu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:5
msgid "Sounds like a deal!"
msgstr "To zní jako dobrá úmluva!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:3
msgid "And what will you do for us?"
msgstr "A co pro nás hodláš udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:3
msgid ""
"I will show you a way to get to the top level where the most prominent criminals, including your general are being held."
msgstr ""
"Ukážu vám cestu, jak se dostat do nejvyššího poschodí, kde jsou drženi ti nejstřeženější zločinci, včetně toho vašeho generála."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:4
msgid ""
"My brother Aontoni is being held in the same block as your famous general.  All I want you to do is to find him and open his cell.  I'm certain he would find his way down here."
msgstr ""
"Můj bratr Aontoni je vězněn ve stejné budově jako ten váš slavný generál. Všechno, co po vás chci, je, abyste ho našli a otevřeli jeho celu. Jsem si jistý, že si cestu ven najde sám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:4
msgid "Of course!  What sort of help did you need?"
msgstr "Zajisté! Jakou pomoc potřebuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:5
msgid ""
"This place is crawling with guards, that's why not!  They'll be on you faster than your head can spin!  Of course, I guess I could help you, but you would have to help me."
msgstr ""
"Tohle místo je plné stráží, proto ne! Lapnou vás dřív, než se stihnete otočit! Samozřejmě počítám, že vám mohu pomoci, ale až potom, co pomůžete vy mně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:6
msgid "We've come to rescue Ivsar Forktooth."
msgstr "Přišli jsme zachránit Ivsara Pizizubého."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:6
msgid ""
"You've broken into Drangheim's most notorious prison, and you think you're going to walk out with its most prominent prisoner?"
msgstr ""
"Vloupali jste se do nejstřeženější drangheimské věznice a ještě si myslíte, že se můžete procházet s nejstřeženějším vězněm?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:7
msgid ""
"Like eggplant you are!  You'd better explain to me why I am not calling the guards on you right now!"
msgstr ""
"A jste děsně nenápadní! Radši mi vysvětlete, proč bych na vás neměl zavolat stráž!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:7
msgid "We're just passing through."
msgstr "Jenom tudy procházím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:8
msgid ""
"I don't care what you have!  Now tell me, exactly what it is that you are doing here!  The guards are just on the other side of this door, and will be more than happy to cave your skull in!"
msgstr ""
"Je mi fuk, co u sebe máte! Teď mi hezky povíte, co přesně tu pohledáváte! Strážci jsou přímo za těmito dveřmi a budou víc než šťastní, když vám budou moct rozmlátit lebky!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:8
msgid "We've got a Visitor's Pass"
msgstr "Máme návštěvnickou propustku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:9
msgid "Alright then.  I'm afraid I'll have to call the guards on you."
msgstr "Tak fajn. Obávám se ale, že na vás budu muset zavolat stráž."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC419.rude:9
msgid "Sounds too dangerous."
msgstr "To zní příliš nebezpečně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:1
msgid "Alright.  You're hired."
msgstr "Dobrá. Jsi přijat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:1
msgid "I won't disappoint you."
msgstr "Nezklamu vás."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:10
msgid "Sorry.  We can't afford that much."
msgstr "Odpusť, ale takovou cenu si nemohu dovolit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:11
msgid "If I find anyone looking for a spear, I'll send them your way."
msgstr "Jestli najdu někoho, kdo hledá zdatného kopiníka, pošlu ho za tebou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:11
msgid "Much obliged."
msgstr "Budu ti zavázán."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:13
msgid "Nice place to visit.  Wouldn't want to live there."
msgstr "Krásné místo k návštěvě. Ale nechtěl bych tam bydlet."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:14
msgid "Looking for work."
msgstr "Hledám práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:2
msgid "My fee is 300 gold per month, plus 2% of any gold you find."
msgstr "Má cena je 300 zlaťáků měsíčně plus 2% ze všeho zlata, které najdeme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:3
msgid "I think we could use your services."
msgstr "Myslím, že bychom mohli využít tvých služeb."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:3
msgid "I'd be happy to join you."
msgstr "Rád se k vám přidám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:4
msgid "Anything that will let me put my spear in someone's chest."
msgstr "Jakoukoliv, při níž bych mohl někomu proklát tělo svým kopím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:4
msgid "What sort of work?"
msgstr "Jakou práci?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:5
msgid ""
"Too dangerous.  With all the Chedians that raid that place, you'd hardly last a few days before you found a sword in your belly."
msgstr ""
"Je to příliš nebezpečné. Všichni Chedijci pořádají na toto místo nájezdy, nevydrželi byste tam déle než pár dní a pak byste najednou zjistili, že máte v břiše čísi meč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:7
msgid "Heard the name before.  Don't know anything besides that."
msgstr "To jméno jsem už slyšel. Ale nic dalšího nevím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:8
msgid "Ask away."
msgstr "Ptej se někde jinde."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:9
msgid ""
"I understand.  Well it was great!  I'll be around if you need me again!"
msgstr ""
"Chápu. Inu, bylo to skvělé! Jestli mne budete ještě potřebovat, budu někde tady poblíž!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC42.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:18
msgid "We will no longer be needing your services."
msgstr "Už víc nebudu potřebovat tvé služby."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:2
msgid "Sure!  We'd love to!"
msgstr "Jasně! To bychom rádi!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:3
msgid ""
"I'm a little worried about the harmony I've created in my theme.  It has a regression in it.  I know that you're not supposed to do that, but it sounds so good!"
msgstr ""
"Trochu se obávám o harmonii, kterou jsem si vytvořil. Je v ní určitá regrese. Vím, že něco takového asi nikdy dělat nebudeš, ale zní to dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:4
msgid ""
"I'm writing music!  I've been working on a theme based upon our call to prayer.  I've heard those darned bells so many times, I can't get their melody out of my head!  So I figured I'd go with it.  Would you like to hear it?"
msgstr ""
"Komponuji hudbu! Pracoval jsem na tématu založeném na našem svolávání k modlitbě. Ty zpropadené zvony jsem slyšel už tolikrát, že se jejich melodie pořád nemůžu zbavit! Tak jsem došel k závěru, že se toho budu radši držet. Chcete si to poslechnout?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:4
msgid "What are you doing all the way up here?"
msgstr "Copak to tu děláš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:6
msgid ""
"I like it here!  Not many people come up here to the rafters, so I can write in peace."
msgstr "Mám to tu rád! Moc lidí sem nepřichází, a tak mohu v klidu psát."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:8
msgid "We'd like to hear your song again."
msgstr "Rádi bychom si opět poslechli tvou píseň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC420.rude:8
msgid "Wonderful!  I'd be happy to play it for you."
msgstr "Skvělé! Rád ti to znovu přehraji!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:2
msgid ""
"I am the one who allowed our saint's relic to be stolen.  For penance, I have to stand here and guard Thjorad all day and night."
msgstr ""
"Jsem jedním z těch, kteří dovolili, aby byla naše relikvie ukradena. Jako pokání setrvávám zde a hlídám Thjorad ve dne v noci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:3
msgid "Interesting.  Can we ask you something else?"
msgstr "Zajímavé. Smím se přeptat ještě na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:4
msgid "So you guys are here all the time?"
msgstr "Tak vy jste tu pořád?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:4
msgid ""
"Unless we're at prayer.  Otherwise we are here.  It's Abbot Leffery's way of making us do our penance."
msgstr ""
"Pokud se zrovna nemodlíme. Jinak setrváváme zde. Tak podle opata Lefferyho činíme své pokání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:5
msgid ""
"Brother Kennet is working on the case for Thjorad.  Since it's exposed, Abbot Leffery assigned us to guard it."
msgstr ""
"Bratr Kennet pracuje na Thjoradu. Od té doby, co je tak zaneprázdněný, nám opat Leffery přikázal jej střežit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:6
msgid ""
"It's a marvelous artifact.  I don't know where it came from, but I've heard it's belonged to us for a very long time."
msgstr ""
"Je to podivuhodný artefakt. Nevím, odkud pochází, ale prý nám náleží už velmi dlouho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC421.rude:7
msgid "Of course, friend."
msgstr "Samozřejmě, příteli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC422.rude:1
msgid "Interesting.  Thanks for your time."
msgstr "Zajímavé. Díky za ochotu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC422.rude:2
msgid ""
"Day and night.  Well, except when the bells call us to prayer.  We can't let something like this stop us from conducting our worship."
msgstr ""
"Ve dne v noci. Tedy kromě toho, když nás zvony volají k modlitbě. Nic nám nesmí zabránit v plnění bohoslužeb."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC422.rude:2
msgid "So you're here all the time?"
msgstr "Takže ty tu pobýváš pořád?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC422.rude:3
msgid ""
"I volunteered to Abbot Leffery to guard Thjorad for him.  He said that after our relic was stolen, we needed to guard everything we had."
msgstr ""
"Dobrovolně jsem slíbil opatovi Lefferymu, že budu strážit Thjorad. Pravil, že poté, co byla naše relikvie ukradena, musíme střežit všechno, co máme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC422.rude:5
msgid ""
"I've been here for as long as I can remember.  Abbot Leffery says my parents dropped me off here because they couldn't afford to care for me.  I don't know about that.  As far as I'm concerned, the monks here are my family."
msgstr ""
"Už si ani nepamatuji, odkdy se tu zdržuji. Opat Leffery říká, že mě tu moji rodiče nechali, protože se o mě nemohli starat. Nevím, zda je to pravda. Ale ať přemýšlím, jak přemýšlím, mou rodinou vždycky byli pouze mniši."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC423.rude:1
msgid ""
"I've always wanted to see Thjorad in person, so when Abbot Leffery asked for volunteers to guard it, I was the first to offer my assistance."
msgstr ""
"Vždycky jsem chtěl Thjorad vidět na vlastní oči, a tak když opat Leffery hledal dobrovolníky, kteří jej budou střežit, byl jsem prvním, kdo mu nabídl pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:2
msgid "Alright.  Anything else?"
msgstr "Dobrá. Ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:2
msgid ""
"Stay away from the lower level.  We abandoned that to those infernal insects years ago.  We are not responsible for your safety if you find your way down there."
msgstr ""
"Držte se dál od dolního poschodí. Již před lety jsme je ponechali tomu ďábelskému hmyzu. Jestli tam zabrousíte, nezodpovídáme za vaše bezpečí!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:3
msgid "See the man at the counter.  He'll give you a Visitor's Pass."
msgstr ""
"Poohlédněte se po muži za pultem. Vybaví vás návštěvnickou propustkou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:6
msgid "We want to get into the prison."
msgstr "Rádi bychom se dostali do věznice."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:4
msgid "We want to get in."
msgstr "Chceme se dostat dovnitř."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:4
msgid ""
"You have a Visitor's Pass?  Very well.  Here are the rules:  No consorting with the prisoners.  Stay out of the way of the guards, and do not go into any of the security booths.  Should you do any of those, you will find yourself in deep trouble."
msgstr ""
"Máte návštěvnickou propustku? Tak dobrá. Zachovávejte ale tato pravidla: žádné bratříčkování s vězni, držte se dál od stráží a nevstupujte do žádné z bezpečnostních buněk. Jestli něco z toho uděláte, budete mít velké problémy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:5
msgid "Been caught stealing, eh?  Very well.  I'll let him in."
msgstr "Byl přistižen při činu, že? Výborně. Umístím ho sem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:5
msgid "We have a criminal here."
msgstr "Máme tu vězně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:6
msgid "We want you to open the door."
msgstr "Chtěli bychom, abys otevřel ty dveře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:7
msgid "Thanks.  You can close the door now."
msgstr "Díky. Teď ty dveře můžeš zase zavřít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:8
msgid "Nothing.  Goodbye."
msgstr "Nic. Sbohem."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC425.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC999.rude:16
msgid "blank."
msgstr "prázdné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:1
msgid "Okay!  That's all.  Here's your visitor's pass."
msgstr "Dobrá."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:1
msgid "Uhhh, no."
msgstr "Vlastně ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:2
msgid ""
"Great.  And one final question.  Are you or any member of your party carrying any contraband material such as knives, forks, saws, lockpicks, or birthday cakes?"
msgstr ""
"Prima. A ještě poslední otázka: nenesete s sebou vy nebo někdo z vaší družiny nějaký kontraband, jako jsou nože, vidličky, pily, paklíče nebo narozeninové dorty?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:4
msgid ""
"Are you or any member of your party here to plan a prison break for any of the inmates?"
msgstr "Nezamýšlíš se náhodou vlámat k některému z odsouzenců?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:5
msgid "Are you or any member of your party a fugitive from justice?"
msgstr "Neprchá někdo z tvojí družiny před zákonem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:6
msgid ""
"I can issue you a Visitor's Pass.  I just need you to answer some questions."
msgstr ""
"Mohu ti vydat návštěvnickou propustku. Jen potřebuji, abys mi odpověděl na několik otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:7
msgid "Hello!  We're armed to the teeth here!"
msgstr "Zdravíme! Jsme po zuby ozbrojení!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:7
msgid "Huh?  Oh!  Well now you're going to stay here permanently!"
msgstr "Co? Aha! Tak to tu zůstaneš napořád!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:8
msgid "The only prison break you'll be planning is your own!"
msgstr "Vlámání do vězení, které plánujete, je vaše věc!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC426.rude:9
msgid "Well you came to the right place!"
msgstr "Pak jste na tom pravém místě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:1
msgid "Free?  I'm Free?  Ha ha!  I'm free!  Thank you!"
msgstr "Volný? Jsem volný? Ha, ha! Jsem volný! Děkuji ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:1
msgid "No torture.  You're free to go."
msgstr "Kdo mluví o mučení. Jsi volný."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:2
msgid "Are you the cooks brother?"
msgstr "Ty jsi kuchařův bratr?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:2
msgid ""
"Yes.  If you plan to beat me, get on with it.  Otherwise leave me alone."
msgstr "Ano, Jestli mě chcete bít, tak do toho. Jinak mě nechte o samotě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:3
msgid "Thank you for rescuing me!"
msgstr "Díky za záchranu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:4
msgid "We're not guards.  We're here to rescue you."
msgstr "Nejsme strážci. Přišli jsme tě zachránit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:4
msgid "What sort of torture is this?  Do not tease me so!"
msgstr "Co je to za další muka? Neposmívej se mi!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:5
msgid "b;anmk"
msgstr "b;anmk"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC427.rude:6
msgctxt "said by the party"
msgid "Nothing"
msgstr "Nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC428.rude:1
msgid "I'm the best stones player in all of Thjorgard!"
msgstr "Jsem nejlepší hráč s kameny v Thjorgardu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC428.rude:1
msgid "You're not so tough."
msgstr "Ty nejseš tak tvrdej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC428.rude:3
msgid "Yeah!  Thanks for helping out like this!"
msgstr "Jo! Mockrát ti za to děkuju!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC428.rude:3
msgid "You're Sven's double?"
msgstr "Ty jsi Svenův dvojník?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:3
msgid ""
"Great!  Here's your ticket.  That will be 5 gold.  If you win, you'll get a prize!  If this is your first time, I'll give you some instructions with your ticket."
msgstr ""
"Skvěle! Tady je váš lístek. Bude to 5 zlatých. Pokud vyhrajete, dostanete cenu! Jestli jste tady poprvé, dám vám k vašemu lístku i nějaké instrukce."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:3
msgid "Sure!  We'd love to play."
msgstr "Jistě! Moc rádi bychom si zahráli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:4
msgid "Spectacular!  You will get 10 tickets for 40 gold."
msgstr "Skvělé! Dostanete 10 lístků za 40 zlatých."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:4
msgid "We want a batch of tickets."
msgstr "Chtěli bychom hromadu lístků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:5
msgid ""
"This, my friends is a boat race.  Whoever can get their boat to the end the fastest wins.  Care to play?"
msgstr ""
"Tohle, moji přátelé, je závod lodí. Kdokoliv svoji loď dostane nejrychleji na druhý konec, ten vyhrává. Máte zájem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:5
msgid "What sort of game is this?"
msgstr "Co je tohle za hru?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:6
msgid "Sorry kids, I don't have time for chit chat."
msgstr "Promiň, chlapče. Nemám čas na žvanění."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:7
msgid "Come back when you're interested."
msgstr "Tak se vraťte, až budete mít zájem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC429.rude:7
msgid "Not right now, sorry."
msgstr "Teď ne, lituji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:10
msgid "Waiting.  Me bash for shinies."
msgstr "Čekat. Já mlátit za prašule."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:11
msgid "Magic Shiny.  Good stuff."
msgstr "Magická věc. Dobrý zboží."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:12
msgid "Thanks for your time Tesar."
msgstr "Díky za ochotu, Tesare."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:13
msgid "Sorry Tesar.  Perhaps another time."
msgstr "Promiň, Tesare. Snad někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:14
msgid "No bright.  Good bash."
msgstr "Ne bystrý. Dobře mlátit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:14
msgid "Not too bright though, are you?"
msgstr "Ty nejsi zrovna nejbystřejší, což?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:17 assets_dev/worlds/mm9/dialogue/rude/TOPBLURB.rude:43
msgid "Me bash good."
msgstr "Já mlátit dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:16
msgid "Question.  Ask."
msgstr "Otázky. Ptát se."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:18
msgid "Er?"
msgstr "Co?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:19
msgid "Me good at it.  Me bash for shinies.  You give shinies, me bash."
msgstr "Já v tom dobrej. Já mlátit za prašule. Vy dát prašule, já mlátit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:19
msgid "What do you know about bashing?"
msgstr "Nakolik se vyznáš v tom mlácení?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:2
msgid "Grandpappy is there.  With Pappy."
msgstr "Je tam dědeček. S tatínkem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:20
msgid "We're sure you do."
msgstr "To určitě udělám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:21
msgid "Thanks for your time, Tesar."
msgstr "Díky za ochotu, Tesare."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:3
msgid "We're sure it is."
msgstr "Určitě je tomu tak."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:3
msgid "You give shinies.  Me bash heads for you."
msgstr "Vy dát prašule. Já pro vás rozbíjet kebule."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:4
msgid "500 shinies every moon.  3 part of found shinies."
msgstr "500 prašulí každej měsíc. 3 části nalezenejch prašulí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:4
msgid "Ah, you're for hire.  How much?"
msgstr "Aha, já si tě mohu najmout. Za kolik?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:5
msgid "Alright Tesar.  You're hired."
msgstr "Dobře, Tesare. Najímám tě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:5
msgid "Me bash good for you."
msgstr "Já bojovat dobře pro vás."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:6
msgid "Me sword.  Good for bashing heads."
msgstr "Já meč. Dobře mlátit hlavy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:7
msgid "You give shinies.  Me bash for you."
msgstr "Vy dát prašule. Já mlátit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:8
msgid "Er,.. Uh, oh.  You want good bash, you come back!"
msgstr "Aha... no co. Vy chtít dobře mlátit, vy se vrátit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:8
msgid "You're fired."
msgstr "Jsi propuštěn."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:9
msgid "Isn't that nice.  Can we ask something else?"
msgstr "No, není to pěkné? Můžeme se zeptat ještě na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC43.rude:9
msgid "Questions.  Ask."
msgstr "Otázky. Ptát se."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:10
msgid ""
"Brave souls.  Go through the doors at the end of the hall.  Your opponents will enter from the two side doors.  Good luck!"
msgstr ""
"Máte kuráž! Projděte dveřmi na konci haly. Vaši protivníci se vyhrnou z obou postranních vrat. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:10
msgid "We'd like to fight at the Knight level."
msgstr "Prahnu po boji na úrovni rytířů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:11
msgid ""
"Alright.  These two creatures are the matchup for this bout.  The visitor's fee is 5 gold."
msgstr ""
"Dobrá. v tomto zápase se utkají tito dva tvorové. Každý divák zaplatí 5 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:11
msgid "Neither, but we would like to watch a fight."
msgstr "Rádi bychom se podívali na nějaký zápas."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:12
msgid "We'd like to wager 250 gold"
msgstr "Chtěli bychom vsadit 250 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:13
msgid ""
"I hope you are as good as you are arrogant.  Go through the doors at the end of the hall.  Your opponents will enter from the two side doors.  Good luck!"
msgstr ""
"Doufám, že jste stejně dobří, jako domýšliví. Projděte dveřmi na konci haly. Vaši protivníci se vyhrnou z obou postranních vrat. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:13
msgid "We're the best there is!  Send us in at Lord!"
msgstr "Jsme ti nejlepší z nejlepších! Chceme úroveň lordů!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:14
msgid "Are there no more fights for today?"
msgstr "Dnes už se žádné zápasy nekonají?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:14
msgid ""
"No, I'm sorry.  All the fights for the day are finished.  Come back another time."
msgstr "Ne, je mi líto. Všechny dnešní boje už skončily. Vrať se někdy jindy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:15
msgid "We'd like to wager 500 gold"
msgstr "Chtěli bychom vsadit 500 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:16
msgid "We'd like to wager 1000 gold"
msgstr "Chtěli bychom vsadit 1000 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:17
msgid "I see that you did, yes.  Here are your winnings.  Thanks for coming."
msgstr "Ano, vím to. Zde máte svou výhru. Díky, že jste přišli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:17 assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:19
msgid "We won!"
msgstr "Vyhráli jsme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:18
msgid "No harm in staying alive.  Comeback if you change your mind."
msgstr "Nic se ti nestane, když zůstaneš naživu. Vrať se, až změníš názor."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:18
msgid "Ummm, we decided we don't want to fight today."
msgstr "Mno, rozhodli jsme se, že dnes bojovat radši nebudeme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:19
msgid "Congratulations.  Here's your prize."
msgstr "Blahopřeji! Zde je vaše výhra!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:2
msgid "Go up the stairs behind you to reach the viewing area."
msgstr "Vystupte po schodech za vámi a dosáhnete hlediště."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:2
msgid "Great."
msgstr "Skvělé."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:20
msgid "Very well.  Was there something else you would like to do?"
msgstr "Tak dobrá. Mohu pro vás ještě něco udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:20
msgid "We changed our minds."
msgstr "Rozmysleli jsme si to."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:21
msgid "Come back when you're ready."
msgstr "Vraťte se, až budete připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:21
msgid "Nothing for us today, thank you."
msgstr "Dnes tu pro nás už nic není, děkujeme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:16
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:7
msgid ""
"Great.  If you have the money, Pick which of the contestants you would like to wager on."
msgstr ""
"Skvělé. Jestli máte peníze, zvolte si, na kterého ze soutěžících si chcete vsadit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:3
msgid "We'd like to wager 50 gold"
msgstr "Chtěli bychom vsadit 50 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:9
msgid ""
"Alright.  Go through the doors at the end of the hall.  Your opponents will enter from the two side doors.  Good luck!"
msgstr ""
"Dobrá. Projděte dveřmi na konci haly. Vaši protivníci se vyhrnou z obou postranních vrat. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:4
msgid "We'd like to fight at the Page level."
msgstr "Chtěli bychom bojovat na úrovni pážat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:5
msgid "We're here to fight."
msgstr "Jsme tu, abychom bojovali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:5
msgid ""
"Wonderful!  It's always good to see fearless souls.  What level of a fight would you be brave enough to face?"
msgstr ""
"Báječné! Je vždycky dobré vidět nebojácné duše. Na jaké úrovni si troufáš bojovat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:6
msgid "We'd like to place a bet."
msgstr "Rádi bychom si vsadili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:6
msgid "Wonderful.  How much would you like to wager?"
msgstr "Báječné. Kolik chcete vsadit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:7
msgid "We'd like to wager 100 gold"
msgstr "Chtěli bychom vsadit 100 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:8
msgid "Alright.  Come back when you're interested."
msgstr "Dobrá. Vraťte se, až budete mít zájem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC430.rude:9
msgid "We'd like to fight at the Squire level."
msgstr "Toužím se bít na úrovni zemanů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:1
msgid "You, my lord"
msgstr "Tobě, můj pane."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:11
msgid "We were betrayed."
msgstr "Byli jsme zrazeni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:12
msgid "We serve ourselves."
msgstr "Sloužím sám sobě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:13
msgid "We owe Tamur Leng and Forad Darre a good wholluping!"
msgstr "Tamuru Lengovi a Forad Darrovi dlužím pěkný výprask!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:13
msgid "Wrong!  Though that might make you feel better."
msgstr "Špatně! I když by ti to mohlo udělat dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:14
msgid "We must kill Forad Darre for betraying us."
msgstr "Musíme zabít Forad Darra za to, že nás zradil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:15
msgid "To serve you, my lord."
msgstr "Sloužit tobě, můj pane."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:15
msgid "What is the nature of your failure?"
msgstr "Jaké povahy je vaše selhání?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:16
msgid "We must surrender all our gold and treasure."
msgstr "Musíme se vzdát všeho bohatství a majetku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:17
msgid "We allowed a traitor to stand amongst us."
msgstr "Dovolili jsme, aby se mezi nás vloudil zrádce."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:18
msgid "We must rescue our friends from death."
msgstr "Musíme své přátele zachránit před smrtí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:19
msgid "For what purpose do you quest?"
msgstr "Jaký smysl má můj úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:19
msgid "You, my lord."
msgstr "Tobě, můj pane."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:2
msgid "Wrong?  What have we done wrong?"
msgstr "Špatně? Co jsme udělali špatně?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:20
msgid "To gain experience and riches."
msgstr "Získávat zkušenosti a bohatství."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:21
msgid "We must give up all that we have experienced."
msgstr "Musíme se vzdát všeho, čeho jsme dosáhli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:22
msgid "How must you make amends?"
msgstr "Jak to musíte napravit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:22
msgid "We owe those we betrayed."
msgstr "Jsme zavázáni těm, jež jsme zradili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:23
msgid "We encouraged others to trust our misjudgement."
msgstr "Povzbudili jsme ostatní, aby uvěřili našemu mylnému úsudku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:23
msgid "Whom do you owe?"
msgstr "Komu jsem zavázán?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:24
msgid "We serve Chedian."
msgstr "Sloužím Chedianu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:25
msgid "To save Chedian."
msgstr "Zachránit Chedian."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:26
msgid "We owe the people of Chedian."
msgstr "Jsme zavázáni lidu Chedianu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:27
msgid "We must light the Six Fires of Penance."
msgstr "Musíme zapálit šestero ohňů pokání."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:28
msgid "We must pay whatever price is required, my lord."
msgstr "Musíme zaplatit vše, oč budeme požádáni, můj pane."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:29
msgid "We serve the world."
msgstr "Sloužím světu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:3
msgid "To save the world from Tamur Leng"
msgstr "Zbavit svět Tamura Lenga."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:30
msgid "Shall you pay?"
msgstr "Zaplatíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:30
msgid "The ultimate price, my lord.  Our lives."
msgstr "Tu nejvyšší cenu, můj pane. Naše životy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:31
msgid "We allowed our friends to be slain."
msgstr "Dovolili jsme, aby naši přátelé zemřeli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:32
msgid "We owe no one."
msgstr "Nikomu nic nedlužím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:33
msgid "We must stop Tamur Leng."
msgstr "Musíme zastavit Tamura Lenga."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:34
msgid "To rescue our fallen companions."
msgstr "Osvobodit mé padlé druhy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:4
msgid "We serve the people."
msgstr "Sloužím lidem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:5
msgid "We must kill our betrayer."
msgstr "Musíme zabít zrádce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:6
msgid "Very well.  Speak again with Skraelos."
msgstr "Výborně. Promluv si znova s Skraelosem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:6
msgid "Yes, my lord."
msgstr "Ano, můj pane."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:8
msgid "We must pay the price of our failure."
msgstr "Za své selhání musíme zaplatit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:8
msgid "What price must you pay?"
msgstr "Jakou cenu musíte zaplatit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC432.rude:9
msgid "We trusted a traitor."
msgstr "Uvěřili jsme zrádci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC433.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC71.rude:1
msgid "I don't wanna answer any questions."
msgstr "Nechci odpovídat na žádné otázky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC434.rude:1
msgid ""
"I'm working on the case for Thjorad, of course.  Now if you don't mind, I have to return to it!"
msgstr ""
"Pracuji na Thjoradu, jak snad vidíš. Když dovolíš, rád bych se k tomu zase vrátil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC434.rude:2
msgid "No.  I'm busy."
msgstr "Ne, mám práci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:2
msgid "We'd like more gold."
msgstr "Chtěli bychom více peněz."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:5
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:6
msgid "Your wish is granted."
msgstr "Vaše přání je splněno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:3
msgid ""
"As a reward, I shall grant you a single benefit of your choice.  What would you like increased?"
msgstr "Na oplátku ti poskytnu výhodu, jakou si zvolíš. Co bys rád získal?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:4
msgid "We'd like more experience."
msgstr "Chceme získat další zkušenosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:5
msgid "We'd like an item."
msgstr "Rádi bychom obdrželi nějaký předmět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC435.rude:6
msgid "We'd like an attribute bonus."
msgstr "Toužím po bonusu k některé z vlastností."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:1
msgid ""
"You've always been too big for Ravensford.  I'm sure you will find your destiny out there somewhere, not here.  I have some things left to give you.  They will impart knowledge that may keep you alive.  Farewell."
msgstr ""
"Ravensford vám byl vždycky příliš malý. Jsem si jist, že najdete svůj osud někde tam venku, ne tady. Mám tu nějaké věci, které vám dám. Poskytnou vám vědomosti, jež vás mohou udržet naživu. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:2
msgid "I have something left to give you."
msgstr "Mám tu něco, co bych ti rád předal."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:3
msgid "What do we do when we're finished?"
msgstr "Co máme dělat, až budeme hotovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:3
msgid ""
"When you've finished all the scrolls, come back and visit me before you leave."
msgstr "Až projdeš všechny svitky, před odchodem mne ještě navštiv."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:4
msgid ""
"Take these scrolls to begin with.  They will tell you all you need to know about interface.  Have a look around this museum.  Click on the buttons.  These are things you may encounter in the world.  Some may help you.  Others may, . . kill."
msgstr ""
"Začněte třeba tím, že si vezmete tyto svitky. Řeknou vám vše, co potřebujete vědět o tomto prostředí. Porozhlédněte se tady v muzeu. Klikejte na tlačítka. Jsou tu věci, na které můžete ve světě narazit. Některé vám mohou pomoci. Jiné vás mohou... zabít."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:4
msgid "Where do we start?"
msgstr "Kde máme začít?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:5
msgid "Goodbye, Grandpa."
msgstr "Sbohem, staříku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:6
msgid ""
"Off you go then.  I doubt we shall see each other again, you've always been too big for Ravensford.  Farewell."
msgstr ""
"Tak tedy běž. Pochybuji, že se ještě někdy uvidíme, Ravensford ti byl vždycky příliš malý. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:6
msgid "That shouldn't be too difficult."
msgstr "To by nemělo být moc těžké."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:7
msgid ""
"Ahhh, I knew that this day would come, when your thirst for adventure would grow too strong to be quenched here in Ravensford.  Very well.  I shall help you with your training."
msgstr ""
"Á, věděl jsem, že jednou přijde den, kdy vaše žízeň po dobrodružství bude příliš velká, než abyste ji nasytili v Ravensfordu. Výborně. Pomohu vám s tréninkem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:7
msgid "We'd like to start our training."
msgstr "Chtěli bychom začít s výcvikem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:8
msgid ""
"Think you're already strong enough, do you?  Well we'll see about that.  Standing between here and the dock to the north are a few..obstacles.  If you can make it to the dock, I think you will have proven your worth."
msgstr ""
"Myslíte si, že jste dostatečně silní, ano? No tak se o tom přesvědčíme. Na cestě odtud k dokům na severu je pár... překážek. Pokud je odstraníte, myslím, že tím dokážete své schopnosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:8
msgid "We don't need to bother with training."
msgstr "Nechceme se obtěžovat s výcvikem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:9
msgid "We're ready to leave."
msgstr "Jsme připraveni jít."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC436.rude:9
msgid ""
"Well, I guess you're strong enough.  Good luck.  You can find a boat waiting at the dock to the north.  I don't expect to see you again."
msgstr ""
"No, myslím, že jste dostatečně silní. Hodně štěstí. Na severu v docích na vás bude čekat loď. Neočekávám, že vás ještě někdy uvidím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:2
msgid "Maybe we can ask you something else?"
msgstr "Nemohli bychom ti položit ještě jinou otázku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:10
msgid "Very well.  I shall be around if you need me again."
msgstr "Dobře. Budu poblíž, kdyby sis to náhodou rozmyslel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:12
msgid "We no longer require your services."
msgstr "Už více nepotřebuji tvých služeb."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:11
msgid "Do you know anything about Verhoffin's diary?"
msgstr "Neříká ti něco Verhoffinův deník?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:11
msgid ""
"I heard that he had one, and that Johannes Bem was looking for it.  Didn't pay enough for me to take the job."
msgstr ""
"Slyšela jsem, že nějaký měl a že po něm pátrá Johannes Bern. Nezaplatil mi dost, abych pro něj tu práci vykonala."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:12
msgid ""
"I think he was vilified for no reason.  It was the fault of the Emperors that he caused the Great Cataclysm.  If they would have just left him alone, it would never have happened."
msgstr ""
"Myslím, že ho bezdůvodně pomlouvají. Pravou příčinou Velké pohromy bylo selhání císařů. Kdyby ho nenechali o samotě, nikdy by se to nebylo stalo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:13
msgid "Farewell, then."
msgstr "Tak tedy sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:2
msgid "I am for hire.  I am one of the best mages you'll ever see!"
msgstr "Můžete mne najmout. Patřím k nejlepším mágům, jaké jste kdy potkali!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:3
msgid "Alright.  You can work for us."
msgstr "Tak fajn. Můžeš pro nás pracovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:3
msgid "Thank heavens!  This place was starting to get to my nerves."
msgstr "Díky nebesům! Tohle místo mě už začínalo pěkně znervózňovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:4
msgid ""
"500 Gold every month.  I also take 4% of the gold you find.  I think that's a bargain.  You won't find anything that cheap anywhere!"
msgstr ""
"Každý měsíc 500 zlatých. Také si beru 4% veškerého zlata, jež nalezneme. Myslím, že je to výhodný obchod. Nikde jinde nenajdeš nic tak levného!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:4
msgid "How much?"
msgstr "Kolik?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:5
msgid "I'm one of the best mages around.  And for a price, I'm yours."
msgstr "Jsem nejlepší ze zdejších mágů. Za patřičný obnos se k vám přidám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:5
msgid "Perhaps.  Why would we be looking for you?"
msgstr "Možná. Proč bychom tě měli hledat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:7
msgid "Nothing.  What is that?"
msgstr "Ne. Kdo je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC44.rude:8
msgid "That's a little steep for our pockets."
msgstr "To je na nás trochu moc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:1
msgid "Great, come back when you've rescued him!"
msgstr "Výborně! Vrať se, až ho zachráníš!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:10
msgid "Do you want Drangheim to get all the glory for saving Chedian?"
msgstr ""
"Chceš, aby si Drangheim přivlastnil veškerou slávu za záchranu Chedianu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:10
msgid "That's it.  I will not be manipulated.  Guards!"
msgstr "Tak je to. A vy se mnou nebudete takhle mluvit! Stráže!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:11
msgid "If you do, I shall stop my army.  Farewell."
msgstr "Jestli se ti to podaří, pak svá vojska zastavím. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:11
msgid "We will get you that treaty!"
msgstr "Opatřím ti tu smlouvu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:12
msgid "And you expect me to help Clan Thronheim?"
msgstr "A vy čekáte, že pomohu thronheimskému kmeni?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:12
msgid "As we speak, an army from Beldonia is marching on Thronheim."
msgstr "Zatímco tu hovoříme, na Thronheim pochoduje armáda z Beldonie."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:13
msgid ""
"If you insist.  But I still think Sigmund strong-armed you into doing it for him."
msgstr ""
"Když na tom trváš. Ale přesto si stále myslím, že to byl Sigmundův nápad."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:13
msgid "It wasn't their fault.  The blame lies with us."
msgstr "Nemohli za to. Vina leží na mně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:14
msgid ""
"If you want my help.  I can't take on these hordes without my best general.  Be careful, though.  You may need more experience before you can take on the Drangheim Prison."
msgstr ""
"Jestli tedy potřebujete mou pomoc. Nemohu proti tlupám táhnout bez svého nejlepšího generála. Ale buďte opatrní. Před vstupem do drangheimské věznice budete asi potřebovat více zkušeností."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:14
msgid "You want us to break into a prison?"
msgstr "To chceš, abych se vlámal do vězení?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:15
msgid "Great!  Come back when you're finished"
msgstr "Skvělé! Vraťte se, až budete hotovi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:16
msgid "How will we do that?"
msgstr "Jak to máme udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:16
msgid ""
"It has been overrun by foul creatures.  If we are to occupy it once again, these things need to be destroyed.  You might have some trouble getting in, though. The portcullis is stuck, and the drawbridge is up."
msgstr ""
"Usídlila se tam nečistá stvoření. Máme-li tvrz znovu začít využívat, musíte ty pekelníky odsud vyhnat. Ačkoliv asi budete mít problém dostat se dovnitř. Padací mříž je spuštěná a most je vytažen nahoru.  "

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:17
msgid ""
"There is a place called Anskram Keep in southern Sturmford that we used to use for the defense of our island.  If we are to defeat these invaders, you will need to clear the imps out."
msgstr ""
"Na jihu Sturmfordu je místo zvané Anskramská tvrz, jíž jsme kdysi používali pro obranné síly našeho ostrova. Jestli máme porazit vetřelce, budete muset pevnost nejdřív vyčistit od impíků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:17
msgid "What is the first thing you need?"
msgstr "Co má být ta první věc, kterou potřebuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:18
msgid ""
"I appreciate you being straight with me.  I shall give you aid.  But in order to do so, I will need you to do two things."
msgstr ""
"Oceňuji to, že jste přišli přímo za mnou. Měl bych vám pomoci. Ale než to udělám, potřeboval bych od vás dvě věci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:18
msgid "They come from Beldonia.  We must unite the clans against them."
msgstr "Přicházejí z Beldonie. Musíme proti nim sjednotit klany."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:19
msgid "He is the leader of the Hordes that will soon overrun us."
msgstr "Je to vůdce hord, které sem táhnou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:19
msgid "What are these Hordes?"
msgstr "O jakých hordách to mluvíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:2
msgid ""
"Besides the total destruction of Drangheim, you mean?  I suppose if I had a treaty signed by Sigmund himself, I could withdraw my troops."
msgstr ""
"Myslíš kromě úplného zničení Drangheimu? Počítám, že kdybych měl v rukou smlouvu podepsanou samotným Sigmundem, pak bych své jednotky stáhl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:2
msgid "What would convince you to withdraw your army?"
msgstr "Co by tě přimělo k tomu, abys se svou armádou odtáhl?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:20
msgid "We need your help to defeat Tamur Leng."
msgstr "Potřebujeme, abys nám pomohl zničit Tamura Lenga."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:20
msgid "Who is that?"
msgstr "Kdo je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:21
msgid "Get to the point."
msgstr "Jdi k věci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:21
msgid "We know you are of great importance, and would like your help."
msgstr "Víme, že jsi velmi důležitá osobnost, a potřebujeme tvou pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:22
msgid "I will be sure to let them all know.  I will see you then!"
msgstr "Určitě to všem oznámím. Uvidíme se pak!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:22
msgid "We will meet in Thronheim in two weeks."
msgstr "Setkáme se za dva týdny v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:23
msgid "Drangheim has already promised soldiers and arms."
msgstr "Drangheim už přislíbil vojsko a zbraně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:23
msgid ""
"I feel as though you are trying to manipulate me into doing something.  That will not happen.  Be straight with me or I will take your heads."
msgstr ""
"Cítím, jak se mě snažíte do něčeho vmanipulovat. To se nestane. Buďte ke mně upřímní, nebo si vezmu vaše hlavy."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:24
msgid ""
"Fear not, noble adventurers, Kira the Cold will be mine.  It only takes time.  Was there anything else you needed?."
msgstr ""
"Nebojte se, šlechetní dobrodruzi, Kira Chladná bude mou. Chce to jenom čas. Potřebujete ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:24
msgid "Oh.  In that case, good luck."
msgstr "Aha, tak v tom případě hodně štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:25
msgid "Then I shall await your summons.  Farewell."
msgstr "Pak budu očekávat vaše předvolání. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:25
msgid "We have much work to do, yet."
msgstr "Máme však ještě spoustu práce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:26
msgid ""
"Alright, that is fair.  I can't blame him for not wanting to sign it first.  Plus, it will give me a chance to be with Kira before the war council convenes!"
msgstr ""
"Dobrá, to je spravedlivé. Nemohu mu klást za vinu, že to nechce podepsat jako první. A navíc budu mít šanci spatřit Kiru ještě před shromážděním rady."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:26
msgid "You and Sigmund will sign it together in Thronheim."
msgstr "Ty a Sigmund ji podepíšete v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:27 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:20
msgid "We shall see you there."
msgstr "Tak se tam uvidíme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:27
msgid "Yes.  Have a safe trip."
msgstr "Ano. Šťastnou cestu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:28
msgid ""
"Ha ha!!  I can't wait to see her!  Oh will this be great!  I shall make plans to travel immediately!  Was there anything else you needed?"
msgstr ""
"Ha ha! Nemohu se dočkat, až ji uvidím! Ó, to bude skvělé! Hned si musím celou cestu naplánovat! Chtěli jste ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:29
msgid "Well, she said, umm, er, well, she said..no."
msgstr "Nu, pravila... ehm, no, tedy... vlastně řekla ne."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:29
msgid ""
"What?!  How could she not be aflutter?  I sent her the best love sonnet I wrote!!"
msgstr ""
"Cože?! Co když byla příliš rozechvělá? Poslal jsem jí ten nejlepší milostný sonet, jaký jsem kdy napsal."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:3
msgid "How do we get in?"
msgstr "Jak se dostanu dovnitř?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:3
msgid ""
"The walls are in a sorry state of disrepair.  There's probably a place where you could break through the walls."
msgstr ""
"Zdi jsou v hrozném stavu. Je tam pravděpodobně místo, kterým by ses skrz zeď proboural."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:30
msgid "No!  That was exactly what she was afraid of."
msgstr "Ne! Právě toho se obávala!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:30
msgid ""
"Oh yes, there's going to be a war all right!  A war of love!  I will not stop until I win her heart!"
msgstr ""
"Ano, bude to pořádná válka! Válka lásky! Neustanu, dokud nezískám její srdce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:31
msgid "She called you a great warrior.  You just aren't her type."
msgstr "Nazvala tě velkým válečníkem. Jenom prostě nejsi její typ."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:31
msgid ""
"She said that, did she?  Well I appreciate your honesty.  It's time to go to war!!!"
msgstr "Skutečně řekla tohle? Nu, těší mě vaše upřímnost. Je čas k válce!!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:32
msgid "Ivsar!  Welcome home!!  Was there anything else you needed?"
msgstr "Ivsare! Vítej domů! Potřebovali jste ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:33
msgid "He is here."
msgstr "Je zde."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:33
msgid "Wonderful.  Here is a little reward for your trouble."
msgstr "Báječné. Tady máte menší odměnu za své úsilí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:35 assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:54
msgid ""
"That is the best news I've heard all day!  My messengers will be sent to all the clans at once!"
msgstr ""
"To je ta nejlepší zpráva, kterou jsem za celý den slyšel! Vyšlu posly do všech kmenů najednou!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:36 assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:40
msgid "And you wish my help?"
msgstr "A chcete, abych vám pomohl?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:36
msgid "If we do not unite the clans, they will conquer all the clans."
msgstr "Pokud kmeny nespojím, nakonec ovládnou všechny klany."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:37
msgid ""
"As you know, we have been on bad terms with the filthy Drangheim Clan.  In a battle near ten years ago, they captured our tactical genius, Ivsar Forktooth.  I want you to break him out of Drangheim Prison."
msgstr ""
"Jak víte, měli jsme nějaké spory s drangheimským kmenem. Před pár lety v boji zajali našeho génia v oblasti taktiky, Ivsara Pizizubého. Chtěl bych, abyste ho dostali ven z drangheimské věznice."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:37
msgid "What is the second thing you need?"
msgstr "Jaká je ta druhá věc, co potřebuješ?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:38
msgid "Don't be silly.  Why would my allies do such a thing?"
msgstr "Nebuď směšný. Jak by moji spojenci mohli učinit něco takového?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:38
msgid "They didn't do that, we did!"
msgstr "To neudělali oni, ale my!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:39
msgid "You have?  Wonderful!  Here is a reward!"
msgstr "Opravdu? Báječné! Zde je odměna!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:4
msgid "See!  I told you!  Those filthy Drangheim liars!"
msgstr "Vida! Já jsem ti to říkal! Ti hnusní drangheimští lháři!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:4
msgid "Sigmund wouldn't join the coalition unless we did."
msgstr "Sigmund by se nepřidal ke koalici, kdybych to neudělal."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:40
msgid "If Tamur Leng is not defeated, all of Chedian will suffer."
msgstr "Pokud nebude Tamur Leng poražen, celý Chedian bude trpět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:41
msgid "Do you not want glory?  Would you rather have Drangheim get it?"
msgstr "Cožpak netoužíš po slávě? Raději dopustíš, aby ji získal Drangheim?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:41
msgid "I do not like to be manipulated.  Guards!"
msgstr "Nemám rád, když se mě někdo snaží ovlivňovat. Stráže!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:42
msgid "I understand.  Should you change your mind, let me know."
msgstr "Rozumím. Kdybys náhodou změnil názor, dej mi vědět."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:42
msgid "We don't have time to play matchmaker."
msgstr "Nemáme čas hrát si na dohazovače."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:43
msgid ""
"She did?  Of course she did!  I sent her my best love sonnet!  Ha Ha!  Thank you all!  Here's your reward!!"
msgstr ""
"Vskutku? Jistěže ano! Poslal jsem jí svůj nejlepší milostný sonet! Ha ha! Děkuji vám všem. Zde je vaše odměna."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:43
msgid "She, uhh, she..smiled."
msgstr "Ona, ehm... se usmívala."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:44
msgid "In fact, there might be."
msgstr "Ve skutečnosti bych možná něco potřeboval."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:45 assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:12
msgid "Come back when you're serious"
msgstr "Tak se vraťte, až to budete myslet vážně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:46
msgid "Come back when you're serious."
msgstr "Tak se vraťte, až to budete myslet vážně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:47
msgid "We've rescued Ivsar."
msgstr "Zachránili jsme Ivsara."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:47
msgid "You have?  Great!  Where is he?  We have much to talk about!"
msgstr "Doopravdy? Báječné! Kde je? Máme si tolik co říci!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:5
msgid ""
"Why should I?  They sent one of their agents into Anskram Keep and disabled all of its defenses!  They were planning an invasion already!!"
msgstr ""
"A proč bych to dělal? Jednoho ze svých agentů vyslali do Anskramské tvrze a zničili veškerou její obranu! Už dávno plánovali válku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:5
msgid "You must stop this war immediately!"
msgstr "Okamžitě musíš tu válku zastavit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:50
msgid "We have come with a response from Kira the Cold."
msgstr "Přicházím s odpovědí od Kiry Chladné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:50
msgid "You have?!  What did she say??  Well?  Out with it!!"
msgstr "Ano?! Co říkala?? No tak! Ven s tím!!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:51
msgid "Anskram Keep is clear."
msgstr "Anskramská tvrz je vyčištěna."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:51
msgid ""
"It is?  Great news!  I knew you wouldn't disappoint me!  Here is a reward for your trouble."
msgstr ""
"Vskutku? Skvělá zpráva! Věděl jsem, že mě nezklameš! Tady je odměna za to, že ses obtěžoval."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:52
msgid "We've done as you've asked.  Will you join the coalition?"
msgstr "Učinili jsme, oč jsi žádal. Připojíš se ke koalici?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:52
msgid "Yes!  Yes of course.  When shall we have the war council?"
msgstr "Ano! Samozřejmě že ano! Kdy se uskuteční válečná porada?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:53
msgid ""
"The meaning of what?  You'd better have a good reason for barging in here and yelling at me!"
msgstr ""
"Co co má znamenat? Doufám, že máte zatraceně dobrý důvod, abyste sem takhle vtrhli a obořili se na mě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:53
msgid "What is the meaning of this?!"
msgstr "Co to má znamenat?!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:54
msgid "It is time for the war council.  The clans are united."
msgstr "Nastal čas pro válečnou poradu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:55
msgid ""
"Kira wrote it?!  Wow!  I didn't know she was so interested in the affairs of Sturmford.  Very well.  As soon as Sigmund has signed it, so will I."
msgstr ""
"Kira že ji napsala?! Wow! Nevěděl jsem, že má takový zájem o sturmfordské záležitosti. Dobře. Jakmile to podepíše Sigmund, učiním tak i já."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:55
msgid "We have a peace treaty written by Kira herself."
msgstr "Máme mírovou smlouvu, podepsanou samotnou Kirou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:56
msgid "Bjarni, forgive us.  We are the ones who killed you."
msgstr "Odpusť, Bjarni, ale to my můžeme za tvou smrt."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:56
msgid "Go, friends.  You must succeed in this.  Then all will be forgiven."
msgstr ""
"Ale běžte, přátelé. Musíte vytrvat ve svém úsilí. Pak bude vše odpuštěno."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:6
msgid "Kira has told us you have gone to war with Drangheim!!"
msgstr ""
"Kira nás zpravila o tom, že jsi zahájil válečné tažení proti Drangheimu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:6
msgid ""
"That's right!  Those dirty liars are as two faced as they are ugly!  I can assure you as soon as they are wiped off the planet, I will be able to turn my attention to Tamur Leng and the Beldonians."
msgstr ""
"To je fakt! Ti špinaví lháři jsou stejně hnusní jako pokrytečtí! Mohu vás ujistit, že jakmile zmizí z povrchu planety, budu moci obrátit pozornost k Tamuru Lengovi a Beldonským."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:7
msgid "Of course.  We would be happy to aid you."
msgstr "Zajisté. Rádi ti pomůžeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:7
msgid "When you return with her response, I shall reward you well."
msgstr "Pak se vrať i s její odpovědí. Dobře se ti odměním."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:8
msgid ""
"It is no longer a secret that Kira, the Jarla of Thronheim possesses my heart, my soul, everything that I consider me.  I have composed a letter that will sweep her from her feet and make her mine.  I want you to take it to her."
msgstr ""
"Není žádným tajemstvím, že moje srdce, má duše i všechny mé myšlenky náleží Kiře, jarle Thronheimu. Sepsal jsem dopis, který ji snad přiměje, aby se do mne zamilovala a stala se mou. Chci, abys jí jej doručil."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:9
msgid ""
"Then you shall have it.  However, there are a two things that you will need to do."
msgstr ""
"Pak ji budete mít. Ale předtím je třeba, abyste pro mě vykonali dvě věci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC45.rude:9
msgid "Yes.  We need the help of all the clans."
msgstr "Ano, potřebujeme pomoc všech klanů."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:1
msgid ""
"Be careful.  They may be spies just like us.  If you are discovered, you may jeopardize your lives."
msgstr ""
"Dejte pozor. Mohou to být lidé jako my. Jestli vás objeví, vaše životy budou ohroženy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:1
msgid "We will try to sniff out the spies for you."
msgstr "Pokusím se ty zvědy najít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:10
msgid ""
"I would hate to use such a strong word as sabotage, but I think it is the word that fits.  I believe Drangheim agents have infiltrated our defenses and are planning an attack."
msgstr ""
"Nepoužíval bych tak silného slova jako sabotáž, ale mám za to, že tohle slovo to právě vystihuje. Věřím, že se mezi naše obranné síly vloudili drangheimští špehové a plánují útok."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:10
msgid "You think someone's been deliberately breaking these things?"
msgstr "Domníváš se, že se někdo snaží tyhle věci zničit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:11
msgid "Very well.  I will trust you to keep your lips closed about this."
msgstr "Tak dobře. Věřím, že se o tom alespoň nikde nezmíníš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:11
msgid "We're not spy catchers."
msgstr "Nejsem žádný lovec zvědů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:12
msgid "I understand.  Perhaps if you're not busy later."
msgstr "Chápu. Ale později snad nebudeš tolik zaneprázdněn."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:12
msgid "Sorry.  We've got too much to do already."
msgstr "Odpusť. Teď máme spoustu jiných věcí na práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:13
msgid "Keep your eyes open.  And be careful!"
msgstr "Měj oči otevřené. A buď opatrný!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:13
msgid "Still no luck on the saboteur."
msgstr "Stále se mi nedaří."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:14
msgid "I appreciate your generosity."
msgstr "Obdivuji vaši šlechetnost."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:14
msgid "Perhaps we can buy you a drink?"
msgstr "A což kdybych ti koupil něco k pití?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:15
msgid "We've discovered who the saboteur is."
msgstr "Zjistili jsme, kdo je tím špehem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:15
msgid "You have?!  Who is he?"
msgstr "Opravdu?! Kdo je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:17 assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:18
msgid "No.  Sorry to bother you."
msgstr "Ne. Promiň, že jsem vyrušoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:17
msgid "Yeah, whatever."
msgstr "Jo, nic se neděje."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:2
msgid ""
"Either you're very perceptive, or I've not been as discrete as I need to be.  Either way, perhaps you could help me."
msgstr ""
"Buďto jste mimořádně vnímaví, nebo jsem nebyl tak nenápadný, jak jsem měl. Ať je to, jak chce, možná byste mi mohli pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:2
msgid "What's your trouble?"
msgstr "Co tě trápí?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:3
msgid ""
"There have been..things going wrong lately.  Things that should be working have been breaking.  Walls that should be in working order are found broken.  Defensive structures left wide open!"
msgstr ""
"Poslední dobou se věci hodně zhoršily. To, co by mělo fungovat, se pokazilo. Stěny, jež měly být provozuschopné, jsou nyní rozbité. Obranné stavby jsou zcela nechráněné!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:3
msgid "We'd be happy to help."
msgstr "Rádi bychom pomohli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:4
msgid "I'm not a tour guide."
msgstr "Nejsem žádný průvodce turistů."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:5
msgid ""
"My cover has been blown.  Too many people know I work for Sturmford.  Perhaps you could poke your nose about and try to dig up some dirt.  It may prove to be lucrative."
msgstr ""
"Můj úkryt byl prozrazen. Příliš mnoho lidí ví, že pracuji pro Sturmford. Snad byste do toho ale mohli strčit nos vy a pokusit se něco vyšťourat. Můžete na tom docela vydělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:5
msgid "You can't do anything about it?"
msgstr "A ty s tím nemůžeš nic dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:6
msgid ""
"Disappeared you say?  He must have had a Scroll of Town Portal.  Good thinking on his part.  Don't worry, I'll make certain he pays for this!  Here's your reward."
msgstr ""
"Říkáte, že zmizel? Musel mít u sebe svitek městské brány. To je docela možné. Nebojte, udělám všechno proto, aby za to zaplatil! Tady je vaše odměna!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:6
msgid "He disappeared."
msgstr "Zmizel."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:7
msgid "A man named Randver the Storm."
msgstr "Muž jménem Randver Bouřlivý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:7
msgid ""
"Randver?!  He's one of the Jarl's scribes!  Why, I've trusted him with some very important information!  What happened to him?"
msgstr ""
"Randver?! To je jeden z jarlových písařů! Proč!? A já jsem mu věřil a poskytoval mu velmi důležité informace! Co je s ním?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC46.rude:8
msgid "Thanks, but I won't need it."
msgstr "Díky, ale já je nebudu potřebovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:1
msgid "Eh?  Oh.  Thank you!"
msgstr "Co? Aha. Děkuji!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:1
msgid "We'll get your manuscript for you."
msgstr "Tak my ti ten rukopis najdeme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:10
msgid ""
"Oh, yeah.  That would be great!  I would pay you well if you would go down there and get my manuscript!  It should be easy to find.  A bundle of papers called \"My Evermore Beloved\"."
msgstr ""
"Aha. To by bylo skvělé! Dobře bych ti zaplatil, kdyby ses vydal tam dolů a přinesl mi můj rukopis! Měl by být snadno k nalezení. Je to stoh papírů nazvaný \"Mé navždy milované\"."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:10
msgid "Perhaps we could go down there for you!"
msgstr "Možná bychom tam mohli nakouknout a přinést ti jej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:11
msgid "Huh?  Questions?  I'm sorry I'm too busy for that sort of thing."
msgstr "Cože? Otázky? Lituji, ale na takové věci jsem příliš zaneprázdněn."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:11
msgid "We'd like you ask you a few questions."
msgstr "Toužím ti položit pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:12
msgid "Eh, what's that?  I don't hear so well these days."
msgstr "Cože to? Dnes nějak špatně slyším."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:12
msgid "We've found your manuscript."
msgstr "Našli jsme tvůj rukopis!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:13
msgid "Eh?  You're looking for canned tulips?  Sorry, I only sell beets."
msgstr ""
"Co? Že tu máte připravené tulipány? Je mi líto, ale já prodávám pouze řepu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:13
msgid "We're still searching for your manuscript."
msgstr "Ještě stále pátrám po tvém rukopise."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:14
msgid ""
"My Manuscript!!!  How did you find it?  Oh, A thousand thank yous!! Here's a reward!"
msgstr ""
"Můj rukopis!!! Jak jste jej našli? Ó, tisíceré díky!! Zde je vaše odměna!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:15
msgid "Alright.  Thanks anyway."
msgstr "V pořádku. I tak děkuji."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:15
msgid "Sorry.  We don't have time for that."
msgstr "Je nám líto, ale teď na to nemáme čas."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:16
msgid "DO YOU HAVE ANY NEWS??"
msgstr "MÁŠ NĚJAKÉ NOVINKY??"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:16
msgid ""
"I've got my manuscript back, thanks to you.  I'll be sure to remember that in my dedication!"
msgstr ""
"Díky vám jsem získal svůj rukopis zpět. Budu na to pamatovat ve své závěti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:17
msgid "Eh?  Yeah, goodbye."
msgstr "Co? Jo, sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:18
msgid ""
"You want tanks for your what?  Your wine?  I'm sorry, I only sell beets."
msgstr ""
"Chcete nádrže na co? Na vaše víno? Promiňte, ale já pouze prodávám řepu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:3
msgid ""
"What?  Oh, well you see, I'm a writer, and I've got to get my manuscript back."
msgstr ""
"Cože? No, jak asi vidíš, jsem písař, a potřebuji získat zpět svůj rukopis."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:3
msgid "You don't look that busy to us."
msgstr "Nezdá se nám, že bys měl tolik práce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:4
msgid ""
"Eh?  Oh, the manuscript?  Well it fell down the drain in my Beet Hoven.  I'm afraid of what's down there.  It's very important to me, though."
msgstr ""
"Co? Aha, ten rukopis. Spadl mi do zavodňovacího kanálu mého domu Beet Hoven. Bojím se, co tam dole může být. Ale ta věc pro mne mnoho znamená."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:4
msgid "What happened to your manuscript?"
msgstr "Co se stalo s tvým rukopisem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:6
msgid ""
"Because of the monsters!  If I went down there, they would surely eat me alive!  I don't want to be eaten by monsters."
msgstr ""
"Kvůli těm příšerám! Kdybych sestoupil tam dolů, určitě by mě zaživa sežraly! Nechci být sežrán obludami!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:6
msgid "Why can't you go down there?"
msgstr "Proč si pro něj tam dolů nedojdeš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:7
msgid "Now if you don't mind, I've got some work to do."
msgstr "A teď, pokud se neurazíš, tu mám něco na práci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:8
msgid "WE FOUND YOUR MANUSCRIPT!!"
msgstr "NAŠLI JSME TVŮJ RUKOPIS!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:8
msgid ""
"You have?!  Wonderful!!!  You are a brave sort.  Here's your reward.  Thank you!"
msgstr "Skutečně?! Úžasné! Jste velmi stateční. Zde je vaše odměna. Děkuji."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:9
msgid "Huh?  What's that you said?"
msgstr "He? Co jste to povídali?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC47.rude:9
msgid "Perhaps we could go down there for you."
msgstr "Možná bychom tam mohli nakouknout a přinést ti jej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:10
msgid "See that you don't come back."
msgstr "Koukej, ať už se nevracíš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:2
msgid "We shall."
msgstr "To učiním."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:3
msgid "We found Itlor a job."
msgstr "Našli jsme Itlorovi práci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:3
msgid ""
"You have?  Well I guess I should thank you for that much at least.  If you see them, tell them I love them."
msgstr ""
"Vskutku? Tak to bych vám měl asi poděkovat. Až je uvidíte, vyřiďte jim, že je miluji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:4
msgid "Are you?  What of my children!?"
msgstr "Opravdu? A co bude s mými dětmi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:5
msgid "No!  I can't!  Please no!"
msgstr "Ne! Nemůžu! Prosím, ne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:5
msgid "You've committed a crime. You will have to go to prison for it."
msgstr "Spáchal jsi zločin. Za to budeš muset jít do vězení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:6
msgid ""
"What?  You can't!  I only did it for my children!  Without me they'll starve!"
msgstr ""
"Cože? To nesmíš! Dělal jsem to jen pro své děti! Beze mne by trpěly hlady!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:6
msgid "Yes.  We're going to have to arrest you."
msgstr "Ano. Přišli jsme tě zajmout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:7
msgid "Is that so?"
msgstr "Opravdu?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:7
msgid "We've been watching you, Hat'lai."
msgstr "Sledovali jsme tě, Hat'lai."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:8
msgid "I don't know anything.  Go away!"
msgstr "Nevím nic. Jdi pryč!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:9
msgid "How can I know that?  I'm not there!  How will they eat?"
msgstr "Jak to tak můžete vědět? Nejsem s nimi! Co budou jíst?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC48.rude:9
msgid "Your children will be taken care of, Hatlati"
msgstr "O tvé děti bude postaráno, Hatlati."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:1
msgid ""
"I dunno.  A lot of people around here don't like them.  I don't know why."
msgstr "Ne. Spousta místních lidí je nesnáší. Nevím proč."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:10
msgid "And now he's in jail."
msgstr "A teď je ve vězení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:10
msgid "What are we to do?!  Without him, We'll starve!"
msgstr "Co teď budeme dělat?! Bez něj umřeme hlady!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:12
msgid ""
"A job?  What would I do?  Jobs aren't exactly easy to find around here!"
msgstr "Práci? A co mám dělat? Tady není nijak snadné najít práci!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:12
msgid "Why don't you get a job?"
msgstr "Proč si tedy neobstaráš nějakou práci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:13
msgid "The Jarl?  Don't lie to him.  He doesn't like it when people lie."
msgstr "O jarlovi? Nikdy mu nelži. Nemá rád, když lidi lžou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:16
msgid "Thanks for your help."
msgstr "Díky za pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:15
msgid "Thank you, but hurry!  I don't want my family to starve!"
msgstr "Děkuji ti, ale pospěš si! Nemůžu nechat svou rodinu hladovět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:16
msgid ""
"My father told me to stay away from that place a long time ago.  It's filled with monsters!"
msgstr ""
"Táta mi kdysi radil, abych se od toho místa držel dál. Je plné nestvůr!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:21
msgid "What do you know about Anskram Keep?"
msgstr "Pověděl bys mi něco o Anskramské tvrzi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:19
msgid ""
"It's great!  Injor pays me well.  I appreciate all that you've done for us."
msgstr ""
"Je to skvělé! Injor mi dobře platí. Moc si cením toho, co jste pro nás udělali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:2
msgid "You're welcome.  Good luck."
msgstr "Není zač. Mnoho štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:20
msgid "It's good that you believe that.  Goodbye"
msgstr "Dobře, že tomu věříš. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:3
msgid "At the Magic Shop.  Injor needs someone to help out."
msgstr "Injor z magického obchůdku potřebuje nějakého pomocníka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:3
msgid ""
"She does?  Great!  I'll see her first thing in the morning!!  Thank you!"
msgstr "Vskutku? Skvělé! Hned ráno za ní zajdu. Děkuji ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:4
msgid "Maybe if he worked an honest day, this wouldn't have happened."
msgstr "Možná že kdyby pracoval poctivě, nebylo by se to stalo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:4
msgid ""
"What else would he do?  There's not a lot of 'honest work' around here."
msgstr "Co jiného měl dělat? Tady neexistuje žádná \"poctivá práce\"."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:5
msgid ""
"I don't want to hear a lecture from you.  I get enough of those from my father."
msgstr "Nemíním se od vás nechat poučovat. Toho už mám dost od svého otce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:5
msgid "There are better ways than stealing from the market!"
msgstr "Jsou i jiné způsoby než krádeže na tržišti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:7
msgid "Maybe we can help you with that."
msgstr "Snad bychom ti v tom mohli pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:7
msgid "You would?  Thank you!"
msgstr "To bys udělal? Děkuji ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC49.rude:9
msgid "It's the least we could do.  Can we ask you a few questions?"
msgstr "To je to poslední, co můžeme udělat. Smíme ti položit nějaké otázky?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:10
msgid "I'll give you 1500 gold for it."
msgstr "Dám ti za něj 1500 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:10
msgid "We've got a medium piece."
msgstr "Máme tu středně velký kousek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:11
msgid "Maybe later."
msgstr "Snad později."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:11
msgid "Whatever you want."
msgstr "Jak chcete."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:12
msgid "Great!  What size piece do you have?"
msgstr "Skvělé! Jak veliké kousky máte?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:12
msgid "We've got some Thjorad to sell"
msgstr "Máme na prodej thjorad."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:13
msgid "I'll give you 3000 gold for it."
msgstr "Dám ti za něj 3000 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:13
msgid "We've got a large piece."
msgstr "Získali jsme velký kus."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:15
msgid ""
"I am interested in purchasing any Elemental Thjorad you bring me.  The larger the size, the more I will pay."
msgstr ""
"Zajímám se o nákup thjoradské rudy. Čím větší kus jí bude, tím více ti zaplatím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:15
msgid "No, but perhaps we can do a job for you."
msgstr "Ne, ale možná bychom pro tebe mohli něco vykonat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:16
msgid "How is that?  What sort of help did you need?"
msgstr "Jakou pomoc potřebujete?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:11
msgid "We were wondering if you could help us."
msgstr "Zajímalo by nás, zda nám nemůžeš pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:17
msgid "Come back when you're ready to do business."
msgstr "Vraťte se, až budete moci obchodovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:2
msgid "Sold!"
msgstr "Prodáno!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:4
msgid ""
"That old thing broke again?  As I recall, the last time I made one for Hjarrand, I made two.  Why don't I trade that broken one you have for a fresh clean one?"
msgstr ""
"Ten starý krám je zase rozbitý? Pokud si vzpomínám, když jsem naposledy jeden vyráběl pro Hjarranda, zhotovil jsem dva exempláře. Proč nevyměnit tu tvojí rozbitou součástku za novou a čistou?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:4
msgid "We need a replacement Slag Extractor."
msgstr "Potřebujeme opravit oddělovač strusky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:5
msgid "Great!  Here you go!"
msgstr "Skvěle! Tumáš!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:6
msgid "I'll give you 700 gold for it."
msgstr "Dám ti za něj 200 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:6
msgid "We've got a small piece."
msgstr "Máme malý kousek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:7
msgid "Here you go."
msgstr "Tady je to."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:7
msgid "Perhaps.  Show us what you have"
msgstr "Možná. Ukaž nám, co nám můžeš nabídnout."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:8
msgid "We'd like to do business"
msgstr "Rádi bychom uzavřeli nějaký obchod."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC5.rude:9
msgid "Alright then.  Anything else I can do for you?"
msgstr "Tak tedy dobrá. Mohu pro vás ještě něco udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:1
msgid ""
"Those filthy people!  If they start another war, I'd be happy to go fight!"
msgstr ""
"Ti hnusní lidé! Jestli začnou další válku, ráda se s nimi pustím do boje!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:10
msgid "Not anymore than any other person who hasn't been there would."
msgstr "To ti nikdo z těch, kdo se tam dostali, už nedokáže povědět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:11
msgid "Would you like to buy something?"
msgstr "Nechtěl by sis třeba něco nakoupit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:13
msgid "Are you looking for any help?"
msgstr "Potřebuješ s něčím pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:13
msgid ""
"Yes!  I need someone to watch the shop when I'm gone, wash the walls and mop the floors."
msgstr ""
"Ano! Potřebovala bych někoho, kdo by dohlédl na obchod, když jsem pryč, utíral prach a zametal podlahu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:14
msgid ""
"I hear that he is in love with Kira the Cold.  That poor fellow!  Not that he's a bad looking fellow for a human, but I don't think she's even remotely interested!"
msgstr ""
"Slyšela jsem, že je zamilován do Kiry Chladné. Chudák! Ne, že by byl nějak zvlášť ošklivý, ale nemyslím si, že by se o něj byť jen vzdáleně zajímala!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:2
msgid "What do you know about Bjarni Thorvaldssen?"
msgstr "Máš nějakou povědomost o Bjarnim Thorvaldssenovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:17
msgid ""
"He's doing well.  He's a hard worker, and stays on the right side of the law.  That was a wonderful thing you did for his family."
msgstr ""
"Pracuje dobře. Je to dobrý pracant a stojí na té správné straně zákona. Jeho rodině jste prokázali skvělou službu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:17
msgid "How's Itlor working out?"
msgstr "Jak si vede Itlor?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:2
msgid "We might have the perfect person."
msgstr "Možná že jsme našli tu pravou osobu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:2
msgid "Who is that?  It would have to be someone I trust."
msgstr "Kdo je to? Potřebuji někoho, komu mohu věřit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:3
msgid "Itlor Oord is looking for work."
msgstr "Itlor Oord hledá práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:3
msgid ""
"Oh!  I heard his father got into some trouble.  Send him over.  I would be happy to help him out."
msgstr ""
"Ó! Doneslo se ke mně, že jeho otec má nějaké potíže. Pošli mi ho sem. Ráda mu pomohu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:4
msgid ""
"Because they are a dirty, filthy people!  They come over here, wreck our things!  They steal our babies!  They destroy our crops!  I say get rid of them all!"
msgstr ""
"Protože je to špinavý, nečistý lid! Přicházejí sem a ničí vše, na co přijdou! Kradou nám děti! Ničí nám úrodu! Měli bychom se jich všech zbavit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:4
msgid "Why do you dislike them so much?"
msgstr "Proč je tak nesnášíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:7
msgid ""
"I wouldn't be the one!  If you want to break the Jarl's heart, go right ahead!"
msgstr ""
"Já bych to určitě neudělala! Jestliže nechceš zlomit jarlovo srdce, tak mu to také zamlč!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:7
msgid "No one has told him?"
msgstr "To mu to nikdo neřekl?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC50.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:8
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:9
msgid "Show us what you have."
msgstr "Ukaž nám, co máš na skladě."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:2
msgid ""
"The wizards up at the laboratory have bought every candle in Yorwick this month.  Whatever they are writing, they write it at night."
msgstr ""
"Čarodějové nahoře v laboratoři tento měsíc skoupili všechny svíčky v Yorwicku.  Ať píší cokoli, píší to v noci."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:4
msgid "Show us your books."
msgstr "Ukaž nám své knihy."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:3
msgid ""
"These are no apprentice primers.  Every tome here was copied from a master's own hand.  Look all you like, but mind the pages."
msgstr ""
"Tohle nejsou žádné učňovské slabikáře.  Každý svazek tady byl opsán vlastní rukou mistra.  Dívejte se, jak chcete, ale dávejte pozor na stránky."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:4
msgid "The lamps are out.  Come back in the morning."
msgstr "Lampy jsou zhasnuté.  Přijďte ráno."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:5
msgid ""
"It's quiet, which suits me.  Scholars come from all over to see the laboratories, and scholars buy books."
msgstr ""
"Je tu klid, a to mi vyhovuje.  Učenci se sem sjíždějí odevšad, aby viděli laboratoře, a učenci kupují knihy."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:6
msgid ""
"Here and there.  Frosgard, Lindisfarne, a wizard's widow in Thjorgard.  I don't ask how a book left its last owner, and I'd thank you not to either."
msgstr ""
"Odsud odtamtud.  Frosgard, Lindisfarne, vdova po čaroději v Thjorgardu.  Neptám se, jak kniha opustila svého posledního majitele, a byl bych rád, kdybyste se neptali ani vy."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:6
msgid "Where do your books come from?"
msgstr "Odkud máš své knihy?"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:7
msgid "Ask, then."
msgstr "Tak se ptejte."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC500.rude:8
msgid "Then keep your fingers off the covers."
msgstr "Pak nesahejte na desky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:1
msgid "Uh-oh."
msgstr "No, tedy..."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:1
msgid "What?  What are you talking about?"
msgstr "Jakže? O čem to mluvíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:10
msgid "Not everyone."
msgstr "Každý ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:10
msgid "We thought everyone here hated Drangheim."
msgstr "Měli jsme za to, že Drangheim tu nenávidí každý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:12
msgid "Why would I want to?"
msgstr "Proč bych měl chtít něco takového?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:12
msgid "You don't think you could stop them?"
msgstr "Proč si nemyslíš, že bys je mohl zastavit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:13
msgid "Aren't you Sturmfordian?"
msgstr "Cožpak ty nepatříš ke Sturmfordským?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:13
msgid "Eh?  Oh, yeah, down with Drangheim!  Those dirty pigs!"
msgstr "Co? Jo, aha, pryč s Drangheimem! Jsou to špinavá prasata!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:14
msgid "Alright.  Maybe we could ask you something else."
msgstr "Fajn, tak bychom se tě možná mohli dotázat na něco jiného."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:15
msgid "Most people here call Drangheim a Pond-hole."
msgstr "Většina místních obyvatel Drangheim nazývá odpadní stokou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:15
msgid "Watch your mouth!"
msgstr "Dej si pozor na pusu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:16
msgid "Go away.  Leave me alone."
msgstr "Jdi pryč. Dej mi pokoj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:17
msgid "'Those' Sturmfordians?  What do you mean?"
msgstr "Sturmfordští? Co tím míníš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:17
msgid "Eh, er, nothing!  I meant, 'we' Sturmfordians."
msgstr "Tedy, vlastně nic! Myslel jsem \"my\" Sturmfordští."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:18
msgid "We, er, those Drangheim people are not as bad as everyone thinks."
msgstr "My, no, oni ti drangheimští lidé nejsou tak zlí, jak si každý myslí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:19
msgid "Leave me alone, then!"
msgstr "Tak mi dej pokoj!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:19
msgid "Nothing.  Nevermind."
msgstr "Nic. Nevadí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:2
msgid ""
"He is a pig!  I don't know how a monkey like him could call himself a Jarl!"
msgstr ""
"Je to pěkná svině! Nechápu, jak si takový opičák jako on může říkat jarl!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:21
msgid "It's filled with nasty things.  Those Sturmfordians should be glad."
msgstr "Je plná odporných tvorů. Sturmfordští by měli být rádi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:22
msgid "Leave me alone!"
msgstr "Nech mne být!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:3
msgid ""
"Because if they occupied it, Drangheim might have to come over here and take over."
msgstr ""
"Protože když ji obsadili, Drangheimští můžou klidně přijít a dobýt ji."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:4
msgid "Why do I think that you're lying to us?"
msgstr "Proč jenom mám pocit, že nám lžeš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:4
msgid "Why would I do that?  Hail Bjarni!  He's the best!"
msgstr "Proč bych to dělal? Sláva Bjarnimu! Je nejlepší!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:11 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:20
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:5
msgid "I don't know anyting!"
msgstr "Nevím nic!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:6
msgid "What do you know about sabotage?"
msgstr "Nejsi náhodou drangheimský špeh?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:6
msgid ""
"What do you mean?  I don't know anyting!  I'm not the one who unlocked the town gates!"
msgstr ""
"Co tím chcete říct? Nevím nic! Já nepatřím k těm, co odemkli městské brány!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:7
msgid "BLANK"
msgstr "BLANK"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:7
msgid "What?"
msgstr "Co?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:8
msgid "He's not my Jarl!"
msgstr "Není to můj jarl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:8
msgid "You would dare call your Jarl a pig?"
msgstr "Ty si dovoluješ nazvat svého jarla sviní?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC51.rude:9
msgid "Er, uh nothing."
msgstr "Chm, no, vlastně nic."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:1
msgid "MMMMM!"
msgstr "MMMMM!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:10
msgid "We'd like to talk to you about your news."
msgstr "Rádi bychom si promluvili o klepech, které šíříš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:10
msgid "What are you talking about?"
msgstr "O čem to mluvíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:12
msgid "Arrgh.  Mmmm."
msgstr "Grrr. Hmmm."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:12
msgid "You don't seem to be talkative anymore."
msgstr "Zdá se, že už nejsi tak upovídaná."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:13
msgid "HRRRMPH!!!"
msgstr "HRRRRMFF!!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:2
msgid "Guess we'll leave you alone.  See you later."
msgstr "Počítáme, že tě asi máme nechat o samotě. Nashle později!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:2
msgid "MMMMRRRRG!!!!"
msgstr "MMMMRRRRG!!!!!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:3
msgid "MMMMFFF!"
msgstr "MMMMFFF!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:3
msgid "What's that?  It's hard to understand you without a tongue."
msgstr "Co je to? Je ti dost těžko rozumět, když nemáš jazyk!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:4
msgid "Alright.  Should have kept your mouth shut."
msgstr "Fajn. Měla jsi držet jazyk za zuby."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:4
msgid "We'll see who's sorry!"
msgstr "Uvidíme, kdo toho bude litovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:5
msgid "Not Bjarni.  Sigmund."
msgstr "Bjarnimu ne. Sigmundovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:5
msgid "The Jarl of Drangheim?  Uh,..What can he do?  Go ahead!"
msgstr "Drangheimskému jarlovi? No teda... co může udělat? Pokračuj!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:6
msgid "Bjarni?  Go ahead.  He'll give me a reward!"
msgstr "Bjarnimu? Jen si posluž. Dá mi odměnu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:6
msgid "Perhaps we will inform the Jarl."
msgstr "A co kdybych to pověděl jarlovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:7
msgid "There is nothing you can make me do."
msgstr "K ničemu mě nepřinutíš."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:7
msgid "We've come to ask you to stop."
msgstr "Přišli jsme tě požádat, abys toho nechala."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:8
msgid "We understand you've been spreading gossip to Drangheim."
msgstr "Víme, že jsi po Drangheimu šířila pomluvy, klepy a drby."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:8
msgid "What would you know about that?  I have done nothing wrong."
msgstr "Jak to můžete vědět? Neudělala jsem nic špatného!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:9
msgid "I can't be bothered with that."
msgstr "S tím mě nesmíš obtěžovat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC52.rude:9 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:8
msgid "We'd like to ask you a few questions"
msgstr "Rádi bychom ti položili pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:10
msgid "I guess.  It's too bad we have to kill to solve problems."
msgstr ""
"To si myslím. Je ale zlé, když musíme zabíjet proto, abychom vyřešili nějaké problémy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:10
msgid "Speaking of, perhaps you'd like to purchase a problem solver?"
msgstr ""
"Když už o tom mluvíš, nechtěl by sis pořídit nějakou pomůcku pro řešení takových problémů?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:11
msgid "That you do."
msgstr "To tedy ano."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:13
msgid "I hear those filthy Drangheimers are planning another war."
msgstr "Slyšel jsem, že ti odporní Drangheimští už zase plánují další válku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:14
msgid "Come back when you want business!"
msgstr "Přijďte zas, až budete chtít obchodovat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:14 assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:10
msgid "Nothing today, thank you."
msgstr "Dnes nic, děkuji."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:2
msgid "Sure.  Show us what you have."
msgstr "Jasně. Ukaž nám, co tu máš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:3
msgid "Heck of a way to keep the population down."
msgstr "Zatracený způsob, jak snižovat populaci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:3
msgid "Yeah.  Speaking of population trimmers, would you like to buy one?"
msgstr ""
"Jo. Když už hovoříme o snižování populace, nechtěl by sis k tomu pořídit nějakou vhodnou pomůcku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:4
msgid "Better to not have it at all."
msgstr "Byl bych radši, kdyby se podobné věci vůbec neděly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:4
msgid ""
"War isn't so bad.  Keeps the population down.  If there were no war, we'd all probably be starving to death."
msgstr ""
"Válka není tak strašná. Snižuje populaci. Nebýt válek, asi bychom už pomřeli hlady."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:5
msgid "Maybe a little humanity."
msgstr "Možná trochu lidskosti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:5
msgid ""
"War is war.  People are going to have it whether you want them to or not.  Better to profit by it than be destroyed by it."
msgstr ""
"Válka je válka. Lidé se do ní budou vždycky pouštět. Je lépe z ní těžit, než v ní zemřít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:6
msgid "That's horrible.  Is that all war is to you?  Profit?"
msgstr "To je strašné. To je všechno, co pro tebe válka znamená? Zisk?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:6
msgid "What do you expect?  I sell weapons."
msgstr "Co jste čekali? Prodávám zbraně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:7
msgid ""
"They're always planning to fight.  It's all the same to me.  Because of that, I get more business."
msgstr ""
"Vždycky chtěli bojovat. Připadá mi to pořád stejné. A díky tomu uzavírám další obchody."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:7
msgid "What makes you think that?"
msgstr "Co tě vede k této domněnce?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC53.rude:9
msgid "Sorry, We're closed.  Come back tomorrow"
msgstr "Promiň, ale máme zavřeno. Vrať se zítra."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:2
msgid ""
"There is always conflict between Sturmford and Drangheim.  It's a good time to buy armor.  Would you like some?"
msgstr ""
"Mezi Sturmfordem a Drangheimem byly vždycky nějaké rozepře. Nastal čas pořídit si nějaké brnění. Chtěl bys?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:2
msgid "War?  Who is he planning to go to war against?"
msgstr "Válka? A proti komu míní táhnout?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:3
msgid ""
"He claims it's to replace old and worn out suits, but I think he's getting ready to go to war."
msgstr ""
"Tvrdí, že potřebuje nahradit staré a obnošené zbroje, ale já si myslím, že se chystá k válce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:3
msgid "What's all that armor for?"
msgstr "K čemu všechno to brnění?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:5
msgid "Show us your stuff."
msgstr "Pochlub se, jaké zboží tu máš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:6
msgid ""
"Sorry.  I don't have much time for that sort of thing.  Bjarni has me making two hundred new suits of armor, and I don't spend much time in the tavern these days."
msgstr ""
"Je mi líto. Nemám na takové věci čas. Bjarni mi nakázal, abych zhotovil dvě stě nových kompletních zbrojí, a tak poslední dobou nemohu trávit moc času v hostinci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC54.rude:7
msgid "Come back when you have money, cheapskate!"
msgstr "Tak se vraťte, až budete mít prachy, skrblíci!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:1
msgid ""
"Ah, is that so?  Let me give you some advice, then.  Without the right writ, everything will be wrong."
msgstr ""
"Opravdu? Pak ti dám jednu radu, ať se ti daří: bez správného písma všechno se samo zmaří!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:1
msgid "We're trying to stop him."
msgstr "Snažím se ho zastavit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:10
msgid "Mad?  Is that what they're saying about me these days?"
msgstr "Šílený? Tak se o mně dneska mluví?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:10
msgid "We've heard you are the Mad Wizard Robinssen."
msgstr "Doneslo se nám, že jsi šílený čaroděj Robinssen."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:11
msgid "You want the help of a mad wizard?  What's wrong with you?"
msgstr "Žádáte pomoc od šíleného čaroděje? Co se to jen s vámi děje?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:13
msgid "How did you get back?"
msgstr "Jak ses dostal zpátky?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:13
msgid "Skraelos had to let me go.  He had to make good on his bet."
msgstr ""
"Co je to za otázku? Skraelos mne nechal jít. Musel na mne hodný být, když prohrál sázku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:14
msgid "That is very astute of you!  Perhaps you are smarter than rodents."
msgstr ""
"Pánové, to je velmi rafinované! Taková věc! Možná jste ještě chytřejší než hlodavec."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:14
msgid "You don't say.  We always thought mesonite was unstable."
msgstr "Nepovídej. Vždycky jsme si mysleli, že mesonit je nestabilní."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:4
msgid "I suppose you may."
msgstr "Snad se můžete i na něco otázat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:16
msgid "Do you sometimes think you're Krohn?"
msgstr "Nemyslíš si občas, že jsi Krohn?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:16
msgid "I've been known to dress like him on occasion."
msgstr "Příležitostně udávám módě tón tím, že se oblékám stejně jak on."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:17
msgid ""
"Actually, he bet me.  He didn't think I could summon a lightening bolt on command all the way in Arslegard.  He's still feeling a little burned on that, I think."
msgstr ""
"Vlastně se vsadil on se mnou. Ten starý bard nevěřil, že bych jednou dokázal vyvolat blesk a řídit jej přes celý Arslegard. Osud ale bývá krutý - myslím, že teď je z toho trochu ožehnutý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:17
msgid "You bet a god?"
msgstr "Ty ses sázel s bohem?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:18
msgid "That is for you to understand."
msgstr "Povídám, že tomu musíte porozumět sami."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:18
msgid "What is that supposed to mean?"
msgstr "Co to má naznačovat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:19
msgid ""
"Sure.  I had a great chat with Krohn on the formation of the universe.  A stunning fellow, that chap."
msgstr ""
"Jistě, bylo to legrační, a víc než řekne krátká věta - pěkně jsme si s Krohnem popovídali o stvoření světa. Ten hoch je prostě senzační."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:19
msgid "You've been there?"
msgstr "Ty jsi tam byl?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:2
msgid "Well you can't have it!  Now go away!"
msgstr "Ale nic nedostaneš! A teď běž!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:20 assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:24
msgid "Thanks for the advice.  Can we ask you something else?"
msgstr "Díky za radu. Můžeme se tě dotázat i na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:20
msgid "You may.  I might even have an answer for you."
msgstr "To smíš. Snad se i nějakou tu odpověď dozvíš."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:21
msgid "Sorry.  We don't have that much money."
msgstr "Je nám líto, ale tolik peněz u sebe nemáme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:21
msgid "Well I ain't going to give it to you!"
msgstr "Kšic! Pak tedy nedostaneš nic!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:22
msgid "Next time it won't be free."
msgstr "Příště už to nebude zadarmo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:23
msgid "Is that so?  I might have a few answers for you."
msgstr "Je tomu tak? Však vám snad i odpovědi dám - ale až pak."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:24
msgid "You can ask.  I might even have an answer."
msgstr "Můžete se ptát. Možná že i nějakou odpověď budu znát."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:25
msgid ""
"It's a nice place.  Although Hanndl can sometimes be a pain.  If you ever go there, make sure you take a drink at the tavern."
msgstr ""
"To krásné místo jest. I když Hanndl může občas znamenat i bolest. Chcete-li tam jíti, určitě si dejte v hospodě něco k pití."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:26
msgid ""
"That's what they all say when they want something from me.  What is it that you want?"
msgstr ""
"Tuhle písničku vždy pějí ti, co po mně něco chtějí. Proč sem jdete? Co mi chcete?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:26
msgid "We're sure you're not mad."
msgstr "Víme jistě, že nejsi šílený."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:27
msgid "You're lucky it's free.  Next time it may not be."
msgstr ""
"Dnes je to zdarma, tak buďte rádi. Příště mi budete muset spoustu peněz dát."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:28
msgid ""
"Well we both agree that the identification of dark matter will probably unlock all the mysteries of the universe, but he thinks that dark matter will have the properties of mesonite.   Mesonite is too unstable to exist in such large amounts though."
msgstr ""
"Oba si myslíme, že když původ téhle substance zjistíme, rozluštíme i všechna tajemství světa. On se domnívá, že ta hmota vlastnosti mesonitu má. Tato látka je však příliš nestabilní, než aby mohla existovat v takovém množství."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:28
msgid "What did he have to say?"
msgstr "Co ti pověděl?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:29
msgid "Go away!  Don't bother me anymore."
msgstr "Tak kušuj! A víckrát už mě nevyrušuj!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:3
msgid "Is that so?  What is it that you want?"
msgstr "Že neodejdete? A co tedy chcete?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:3
msgid "We won't go away until you help us!"
msgstr "Neodejdeme, dokud nám nepomůžeš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:30
msgid ""
"He's vastly overrated as a mage.  If he had been more skilled, he might have had enough sense to not mess with the things he was messing with."
msgstr ""
"Jako mág je velmi přeceňován. Kdyby byl ve svém řemesle zběhlejší, viděl by i věci vedlejší. Byl by hlava rozumná, která nestrká nos tam, kam nemá."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:31
msgid "You should be thankful.  I should charge you for it!"
msgstr "Važte si toho. Příště vás to bude stát peněz mnoho!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:4
msgid ""
"Have it?  What is wrong with people these days?  I invented the darned thing!"
msgstr ""
"Že jej vlastním? Můj jazyk jen kleje, co se to teď s lidmi děje! Každá část té zatracené věci je dílem mých rukou přeci!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:4
msgid "We've heard you have a Black Orb of Knowledge."
msgstr "Doslechli jsme se, že vlastníš černý orb vědění."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:5
msgid "Do you have one?  If you do, we'd like to buy it from you."
msgstr "Máš nějaký? Pokud ano, velmi rádi bychom jej od tebe koupili."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:5
msgid ""
"Have one?  Why sure, I've got one.  Would I sell it though?  I'm not sure."
msgstr ""
"Tvrdíš, že jej vlastním? Správně se ti jevím. Ale zda jej prodám, to namouvěru nevím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:6
msgid "Name your price."
msgstr "Řekni si cenu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:6
msgid ""
"Well If that were the case, I'd charge you a million gold.  I'm pretty sure that you wouldn't pay that much for it.  It's a pretty useful item, though.  2000 gold."
msgstr ""
"Inu, kdyby na to přišlo, na milión by vás to vyšlo. Ale moc dobře vím přec, že tolik byste nezaplatili - ani za tak užitečnou věc. Tak dost těch fraků, dáte mi 2000 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:7
msgid "That's pretty steep."
msgstr "To je trochu moc."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:7
msgid ""
"Well I don't really need to sell it.  If you want it, that's how much you'll have to pay for it."
msgstr ""
"Nu, skutečně to nepotřebuji prodávat, ale když už to mít máte, právě tolik peněz mi za to dáte!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:8
msgid "Nice doing business with you."
msgstr "Bylo mi ctí s vámi obchodovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:8
msgid "Well, alright.  2000 gold it is."
msgstr "Tak dobrá. Tady je 2000 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC55.rude:9
msgid ""
"That man is dangerous.  It's very possible that he'll become the new ruler of Chedian.  Perhaps the Ursanian Empire will live again."
msgstr ""
"Ten muž je nebezpečný. Na druhou stranu je dosti pravděpodobné, že se stane novým vládcem Chedianu. A dodám tiše, že tak znovu obživne i Ursanská říše."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:12
msgid ""
"Well we need an Orb of Linking.  If we had one of those, all the banks in Chedian could be linked up!"
msgstr ""
"No, protože potřebujeme orb přenosu. Až ho budeme mít, všechny banky v Chedianu budou propojeny!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:13
msgid ""
"Our local writer, Ludwig Van has been walking around very depressed lately."
msgstr "Náš místní spisovatel Ludwig Van je poslední dobou velmi smutný."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:15
msgid "No, We would like to ask some questions."
msgstr "Ne. Ale měli bychom na tebe pár otázek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:16
msgid "An Orb of Linking?  Those are real?!  Of course you can install it!"
msgstr ""
"Orb přenosu? Copak něco takového existuje?! Samozřejmě že jej sem můžete umístit!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:16
msgid "We've come to install an Orb of Linking."
msgstr "Přišli jsme sem umístit orb přenosu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:17
msgid "Great!  Thanks for all your help!"
msgstr "Výborně! Díky za pomoc!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:2
msgid ""
"I don't know what the big deal is about.  I don't think they're half as bad as all the Sturmfordians think."
msgstr ""
"Nevím, v čem je vlastně problém. Myslím, že nejsou ani z poloviny tak zlí, jak si Sturmfordští myslí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:3
msgid "From what we've heard that sort of talk is close to treason."
msgstr "Podle toho, co jsme slyšeli, podobné řeči se blíží vlastizradě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:3
msgid ""
"Some people get a little overzealous about the conflict between our sister clan."
msgstr ""
"Někteří jsou příliš horliví, co se týče sporu s naším sesterským kmenem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:5
msgid "Sister Clan?"
msgstr "Sesterským kmenem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:5
msgid ""
"Yes.  A few generations ago, there was a conflict between Sturm, our Clan leader, and his sister, Drang.  Drang finally left with her followers and became the Jarla of a new clan."
msgstr ""
"Ano. Před nemnoha generacemi nastal spor mezi Sturmem, vůdcem našeho kmene, a jeho sestrou Drang. Drang nakonec se svými věrnými odešla a stala se jarlou nového kmene."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:6
msgid ""
"Ludwig Van lives in his shop.  A place called the Beet Hoven.  It's on the corner, right across the street from the park"
msgstr ""
"Ludwig Van žije ve svém obchůdku. Na místě zvaném Beet Hoven. Je to na rohu, z parku přímo přes ulici."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:7
msgid "I'm not sure.  He only mumbles something about his manuscript."
msgstr "Nevím. Mumlá cosi o nějakém rukopise."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:8
msgid "Yes.  We would like to do some banking."
msgstr "Ano. Rádi bychom přešli k bankovním transakcím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:9
msgid "He's not one of our clients."
msgstr "Je jedním z našich zákazníků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC56.rude:9
msgid "What do you know about Tamur Leng"
msgstr "Víš něco o Tamuru Lengovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:1
msgid ""
"If you don't pay, you don't stay!  I won't do any business with you until you pay for that window!"
msgstr ""
"Když nezaplatíte, tak tu ani nezůstanete! Nebudu s vámi obchodovat, dokud mi nenahradíte to rozbité okno!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:1
msgid "What?  That's way overpriced.  We're not paying!"
msgstr "Co? To je poněkud předražené. Tolik tedy nezaplatím!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:11
msgid "Dragons?  Tell us about the dragons."
msgstr "Draci? Povídej nám o dracích."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:11
msgid ""
"Well, there aren't very many of them left in the world, I can tell you that much.  I have heard rumors, though.  Men come in here from time to time, look at my prize, and tell me the dragon stories."
msgstr ""
"No, můžu ti říci pouze tolik, že ve světě jich už moc není. Ačkoliv jsem zaslechl nějaké fámy. Muži sem jednou za čas přijdou, podívají se na mé ceny a poví mi příběhy o dracích."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:12
msgid "We'd like to hear the dragon stories."
msgstr "Rádi bychom slyšeli příběhy o dracích."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:12
msgid ""
"Well, they say that there's one left, though I'm not sure where he is.  But I do know someone who does!"
msgstr ""
"No, říká se, že tu jeden byl, ačkoliv si nejsem jist, kde by mohl být. Ale znám někoho, kdo to ví!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:13
msgid ""
"His name is Snorri the Fist.  He's an old warrior who spends most of his time in a bottle."
msgstr ""
"Jmenuje se Snorri Pěst. Je to starý bojovník, který strávil většinu času s lahví v ruce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:13
msgid "Who?"
msgstr "Koho?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:14
msgid ""
"If he's anything like I remember him, probably somewhere inside a bottle in Thjorgard."
msgstr ""
"Pokud je to tak, jak si vzpomínám, pravděpodobně by měl být v Thjorgardu, a asi si pořád bude pořádně přihýbat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:15
msgid "Alright.  We're sorry.  We'll pay for it."
msgstr "No jo. Omlouvám se. Zaplatím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:15
msgid "Thank you.  Come back later, and I'll be happy to do business again."
msgstr "Děkuji. Přijďte později a rád s vámi uzavřu nějaký ten obchůdek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:16
msgid ""
"If you find one of those, look out!  They're usually heavily trapped.  But if you can get into one without getting yourself killed, the treasure inside is worth it!"
msgstr ""
"Jestli na něco takového narazíš, pak se měj na pozoru! Obvykle bývají opatřeny mnoha pastmi. Ale pokud se ti podaří dostat se dovnitř, aniž bys přitom zahynul, obsah za tu námahu bude určitě stát!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:16
msgid "What do you know about Black Chests?"
msgstr "Máš povědomost o černých truhlicích?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:17
msgid "Suit yourself."
msgstr "Hodí se k vám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:17
msgid "That's nice.  Congratulations."
msgstr "To je hezké. Gratuluji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:18
msgid "Certainly.  Would you like a drink?"
msgstr "Ovšem. Nedal by sis něco k pití?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:19
msgid ""
"No!  You broke my window.  You don't get anything around here until you pay for it!  That glass cost me 300 gold!"
msgstr ""
"Ne! Rozbili jste mi okno. Nedostanete nic, dokud za ně nezaplatíte! To sklo mě stálo 300 zlaťáků!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:2
msgid "Artifact?"
msgstr "Artefakt?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:2
msgid ""
"Yes.  Like Spencer's Obedience.  It may be a club, but it packs a better wallop than any old sword!"
msgstr ""
"Ano. Například zbraň, jako je Spencerova poslušnost. Je to sice kyj, ale má lepší úder než kdejaký starý meč!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:22
msgid ""
"Some guy came in here the other day talking about her.  Maybe you could ask him."
msgstr ""
"Onehdá se tu o ní nějaký chlapík zmiňoval. Možná by ses mohl přeptat jeho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:23
msgid "Anything else of interest?"
msgstr "Něco jiného zajímavého?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:23
msgid ""
"Maybe.  You look the sort who would be crazy enough to be interested.  You see that dragon over the door?  That was Thoronax, the last of the great red dragons.  I slew him myself."
msgstr ""
"Možná. Vypadáš na někoho dostatečně bláznivýho, koho by to mohlo zajímat. Vidíš toho draka nade dveřmi? To byl Thoronax, poslední z velkých rudých draků. Zabil jsem ho sám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:24
msgid "Come back when you're thirsty."
msgstr "Vraťte se, až dostanete žízeň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:25
msgid "Certainly.  Maybe buy a drink?"
msgstr "Zajisté. Nedáš si něco k pití?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:3
msgid ""
"Oh, I don't know where it is.  Somebody probably has a hold of it somewhere."
msgstr "Tak to netuším. Pravděpodobně ho už někdo používá."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:3
msgid "Where can we find it?"
msgstr "Kde bychom ho mohli nalézt?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:5
msgid ""
"They're scattered all over.  You're best bet would be to take a quest from someone."
msgstr ""
"Těžko říct. Nejlepší bude, když se na to zeptáš někoho, kdo o tom něco ví."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:7
msgid ""
"If you can find yourself an artifact, they're usually worth the trouble they cause."
msgstr ""
"Pokud dokážeš získat nějaký artefakt, určitě to bude stát za tu námahu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:8
msgid "No problem.  Anything else I can help you with?"
msgstr "Žádný problém. Něco jiného, s čím ti mohu pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC57.rude:9
msgid ""
"He's probably still hanging around Sturmford.  He said his name was Doorsbane.  Halfdan Doorsbane, I think."
msgstr ""
"Znám a pravděpodobně se potlouká stále ještě ve Sturmfordu. Prý se kdysi jmenoval Vratoborec. Halfdan Vratoborec, myslím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:10
msgid "Blessings be with you, children."
msgstr "Požehnání vás provázej, děti."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:2
msgid "Alright, we're sorry.  We'll pay for the glass."
msgstr "Tak dobře, omlouvám se. Zaplatím ti to sklo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:2
msgid ""
"Thank you very much!  Come back later and I would be happy to heal you."
msgstr "Děkuji vám mnohokrát! Přijďte později a velice ráda vás vyléčím."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:3
msgid ""
"You should not be asking questions about that place.  When the time comes.  All your questions will be answered."
msgstr ""
"Na to místo byste se radši ani neměli vyptávat. Všechny vaše otázky budou zodpovězeny, až nadejde ten pravý čas."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:4
msgid "Blessings upon you."
msgstr "Nechť vás provází požehnání."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:4
msgid "Yes.  We would like some healing."
msgstr "Ano. Potřebujeme nějaké uzdravení."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:5
msgid "No way!  That's way too much!"
msgstr "Ne! Ta cena je děsně přemrštěná!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:5
msgid "Then you will have to go somewhere else for your healing!"
msgstr "Pak si pro uzdravení budete muset dojít někam jinam."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:6
msgid "The blessings of the gods upon you, children."
msgstr "Nechť ti bohové požehnají, dítě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:6
msgid "We would like to make a donation"
msgstr "Rádi bychom poskytli chrámu příspěvek."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:8
msgid ""
"No!  You've been fooling around in here and you broke a window!  Those windows cost seven hundred gold!  I won't heal you until you pay for them!"
msgstr ""
"Ne! Rozbili jste tu okno! Taková okna stojí sedm set zlaťáků! Neposkytnu vám uzdravení, dokud mi za ně nezaplatíte!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:9
msgid ""
"Ah, they're finally replacing that temple in Guberland, are they?  I'm afraid I can't help you.  I am the only one here."
msgstr ""
"Á, tak konečně opět zprovozňují ten chrám v Guberlandu, že? Obávám se však, že ti v této věci nemohu nijak pomoci. Jsem tu samojediná."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC58.rude:9
msgid "We're looking for a priest to take to a new temple."
msgstr "Hledáme kněze, jehož bychom mohli doprovodit do nového chrámu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:10
msgid "Sho'!  Anything else?"
msgstr "'Se ví! 'Eště něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:8
msgid "Sho'!"
msgstr "'Se ví!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:3
msgid ""
"He's in love with that Kira the Cold over in Thronheim.  I heard he's composed love sonnets to her an everthin'!"
msgstr ""
"Je zamilovanej do Kiry Chladný z Thronheimu. Doslech' jsem se, že jí pořád píše nějaký milostný sonety!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:4
msgid "Sho'!  Have a look!"
msgstr "'Se ví! Enem se mrkni!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:5
msgid "Sorry, we're closed for the evening."
msgstr "Lituju, ale večer máme zavříno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:6
msgid "Sho'!  You want ta do some shoppin'?"
msgstr "'Se ví! Nechtěl bys teď trochu vobchodovat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC59.rude:7
msgid "Nuthin'.  What is it?"
msgstr "Nic. Co je to?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:1
msgid "We're ready for the challenge."
msgstr "Jsme připraveni zhostit se tohoto úkolu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:1
msgid ""
"You may think so.  I'm not so sure.  Go see Abbot Leffery Caid in Lindisfarne.  He will instruct you on how to summon the dragon."
msgstr ""
"To si jen myslíš. Já si tím nejsem tak jistý. Ale vyhledej Abbota Leffery Caida v Lindisfarnu. On ti dá instrukce, jak vyvolat draka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:10
msgid "Sounds too dangerous for us."
msgstr "To se nám zdá poněkud nebezpečné."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:10
msgid ""
"They say cowards are long lived.  Perhaps one day you will be brave enough to take the challenge."
msgstr ""
"Říká se, že zbabělci žijí dlouho. Ale jednoho dne snad sebereš dostatek odvahy, abys tuto výzvu přijal."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:12
msgid ""
"Much thanks.  I can tell that you haven't yet been tested by the Training Hall.  It changes a person, you know.  Come back and buy me another drink when you've learned that for yourselves."
msgstr ""
"Díky. Jak vidím, ještě jste nebyli ve Cvičišti. Víte, to úplně změní váš život. Až to zvládnete, vraťte se a kupte mi další pivo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:13
msgid "Sorry old man.  Maybe you should get a job."
msgstr "Promiň, starče, ale snad by sis měl radši najít nějakou práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:13
msgid ""
"Watch your mouth!  I may be old, but I could still show you a thing or two!"
msgstr ""
"Dej si pozor na ústa! Možná jsem starý, ale ještě pořád ti můžu pár triků ukázat!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:2
msgid ""
"There is a place I have been to.  It is a secretive place that only the bravest and best warriors dare go.  It is here the best warriors are made.  If you can pass the tests given there, you may be worthy of killing the dragon."
msgstr ""
"Je tu jedno místo, kde jsem byl. Jen ti nejstatečnější a nejlepší dobrodruzi se tam odváží vstoupit. Odtud pochází nejlepší bojovníci. Pokud uspějete v testu, který vám zde bude zadán, budete ti praví, kteří mohou zabít draka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:2
msgid "What is this task?"
msgstr "Co je to za úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:3
msgid ""
"Well perhaps you might do a task for me.  If you complete that task, I shall tell you how to slay the dragon."
msgstr ""
"No, snad bys pro mě mohl splnit ten úkol. Pokud ho splníš, řeknu ti, jak zabít draka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:3
msgid "Who us?  Of course!"
msgstr "Kdo? My? Samozřejmě!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:5
msgid "If it is there, we will find it."
msgstr "Pokud to tam je, najdu to."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:5
msgid ""
"You certainly have the bravery.  If you are worthy, perhaps I shall see you again."
msgstr ""
"Jste opravdu stateční. Pokud toho budete hodni, možná se opět uvidíme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:6
msgid ""
"Ahhh, that I cannot say.  It is a place you must find yourself.  I can tell you this however: It is called the Training Hall, and can be found somewhere in region of Thjorgard."
msgstr ""
"Á, tak to vám nesmím říci. To místo musíte najít sami. Povím vám však toto: říká se mu Cvičiště a nalézá se kdesi v oblasti Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:3
msgid "Where is it?"
msgstr "Kde to je?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:7
msgid "I bet you're interested in slaying dragons, ain't ya?"
msgstr "Vsadil bych se, že se zajímáš o zabíjení draků, že jo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:7
msgid "Weave your tale, old man."
msgstr "Řekni mi svůj příběh, starý muži."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:8
msgid ""
"Much thanks.  If you care to listen, I have a tale that warriors such as yourselves might find interesting."
msgstr ""
"Díky moc. Chcete-li poslouchat, povím vám příběh, jenž by mohl zajímat právě válečníky, jako jste vy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:12 assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:9
msgctxt "said by the party"
msgid "Of course."
msgstr "Samozřejmě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC6.rude:9
msgid ""
"Much thanks.  I can see by your faces that you succeeded in surviving the Training Hall.  Well done.  But the dragon is an even greater task."
msgstr ""
"Mnohokrát děkuji. Když vidím vaše obličeje, předpokládám, že jste uspěli ve Cvičišti. Výborně. Ale zabít draka je mnohem těžší úkol."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:1
msgid "A fine place for trade, if your boat can make it that far."
msgstr ""
"Místo jako stvořené pro obchod, pokud vaše loď dokáže doplout tak daleko."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:4
msgid "And what sort of information would you be looking for?"
msgstr "A po jakých informacích prahneš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:5
msgid ""
"If you're looking to get away from the islands that make up Hanndl's Grasp, go to Guberland.   You can travel to anywhere from there."
msgstr ""
"Jestliže se chcete nějak dostat z těchto ostrovů, tvořících Hanndlovo objetí, vydejte se do Guberlandu. Odtamtud pak můžete vyrazit kamkoliv."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:5
msgid "Is there anywhere else we can go?"
msgstr "Můžeme jít ještě někam jinam?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:6
msgid ""
"I won't be putting to sea for a while yet, should you change your mind."
msgstr "Zatím se ještě nevydám na moře, takže si to můžete rozmyslet."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC60.rude:7
msgid "Sure you're not looking for passage?"
msgstr "Skutečně nehledáš cestu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:1
msgid ""
"I hear there are some hanging around the outskirts of Sturmford.  One should not be difficult to find."
msgstr ""
"Doslechl jsem se, že jeden se potuluje kdesi na kraji Sturmfordu. Nebude těžké jej najít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:1
msgid "Where can we find the Basilisk?"
msgstr "Kde najdu toho baziliška?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:10
msgid "It is within the city walls of Thjorgard."
msgstr "Leží za městskými zdmi Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:10
msgid "Where is the Arena?"
msgstr "Kde se nalézá ta aréna?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:11
msgid "Is there anything else I can do for you?"
msgstr "Mohu pro vás ještě něco udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:12
msgid ""
"Bjarni lives in the longhouse in the middle of the northern section of town."
msgstr "Bjarni přebývá v tom dlouhém domě uprostřed severní části města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:13
msgid "You can find the bank west of Bjarni's Longhouse."
msgstr "Na banku natrefíš západně od Bjarniho dlouhého domu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:15
msgid ""
"The first labor is to find a basilisk and kill it.  Once you have done that, bring its skin back to me."
msgstr ""
"Prvním úkolem je najít baziliška a zabít ho. Až to vykonáte, přineste mi jako důkaz jeho kůži."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:15
msgid "What is the first labor?"
msgstr "Jak zní ten první úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:17
msgid ""
"Very well.  There are three Gladiatorial Labors.  Before you can be promoted, you must complete all three."
msgstr ""
"Dobrá. Pro gladiátory tu máme celkem tři různé úkoly. Ještě než budete povýšeni, musíte je splnit všechny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:17
msgid "Yes, we have members who would like to be Gladiators."
msgstr "Ano. Mezi námi jsou tací, kteří se touží stát gladiátory."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:2
msgid ""
"So you have.  Congratulations.  You are hereby promoted to Gladiators."
msgstr "Tak se vám to povedlo. Blahopřeji. Nyní jste povýšeni na gladiátory."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:2
msgid "We've completed all the labors."
msgstr "Splnili jsme všechny úkoly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:24
msgid ""
"You can find the armor shop in the southern section of town next to a small park."
msgstr "Zbrojířův krámek se nachází v jižní části města, hned vedle parčíku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:26
msgid "Alright.  Is there something else you need?"
msgstr "Dobrá. Potřebujete ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:26
msgid "No, we don't have anyone who wants to be promoted to Gladiator."
msgstr "Ne, v našich řadách není nikdo, kdo by se chtěl stát gladiátorem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:27
msgid "I'm afraid not.  Sorry."
msgstr "Obávám se, že ne. Je mi líto."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:29
msgid ""
"The second labor is not a traditional labor, but as it's my duty to assign them, I shall choose the labors.  For some time, Bjarni has fancied Kira, the Jarla of Thronheim.  I'm sure if he had something dear to her she would welcome his love."
msgstr ""
"Ten druhý úkol je sice netradiční, ale je mojí povinností ti ho zadat. Už nějakou dobu Bjarniho přitahuje Kira, jarla Thronheimu. Jsem si jistý, že kdyby měl něco, co jí je drahé, že by mohla přijmout jeho lásku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:29
msgid "What is the second labor?"
msgstr "Co je ten druhý úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:30
msgid ""
"Good luck on your continued quests.  Anything else I can help you with?"
msgstr ""
"Hodně štěstí při dalších dobrodružstvích. Mohu ti ještě s něčím pomoci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:31
msgid "The tavern is the first building east of the northern entrance."
msgstr "Hospoda je první stavení východně od severního vchodu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:33
msgid "The temple is in the southern section of town, past the East Gate."
msgstr "Chrám se tyčí v jižní části města, za Východní bránou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:35
msgid ""
"In fact, we have.  Some of the shopkeepers have complained that someone has been stealing from them.  Not very much, but enough to perhaps feed a small family.  I would be grateful if you would look into it."
msgstr ""
"Popravdě řečeno, máme. Někteří obchodníci si stěžují, že jim někdo krade jejich zboží. Ne příliš mnoho, ale dost, aby to nasytilo jednu malou rodinu. Byl bych ti vděčný, kdybys na to trochu dohlédl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:36
msgid "What is the third labor?"
msgstr "Co mne čeká jako třetí úkol?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:36
msgid "You must go to the Arena in Thjorgard, fight at Lord level, and win."
msgstr "Vyprav se do arény v Thjorgardu, bojuj na obtížnost lorda a vyhraj."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:37
msgid ""
"You can find the magic shop in the southern section of town next to a small park."
msgstr "Magický obchod najdete v jižní části města, hned vedle parčíku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:40
msgid ""
"Come back when they are completed and you shall call yourselves Gladiators."
msgstr "Vraťte se, až vše splníte, a budete se moci zvát gladiátory."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:40
msgid "We shall do all of these things."
msgstr "Všechno vykonám."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:41
msgid "Should you wish to become a Gladiator.  I can help you with that."
msgstr "Chcete-li se stát gladiátory, mohu vám s tím pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:41
msgid "We have heard that you can promote Mercenaries."
msgstr "Doslechli jsme se, že můžeš povýšit žoldáky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:44
msgid "The training hall is in the most southwesterly section of town."
msgstr "Tréninkovou halu nalezneš na samém jihozápadě města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:50
msgid "The general store is west of here, north of the library."
msgstr "Obchod se smíšeným zbožím stojí západně odsud, na sever od knihovny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:52
msgid "The library is between the bank and the general store."
msgstr "Knihovna stojí mezi bankou a smíšeným zbožím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:59
msgid ""
"I want you to go to her palace in Thronheim, and steal her shield, then bring it back to me."
msgstr ""
"Chci, aby ses vloudil do jejího paláce v Thronheimu, ukradl její štít a přinesl ho zpátky ke mně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:60
msgid "Ah yes, so you do.  Congratulations on the completion of one labor."
msgstr "Ano, tak jste to zvládli. Blahopřeji k dokončení práce."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:60
msgid "We have the Basilisk Skin"
msgstr "Získali jsme kůži z baziliška."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:61
msgid ""
"Thank you!  This will win her over for sure!  Congratulations on the completion of one labor."
msgstr "Děkuji ti! Tím si ji dozajista získá! Blahopřeji ti k završení úkolu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:61
msgid "We have Kira's Shield"
msgstr "Máme Kiřin štít."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:62
msgid "We have won in the Arena."
msgstr "Zvítězili jsme v aréně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:62
msgid ""
"You have proven your strength, adventurers.  Congratulations on the completion of one labor."
msgstr ""
"Prokázali jste svou sílu, dobrodruzi. Blahopřeji vám k vykonání úkolu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:7
msgid ""
"You can find the weapon shop in the northern section of town next to a small park."
msgstr "Obchod se zbraněmi leží v severní části města, hned vedle parčíku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC61.rude:9
msgid ""
"Johannes Bem right in Thjorgard can help you.  You can find him in the Bembridge University."
msgstr ""
"V tom ti může být nápomocen Bern, žijící přímo v Thjorgardu. Nalezneš ho na Bembridgské univerzitě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC63.rude:1
msgid "Nothing exciting has happened to me in thirty years!"
msgstr "Za posledních třicet let se mi nic zvláštního nepřihodilo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC63.rude:3
msgid ""
"If you bake their bones in cow dung, you can make a potent anti-venom!  Why, I remember this time my sword brother took ill after a fight with a snake!  I nursed him back to health with that concoction!"
msgstr ""
"Pokud jejich kosti zapečeš s chlévskou mrvou, získáš mocný protijed! Nu, teď si vzpomínám, jak jednou jeden můj bojovný bratr ochořel po souboji s hadem! Přivedl jsem ho k životu právě skrze tuto směs!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC63.rude:3
msgid "What do you know about fighting skeletons?"
msgstr "Co je ti známo o bojujících kostlivcích?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC63.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC63.rude:5
msgid "Farewell, young warriors!"
msgstr "Sbohem, mladý válečníku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC64.rude:2
msgid ""
"He died, of course!  At least, I thought he was dead!  I even put chips of Elemental Thjorad over his eyes.  But he came back!  Thank the heavens!"
msgstr ""
"Umřel, samozřejmě! Aspoň já jsem si myslela, že skonal! Dokonce jsem na místo jeho očí vložila plátky thjoradské rudy. Ale on se vrátil! Díky nebesům!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC64.rude:2
msgid "How did he get there?"
msgstr "Jak se tam dostal?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC64.rude:3
msgid "My husband, of course!  He went to Arslegard, and then came back!"
msgstr "Můj manžel, samozřejmě! Vydal se do Arslegardu a pak se navrátil!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC64.rude:3
msgid "Who did?"
msgstr "Kdože?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC64.rude:4
msgid ""
"That poor Feargus A'Feslo!  He spent a long time in the Drangheim Prison!"
msgstr ""
"Ten ubohý Feargus A'Feslo! Strávil hezkou dobu v drangheimské věznici!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC65.rude:1
msgid ""
"Dalla!  How could someone go to Arslegard and then come back?  No one can come back from the dead!"
msgstr ""
"Dalla! Jak se někdo může dostat do Arslegardu a potom se vrátit? Nikdo se nedostane z říše smrti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC65.rude:1
msgid "Who's fibbing?"
msgstr "Kdože lže?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:1
msgid ""
"Stay away from the Ruined Temple.  That place is dangerous!  My cousin's uncle went in there and never came back out!"
msgstr ""
"Od zříceniny chrámu se radši drž dál. Je to tam nebezpečné! Strýc mé sestřenice tam jednou vešel a už se víckrát nedostal ven!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:3
msgid ""
"A leader from the Dia clan sought the wanderers out.  She traveled this new wasteland, and brought us to this place.  If it weren't for Ekan'dia, the half-orcs would have become extinct."
msgstr ""
"Až jedna vůdkyně z kmene Dia všechny poutníky spojila. Prošla s námi všemi nově vzniklými pustinami a dovedla nás až sem. Nebýt Ekan'die, poloskřeti by už dávno vyhynuli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:3
msgid "How did you survive?"
msgstr "Jak jste přežili?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:4
msgid ""
"After the Great Cataclysm, all our homelands and culture were destroyed.  We wandered for years.  Many starved.  We were ill equipped to survive in this new and harsh world that was created."
msgstr ""
"Po Velké pohromě byla celá naše vlast i kultura zničena. Po celá léta jsme se jen tak potulovali a mnozí z nás hladověli. Byli jsme špatně vybaveni pro přežití v tomto novém a krutém světě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:4
msgctxt "said by the party"
msgid "Sure."
msgstr "Jasně."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:7
msgid "Would you like to hear about the history of the Half-orcs?"
msgstr "Chtěl by sis vyslechnout něco o historii poloskřetů?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC66.rude:9
msgid "If it weren't for Ekan'dia, we would never have survived."
msgstr "Nebýt Ekan'die, žádný z nás by nepřežil."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC67.rude:1
msgid "I heard that Feargus A'Feslo spent some time in Drangheim Prison."
msgstr ""
"Doneslo se mi, že Feargus A'Feslo strávil nějaký čas v drangheimské věznici."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:1
msgid ""
"Very soon I'll be going off to Lindisfarne to study!  I'm very excited!  Maybe one day I'll be invited to give a speech on Elvish history!"
msgstr ""
"Již brzo odejdu do Lindisfarnu studovat! Mám z toho velkou radost! Snad jednoho dne dostanu pozvání, abych promluvila i na elfském území!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:3
msgid ""
"My father said we were once a single nation 500 years ago!  I didn't believe him, but he studied at the University in Mendossus."
msgstr ""
"Můj táta říkal, že někdy před 500 lety jsme bývali jediným národem! Nevěřila jsem mu, ale on studoval na Mendosské univerzitě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:3
msgid "What do you know about Rysh?"
msgstr "Co bys mi mohla říci o Ryshu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:6
msgid "Not a problem.  Goodbye."
msgstr "Nic se neděje. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:5
msgid ""
"It's this place in Mendossus that is a focal point of magical energy.  All of the great scholars go there to study!"
msgstr ""
"Právě toto místo v Mendossusu je zdejším ohniskem magické energie. Chodí tam studovat všichni velcí učenci!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC68.rude:5
msgid "What is the University?"
msgstr "Co je to za univerzitu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC69.rude:1
msgid ""
"Mommy gave a whole piece of gold for my birthday last year!  Can you believe that?  A whole gold piece!!"
msgstr ""
"Mamka mi k minulým narozeninám dala celý zlaťák! Věřil bys tomu? Celý zlaťák!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC69.rude:3
msgid ""
"Daddy says they are mean people!  He said if I ever saw one I should run away, because they might eat me!"
msgstr ""
"Tatínek říká, že jsou to podlí lidé! Řekl, že kdybych někdy nějakého potkal, měl bych utíkat pryč, protože by mě mohli sníst!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC69.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:8
msgid "Bye bye!"
msgstr "Pa-pa!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:1
msgid "How much are you offering?"
msgstr "Kolik nabízíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:1
msgid "Well how much do you want?"
msgstr "Tak kolik tedy chceš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:10
msgid "Forget it then.  See you later"
msgstr "Tak na to zapomeň. Uvidíme se později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:10
msgid "Good riddance."
msgstr "Spánembohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:11
msgid "Is the machine fixed yet?"
msgstr "Už je ten stroj opraven?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:11
msgid ""
"Settle down!  I haven't even looked at it yet!  But you'll have to come with me when I do!!"
msgstr ""
"Klídek! Ještě jsem se na to ani nepodíval! Ale až to udělám, musíte jít se mnou!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:12
msgid "Hm..er..ahh..I guess..not.  That just isn't worth my time."
msgstr "Hmm... no... teda... myslím, že ne. To mi za to pořád nestojí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:12
msgid "We'll pay you 500 gold."
msgstr "Investuju do tebe 500 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:13
msgid "We have the money."
msgstr "Máme peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:14
msgid "Mmmmm..uh..alright.  I guess I could do it for that"
msgstr "Mmmmm... ehm... no tak dobrá. Počítám, že to pro vás můžu udělat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:14
msgid "We'll pay you 1,000 gold"
msgstr "Postoupím ti 1000 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:15
msgid "Did you fix the machine?"
msgstr "Už jsi opravil ten přístroj?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:15
msgid ""
"What?  Fix it?  Of course not!  Fixing it's your job.  That mark I made is where it is broken.  Don't dally now!  Get to work!"
msgstr ""
"Cože? Opravil? Samozřejmě že ne! Oprava je vaše práce. Já jsem akorát zjistil, kde je závada. A teď se neulejvejte a pusťte se hezky do práce!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:16
msgid ""
"Did you hear the good news?  They offered me my job back!  Isn't that great!  I owe it all to you.  Thanks!"
msgstr ""
"Už jste slyšeli tu dobrou zprávu? Zase mi nabídli práci! Není to skvělý? A za všecko vděčím vám! Díkes!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:17
msgid "We'll pay you 2,000 gold"
msgstr "Vynaložím na to 2000 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:17
msgid "YAAA-Heee!  Saddle 'em up!  I'll take a look at that machine for ya."
msgstr "Juchééééj! Sedlejte koně! Tak se teda na ten starej klump podívám!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:18
msgid ""
"I got the last replacement from Gunnar Thjorsmith, the Armor Merchant.  I don't know if he's still in business, though."
msgstr ""
"Naposled jsem náhradní získal od Gunnara Thjorsmithe, obchodníka se zbrojí. Nicméně vůbec nevím, jestli ještě stále obchoduje."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:18
msgid "Where can we find a new Slag Extractor?"
msgstr "Kde bychom našli nový oddělovač hlušiny?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:19
msgid "Nothing.  Sorry to bother you"
msgstr "Nic. Odpusť, že jsem vyrušoval."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:2
msgid ""
"Heh heh.  First they fire me for being too old, and now that something has broken, they have to come running to me to fix it.  Is there money involved?"
msgstr ""
"Hehe. Tak nejdřív mi vpálí, že jsem moc starý, a teď, když se něco pokazí, chtějí po mně, abych to spravil. Koukají z toho aspoň nějaké peníze?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:2
msgid "They say you're the only one who could fix it."
msgstr "Ty jsi prý ten jediný, kdo to dokáže spravit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:3
msgid "Hah!  Fat chance.  Maybe you should find some other sucker."
msgstr "Checht! To je teda pálka! Měli byste si najít jinýho naivku!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:3
msgid "We'll pay you 50 gold"
msgstr "Zaplatím ti 50 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:4
msgid "One of the machines in the Refinery is broken."
msgstr "Jeden ze strojů v rafinérii je rozbitý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:4
msgid "What should I care about that?"
msgstr "A co je mi po tom?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:6
msgid "OK.  Thanks."
msgstr "OK. Díky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:8
msgid "Alright!  Let's go."
msgstr "Prima! Pojďme!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:8
msgid "I know the way.  See you there."
msgstr "Znám cestu. Uvidíme se tam."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:9
msgid "I could almost be bothered to get out of my bed for that."
msgstr "Za to bych se ani nezvednul z postele."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC7.rude:9
msgid "We'll pay you 100 gold"
msgstr "Dám ti 100 zlaťáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC72.rude:1
msgid ""
"I caught a snake yesterday, but it bit my finger, and I had to let it go."
msgstr ""
"Včera jsem chytil hada, ale kousl mě do prstu, a tak jsem ho nechal jít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC72.rude:3
msgid "I hate school!"
msgstr "Nenávidím školu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC72.rude:3
msgid "What do you know about teachers?"
msgstr "Máš nějakou povědomost o učitelích?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:2
msgid "I hope he does better than Pappa did!"
msgstr "Doufám, že si povede líp než táta."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:2
msgid "Itlor has found a job.  He'll care for you."
msgstr "Itlor si našel práci. Bude se o tebe starat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:3
msgid "I want Pappa!"
msgstr "Já chci tátu!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:3
msgid "We Haven't seen your pappa."
msgstr "Tvého taťku jsme neviděli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:4
msgid "Who's going to take care of us now?"
msgstr "Kdo se o nás teď postará?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:4
msgid "Your pappa is in jail for stealing."
msgstr "Tvůj tatínek sedí ve vězení za krádež."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:5
msgid "Pappa always took care of us!"
msgstr "Taťka se o nás vždycky staral!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC73.rude:5
msgid "We'll find a way for you to care for yourselves."
msgstr "Najdu způsob, jak byste se o sebe mohli postarat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:2
msgid "He's got to do his time."
msgstr "Musí tam nějakou dobu zůstat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:2
msgid "I hope it doesn't take long!"
msgstr "Doufám, že to nebude trvat dlouho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:3
msgid "Hurry!  I don't want to starve!"
msgstr "Pospěš si! Nechci trpět hladem!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:3
msgid "We'll find a way for you to be taken care of."
msgstr "Najdu způsob, jak se o tebe postarat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:4
msgid "If you do, tell him his children are looking for him."
msgstr "Jestli ho uvidíte, povězte mu, že ho hledají jeho děti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:4
msgid "We Haven't seen him either."
msgstr "Taky jsme ho neviděli."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:5
msgid "He will?  What of Pappa?"
msgstr "Opravdu? A co táta?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:5 assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:4
msgid "Itlor will be taking care of you."
msgstr "Itlor se o tebe postará."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:6
msgid "What?!  What are we going to do now?"
msgstr "Co?! A co teď máme dělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC74.rude:6
msgid "Your pappa has gone to jail.  He got caught stealing."
msgstr "Tvůj táta šel do vězení. Přistihli ho při krádeži."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:2
msgid "I don't want to starve!!"
msgstr "Nechci mít hlad!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:2
msgid "We'll think of something."
msgstr "Něco vymyslím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:3
msgid "If we see him, we'll tell him to come home."
msgstr "Až ho uvidím, vyřídím mu, že se má vrátit domů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:4
msgid "Of course he will!  He's my big brother!"
msgstr "Samozřejmě že jo! Je to můj velkej bráška!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:5
msgid "Pappa's in jail.  He got caught stealing."
msgstr "Táta sedí ve vězení. Chytili ho při krádeži."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC75.rude:5
msgid "What'll we do?!  I don't want to starve!!"
msgstr "Co budeme dělat? Nechci hladovět!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:1
msgid ""
"She said whatever it was that I was fighting would kill me.  She said I would go to Hallenhalt."
msgstr ""
"Povídala, že ať už bojuji s čímkoliv, zabije mě to. Prý se mám vydat do Hallenhaltu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:1
msgid "What else did she say?"
msgstr "Co ještě řekla?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:10
msgid "I've heard that there is a basilisk that lives near Anskram Keep."
msgstr "Doneslo se ke mně, že se v okolí Anskramské tvrze potuluje bazilišek."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:2
msgid "Sure"
msgstr "Jistěže."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:3
msgid ""
"My real name is Halfdan Gjalpssen.  When we were on the raid, the monks tried to lock us out.  While Thakkrad tried to hack down the door, I put my shoulder into it.  It shattered into pieces."
msgstr ""
"Mé skutečné jméno je Halfdan Gjalpssen. Během našeho nájezdu se nás mniši pokusili zamknout. Zatímco se Thakkrad pokoušel vyrazit dveře, já jsem do nich šťouchl ramenem. Rozletěly se na kousíčky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:3
msgid "Seems like an odd place to gain a name."
msgstr "To vypadá jako dost podivné místo pro získávání jména."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:4
msgid "I got it on my first raid to Lindisfarne."
msgstr "Získal jsem je při svém prvním nájezdu na Lindisfarn."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:4
msgid "Where'd you get the name Doorsbane?"
msgstr "Kde sis vysloužil jméno Vratoborec?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:7
msgid ""
"I heard Lindisfarne has a great artifact called Thjorad.  I couldn't find it, though."
msgstr ""
"Doslechl jsem se, že Lindisfarn má v držení mocný artefakt zvaný Thjorad. Ale nepodařilo se mi jej najít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:7
msgid "What do you know about Artifacts?"
msgstr "Nevíš něco o artefaktech?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:8
msgid "See ya later."
msgstr "Tak zatím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC76.rude:9
msgid ""
"She spoke to me when we spent the night on the Isle of Ashes.  She said that a time would soon come when I would fight bravely."
msgstr ""
"Mluvila se mnou, když jsme trávili noc na Ostrově popela. Pravila, že brzy nadejde čas, kdy budu moci statečně bojovat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:5
msgid "If you have the skill."
msgstr "Jestli je ovládáš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:3
msgid ""
"My uncle died and went to Hallenhalt.  He came to me in a dream.  He said to be careful!  There are foul monsters there.  I thought Hallenhalt was supposed to be a beautiful place!"
msgstr ""
"Můj strýc zemřel a dostal se do Hallenhaltu. Přišel ke mně ve snu a pravil, že mám být opatrná, protože je tam spousta oblud! Já jsem se domnívala, že Hallenhalt má být překrásné místo!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC77.rude:4
msgid ""
"Find Hrrapp Spearhands in Thjorgard.  He can help you achieve your goals."
msgstr ""
"Najdi Hrrapa Kopirukého z Thjorgardu. Pomůže ti dosáhnout vytčených cílů."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:5
msgid "If you have the skills, I can teach you."
msgstr "Pokud ji dostatečně ovládáte, pak vás mohu vyučit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:3
msgid ""
"There are foul things in Anskram Keep.  If I were going to go in there, I'd bring some healing potions for sure!"
msgstr ""
"V Anskramské tvrzi je spousta hnusných věcí. Kdybych se tam vypravil, určitě bych si s sebou vzal nějaké léčivé lektvary!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:10 assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:9
#: assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:8
msgid "See you later."
msgstr "Uvidíme se později."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:7
msgid ""
"He bashes good!  He's a good fighter.  If I were looking to hire someone to do some fighting for me, I think he would be near the top of the list."
msgstr ""
"Je to dobrý bijec! A dobrý bojovník. Kdybych si chtěl najmout někoho, kdo by pro mě bojoval, myslím, že by byl mezi prvními na seznamu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC78.rude:7
msgid "What do you know about Tesar Olin?"
msgstr "Co víš o Tesarovi Olinovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:2 assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:4
msgid "If I must help you."
msgstr "Když to musí být."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:3
msgid "Where can we become Grandmasters in Dodge?"
msgstr "Kde bychom se mohli vytrénovat na velmistry v uhýbání?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC79.rude:6
msgid "No!  Leave me alone.  Well, alright."
msgstr "Ne! Chci být sama ... nebo jo, no tak dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:10
msgid "I noticed.  I hope that you're alright."
msgstr "To jsem si všim'. Doufám, že jste v pořádku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:10
msgid "We've found your cave in."
msgstr "Nalezli jsme tu tvou zavalenou jeskyni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:11
msgid "A fine idea!  I doubt that he'll do anything about it."
msgstr "Dobrej nápad! Pochybuju ale, že v tom něco udělá."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:11
msgid "Sounds dangerous.  Maybe we should report this to Sven Svenssen"
msgstr "To zní nebezpečně. Snad bychom to měli oznámit Svenu Svenssenovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:12
msgid "He wants to know why you're not working."
msgstr "Chce vědět, proč nepracuješ."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:12
msgid ""
"If he wants the Elemental Thjorad so bad, you tell him to go in there and get it himself!"
msgstr ""
"Když tak strašně touží po thjoradské rudě, ať se sem vypraví a získá ji sám!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:13
msgid "Here, let me show you."
msgstr "Tady, ukážu ti to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:13
msgid "Where is the cave again?"
msgstr "Ještě jednou - kde je ta jeskyně?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:14
msgid "Is this it?"
msgstr "To je ono?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:14
msgid ""
"Yes.  You can see that big crack in the floor for yourself.  I'm not going any further."
msgstr ""
"Ano. Ten velkej zlom v podlaze uvidíte sami. Já už tam víckrát nepůjdu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:15
msgid "Careful on your way out!"
msgstr "Buď opatrný, až půjdeš ven!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:15
msgid "Sorry.  Nevermind"
msgstr "Promiň. To nevadí."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:2
msgid "OK."
msgstr "Dobře."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:3
msgid ""
"It's against my better judgment, but I better show you where it is.  Follow me."
msgstr ""
"Je to sice proti mému nejlepšímu vědomí a svědomí, ale ukážu ti, kde to je. Pojď se mnou."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:4
msgid "Good!  Thanks for helping us like that.  Now we can get back to work!"
msgstr ""
"Dobře! Díky, že jste mi tak pomohli. Teď se můžu zase vrhnout do práce!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:4
msgid "We are."
msgstr "Jsme."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:6
msgid "Maybe we should go have a look."
msgstr "Možná bychom na to mohli dohlédnout."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:6
msgid "You're fools!  You'll only walk out to your death."
msgstr "Jste blázni! Akorát si půjdete pro smrt!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:7
msgid ""
"We've been diggin' too much.  If we dig anymore, there's likely to be a cave-in.  We've lost too many miners as it is.  They don't wanna to go in, and I ain't gonna force them!"
msgstr ""
"Už jsme kopali moc hluboko. 'Esli půjdem' 'eště dál, všecko se tu zřítí. Už takhle jsme přišli o pěknou spoustu horníků. Nikdo nechce jít dovnitř, a já nemíním nikoho nutit!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:8
msgid "It's dangerous in there!"
msgstr "Je to tam nebezpečné!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:8
msgid "Why do you say that?"
msgstr "Proč to říkáš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:9
msgid "Inspect the mines?  You're braver than I am."
msgstr "Prozkoumali doly? Tak to jste statečnější než já."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC8.rude:9
msgid "Sven Svenssen sent us to inspect the mines."
msgstr "Sven Svenssen nás poslal, abychom prozkoumali doly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:2
msgid "Thanks!  Can we ask you something else?"
msgstr "Díky! Smím se tě zeptat ještě na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:3
msgid ""
"I've heard that mummies are afraid of fire.  If I were going to fight some of those, I'd definitely use fire against them."
msgstr ""
"Doneslo se mi, že mumie mají strach z ohně. Kdybych se s nějakými měla střetnout, určitě bych proti nim použila oheň."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:4
msgid "Where can we become Grandmaster in Blade?"
msgstr "Kde bychom se mohli stát velmistry v dovednosti meče?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:5
msgid "We'd like to become Master  in Blade."
msgstr "Mým cílem je dosáhnout mistrovství v dovednosti meče."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:6
msgid "Sure.  Goodbye."
msgstr "Jasně. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC80.rude:7
msgid ""
"I've heard of this sword called Excala Banna.  It is supposed to be very lucky.  Man do I wish I had one of those!"
msgstr ""
"Slyšela jsem o meči zvaném Excala Banna. Prý přináší neskutečné štěstí. Páni, tak bych si přála něco takového mít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:1
msgid "Lucky for you."
msgstr "To jsi měl štěstí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:1
msgid "Yeah!  Because of that, I escaped!"
msgstr "Jo! Díky tomu jsem taky utekl!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:3
msgid ""
"If you have any small children, I'd stay away from Frosgard.  I heard there's a frost giant who eats them there!"
msgstr ""
"Jestli máte malé děti, pak bych se být vámi držel dál od Frosgardu. Prý tam přebývá mrazivý obr, který je požírá!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:6
msgid ""
"Sturmford is the place if you want to learn weapon or armor skills!  There's plenty of teachers around here!"
msgstr ""
"Sturmford je tím pravým místem, kde se můžete vycvičit v ovládání zbraní a zbroje. Je tu v okolí spousta různých instruktorů!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:6
msgid "What do you know about Teachers?"
msgstr "Co nám můžeš prozradit o učitelích?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:8
msgid ""
"I served some time in the Drangheim Prison when I was younger.  One time when I was particularly rowdy, they threw me down into the basement block with all the nagate.  Little did they know in one of the old cells, there is a tunnel to the outside!"
msgstr ""
"Zamlada jsem nějaký čas strávil v drangheimské věznici. Jednou, když jsem se choval zvlášť hrubě, uvrhli mě za trest do podzemních prostor. Ale o těch celách toho tedy moc nevěděli - byl tam tunel, který vedl na svobodu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC81.rude:8
msgid "What do you know about prisons?"
msgstr "Víš něco o věznici?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC82.rude:2
msgid ""
"Ludwig Van is my favorite writer!  I think it's tragic that he lost his manuscript.  If only someone would go find it for him!"
msgstr ""
"Ludwig Van je můj oblíbený spisovatel! Myslím, že to, že ztratil svůj rukopis, je hotová tragédie. Kdyby jej tak někdo dokázal najít!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC82.rude:5
msgid ""
"Those Honkies have a temple in Guberland.  I wish they would just go there and stay there!  They're always coming over to my house and bothering me!"
msgstr ""
"Tihle kejhovité mají v Guberlandu vlastní chrám. Bylo by fajn, kdyby se tam zavřeli a už tam zůstali! Pořád mi obcházejí kolem domu a ruší mě!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:1
msgid "I suppose it's alright."
msgstr "No, zkusit to můžete."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:2
msgid "My sister just had a baby!  Isn't that great!"
msgstr "Mé sestře se právě narodilo dítě! Není to ohromné?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:4
msgid ""
"Look for Katrina Vianni, she lives around here, and is the best sword teacher around!"
msgstr ""
"Poohlédni se po Katrině Vianni, která žije někde tady. Je to ta nejlepší instruktorka meče široko daleko!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:4
msgid "What do you know about Sword Mastery?"
msgstr "Tušíš něco o mistrovství meče?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC83.rude:7
msgid ""
"I was talking to Feargus A'Feslo a while back about the Drangheim Prison.  Did you know he escaped from there?"
msgstr ""
"Před chvilkou jsme s Feargusem A'Feslem hovořili o drangheimské věznici. Víte, že odtamtud uprchl?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:5
msgid "I can help you with that, if you are skilled enough."
msgstr ""
"Můžu vám s tím pomoci, pokud jste v této dovednosti dostatečně zběhlí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:3
msgid ""
"I'm planning to move to Thjorgard and become a Thjoradric Smith!  Then I can get rich!"
msgstr ""
"Mám v úmyslu přestěhovat se do Thjorgardu a stát se thjoradským kovářem. Pak zbohatnu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:7
msgid ""
"Not very much, but it can't be that hard, can it?  You just bang on a piece of Elemental Thjorad with a hammer!  Easy!"
msgstr ""
"Moc ne, ale nemůže to být tak hrozné, ne? Prostě jenom kladivem boucháš do kousků té rudy! Jak prosté!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:7
msgid "What do you know about making weapons?"
msgstr "Máš povědomost o výrobě zbraní?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC84.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:8 assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:6
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:4
msgid "Can we ask you a few questions?"
msgstr "Smím ti položit pár otázek?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:1
msgid "Can we ask you something else."
msgstr "Můžeme se otázat ještě na něco jiného?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:1
msgid "You can ask."
msgstr "Jen se ptej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:10
msgid "Nuthin'."
msgstr "Nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:11
msgid "Yeah."
msgstr "Jo."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:12
msgid "We're not interested in hiring you."
msgstr "Nemáme o tebe zájem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:13
msgid "Come back when you can afford me."
msgstr "Přijďte, až mne budete schopni zaplatit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:13
msgid "Sorry.  That's too much"
msgstr "Promiň. To je příliš mnoho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:14
msgid ""
"That figures!  Never know good talent when they see one.  See you around."
msgstr ""
"To jsem si moh' myslet! Nikdy nepoznaj' nadanýho člověka, ani když ho maj' před nosem. Uvidíme se někde tady!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:15
msgid "That's right you weren't!"
msgstr "Tak to opravdu ne!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:15
msgid "We weren't looking anywhere."
msgstr "Nikde jsme nehledali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:2
msgid ""
"Ha!  I been sitting here for weeks trying to find a job.  You'd think I'd get an earful of news, but I ain't got nothing!"
msgstr ""
"Ha! Už týdny tu vysedávám a hledám práci. Myslíš si, že se ze mě stala pokladnice drbů? Nevím nic!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:3
msgid "Congratulations!  You're hired!"
msgstr "Blahopřeji ti! Jsi přijat!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:3
msgid "Great!  Let me get my things."
msgstr "Výborně! Jen si seberu svejch pět švestek!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:4
msgid ""
"What does it look like I'm doing?  I'm an out of work gladiator!  We gladiators need to pay the bills too, you know!"
msgstr ""
"Co si myslíš, že dělám? Jsem nezaměstnanej gladiátor! My gladiátoři musíme platit spoustu účtů, to je ti, doufám, jasný!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:5
msgid "Great!  I charge 700 gold per month plus 10% of the gold we find."
msgstr ""
"Skvělý! Čítám si 700 zlaťáků měsíčně plus 10% ze všeho nalezenýho zlata."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:5
msgid "We might be interested in hiring you."
msgstr "Snad bychom tě mohli najmout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:7
msgid "I'm an out of work gladiator.  Maybe you got a job for me?"
msgstr "Jsem nezaměstnanej gladiátor. Neměl bys pro mě třeba nějakou práci?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:7
msgid "What's it to you?"
msgstr "Kdopak jsi?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:8
msgid "You can ask.  Doesn't mean I'll answer."
msgstr "Ptát se můžete, ale to neznamená, že vám odpovím."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC85.rude:9
msgid "Sorry to hear it.  Thanks for the talk."
msgstr "To nerad slyším. Dík za rozmluvu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:10
msgid ""
"My brother went to Mendossus to look for Old Ursana, the empire's capital.  It is supposedly filled with riches!  He never came back for me, though.  He said he would!"
msgstr ""
"Můj bratr se vypravil do Mendossusu, aby vyhledal starou Ursanu, bývalé hlavní město říše. Určitě ukrývá spoustu pokladů! Nikdy se však ke mně nevrátil. A to slíbil, že přijde!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:12
msgid "Very well.  I understand."
msgstr "Dobrá. Chápu to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:2
msgid "Consider us benefactors.  Welcome aboard."
msgstr "Přijmi ode mně tedy tento dar. Vítej v mé družině!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:2
msgid "Your generosity will be repaid tenfold."
msgstr "Vaše štědrost se vám desateronásobně vyplatí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:3
msgid "Are you saying you would like to come with us?"
msgstr "Říkáš, že by ses k nám rád připojil?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:3
msgid ""
"If you would but donate 1000 gold per month to my temple, I would be happy to aid you in your quest."
msgstr ""
"Budu ti rád při tvém putování nápomocen, ale nejprve bys měl darovat 1000 zlaťáků mému chrámu"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:4
msgid ""
"A noble quest if I should live another day to hear one.  That quest is worthy of a champion of good like myself."
msgstr ""
"To je ušlechtilý úkol, který bych si nechal líbit. Je hoden někoho, kdo je ochráncem dobra - jako já."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:4
msgid "We must unite the clans against Tamur Leng and his Hordes."
msgstr "Musíme spojit všechny kmeny proti Tamuru Lengovi a jeho tlupám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:6
msgid "I am sorry.  I do not put much trust in rumors."
msgstr "Odpusť, ale klepům příliš nedůvěřuji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:7
msgid "That we are."
msgstr "To tedy ano."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:7
msgid "What is your mission?"
msgstr "Jaké je vaše poslání?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:8
msgid ""
"Should you find yourself in a position to accept my help, then by all means, return."
msgstr "Až se budete cítit, abyste přijali mou pomoc, pak se klidně vraťte."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC86.rude:8
msgid "That's a little steep for a donation."
msgstr "To je na dobrovolný dar trošku přehnané."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:1
msgid ""
"Oh no!  This is too much!  I mean it only figures, of course, all the problems land on my head.  What if they come here?  What if they army is too strong for us?  What can I do?  Drangheim will be destroyed!"
msgstr ""
"Ale ne! To už je příliš! Co když sem přitáhnou? Co když je jejich armáda pro nás příliš silná? Co mohu dělat? Drangheim bude zničen."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:1
msgid "The Beldonian Hordes are marching to Chedian."
msgstr "Tlupy z Beldonie mašírují na Chedian."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:10
msgid ""
"When you find the source, try to make them stop.  If you cannot, tell me.  I will find a way to silence their foul mouth.  Good luck!"
msgstr ""
"Až zjistíte původce, pokuste se je zastavit. Jestli se vám to nepovede, sdělte mi to. Najdu způsob, jak umlčet ty jejich špinavé klapačky! Hodně štěstí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:11
msgid "That is a problem."
msgstr "To je problém."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:11
msgid ""
"Why don't you do that for me?  Yes!  I think you should.  Go find Greudach A'Dorad.  She should be somewhere around town.  Ask her where she got the rumor from, and keep asking until you find the source!"
msgstr ""
"Proč to pro mě neuděláte? Ano! Myslím, že byste mohli. Vyhledejte Greudach A'Dorad. Měla by být někde poblíž města. Zjistěte, odkud ty své informace získává, a vyptávejte se jí tak dlouho, dokud vám neprozradí svůj zdroj!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:12
msgid ""
"Well, Greudach A'Dorad has often been telling me troubling news as of late.  I think she's quite taken with gossip.  I'd like to know who is at the root of these rumors."
msgstr ""
"No, Greudach A'Dorad mi poslední dobou často sdělovala znepokojivé zvěsti. Domnívám se, že je těmi klepy úplně unesena. Jen bych rád věděl, kdo za všemi těmi pomluvami stojí."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:12
msgid "What rumors?"
msgstr "Jaké drby?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:13
msgid "I'm worried about the rumors."
msgstr "Drby mě už unavují."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:14
msgid "We have come seeking your aid."
msgstr "Přišli jsme hledat pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:14
msgid "What is it that you want?"
msgstr "Copak potřebujete?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:15
msgid "I will let them know!  See you at the council!"
msgstr "Dám jim vědět! Uvidíme se na shromáždění?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:15
msgid "Tell them we are meeting in Thronheim in two weeks."
msgstr "Vyřiď jim, že se sejdeme za dva týdny v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:16
msgid ""
"There is a fort called Anskram Keep along our border located in Sturmford.  It is rightfully ours.  Go to this fort, and disable all of its defenses.  Take this key.  One of our agents returned with it."
msgstr ""
"Existuje pevnost jménem Anskramská tvrz, která se nachází u hranic se Sturmfordem. Podle práva patří nám. Jdi do pevnosti a vyřaď celou její obranu. Vem si tento klíč. Vrátil se s ním jeden z našich špehů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:16
msgid "What do you need done?"
msgstr "Co potřebuješ udělat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:18
msgctxt "said by the party"
msgid "Certainly."
msgstr "Jistě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:18
msgid ""
"What a beautiful artifact!  No one will dispute my claim to the Jarlship now!  Here's a little something for your troubles."
msgstr ""
"Jaký to překrásný artefakt! Nikdo teď už nebude diskutovat o mém právu být jarlem! A tady máte něco za tu námahu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:2
msgid "No, thank you!  Was there anything else you wanted today?"
msgstr "Ne, já děkuji. Chtěli jste dnes ještě něco?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:21
msgid ""
"Thronheim?!  That Bjarni doesn't trust me enough to sign it first?!  Very well, I will go to Thronheim and sign this treaty."
msgstr ""
"V Thronheimu?! To mi Bjarni tak nedůvěřuje, že se nehodlá podepsat jako první? Tak dobrá, odcestuji do Thronheimu a tu úmluvu podepíšu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:21
msgid "You and Bjarni will both sign it in Thronheim."
msgstr "Spolu s Bjarnim ji podepíšete v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:22
msgid "Bjarni said he needed his general.  We gave it to him."
msgstr "Bjarni prohlásil, že potřebuje generála. Tak jsme mu ho přivedli."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:22
msgid ""
"You did it!  It doesn't matter anyway.  Sturmford wouldn't stop now anyway."
msgstr "Takže vy! No, to stejně nevadí. Sturmford se teď už nezastaví."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:23
msgid "Great!  I shall be ready.  Farewell."
msgstr "Prima! Budu připraven. Sbohem!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:23
msgid "We have much to do, yet.  We'll let you know."
msgstr "Máme ještě spoustu věcí na práci. Dáme ti vědět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:24
msgid "A person named Marsaili A'Lanth in Sturmford."
msgstr "Osoba jménem Marsaili A'Lanth ze Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:24
msgid ""
"In Sturmford?  Must be one of Bjarni's spies.  Very well.  I shall take care of it.  Thank you.  Here is something for your hard work."
msgstr ""
"Z Sturmfordu? To musí být nějaký Bjarniho špeh. Dobrá, postarám se o to. Díky vám a tady máte něco za svou námahu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:26 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:44
msgid "That is great!  I shall dispatch messengers to the Jarls immediately."
msgstr "To je báječné! Okamžitě rozešlu posly k ostatním jarlům."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:26
msgid "The clans are united.  Now is the time for the war council."
msgstr "Kmeny jsou spojeny. Nastal čas k válečné poradě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:27
msgid "We've already retrieved that."
msgstr "Tuhle věc už jsme získali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:27 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:39
msgid "You have?  Let me see it!"
msgstr "Vskutku? Ukaž!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:28
msgid "Sorry.  We're much to busy to root out rumors."
msgstr ""
"Promiň. Máme na práci jiné věci než zjišťovat, od koho pocházejí klepy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:29
msgid "We can't do this for you right now."
msgstr "V této chvíli to pro tebe nemohu vykonat."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:3
msgid ""
"A treaty?!  Yes, I suppose that would work.  Find someone to write us a treaty, and bring it to me.  I will sign it."
msgstr ""
"Smlouvy?! Ano, počítám, že to by mohlo fungovat. Najděte někoho, kdo pro vás sepíše úmluvu, a přineste ji ke mně. Já ji podepíšu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:3
msgid "What if we got him to sign a treaty?"
msgstr "A co když ho přiměji k podepsání smlouvy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:30
msgid "No, thanks to you!  The rumors have quieted down.  I am in you debt."
msgstr "Ne, díky vám! Všechny klepy utichly. Jsem vám nesmírně zavázán."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:31 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:40
msgid "Now that we've done both tasks for you, will you join us?"
msgstr "A teď, když už jsme splnili oba tvé úkoly, se k nám připojíš?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:31 assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:40
msgid ""
"Of course I will!  I assume that you will be working out all the details?"
msgstr "Samozřejmě! Počítám, že už sis promyslel všechny podrobnosti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:32
msgid ""
"There is some question about my legitimacy to serve as Jarl of Drangheim.  There is an item, called the Crona Kiga that will erase any questions of that.  I would like you to visit Chasm of the Dead and retrieve it."
msgstr ""
"O mém postu drangheimského jarla se občas pochybuje. Avšak existuje jedna věc, zvaná Crona Kiga, která všechny tyto pochybnosti smete. Rád bych, abys navštívil Rokli smrti a získal ji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:32
msgid "What else do you need done?"
msgstr "Co ještě je nutno učinit?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:33
msgid ""
"You have?  That's great news!  Oh, are those Sturmfordians going to pay now!!  Here's a little something for you, too."
msgstr ""
"Opravdu? To je skvělá zpráva! Tak, teď Sturmforďané za všechno zaplatí! A tady máte nějakou maličkost."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:34
msgid ""
"He's the guy in charge of Sturmford!  Those Sturmfordians must have rocks in their brains for picking him!"
msgstr ""
"To je ten chlápek, co vládne Sturmfordu! Ti Sturmforďané musí mít v hlavě místo mozku kamení, že si ho zvolili!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:35
msgid "We haven't finished them yet."
msgstr "Ještě jsme je nesplnili."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:35
msgid "Well hurry up!"
msgstr "No tak si pospěš!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:37
msgid "About those things you needed done.."
msgstr "O tom, co je třeba vykonat..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:38
msgid ""
"That's great news!  Oh, are those Sturmfordians going to pay now!!  Here's a little something for you, too."
msgstr ""
"To je výborná zpráva! Teď vám Sturmforďané za všechno zaplatí! A tady je něco pro vás..."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:38
msgid "We've disabled Anskram Keep's defenses."
msgstr "Zničili jsme obranu Anskramské tvrze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:39
msgid "We've got the Crona Kiga."
msgstr "Získali jsme artefakt zvaný Crona Kiga."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:4
msgid "Sturmford didn't do it.  We did."
msgstr "To není dílem Sturmfordu, ale mým."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:4
msgid "YOU!??  Why on earth would you do such a thing?"
msgstr "Vy?!! Proč byste pro všechno na světě něco takového dělali?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:43
msgid "Is that so?  Who has been spreading these foul lies?"
msgstr "Opravdu? A kdo ty hnusné lži vypouští?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:43
msgid "We've found out who's been spreading the gossip."
msgstr "Vypátrali jsme, kdo šíří ty klepy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:45
msgid "Why have you gone to war with Sturmford?!"
msgstr "Proč jsi zahájil válku proti Sturmfordu?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:45
msgid ""
"Why?  I'll tell you why!  Because some filthy agents from Sturmford broke into my prison and stole away with Ivsar Forktooth, that's why!!  They are no good, and don't deserve to be on this continent, let along the same island as we!"
msgstr ""
"Proč? Řeknu ti proč! Protože nějací podlí bastardi ze Sturmfordu se vloupali do mé věznice a osvobodili Ivsara Pizizubého, proto!! Už mám těch zbabělců plné zuby!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:46
msgid ""
"Kira wrote it?  She is a fair and just ruler, I will trust her words.  Very well, as soon as Bjarni signs it, so will I."
msgstr ""
"Kira že to napsala? Je to spravedlivá a čestná vládkyně a jejím slovům věřím. Nuže, až to podepíše Bjarni, učiním tak i já."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:46
msgid "We have a peace treaty written by Kira the Cold."
msgstr "Máme mírovou smlouvu, již sepsala Kira Chladná."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:47
msgid "Perservere.  Your ignorance has not failed us yet."
msgstr "Vytrvejte. Vaše nevědomost nás ještě nezklamala."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:47
msgid "We are sorry, Sigmund.  Our ignorance killed you."
msgstr "Je nám líto, Sigmunde, ale naše nevědomost tě zabila."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:48
msgid "Greudach A'Dorad talked."
msgstr "Greudach A'Dorad promluvila."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:48
msgid "She did, did she?  Well go find the person responsible!"
msgstr "Doopravdy? Tak najdi toho, kdo je za všechno zodpovědný!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:5
msgid ""
"Great!  Chasm of the Dead is located just outside Drangheim.  I must give you this warning.  Chasm of the Dead is heavily trapped and EXTREMELY dangerous.  Stick close to the walls if you value your lives.  Good luck."
msgstr ""
"Výborně! Rokle smrti leží hned za Drangheimem. Musím vás však varovat: uvnitř je velká spousta pastí a nástrah a venkoncem je to MIMOŘÁDNĚ nebezpečné místo. Držte se při zdi, je-li vám život milý. Mnoho štěstí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:6
msgid "Great!  Good luck."
msgstr "Báječné! Mnoho štěstí!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:7
msgid ""
"Great!  One less thing I have to worry about.  When is the war council?"
msgstr "Skvělé! Teď už mě trápí jen jediná věc - kdy se koná válečná porada?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:8
msgid "Join us!  We are trying to unite the Clans against them."
msgstr "Přidej se ke mně! Snažím se proti nim spojit všechny kmeny!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:8
msgid ""
"Join you?  Hmmm.  I've got my hands full with Sturmford these days.  Perhaps if you would help me with that, I would be able to help you."
msgstr ""
"Přidat se k vám? Hmmm. Teď mám zrovna plné ruce práce se Sturmfordem. Možná že kdybyste mi trochu pomohli, mohl bych potom pomoci i já vám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:9
msgid ""
"Very well.  Once Bjarni has signed it, I will withdraw my troops.  Farewell."
msgstr "Dobře. Až ji podepíše i Bjarni, odvolám své jednotky. Sbohem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC87.rude:9
msgid "We will get you a treaty."
msgstr "Přinesu ti smlouvu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:11
msgid "So you have.  Congratulations.  You are hereby promoted to Assassins."
msgstr "Tak jste to zvládli. Blahopřeji. Nyní jste povýšeni na vrahy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:12
msgid "We shall see your worth."
msgstr "Uvidíme, jak si povedeš."

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:2
msgid "sdef"
msgstr "sdef"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:4
msgid ""
"A certain noble, who we will call Mr. Kluso, would like to test his security devices.  An assassin should be able to get past any security device the mind can think of.  Find his house, and steal whatever it is he holds valuable enough to guard."
msgstr ""
"Jistý šlechtic, říkejme mu třeba pan Kluso, by si rád otestoval zabezpečení svého obydlí. Správný vrah by však měl dokázat obejít jakékoliv zařízení tohoto druhu, ať je to, co je to. Proto najdi jeho dům a ukradni všechno, co tam stojí za hlídání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:5
msgid ""
"I will be the judge of that.  The Assassin's Trial consists of two tasks."
msgstr "Posoudím to. Vrahova zkouška sestává ze dvou úkolů."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:6
msgid ""
"Is that so?  Is there among you those mercenaries who would be worthy to become assassins?"
msgstr "Vážně? Máte v družině žoldáky, kteří jsou hodni stát se vrahy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:8
msgid "We have come seeking promotions."
msgstr "Hledáme povýšení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:8
msgid ""
"Another skill of the Assassin is murder.  There are many who would pay great price for the death of another.  Someone has already paid me for the life of Guaire A'Velsi.  If you are worthy, find this man, and in broad daylight, kill him."
msgstr ""
"Další nutnou dovedností vraha je zabíjení. Spousta lidí je ochotna za smrt někoho jiného poskytnout velmi tučnou odměnu. Právě jsem dostal zaplaceno za život Guaire A'Velsi. Máte-li dost odvahy, vyhledejte tohoto muže a za bílého dne ho zabijte."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:8
msgid "What is the Second Task?"
msgstr "Jak zní druhá úloha?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC88.rude:9
msgid "Then come back when there are."
msgstr "Pak se vraťte, až budete připraveni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:10
msgid "Come back if you do."
msgstr "Tak se vrať, až tomu tak bude."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:10
msgid "We do not have anyone who would like to become a Crusader."
msgstr "Nemáme v družině nikoho, kdo by se toužil stát křižákem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:11
msgid "I am not here to entertain you."
msgstr "Nejsem tu pro legraci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:12
msgid "About that promotion quest."
msgstr "O povyšovacím úkolu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:13
msgid ""
"The villagers have been praising your names to me already.  Congratulations.  I hearby promote you to Crusaders!"
msgstr ""
"Vesničané už na vás pěli chválu. Blahopřeji. Tímto vás jmenuji křižáky!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:13
msgid "We have completed the task."
msgstr "Ten úkol jsme splnili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:3
msgid ""
"Don't forget.  Crusaders carry themselves with honor.  Be honorable and do the order proud."
msgstr ""
"Nezapomeňte. Křižáci vždycky vystupují čestně. Buďte hodni úcty, ať jsou na vás všichni pyšní."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:4 assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:6
msgid ""
"As you may have heard from the villagers, just outside of Drangheim there is a gang known as the Yobboe Gang.  They have been extorting money from the villagers nearby.  Go to the Yobboe camp, defeat the bandits, and return the villagers' things to them."
msgstr ""
"Jak ses možná doslechl od vesničanů, jen kousek od Drangheimu sídlí gang zvaný Velcí chuligáni. Místní vesničany už připravili o spoustu peněz. Vyprav se do jejich tábora, všechny bandity znič a pak vesničanům navrať ztracené věci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:4
msgid "What was the task again?"
msgstr "Ještě jednou, co mám vykonat?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:5
msgid "We will accept this task."
msgstr "Přijímám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:6
msgid "What is the task?"
msgstr "Co má být mým úkolem?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:7
msgid "I will give you the task then."
msgstr "Pak mám pro vás úkol."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:7
msgid "Yes.  Some of us would like to become Crusaders."
msgstr "Ano. Někteří z družiny by se rádi stali křižáky."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:8
msgid "There are those among you who would wish to become Crusaders?"
msgstr "Najdou se ve vaší družině tací, kteří touží stát se křižáky?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC89.rude:9
msgid "We're not ready to accept this quest."
msgstr "Ještě nejsem připraven ujmout se něčeho takového."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:1 assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:8
msgid ""
"It's in the hallway behind me.  Take the first corridor to your right and follow it until it ends."
msgstr ""
"Je to v chodbě přede mnou. Jdi první chodbou po tvojí pravé straně a následuj ji až na konec."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:1
msgid "Where is this section?"
msgstr "Kde je to místo?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:4
msgid "Good.  Once this rock is cleared, we can get back to work."
msgstr "Dobrá. Až bude ten kámen pryč, můžu se znovu pustit do práce."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:4
msgid "We'll give it a try."
msgstr "Zkusím to."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:5
msgid "I don't think he'll accept that answer."
msgstr "Nemyslím si, že tu odpověď přijme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:5
msgid ""
"Maybe you can try to break through.  My geologist tells me there's a cave with normal rock beyond this stuff."
msgstr ""
"Možná bys ses mohl pokusit probít skrz. Náš geolog říká, že pod námi je jeskyně z normálního kamene."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:6
msgid "Sven Forkbeard sent us to find out why you are not working."
msgstr "Sven Vidlobrad nás vyslal, abychom vyzvěděli, proč nepracujete."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:6
msgid ""
"We started a new vein a while back, and we've reached a section of rock that's too strong for our picks."
msgstr ""
"O kousek dál jsme objevili novou žílu a narazili na kámen, který je pro naše krumpáče příliš tvrdý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:7
msgid ""
"The section that was too strong for our picks?  That's great!  Thank you!"
msgstr ""
"Tu část, která byla příliš tvrdá pro naše krumpáče? To je skvělé! Děkuji ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:7
msgid "We cleared out your rock."
msgstr "Odstranili jsme ten kámen."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:8
msgid "Where was that rock again?"
msgstr "Kde je ten kámen?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:9
msgid "Uh, no.  Sorry."
msgstr "Ne. Promiň."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC9.rude:9
msgid ""
"We always need good miners.  I'll be here if you ever change your mind."
msgstr ""
"No, o dobré horníky j vždycky nouze. Počkám tady, dokud si to nerozmyslíš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:2
msgid "All right!  See you there!"
msgstr "Dobrá. Uvidíme se tam!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:3
msgid "We're supposed to take you to see Bjarni."
msgstr "Máme tě přivést k Bjarnimu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:3
msgid ""
"What, you think I want to go gallivanting around with you?  Not likely.  Besides, I need a drink!  When you're ready to see Bjarni, you can find me in the tavern in Sturmford."
msgstr ""
"To si myslíte, že se tu míním ukazovat ve vaší společnosti? Tak to tedy ne. A krom toho se potřebuju něčeho napít! Až budete připraveni setkat se s Bjarnim, najdete mě v hospodě ve Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:4
msgid "Let's go."
msgstr "Pojďme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:4
msgid "Woooweee!!  Freedom!!"
msgstr "Sláááva!! Svoboda!!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:5
msgid ""
"Bjarni sent you?  To get me?  What are we waiting for?  I may be an old man now, but I can move just as good as when I was twenty!  And don't worry if you lose me.  I know my way around.  If we get separated I'll meet you outside."
msgstr ""
"Poslal vás Bjarni? Abyste mě přivedli? Tak na co čekáme? Jsem už starý, ale dokážu se pohybovat stejně rychle, jako když mi bylo dvacet! A nemějte strach, kdybych se vám náhodou ztratil - dobře se tu vyznám. Kdybychom se rozdělili, potkáme se venku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:5
msgid "We've been sent by Bjarni Thorvaldssen to rescue you."
msgstr "Poslal nás Bjarni Thorvaldssen, abychom tě zachránili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:6
msgid "We've come to take you back to Sturmford."
msgstr "Přišli jsme tě odvést zpátky do Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:6
msgid "What?  Who are you?"
msgstr "Co? Kdo jste?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:7
msgid "I know the way from here!"
msgstr "Znám odsud cestu!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:7
msgid "What is it, General?"
msgstr "Co je, generále?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:8
msgid "Come on, General."
msgstr "Pojď, generále."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:8
msgid "Sure thing!  Ready to go!"
msgstr "Jasná páka! Pojď!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:9
msgid "Sorry to bother you, old man."
msgstr "Promiň, že jsem tě vyrušoval, starče."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC90.rude:9
msgid "Wait!  Come back!  Keep an old man some company."
msgstr "Počkej! Vrať se! Potěš přece starce svou společností!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:2
msgid ""
"I wish someone would show those Yobboes the what for!  They certainly deserve it!"
msgstr ""
"Přál bych si, aby někdo konečně ukázal těm banditům, zač je toho loket! Opravdu si to zaslouží!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:3
msgid "Mercy be on you!"
msgstr "Buď požehnán!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:3
msgid "We'll get your plow back for you."
msgstr "Získám pro tebe ten pluh a vrátím ti jej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:5
msgid ""
"Those darned Yobboes took it!  As payment for protection against Sturmford they say.  I think they just like watching us suffer!"
msgstr ""
"Ti zpropadení chuligáni mi ho sebrali! Prý jako platbu za ochranu proti Sturmfordu. Myslím ale, že se radši dívají, jak trpíme."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:5
msgid "What happened to your plow?"
msgstr "Co se stalo s tvým pluhem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:6
msgid "Yeah, I guess."
msgstr "Počítám, že jo."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:7
msgid ""
"Thank you!  I was afraid I wasn't going to be able to get the plowing done for the planting!"
msgstr "Děkuji! Bál jsem se, že už s ním nikdy nebudu moci orat svá pole!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:7
msgid "We have your plow."
msgstr "Máme tvůj pluh."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:8
msgid ""
"Isn't that some sort of illness?  I think my brother Dean came down with that a few weeks ago.  I'd stay away from him if I were you!  It's very contagious!"
msgstr ""
"Není to nějaká choroba? Myslím, že můj bratr Dean sem s tím přišel před pár týdny. Být vámi, držím se od něho dál! Je to velmi nakažlivé!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC91.rude:9
msgid "I've got my plow back, thanks to you!"
msgstr "Tak mám svůj pluh zpátky, a to díky vám!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:1
msgid ""
"I hate those Yobboes!  Who among us has the nerve to stand up to them?"
msgstr "Nesnáším ty bandity! Kdo z nás by měl odvahu se jim postavit?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:2
msgid "We'll find your herbs for you."
msgstr "Najdu ti ty bylinky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:2
msgid "You will?  Thank you!"
msgstr "To bys udělal! Děkuji!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:3
msgid ""
"Those Yobboes took them from me because I refused to heal one of them."
msgstr "Banditi mi je sebrali, protože jsem jednoho z nich odmítla vyléčit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:3
msgid "What happened to your herbs?"
msgstr "Co se stalo s tvými bylinkami?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:5
msgid "We've got your bag of herbs."
msgstr "Tvůj balíček s bylinami máme u sebe."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:5
msgid "You have?  Wonderful!  Thank you so much!"
msgstr "Vskutku? To je báječné! Tolik ti děkuji!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:6
msgid ""
"That's some monastery to the south.  We get a lot of pilgrims stopping here on their way down there."
msgstr ""
"To je jeden klášter na jihu. Spousta poutníků se u nás cestou tam zastaví."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC92.rude:7
msgid "Thank you for bringing my herbs back!"
msgstr "Děkuji vám, že jste mi vrátili mé bylinky!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:1
msgid "I've got my dolly back!  See!  Lori's all happy now!  Thank you!"
msgstr ""
"Tak už mám zase svou panenku! Podívej! Lori je teď taková šťastná! Děkuji ti!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:2
msgid ""
"I can't find it!  Little Lori has been missing since the Yobboes came.  I'm getting real worried about her!"
msgstr ""
"Nemohu ji najít! Lorinka mi chybí od té doby, co sem vtrhli ti zlí lidé. Už o ni začínám mít pěkný strach!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:2
msgid "What happened to your dolly?"
msgstr "Co je s tvou panenkou?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:3
msgid "That's the name of the place I live at!"
msgstr "To je název místa, kde žiju!"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:4
msgid "We've found your dolly."
msgstr "Našli jsme tvou panenku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:4
msgid "You found my dolly?  Thank you!  Oh Lori, are you alright?"
msgstr "Vy jste našli mou panenku? Děkuji vám! Ó, Lorinko, jsi v pořádku?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC93.rude:5
msgid ""
"I'm not supposed to talk to anyone I don't know.  Especially since the Yobboes came."
msgstr ""
"Nesmím mluvit s nikým, koho neznám. Zvlášť od té doby, co sem přišli chuligáni."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC94.rude:1
msgid "No one of consequence."
msgstr "Nikdo důležitý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC95.rude:1
msgid "Of course not."
msgstr "Samozřejmě že ne."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:11
msgid "We'd like to talk to you about your \"news\"."
msgstr "Rádi bychom si s tebou promluvili o těch tvých \"novinkách\"."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:11
msgid "What about my news?"
msgstr "Co je s mými novinkami?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:2
msgid "Marsaili A'Lanth in Sturmford.  She's been telling me all the news."
msgstr "Všechny tyto zprávy mám od Marsaili A'Lanth ze Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:2
msgid "We promise."
msgstr "Slibuji."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:3
msgid "Don't tell anyone I told you!"
msgstr "Nikomu neříkej, že jsem ti to pověděla!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:4
msgid "People.  Everyone's been talking about it."
msgstr "Od lidí. Každý o tom mluví."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:4
msgid "We want to know who you have been hearing it from."
msgstr "Potřebujeme vědět, od koho přesně jsi to slyšela."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:5
msgid ""
"They say he's a coward!  I heard he found a snake under his bed and cried like a baby!  Some ruler."
msgstr ""
"Povídá se, že je to zbabělec! Jednou prý našel pod postelí hada a křičel přitom jako malé dítě! A to si říká vládce!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:5
msgid "What about Sigmund?"
msgstr "Povíš mi něco o Sigmundovi?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:6
msgid ""
"Oh, but I have so much!  There's the story about Sigmund, and what I've heard about Sturmford will make your head spin!"
msgstr ""
"Ó, mám jich tolik! Je tu příběh o Sigmundovi a z toho, co jsem se dozvěděla o Sturmfordu, ti bude běhat mráz po zádech!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:6 assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:8
msgid "What news?"
msgstr "Jaké zprávy?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:7
msgid ""
"Me?  Certainly you don't think I..?  No, I guess you do.  Alright, but you've got to promise not to tell who told you."
msgstr ""
"Ode mne? Opravdu si myslíte, že já...? Ne, počítám, že ne. Tak dobrá, ale musíte mi slíbit, že nikomu neprozradíte, kdo vám to řekl."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:7
msgid "Not everyone.  The people we spoke to said you were the source."
msgstr ""
"Každý ne. Lidé, s nimiž jsme hovořili, nám sdělili, že všechny tyto zvěsti mají od tebe."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:8
msgid "Oh, it's you.  Never mind."
msgstr "Aha, to jste vy. To nic."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:9
msgid ""
"I heard they are going to invade soon.  Their army is ten times bigger than ours.  We'll stand no chance.  We might as well surrender now."
msgstr ""
"Doslechla jsem se, že se sem brzy chystají vtrhnout. Jejich armáda je desetkrát větší než naše. Nemáme žádnou šanci. Měli bychom se radši vzdát."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC96.rude:9
msgid "What about Sturmford?"
msgstr "A co je se Sturmfordem?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:2
msgid ""
"I heard Sigmund is worried about Sturmford.  They've been very quiet lately.  That's unusual for them."
msgstr ""
"Zaslechl jsem, že Sigmund se obává Sturmfordu. Poslední dobou byli podezřele zticha. To je pro ně nezvyklé."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:4
msgid "Yes.  We would like to see what you have."
msgstr "Ano. Rádi bychom se podívali, co nám můžeš nabídnout."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:4
msgid "Sorry, but we're closed."
msgstr "Promiň, ale máme zavřeno."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:5
msgid ""
"They're bred from dirty string and goat cheese.  You think I'm kidding?  Why don't you go smell one of them!"
msgstr ""
"Vyrůstají na nečistých šlachách a kozím sýru. Myslíš, že žertuji? Tak proč si k někomu z nich nečichneš?"

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:7
msgid "Come back when you want to spend some money."
msgstr "Tak se vraťte, až budete chtít utratit nějaké peníze."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC97.rude:8
msgid "Would you like to buy a weapon?"
msgstr "Nechtěl by sis pořídit nějakou zbraň?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:2
msgid ""
"I've heard that dog spit mixed with frog brains makes an excellent anti-undead potion."
msgstr ""
"Slyšela jsem, že psí sliny smíchané se žabími mozky tvoří výborný lektvar proti nemrtvým."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:4
msgid "Yes.  Show us what you have."
msgstr "Ano. Ukaž nám, copak tu máš."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:5
msgid ""
"Sometimes some traders come here with merchandise from there.  The stuff is expensive, but it's pretty good quality.  They make a kind of armor that you don't see around here."
msgstr ""
"Kupci sem občas jezdívají za obchodem. Jejich zboží je drahé, ale velice kvalitní. Vyrábějí zbroje, jaké nejsou nikde jinde k vidění."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC98.rude:6
msgid "Would you like some armor?"
msgstr "Budete chtít nějakou zbroj?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:2
msgid ""
"I've heard of this game they play in Frosgard.  They wear knives on their feet, and chase a biscuit around on a frozen lake!  It sounds like great fun to me.  I want to visit Frosgard and play this game."
msgstr ""
"Dozvěděla jsem se o hře, která se hraje ve Frosgardu. Nosí na nohou nože a po zamrzlém jezeře prohánějí nějaké pečivo! To mi připadá jako velká zábava. Chci se do Frosgardu podívat a tuhle hru si zahrát."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:4
msgid "We would like to look at your spells."
msgstr "Rádi bychom si prohlédli tvá kouzla."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:5
msgid "Who is that?  His name sounds familiar, but I can't quite place it."
msgstr "Kdo je to? Jméno mi zní povědomě, ale nedokážu je zařadit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:6
msgid ""
"If you need some advice, go visit Tymon the Nord in Thjorgard.  He always helps me out."
msgstr ""
"Jestli potřebujete nějakou radu, navštivte Tymona Seveřana z Thjorgardu. Vždycky mi pomůže."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC99.rude:6
msgid "What do you know about Adventuring?"
msgstr "Co víš o věcech dobrodružství?"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:1
msgid "Complete your training."
msgstr "Trénink je dokončen."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:1
msgid ""
"The Old Man believes you are finally ready to leave Ravensford.  Read the scroll he's given you to begin your training.  If you don't think you need any training, sell your scroll back to a shopkeeper and head north."
msgstr ""
"Starý muž věří, že jste konečně připraveni  opustit Ravensford. Přečtěte si svitek, který vám dal, abyste mohli začít trénovat. Pokud si myslíte, že již nepotřebujete žádný trénink, prodejte svitek zpět obchodníkovi a jděte na sever."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:10
msgid ""
"The old man put you on the path.  Complete his task to prove your worth."
msgstr "Starý muž ti ukázal cestu. Splň jeho úkol a dokaž mu své schopnosti."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:100
msgid "You've killed Guaire A'Velsi.  Return to Atli the Quick."
msgstr "Zabili jste Guaire A'Velsiho. Vraťte se k Atli Rychlému."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:101
msgid ""
"Stop Jarl Sven Forkbeard of Thjorgard from being assassinated. Show the letter to Jarl Sven in Thjorgard.  Return to Grehgknak the Right in Lindisfarne when you are finished."
msgstr ""
"Zabraňte tomu, aby byl jarl Sven Vidlobrad Thjorgardský zavražděn. Ukažte dopis jarlovi Svenovi v Thjorgardu. Až budete hotovi, vraťte se k Grehgkňákovi Spravedlivému do Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:101 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:102
msgid "Stop Jarl Sven's assassination."
msgstr "Překaž vraždu jarla Svena."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:102
msgid "Go to the Arena and stop Sven's double from being assassinated."
msgstr "Běž do arény a zabraň vraždě Svenova dvojníka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:103
msgid "Find Harris Willington."
msgstr "Najdi Harrise Willingtona."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:103
msgid ""
"Find Harris Willington.  Report back to Jarl Sven of Thjorgard.  When you are finished return to Grehgknak the Right in Lindisfarne."
msgstr ""
"Nalezni Harrise Willingotna a ohlaš to jarlovi Svenovi z Thjorgardu. Potom se vrať ke Grehgkňákovi Spravedlivému z Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:104 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:105
msgid "Arrest the thief."
msgstr "Zatkni zloděje."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:104
msgid ""
"Go to the town hall clerks and find who is having trouble with theives.  When you have found the thief, arrest him, and take him to the town jail."
msgstr ""
"Jděte do městské haly úředníků a najděte někoho, kdo má problémy se zloději. Až najdete zloděje, zatkněte ho a odveďte do městského vězení."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:105
msgid ""
"You've arrested Hatlati Oord for stealing.  Take him to the jail inside the Sturmford Town Hall."
msgstr ""
"Zatkli jste Hatlatiho Oorda za krádež. Odveďte ho do vězení uvnitř městské haly ve Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:106
msgid "Help the Oor'ds help themselves."
msgstr "Pomož Oor'dům, aby se o sebe postarali."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:106
msgid ""
"Speak to Hatlati's family.  Find a way for them to provide for themselves."
msgstr ""
"Promluv si s Hatlatiho rodinou a najdi způsob, jak by se o sebe její členové mohli postarat."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:107
msgid "Find Itlor a job."
msgstr "Najdi Itlorovi zaměstnání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:107
msgid ""
"Itlor wants a job so he can provide for his family.  There must be someone around Sturmford who is willing to give him a job.  Return to Grehgknak the right when you are finished."
msgstr ""
"Itlor potřebuje práci, aby mohl zajistit svou rodinu. Ve Sturmfordu musí být někdo, kdo by mu nějaké zaměstnání poskytl. Až se ti to podaří, navštiv Grehkňáka Spravedlivého z Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:108
msgid "Find Everstrike."
msgstr "Nalezni Přesnostříl."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:108
msgid ""
"Find the bow known as Everstrike.  Return to Fenja Tree-friend when you have it."
msgstr ""
"Nalezni luk známý jako Přesnostříl a zanes jej Fenje Přítelkyni stromů z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:109
msgid ""
"Go to the Dungeon of Secrets in Frosgard.  Pass through the dungeon without setting off a single trap.  Return to Fenja Tree-friend when you are finished."
msgstr ""
"Vstup to Žaláře tajemství ve Frosgardu a projdi jím, aniž bys přitom spustil jedinou past. Potom se vrať k Fenje Přítelkyni stromů z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:109 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:110
msgid "Pass through Dungeon of Secrets."
msgstr "Projdi Žalářem tajemství"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:11
msgid ""
"Snorri the Fist has instructed you to meet Abbot Leffery Caid in Lindisfarne.  He will show you how to summon the dragon."
msgstr ""
"Snorri Pěst ti nařídil setkání s Abbotem Leffery Caidem v Lindisfarnu. On ti ukáže, jak vyvolat draka."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:110
msgid ""
"You've completed the Dungeon of Secrets.  Return to Fenja Tree-friend."
msgstr "Prošli jste Žalář tajemství. Vraťte se k Fenje Příteli stromů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:111
msgid "Find a new priest for the new temple."
msgstr "Vyhledej kněze pro nový chrám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:111
msgid ""
"Find a priest who would be willing to take over the new temple to Igdrasa you are building.  Return to Gray Slemnir when you are finished."
msgstr ""
"Vyhledej nějakého kněze, jenž by se ujal nového Igdrasina chrámu, který právě stavíš. Pak to sděl Grayi Slemnirovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:112
msgid "Find a new Tree of Life."
msgstr "Objev Strom života."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:112
msgid ""
"Find the Ruined Temple in Frosgard and recover the Tree of Life symbol.  Take it to Gray Slemnir in Guberland when you have acquired it."
msgstr ""
"Ve Frosgardu najdi zříceniny chrámu a získej odtud symbol Stromu života, který posléze předej Grayi Slemnirovi z Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:113
msgid ""
"Find Nath'i A'Mor in Frosgard and convince him to teach you the Ritual of Consecration.  Return to Gray Slemnir when you are finished."
msgstr ""
"Ve Frosgardu se poohlédněte po Nath'i A'Mor a požádejte ho, zda by vás nenaučil rituál soustředění. Pak se vraťte ke Grayi Slemnirovi z Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:113
msgid "Learn the Ritual of Consecration."
msgstr "Nauč se rituál soustředění."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:114
msgid ""
"Find the Green Man in Frosgard, and ask him what you can do to help him return to Frosgard."
msgstr ""
"Ve Frosgardu vyhledejte Zeleného mužíčka a zeptejte se ho, co můžete udělat pro to, aby se vrátil do Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:114
msgid "Find the Green Man."
msgstr "Najdi Zeleného mužíčka."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:115 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:116
msgid "Get a promise from Frosgard."
msgstr "Získej slib z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:115
msgid ""
"Get a promise from at least seven residents of Frosgard that they will not neglect the Green Man.  Return to the Green Man when you are finished."
msgstr ""
"Alespoň od šesti obyvatel Frosgardu získej slib, že nebudou zapomínat na Zeleného mužíčka. Neopomeň mu to potom sdělit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:116
msgid ""
"The citizens of Frosgard have promised not to neglect the Green Man.  Return to him when you've finished his other tasks."
msgstr ""
"Občané Frosgardu slíbili nezanedbávat Zeleného mužíčka. Vrať se k Zelenému mužíčkovi, až splníš i jeho ostatní úkoly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:117
msgid ""
"Find someone in Frosgard who will repair the old maypole.  Return to the Green Man when you are finished."
msgstr ""
"Najdi někoho z Frosgardu, kdo bude ochoten opravit starou májku, a pak se vrať k Zelenému mužíčkovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:117 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:118
msgid "Fix the maypole in the center of town."
msgstr "Oprav májku uprostřed města."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:118
msgid ""
"Soxolf will fix the maypole at the center of town.  Return to the Green Man when you've finished his other tasks."
msgstr ""
"Soxolf opraví májku uprostřed města. Vrať se k Zelenému mužíčkovi, až splníš i jeho ostatní úkoly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:119 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:120
msgid "Get Tryygva to erect a runestone."
msgstr "Přiměj Tryygvu, aby vztyčil runový kámen."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:119
msgid ""
"Speak to Jarl Tryygva of Frosgard.  Convince him to commit a promise to celebrate the Green Man to stone and place that stone next to the maypole.  Return to the Green Man when you are finished."
msgstr ""
"Promluv si s jarlem Tryygvou z Frosgardu a přiměj ho, aby slíbil, že na kameni vzdá hold Zelenému mužíčkovi a tento pomník umístí pod májku. Až uspěješ, oznam to Zelenému mužíčkovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:12
msgid ""
"Leffery Caid has the relic.  Perhaps now you will meet the dragon in his cave in Lindisfarne."
msgstr ""
"Leffery Caid má dračí relikvii. Snad se nyní setkáš s drakem v jeho sluji v Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:120
msgid ""
"Tryygva agreed to erect a runestone.  Return to the Green Man when you've finished his other tasks."
msgstr ""
"Tryygva souhlasil se zhotovením památníku. Vrať se k Zelenému mužíčkovi, až splníš i jeho ostatní úkoly."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:121
msgid "Find Verhoffin's Diary."
msgstr "Nalezni Verhoffinův deník."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:121
msgid ""
"Go to the Verhoffin Ruins on the Isle of Ashes and recover Verhoffin's Diary.  Return to Johannes Bem in Thjorgard when you are finished."
msgstr ""
"Vnikněte do Verhoffinových ruin na Ostrově popela a přineste odtamtud Verhoffinův deník. Doručte jej pak Bernovi z Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:122
msgid "Become a Lich."
msgstr "Staň se lichem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:122
msgid "Follow the Lich Instructions and become a lich."
msgstr "Následuj instrukce a proměň se v licha."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:123
msgid "Find the Training Hall in Thjorgard and survive its trials."
msgstr "V Thjorgardu nalezni Cvičiště a přežij všechny jeho nástrahy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:123
msgid "Survive the Training Hall."
msgstr "Přežij Cvičiště"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:124
msgid ""
"Find out who is sabotaging Sturmford's defenses.  Report back to Bjarni Herjolfssen when you have uncovered who it is."
msgstr ""
"Vypátrej, kdo narušuje obranu Sturmfordu. Jméno sabotéra ohlaš Bjarnimu Herjolfssenovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:124
msgid "Find the saboteur."
msgstr "Vypátrej sabotéra."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:125
msgid ""
"Jarl Bjarni has given you a love letter he wrote to Kira the Cold.  Take it to her in Thronheim, and report back to Bjarni when you have her response."
msgstr ""
"Jarl Bjarni ti předal milostný dopis pro Kiru Chladnou. Doruč jí jej do Thronheimu a Bjarnimu pak oznam její odpověď."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:125
msgid "Take love letter to Kira the Cold."
msgstr "Doruč Kiře Chladné milostný dopis."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:126
msgid ""
"Ludwig Van dropped his manuscript down the cellar of his Beet Hoven.  Go down into the sewers below his Beet Hoven and bring his manuscript back for him."
msgstr ""
"Ludwigu Vanovi spadl jeho rukopis kamsi do sklepa v Beet Hoven. Prozkoumejte stoky pod Beet Hovenem a přineste mu jeho spisky zpět."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:126
msgid "Retrieve Ludwig's Manuscript."
msgstr "Získej Ludwigův rukopis."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:127 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:128
msgid "Convince the Dook to leave Guberland."
msgstr "Přiměj Dooka, aby opustil Guberland."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:127
msgid ""
"Go to the Dook's Castle in Guberland and convince the Dook to leave.  Return to Jarl Markel of Guberland when you are finished."
msgstr ""
"Navštiv Dookův hrad v Guberlandu a přiměj ho, aby se vzdálil. Potom se vrať k jarlovi Markelovi z Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:128
msgid ""
"You've convinced the Dook to leave.  Return to Jarl Markel of Guberland."
msgstr ""
"Přesvědčil si Dooka, aby odešel. Vrať se k jarlovi Markelovi Guberlandskému."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:129 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:130 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:131
msgid "Get Nicolai a job."
msgstr "Sežeň Nikolajovi práci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:129
msgid ""
"Nicolai Ironfist of Drangheim is down on his luck.  Try to find him a job.  There's got to be a circus around here somewhere."
msgstr ""
"Nikolaj Ironfist z Drangheimu nemá žádné štěstí. Pokus se pro něj najít práci. Někde poblíž by tu měl být cirkus."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:13
msgid ""
"Bjarni Thorvaldssen, the Jarl of Sturmford has asked you to rid Anskram Keep in Sturmford of the imps that have inhabited it.  Destroy the portals they are coming from.  Return to him when you are finished."
msgstr ""
"Bjarni Thorvaldssen, jarl Sturmfordský, vás požádal vyčištění Anskramské tvrze ve Sturmfordu od impů, kteří se zde usadili. Zničte portály, ze kterých přicházejí. Vraťte se k němu, až budete hotovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:13 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:14
msgid "Clear out Anskram Keep."
msgstr "Vyčisti Anskramskou tvrz."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:130
msgid ""
"Thorir Mouth of Guberland offered Nicolai a job.  Return to Nicolai in Drangheim to tell him."
msgstr ""
"Thorir Huba Guberlandský zařídil Nikolajovi práci. Vrať se k Nikolajovi do Drangheimu a pověz mu o tom."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:131
msgid ""
"Nicolai has accepted the job.  Return to Thorir Mouth in Guberland for your reward."
msgstr ""
"Nikolaj přijal novou práci. Vrať se ke Thorirovi Hubě v Guberlandu pro svou odměnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:132 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:133 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:134
msgid "Find out who is spreading gossip."
msgstr "Zjisti, kdo roznáší pomluvy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:132
msgid ""
"Jarl Sigmund of Drangheim is worried about the gossip spreading throughout his clan.  Find out who's tongue is wagging.  Return to Jarl Sigmund in Drangheim when you have discovered who is responsible."
msgstr ""
"Jarl Sigmund z Drangheimu se obává pomluv, které se šíří po jeho kmeni. Odhal, kdo je šíří, a jméno dotyčné osoby oznam jarlovi Sigmundovi z Drangheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:133
msgid ""
"Greudach A'Dorad has fingered Marsaili A'Lanth in Sturmford.  Go find them and tell them to stop spreading the rumors."
msgstr ""
"Greudach A'Dorad donášela Marsaili A'Lanthe ve Sturmfordu. Vyhledej je a řekni jim, aby přestaly roznášet drby."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:134
msgid ""
"Marsaili A'Lanth refused to stop spreading lies.  Return to Sigmund with the information."
msgstr ""
"Marsaili A'Lanth odmítla přestat roznášet drby. Vrať se k Sigmundovi s touto zprávou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:135
msgid "Sell Brewmaster Smith's new concoction to Guberland."
msgstr "Prodej nově namíchané pivo sládka Smithe do Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:135
msgid ""
"Take the cask Brewmaster Smith gave you to the tavern in Guberland, and try to get the bartender to purchase it from you.  Once you have succeeded, return to Brewmaster Smith"
msgstr ""
"Tento sud vám dal sládek Smith, abyste jej dopravili do guberlandského hostince a pokusili se přimět tamějšího barmana, aby jej od vás koupil. Jestliže uspějete, vraťte se ke sládkovi Smithovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:136
msgid "Get Black Orb of Knowledge."
msgstr "Získej Černý orb vědění"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:136
msgid ""
"Go to the Wizard's Lab in Yorwick, and get the Black Orb of Knowledge from the Mad Wizard Robinsson.  Return to Ealusaid A'Norta a'thrakan in Thronheim when you are finished."
msgstr ""
"Vydej se do Čarodějovy laboratoře v Yorwicku a z šíleného čaroděje Robinssona se pokus vymámit Černý orb vědění. Potom zajdi za Ealusaidem A'Nortou a'thrakanem z Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:137
msgid ""
"Take the Scroll of Bad News to Erlend the Nay-sayer in the Temple of Ratatosk.  Return to Dagfari the Peevish in Thronheim when you are finished."
msgstr ""
"Svitek špatných zpráv doruč Erlendovi Nicneříkajícímu z Ratatoskova chrámu. Splnění tohoto úkolu ohlaš Dagfari Mrzutému z Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:137
msgid "Take the news to the Temple of Ratatosk."
msgstr "Dones zprávy do Ratatoskova chrámu"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:138
msgid "Get the Orbs of Linking."
msgstr "Opatři si Orby přenosu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:138
msgid ""
"Go to the Inventa Storca in Thronheim and collect six Orbs of Linking.  Install them in the six banks in Chedian."
msgstr ""
"Vyprav se do Inventa Storca v Thronheimu a sežeň šest Orbů přenosu, jež poté umísti do šesti bank v Chedianu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:139
msgid ""
"Find Lindisfarne Monastery's missing relic.  Return it to Leffery Caid in the Lindisfarne Monastery when you have retrieved it."
msgstr ""
"Najdi ztracenou relikvii kláštera v Lindisfarnu. Až ji získáš, vrať ji Leffery Caidimu do kláštera v Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:139
msgid "Retrieve the missing relic."
msgstr "Získej ztracenou relikvii."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:14
msgid ""
"You have destroyed the imp portals.  Return to Jarl Bjarni in Sturmford City."
msgstr ""
"Zničili jste portály impů. Vraťte se k jarlovi Bjarnimu do města Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:140
msgid ""
"Go to the Temple of Honk in Guberland and steal their primary icon, the Golden Honk.  Take it to the goddess Fre in the Hall of the Gods when you have taken it."
msgstr ""
"Vetřete se do kejhovitského chrámu v Guberlandu, ukradněte jim hlavní ikonu, zlatou husu. Až ji budete mít u sebe, doneste ji bohyni Fré v Síni bohů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:140
msgid "Steal the Golden Honk."
msgstr "Ukradni zlatou husu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:141 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:142
msgid "Clean out the Bathhouse."
msgstr "Vyčisti lázně."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:141
msgid ""
"Go to the Bathhouse in Arslegard and get rid of Ebora and her concubines.  Return to Jokull the Ugly in Arslegard when you are finished."
msgstr ""
"Jděte do lázní v Arslegardu a zbavte se Ebory a jejích konkubín. Až budete hotovi, vraťte se k Jokullovi Hnusnému v Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:142
msgid ""
"You got rid of Ebora and her concubines.  Return to Jokull the Ugly in Arslegard."
msgstr ""
"Zbavil ses Ebory a jejích konkubín. Vrať se k Jokullovi Hnusnému do Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:143
msgid "Find Gungnir."
msgstr "Nalezni Gungnir."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:143
msgid "Hanndl lost his spear, called Gungnir.  Find it and return it to him."
msgstr "Hanndl ztratil své kopí zvané Gungnir. Najdi je a vrať mu je."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:15
msgid ""
"General Ivsar Forktooth is being held captive in Drangheim Prison.  Go to Drangheim and break him out.  Return to Jarl Bjarni of Sturmford when you are finished."
msgstr ""
"Generál Ivsar Pizizubý je držen v zajetí v drangheimské věznici. Vyprav se do Drangheimu a osvoboď jej. Potom se vrať k jarlovi Bjarnimu ze Sturmfordu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:15 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:16 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:17
msgid "Rescue Ivsar Forktooth."
msgstr "Osvoboď Ivsara Pizizubého."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:16
msgid ""
"You've got the general.  Now get out of the prison and back to Sturmford.  If you get separated, Ivsar said he'd meet you outside."
msgstr ""
"Máte generála. Teď se dostaňte ven z věznice a vraťte se do Sturmfordu. Pokud byste se rozdělili, Ivsar řekl, že se setkáte venku. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:17
msgid ""
"General Ivsar said he knew the way back.  Meet him at the Sturmford City Tavern, and take him to Jarl Bjarni"
msgstr ""
"Generál Ivsar řekl, že zná cestu zpět. Setkej se s ním v hospodě města Sturmfordu a vezmi ho k jarlovi Bjarnimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:18 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:19
msgid "Disable Anskram Keep's defenses."
msgstr "Vyřaď obranu Anskramské tvrze."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:18
msgid ""
"Travel to Anskram Keep in Sturmford and disable it's defenses by opening the portcullis and lowering the drawbridge.  Return to Jarl Sigmund of Drangheim when you are finished."
msgstr ""
"Odcestujte do Anskramské tvrze ve Sturmfordu a vyřaďte obranu otevřením padací mříže a spuštěním padacího mostu. Vraťte se k jarlovi Sigmundovi do Drangheimu, až budete hotovi."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:19
msgid ""
"You've disabled Anskram Keep's defenses.  Return to Jarl Sigmund of Drangheim"
msgstr ""
"Vyřadili jste obranu Anskramské tvrze. Vraťte se k jarlovi Sigmundovi do Drangheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:2
msgid "Search for anyone living on this island."
msgstr "Poohlédni se po tomto ostrově, zda tu nezůstal někdo živý."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:2
msgid ""
"The Isle of Ashes is supposed to be uninhabited, but there may be someone here who would help you."
msgstr ""
"Ostrov popela je prý neobydlený, ale možná tu bude někdo, kdo ti dokáže pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:20
msgid ""
"Go to Chasm of the Dead in Drangheim and retrieve the Crona Kiga.  Deliver it to Jarl Sigmund of Drangheim."
msgstr ""
"Vejdi do Rokle smrti v Drangheimu a získej odtud artefakt zvaný Crona Kiga. Dones jej jarlovi Sigmundovi z Drangheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:20 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:21
msgid "Retrieve the Crona Kiga from the Chasm of the Dead."
msgstr "Z Rokle smrti přines artefakt zvaný Crona Kiga."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:21
msgid "You've got the Crona Kiga.  Deliver it to Jarl Sigmund of Drangheim."
msgstr ""
"Získali jste artefakt zvaný Crona Kiga. Dovezte ho jarlovi Sigmundu Drangheimskému."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:22 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:23 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:24
msgid "Get the Book of Rules from the Ta'Sar Academy."
msgstr "Získej Knihu pravidel z Ta'Sarské akademie."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:22
msgid ""
"Go to the Ta'Sar Academy in Lindisfarne and retrieve the Book of Rules.  Return to Jarl Markel in Guberland when you are finished."
msgstr ""
"Jdi do Ta'Sarské akademie v Lindisfarnu a podívej se tam po Knize pravidel, kterou pak předej jarlovi Markelovi z Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:23
msgid ""
"You've put the books away.  Now go find the location of the Book of Rules."
msgstr ""
"Odložili jste knihy. Teď běžte najít místo, kde se nachází Kniha pravidel."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:24
msgid "You've got the book.  Return it to Jarl Markel in Guberland."
msgstr "Získali jste knihu. Vraťte ji jarlovi Markelovi v Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:25 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:26
msgid "Beat Ivan the Smart at trivia."
msgstr "Poraž Ivana Mazaného"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:25
msgid ""
"Go to the Gathering in Guberland and challenge Ivan the Smart to a trivia contest.  Return to Jarl Markel of Guberland when he is beaten."
msgstr ""
"Vyprav se na shromáždění v Guberlandu a vyzvi Ivana Mazaného na souboj. Až ho porazíš, vrať se k jarlovi Markelovi do Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:26
msgid ""
"You've beaten Ivan the Smart.  Return with the Victory Certificate to Jarl Markel of Guberland."
msgstr ""
"Porazili jste Ivana Mazaného. Vraťte se s vítězným diplomem k jarlovi Markelovi Guberlandskému."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:27
msgid ""
"Go to the Lindisfarne Monastery in Lindisfarne and retrieve the artifact called Thjorad.  Return it to Jarl Sven of Thjorgard."
msgstr ""
"Vydej se do lindisfarnského kláštera v Lindisfarnu a získej odtamtud artefakt zvaný Thjorad. Poté se vrať k jarlovi Svenovi Thjorgardskému."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:27 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:28
msgid "Retrieve Thjorad from Lindisfarne."
msgstr "Získej Thjorad z Lindisfarnu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:28
msgid "You've got Thjorad.  Now return it to Jarl Sven of Thjorgard."
msgstr "Získali jste Thjorad. Teď se vraťte k jarlovi Svenu Thjorgardskému."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:29 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:37
msgid "Find out why the Elemental Thjorad production has stopped."
msgstr "Zjisti, proč byla zastavena těžba thjoradské rudy."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:29
msgid ""
"Go to the Thjorad Mine in Thjorgard and find out why they have stopped producing Elemental Thjorad.  Return to Jarl Sven of Thjorgard when they are once again producing Elemental Thjorad."
msgstr ""
"Podívej se do thjoradských dolů v Thjorgardu a zjisti, proč přestali těžit thjoradskou rudu. Až bude dolování obnoveno, vrať se k jarlovi Svenovi do Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:3 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:5
msgid "Find a way off the island."
msgstr "Najdi cestu z ostrova."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:3
msgid ""
"There's got to be some way off this rock.  Maybe there are a few inhabitants that could help you."
msgstr ""
"Vypadá to, že je tu nějaká cesta přes skálu. Možná tu je pár obyvatel, kteří by ti mohli pomoci."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:30
msgid ""
"A section of the mine is about to cave in.  Find it and see if there is anything you can do about it."
msgstr ""
"Část dolu je zavalená. Najděte tento zával a podívejte se, jestli s ním něco nemůžete provést."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:30
msgid "Find the cave-in"
msgstr "Najdi zával."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:31
msgid "Break through the hard rock."
msgstr "Rozbij tvrdou skálu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:31
msgid ""
"There is a section of rock that is too tough for the miner's picks.  Find it and try to break through it."
msgstr ""
"Je tu část skály, která je pro majzlíky havířů příliš tvrdá. Najdi ji a pokus se ji rozbít."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:32 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:33 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:34
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:35 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:36
msgid "Fix the refinery machine."
msgstr "Oprav těžební stroj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:32
msgid ""
"The slag extractor is broken.  Find Hjarrand the Fixer in Thjorgard.  He should remember how to fix the machine."
msgstr ""
"Oddělovač hlušiny je rozbitý. Najdi Hjarranda Opraváře v Thjorgardu. Měl by si vzpomenout, jak opravit tento stroj."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:33
msgid "You've paid Hjarrand to look at the Machine.  Meet him at the Mine."
msgstr ""
"Zaplatil si Hjarrandovi za to, že se podívá na stroj. Setkej se s ním v dole."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:34
msgid ""
"Hjarrand showed you where the machine is broken.  It's up to you to fix it."
msgstr ""
"Hjarrad vám ukázal, kde je stroj rozbitý. Je to na vás, abyste ho opravili."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:35
msgid ""
"You have the broken Slag Extractor.  Try and get a replacement from Gunnar Thjorsmith in Thjorgard."
msgstr ""
"Máte rozbitý oddělovač hlušiny. Pokuste se sehnat náhradní od Gunnara Thjorsmithe v Thjorgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:36
msgid ""
"You have a replacement Slag Extractor.  Return to the Thjorad Mine and install it."
msgstr ""
"Máte náhradní oddělovač hlušiny. Vraťte se do Thjoradského dolu a nainstalujte ho."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:37
msgid ""
"The East Mine, West Mine, and Refinery are now working.  Return to Thjorgard City and inform Jarl Sven."
msgstr ""
"Východní důl, západní důl a těžební stroj nyní pracují. Vrať se do města Thjorgardu a informuj jarla Svena."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:38 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:39
msgid "Defeat Yanmir the Frost Giant."
msgstr "Znič mrazivého obra Yanmira."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:38
msgid ""
"Go to Yanmir's Sky Fort in Frosgard and find a way to defeat the Frost Giant who lives there.  Return to Jarl Tryygva of Frosgard when you are finished."
msgstr ""
"Pronikni do Yanmirovy nebeské tvrze ve Frosgardu a zjisti, jak lze zabít mrazivého obra, který tam žije. Potom navštiv jarla Tryygvu z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:39
msgid ""
"You've killed Yanmir the Frost Giant.  Now return to Jarl Tryygva of Frosgard."
msgstr ""
"Zabili jste Yanmira, mrazivého obra. Teď se vraťte k jarlovi Tryygvovi Frosgardskému."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:4
msgid "Find Yrsa the Troll."
msgstr "Najdi Yrsu Trol."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:4
msgid ""
"Forad Darre suggested that if you find Yrsa the Troll, she may be able to help you leave the island."
msgstr ""
"Forad Darre tvrdil, že pokud najdete Yrsu Trol, může být schopna vám pomoci opustit ostrov. "

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:40 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:41 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:42
msgid "Break up the ice that surrounds the docks."
msgstr "Rozbij led, který obklopuje doky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:40
msgid ""
"Find a way to break up the ice that surrounds the docks in Frosgard.  Return to Jarl Tryygva of Frosgard when you are finished."
msgstr ""
"Najdi způsob, jak prolomit ledy, jež obklopují doky ve Frosgardu. Potom se navrať k jarlovi Tryygvovi z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:41
msgid ""
"Bodvar Elvissen has delivered a sunflower barrel to the edge of the docks.  Find it and destroy it to see if it will break up the ice."
msgstr ""
"Bodvar Elvissen doručil sud se slunečnicí na okraj doků. Najdi ho a znič ho, abys viděl, jestli rozláme led."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:42
msgid ""
"You've succeeded in breaking up the ice that surrounds the docks.  Return to Jarl Tryygva of Frosgard."
msgstr ""
"Uspěli jste. Rozbili jste led, který obklopoval doky. Vraťte se k jarlovi Tryygvovi z Frosgardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:43
msgid ""
"Find a way to rid Thronheim of Honk worshippers.  Just don't kill them.  Return to Kira the Cold in Thronheim when you are finished."
msgstr ""
"Vymysli, jak zbavit Thronheim Uctívačů kejhovových - nesmíš je však pozabíjet. Až se ti to podaří, zajdi za Kirou Chladnou z Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:43 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:44 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:45
msgid "Rid Thronheim of Honk worshippers."
msgstr "Zbav Thronheim kejhovitů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:44
msgid ""
"Moenach the dockmaster in Thronheim has agreed to shanhai the Honkies.  Find all three Honkies and try to convince them to visit the docks."
msgstr ""
"Moenach, pán doků v Thronheimu, souhlasil s násilným odvezením kejhovitů. Najdi všechny tři kejhovity a pokus se je přesvědčit k tomu, aby navštívili doky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:45
msgid ""
"All the Honkies are on their way to the docks.  Return to Kira the Cold in Thronheim."
msgstr ""
"Všichni kejhovité jsou na cestě do doků. Vrať se ke Kiře Chladné v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:46
msgid ""
"Find and clear the Mountain Pass between Thronheim and Thjorgard.  Return to Kira the Cold in Thronheim when you are finished."
msgstr ""
"Najděte a vyčistěte horský průsmyk mezi Thronheimem a Thjorgardem. Vraťte se ke Kiře Chladné v Thronheimu, až budete hotovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:46 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:47
msgid "Find the Mountain Pass."
msgstr "Najdi horský průsmyk."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:47
msgid ""
"You've traveled through the Mountain Pass.  Return to Kira the Cold with its location."
msgstr ""
"Prošli jste horským průsmykem. Vraťte se ke Kiře Chladné s jeho polohou."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:48
msgid "Go to Thronheim for the war council."
msgstr "Zúčastni se válečného shromáždění v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:48
msgid ""
"Now that the clans are united, there is to be a war council in Thronheim in two weeks."
msgstr ""
"Nyní, když se kmeny konečně spojily, se bude za čtrnáct dní v Thronheimu konat válečná porada."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:49
msgid ""
"Find out why Sturmford and Drangheim have gone to war with each other, and stop them from fighting.  Return to the War Council in Thronheim when you are finished."
msgstr ""
"Zjistěte, proč Sturmford a Drangheim začali spolu válčit a zastavte tento boj. Vraťte se na válečnou poradu v Thronheimu, až budete hotovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:49 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:50 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:51
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:52 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:53
msgid "Stop the war between Sturmford and Drangheim."
msgstr "Zastav válku mezi Sturmfordem a Drangheimem."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:5
msgid ""
"You have a task to perform.  The first step is to find a way off this island.  Yrsa suggested you speak to Forad Darre."
msgstr ""
"Musíte splnit úkol. První krok přestavuje nalezení cesty z ostrova. Yrsa vám doporučila, abyste si promluvili s Foradem Darre."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:50
msgid ""
"Bjarni and Sigmund have agreed to sign the peace treaty.  Meet them at Kira's Palace in Thronheim."
msgstr ""
"Bjarni a Sigmund souhlasili s podepsáním mírové smlouvy. Setkej se s nimi v paláci Kiry Chladné v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:51
msgid ""
"Bjarni said he's willing to sign a peace treaty.  Find someone to write it."
msgstr ""
"Bjarni řekl, že je ochotný podepsat mírovou smlouvu. Najdi někoho, kdo ji sepíše."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:52
msgid "Sigmund is willing to sign a peace treaty.  Find someone to write it."
msgstr ""
"Sigmund je ochotný podepsat mírovou smlouvu. Najdi někoho, kdo ji sepíše."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:53
msgid ""
"Kira has written a peace treaty for Sturmford and Drangheim.  Get Sigmund and Bjarni to agree to sign it."
msgstr ""
"Kira sepsala mírovou smlouvu pro Sturmford a Drangheim. Dej je Sigmundovi a Bjarnimu, aby je podepsali."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:54
msgid ""
"Go to the Thing in Thjorgard, and get the prize for Yrsa's daughter Bikki by winning all the games.  Once you have the prize, take it to Bikki Yrsadotir in Thronheim.  Return to the War Council in Thronheim when you are finished."
msgstr ""
"Jděte do Thingu v Thjorgadu a získejte cenu pro Yrsinu dceru Bikki tím, že vyhrajete všechny hry. Až budete mít cenu, dejte ji Bikki Yrsadotir v Thronheimu. Vraťte se na válečnou poradu v Thronheimu, až budete hotovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:54 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:55
msgid "Win a prize at the Thing for Yrsa's daughter."
msgstr "Vyhraj v Thingu cenu pro Yrsinu dceru."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:55
msgid "You have the Prize.  Take it to Yrsa's daughter Bikki."
msgstr "Získali jste cenu. Odneste ji Yrsině dceři Bikki."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:56
msgid "Return to War Council."
msgstr "Vrať se na válečnou poradu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:56
msgid ""
"You've delivered Bikki's prize.  Return to the War Council in Thronheim."
msgstr ""
"Doručili jste Bikkinu cenu. Vraťte se na válečnou poradu v Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:57
msgid "Meet army in Yorwick."
msgstr "Setkej se s armádou v Yorwicku."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:57
msgid ""
"Travel through the Connecting Tunnels to Yorwick and join the coalition army."
msgstr ""
"Projdi skrz spojovací tunel do Yorwicku a připoj se ke spojenecké armádě."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:58
msgid ""
"Find a way to travel to Arslegard and speak to Skraelos to get your soldiers back."
msgstr ""
"Pokuste se přepravit do Arslegardu a promluvte se Skraelem, zda by vám nevrátil vaše vojáky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:58
msgid "Get your army back."
msgstr "Získej zpět svou armádu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:59
msgid ""
"Get a Writ of Fate from the Wyrdes so Hanndl will let you into Arslegard."
msgstr ""
"Od Wyrda so Hanndla si vyptej Písmo osudu, aby ses mohl dostat do Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:59
msgid "Get a Writ of Fate."
msgstr "Sežeň Písmo osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:6
msgid "Help Yrsa the Troll."
msgstr "Pomoz Yrse Trol."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:6
msgid ""
"There are a group of dragonflies beyond the tunnel near Yrsa's hut.  Find them and kill them all."
msgstr ""
"Za tunelem k Yrsině chýši se usadila skupina vážek. Najdi je a všechny je pozabíjej."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:60
msgid ""
"Get the Capstone of Order from Guberland and take it to the Verhoffin Ruins."
msgstr "V Guberlandu získej Kámen řádu a doprav jej do Verhoffinových ruin."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:60 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:61 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:62
msgid "Take the Capstone of Order to the Verhoffin Ruins"
msgstr "Zanes Kámen řádu do Verhoffinových ruin."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:61
msgid ""
"Thorir Mouth of Guberland will trade the Capstone of Order for a wooden sword, a wooden shield, a fur cap, a pair of cloth gloves, a set of quilted armor, and a pair of fuzzy slippers."
msgstr ""
"Thorir Huba Guberlandský vymění Kámen řádu za dřevěný meč, dřevěný štít, beranici, pár plátěných rukavic, prošívané brnění a pár chlupatých pantoflí."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:62
msgid ""
"You have the Capstone of Order.  Take it to the Verhoffin Ruins and place it on the pedestal in the Lab Room."
msgstr ""
"Máte Kámen řádu. Zaneste ho do Verhoffinových ruin a položte ho na piedestal v laboratoři."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:63
msgid "Pick up the Writ of Fate."
msgstr "Vezmi Písmo osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:63
msgid ""
"You have placed the Capstone of Order in the Verhoffin Ruins.  Pick up the Writ of Fate from the altar in the Lab Room, then show it to Hanndl at the Great Gate in Arslegard to get in."
msgstr ""
"Umístili jste Kámen řádu do Verhoffinových ruin. Vezměte Písmo osudu z oltáře v laboratoři, pak ho ukažte Hanndlovi u Velké brány v Arslegardu, aby vás pustil dovnitř."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:64
msgid "Return to Arslegard."
msgstr "Vrať se do Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:64
msgid ""
"You've got a Writ of Fate.  Show it to Hanndl at the Great Gate in Arslegard to get in."
msgstr ""
"Získali jste Písmo osudu. Ukažte ho Hanndlovi u Velké brány v Arslegardu, aby vás pustil dovnitř."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:65
msgid ""
"Go to The Afterworld in Arslegard and light the Six Fires of Penance.  Return to Skraelos in the Hall of the Gods when you are finished."
msgstr ""
"Vydej se do posmrtného světa v Arslegardu a zažehni šest ohňů pokání. Poté se vrať ke Skraelovi v Síni bohů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:65 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:66 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:67
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:68 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:69 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:70
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:71
msgid "Light the Six Fires of Penance."
msgstr "Zažehni šest ohňů pokání."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:66
msgid "Confession:  Find the Six Jarls and confess to them your guilt."
msgstr "Přiznání: Vyhledej šest jarlů a přiznej jim svou vinu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:67
msgid "Suffering:  You must suffer until you satisfy the Questioner."
msgstr ""
"Utrpení:  Musíte trpět tak dlouho, dokud nebude zadavatel úkolu spokojen."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:68
msgid ""
"Retribution:  Find and kill the ghostly versions of the Beldonian Horde."
msgstr "Odplata: Najdi a zabij strašidelné přízraky Beldonských hord."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:69
msgid ""
"Absolution:  Find all five of the Jarls' swords and return them to Skraelos."
msgstr "Rozhřešení: Najdi všech pět mečů jarlů a vrať je Skraelovi."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:7
msgid "Kill the Bone Thrashers."
msgstr "Pozabíjej kostrouny."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:7
msgid ""
"To be able to leave the island, you have to stop the bone thrashers from coming over from their mausoleum.  Forad suggested there might be something behind the locked door that could help."
msgstr ""
"Aby bylo možné ostrov opustit, je třeba zastavit kostrouny, kteří vycházejí ze svého mauzolea. Forad ti poradil, že za zamčenými dveřmi bude možná ukryto něco, co ti pomůže."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:70
msgid ""
"Rebirth.  You've lit five of the six fires.  Find the blazing inferno out there and step through it to be reborn."
msgstr ""
"Znovuzrození. Zažehli jste pět ze šesti ohňů. Najděte rozžhavené peklo a vejděte do něj, abyste se mohli znovuzrodit."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:71
msgid ""
"You've lit the Six Fires.  Return to Skraelos and ask him to give you your soldiers back."
msgstr ""
"Zažehli jste šest ohňů. Vraťte se ke Skraelovi a požádejte ho o navrácení vašich vojáků."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:72
msgid ""
"Find Sven Forkbeard in Arslegard and speak to him about leading the army against the Beldonian Hordes."
msgstr ""
"V Arslegardu se poohlédni po Svenu Vidlobradovi a pohovoř si s ním o vedení vojsk proti beldonským tlupám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:72
msgid "Speak to Sven Forkbeard."
msgstr "Promluv si se Svenem Vidlobradem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:73
msgid "Lead Army against the Beldonian Hordes."
msgstr "Veď armády proti beldonským tlupám."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:73
msgid ""
"The Beldonian Horde is moving toward Frosgard.  Travel there and stop Tamur Leng and Forad Darre once and for all!"
msgstr ""
"Beldonské tlupy táhnou na Frosgard. Odcestuj tam a jednou provždy Tamura Lenga a Forada Darre zastav!"

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:74
msgid "Find out why you and Tamur Leng have Writs of Fate."
msgstr "Zjisti, proč ty i Tamur Leng máte svitky osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:74
msgid "Find out why you and Tamur Leng have conflicting Writs of Fate."
msgstr "Odhalte, proč vy a Tamur Leng máte protichůdné svitky osudu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:75
msgid "Stand before Krohn."
msgstr "Staň před Krohnem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:75
msgid ""
"You and Tamur Leng have been summoned to the Hall of the Gods in Arslegard to stand before Krohn."
msgstr ""
"Spolu s Tamurem Lengem jste byli předvoláni před Krohna do Síně bohů v Arslegardu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:76
msgid ""
"Find a way to lure Njam into the Tomb of a Thousand Terrors.  Once there, find a way to imprison Njam the Meddler."
msgstr ""
"Najdi způsob, jak nalákat Njama do Hrobky tisíce hrůz. Až tam bude, najdi způsob, jak tam Njama Kibice uvěznit."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:76
msgid "Imprison Njam the Meddler in the Tomb of 1000 Terrors."
msgstr "Uvězni Njama Kibice v Hrobce tisíce hrůz."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:77
msgid ""
"Find Atli Sigmundssen in Guberland and find out how you can help him move to Thronheim."
msgstr ""
"Najděte Atli Sigmundssena v Guberlandu a zjistěte, jak mu můžete pomoci přestěhovat se do Thronheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:77 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:79
msgid "Speak to Atli Sigmundssen."
msgstr "Promluv si s Atli Sigmundsenem."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:78
msgid "Guard Atli Sigmundssen's Boat."
msgstr "Pohlídej loď Atli Sigmundssena."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:78
msgid ""
"Relieve Atli's guard at 3:00am and guard the boat until Atli relieves you at 6:00am."
msgstr ""
"Vystřídejte Atliho stráž ve 3:00 a hlídejte loď, dokud vás Atli nevystřídá v 6:00."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:79
msgid ""
"Now that he has relieved you, speak to Atli to make sure he doesn't need anymore of your help."
msgstr ""
"Teď vás Atli vystřídal, tak si s ním ještě promluvte, abyste se ujistili, že už nebude potřebovat vaši pomoc."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:8
msgid "Unite the Clans."
msgstr "Sjednoť klany."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:8
msgid ""
"Yrsa has commanded you to unite the six clans of the Chedian against the Beldonian Hordes.  Perhaps you should speak to the six clan leaders."
msgstr ""
"Yrsa ti nakázala, abys spojil šest chedijských kmenů proti beldonským tlupám. Možná by sis měl promluvit se všemi vůdci těchto klanů."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:80 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:84
msgid "Defeat the Yobboes."
msgstr "Zlikviduj chuligány."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:80
msgid ""
"Find the Yobboe Gang in Drangheim, defeat them, and return the villagers' things to them."
msgstr ""
"V Drangheimu vypátrej gang velkých chuligánů, rozpráši jej a vrať vesničanům jejich věci."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:81
msgid "Return the Plow."
msgstr "Vrať pluh."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:81
msgid ""
"You've got his plow, now return it to Hring Plowhands in Drangheim Village."
msgstr "Máte pluh. Vraťte ho Hringovi Oráčovi ve vesnici Drangheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:82
msgid "Return the Dolly."
msgstr "Vrať panenku."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:82
msgid ""
"You've got her dolly, now return it to Tyock A'Norta a'leipshi in Drangheim Village"
msgstr "Máte panenku.Vraťte ji Tyock A'Nortě a'leipshi ve vesnici Drangheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:83
msgid "Return the Herbs."
msgstr "Vrať byliny."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:83
msgid ""
"You've got her herbs, now return them to Ragnheid Lifegiver in Drangheim Village"
msgstr "Máte byliny. Vraťte je Ragnheid Dárkyni života ve vesnici Drangheimu."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:84
msgid ""
"You've defeated the Yobboes.  Return to Keith Bloodaxe in Drangheim City for your reward."
msgstr ""
"Porazili jste Yobby. Vraťte se ke Keith Krvavé sekeře ve městě Drangheim pro svou odměnu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:85
msgid ""
"Find a Magreeb in Thjorgard and study it.  Return to the Bembridge University when you are finished to report your findings."
msgstr ""
"V Thjorgardu najdi magríba a prozkoumej jej. Své poznatky pak přednes na Bembridgské univerzitě."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:85 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:86
msgid "Study a Magreeb."
msgstr "Prostuduj magríba."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:86
msgid ""
"You've found a Magreeb and studied it.  Return to Tymon the Nord at the Bembridge University in Thjorgard to report your findings."
msgstr ""
"Našli jste magríba a prozkoumali jste ho. Vraťte se ke Tymonovi Seveřanovi na Bembridgskou univerzitu v Thjorgardu, abyste mu nahlásili své výsledky."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:87
msgid ""
"Find a way to heal Nutty Nurtigan in Guberland.  Return to Tjolnir the Super-neat in Guberland when you've succeeded."
msgstr ""
"Přijď na to, jak vyléčit Nutty Nurtigana z Guberlandu. Až se ti to podaří, ohlaš to Tholnirovi Přečistému z Guberlandu."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:87 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:88 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:89
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:90 assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:91
msgid "Heal Nutty Nurtigan."
msgstr "Uzdrav Nutty Nurtigana."

# imported from the Czech MM9 (CD Projekt, 2002)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:88
msgid ""
"Skarphedinn Njalssen at the apothecary in Guberland said he needed a lock of the Old Hag's hair to make the potion to cure Nurtigan."
msgstr ""
"Skarphedinn Njalssen v lékárně v Guberlandu řekl, že potřebuje pramínek vlasů staré čarodějnice, aby mohl vyrobit lektvar, který by vyléčil Nurtigana."

# imported from the Czech MM9 (CD Projekt, 2002)
# party made plural (Claude)
#: assets_dev/worlds/mm9/dialogue/rude/NPC997.rude:89
msgid ""
