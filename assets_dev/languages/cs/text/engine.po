# imported from CZfix (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/items.txt:1406
msgid ""
"Quest Item:  A jar holding your physical and spiritual essence.  Don't lose the jar."
msgstr ""
"Úkolový předmět: Ve džbánu je uschována vaše fyzická a duševní podstata. Neztraťte džbány."

