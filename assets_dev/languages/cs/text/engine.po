#: assets_dev/engine/data_tables/items.txt:54
msgid "Hayfork"
msgstr "Vidle"

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:54
msgid ""
"Though a common farming implement, this hayfork is of sturdy construction and could be an excellent, if improvised, weapon."
msgstr ""
"Ačkoli jsou určené pro obyčejné farmaření, tyto vidle na seno mají robustní konstrukci a mohou být použity jako útočná zbraň."

