# imported from CZfix (MMMerge localization)
#~ msgid "Wonderful!"
#~ msgstr ""
#~ "Skvělé! Není mrtvá! Omlouvám se za všechny nepříjemnosti. Doufám, že přijmete tento znak jako výraz mé vděčnosti."

# imported from CZfix (MMMerge localization)
#~ msgid "Is there no hope for us?"
