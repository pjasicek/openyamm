# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:103 assets_dev/engine/data_tables/spells.txt:102
msgid "Fastest recovery rate and 9 fragments"
msgstr "Nejrychlejší doba zotavení a 9 střepin"

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:103 assets_dev/engine/data_tables/spells.txt:102
msgid ""
"Fires a blast of hot, jagged metal in front of the caster, striking any creature that gets in the way.  Each piece inflicts 1-6 points of damage per point of skill in Dark Magic."
msgstr ""
"Vystřelí několik horkých, ostrých kovových střepin ve směru pohledu družiny, které zasáhnout jakoukoliv nestvůru která se jim dostane do cesty. Každá střepina způsobí 1-6 bodů zranění za bod dovednosti magie temnoty."

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:104 assets_dev/engine/data_tables/spells.txt:103
msgid "Cntrl Undead"
msgstr "Ovl. nemrtvé"

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:104 assets_dev/engine/data_tables/spells.txt:103
msgid "Duration 3 minutes per point of skill"
