#: assets_dev/engine/data_tables/npc_topic_text.txt:1679 assets_dev/engine/events/Global.lua:4154 assets_dev/engine/events/Global.lua:4202
#: assets_dev/engine/events/Global.lua:4250 assets_dev/engine/events/Global.lua:4298 assets_dev/engine/events/Global.lua:4346
