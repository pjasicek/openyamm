msgid "Wetsuit"
msgstr "Skafandr"

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:141
msgid ""
"A ring of soft gold rendered with half-hearted craftsmanship as a means of conveniently carrying a small amount of wealth."
msgstr ""
"Prsten z měkkého zlata vyrobený nepříliš zručným klenotníkem. Slouží spíše jako symbol movitějšího majitele."

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:141
msgid "Gold Ring"
msgstr "Zlatý prsten"

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1410
