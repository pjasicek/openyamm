"Is there anything I can do for you?"
msgstr ""
"<smiling>  The end of the world nears--with a little help from you and me, %10 %02.  Is there anything I can do for you?"

# imported from CZfix2 (MMMerge localization)
#: assets_dev/engine/data_tables/npc_topic_text.txt:6929
msgid ""
"Wonderful %10 %02!\n"
"You have come to save the world!\n"
"Praise be!\n"
"I only hope you aren't too late."
