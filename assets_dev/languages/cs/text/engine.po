# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:608
msgid ""
"Quest Item: This Dragon egg is nearly ready to hatch. The small life inside makes its presence known with an occasional rustle."
msgstr ""
"Úkolový předmět: Toto dračí vejce se brzo vyklube. Malý tvoreček uvnitř dává najevo svou přítomnost občasnými pohyby."

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:609
