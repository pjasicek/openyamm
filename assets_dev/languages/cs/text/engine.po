msgstr "Funguje, pokud slabost byla kratší než 3 minuty za bod zkušenosti"

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/english/spells.txt:76 assets_dev/engine/data_tables/spells.txt:75
