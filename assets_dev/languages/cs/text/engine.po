#: assets_dev/engine/data_tables/items.txt:1410
msgid "Oscillation Overthruster"
msgstr "Oscilační přetlakovač"

# imported from CZfix (MMMerge localization)
# address made plural (Claude)
#: assets_dev/engine/data_tables/items.txt:1410
msgid ""
"Quest Item:  This device has no visible symbols or parts.  Why it is so valuable is beyond your comprehension."
msgstr ""
"Úkolový předmět: Na tomto zařízení nejsou viditelné žádné symboly nebo ovládací prvky. Nemůžete pochopit, proč je tak cenné."

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1411
msgid ""
"Quest Item:  A highly stylized 'D' and 'P' intertwined by a snake with a crown above its head are engraved into the face of this ring.  This must certainly be Davrick's."
msgstr ""
"Úkolový předmět: Na prstenu jsou vyryty stylizované iniciály 'D' a 'P' propletené hadem s korunou na jeho hlavě. Prsten jistě patří Davrickovi."

# imported from CZfix (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1411
msgid "Signet Ring"
msgstr "Pečetní prsten"

# imported from CZfix (MMMerge localization)
