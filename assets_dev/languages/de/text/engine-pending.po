# imported from GR (MMMerge localization)
# address made plural (Claude)
msgid "You find a grey key where one of the bricks used to be."
msgstr "Dort, wo ein Stein fehlt, findet Ihr einen grauen Schlüssel."

# imported from GR (MMMerge localization)
# address made plural (Claude)
msgid "You find a silver key where one of the bricks used to be."
msgstr "Dort, wo ein Stein fehlt, findet Ihr einen silbernen Schlüssel."

# imported from GR (MMMerge localization)
# address made plural (Claude)
msgid "You find and destroy one of the clerics bones."
msgstr "Ihr findet und vernichtet einen der Knochen des Klerikers."

# imported from GR (MMMerge localization)
# address made plural (Claude)
msgid "You fit the dowl into the hole and a small key pops out."
msgstr ""
"Ihr steckt den Dübel in das Loch und ein kleiner Schlüssel fällt heraus."

# imported from GR (MMMerge localization)
# address made plural (Claude)
msgid "You fit the key into the padlock and it pops open."
msgstr "Ihr steckt den Schlüssel in das Schloß, und es springt auf."

# imported from GR (MMMerge localization)
# address made plural (Claude)
msgid "You harvest the guano and put it in your pouch"
msgstr "Ihr sammelt den Dung ein und stopft ihn in Euren Beutel"

# imported from GR (MMMerge localization)
