msgstr "Schild eines Mitbewerbers"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1463
msgid ""
"Quest Item:  Blood stains the back side of this battered shield.  The owner must certainly have been killed while using it."
msgstr ""
"Suchgegenstand: Die Innenseite des Schildes ist blutverschmiert. Der Besitzer ist sicherlich getötet worden, während er den Schild trug."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1464
