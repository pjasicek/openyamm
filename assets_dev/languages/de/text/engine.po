#: assets_dev/engine/rulesets/maw/content/items_patch.txt:903 assets_dev/engine/rulesets/maw/content/items_patch.txt:915 assets_dev/engine/rulesets/maw/content/items_patch.txt:927
msgid "Book"
msgstr "Buch"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:614
msgid "Lost Book of Kehl"
msgstr "Das verschollene Buch von Kehl"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:614
msgid ""
"Quest Item: The formerly \"Lost\" Book of Kehl. Some say he was the greatest necromancer of the last age. Staring at the intricately embossed cover is a disquieting experience as the design seems to writhe with evil energy."
msgstr ""
"Wichtiger Gegenstand: Das einst verschollene Buch von Kehl. Einige sagen, daß er der größte Nekromant vergangener Tage war. Es ist ein beunruhigendes Erlebnis, auf die kompliziert geprägte Buchhülle zu schauen, da das Muster sich vor finsterer Energie zu winden scheint."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:615
msgid ""
"Quest Item: Though painstakingly carved from a single slab of gray stone, Korbu's sarcophagus is inexplicably, much lighter in weight than seems possible. Removal of the snug fitting lid produces a powerful exhalation of myrrh and stale crypt air."
msgstr ""
"Wichtiger Gegenstand: Obwohl er sorgfältig aus einem einzigen grauen Stein gearbeitet wurde, ist Korbus Sarkophag unerklärlicherweise viel leichter als es eigentlich möglich sein könnte. Wenn man den gut sitzenden Deckel abnimmt, wird ein Geruch von Myrrhe und abgestandener Luft einer Gruft verströmt."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:615
msgid "Sarcophagus"
msgstr "Sarkophag"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:615
msgid "Sarcophagus of Korbu"
msgstr "Sarkophag des Korbu"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:616
msgid "Box"
msgstr "Kiste"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:616
msgid "Puzzle Box"
msgstr "Rätselkästchen"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:616
msgid ""
"Quest Item: No matter how you move the shifting panels of this small inlaid box, its lid remains shut. When you shake it, you can hear something rattling around inside. It sounds like a large nut or bead."
msgstr ""
"Wichtiger Gegenstand: Egal, wie man die sich verschiebende Täfelung dieses kleinen eingelegten Kästchens bewegt, sein Deckel öffnet sich nicht. Wenn man es schüttelt, hört man innen etwas klappern. Es klingt nach einer großen Nuß oder Perle."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:617
msgid ""
"Quest Item: This is the vial of dirt you stole from the vampire crypt in Shadowspire."
msgstr ""
"Wichtiger Gegenstand: Dies ist die Phiole mit Erde, die Ihr aus der Vampirgruft in Schattensumpf gestohlen habt."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:617
msgid "Vial"
msgstr "Phiole"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:617
msgid "Vial of Grave Earth"
msgstr "Phiole mit Graberde"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:618
msgid "Drum"
msgstr "Trommel"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:618
msgid "Drum of Victory"
msgstr "Trommel des Sieges"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:618
msgid ""
"Quest Item: This magical items properties are unknown to you. When you tap the drum's head with one of its sticks, the resulting beat resonates with echoes that seem to reflect from the ceiling of the sky."
msgstr ""
"Wichtiger Gegenstand: Die Eigenschaften dieses magischen Gegenstandes sind Euch unbekannt. Wenn die Tommel geschlagen wird, ertönt ein gewaltiger Klang mit einem Echo, das scheinbar vom Himmel zurückgeworfen wird."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:619
msgid ""
"Quest Item: Though possessing no magical properties, this potion's ingredients have been gathered under the most stringent ritual conditions. The thornbark powder, for example, was ground in a silver mortar from bark stripped during the peak of a high noon eclipse. The whole concoction has sat in the seer's personal shrine for more than a hundred years."
msgstr ""
"Wichtiger Gegenstand: Obwohl sie keine magischen Eigenschaften besitzen, wurden die Bestandteile dieses Trankes unter schärfsten rituellen Bedingungen gesammelt. Das Dornenrindenpulver beispielsweise, dessen Rinde zum Zeitpunkt des höchsten Standes der mittäglichen Sonnenfinsternis abgerindet wurde, wurde in einem silbernen Mörser gemahlen. Die Mischung des Trankes wurde über einhundert Jahre im persönlichen Schrein des Sehers aufbewahrt."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:62
msgid ""
"By laminating together layers of wood, steel, and bone the bowsmiths of Alvar have created a bow of perfect balance, strength and accuracy. The process consumes a lot of time, craft and expensive materials which explains the steep price these bows command."
msgstr ""
"Durch die Laminierung von Schichten aus Holz, Stahl und Knochen haben die Waffenschmiede von Alvar einen Bogen geschaffen, der gute Balance, Durchschlagskraft und Präzision in sich vereinigt. Die Herstellung ist sehr zeitaufwendig, was die hohen Preise für die Bögen erklärt."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:62
msgid "Elven Warbow"
msgstr "Kriegsbogen der Elfen"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:620 assets_dev/engine/rulesets/maw/patches/items.txt:163
msgid ""
"Quest Item: A facet carved stone of dark glassy rock. When tapped it produces a high bell tone."
msgstr ""
"Wichtiger Gegenstand: Ein in Facetten geschnitzter Stein aus dunklem, glasigen Gestein. Wenn man dagegen klopft, ertönt ein hoher Glockenton."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:621 assets_dev/engine/rulesets/maw/patches/items.txt:170
msgid ""
"Quest Item: A facet carved stone of dark glassy rock. When tapped it produces a medium bell tone."
msgstr ""
"Wichtiger Gegenstand: Ein in Facetten geschnitzter Stein aus dunklem, glasigen Gestein. Wenn man dagegen klopft, ertönt ein mittlerer Glockenton."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:622
msgid "Pirate Leader's Key"
msgstr "Schlüssel des Piratenanführers"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:622
msgid "Quest Item: The key you took from Blackwell Cooper's body."
msgstr ""
"Wichtiger Gegenstand: Der Schlüssel, den Ihr von Blackwell Coopers Körper genommen habt."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:623 assets_dev/engine/data_tables/items.txt:624
msgid "Prison Key"
msgstr "Gefängnis schlüssel"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:623 assets_dev/engine/data_tables/items.txt:624
msgid ""
"Quest Item: A key of the type commonly used for dungeon cell door locks."
msgstr ""
"Wichtiger Gegenstand: Ein Schlüssel vom Typ derjenigen, die für die Schlösser von Kerkertüren verwendet werden."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:625
msgid "quest item 622"
msgstr "Auftragsgegenstand 622"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1405 assets_dev/engine/data_tables/items.txt:2059 assets_dev/engine/data_tables/items.txt:2060
#: assets_dev/engine/data_tables/items.txt:2061 assets_dev/engine/data_tables/items.txt:2062 assets_dev/engine/data_tables/items.txt:2063
