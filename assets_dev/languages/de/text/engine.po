msgstr "Kartenspiel"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid ""
"Quest Item: A deck of fancifully drawn cards used for a popular card game."
msgstr ""
"Suchgegenstand: Ein Stapel schöner Karten für ein beliebtes Kartenspiel."

