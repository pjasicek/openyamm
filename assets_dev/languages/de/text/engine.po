msgid "Heart of the Wood"
msgstr "Herz des Waldes"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1405
msgid "Quest Item:  A jewel like none you have ever seen."
msgstr "Suchgegenstand: Ein Juwel, wie Ihr noch keinen gesehen habt."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1406
msgid ""
"Quest Item:  A jar holding your physical and spiritual essence.  Don't lose the jar."
msgstr ""
"Suchgegenstand: Ein Gefäß, das Ihre physische und seelische Essenz bewahrt. Verlieren Sie es nicht!"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1407
msgid "Case of Jars"
msgstr "Kiste mit Gefäßen"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1407
msgid "Case of Soul Jars"
msgstr "Kiste mit Seelengefäßen"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1407
msgid ""
"Quest Item:  A rosewood case lovingly crafted to contain a set of Lich Jars.  This case appears to be full."
msgstr ""
"Suchgegenstand: Ein mit Liebe gearbeitetes Rosenholzkästchen, das Lichgefäße beinhaltet. Dieses Kästchen scheint voll zu sein."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1408
msgid "Parson's Quill"
msgstr "Parsons Federkiel"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1408
msgid ""
"Quest Item:  King Parson's hand employed this quill to sign the treaty ending the first Timber War."
msgstr ""
"Suchgegenstand: König Parsons Hand führte diese Feder, um den Vertrag zu unterzeichnen, der den ersten Holzkrieg beendete."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1408
msgid "Quill"
msgstr "Federkiel"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1409
msgid ""
"Quest Item:  This environmental suit handles not only respiration, but protection from the extreme pressure of deep sea diving.  It does not look like any other items may be worn while wearing the suit.  You must remove ALL equipment to wear the suit."
msgstr ""
"Suchgegenstand: Dieser Schutzanzug gewährleistet nicht nur die Atmung, sondern schützt auch vor dem extremen Druck in großer Tiefe. Es scheint so, als ob kein anderer Gegenstand unter oder über dem Schutzanzug getragen werden kann. Ihr müsst alle anderen Gegenstände ausziehen."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1409
msgid "Strange Suit"
msgstr "Seltsamer Anzug"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1409
msgid "Wetsuit"
msgstr "Tiefseeanzug"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:141
msgid ""
"A ring of soft gold rendered with half-hearted craftsmanship as a means of conveniently carrying a small amount of wealth."
msgstr ""
"Eine halbherzige Goldschmiedearbeit aus weichem Gold. Dieser Ring ist nur dazu gedacht, um auf praktische Art und Weise ein kleines Vermögen mit sich herum zu tragen."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:141
msgid "Gold Ring"
msgstr "Goldring"

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1410
msgid "Ancient Part"
msgstr "Uraltes Bauteil"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1410
msgid "Oscillation Overthruster"
msgstr "Oszillations - Regulator"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1410
msgid ""
"Quest Item:  This device has no visible symbols or parts.  Why it is so valuable is beyond your comprehension."
msgstr ""
"Suchgegenstand:  Dieses Ding hat keine sichtbaren Symbole oder Teile. Warum es so wertvoll ist, liegt jenseits Eures Fassungsvermögens."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1411
msgid ""
"Quest Item:  A highly stylized 'D' and 'P' intertwined by a snake with a crown above its head are engraved into the face of this ring.  This must certainly be Davrick's."
msgstr ""
"Suchgegenstand:  Ein stilisiertes D und P sind - von einer Schlange umgeben, die eine Krone trägt - als Siegel eingraviert. Dieser Ring muß wohl Davrick gehören."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1411
msgid "Signet Ring"
msgstr "Siegelring"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1412
msgid "Letter from Johann Kerrid to the Faerie King"
msgstr "Brief von Johann Kerrid an den Feenkönig"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1412
msgid ""
"Quest Item:  A letter from Johann Kerrid to the Faerie King.  Opening a sealed letter is in the poorest of taste, and would be frowned upon by both parties."
msgstr ""
"Suchgegenstand: Ein Brief von Johann Kerrid an den König der Feen. Einen versiegelten Brief zu öffnen zeugt von schlechten Manieren und würde von allen Seiten mißbilligt werden."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1413 assets_dev/engine/data_tables/items.txt:1414 assets_dev/engine/data_tables/items.txt:1415
