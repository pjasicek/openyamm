#: assets_dev/engine/data_tables/items.txt:1450
msgid ""
"Quest Item:  The powerful left arm of a mighty golem.  It appears to require a bit of assembly before being fully functional."
msgstr ""
"Suchgegenstand: Der kraftvolle linke Arm eines mächtigen Golems. Er scheint noch ein paar Handgriffe zu benötigen, bevor er brauchbar ist."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1451
msgid ""
"This flawless horseshoe is made of silver.  To use, pick the horseshoe up and right-click over a character's portrait."
msgstr ""
"Dieses einwandfreie Hufeisen ist aus Silber. Um es zu benutzen, klicken Sie es auf ein Charakterportrait."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1452
msgid "Dragon Egg"
msgstr "Drachenei"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1452
msgid ""
"Quest Item:  Rough, leathery, and strangely warm, this egg appears nearly ready to hatch."
msgstr ""
"Suchgegenstand: Das Ei ist rauh, ledrig und merkwürdig warm, und scheint darauf zu warten, ausgebrütet zu werden."

# machine translation (Claude), review
#: assets_dev/engine/data_tables/items.txt:1453
msgid "Lantern"
msgstr "Laterne"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid "Lantern of Light"
msgstr "Laterne des heiligen Lichtes"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1453
msgid ""
"Quest Item:  This lantern shines with a faint, holy light, though no flame appears to be lit inside."
msgstr ""
"Suchgegenstand: Diese Laterne leuchtet mit einem blassen, heiligen Licht, obwohl keine Flamme im Inneren zu brennen scheint."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1454
msgid ""
"Quest Item:  This belt is worn to the point where it should only last about an hour.  Hopefully, that will be long enough."
msgstr ""
"Suchgegenstand: Dieser Riemen ist so weit abgenutzt, daß er keine Stunde mehr hält. Hoffentlich ist das lange genug."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1454
msgid "Worn Belt"
msgstr "Abgenutzter Riemen"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1455
msgid ""
"A strangely shaped small building finely crafted inside a glass bottle.  Something about the bottle beckons you inside.  To use, pick the bottle up and click over the picture of your character in the inventory screen."
msgstr ""
"Ein seltsam geformtes, kleines Gebäude feinster Machart ist in dieser Flasche. Etwas an dieser Flasche lockt Sie hinein. Um sie zu benutzen, muß sie aufgenommen und auf das Charakterbild geklickt werden."

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1455
msgid "Temple in a Bottle"
msgstr "Tempel in der Flasche"

# imported from GR (MMMerge localization)
#: assets_dev/engine/data_tables/items.txt:1456
msgid "Arcomage Deck"
msgstr "Arcomage - Karten"

