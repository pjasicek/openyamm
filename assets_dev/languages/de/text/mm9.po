# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:15
msgid "Sturm and Drang have gone to war"
msgstr "Sturm und Drang sind in den Krieg gezogen"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:15
msgid "gone to war!"
msgstr "In den Krieg gezogen!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:16
