msgstr "Der Frostriese ist tot"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:12
msgid "the docks are clear!!"
msgstr "Die Docks sind frei!!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:12
msgid "the icy docks"
msgstr "Die vereisten Docks"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:13
msgid "Honky quest"
msgstr "Honk-Aufgabe"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:13
