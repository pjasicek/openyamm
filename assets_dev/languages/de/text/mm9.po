# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:17
msgid "Player won prize"
msgstr "Spieler hat einen Preis gewonnen"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:17
msgid "Won prize!!"
msgstr "Preis gewonnen!!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:18
msgid "Betrayed Party!!"
msgstr "Die Gruppe wurde verraten!!"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:18
msgid "Forad has betrayed the party"
msgstr "Forad hat die Gruppe verraten"

# machine translation (Claude), review
#: assets_dev/worlds/mm9/dialogue/rude/NPC400.rude:19
msgid "Player imprisoned Njam"
