;----------------------------------------------
;BreakIce.scr
; By Timmy
; handles break the ice quest
;
; edited by Bones -- 6/12/03
; TELP Patch 1.3 -- prevents accessing objects before they are loaded
;----------------------------------------------

#include globals.inc 

#number                         KeyCheck

;-------------------------------------
:OnStart
;-------------------------------------
wait 1 2 Start
exit

;-------------------------------------
:Start
;-------------------------------------

screenfadeout 1
wait 1 1 FadeIn
exit


;-------------------------------------
:FadeIn
;-------------------------------------

letterbox true
getobjecthandle Camera0 g_hobject
trigger g_hobject On
screenfadein 1


getobjecthandle DestructableBrush27 g_hobject
trigger g_hobject DamageOn

wait 1 1 ShootOn
exit

;-------------------------------------
:ShootOn
;-------------------------------------

getobjecthandle Shooter1 g_hobject
trigger g_hobject On

wait 1 .5 LetterboxOff
exit

;-------------------------------------
:LetterboxOff
;-------------------------------------
getobjecthandle Camera0 g_hobject
trigger g_hobject Start
wait 1 1.5 Shooter2
wait 2 1.7 Shooter3
wait 3 1.8 Shooter4
wait 4 2.5 UnderCam
exit

;-------------------------------------
:Shooter2
;-------------------------------------

getobjecthandle DestructableBrush6 g_hobject
trigger g_hobject DamageOn
getobjecthandle DestructableBrush17 g_hobject
trigger g_hobject DamageOn
getobjecthandle DestructableBrush18 g_hobject
trigger g_hobject DamageOn
getobjecthandle DestructableBrush16 g_hobject
trigger g_hobject DamageOn

getobjecthandle Shooter2 g_hobject
trigger g_hobject On
exit

;-------------------------------------
:Shooter3
;-------------------------------------

getobjecthandle Shooter3 g_hobject
trigger g_hobject On
exit

;-------------------------------------
:Shooter4
;-------------------------------------

getobjecthandle Shooter4 g_hobject
trigger g_hobject On
exit


;-------------------------------------
:UnderCam
;-------------------------------------

getobjecthandle Camera0 g_hobject
trigger g_hobject Off
getobjecthandle Camera1 g_hobject
trigger g_hobject On
trigger g_hobject Move
wait 1 .7 Destroy15
wait 2 1.5 Destroy16
wait 3 2 Destroy25
exit


;-------------------------------------
:Destroy15
;-------------------------------------

getobjecthandle DestructableBrush15 g_hobject
trigger g_hobject DamageOn
trigger g_hobject destroy
Playsound Sounds\Events\iceimpact.wav, DoNothing, 100, 9000, FALSE, 100
exit

;-------------------------------------
:Destroy16
;-------------------------------------

getobjecthandle DestructableBrush26 g_hobject
trigger g_hobject DamageOn
trigger g_hobject destroy
Playsound Sounds\Events\iceimpact.wav, DoNothing, 100, 9000, FALSE, 100
exit

