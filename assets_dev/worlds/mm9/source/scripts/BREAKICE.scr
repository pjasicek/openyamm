;-------------------------------------
:GivePoints
;NOTE this script just completes the quest right now.
; this is the routine where additional functionality should go
;-------------------------------------
haskey 72 g_ntemp ;checks to see if player has done this yet

if (g_ntemp==0,  )

	Haskey 71 keycheck ;checks to see if player is on kill anskram keep Quest
	if ( keycheck==1,  )
	
		givekey, 72 ;gives player finished quest key
		GiveEXP 8000
		exit
	endif
endif

Haskey 174 keycheck ;checks to see if player is on kill anskram keep Quest
if ( keycheck==0,  )
	
	givekey, 174 ;gives player finished quest key
	GiveEXP 8000
	exit
	endif
exit




;-------------------------------------
:Main
;-------------------------------------

;TraceOn ;delete me!!
AddTrigger Start OnStart
AddTrigger Cam3 OnCam3
OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
wait 1 .1 Init
exit


;-------------------------------------
:Init
;	overloaded -- Bones
;-------------------------------------

;kills competing waits
wait 1 0 DoNothing

haskey 72 g_ntemp
if (g_ntemp==FALSE)
	haskey 174 g_ntemp
	if (g_ntemp==FALSE)
		exit
	endif
endif

set g_nPad2 1
;timer overloaded intentionally
wait 1 1 OnStart
exit

;-------------------------------------
:OnStart
;	overloaded -- Bones
