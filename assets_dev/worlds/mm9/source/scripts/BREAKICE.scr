:Destroy25
;-------------------------------------

getobjecthandle DestructableBrush25 g_hobject
trigger g_hobject DamageOn
trigger g_hobject destroy
Playsound Sounds\Events\iceimpact.wav, DoNothing, 100, 9000, FALSE, 100
exit

;-------------------------------------
:OnCam3
;-------------------------------------

getobjecthandle Camera1 g_hobject
trigger g_hobject Off
getobjecthandle Camera2 g_hobject
trigger g_hobject On
wait 1 1.1 Group1
wait 2 1.11 Group2
wait 3 1.12 Group3
wait 4 3 OnDone
exit

