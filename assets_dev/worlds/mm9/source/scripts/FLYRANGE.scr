#include FlyRange.inc

;------------------------------------------
:Init
;------------------------------------------

	SetIdle

	exit

;------------------------------------------
:Main
;	This routine is automatically run
;	at script startup...
;------------------------------------------

	gosub FlyRangeInit

	Wait 30, 0.1, Init

	exit
