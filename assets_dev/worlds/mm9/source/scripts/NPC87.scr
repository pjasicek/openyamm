;--------------------------------------------------
;NPC87.scr
; timmy
; handles Sigmund the Stressed voice and quest stuff
;
; edited by Bones 03/25/03
; TELP Patch 1.3 -- delays Sigmund's return 
;--------------------------------------------------

#include globals.inc
#include United.inc

#String    Params          
#String    sound
#number                         KeyCheck
;Parameters
;P0 name of wav file
;P1 name of animation to run
;P2  # of times animation runs


; flag variables
#number							Visible = 1
#number							Solid   = 8192
#number							Gravity = 131072

#number			bVanish

;-------------------------------------
:Init
;-------------------------------------
haskey 40 g_ntemp
if (g_ntemp==TRUE)
	set bVanish TRUE
	gosub vanish
endif

haskey 108 g_ntemp
if (g_ntemp==TRUE)
	set bVanish False
	gosub Vanish
endif
exit


	
;-------------------------------------
:Vanish
;-------------------------------------

getmyhandle g_hobject

if (bVanish==TRUE)
	clearflag g_hobject, visible
	clearflag g_hobject, solid
	clearflag g_hobject, gravity
	exit
else
	setflag g_hobject, visible
	setflag g_hobject, solid
	setflag g_hobject, gravity
	loopanim Sit 0 DoNothing
	exit
endif

exit
;--------------------------------------------------
:OnRude
;--------------------------------------------------

haskey 489 g_ntemp
if (g_ntemp==FALSE)
	haskey 44 g_ntemp
	if (g_ntemp==TRUE)
		giveitem 596
		givekey 489
	endif
endif

Gosub Gossip
Gosub FortStenig
gosub CronaKiga
gosub united
exit


;--------------------------------------------------
:Gossip
;--------------------------------------------------

Haskey 300 g_ntemp
if (g_ntemp==0)
	haskey 55 g_ntemp
	if (g_ntemp==1)
		givekey 300
		giveexp 5000
		givegold 5000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
		exit
	endif
endif
exit

;--------------------------------------------------
:FortStenig
;--------------------------------------------------
;****************
;Fort Stenig Quest
;****************

Haskey 171, keycheck
if (keycheck==0, )
; checks to see if they already have got the reward.
	Haskey 49, g_ntemp
	if (g_ntemp==1, )
	; checks to see if they've got cronakiga
		GiveKey 171
		GiveExp 32000
		Givegold 7000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100

		; gives reward

		exit
	endif
endif

exit


;End Fort stenig quest
;******************
exit


;--------------------------------------------------
:CronaKiga
;--------------------------------------------------
;****************
;CronaKiga Quest
;****************


Haskey 170, keycheck
if (keycheck==0, )
; checks to see if they already have got the reward.
	Haskey 50, g_ntemp
	if (g_ntemp==1, )
	; checks to see if they've got cronakiga
		GiveKey 170
		GiveExp 52000
		Givegold 10000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
		takeitem 390
		; gives reward

		exit
	endif
endif

exit


;End Crona Kiga Quest
;******************
exit




;--------------------------------------------------
:OnUse
;--------------------------------------------------

Playsound voices\NPC\NPC_087.wav, Onexit, 100, 240, FALSE, 100
Gosub OnCheck
exit

;-------------------------------------
:OnExit
;-------------------------------------

exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!
OnRudeExit OnRude
Addtrigger Use, OnUse
Set Jarl, Sigmund
Gosub UnitedInit
gosub Init
exit

