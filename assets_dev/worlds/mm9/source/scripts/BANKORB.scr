;--------------------------------------------------
;BankOrb.scr
; timmy
; handles the bankers for the Orb of Linking
;
; edited by Bones 6/13/02
; TELP Patch 1.3 -- Prevents bankers from offering Orb placement after Orb has been placed.
;--------------------------------------------------
#include globals.inc

#number		nKey
#String		sLocation

#number		nRude
#number		nKey2

; flag variables
#number				Visible = 1
#number				Solid   = 8192
#number				Gravity = 131072

;Parameters

;p0 the key to CheckFor when player placed the orb


;--------------------------------------------------
:OnUse
;--------------------------------------------------

haskey nKey2 g_ntemp
if (g_ntemp==TRUE)
	exit
endif

haskey 322 g_ntemp
if (g_ntemp==FALSE)
	exit
endif

hasitem 252 g_ntemp
if (g_ntemp==TRUE)
	givekey 330
endif
exit

;--------------------------------------------------
:OnRude
;--------------------------------------------------

haskey 330 g_ntemp
if (g_ntemp==TRUE)
	takekey 330
	haskey nKey g_ntemp
	if (g_ntemp==TRUE)
		Playsound sounds\events\quest.wav, DoNothing, 100, 24000, FALSE, 100
		takeitem 252
		givekey nKey2
		Gosub CheckAll
	endif
endif

exit


;--------------------------------------------------
:CheckAll
;--------------------------------------------------

haskey 337 g_ntemp
if (g_ntemp==TRUE)
	exit
endif

set g_ncounter, 0

haskey 331 g_ntemp
if (g_ntemp==TRUE)
	Add g_ncounter, 1
endif

haskey 332 g_ntemp
if (g_ntemp==TRUE)
	Add g_ncounter, 1
endif

haskey 333 g_ntemp
if (g_ntemp==TRUE)
	Add g_ncounter, 1
endif

haskey 334 g_ntemp
if (g_ntemp==TRUE)
	Add g_ncounter, 1
endif

haskey 335 g_ntemp
if (g_ntemp==TRUE)
	Add g_ncounter, 1
endif

haskey 336 g_ntemp
if (g_ntemp==TRUE)
	Add g_ncounter, 1
endif

if (g_ncounter==6)
	givekey 337
	giveexp 20000
	givegold 15000
	Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
endif

exit

;--------------------------------------------------
:Init
;331	Player placed orb in Thronheim
;332	Player placed orb in guberland
;333	Player placed orb in frosgard
;334	Player placed orb in drangheim
;335	player placed orb in thjorgard
;336	player placed orb in sturmgard

;--------------------------------------------------


getmyhandle g_hmyobject
getstat g_hmyobject RudeID nRude

;debugout nRude

if (nRude==13)
	set nKey 335
	set nKey2 323
	exit
endif

if (nRude==56)
	set nKey 336
	set nKey2 324
	exit
endif

if (nRude==100)
	set nKey 334
	set nKey2 325
	exit
endif

if (nRude==140)
	set nKey 332
	set nKey2 326
	exit
endif

if (nRude==206)
	set nKey 333
	set nKey2 327
	exit
endif

if (nRude==243)
	set nKey 331
	set nKey2 328
	exit
endif

exit



;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon ;Remove

AddTrigger Use, ONUse
OnRudeExit OnRude
getparam 0 sLocation
OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
OnPostSaveLoad Init
wait 1 .1 Init
exit