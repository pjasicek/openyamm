;--------------------------------------------------
;rondo.scr
; timmy
; Plays the intro to Rondo ala turk 
;--------------------------------------------------

#include globals.inc 

       
#Number					counter
;--------------------------------------------------
:OnPlay
;--------------------------------------------------

getobjecthandle Bell1, g_hobject
trigger g_hobject use
wait 1 .5, 1
exit

;--------------------------------------------------
:1
;--------------------------------------------------

getobjecthandle Bell2, g_hobject
trigger g_hobject use
wait 1 .5, 2

exit

;--------------------------------------------------
:2
;--------------------------------------------------

getobjecthandle Bell3, g_hobject
trigger g_hobject use
wait 1 .25, 3

exit



;--------------------------------------------------
:3
;--------------------------------------------------

getobjecthandle Bell4, g_hobject
trigger g_hobject use
wait 1 .25, 4

exit

;--------------------------------------------------
:4
;--------------------------------------------------

getobjecthandle Bell5, g_hobject
trigger g_hobject use
wait 1 .5, partII

exit
;Part II

;exit



;--------------------------------------------------
:partII
;--------------------------------------------------

getobjecthandle Bell4, g_hobject
trigger g_hobject use
wait 1 .25, 1-2
exit

;--------------------------------------------------
:1-2
;--------------------------------------------------

getobjecthandle Bell3, g_hobject
trigger g_hobject use
wait 1 .25, 2-2

exit

;--------------------------------------------------
:2-2
;--------------------------------------------------

getobjecthandle Bell2, g_hobject
trigger g_hobject use
wait 1 .5, 3-2

exit



;--------------------------------------------------
:3-2
;--------------------------------------------------

getobjecthandle Bell3, g_hobject
trigger g_hobject use
wait 1 .25, 4-2

exit

;--------------------------------------------------
:4-2
;--------------------------------------------------

getobjecthandle Bell4, g_hobject
trigger g_hobject use
wait 1 .25, PartIII


;Part III

exit

;--------------------------------------------------
:partIII
;--------------------------------------------------

getobjecthandle Bell5, g_hobject
trigger g_hobject use
wait 1 .5, 1-3
exit

;--------------------------------------------------
:1-3
;--------------------------------------------------

getobjecthandle Bell4, g_hobject
trigger g_hobject use
wait 1 .25, 2-3

exit

;--------------------------------------------------
:2-3
;--------------------------------------------------

getobjecthandle Bell3, g_hobject
trigger g_hobject use
wait 1 .25, 3-3

exit



;--------------------------------------------------
:3-3
;--------------------------------------------------

getobjecthandle Bell2, g_hobject
trigger g_hobject use
wait 1 .5, DoNothing

exit



;PartIV

;--------------------------------------------------
:partIV
;--------------------------------------------------

getobjecthandle B2, g_hobject
trigger g_hobject use
wait 1 .25, 1-4
exit

;--------------------------------------------------
:1-4
;--------------------------------------------------

getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .25, 2-4

exit

;--------------------------------------------------
:2-4
;--------------------------------------------------

getobjecthandle G#2, g_hobject
trigger g_hobject use
wait 1 .25, 3-4

exit



;--------------------------------------------------
:3-4
;--------------------------------------------------

getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .25, 4-4
exit


;--------------------------------------------------
:4-4
;--------------------------------------------------

getobjecthandle B2, g_hobject
trigger g_hobject use
wait 1 .25, 5-4
exit

;--------------------------------------------------
:5-4
;--------------------------------------------------

getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .25, 6-4

exit

;--------------------------------------------------
:6-4
;--------------------------------------------------

getobjecthandle G#2, g_hobject
trigger g_hobject use
wait 1 .25, 7-4

exit



;--------------------------------------------------
:7-4
;--------------------------------------------------

getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .25, 8-4

exit

;--------------------------------------------------
:8-4
;--------------------------------------------------

getobjecthandle C2, g_hobject
trigger g_hobject use
wait 1 .75, partV

exit




;PartV


;--------------------------------------------------
:partV
;--------------------------------------------------

getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .5, 1-5
exit

;--------------------------------------------------
:1-5
;--------------------------------------------------

getobjecthandle C2, g_hobject
trigger g_hobject use
wait 1 .5, 2-5

exit

;--------------------------------------------------
:2-5
;--------------------------------------------------

getobjecthandle G2, g_hobject
trigger g_hobject use
getobjecthandle B2, g_hobject
trigger g_hobject use
wait 1 .5, 3-5

exit



;--------------------------------------------------
:3-5
;--------------------------------------------------

getobjecthandle F#2, g_hobject
trigger g_hobject use
getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .5, 4-5
exit


;--------------------------------------------------
:4-5
;--------------------------------------------------

getobjecthandle E1, g_hobject
trigger g_hobject use
getobjecthandle G2, g_hobject
trigger g_hobject use
wait 1 .5, 5-5
exit

;--------------------------------------------------
:5-5
;--------------------------------------------------

getobjecthandle F#2, g_hobject
trigger g_hobject use
getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .5, 6-5

exit

;--------------------------------------------------
:6-5
;--------------------------------------------------

getobjecthandle G2, g_hobject
trigger g_hobject use
getobjecthandle B2, g_hobject
trigger g_hobject use
wait 1 .5, 7-5

exit



;--------------------------------------------------
:7-5
;--------------------------------------------------

getobjecthandle F#2, g_hobject
trigger g_hobject use
getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .5, 8-5

exit

;--------------------------------------------------
:8-5
;--------------------------------------------------

getobjecthandle E1, g_hobject
trigger g_hobject use
getobjecthandle G2, g_hobject
trigger g_hobject use
wait 1 .5, 9-5

exit



;--------------------------------------------------
:9-5
;--------------------------------------------------

getobjecthandle F#2, g_hobject
trigger g_hobject use
getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .5, 10-5
exit


;--------------------------------------------------
:10-5
;--------------------------------------------------

getobjecthandle G2, g_hobject
trigger g_hobject use
getobjecthandle B2, g_hobject
trigger g_hobject use
wait 1 .5, 11-5
exit

;--------------------------------------------------
:11-5
;--------------------------------------------------

getobjecthandle F#2, g_hobject
trigger g_hobject use
getobjecthandle A2, g_hobject
trigger g_hobject use
wait 1 .5, 12-5

exit

;--------------------------------------------------
:12-5
;--------------------------------------------------

getobjecthandle E1, g_hobject
trigger g_hobject use
getobjecthandle G2, g_hobject
trigger g_hobject use
wait 1 .5, 13-5

exit



;--------------------------------------------------
:13-5
;--------------------------------------------------

getobjecthandle D#2, g_hobject
trigger g_hobject use
getobjecthandle F#2, g_hobject
trigger g_hobject use
wait 1 .5, 14-5

exit

;--------------------------------------------------
:14-5
;--------------------------------------------------

getobjecthandle E1, g_hobject
trigger g_hobject use
;wait 1 .5, 8-5

exit


;--------------------------------------------------
:Main
;--------------------------------------------------


;TRACEON
Set counter, 0
AddTrigger Use, OnPlay
exit

