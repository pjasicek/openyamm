;
;		Ambient NPCs
;			Gymir Afissen		( 363 )
;			Aso Darbyssen		( 364 )
;			Dain Kolskeggssen	( 365 )
;			Dagny Daindotir		( 366 )
;			Osk Thorgrimdotir	( 367 )
;			Tepil Ahura			( 368 )
;			Val Tonlan			( 369 )
;			Ateed Haji			( 370 )
;			Sechnassach A'Washadi	( 371 )
;			Angus A'Mor				( 372 )
;			Orabilia A'Dlinn		( 373 )
;			Eilinoir A'Endlar		( 374 )
;			Bjarni Eirikssen		( 375 )
;			Unn Canutedotir			( 376 )
;			Phili, The Great Honk	( 377 ) <<< REMOVED >>>
