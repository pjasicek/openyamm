;----------------------------------------------------------------
;----------------------------------------------------------------
;----------------------------------------------------------------

;----------------------------------------------------------------
:InitWorkSchedule
;----------------------------------------------------------------
	
	@M 6 : 15 Group1_GoWork Group1_WarpWork
	@M 6 : 30 Group2_GoWork Group2_WarpWork
	@M 6 : 45 Group3_GoWork Group3_WarpWork
	@M 7 : 00 Group4_GoWork Group4_WarpWork
	
	Exit


;----------------------------------------------------------------
:InitHomeSchedule
;----------------------------------------------------------------
	
	@M 18 : 00 Group1_GoHome Group1_WarpHome
	@M 18 : 15 Group2_GoHome Group2_WarpHome
	@M 18 : 30 Group3_GoHome Group3_WarpHome
	@M 18 : 45 Group4_GoHome Group4_WarpHome
	
	Exit 

;----------------------------------------------------------------
:InitMiscSchedule
;----------------------------------------------------------------

	; Go Wander off to somewhere	
	@M  13 : 00 Group1_GoMisc Group1_WarpMisc
	@M  13 : 15 Group2_GoMisc Group2_WarpMisc
	@M  13 : 30 Group3_GoMisc Group3_WarpMisc
	@M  13 : 45 Group4_GoMisc Group4_WarpMisc
	
	; Go Back to work
	@M  15 : 00 Group1_GoWork Group1_WarpWork
	@M  15 : 15 Group2_GoWork Group2_WarpWork
	@M  15 : 30 Group3_GoWork Group3_WarpWork
	@M  15 : 45 Group4_GoWork Group4_WarpWork

	Exit


;----------------------------------------------------------------
;----------------------------------------------------------------
;----------------------------------------------------------------

;----------------------------------------------------------------
:InitArrays
;----------------------------------------------------------------
	
	index = 0
	while( index < 10 )
		ArrayPut aGroup1, index , 0
		ArrayPut aGroup2, index , 0
		ArrayPut aGroup3, index , 0
		ArrayPut aGroup4, index , 0
		index = index + 1
	endwhile

	Exit	 

	 	 
