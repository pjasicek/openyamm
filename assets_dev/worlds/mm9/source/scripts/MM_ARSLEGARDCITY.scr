;----------------------------------------------------------------
:Init
;----------------------------------------------------------------
	gosub InitArrays
	
	gosub LoadGroup1
	gosub LoadGroup2
	gosub LoadGroup3
	gosub LoadGroup4
	
	gosub InitWorkSchedule
	gosub InitHomeSchedule
	gosub InitMiscSchedule

	Exit

;----------------------------------------------------------------
:Main
;----------------------------------------------------------------
	gosub Init
	AddTrigger HasArrived, OnArrived
		
	Exit
