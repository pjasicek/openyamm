;----------------------------------------------
; SpikeDoorB.scr
; By Karl
; When spike are removed the blocks can be 
; opened
;
;----------------------------------------------

#include globals.inc 

#number		count = 0
#hObject	hMyDoor

#string		sDoor

;-------------------------------------
:OnUse
;-------------------------------------
	GetMyHandle hMyDoor
	if ( count == 6 )
		Trigger hMyDoor, unlock
		Trigger hMyDoor, toggle
	endif
	Exit TRUE
;-------------------------------------
:OnePulled
;-------------------------------------
	count = count + 1
	if (count == 6 )
			Trigger hMyDoor unlock
			Trigger hMyDoor use
	endif
	Exit 1
;-------------------------------------
:Main2
;-------------------------------------
	GetObjectHandle sDoor, hMyDoor
	AddTrigger OnePulled OnePulled
	Exit 1
;-------------------------------------
:main
;-------------------------------------
	GetParam 0, sDoor
	wait 0, 0.4, Main2
	Exit