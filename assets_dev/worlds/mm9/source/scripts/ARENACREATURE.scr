;--------------------------------------------------
;ArenaCreature.scr
; timmy
; handles scholar promo stuff
;--------------------------------------------------

#include globals.inc
#include basedoor.inc


#number			bWonBattle
#number			nHitPoints
#string			sMonster_ID

#number			nMinHP
#number			nMaxHP


;-------------------------------------
:OnArrive
;-------------------------------------


stop

Taunt OnStartFight
;;wait 1 2 OnStartFight

exit TRUE

;-------------------------------------
:OnStartFight
;-------------------------------------

getobjecthandle ShopkeeperElfMaleB0 g_hobject
trigger g_hobject Arrive

exit

;-------------------------------------
:Init
;-------------------------------------

getmyhandle g_hmyobject
getstat g_hmyobject HitPoints g_ntemp
nMinHP = g_ntemp * .7
nMaxHP = g_ntemp * 1.5
getrandomint nMinHP, nMaxHP, nHitPoints
setstat g_hmyobject Hitpoints nHitPoints
setstat g_hmyobject GaveTreasure TRUE

getobjecthandle RotatingDoor2,g_hObject
Trigger g_hObject,Unlock
Trigger g_hObject,Use

getobjecthandle RotatingDoor4,g_hObject
Trigger g_hObject,Unlock
Trigger g_hObject,Use

Wait 29,2.2,GetOutThere

exit

;-------------------------------------
:GetOutThere
;-------------------------------------

getobjecthandle marker2 g_hobject
target g_hObject

runto g_hobject 128 OnArrive
exit


;-------------------------------------
:OnHate
;-------------------------------------

addenemy AIBase
addfriend Player

#string	sScript

GetStatStr g_hmyobject,ScriptName,sScript
;cprint running script
;cprint sScript

getobjecthandle RotatingDoor2,g_hObject
Trigger g_hObject,close
Trigger g_hObject,lock

getobjecthandle RotatingDoor4,g_hObject
Trigger g_hObject,close
Trigger g_hObject,lock

RunScript sScript

exit

;--------------------------------------------------
:FaceMarker
;--------------------------------------------------

GetObjectHandle Marker2,g_hObject
FaceObject g_hObject,0
Exit


;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!
getparam 0 sMonster_ID
givekey 1011
addtrigger HateAll OnHate
wait 2,0.1,FaceMarker
wait 1 3 Init

gosub BaseDoorInit


getmyhandle g_hmyobject

SetPropString DeathTriggerTarget,ShopkeeperElfMaleB0
SetPropString DeathTriggerMessage,IDied
SetPropNumber RunAwayChance,0
SetPropNumber CanOpenDoors,0

GetStatStr g_hmyobject,ScriptName,g_sTemp

CacheScript g_sTemp


exit

