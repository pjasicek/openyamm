#include BaseFly.inc


;------------------------------------------
:Init
;------------------------------------------
	SetIdle

	exit

;------------------------------------------
:Main
;	This routine is automatically run
;	at script startup...
;------------------------------------------

	gosub BaseFlyInit

	Wait 30, 0.01, Init

	exit
