;--------------------------------------------------
:PromotePriest
;
; Player has already completed the quest
; just check to see who gets promoted
;--------------------------------------------------
Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
haskey 441 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Priest Char1
	takekey 441
endif

haskey 442 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Priest Char2
	takekey 442
endif

haskey 443 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Priest Char3
	takekey 443
endif

haskey 444 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Priest Char4
	takekey 444
endif
exit




;--------------------------------------------------
:OnRude
;--------------------------------------------------


gosub Givequest
Gosub priest


exit


;--------------------------------------------------
:Givequest
;--------------------------------------------------

haskey 441 g_ntemp
if (g_ntemp==TRUE)
	givekey 250
	givekey 251
	givekey 252
	exit
endif

haskey 442 g_ntemp
if (g_ntemp==TRUE)
	givekey 250
	givekey 251
	givekey 252
	exit
endif

haskey 443 g_ntemp
if (g_ntemp==TRUE)
	givekey 250
	givekey 251
	givekey 252
	exit
endif

haskey 444 g_ntemp
if (g_ntemp==TRUE)
	givekey 250
	givekey 251
	givekey 252
	exit
endif

;--------------------------------------------------
:priest
;--------------------------------------------------
;****************
;priest Quest
;****************

haskey 261 g_ntemp
if (g_ntemp==FALSE, )
	haskey 260 g_ntemp
	if (g_ntemp==TRUE, )
		giveexp 63000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
		givegold 5000
		givekey 261
		takeitem 241
		takeitem 430
		gosub PromotePriest
		exit
	endif
endif
exit


;End priest quest
;******************
exit




;--------------------------------------------------
:OnUse
;--------------------------------------------------

Playsound voices\NPC\NPC_129.wav, Onexit, 100, 240, FALSE, 100
exit

