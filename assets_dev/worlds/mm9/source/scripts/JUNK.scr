#number				hPlayerObject




;---------------------------------------------------------------------
:Trigger_ON
;---------------------------------------------------------------------

	Set nFollowPathCount, 1
	Set sFollowPathTemp,CameraPath
	Add sFollowPathTemp,nFollowPathCount

	Set g_sOut, [
	Add g_sOut, sFollowPathTemp
	Add g_sOut, ]-->was not found! Total marker count=>
	Add g_sOut, nFollowPathCount

	DebugOut g_sOut

	Exit 1
;---------------------------------------------------------------------
:Main
;---------------------------------------------------------------------

	AddTrigger ON, Trigger_ON

	GetMyHandle hMyObject

	GetPos hMyObject,nStartPosX,nStartPosY,nStartPosZ

;;	ConsoleCommand ShowFrameRate 1


	Exit