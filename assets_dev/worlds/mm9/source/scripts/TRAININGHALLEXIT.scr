#include globals.inc



;-------------------------------------
:OnTouch
;-------------------------------------

Haskey 301 g_ntemp
if (g_ntemp==0)
	exit
	givekey 301
	GiveAttribute 0 5 1 
	GiveAttribute 1 5 1
	giveexp 20000
	Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
	exit
endif
exit

;-------------------------------------
:OnExit
;-------------------------------------

exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!
OnTouchNotify Ontouch


exit

