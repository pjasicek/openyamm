;--------------------------------------------------
;SlagExtractor.scr
; timmy
; handles the slag extractor stuff.
;--------------------------------------------------

#include globals.inc

#String    Params          
#String    sound


#String Model_Name = models\PickUpItems\Quest\Machine-Part_Whole.ABC
#String Model_Skin = skins\PickUpItems\Quest\MachinePart_Whole.dtx

; flag variables
#number							Visible = 1
#number							Solid   = 8192
#number							Gravity = 131072


;--------------------------------------------------
:OnUse
;--------------------------------------------------

haskey 9512 g_ntemp
if (g_ntemp==FALSE)

	;Cprint Player picked up the Slag extractor

	Giveitem 398
	givekey 9512
	getmyhandle g_hobject
	clearflag g_hobject, visible
;	clearflag g_hobject, solid
;	clearflag g_hobject, gravity
	exit
endif

; No exit on purpose?

;--------------------------------------------------
:OnShow
;--------------------------------------------------


;Cprint Player is swapping slag extractor

haskey 37 g_ntemp
if (g_ntemp==TRUE)
	exit
endif

GiveExp 5000
Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
SetModelFilenames model_name Model_skin 
Takeitem 399
givekey 37
getmyhandle g_hobject
setflag g_hobject, visible
;setflag g_hobject, solid
;setflag g_hobject, gravity

exit

;--------------------------------------------------
:Init
;--------------------------------------------------
;;Cprint Ran Init!!


haskey 9512 g_ntemp
if (g_ntemp==TRUE)

	;Cprint Player Got broken slag Extractor

	haskey 37 g_ntemp
	if (g_ntemp==TRUE)

		;Cprint Set Model Filename because the player fixed the machine

		SetModelFilenames model_name Model_skin 
		exit
	else

		;Cprint Extractor is not there because player picked it up already

		getmyhandle g_hobject
		clearflag g_hobject, visible
;		clearflag g_hobject, solid
;		clearflag g_hobject, gravity
		exit
	endif
endif

exit


;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!


Addtrigger Use, OnUse
Addtrigger Show, OnShow
OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
wait 1 .1 Init
exit

