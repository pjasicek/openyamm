;				Fiachu A'Dlinn				( 25 )
;
;			Ambient NPCs
;				Bodil the Brawny			( 31 )
;				Frode Fafnirssen			( 32 )
;				Annelise Baldundotir		( 33 )
;				Karl Knutssen				( 34 )
;				Britta Stonewasher			( 35 )
;				Einar Thorfinssen			( 36 )
;
;			Teacher NPCs
;				Barabell A'Dorad			( 267 )
;				Cator Fiskdal				( 295 )
;				Eilinoir A'Mor				( 310 )
;				Bysen A'Klindor				( 40 )
;				Darby Davinssen				( 311 )
;				Tove Halvardotir			( 320 )
;				Toman Yatol					( 38 )
;				Giorsal A'Velsi				( 321 )
;				Comhgan A'Dorad				( 41 )
;				Cinnfhail A'Mor				( 347 )
;				Gjerta Headstrong			( 37 )
;				Hrrapp Spearhands			( 361 )
;				Muadhnait A'Tryht			( 362 )
;				Thorfinn Quickeye			( 384 )
;				Chera Papan					( 39 )
;				Sigre Bjarnidotir			( 385 )
;				Fjarkskafinn the Still-alive	( 386 )
;				Halfdan the Hidden			( 387 )
;				Hildigunna the Quick		( 388 )
;
;----------------------------------------------------------------

#include Globals.inc

#hObject npc_object	= NULL

#number Work = 1
#number Home = 2
#number Misc = 3
#number goto_location = 1

#number npc_id = 0

#number current_group = 1
#number Group1 = 1
#number Group2 = 2
#number Group3 = 3
#number Group4 = 4

#number index = 0
#numberArray aGroup1[10]
#numberArray aGroup2[10]
#numberArray aGroup3[10]
#numberArray aGroup4[10]

#number bWarp = FALSE

#string goto_marker = ""
#string marker_home = "Marker_Home_"
#string marker_work = "Marker_Work_"
#string marker_misc = "Marker_Misc_"

;----------------------------------------------------------------
:OnArrived
;----------------------------------------------------------------
	
	Exit

;----------------------------------------------------------------
:WarpOn
;----------------------------------------------------------------

	bWarp = TRUE
	
	Exit

;----------------------------------------------------------------
:WarpOff
;----------------------------------------------------------------

	bWarp = FALSE
	
	Exit

;----------------------------------------------------------------
:CreateMarker
;----------------------------------------------------------------

	if( goto_location == Work )
		goto_marker = marker_work + npc_id	
	endif

	if( goto_location == Home )
		goto_marker = marker_home + npc_id	
	endif
	
	if( goto_location == Misc )
		goto_marker = marker_misc + npc_id	
	endif

	Exit

;----------------------------------------------------------------
:GoToLocation
;----------------------------------------------------------------

	GetObjectHandleByRUDEID npc_id, npc_object

	SetStat npc_object, PARAM, goto_marker

	if( bWarp == FALSE )
		Trigger npc_object, GoToLoc
	endif

	if( bWarp == TRUE )
		Trigger npc_object, WarpToLoc
	endif

	Exit

;----------------------------------------------------------------
:LaunchGroup
;----------------------------------------------------------------

	index = 0

	while( index < 10 )
	
		npc_id = 0
		
		if( current_group == Group1 )
			ArrayGet aGroup1,index,npc_id
		endif

		if( current_group == Group2 )
			ArrayGet aGroup2,index,npc_id
		endif

		if( current_group == Group3 )
			ArrayGet aGroup3,index,npc_id
		endif

		if( current_group == Group4 )
			ArrayGet aGroup4,index,npc_id
		endif

		if( npc_id != 0 )
			gosub CreateMarker
			gosub GoToLocation
		endif

		index = index + 1
	endwhile

	Exit

;----------------------------------------------------------------
;----------------------------------------------------------------
;----------------------------------------------------------------

;----------------------------------------------------------------
:Group1_GoWork
;----------------------------------------------------------------

	gosub WarpOff
	current_group = Group1
	goto_location = Work
	gosub LaunchGroup

	Exit

;----------------------------------------------------------------
:Group1_WarpWork
;----------------------------------------------------------------

	gosub WarpOn
	current_group = Group1
	goto_location = Work
	gosub LaunchGroup
	
	Exit

