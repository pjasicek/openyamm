;--------------------------------------------------
;WG_NPC335.scr
; timmy
; handles Krohn acting for cutscene
;--------------------------------------------------

#include globals.inc


#String    Params          
#String    sound
#number                         KeyCheck
;Parameters
;P0 name of wav file
;P1 name of animation to run
;P2  # of times animation runs

; flag variables
#number							Visible = 1
#number							Solid   = 8192
#number							Gravity = 131072


;--------------------------------------------------
:Loop
;--------------------------------------------------


getmyhandle g_hobject
HidePiece spear
clearflag g_hobject, visible
clearflag g_hobject, solid
clearflag g_hobject, gravity
exit

;--------------------------------------------------
:OnStart
;--------------------------------------------------

getmyhandle g_hobject
setflag g_hobject, visible
setflag g_hobject, solid
setflag g_hobject, gravity
Loopanim stand 0 DoNothing
exit

;-------------------------------------
:OnArrive
;-------------------------------------
getparam 0 g_hobject
target g_hobject
wait 1 1 StartTalk
exit

;-------------------------------------
:StartTalk
;-------------------------------------

getobjecthandle WinMan g_hobject
Trigger g_hobject Hanndl1
exit

;-------------------------------------
:OnKrohn1
;-------------------------------------

PlayAnim Krohn01 DoNothing
;"Excellent.  They will hold..."
wait 1 4 Hanndl2
exit

;-------------------------------------
:OnVoice1
;-------------------------------------

Playsound voices\cinema\wingame\Krohn01.wav, DoNothing, 100, 240000, FALSE, 100
exit

;-------------------------------------
:OnKrohn2
;-------------------------------------
wait 1 1 Speak02
exit

;-------------------------------------
:Speak02
;-------------------------------------

PlayAnim Krohn02 DoNothing
;"And What is it you wanted to say?"
wait 1 2 Hanndl3
exit

;-------------------------------------
:OnVoice2
;-------------------------------------

Playsound voices\cinema\wingame\Krohn02.wav, DoNothing, 100, 240000, FALSE, 100
exit

;-------------------------------------
:OnKrohn3
;-------------------------------------
wait 1 1 Speak03
exit

;-------------------------------------
:Speak03
;-------------------------------------

PlayAnim Krohn03 DoNothing
;"You begin to overstep you lattitude..."
wait 1 3 hanndl4
exit

;-------------------------------------
:OnVoice3
;-------------------------------------

Playsound voices\cinema\wingame\Krohn03.wav, DoNothing, 100, 240000, FALSE, 100
exit

;-------------------------------------
:OnKrohn4
;-------------------------------------

wait 1 3 speak04
exit

;-------------------------------------
:Speak04
;-------------------------------------

PlayAnim Krohn04 DoNothing
;"I think you've grown..."
wait 1 3 Speak04b
exit

;-------------------------------------
:OnVoice4
;-------------------------------------

Playsound voices\cinema\wingame\Krohn04.wav, DoNothing, 100, 240000, FALSE, 100
exit

;-------------------------------------
:Speak04b
;-------------------------------------

getobjecthandle winman g_hobject
trigger g_hobject HanndlClose
wait 1 2.5 Speak04c
exit
;-------------------------------------
:Speak04c
;-------------------------------------


getobjecthandle winman g_hobject
trigger g_hobject KrohnClose
PlayAnim Krohn05 DoNothing
;"..Perhaps though you are right..."
wait 1 21 Hanndl5
wait 2 18.5 KrohnEver
exit

;-------------------------------------
:OnVoice5
;-------------------------------------

Playsound voices\cinema\wingame\Krohn05.wav, DoNothing, 100, 240000, FALSE, 100
exit


;-------------------------------------
:KrohnEver
;-------------------------------------

getobjecthandle winman g_hobject
trigger g_hobject Ever
exit

;-------------------------------------
:OnKrohn5
;-------------------------------------


;PlayAnim Krohn06 DoNothing
PlayAnim SC7_22_Krohn DoNothing
;"The next time they return, gatekeeper..."
wait 1 4 Hanndl6
exit

;-------------------------------------
:OnVoice6
;-------------------------------------

Playsound voices\cinema\wingame\Krohn06.wav, DoNothing, 100, 240000, FALSE, 100
exit


;-------------------------------------
:OnKrohn6
;-------------------------------------

Playsound voices\cinema\wingame\Krohn07.wav, DoNothing, 100, 240000, FALSE, 100
;"It is their true Writ of Fate"
wait 1 5 OnKrohn7
exit



;-------------------------------------
:OnKrohn7
;-------------------------------------


getobjecthandle winman g_hobject
trigger g_hobject End
exit

;-------------------------------------
:Hanndl2
;-------------------------------------

getobjecthandle WinMan g_hobject
Trigger g_hobject Hanndl2
exit


;-------------------------------------
:Hanndl3
;-------------------------------------

getobjecthandle WinMan g_hobject
Trigger g_hobject Hanndl3
exit


;-------------------------------------
:Hanndl4
;-------------------------------------

getobjecthandle WinMan g_hobject
Trigger g_hobject Hanndl4
exit

;-------------------------------------
:Hanndl5
;-------------------------------------

getobjecthandle WinMan g_hobject
Trigger g_hobject Hanndl5
exit

;-------------------------------------
:Hanndl6
;-------------------------------------

getobjecthandle WinMan g_hobject
Trigger g_hobject Hanndl6
exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!

Gosub Loop
AddTrigger Arrive OnArrive
AddTrigger Start OnStart
AddTrigger Stop Loop
Addtrigger krohn1 OnKrohn1
AddTrigger Krohn2 OnKrohn2
Addtrigger krohn3 OnKrohn3
AddTrigger Krohn4 OnKrohn4
Addtrigger krohn5 OnKrohn5
AddTrigger Krohn6 OnKrohn6
Addtrigger krohn7 OnKrohn7

AddModelKey Voice1 OnVoice1
AddModelKey Voice2 OnVoice2
AddModelKey Voice3 OnVoice3
AddModelKey Voice4 OnVoice4
AddModelKey Voice5 OnVoice5
AddModelKey Voice6 OnVoice6
;AddModelKey Voice7 OnVoice7
exit

