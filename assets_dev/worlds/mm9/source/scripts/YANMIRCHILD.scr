;-----------------------------------------------------------
;	YanmirChild.Scr
;
; edited by Bones -- 4/20/03, 6/12/03
; TELP Patch 1.3 -- cries for help harder to miss
;		children will routinely look for exit
;-----------------------------------------------------------
#include FollowPlayer.inc
#include baseDoor.inc

#number		nTemp = 0
#number		ESCAPE_RADIUS = 64

#string		sEscapeName = ""
#hobject	hEscape = 0

;-----------------------------------------------------------
:Main
;-----------------------------------------------------------
	GetParam 0, sEscapeName

	SetConsoleNumVar YANMIR_CHILD_HELP, 0

	OnPostStartWorld InitYanmirChild
	OnPostMiniSaveLoad InitYanmirChild

	Exit TRUE

;-----------------------------------------------------------
:InitYanmirChild
;-----------------------------------------------------------
	AddTrigger use, OnUse

	OnFoundPlayer ShoutForHelp

	SetIdle

	Exit TRUE

;-----------------------------------------------------------
:OnUse
;	only follow if they unlocked the cage
;-----------------------------------------------------------
	HasKey 7001, nTemp
	if( nTemp==TRUE )
		gosub BaseDoorInit
		gosub FollowInit
		gosub FollowStart
		OnStuckDone	FollowStart
	else
;;		RolloverText 200, 1, 4000, 3000
	endif

	Exit FALSE

;-----------------------------------------------------------
:ShoutForHelp
;	to text to tell the player "Help!"
;-----------------------------------------------------------
	GetConsoleNumVar YANMIR_CHILD_HELP, nTemp
	if( nTemp==0 )
		SetConsoleNumVar YANMIR_CHILD_HELP, 1
		HasKey 7001, nTemp
		if( nTemp==TRUE )
			RolloverText 201 0
		else
			RolloverText 200 0
		endif
	endif

	Exit TRUE

;-----------------------------------------------------------
:OnFollowDone
;	check to see if near escape point
;-----------------------------------------------------------
;	if( hEscape==0 )
		GetObjectHandle sEscapeName, hEscape
;	endif

	if( hEscape!=0 )
		AIGetDistance hEscape, nTemp
		if( nTemp<ESCAPE_RADIUS )
			gosub EscapeLevel
		endif
	endif

	Exit TRUE
	
;-----------------------------------------------------------
:EscapeLevel
;	run to teleporter
;-----------------------------------------------------------
;	if( hEscape!=0 )
		RunToPos 6528 71 279 0 Escape
		OnObstacle Escape
;	endif

	Exit TRUE

;-----------------------------------------------------------
:Escape
;	disappear
;-----------------------------------------------------------
	Stop
	hEscape = NULL
	GetMyHandle hEscape
	RemoveObject hEscape

	Exit TRUE