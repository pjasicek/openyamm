;--------------------------------------------------
;NPC244.scr
; timmy
; handles Bikki Yrsadotir voice and quest stuff
;--------------------------------------------------

#include globals.inc


#String    Params          
#String    sound
#number                         KeyCheck
;Parameters
;P0 name of wav file
;P1 name of animation to run
;P2  # of times animation runs

;--------------------------------------------------
:OnRude
;--------------------------------------------------

Gosub Prize


exit





;--------------------------------------------------
:Prize
;--------------------------------------------------
;****************
;Prize Quest
;****************

Haskey 186, keycheck
if (keycheck==0, )
; checks to see if they already have got the reward.
	Haskey 95, g_ntemp
	if (g_ntemp==1, )
	; checks to see if they've given the prize
		GiveKey 186
		GiveExp 53000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
		TakeItem 395
		; gives reward

		exit
	endif
endif

exit


;End Prize Quest
;******************
exit




;--------------------------------------------------
:OnUse
;--------------------------------------------------

Playsound voices\NPC\NPC_244.wav, Onexit, 100, 240, FALSE, 100
exit

;-------------------------------------
:OnExit
;-------------------------------------

exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!


OnRudeExit OnRude

Addtrigger Use, OnUse

exit

