;----------------------------------------------
;Arena.scr
; By Timmy
; gives the player the key for killing 5 monsters in arena
; 11/29/01
;----------------------------------------------

#include globals.inc
#include Pickmon.inc

#number							nMonsterA_Level
#number							nMonsterB_Level

#number							nPlayerLevel
#number							nNumberMonsters
#number							nMonstersDead = 0
#number							nArenaReward


#string							sMonsterA
#string							SMiniMonsterA
#string							sMonsterB
#string							SMiniMonsterB



#hobject						hMonsterA
#hobject						hMonsterB

#number							XPos
#number							YPos
#number							ZPos

#number							nMinLevel = 1
#number							nMaxLevel = 89

#string							SCRIPT = " ScriptName ArenaFightPlayer.scr"


#number							bWaitingForPlayer

;-------------------------------------
:OnPage
;-------------------------------------

SetConsoleNumVar WaitingForPlayer,TRUE

nMinLevel = nPlayerLevel * .8
nMaxLevel = nPlayerLevel * 1.3
if (nPlayerLevel>89)
	set nMaxLevel 89
endif

if (nPlayerlevel<4)
	nMaxLevel = 4
endif

gosub Clearmon

getrandomInt 1, 2 nNumberMonsters
nArenaReward = nNumberMonsters * nPlayerLevel
nArenaReward = nArenaReward * 20


getrandomint nMinLevel, nMaxLevel g_ntemp
gosub pickmonster

if (nMonster_Level<nMinLevel)
	Goto OnPage
	exit
endif

if (nMonster_Level>nMaxLevel)
	Goto OnPage
	exit
endif

sMonsterA = sMonster_Temp + Script
getobjecthandle marker0 g_hobject
getpos g_hobject XPos YPos ZPos
Spawn g_hobject Xpos YPos ZPos sMonsterA


if (nMonsterNumber>1)
	getrandomint nMinLevel, nMaxLevel g_ntemp
	gosub pickmonster

	if (nMonster_Level<nMinLevel)
		Goto OnPage
		exit
	endif

	if (nMonster_Level>nMaxLevel)
		Goto OnPage
		exit
	endif

	sMonsterB = sMonster_Temp + Script
	getobjecthandle marker1 g_hobject
	getpos g_hobject XPos YPos ZPos
	Spawn g_hobject Xpos YPos ZPos sMonsterB
endif

getobjecthandle RotatingDoor3 g_hobject
trigger g_hobject use

getobjecthandle RotatingDoor4 g_hobject
trigger g_hobject use

exit

