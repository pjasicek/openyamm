;-------------------------------------
:End
;-------------------------------------

Screenfadeout 1


giveitem 394
wait 1 3 Release
exit

;-------------------------------------
:Release
;-------------------------------------

;load Arslegard here
getobjecthandle WG_Scene7Cam11 g_hobject
trigger g_hobject Off
getobjecthandle Skraelos0 g_hobject
trigger g_hobject stop
getobjecthandle Krohn g_hobject
trigger g_hobject stop
getobjecthandle Hanndl g_hobject
trigger g_hobject stop
getobjecthandle Krohn0 g_hobject
trigger g_hobject start
Letterbox False
screenfadein 1
DoHighScore
exit

;-------------------------------------
:Init
;-------------------------------------

if (sPart!=Part2)
	exit
endif

hasitem 394 g_ntemp
if (g_ntemp==TRUE)
	exit
endif

haskey 109 g_ntemp
if (g_ntemp==FALSE)
	exit
endif

wait 1 .1 OnKrohn
exit

;-------------------------------------
:Main
;-------------------------------------

;TraceOn ;delete me!!
getparam 0 sPart

AddTrigger Use, OnUse
AddTrigger NjamCamDone OnNjamCamDone
Addtrigger HandDone ONHandDone
AddTrigger BallStart OnBallStart
AddTrigger CameraSwitch OnCameraSwitch
AddTrigger CameraSwitch2 OnCameraSwitch2
Addtrigger Frozen OnFrozen
AddTrigger Panup OnPanUp
AddTrigger CutTo OnCutTo
Addtrigger Krohn OnKrohn
;Addtrigger Start ONForceStart
AddTrigger CutToKrohn OnKrohnCut

Addtrigger krohn1 OnKrohn1
AddTrigger Krohn2 OnKrohn2
Addtrigger krohn3 OnKrohn3
AddTrigger Krohn4 OnKrohn4
Addtrigger krohn5 OnKrohn5
AddTrigger Krohn6 OnKrohn6
Addtrigger krohn7 OnKrohn7
Addtrigger krohnClose OnKrohnClose
AddTrigger Ever OnEver



Addtrigger Hanndl1 OnHanndl1
Addtrigger Hanndl2 OnHanndl2
Addtrigger Hanndl3 OnHanndl3
Addtrigger Hanndl4 OnHanndl4
Addtrigger Hanndl5 OnHanndl5
Addtrigger Hanndl6 OnHanndl6
Addtrigger HanndlClose OnHanndlClose

AddTrigger switch onSwitch

AddTrigger End End

OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
wait 1 .4 Init


exit


;-------------------------------------
:Init
;	overloaded -- Bones
;-------------------------------------

haskey 108 g_bTemp
if g_bTemp == FALSE
	getobjecthandle FoyerDoorSouth1 g_hobject
	trigger g_hobject close
	trigger g_hobject lock
	getobjecthandle FoyerDoorSouth2 g_hobject
	trigger g_hobject close
	trigger g_hobject lock
	exit
else
	getobjecthandle FoyerDoorSouth1 g_hobject
	trigger g_hobject unlock
	getobjecthandle FoyerDoorSouth2 g_hobject
	trigger g_hobject unlock
	goto Init, 1
endif
	