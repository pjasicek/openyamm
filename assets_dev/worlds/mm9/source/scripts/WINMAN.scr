;----------------------------------------------
;WinMan.scr
; By Timmy
; 11/16
; Manager for the WinGame Cutscene
;
; edited by Bones 04/29/03
; TELP Patch 1.3 -- moved givekey 109 to WG_NJAMCAM.SCR
;	protected switch from access through wall
;	prevented access to last sequence without quest
;----------------------------------------------

#include globals.inc 

#number		HanndlCounter
#string		sPart
#number		bUp = FALSE

#number				bSafeToStart

#numberArray		g_hMonsterArray[10]
#number				g_nMonsterCount

;-------------------------------------
:OnUse
;-------------------------------------

GetPlayerHandle g_hPlayer
GetPos g_hPlayer g_posX g_posY g_posZ
if g_posZ < -3680
	exit
endif

haskey 108 g_ntemp
if (g_ntemp==FALSE)
	
	Gosub OnSwitch
	getobjecthandle Lightning1 g_hobject
	trigger g_hobject On
	getobjecthandle Lightning2 g_hobject
	trigger g_hobject On
	Wait 1 7 OnLightningOff
	exit
endif

gosub OnSwitch

haskey 109 g_ntemp
if (g_ntemp==false)
	GiveExp 234000
endif

Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
gosub DestroyMonsters

;Camera
ScreenFadeOut 1
Playsound \Sounds\magic\Windup10.wav, DoNothing, 100, 24000, FALSE, 100
wait 1 2 OnStart
exit

;-------------------------------------
:onSwitch
;-------------------------------------
	if (bUp==FALSE)
		Playsound \Sounds\door\cell_door_close.wav, DoNothing, 100, 24000, FALSE, 100
		Playanim up DoNothing
		set bUp TRUE
	else
		Playsound \Sounds\door\cell_door_close.wav, DoNothing, 100, 24000, FALSE, 100
		PlayAnim Down DoNothing
		set bUp FALSE
	endif

	exit

;--------------------------------------------------
:DestroyMonsters
;--------------------------------------------------

;traceon

set g_ntemp, 0

GetObjects AIBase, 1024, 10, g_hMonsterArray, g_nMonsterCount

if (g_nMonsterCount==0)
	exit
endif

	while ( g_nTemp < g_nMonsterCount )

		ArrayGet g_hMonsterArray, g_nTemp, g_hObject
		isclass g_hObject NjamtheMeddler g_btemp

		if (g_btemp!=TRUE)

			removeobject g_hobject

		endif

		g_nTemp = g_nTemp + 1

		if (g_ntemp > 10 )
			exit
		endif

	endwhile

;traceoff
exit

;-------------------------------------
:OnLightningOff
;-------------------------------------


getobjecthandle Lightning1 g_hobject
trigger g_hobject Off
getobjecthandle Lightning2 g_hobject
trigger g_hobject Off
exit


;-------------------------------------
:OnStart
;-------------------------------------

getobjecthandle NjamCam g_hobject 
;trigger g_hobject On
trigger g_hobject Play


getobjecthandle Njam g_hobject 
trigger g_hobject chase

exit

;-------------------------------------
:OnNjamCamDone
;-------------------------------------
getobjecthandle NjamCam g_hobject 
trigger g_hobject Off


getobjecthandle WG_Shot2Cam g_hobject 
trigger g_hobject On
trigger g_hobject play
exit


;-------------------------------------
:OnHandDone
;-------------------------------------

getobjecthandle WG_Shot2Cam g_hobject 
trigger g_hobject Off

getobjecthandle WG_Shot3Cam g_hobject 
trigger g_hobject On
getobjecthandle Njam g_hobject
trigger g_hobject Panic
Playsound \Sounds\spells\Armsofearth01.wav, DoNothing, 100, 24000, FALSE, 100
exit

;-------------------------------------
:OnCameraSwitch
;-------------------------------------

getobjecthandle WG_Shot3Cam g_hobject 
trigger g_hobject Off

getobjecthandle WG_Shot4Cam g_hobject 
trigger g_hobject On

exit


;-------------------------------------
:OnCameraSwitch2
;-------------------------------------

getobjecthandle WG_Shot4Cam g_hobject 
trigger g_hobject Off

getobjecthandle WG_Shot5Cam g_hobject 
trigger g_hobject On
trigger g_hobject Play

exit

;-------------------------------------
:OnBallStart
;-------------------------------------

exit

;-------------------------------------
:OnFrozen
;-------------------------------------

ScreenFadeOut 1

wait 1 2 OnFinish
exit

exit

;-------------------------------------
:OnFinish
;-------------------------------------

getobjecthandle WG_Shot5CamB g_hobject 
trigger g_hobject Off


getobjecthandle WG_Shot7Cam g_hobject
trigger g_hobject On
Trigger g_hobject Play 

exit



;-------------------------------------
:OnPanUp
;-------------------------------------

getobjecthandle WG_Shot5Cam g_hobject 
trigger g_hobject Off

getobjecthandle WG_Shot6Cam g_hobject 
trigger g_hobject On

wait 1 .6 OnPanReturn
exit

;-------------------------------------
:OnPanReturn
;-------------------------------------

getobjecthandle WG_Shot6Cam g_hobject 
trigger g_hobject Off

getobjecthandle WG_Shot5Cam g_hobject 
trigger g_hobject On

wait 1 3 LightingCamera2
exit

;-------------------------------------
:LightingCamera2
;-------------------------------------

getobjecthandle WG_Shot5Cam g_hobject 
trigger g_hobject Off

getobjecthandle WG_Shot5CamB g_hobject 
trigger g_hobject On
exit

;-------------------------------------
:OnCutTo
;-------------------------------------
Screenfadeout 2
wait 1 2 ChangeLevel
exit


;-------------------------------------
:ChangeLevel
;-------------------------------------
;getobjecthandle WG_Shot7Cam g_hobject
;trigger g_hobject Off
;Letterbox False
getobjecthandle ExitTrigger1 g_hobject
trigger g_hobject trigger
;screenfadein 1
exit

;-------------------------------------
:OnKrohn
;-------------------------------------

;Screenfadeout 1
Letterbox True
wait 1 1 StartPart2
exit

;-------------------------------------
:StartPart2
;-------------------------------------

getobjecthandle Skraelos0 g_hobject
trigger g_hobject start
getobjecthandle Krohn g_hobject
trigger g_hobject start
getobjecthandle Hanndl g_hobject
trigger g_hobject start
getobjecthandle Krohn0 g_hobject
trigger g_hobject stop


getobjecthandle WG_Scene7Cam1 g_hobject
trigger g_hobject On
trigger g_hobject play
getobjecthandle Hanndl g_hobject
trigger G_hobject action
screenfadein 1
exit

;-------------------------------------
:OnKrohnCut
;-------------------------------------



Screenfadeout .5
getobjecthandle WG_Scene7Cam1 g_hobject
trigger g_hobject Off
getobjecthandle WG_Scene7Cam2 g_hobject
trigger g_hobject On
trigger g_hobject play
screenfadein 1
screenfadein 1
wait 1 3.5 KrohnCut
exit

;-------------------------------------
:KrohnCut
;-------------------------------------

getobjecthandle WG_Scene7Cam2 g_hobject
trigger g_hobject Off
getobjecthandle WG_Scene7Cam3 g_hobject
trigger g_hobject On
trigger g_hobject play
exit

;-------------------------------------
:OnHanndl1
;-------------------------------------


getobjecthandle WG_Scene7Cam3 g_hobject
trigger g_hobject Off
getobjecthandle WG_Scene7Cam4 g_hobject
trigger g_hobject On
getobjecthandle hanndl g_hobject
trigger g_hobject Hanndl1
exit


