;--------------------------------------------------
;NPC213.scr
; timmy
; handles Robert's speech
;--------------------------------------------------





#include globals.inc
#include basewander.inc

#string			Sound
#number			nKey

; flag variables
#number							Visible = 1
#number							Solid   = 8192
#number							Gravity = 131072

;--------------------------------------------------
:OnStop
;--------------------------------------------------
stop
Loopanim stand 0 DoNothing
exit

;--------------------------------------------------
:OnSpeak2
;--------------------------------------------------

Loopanim conv1 0 DoNothing
Playsound voices\cinema\BobandDoug\02.wav, DoNothing, 100, 2400, FALSE, 100
wait 1 3, Trigger3
exit


;--------------------------------------------------
:Trigger3
;--------------------------------------------------

gosub Onstop
getobjecthandle Douglas g_hobject
trigger g_hobject Speak3
exit


;--------------------------------------------------
:OnSpeak4
;--------------------------------------------------

Loopanim conv1 0 DoNothing
Playsound voices\cinema\BobandDoug\04.wav, DoNothing, 100, 2400, FALSE, 100
wait 1 3.8, Trigger5
exit


;--------------------------------------------------
:Trigger5
;--------------------------------------------------

gosub Onstop
getobjecthandle Douglas g_hobject
trigger g_hobject Speak5
exit



;--------------------------------------------------
:OnSpeak6
;--------------------------------------------------

Loopanim conv1 0 DoNothing
Playsound voices\cinema\BobandDoug\06.wav, DoNothing, 100, 2400, FALSE, 100
wait 1 2, Trigger7
exit


;--------------------------------------------------
:Trigger7
;--------------------------------------------------

gosub Onstop
getobjecthandle Douglas g_hobject
trigger g_hobject Speak7
exit

;--------------------------------------------------
:OnSpeak8
;--------------------------------------------------

Loopanim conv1 0 DoNothing
Playsound voices\cinema\BobandDoug\08.wav, DoNothing, 100, 2400, FALSE, 100
wait 1 4, Trigger9
exit


;--------------------------------------------------
:Trigger9
;--------------------------------------------------

gosub Onstop
getobjecthandle Douglas g_hobject
trigger g_hobject Speak9
exit

;--------------------------------------------------
:OnTarget
;--------------------------------------------------

getparam 0 g_hTarget
target g_htarget
exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!


Addtrigger Speak2 OnSpeak2
AddTrigger Speak4 OnSpeak4
Addtrigger Speak6 OnSpeak6
AddTrigger Speak8 OnSpeak8
Addtrigger Target OnTarget

exit

