;----------------------------------------------
;Forstenigmainline.scr
; By Timmy
; checks to see if the player has disabled ft stening's defenses
;

;----------------------------------------------

#include globals.inc 

#number                         KeyCheck


;-------------------------------------
:Onuse
;NOTE this script just completes the quest right now.
; this is the routine where additional functionality should go
;-------------------------------------
haskey 47 g_ntemp ;checks to see if player has done this yet

if (g_ntemp==0,  )
	
		givekey, 47 ;gives player finished quest key
		Playsound sounds\events\quest.wav, DoNothing, 100, 24000, FALSE, 100
		exit
	endif
endif
exit




;-------------------------------------
:Main
;-------------------------------------

;TraceOn ;delete me!!
AddTrigger Use, Onuse

exit