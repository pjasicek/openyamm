	Set g_nFollowPathLoops			1
	gosub FollowPath	

	AddTrigger StartLich, DoNothing

	Exit   


;------------------------------------------
:OnPendulumDone
;------------------------------------------
	 ;do whatever here then continue
	 DebugOut In OnPendulum Done
	 gosub OnStartThrone

	 Exit

;------------------------------------------
:OnThroneDone
;------------------------------------------
	 ;do whatever here then continue
	 gosub OnStartScythe

	 Exit

;------------------------------------------
:OnScytheDone
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartSaw

	 Exit

;------------------------------------------
:OnSawDone
;------------------------------------------
	 ;do whatever here then continue
	 gosub OnStartWardrobe	 

	 Exit

;------------------------------------------
:OnWardrobeDone
;------------------------------------------
	 ;do whatever here then continue
	 gosub OnStartWardrobe2	

	 Exit

;------------------------------------------
:OnWardrobe2Done
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartSconce

	 Exit

;------------------------------------------
:OnSconceDone
;------------------------------------------
	 ;do whatever here then continue 
	 gosub OnStartTreasure

	 Exit	 

;------------------------------------------
:OnTreasureDone
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartPit

	 Exit

;------------------------------------------
:OnPitDone
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartPit2

	 Exit

;------------------------------------------
:OnPit2Done
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartTrapDoor

	 Exit

;------------------------------------------
:OnTrapDoorDone
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartChasm

	 Exit

;------------------------------------------
:OnChasmDone
;------------------------------------------
	 ;do whatever here then continue	 
	 gosub OnStartLich

	 Exit


;------------------------------------------
:OnLichDone
;------------------------------------------
	 ;do whatever here then continue
	 Trigger g_hMyObject, OFF

	 Exit

;------------------------------------------
:DoNothing
;------------------------------------------
	Exit

;------------------------------------------
:Main
;	This routine is automatically run
;	at script startup...
;------------------------------------------
	
	;TraceOn

	gosub FollowPathInit

	GetMyHandle g_hMyObject
	
	AddTrigger StartPendulum,	OnStartPendulum
	AddTrigger StartThrone,		OnStartThrone
	AddTrigger StartScythe,		OnStartScythe
	AddTrigger StartSaw,		OnStartSaw
	AddTrigger StartWardrobe,	OnStartWardrobe
	AddTrigger StartWardrobe2,	OnStartWardrobe2
	AddTrigger StartSconce,		OnStartSconce
	AddTrigger StartTreasure,	OnStartTreasure
	AddTrigger StartPit,		OnStartPit
	AddTrigger StartPit2,		OnStartPit2
	AddTrigger StartTrapDoor,	OnStartTrapDoor
	AddTrigger StartChasm,		OnStartChasm
	AddTrigger StartLich,		OnStartLich	

	AddTrigger On,				OnTurnOn

	;AddTrigger FollowPathDone OnFollowPathDone

	Exit