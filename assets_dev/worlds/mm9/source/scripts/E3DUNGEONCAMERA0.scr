;----------------------------------------------------------------
;	Camera0.scr
;	John Machin
;
;		This script will move a camera down a designated marker 
;		path.
;----------------------------------------------------------------	 
#include followpath.inc
#include globals.inc

;------------------------------------------
:OnTurnOn
;------------------------------------------
	gosub OnStartPendulum

	Exit FALSE

;------------------------------------------
:OnStartPendulum
;------------------------------------------	
	SetCallBack 0, OnPendulumDone

	Set g_sFollowPathName			PendulumPath
	Set	g_nFollowPathSpeed			175
	Set g_nFollowPathDoneCallback	0
	Set g_nFollowPathLoops			1
	gosub FollowPath	

	;AddTrigger StartPendulum, DoNothing

	Exit 

;------------------------------------------
:OnStartThrone
;------------------------------------------
	SetCallBack 0, OnThroneDone

	Set g_sFollowPathName			ThronePath
	Set	g_nFollowPathSpeed			175
	Set g_nFollowPathDoneCallback	0
	Set g_nFollowPathLoops			1
	gosub FollowPath
	
	AddTrigger StartThrone, DoNothing	

	Exit 

;------------------------------------------
:OnStartScythe
;------------------------------------------
	SetCallBack 0, OnScytheDone

	Set g_sFollowPathName			ScythePath
	Set	g_nFollowPathSpeed			175
