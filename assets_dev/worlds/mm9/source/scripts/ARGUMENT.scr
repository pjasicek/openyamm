;----------------------------------------------
;Argument.scr
; By Timmy
; handles XP for stopping the war
;
; edited by Bones 7/16/02, 5/29/03
; TELP Patch 1.3 -- Ensures Yrsa's errand is given.
;		Prevents proceeding to cutscene in TB mode.
;----------------------------------------------

#include globals.inc 


#number  keycheck

#number			nCamCount
#number			nStarted = 0

#hobject		hSven
#hobject		hBjarni
#hobject		hSigmund
#hobject		hMarkel
#hobject		hTryygva
#hobject		hKira
#hobject		hForad

;-------------------------------------
:OnUse
;-------------------------------------
Haskey 184 g_ntemp
if (g_ntemp==1, )
	DoRude 1
	Playsound voices\NPC\NPC_001.wav, DoNothing, 100, 24000, FALSE, 100
	exit
endif
gosub War

exit


;-------------------------------------
:War
; gives reward for viewing cutscene
;-------------------------------------


Haskey 184 g_ntemp
if (g_ntemp==0, )
	GiveKey 184
	GiveKey 40
	givekey 85
	GiveExp 26500
	Playsound sounds\events\quest.wav, DoNothing, 100, 24000, FALSE, 100
	takeitem 401
	; gives reward

	givekey 93
	; Yrsa's errand

	exit
endif
exit


;-------------------------------------
:OnRude
; this is for Yrsa after the arguement
;-------------------------------------

Haskey 185 g_ntemp
if (G_ntemp==0, )
	Haskey 93 g_ntemp
	if (g_ntemp==1, )
		;this is where Forad is removed from the party
;		GiveExp 16000
		Playsound sounds\events\quest.wav, DoNothing, 100, 24000, FALSE, 100
		givekey 185

		exit
	endif
endif
exit


;-------------------------------------
:ForceStart
;-------------------------------------

if (nStarted==TRUE)
	exit
endif

	getobjecthandle Sven hSven
	getobjecthandle Bjarni hBjarni
	getobjecthandle Sigmund hSigmund
	getobjecthandle Markel hMarkel
	getobjecthandle Tryygva hTryygva
	getobjecthandle Kira hKira
	getobjecthandle Forad hForad
;letterbox true
;set ncamcount 18
;gosub Bjarni16
	gosub OnStart
	exit

;-------------------------------------
:Init
;-------------------------------------

haskey 40 g_ntemp
if (g_ntemp==TRUE)
	exit
endif


set g_ncounter, 0



haskey 90 g_ntemp
if (g_ntemp==TRUE)
	add g_ncounter, 1
endif

haskey 91 g_ntemp
if (g_ntemp==TRUE)
	add g_nCounter, 1
endif

if (g_nCounter==2)

	if (nStarted==TRUE)
		exit
	endif

	getobjecthandle Sven hSven
	getobjecthandle Bjarni hBjarni
	getobjecthandle Sigmund hSigmund
	getobjecthandle Markel hMarkel
	getobjecthandle Tryygva hTryygva
	getobjecthandle Kira hKira
	getobjecthandle Forad hForad

	gosub OnStart
	exit
endif

exit


;-------------------------------------
:OnStart
;-------------------------------------

IsTurnBased g_nTemp
if g_nTemp == TRUE
	ScreenFadeOut 1
	RollOverText 18 0
	wait 0 1 OnStart
	Exit
endif

set nStarted, TRUE
removetrigger start
set nCamCount, 0
screenfadeout 1
wait 1 1 FadeIn
exit

;-------------------------------------
:FadeIn
;-------------------------------------

letterbox true
getobjecthandle Camera0 g_hobject
trigger g_hobject On
Trigger g_hobject Play
screenfadein 1
;wait 1 1 ShootOn
exit

;-------------------------------------
:Cam1
;-------------------------------------

screenfadeout .5
wait 1 .5 Cam2B
exit

;-------------------------------------
:Cam2b
;-------------------------------------

getobjecthandle Camera0 g_hobject
trigger g_hobject Off
getobjecthandle Camera1 g_hobject
trigger g_hobject On
screenfadein .5

getobjecthandle KiraCold g_hobject
trigger g_hobject KillMarkel
RemoveNPC 2 g_hobject

trigger hBjarni Shot1A

exit

;-------------------------------------
:Cam2
;-------------------------------------

getobjecthandle Camera1 g_hobject
trigger g_hobject Off
getobjecthandle Camera11 g_hobject
trigger g_hobject On

trigger hSigmund Shot1A
wait 1 4 Cam2c
exit

;-------------------------------------
:Cam2c
;-------------------------------------

getobjecthandle Camera11 g_hobject
trigger g_hobject Off
getobjecthandle Camera2 g_hobject
trigger g_hobject On

;itrigger hSigmund Shot1A
;wait 1 2 Cam2b
exit



;-------------------------------------
:Cam3
;-------------------------------------

getobjecthandle Camera2 g_hobject
trigger g_hobject Off
getobjecthandle Camera3 g_hobject
trigger g_hobject On

;trigger Bjarni and Sigmund to Shake hands

trigger hBjarni Shake
trigger hSigmund Shake
Trigger hKira Clap
trigger hMarkel Clap
trigger hSven Clap
trigger hForad Clap
trigger htryygva clap
gosub war
wait 1 4 OnMarkel

exit

