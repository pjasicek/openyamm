;--------------------------------------------------
:OnDone
;--------------------------------------------------

nCamCount = nCamCount + 1

if (nCamCount==1)
	;Bjarni signs
	Gosub Cam1
	exit
endif


if (nCamCount==2)
	;sigmund signs
	Gosub Cam2
	exit
endif


if (nCamCount==3)
	; shake hands and clap
	Gosub Cam3
	exit
endif

if (nCamCount==4)
	Gosub Cam4
	; Bjarni "Who gives a damn..."
	exit
endif

if (nCamCount==5)
	Gosub Sigmund3
	; "...I Agree with you..."
	exit
endif

if (nCamCount==6)
	Gosub Markel4
	; "What do you know about fighting..."
	exit
endif


if (nCamCount==7)
	Gosub Kira5
	; "...please go..."
	exit
endif

if (nCamCount==8)
	Gosub Forad6
	;"Don't go, we need you to stay"
	exit
endif

if (nCamCount==9)
	Gosub Kira7
;	"If he would shut up about that book of his..."
	exit
endif

if (nCamCount==10)
	Gosub Markel8
	; "Maybe it's not me.."
	exit
endif

if (nCamCount==11)
	Gosub Bjarni9
	; "watch your mouth, boy"
	exit
endif

if (nCamCount==12)
	Gosub Kira10
	;"Bjarni please,...Yesterday's beef"
	exit
endif

if (nCamCount==13)
	Gosub Markel11
	;"Is that what you think...what do you do..."
	exit
endif

if (nCamCount==14)
	Gosub Kira12
	; "I will not play this game with you..."
	exit
endif

if (nCamCount==15)
	Gosub Markel13
;	"Of course you won't...Don't know the answer..."
	exit
endif

if (nCamCount==16)
	Gosub Kira14
	;"Why don't I put my sword in your belly?"
	exit
endif

if (nCamCount==17)
	Gosub Markel15
	;"always the violence...rotten brains"
	exit
endif

if (nCamCount==18)
	Gosub Bjarni16
	; "You've done it now..."
	exit
endif

if (nCamCount==19)
	Gosub KiraStand
	; wave off Bjarni and stand
	exit
endif

if (nCamCount==20)
	Gosub OnKiraStand
	; switch to behind Kira cam wide
	exit
endif

if (nCamCount==21)
	Gosub KiraCam
	; switch to behind Markel Cam
	exit
endif

if (nCamCount==22)
	Gosub KiraCam2
	; "now may we get down to business?"
	exit
endif

if (nCamCount==23)
	Gosub Agree
	; The Jarls Agree
	exit
endif

if (nCamCount==24)
;	Gosub Forad20
	gosub end
	; "very well...a week's time"
	exit
endif


if (nCamCount==25)
	Gosub End
	; thank you for playing, and good night!
	exit
endif

exit
;-------------------------------------
:End
;-------------------------------------

gosub war
screenfadeout 1
wait 1 1 End2
exit


;-------------------------------------
:End2
;-------------------------------------


getobjecthandle Camera10 g_hobject
trigger g_hobject Off
getobjecthandle YrsatheTroll0 g_hobject
trigger g_hobject appear
letterbox false
screenfadein 1
exit

;-------------------------------------
:Main
;-------------------------------------

;TraceOn ;delete me!!

AddTrigger Done, OnDone
addtrigger ForceStart ForceStart
Addtrigger Start Init

exit