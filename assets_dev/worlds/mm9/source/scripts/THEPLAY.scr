;----------------------------------------------
;ThePlay.scr
; By Timmy
; handles robert and douglas's argument 
;

;----------------------------------------------

#include globals.inc 

; sound stuff
#number                         sound   ; checks to see if a sound is currently playing
#number							sounddur ; duration of sound
#number							sounddone ; if sound is done this is true

;actor voice handlers
#number							Narratorhandle ; handler for Narrator
#number							TrislanHandle  ;handler for Trislan
#number							AbrielHandle   ; Handle for Abriel
#number							RalofHandle   ; Handle for Ralof
#number							WilamHandle   ; Handle for Wilam
#number							LefferyHandle  ; Handle for Leffery




;ACT I


;-------------------------------------
:Onblabber
;-------------------------------------
; 



	Playsoundhandle voices\cinema\guberlandplay\01.wav, Narratorhandle, 240, FALSE, 100
	GetSoundDuration, Narratorhandle, sounddur
	Add sounddur, 1
	Wait 1 sounddur, Narrator02


exit


;-------------------------------------
:Narrator02
;-------------------------------------

KillSound Narratorhandle
Playsoundhandle voices\cinema\guberlandplay\02.wav, Narratorhandle, 240, FALSE, 100
GetSoundDuration, Narratorhandle, sounddur
Wait 1 sounddur, Trislan03
exit


;-------------------------------------
:Trislan03
