GetSoundDuration, Narratorhandle, sounddur
add sounddur, 3
Wait 1 sounddur, Onexit
exit

;-------------------------------------
:OnUse
;-------------------------------------

;if sound is playing, kill it

	KillSound Narratorhandle 
	KillSound TrislanHandle  
	KillSound AbrielHandle   
	KillSound RalofHandle   
	KillSound WilamHandle  
	KillSound LefferyHandle 

	set sound, 0
	set g_ntemp, 0

;start rude dialog
DoRude 110
exit


;-------------------------------------
:Onexit
;-------------------------------------

; kill the sound if it's done



	KillSound Narratorhandle 
	KillSound TrislanHandle  
	KillSound AbrielHandle   
	KillSound RalofHandle   
	KillSound WilamHandle  
	KillSound LefferyHandle 

exit


;-------------------------------------
