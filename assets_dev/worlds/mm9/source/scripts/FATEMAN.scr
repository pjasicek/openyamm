;----------------------------------------------
;LoseMan.scr
; By Timmy
; 12/20
;handles losegame cutscene
;----------------------------------------------

#include globals.inc 

#number		nCounter=0



#string		sVoice1
#string		sVoice2
#string		sVoice3
#string		sVoice4
#string		sVoice5
#string		sVoice6


;-------------------------------------
:OnLose
;-------------------------------------



haskey 98 g_ntemp
if (g_ntemp==TRUE)
	exit
endif

givekey 98

ScreenFadeOut 1
wait 1 2 OnStart
exit

;-------------------------------------
:OnStart
;-------------------------------------

getobjecthandle Losecam4 g_hobject 
;trigger g_hobject On
trigger g_hobject Play

exit

;-------------------------------------
:OnCam2
;-------------------------------------


ScreenFadeOut .5
getobjecthandle losecam4 g_hobject
trigger g_hobject off

getobjecthandle losecam2 g_hobject
trigger g_hobject Play
exit

;-------------------------------------
:OnCam3
;-------------------------------------


ScreenFadeOut .5
getobjecthandle losecam2 g_hobject
trigger g_hobject off

getobjecthandle losecam3 g_hobject
trigger g_hobject on
ScreenFadein .5
wait 1 1 Scene4
exit

;-------------------------------------
:Scene4
;-------------------------------------

getobjecthandle Door0 g_hobject
trigger g_hobject use
Playsound \Sounds\events\draweropenwood.wav, DoNothing, 100, 24000, FALSE, 100
wait 1 1.5 Speak9
exit

;-------------------------------------
:Speak9
;-------------------------------------

getobjecthandle hanndl g_hobject
trigger g_hobject speak9

exit

;-------------------------------------
:Close
;-------------------------------------

getobjecthandle Door0 g_hobject
trigger g_hobject use
Playsound \Sounds\events\draweropenwood.wav, DoNothing, 100, 24000, FALSE, 100
wait 1 1 FadeOut
exit

;-------------------------------------
:FadeOut
;-------------------------------------

ScreenFadeOut 1
letterbox False
wait 1 1 ExitIN
exit


;-------------------------------------
:ExitIN
;-------------------------------------

screenfadein 2
getobjecthandle ExitTrigger2 g_hobject
trigger g_hobject trigger
GiveExp 46000
Playsound sounds\events\quest.wav, DoNothing, 100, 24000, FALSE, 100
exit

;-------------------------------------
:OnPC1
;-------------------------------------

Playsound sVoice1, Trigger10, 100, 24000, FALSE, 100
;wait 1 2.5 Trigger10
exit

;-------------------------------------
:Trigger10
;-------------------------------------

getobjecthandle Hanndl g_hobject
trigger g_hobject Speak10
exit


;-------------------------------------
:OnPC2
;-------------------------------------

Playsound sVoice2, Trigger11, 100, 24000, FALSE, 100
;wait 1 3 Trigger11
exit

;-------------------------------------
:Trigger11
;-------------------------------------

getobjecthandle Hanndl g_hobject
trigger g_hobject Speak11
exit

;-------------------------------------
:OnPC3
;-------------------------------------

Playsound sVoice3, Trigger12, 100, 24000, FALSE, 100
;wait 1 3.5 Trigger12
exit

;-------------------------------------
:Trigger12
;-------------------------------------

getobjecthandle Hanndl g_hobject
trigger g_hobject Speak12
exit

;-------------------------------------
:OnPC4
;-------------------------------------

Playsound sVoice4, Trigger13, 100, 24000, FALSE, 100
;wait 1 3.5 OnPC5
exit

;-------------------------------------
:Trigger13
;-------------------------------------

getobjecthandle Hanndl g_hobject
trigger g_hobject Speak13
exit

;-------------------------------------
:OnPC5
;-------------------------------------

Playsound sVoice5, Trigger13, 100, 24000, FALSE, 100
;wait 1 3.5 Trigger13
exit



;-------------------------------------
:OnPC6
;-------------------------------------

Playsound sVoice6, Trigger15, 100, 24000, FALSE, 100
;wait 1 2.5 Trigger15
exit

;-------------------------------------
:Trigger15
;-------------------------------------

getobjecthandle Hanndl g_hobject
trigger g_hobject Speak15
exit

;-------------------------------------
:OnDone
;-------------------------------------

nCounter = nCounter + 1

if (nCounter==1)
	goto OnPC1
	exit
endif

if (nCounter==2)
	goto OnPC2
	exit
endif

if (nCounter==3)
	goto OnPC3
	exit
endif

if (nCounter==4)
	goto OnPC4
	exit
endif

if (nCounter==5)
	goto OnPC6
	exit
endif

if (nCounter==6)
	goto OnPC6
	exit
endif
exit

