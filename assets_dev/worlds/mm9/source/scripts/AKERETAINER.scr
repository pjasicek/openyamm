;----------------------------------------------
;Akeretainer.scr
; By Timmy
; handles ake the righteous's stuff
;

;----------------------------------------------

#include globals.inc 


; flag variables
#number							Visible = 1
#number							Solid   = 8192
#number							Gravity = 131072
;-------------------------------------
:Onblabber
;-------------------------------------

Playsound voices\NPC\NPC_086.wav, DoNothing, 100, 24000, FALSE, 100
exit


;--------------------------------------------------
:Init
;--------------------------------------------------
haskey 454 g_ntemp

getmyhandle g_hobject


if (g_ntemp==FALSE)
	setflag g_hobject, visible
	setflag g_hobject, solid
	setflag g_hobject, gravity
	LoopAnim sitting 0, DoNothing
else
	clearflag g_hobject, visible
	clearflag g_hobject, solid
	clearflag g_hobject, gravity
	exit
endif

exit


;-------------------------------------
:Main
;-------------------------------------

;TraceOn ;delete me!!
AddTrigger Use, Onblabber
OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
wait 1 .1 Init
exit