#number nKeyNumber = 7000

#hobject hHButton = 0
#hobject hOButton = 0
#hobject hNButton = 0
#hobject hKButton = 0
#hobject hHColumn = 0
#hobject hOColumn = 0
#hobject hNColumn = 0
#hobject hKColumn = 0

#number	nOkSooFar = 0
#number	count = 0
#hobject hSecretDoor = 0
#hobject NULL = 0
#number nHasKey = 0

:dn
exit 1



;-------------------------------------------
:OpenDoor
;-------------------------------------------

	trigger hSecretDoor open
	wait 0 20 resetbuttons

exit 1

;-------------------------------------------------------------
:resetButtons
;-------------------------------------------------------------

	nOkSooFar = 0
	count = 0
;	trigger hHButton unlock
	trigger hHColumn close
;	trigger hOButton unlock
	trigger hOColumn close
;	trigger hNButton unlock
	trigger hNColumn close
;	trigger hKButton unlock
	trigger hKColumn close

exit 1

;--------------------------------------------------------------
:hpressed
;--------------------------------------------------------------


	count = count + 1
	if ( count != 1 )
		nOkSooFar = 1
		if ( count == 4 )
			gosub resetButtons
		endif		
	endif
exit 1

;--------------------------------------------------------------
:opressed
;--------------------------------------------------------------


	count = count + 1
	if ( count != 2 )
		nOkSooFar = 1
		if ( count == 4 )
			gosub resetButtons
		endif
	endif
exit 1

;--------------------------------------------------------------
:npressed
;--------------------------------------------------------------


	count = count + 1
	if ( count != 3 )
		nOkSooFar = 1
		if ( count == 4 )
			gosub resetButtons
		endif		
	endif
exit 1

;--------------------------------------------------------------
:kpressed
;--------------------------------------------------------------


	count = count + 1
	if ( count != 4 )
		nOkSooFar = 1
	else
		if ( nOkSooFar == 1 )
			gosub resetButtons

		else
			HasKey nKeyNumber nHasKey
			if ( nHasKey = 1 )
				gosub OpenDoor
			else
				wait 0 2 resetButtons
			endif


		endif
	
	endif
	
exit 1

;--------------------------------------------------------------
:UnlockButtons
;--------------------------------------------------------------

		Trigger hHButton unlock
		Trigger hOButton unlock
		Trigger hNButton unlock
		Trigger hKButton unlock


Exit 1


;--------------------------------------------------------------
:Main2
;--------------------------------------------------------------

	GetObjectHandle HButton hHButton
	GetObjectHandle OButton hOButton
	GetObjectHandle NButton hNButton
	GetObjectHandle KButton hKButton
	GetObjectHandle HCornerStone hHColumn
	GetObjectHandle OCornerStone hOColumn
	GetObjectHandle NCornerStone hNColumn
	GetObjectHandle KCornerStone hKColumn

	GetObjectHandle secretdoor hSecretDoor
	HasKey nKeyNumber nHasKey
	if ( nHasKey = 1 )
		Trigger hHButton unlock
		Trigger hOButton unlock
		Trigger hNButton unlock
		Trigger hKButton unlock
	endif


Exit 1


;--------------------------------------------------------------
:Main
;--------------------------------------------------------------

	AddTrigger reset resetButtons

	AddTrigger UnlockButtons UnlockButtons
	AddTrigger hPressed hPressed
	AddTrigger oPressed oPressed
	AddTrigger nPressed nPressed
	AddTrigger kPressed kPressed
	Wait 0 .1 Main2



Exit 1