;--------------------------------------------------
;SkillBook.scr
;10/4
; timmy
; Triggers one prop with another

;--------------------------------------------------

#include globals.inc

#string Target
#String Message

#number	nLinked

; Parameters
;P0 The object name of the target
;P1 the trigger message to send

;--------------------------------------------------


;--------------------------------------------------
:OnUse
;--------------------------------------------------

if (nLinked==FALSE)
	exit
endif

Getobjecthandle Target g_hobject
if (g_hobject!=null)
	trigger g_hobject message
	exit
endif
exit

;--------------------------------------------------
:Init
;--------------------------------------------------

getobjecthandle Target g_hobject
if (g_hobject!=NULL)
	CreateObjectLink g_hobject
	OnObjectLinkBroken BreakLink
	set nLinked, TRUE
	exit
endif
exit

;--------------------------------------------------
:BreakLink
;--------------------------------------------------

set nLinked, FALSE
exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!
Addtrigger Use OnUse
OnTouchNotify OnUse
Getparam 0 Target
getParam 1 Message
OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
wait 1 .1 Init
exit


