;----------------------------------------------
;dolly.scr
; By Timmy
; checks to see if player is on the quest
; and gives the dolly key
; relevant RudeIDs: 89, 91, 92, 93

; key 128 = player is on yobboe promo quest
; Key 132 = player has the plow


;----------------------------------------------

#include globals.inc 

#number                         KeyCheck
#number							Keydata

; flag variables
#number							Visible = 1
#number							Solid   = 8192
#number							Gravity = 131072
;-------------------------------------
:OnUse
;-------------------------------------


Haskey 128, g_ntemp
if ( g_ntemp==1, )
;checks to see if player is on the yobboe promo quest
	Haskey 132 g_ntemp
	If ( g_ntemp==0, )
	;checks to see if player has already done this
		givekey 132
		giveitem 370
		getmyhandle g_hmyobject
		removeobject g_hmyobject
		;gives dolly key.
		exit
	endif
endif
exit
	

;-------------------------------------
:Init
;-------------------------------------

haskey 128 g_ntemp
if (g_ntemp==TRUE)
	getmyhandle g_hobject
	setflag g_hobject, visible
	setflag g_hobject, solid
	setflag g_hobject, gravity
else
	getmyhandle g_hobject
	clearflag g_hobject, visible
	clearflag g_hobject, solid
	clearflag g_hobject, gravity
endif

haskey 132 g_ntemp
if (g_ntemp==TRUE)
	getmyhandle g_hmyobject
	removeobject g_hmyobject
	exit
endif
exit

;-------------------------------------
:Main
;-------------------------------------

;TraceOn ;DELETE ME!!
Addtrigger Use, Onuse
Gosub Init

exit