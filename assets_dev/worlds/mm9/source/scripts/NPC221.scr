;--------------------------------------------------
;NPC221.scr
; timmy
; handles The Green Man voice and quest stuff
;--------------------------------------------------

#include globals.inc
#include basewander.inc

;promo variables

#number		Fighter = 0
#number		Mercenary = 1
#number		Crusader = 2
#number		Assassin = 3
#number		Gladiator = 4
#number		Ranger = 5
#number		Paladin = 6
#number		Initiate = 7
#number		Scholar = 8
#number		Healer = 9
#number		Mage = 10
#number		Lich = 11
#number		Priest = 12
#number		Druid = 13
#number		Char1 = 0
#number		Char2 = 1
#number		Char3 = 2
#number		Char4 = 3

;--------------------------------------------------
:OnRude
;--------------------------------------------------

Gosub promo


exit

;--------------------------------------------------
:Promo
;--------------------------------------------------

haskey 280 g_ntemp
if (g_ntemp==0, )
	haskey 279 g_ntemp
	if (g_ntemp==1, )
		givekey 280
		giveexp 63000
		givegold 5000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
		giveitem 213
		gosub PromoteDruid
		; givepromo
		exit
	endif
endif

exit

;--------------------------------------------------
:PromoteDruid
;
; Player has already completed the quest
; just check to see who gets promoted
;--------------------------------------------------

haskey 445 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Druid Char1
	takekey 445
endif

haskey 446 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Druid Char2
	takekey 446
endif

haskey 447 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Druid Char3
	takekey 447
endif

haskey 448 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Druid Char4
	takekey 448
endif
exit

;--------------------------------------------------
:OnUse
;--------------------------------------------------

Playsound voices\NPC\NPC_221.wav, Onexit, 100, 240, FALSE, 100
exit

;-------------------------------------
:OnExit
;-------------------------------------

exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!


OnRudeExit OnRude

Addtrigger Use, OnUse
gosub basewanderinit
exit

