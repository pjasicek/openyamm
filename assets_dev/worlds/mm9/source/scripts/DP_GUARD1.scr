;------------------------------------------------------------------
;	DP_Guard1.scr
;	Brett Yagi
;
;	Works in conjunction with IS_fickyflock.scr.
;	Generic function moves object randomly between markers in parameters
;	When given the "scatter" trigger, it will trigger the "birds"
;	specified in parameters.
;
;	Parameters
;
;	0 - Marker Root name  (ie for Markers Mrk0, Mrk1, Mrk2  "Mrk" is the root name)
;	1 - Number of Markers
;	2 - Bird Root name  (ie for Birds Bird0, Bird01, Bird02  "Bird0" is the root name)
;	3 - Number of Birds
;
;
;-----------------------------------------------------

#string		sGuardNameRoot
#string		sPrisonerNameRoot
#string		sMarkerNameRoot
#number		nNumPrisoners
#string		sMarker
#number		nCount = 0
#number		nMarker = 0
#hobject	hMarker

#string		sGuard
#hobject	hGuard
#string		sPrisoner
#hobject	hPrisoner

#string		sDoor
#hobject	hDoor
#hobject	NULL = 0

:dn

exit 1

;--------------------------------------------------------------
:LockCell
;--------------------------------------------------------------

	PlayAnim Fidget1 dn
	sGuard = sGuardNameRoot + 0
	GetObjectHandle sGuard hGuard
	Trigger hGuard CloseCellDoor
	nCount = nCount + 1
	Target NULL 0
	if nCount < nNumPrisoners
		Wait 0 2 GetPrisoner
	endif

Exit 1


;--------------------------------------------------------------
:PutPrisonerInCell
;--------------------------------------------------------------

	SetIdle
	sGuard = sGuardNameRoot + 2
	GetObjectHandle sGuard hGuard
	Trigger hGuard LockDown
	sGuard = sGuardNameRoot + 0
	GetObjectHandle sGuard hGuard
	Trigger hGuard OpenCellDoor

	sPrisoner = sPrisonerNameRoot + nCount
	GetObjectHandle sPrisoner hPrisoner
	Target hPrisoner 1
	Trigger hPrisoner GetInCell

Exit 1

;--------------------------------------------------------------
:ReturnToCell
;--------------------------------------------------------------

	nMarker = nCount * 3 + 4
	sMarker = sMarkerNameRoot + nMarker
	GetObjectHandle sMarker hMarker
	WalkTo hMarker 30 PutPrisonerInCell

Exit 1



;--------------------------------------------------------------
:GoOutside
;--------------------------------------------------------------

	Trigger hDoor unlock
	Trigger hDoor use
	nMarker = 1
	sMarker = sMarkerNameRoot + nMarker
	GetObjectHandle sMarker hMarker

	WalkTo hMarker 30 ReturnToCell

Exit 1



;--------------------------------------------------------------
:Interrogate
;--------------------------------------------------------------

	Trigger hDoor use
	Trigger hDoor lock
	playsound Sounds\wahoo.wav GoOutside 0 1000 0 30


Exit 1



;--------------------------------------------------------------
:GoInside
;--------------------------------------------------------------

	nMarker = 0
	sMarker = sMarkerNameRoot + nMarker
	GetObjectHandle sMarker hMarker

	WalkTo hMarker 20 Interrogate


Exit 1


;--------------------------------------------------------------
:WalkToIR
;--------------------------------------------------------------

	Trigger hGuard Follow
	Trigger hPrisoner Follow

	nMarker = 1
	sMarker = sMarkerNameRoot + nMarker
	GetObjectHandle sMarker hMarker

	GetObjectHandle sDoor hDoor
	Trigger hDoor unlock
	Trigger hDoor open
	WalkTo hMarker 20 GoInside


Exit 1


;--------------------------------------------------------------
:OpenCell
;--------------------------------------------------------------

	PlayAnim Fidget1 dn
	sGuard = sGuardNameRoot + 0
	GetObjectHandle sGuard hGuard
	Trigger hGuard OpenCellDoor
	sPrisoner = sPrisonerNameRoot + nCount
	GetObjectHandle sPrisoner hPrisoner
	Trigger hPrisoner ExitCell

Exit 1

;--------------------------------------------------------------
:GetPrisoner
;--------------------------------------------------------------

	nMarker = nCount * 3 + 2
	sMarker = sMarkerNameRoot + nMarker
	GetObjectHandle sMarker hMarker
	sGuard = sGuardNameRoot + 2
	GetObjectHandle sGuard hGuard
	Trigger hGuard GoToCell
	WalkTo hMarker 20 OpenCell

Exit 1

;--------------------------------------------------------------
:Main2
;--------------------------------------------------------------

; do normal shit

Exit 1

;--------------------------------------------------------------
:Main
;--------------------------------------------------------------

	GetParam 0 sGuardNameRoot
	GetParam 1 sPrisonerNameRoot
	GetParam 2 nNumPrisoners
	GetParam 3 sMarkerNameRoot
	GetParam 4 sDoor

	AddTrigger WalkToIR WalkToIR
	
	AddTrigger GetPrisoner GetPrisoner
	AddTrigger LockCell LockCell
	AddTrigger GoOutside GoOutside

	Wait 0 .1 main2


Exit 1









