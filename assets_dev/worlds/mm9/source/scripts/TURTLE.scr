;----------------------------------------------------------------
;	Turtle.scr
;	John Machin
;
;		Default script for wanderers
;----------------------------------------------------------------
#include globals.inc
#include wander.inc
#include aiglobals.inc

#hobject	hAlertedBy 
#string		sAlertName

#hobject	hAttacker
#hobject	hTouchedBy


;Passed in Parameter to get Wander distance
#number		g_nDistance

;----------------------------------------------------------------
:HandleOnAlert
;----------------------------------------------------------------
		
	GetParam 0, hAlertedBy
	GetClassName hAlertedBy, sAlertName		
																	
	Exit

;----------------------------------------------------------------
:TurtleOnDamage
;----------------------------------------------------------------		
	;Figure out who hit us
	GetParam 0, hAttacker		

	;Alert nearby AI
	SendAlert hAttacker		
																
	Exit FALSE	 	

	
;----------------------------------------------------------------
:InitTurtle
;----------------------------------------------------------------		 	
	 ;Set Rooster wander distance
	GetParam 1, g_nDistance
	
	if( g_nDistance != 0 )
		Set MAX_DIST_FROM_STARTPOINT, g_nDistance
	else
		Set MAX_DIST_FROM_STARTPOINT, 350
	endif	

	;Set how often we stop at an obstacle
	Set g_nStopAtObstacle, 2

	;Set how often we idle 1 equals 10% valid numbers are 1 to 10
	Set g_IdleFrequency, 4

	;Set max time in seconds before idle check
	Set g_IdleCheckMin, 7
	Set g_IdleCheckMax, 7

	;Set how often special anim is played valid numbers are 1 to 10
	Set g_SpecialAnimFrequency, 0

	Exit

;----------------------------------------------------------------
:Main
;----------------------------------------------------------------
		
	;Monitor these callbacks
	OnDamage		TurtleOnDamage	
	
	;Setup wandering behavior
	gosub WanderInit					

	Exit