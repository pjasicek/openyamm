;	Bran A'Norta a'leipshi	( 322 )
	ArrayPut aGroup1,0,322

;	Asvald Hrrappssen		( 328 )
	ArrayPut aGroup1,1,328

;	Marshall Hanford		( 333 )
	ArrayPut aGroup1,2,333

;	Laina Wilan				( 409 )
