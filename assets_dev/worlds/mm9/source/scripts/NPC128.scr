;--------------------------------------------------
:OnRude
;--------------------------------------------------

gosub Promocheck
Gosub Nurtigan


exit

;--------------------------------------------------
:PromoteHealer
;
; Player has already completed the quest
; just check to see who gets promoted
;--------------------------------------------------

Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
haskey 437 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Healer Char1
	takekey 437
endif

haskey 438 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Healer Char2
	takekey 438
endif

haskey 439 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Healer Char3
	takekey 439
endif

haskey 440 g_ntemp
if (g_ntemp==TRUE)
	GivePromo Healer Char4
	takekey 440
endif
exit


;--------------------------------------------------
:Promocheck
;--------------------------------------------------

haskey 206 g_ntemp
if (g_ntemp==TRUE)
	exit
endif

haskey 437 g_ntemp
if (g_ntemp==TRUE)
	givekey 206
	exit
endif

haskey 438 g_ntemp
if (g_ntemp==TRUE)
	givekey 206
	exit
endif

haskey 439 g_ntemp
if (g_ntemp==TRUE)
	givekey 206
	exit
endif

haskey 440 g_ntemp
if (g_ntemp==TRUE)
	givekey 206
	exit
endif

;--------------------------------------------------
:Nurtigan
;--------------------------------------------------
;****************
;Nurtigan Quest
;****************

haskey 213 g_ntemp
if (g_ntemp==0, )
	Haskey 212 g_ntemp
	if (g_ntemp==1, )
		givekey 213
		giveexp 24500
		givegold 1000
		Playsound sounds\events\quest.wav, DoNothing, 100, 240, FALSE, 100
		gosub PromoteHealer
		exit
	endif
endif

;End Nurtigan quest
;******************
exit




;--------------------------------------------------
:OnUse
;--------------------------------------------------


Playsound voices\NPC\NPC_128.wav, Onexit, 100, 240, FALSE, 100
exit

;-------------------------------------
:OnExit
;-------------------------------------

exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!


OnRudeExit OnRude

Addtrigger Use, OnUse

exit

