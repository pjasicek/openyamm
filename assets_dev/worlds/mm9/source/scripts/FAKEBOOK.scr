;-------------------------------------
:haskey
;-------------------------------------
haskey 281 g_ntemp
if (g_ntemp==0)
	givekey 281
	givekey 290
	giveitem 242
	getmyhandle g_hmyobject
	removeobject g_hmyobject
	exit
endif
exit


;-------------------------------------
:deletecheck
;-------------------------------------

haskey 282 g_ntemp
if (g_ntemp==1)
	getmyhandle g_hmyobject
	removeobject g_hmyobject
	exit
endif

haskey 281 g_ntemp
if (g_ntemp==1)
	getmyhandle g_hmyobject
	removeobject g_hmyobject
	exit
endif
exit
	

