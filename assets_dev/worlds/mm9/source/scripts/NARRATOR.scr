;--------------------------------------------------
;givetake.scr
;10/4
; timmy
; narrator's actions for GCity play
;
; edited by Bones -- 6/12/03
; TELP Patch 1.3 -- corrects playing of 02.wav
;--------------------------------------------------

#include globals.inc

#number			Item_ID
#number			nGiveOnce = FALSE





; Parameters
;P0 Item number of item to give


;--------------------------------------------------


;--------------------------------------------------
:OnStart
;--------------------------------------------------
SetPropNumber DoRude False
getobjecthandle curtain g_hobject
trigger g_hobject open
wait 1 2 OnStart2
exit


;--------------------------------------------------
:OnStart2
;--------------------------------------------------
Loopanim conv2 0 DoNothing
Playsound voices\cinema\guberlandplay\01.wav, DoNothing, 100, 512, FALSE, 100
wait 1 6, TriggerStart
exit


;--------------------------------------------------
:TriggerStart
;--------------------------------------------------



getobjecthandle Trislan g_hobject
trigger g_hobject Walk1

getobjecthandle Abriel g_hobject
trigger g_hobject Walk1

Loopanim conv3 0 DoNothing
Playsound voices\cinema\guberlandplay\02.wav, DoNothing, 100, 512, FALSE, 100

getobjecthandle Abriel1 g_hobject
FaceObject g_hobject 200 DoNothing
exit

;--------------------------------------------------
:OnSpeak9
;--------------------------------------------------

getobjecthandle Abriel g_hobject
Trigger g_hobject Exit
getobjecthandle Trislan g_hobject
Trigger g_hobject Exit


getobjecthandle Leffery g_hobject
Trigger g_hobject Start
getobjecthandle Ralof g_hobject
Trigger g_hobject Start
getobjecthandle Wilam g_hobject
Trigger g_hobject Start

Loopanim conv3 0 DoNothing
Playsound voices\cinema\guberlandplay\09.wav, DoNothing, 100, 512, FALSE, 100
wait 1 4 Trigger9
exit

;--------------------------------------------------
:Trigger9
;--------------------------------------------------

gosub Onstop
getobjecthandle Wilam g_hobject
trigger g_hobject Speak9
exit

;--------------------------------------------------
:OnStop
;--------------------------------------------------
stop
Loopanim stand 0 DoNothing
exit


;--------------------------------------------------
:OnSpeak21
;--------------------------------------------------

Loopanim conv1 0 DoNothing
Playsound voices\cinema\guberlandplay\21.wav, DoNothing, 100, 512, FALSE, 100
wait 1 4 Trigger22
exit



;--------------------------------------------------
:Trigger22
;--------------------------------------------------

stop
Loopanim stand 0 DoNothing
getobjecthandle Abriel g_hobject
trigger g_hobject exit
getobjecthandle Ralof g_hobject
trigger g_hobject exit
getobjecthandle Wilam g_hobject
trigger g_hobject exit
getobjecthandle Leffery g_hobject
trigger g_hobject exit
exit

;--------------------------------------------------
:OnSpeak22
;--------------------------------------------------

getobjecthandle Trislan g_hobject
trigger g_hobject Walk2
Loopanim conv1 0 DoNothing
Playsound voices\cinema\guberlandplay\22.wav, DoNothing, 100, 512, FALSE, 100
wait 2 1 Abrielwalk
wait 1 5.5 Trigger23
exit

;--------------------------------------------------
:Abrielwalk
;--------------------------------------------------

getobjecthandle Abriel g_hobject
trigger g_hobject Walk2
exit

;--------------------------------------------------
:Trigger23
;--------------------------------------------------

getobjecthandle ralof g_hobject
trigger g_hobject Walk2
wait 1 1 GuardWalk
exit

;--------------------------------------------------
:Guardwalk
;--------------------------------------------------
getobjecthandle Leffery g_hobject
trigger g_hobject Walk2
getobjecthandle Wilam g_hobject
trigger g_hobject Walk2
exit

;--------------------------------------------------
:OnSpeak27
;--------------------------------------------------

getobjecthandle peasant2 g_hobject
target g_hobject
Loopanim conv3 0 DoNothing
Playsound voices\cinema\guberlandplay\27.wav, DoNothing, 100, 512, FALSE, 100
wait 1 13 Trigger28
exit

;--------------------------------------------------
:Trigger28
;--------------------------------------------------

getobjecthandle Ralof g_hobject
trigger g_hobject CastCall
getobjecthandle Wilam g_hobject
trigger g_hobject CastCall
getobjecthandle Leffery g_hobject
trigger g_hobject CastCall
getobjecthandle Abriel g_hobject
trigger g_hobject CastCall
getobjecthandle Trislan g_hobject
trigger g_hobject CastCall
wait 1 3 Bow
exit


;--------------------------------------------------
:Bow
;--------------------------------------------------


Loopanim conv3 0 DoNothing
Playsound voices\cinema\guberlandplay\28.wav, DoNothing, 100, 512, FALSE, 100
wait 1 1 OnBow
exit

;--------------------------------------------------
:OnBow
;--------------------------------------------------

stop
Loopanim stand 0 DoNothing
getobjecthandle Ralof g_hobject
trigger g_hobject Bow
getobjecthandle Wilam g_hobject
trigger g_hobject Bow
getobjecthandle Leffery g_hobject
trigger g_hobject Bow
getobjecthandle Abriel g_hobject
trigger g_hobject Bow
getobjecthandle Trislan g_hobject
trigger g_hobject Bow
wait 1 5 Exit
exit

;--------------------------------------------------
:Exit
;--------------------------------------------------
getobjecthandle curtain g_hobject
trigger g_hobject close
getobjecthandle Ralof g_hobject
trigger g_hobject Exit
getobjecthandle Wilam g_hobject
trigger g_hobject Exit
getobjecthandle Leffery g_hobject
trigger g_hobject Exit
getobjecthandle Abriel g_hobject
trigger g_hobject Exit
getobjecthandle Trislan g_hobject
trigger g_hobject Exit
SetPropNumber DoRude TRUE
exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!
Addtrigger start, Onstart
Addtrigger stop OnStop
AddTrigger Speak9 OnSpeak9
AddTrigger Speak21 OnSpeak21
AddTrigger Speak22 OnSpeak22
Addtrigger Speak27 OnSpeak27
@m 14 : 30 OnStart
@m 16 : 30 OnStart
exit


