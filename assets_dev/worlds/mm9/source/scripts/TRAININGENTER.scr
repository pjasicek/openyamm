;--------------------------------------------------
;givetake.scr
;10/4
; timmy
; gives party specific item
;
;edited by Bones 3/27/03
; TELP Patch 1.3 -- moved reward from TRAININGHALLEXIT.SCR (all THall loads)
;		removed unnecessary PerceptionBrushes (new Thjorgard loads)
;--------------------------------------------------

#include globals.inc

#string			sLocation





; Parameters
;P0 Item number of item to give


;--------------------------------------------------



;--------------------------------------------------
:OnBreak
;--------------------------------------------------

		getobjecthandle ExitTrigger0 g_hobject
		trigger g_hobject on
		exit

;--------------------------------------------------
:Init
;--------------------------------------------------

haskey 301 g_ntemp
if (g_ntemp==TRUE)
	if (sLocation==TrainingHall)
		getobjecthandle ExitTrigger0 g_hobject
		trigger g_hobject on
	else
		getobjecthandle ExitTrigger6 g_hobject
		trigger g_hobject on
	endif
	exit
endif
exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!
getparam 0 sLocation
AddTrigger Break OnBreak
OnPostStartWorld Init
OnPostMiniSaveLoad Init
OnPostSaveLoad Init
wait 1 .1 Init
exit

;--------------------------------------------------
:OnBreak
;	overloaded
;--------------------------------------------------

Haskey 301 g_ntemp
if (g_ntemp==0)
	givekey 301
	GiveAttribute 0 5 1 
	GiveAttribute 1 5 1
	giveexp 20000
	Playsound sounds\events\quest.wav, DoNothing, 100, 5000, FALSE, 100
endif
goto OnBreak, 1

;-------------------------------------
:Init
;	overloaded -- Bones
;-------------------------------------

if (sLocation == TrainingHall)
	haskey 301 g_ntemp
	if (g_ntemp==TRUE)
		GetObjectHandle DestructableBrush12 g_hObject
		RemoveObject g_hObject
	endif
	goto Init, 1
endif

GetObjectHandle DestructableBrush7 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush6 g_hObject
	RemoveObject g_hObject
endif

GetObjectHandle DestructableBrush8 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush8 g_hObject
	RemoveObject g_hObject
endif

GetObjectHandle DestructableBrush9 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush10 g_hObject
	RemoveObject g_hObject
endif

GetObjectHandle DestructableBrush10 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush11 g_hObject
	RemoveObject g_hObject
endif

GetObjectHandle DestructableBrush11 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush7 g_hObject
	RemoveObject g_hObject
endif

GetObjectHandle DestructableBrush12 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush9 g_hObject
	RemoveObject g_hObject
endif

GetObjectHandle DestructableBrush13 g_hObject
if g_hObject == 0
	GetObjectHandle PerceptionBrush5 g_hObject
	RemoveObject g_hObject
endif

goto Init, 1