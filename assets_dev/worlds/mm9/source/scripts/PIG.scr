;----------------------------------------------------------------
;	pig.scr
;	John Machin
;
;		Default script for wanderers
;---------------------------------------------------------------- 
#include globals.inc
#include wander.inc

#hobject	hAttacker

#number		g_nDistance

#number		g_nLastDamage

;----------------------------------------------------------------
:OnSpecial
;----------------------------------------------------------------
	;GetRandomInt 1, 10, g_nRandom	
	;LoopAnim sit, g_nRandom, OnSpecialDone
	if( g_nRandom < 3 )
		;We will sit and rest
		PlayAnim Standdown, OnStandDownRestDone
	else
		PlayAnim Standdown, OnStandDownRollDone
	endif	

	Exit

;----------------------------------------------------------------
:OnStandDownRestDone
;----------------------------------------------------------------
	GetRandomInt 9, 15, g_nRandom
	LoopAnim Rest, g_nRandom, OnDownDone

	Wait 0, 0, DoNothing
																	
	Exit

;----------------------------------------------------------------
:OnStandDownRollDone
;----------------------------------------------------------------		
	LoopAnim Roll, 4, OnDownRoll2Done

	Wait 0, 0, DoNothing
																	
	Exit

;----------------------------------------------------------------
:OnDownRoll2Done
;----------------------------------------------------------------	
	GetRandomInt 9, 15, g_nRandom
	LoopAnim Rest, g_nRandom, OnDownDone	

	Wait 0, 0, DoNothing
																	
	Exit

;----------------------------------------------------------------
:OnDownDone
;----------------------------------------------------------------
	PlayAnim Standup

	Wait 0, 1, WanderTick
																	
	Exit	


;----------------------------------------------------------------
:DoNothing
;----------------------------------------------------------------
	;Nothing to see here

	Exit

;----------------------------------------------------------------
:OnRun
;----------------------------------------------------------------
	
	GetFaceDir hAttacker, g_posX, g_posY, g_posZ	

	FaceDir g_PosX, g_PosY, g_PosZ

	Run	
	
	Set g_IsRunning, TRUE
	;This will cause a more erratic runniing behavior
	Set g_IdleCheckMin, 1
	Set g_IdleCheckMax, 1

	;Set turn degree min max for more erratic movement
	;Set g_TurnDegreeMin, 40
	;Set g_TurnDegreeMax, 90
													
	Exit

;----------------------------------------------------------------
:OnRunning
;----------------------------------------------------------------
	;We want to continue sending Alerts to nearby AI while running
	SendAlert hAttacker		

	Exit


;----------------------------------------------------------------
:OnStopRunning
;----------------------------------------------------------------
	;Setup our stuff back to normal
	Set g_IdleCheckMin, 7
	Set g_IdleCheckMax, 7

	Set g_TurnDegreeMin 15
	Set g_TurnDegreeMax 90

	Set g_IsRunning, FALSE

	Exit

;----------------------------------------------------------------
:PigOnDamage
;----------------------------------------------------------------
	;Figure out who hit us
	GetParam 0, hAttacker	

	;Get last damage done
	GetParam 1, g_nLastDamage

	;Alert nearby AI
	SendAlert hAttacker	

	GetTime g_StopRunTime
	Add g_StopRunTime, 15

	if( g_nLastDamage == 0 )
		gosub PigOnDamageDone
	endif
																	
	Exit FALSE


;----------------------------------------------------------------
:PigOnDamageDone
;----------------------------------------------------------------
	gosub OnRun	
																	
	Exit

;----------------------------------------------------------------
:InitPig
;----------------------------------------------------------------
	;Set the hens roaming distance
	GetParam 1, g_nDistance
	
	if( g_nDistance != 0 )
		Set MAX_DIST_FROM_STARTPOINT, g_nDistance
	else
		Set MAX_DIST_FROM_STARTPOINT, 350
	endif

	;Set how often we stop at obstacle
	Set g_nStopAtObstacle, 1

	;Set how often hen is idle 1 equals 10%
	Set g_IdleFrequency, 5

	;Set how often special anim is played valid numbers are 1 to 10
	Set g_SpecialAnimFrequency, 8

	;Set max time before idle check
	Set g_IdleCheckMin, 8
	Set g_IdleCheckMax, 8

	Exit

;----------------------------------------------------------------
:Main
;----------------------------------------------------------------
	;Initialize Pig behavior
	gosub InitPig	

	;Initialize wandering behavior
	gosub WanderInit

	;override these callbacks
	OnDamageDone	 PigOnDamageDone
	OnDamage		 PigOnDamage

	;setup these special triggers
	AddTrigger SpecialAnim,		OnSpecial
	AddTrigger StopRunning,		OnStopRunning
	AddTrigger Running,			OnRunning

	

	Exit