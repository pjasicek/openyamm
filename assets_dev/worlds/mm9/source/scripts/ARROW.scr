;--------------------------------------------------
;arrow.scr
; timmy
; Handles the arrow shooter in A2_RD1
;--------------------------------------------------

#include globals.inc 
#string					arrows=arrows
       
#Number					counter
;--------------------------------------------------
:OnUse
;--------------------------------------------------

getrandomint 1, 8, g_ntemp

if (g_ntemp==1)
	goto 1
	
endif

if (g_ntemp==2)
	goto 2
endif

if (g_ntemp==3)
	goto 3
endif

if (g_ntemp==4)
	goto 4
endif

if (g_ntemp==5)
	goto 5
endif

if (g_ntemp==6)
	goto 6
endif

if (g_ntemp==7)
	goto 7
endif

if (g_ntemp==8)
	goto 8
endif

exit

;--------------------------------------------------
:1
;--------------------------------------------------


getobjecthandle arrows1, g_hobject
if (g_hobject==null)
	debugout NULL!
	exit
endif
trigger g_hobject On
trigger g_hobject Off
exit


;--------------------------------------------------
:2
;--------------------------------------------------


getobjecthandle arrows2, g_hobject
if (g_hobject==null)
	debugout NULL!
	exit
endif
