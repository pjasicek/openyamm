;--------------------------------
;	TronPiece.scr
;	by SJR
;	12-12-01
;	Purpose:message TronGame.scr
;			when 'use'd
;--------------------------------

#string		sTronName = ""
#hobject	hTron = 0
#number		nMyIndex = 0

;--------------------------------
:Main
;--------------------------------
	GetParam 0, nMyIndex

	OnPostStartWorld InitTronPiece

	Exit 1

;--------------------------------
:InitTronPiece
;--------------------------------
	AddTrigger use,   OnUse
	AddTrigger white, TurnWhite
	AddTrigger black, TurnBlack

	GetConsoleStrVar TRON_NAME, sTronName
	GetObjectHandle sTronName, hTron

	Exit 1

;--------------------------------
:OnUse
;--------------------------------
	SetConsoleNumVar TRON_INDEX, nMyIndex

	if( hTron!=0 )
		Trigger hTron, move
	endif

	Exit 1

;--------------------------------
:TurnWhite
;--------------------------------
	SetModelFilenames "models\gibs\stone.abc", "skins\gibs\yellow.dtx"
	Exit 1

;--------------------------------
:TurnBlack
;--------------------------------
	SetModelFilenames "models\gibs\stone.abc", "skins\gibs\blue.dtx"
	Exit 1