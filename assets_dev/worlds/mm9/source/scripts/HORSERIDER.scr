;----------------------------------------------------------------
;	horserider.scr
;	John Machin
;
;		Default script for wanderers
;----------------------------------------------------------------
#include globals.inc
#include aiglobals.inc
#include wander.inc
#include base.inc

#hobject	hAlertedBy 
#string		sAlertName

;Passed in Parameter to get Wander distance
#number		g_nDistance

;Creature type ok to attack bool
#number		g_bOkAttackType			= 0

;-----
;NOTE:
;I am leaving the attack stuff in here and have it commented out.  Currently this
;model only has a walking animation.  Leaving just in case they add attack anims in
;the future
;-----


;----------------------------------------------------------------
:InitHorseRider
;----------------------------------------------------------------
	;Set Rooster wander distance
	GetParam 1, g_nDistance
	
	if( g_nDistance != 0 )
		Set MAX_DIST_FROM_STARTPOINT, g_nDistance
	else
		Set MAX_DIST_FROM_STARTPOINT, 350
	endif

	;Set how often hen is idle 1 equals 10% valid numbers are 1 to 10
	Set g_IdleFrequency, 0

	;Set max time in seconds before idle check
	;Set g_IdleCheckMin, 5
	;Set g_IdleCheckMax, 10

	;Set how often special anim is played valid numbers are 1 to 10
	Set g_SpecialAnimFrequency, 3

	Exit

;------------------------------------------
:HorseRiderAttackReady
;
;	We are now in attack range (for our
;	currently selected weapon) and ready
;	to attack.  So let's do it!
;------------------------------------------
	
	GetClassName g_hTarget, sAlertName
	if( sAlertName == HorseRider )
		Exit
	endif
	
	Set g_bFighting, TRUE

	GetTime g_nLastAttackTime

	Attack

	Exit

;----------------------------------------------------------------
:HorseRiderAlert
;----------------------------------------------------------------
		
	GetParam 0, hAlertedBy
	GetClassName hAlertedBy, sAlertName		
	
	if( g_hTarget == NULL )		
		;Check to see if the alert came from a hen or another rooster
		if( sAlertName == HorseRider )			
			Set g_bOkAttackType, 1
		endif
	endif	
	
	if( g_bOkAttackType == TRUE )		
		GetParam 1, g_hTarget
		Target g_hTarget
		gosub BaseGoGetHim
	endif	 
																	
	Exit



;----------------------------------------------------------------
:Main
;----------------------------------------------------------------
	
	;Initialize Horserider
	gosub InitHorseRider	

	;Initialize Attack Behavior
	;gosub InitBase

	;Initialize Wander Behavior
	gosub WanderInit
	
	;Override these Base Calls
	OnAlert			HorseRiderAlert
	OnAttackReady	HorseRiderAttackReady
	
	;Monitoring this with no function will keep the AI from looking for players
	OnFoundPlayer
	
	

	Exit