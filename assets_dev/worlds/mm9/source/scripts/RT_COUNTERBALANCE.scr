;-----------------------------------------------------
;
;	RT_CounterBalance.scr
;
;	Karl Drown 11-13-01
;	Super simple "Move My World Object" script.
;	
;	
;-----------------------------------------------------

#include Globals.inc
#include Flags.inc

#hObject	hMarker
#hObject	hCrypt
#hObject	hDummy
#hObject	hMe

#number		nVarX
#number		nVarY
#number		nVarZ
;-----------------------------------------------------
:StopHere
;-----------------------------------------------------
	playsound Sounds\Door\doorslammetal01.wav DoNothing hDummy 400 FALSE 100
	hCrypt = NULL
	GetObjectHandle DB_Crypt0, hCrypt
	Trigger hCrypt, Destroy
	Exit TRUE
;-----------------------------------------------------
:MoveToMarker
;-----------------------------------------------------
	GetMyHandle hMe
	SetFlag hMe, FLAG_GOTHRUWORLD
	;;playsound Sounds\Events\boulderroll.wav DoNothing hDummy 1000 TRUE 100
	GetObjectHandle CryptMarker0, hMarker
	GetPos hMarker, nVarX, nVarY, nVarZ
	MoveToPos nVarX, nVarY, nVarZ, 300, StopHere
	Exit
;-----------------------------------------------------
:Main
;-----------------------------------------------------
	AddTrigger Fall, MoveToMarker
	OnDamage MoveToMarker
	Exit
;------------- E n d - O f - F i l e -------------------