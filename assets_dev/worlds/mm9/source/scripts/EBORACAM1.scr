#include BaseGlobals.inc

#hobject	hEbora = 0

;----------------------------------------------
:CameraOn
;----------------------------------------------
	GetObjectHandle Ebora, hEbora
	FaceObject hEbora, 0, DoNothing
	
Exit FALSE

;----------------------------------------------
:Main
;----------------------------------------------
	AddTrigger on,  CameraOn

Exit TRUE