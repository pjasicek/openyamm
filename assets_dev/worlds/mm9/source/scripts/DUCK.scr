;----------------------------------------------------------------
;	duck.scr
;	John Machin
;
;		Default script for wanderers
;----------------------------------------------------------------
#include globals.inc
#include wander.inc
#include aiglobals.inc

#hobject	hAlertedBy 
#string		sAlertName

#hobject	hAttacker
#hobject	hTouchedBy


;Passed in Parameter to get Wander distance
#number		g_nDistance

#number		g_nLastDamage 

;----------------------------------------------------------------
:HandleOnAlert
;----------------------------------------------------------------
		
	GetParam 0, hAlertedBy
	GetClassName hAlertedBy, sAlertName		
																	
	Exit
	
;----------------------------------------------------------------
:OnRun
;----------------------------------------------------------------
	
	GetFaceDir hAttacker, g_posX, g_posY, g_posZ
	;CalcDist g_posX,g_posY,g_posZ,g_startX,g_startY,g_startZ,g_dist

	;if (g_dist>MAX_DIST_FROM_STARTPOINT)
		; Too far away from original starting point!!
	;	FacePos g_startX, g_startY, g_startZ, 180
	;endif

	FaceDir g_PosX, g_PosY, g_PosZ

	;This will cause a more erratic running behavior
	Set g_IdleCheckMin, 1
	Set g_IdleCheckMax, 1

	;Set turn degree min max for more erratic movement
	Set g_TurnDegreeMin, 60
	Set g_TurnDegreeMax, 90
	
	Run		

	Set g_IsRunning, TRUE
									
	Exit

;----------------------------------------------------------------
:OnRunning
;----------------------------------------------------------------
	;We want to continue sending Alerts to nearby AI while running
	SendAlert hAttacker		

	Exit
	
;----------------------------------------------------------------
:OnStopRunning
;----------------------------------------------------------------
	;Setup our stuff back to normal
	Set g_IdleCheckMin, 7
	Set g_IdleCheckMax, 7

	Set g_TurnDegreeMin 15
	Set g_TurnDegreeMax 90

	Set g_IsRunning, FALSE
	
	Exit

;----------------------------------------------------------------
:DuckOnDamage
;----------------------------------------------------------------		
	;Figure out who hit us
	GetParam 0, hAttacker	

	;Get last dmg done
	GetParam 1, g_nLastDamage

	;Alert nearby AI
	SendAlert hAttacker	

	GetTime g_StopRunTime
	Add g_StopRunTime, 15

	if( g_nLastDamage == 0 )
		gosub DuckOnDamageDone
	endif	
																	
	Exit FALSE	 	


;----------------------------------------------------------------
:DuckOnDamageDone
;----------------------------------------------------------------
	gosub OnRun	
																	
	Exit
	
;----------------------------------------------------------------
:InitDuck
;----------------------------------------------------------------		 	
	 ;Set Rooster wander distance
	GetParam 1, g_nDistance
	
	if( g_nDistance != 0 )
		Set MAX_DIST_FROM_STARTPOINT, g_nDistance
	else
		Set MAX_DIST_FROM_STARTPOINT, 350
	endif	

	;Set how often we stop at an obstacle
	Set g_nStopAtObstacle, 2

	;Set how often we idle 1 equals 10% valid numbers are 1 to 10
	Set g_IdleFrequency, 4

	;Set max time in seconds before idle check
	Set g_IdleCheckMin, 7
	Set g_IdleCheckMax, 7

	;Set how often special anim is played valid numbers are 1 to 10
	Set g_SpecialAnimFrequency, 0

	Exit

;----------------------------------------------------------------
:Main
;----------------------------------------------------------------
		
	;Monitor these callbacks
	OnDamage		DuckOnDamage
	OnDamageDone	DuckOnDamageDone
	
	;Setup wandering behavior
	gosub WanderInit					

	Exit