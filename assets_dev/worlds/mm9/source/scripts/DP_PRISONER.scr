;------------------------------------------------------------------
;	DP_Prisoner.scr
;	Brett Yagi
;
;	Works in conjunction with IS_fickyflock.scr.
;	Generic function moves object randomly between markers in parameters
;	When given the "scatter" trigger, it will trigger the "birds"
;	specified in parameters.
;
;	Parameters
;
;	0 - Marker Root name  (ie for Markers Mrk0, Mrk1, Mrk2  "Mrk" is the root name)
;	1 - Number of Markers
;	2 - Bird Root name  (ie for Birds Bird0, Bird01, Bird02  "Bird0" is the root name)
;	3 - Number of Birds
;
;
;-----------------------------------------------------

#string		sGuardNameRoot
#string		sMarkerNameRoot
#string		sCellMarker
#number		nPrisonerNum
#string		sMarker
#number		nMarker = 0
#hobject	hMarker

#string		sGuard
#hobject	hGuard
#hobject	NULL = 0
#number		nInRange = 0


:dn

exit 1

:DoNothing
	
	Setidle

exit 1

;--------------------------------------------------------------
:GetInCell
;--------------------------------------------------------------

	SetIdle
	Target NULL 0
	GetObjectHandle sCellMarker hMarker
	WalkTo hMarker 30 dn

Exit 1


;--------------------------------------------------------------
:Follow
;--------------------------------------------------------------

	WalkTo hGuard 50 dn
	OnTargetBeyondDist 50 Follow


Exit 1


;--------------------------------------------------------------
:ExitCell
;--------------------------------------------------------------

	nMarker = nPrisonerNum * 3 + 3
	sMarker = sMarkerNameRoot + nMarker
	GetObjectHandle sMarker hMarker
	sGuard = sGuardNameRoot + 1
	GetObjectHandle sGuard hGuard
	Trigger hGuard WalkToIR
	Target hGuard 1

Exit 1

;--------------------------------------------------------------
:Main2
;--------------------------------------------------------------

	sGuard = sGuardNameRoot + 1
	GetObjectHandle sGuard hGuard
	Target hGuard 1
	GoSub Follow

Exit 1

;--------------------------------------------------------------
:Main
;--------------------------------------------------------------

	GetParam 0 sGuardNameRoot
	GetParam 1 sMarkerNameRoot
	GetParam 2 sCellMarker
	GetParam 3 nPrisonerNum


	
	AddTrigger ExitCell ExitCell
	AddTrigger Follow Follow
	AddTrigger GetInCell GetInCell
	Wait 0 .1 main2


Exit 1









