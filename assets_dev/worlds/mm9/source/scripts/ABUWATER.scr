;---------------------------------------------------------------------
:	AbuWater.scr
;	Tony Evans
;
;	This script is used to raise water for the trap in Abu Dectome's
;	burial chamber in the Tomb of a Thousand Terrors
;
;	Parameters:
;
;	p1	- How many inches of water to leave
;	p2	- Fill Rate
;
;---------------------------------------------------------------------

#include globals.inc

#number			nOrigPosX
#number			nOrigPosY
#number			nOrigPosZ

#number			nDimsX
#number			nDimsY
#number			nDimsZ

;
; Default parameters
;
#number			nWaterToLeave=64
#number			nWaterFillRate=24

#string			sFillSound=Sounds\water\waterfill.wav
#string			sSinkSound=Sounds\water\watersink.wav

#number			hWaterSound

;---------------------------------------------------------------------
:OnRaiseWater
;---------------------------------------------------------------------

	GetDims g_hMyObject, nDimsX, nDimsY, nDimsZ
	Set nDestPosY, nOrigPosY
	Add nDestPosY, nDimsY

	; Leave some water there....

	Sub nDestPosY, nWaterToLeave

	IsSoundDone hWaterSound, g_bTemp
	if ( g_bTemp==TRUE )
		PlaySound sFillSound, 1000, TRUE, 100, hWaterSound
	endif

	MoveToPos nOrigPosX, nDestPosY, nOrigPosZ, nWaterFillRate, StopSound

	Exit

;---------------------------------------------------------------------
:StopSound
;---------------------------------------------------------------------
	KillSound hWaterSound

	Exit

;---------------------------------------------------------------------
:Main
;
;
;---------------------------------------------------------------------
	
	GetMyHandle g_hMyObject
	GetPos g_hMyObject, nOrigPosX, nOrigPosY, nOrigPosZ

	AddTrigger RaiseWater, OnRaiseWater

	GetParam 0, g_nTemp

	if ( g_nTemp!=0 )
		Set nWaterToLeave, g_nTemp
	endif

	GetParam 1, g_nTemp

	if ( g_nTemp!=0 )
		Set nWaterFillRate, g_nTemp
	endif

	Exit