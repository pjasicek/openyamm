;---------------------------------
;	Summoner.scr
;	by SJR
;	11-01-01
;	Purpose:uses SpawnMgr to summon
;			guys, look all dramatic
;			and give player an incentive
;			to kill the summoner soon
;
;	ScriptParams:
;		p0 = name of spawn locations
;		p1 = index of first
;		p2 = index of last
;---------------------------------

#string		sCreatureName = ""
#string		sLocationName = ""
#string		SPAWN_PARAM = ""
#string		sScriptName = " ScriptName Isle_SpawnCreature.scr"

#hobject	hDummy = 0

#number		x = 0
#number		y = 0
#number		z = 0
#number		nCounter = 0

;------------------
:Main
;------------------
	GetParam 0, sCreatureName
	GetParam 1, sLocationName

	OnPostStartWorld InitSummoner
	OnPostMiniSaveLoad InitSummoner
	OnCacheFiles CacheFiles

	Exit 1

;------------------
:CacheFiles
;------------------
	CacheScript "Isle_SpawnCreature.scr"

	Exit 1

;------------------
:InitSummoner
;------------------
	SPAWN_PARAM = sCreatureName + sScriptName
	GetObjectHandle sLocationName, hDummy
	GetPOS hDummy, x,y,z

	AddTrigger spawn, SpawnCreature

	Exit 1

;------------------
:SpawnCreature
;------------------
	if( nCounter>=5 )
		RemoveTrigger spawn
	endif

	nCounter = nCounter + 1
	PlayAnim hattack1
	Spawn hDummy, x,y,z, SPAWN_PARAM

	Exit 1