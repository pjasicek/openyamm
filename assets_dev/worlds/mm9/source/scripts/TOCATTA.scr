;--------------------------------------------------
;tocatta.scr
; timmy
; Plays the intro to tocatta and fugue in dm (transposed to gm)
;--------------------------------------------------

#include globals.inc 

       
#Number					counter
;--------------------------------------------------
:OnPlay
;--------------------------------------------------

getobjecthandle D2, g_hobject
trigger g_hobject use
Wait .2, 1
exit

;--------------------------------------------------
:1
;--------------------------------------------------

getobjecthandle C2, g_hobject
trigger g_hobject use
Wait .2, 2

exit

;--------------------------------------------------
:2
;--------------------------------------------------

getobjecthandle D2, g_hobject
trigger g_hobject use
Wait 1, 3

exit


; RUN DOWN #1
;--------------------------------------------------
:3
;--------------------------------------------------

getobjecthandle C2, g_hobject
trigger g_hobject use
Wait .5, 4

exit

;--------------------------------------------------
:4
;--------------------------------------------------

getobjecthandle A#2, g_hobject
trigger g_hobject use
Wait .5, 5

exit


;--------------------------------------------------
:5
;--------------------------------------------------

getobjecthandle a2, g_hobject
trigger g_hobject use
Wait .5, 6

exit

;--------------------------------------------------
:6
;--------------------------------------------------

getobjecthandle g2, g_hobject
trigger g_hobject use
Wait .5, 7
exit



;--------------------------------------------------
:7
;--------------------------------------------------

getobjecthandle f#2, g_hobject
trigger g_hobject use
Wait 1, 8

exit

;--------------------------------------------------
:8
;--------------------------------------------------

getobjecthandle g2, g_hobject
trigger g_hobject use
Wait 1.5, Phrase2
exit



;*******************
; PHRASE 2
;*******************




;--------------------------------------------------
:Phrase2
;--------------------------------------------------

getobjecthandle D1, g_hobject
trigger g_hobject use
Wait .2, 1-2
exit

;--------------------------------------------------
:1-2
;--------------------------------------------------

getobjecthandle C1, g_hobject
trigger g_hobject use
Wait .2, 2-2

exit

;--------------------------------------------------
:2-2
;--------------------------------------------------

getobjecthandle D1, g_hobject
trigger g_hobject use
Wait 1, 3-2

exit


; RUN DOWN #2
;--------------------------------------------------
:3-2
;--------------------------------------------------

getobjecthandle A1, g_hobject
trigger g_hobject use
Wait .5, 4-2

exit

;--------------------------------------------------
:4-2
;--------------------------------------------------

getobjecthandle A#1, g_hobject
trigger g_hobject use
Wait .5, 5-2

exit


;--------------------------------------------------
:5-2
;--------------------------------------------------

getobjecthandle F#1, g_hobject
trigger g_hobject use
Wait 1, 6-2

exit

;--------------------------------------------------
:6-2
;--------------------------------------------------

getobjecthandle G1, g_hobject
trigger g_hobject use
Wait 1.5, Phrase3
exit







;*******************
; PHRASE 3
;*******************




;--------------------------------------------------
:Phrase3 
;--------------------------------------------------

getobjecthandle D1, g_hobject
trigger g_hobject use
Wait .2, 1-3
exit

;--------------------------------------------------
:1-3
;--------------------------------------------------

getobjecthandle C1, g_hobject
trigger g_hobject use
Wait .2, 2-3

exit

;--------------------------------------------------
:2-3
;--------------------------------------------------

getobjecthandle D1, g_hobject
trigger g_hobject use
Wait 1, 3-3

exit


; RUN DOWN #3
;--------------------------------------------------
:3-3
;--------------------------------------------------

getobjecthandle C1, g_hobject
trigger g_hobject use
Wait .5, 4-3

exit

;--------------------------------------------------
:4-3
;--------------------------------------------------

getobjecthandle A#1, g_hobject
trigger g_hobject use
Wait .5, 5-3

exit


;--------------------------------------------------
:5-3
;--------------------------------------------------

getobjecthandle A1, g_hobject
trigger g_hobject use
Wait .5, 6-3

exit

;--------------------------------------------------
:6-3
;--------------------------------------------------

getobjecthandle G1, g_hobject
trigger g_hobject use
Wait .5, 7-3
exit



;--------------------------------------------------
:7-3
;--------------------------------------------------

getobjecthandle F#1, g_hobject
trigger g_hobject use
Wait 1, 8-3

exit

;--------------------------------------------------
:8-3
;--------------------------------------------------

getobjecthandle G1, g_hobject
trigger g_hobject use
;Wait 1.5, C2
exit








;--------------------------------------------------
:Main
;--------------------------------------------------


;TRACEON
Set counter, 0
AddTrigger Play, OnPlay
exit

