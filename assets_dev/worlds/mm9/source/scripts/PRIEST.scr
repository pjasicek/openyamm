;----------------------------------------------------------------
;	Priest.scr
;	John Machin
;
;		Default script for wanderers
;---------------------------------------------------------------- 
#include globals.inc
#include wander.inc

#hobject	hAttacker

#number		g_nDistance
#number		g_bIsPlayer			= 0
#number		g_nAngle			= 0

#number		g_nLastDamage


;----------------------------------------------------------------
:DoNothing
;----------------------------------------------------------------
	;Do nothing here...

	Exit

;----------------------------------------------------------------
:OnRun
;----------------------------------------------------------------
	
	;Get direction of player face that way and RUN!	
	GetFaceDir hAttacker, g_posX, g_posY, g_posZ
	FaceDir g_PosX, g_PosY, g_PosZ

	;This will cause a more erratic running behavior
	Set g_IdleCheckMin, 1
	Set g_IdleCheckMax, 1

	;Set turn degree min max for more erratic movement
	Set g_TurnDegreeMin, 60
	Set g_TurnDegreeMax, 90
	
	Run		

	Set g_IsRunning, TRUE
									
	Exit

;----------------------------------------------------------------
:OnRunning
;----------------------------------------------------------------
	;We want to continue sending Alerts to nearby AI while running
	SendAlert hAttacker		

	Exit

;----------------------------------------------------------------
:OnStopRunning
;----------------------------------------------------------------
	;Setup our stuff back to normal
	Set g_IdleCheckMin, 2
	Set g_IdleCheckMax, 6

	Set g_TurnDegreeMin 15
	Set g_TurnDegreeMax 90

	Set g_IsRunning, FALSE
	
	Exit

;----------------------------------------------------------------
:PriestOnDamage
;----------------------------------------------------------------
		
	;Figure out who hit us
	GetParam 0, hAttacker	

	;Get last dmg done
	GetParam 1, g_nLastDamage

	;Alert nearby AI
	SendAlert hAttacker	

	GetTime g_StopRunTime
	Add g_StopRunTime, 15
	
	if( g_nLastDamage == 0 )
		gosub PriestOnDamageDone
	endif
																	
	Exit FALSE

;----------------------------------------------------------------
:PriestOnDamageDone
;----------------------------------------------------------------
	gosub OnRun	
																	
	Exit

;----------------------------------------------------------------
:InitPriest
;----------------------------------------------------------------
	;Set the NPCs roaming distance
	GetParam 1, g_nDistance
	
	if( g_nDistance != 0 )
		Set MAX_DIST_FROM_STARTPOINT, g_nDistance
	else
		Set MAX_DIST_FROM_STARTPOINT, 350
	endif

	;Set how often the NPC is idle 1 equals 10% valid numbers are 1 to 10
	Set g_IdleFrequency, 8

	;Set max time in seconds before idle check
	Set g_IdleCheckMin, 5
	Set g_IdleCheckMax, 10

	;Set how often special anim is played valid numbers are 1 to 10
	Set g_SpecialAnimFrequency, 0

	Exit


;----------------------------------------------------------------
:Main
;----------------------------------------------------------------
	
	;Initialize priest
	gosub InitPriest	

	;Initialize Wandering Behavior
	gosub WanderInit	

	;Monitor these callbacks	
	OnDamage		PriestOnDamage
	OnDamageDone	PriestOnDamageDone
	
	;Handle these triggers	
	AddTrigger StopRunning,		OnStopRunning
	AddTrigger Running,			OnRunning  		

	Exit