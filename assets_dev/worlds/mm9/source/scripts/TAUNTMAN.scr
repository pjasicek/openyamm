;--------------------------------------------------
;TauntMan.scr
; timmy
; Manager for Taunt script
;
; edited by Bones 5/26/03
; TELP Patch 1.3 -- Prevents lockup if in TB mode.
;--------------------------------------------------

#include globals.inc


;--------------------------------------------------
:OnStart
;--------------------------------------------------

haskey 108 g_ntemp
if (g_ntemp==FALSE)
	exit
else
	haskey 497 g_ntemp
	if (g_ntemp==TRUE)
		exit
	endif
endif

givekey 497
ScreenFadeOut 1
wait 1 1 FadeIn
exit

;--------------------------------------------------
:FadeIn
;--------------------------------------------------

Letterbox True
Getobjecthandle TauntCam g_hobject
trigger g_hobject on
ScreenFadeIn 1
getobjecthandle Door0 g_hobject
trigger g_hobject open
wait 1 1 TriggerNjam
exit

;--------------------------------------------------
:TriggerNjam
;
; Time to walk out of the Room
;--------------------------------------------------

getobjecthandle NjamtheMeddler0 g_hobject
trigger g_hobject start
exit


;--------------------------------------------------
:OnCloseUp
; 
; switches to the Closeup Cam
;--------------------------------------------------

getobjecthandle Door0 g_hobject
trigger g_hobject Close
Getobjecthandle TauntCam g_hobject
trigger g_hobject off
Getobjecthandle TauntCamB g_hobject
trigger g_hobject on
exit




;--------------------------------------------------
:OnFarCam
; 
; switches to the Closeup Cam
;--------------------------------------------------


Getobjecthandle TauntCamB g_hobject
trigger g_hobject off
Getobjecthandle TauntCam g_hobject
trigger g_hobject on
exit

;--------------------------------------------------
:OnFadeOut
;--------------------------------------------------

ScreenFadeOut 1
Wait 1 1 FadeOut2
exit


;--------------------------------------------------
:FadeOut2
;--------------------------------------------------

LetterBox False
Getobjecthandle TauntCam g_hobject
trigger g_hobject off
ScreenFadeIn 1
exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!

AddTrigger Start OnStart
AddTrigger Arrive OnCloseUp
AddTrigger VanishStart OnFarCam
Addtrigger VanishDone OnFadeOut

exit

;--------------------------------------------------
:OnStart
;	overloaded -- Bones
;--------------------------------------------------

haskey 108 g_ntemp
if (g_ntemp==FALSE)
	exit
else
	haskey 497 g_ntemp
	if (g_ntemp==TRUE)
		exit
	endif
endif

IsTurnBased g_nTemp
if g_nTemp == TRUE
	ScreenFadeOut 1
	RollOverText 18 0
	wait 0 1 OnStart
	Exit
endif

goto OnStart 1
