;-----------------------------------
;	GiveRandom.inc
;	by SJR
;	11-03-01
;	Purpose:give the player a random
;			bonus or detriment
;	Triggers:
;		'use' = give out random thing
;	ScriptParams:
;		p0 = name of smoke to trigger
;		p1 = number of "wishes" (0=infinite)
;-----------------------------------
#include BaseGlobals.inc
#include pickmon.inc

#string		sSmokeName = ""
#hobject	hSmoke = 0
#hobject	hPlayer = 0
#number		nQuantity = 0

#number		nTemp = 0

#number		MAX_GOLD = 1000
#number		MAX_EXP = 1000
#number		MAX_HEALTH = 1000
#number		MAX_ATTRIBUTE = 2

#number		MIN_GOLD = 100
#number		MIN_EXP = 100
#number		MIN_HEALTH = 100
#number		MIN_ATTRIBUTE = 1

#number		NUM_ITEMS = 60
#number		NUM_MONSTERS = 90
#number		NUM_ATTRIBUTES = 5

;-------------------
:Main
;-------------------
	GetParam 0, sSmokeName

;;	OnPostStartWorld InitGiveRandom
Wait 0, 5, InitGiveRandom

	gosub InitItemList

	Exit TRUE

;-------------------
:InitGiveRandom
;-------------------
	AddTrigger use, ProduceRandomEffect

	SetCallback 0, GiveRandomGold
	SetCallback 1, GiveRandomExp
	SetCallback 2, GiveRandomItem
	SetCallback 3, GiveRandomHealth
	SetCallback 4, GiveRandomAttribute

	GetPlayerHandle hPlayer

	Exit TRUE

#number		nRandom = 0
;-------------------
:ProduceRandomEffect
;-------------------
	RemoveTrigger use

	if( hSmoke==0 )
		GetObjectHandle sSmokeName, hSmoke
	endif
	if( hSmoke!=0 )
		Trigger hSmoke, trigger
	endif

	GetRandomInt 0, 5, nRandom

	DoCallback nRandom

	Exit TRUE

;****************************
;private
;****************************
#number		nMin = 0
#number		nMax = 0

#numberarray	npItems[61]
#string			sName = ""

:GetRandomQuantity
	GetRandomInt nMin, nMax, nQuantity

	Exit TRUE

:GiveRandomGold
	nMin = MIN_GOLD
	nMax = MAX_GOLD
	gosub GetRandomQuantity

	GiveGold nQuantity

	Exit TRUE

:GiveRandomExp
	nMin = MIN_EXP
	nMax = MAX_EXP
	gosub GetRandomQuantity

	GiveExp nQuantity

	Exit TRUE

:GiveRandomHealth
	nMin = MIN_HEALTH
	nMax = MAX_HEALTH
	gosub GetRandomQuantity

	Heal hPlayer, nQuantity

	Exit TRUE

:GiveRandomAttribute
	nMin = MIN_ATTRIBUTE
	nMax = MAX_ATTRIBUTE
	gosub GetRandomQuantity

	GetRandomInt 0, NUM_ATTRIBUTES, nTemp
	;;numattribute, howmuch, everyone, gameseconds (5 real mins)
	GiveAttribute nTemp, nQuantity, TRUE, 3000

	Exit TRUE

:GiveRandomItem
	GetRandomInt 0, NUM_ITEMS, nTemp
	ArrayGet npItems, nTemp, nQuantity

	GiveItem nQuantity

	Exit TRUE

;;should be named "SuperFunToWriteRoutine"
