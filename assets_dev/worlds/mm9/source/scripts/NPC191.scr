;--------------------------------------------------
;NPC191.scr
; timmy
; handles Gudrun Fyridotir voice and quest stuff
;--------------------------------------------------

#include globals.inc
#include pledge.inc

#String    Params          
#String    sound
#number                         KeyCheck
;Parameters
;P0 name of wav file
;P1 name of animation to run
;P2  # of times animation runs

;--------------------------------------------------
:OnRude
;--------------------------------------------------

Gosub pledge
exit



;--------------------------------------------------
:OnUse
;--------------------------------------------------

Playsound voices\NPC\NPC_191.wav, Onexit, 100, 240, FALSE, 100
exit

;-------------------------------------
:OnExit
;-------------------------------------

exit

;--------------------------------------------------
:Main
;--------------------------------------------------

;traceon 
;Don't Forget to Delete this!


OnRudeExit OnRude

Addtrigger Use, OnUse

exit

