# The release key that seals the playthrough statistics (devdocs/PLAYTHROUGH_STATISTICS_PLAN.md, "Sealed files").
#
# Neither the key nor how a release build assembles it is in the repository. A release build compiles in a private
# C++ source that defines
#
#     namespace OpenYAMM::Game::PlaythroughSealRelease
#     {
#     // Writes the 32-byte release key to pKey and returns its version label, e.g. "release-1".
#     const char *assembleKey(uint8_t *pKey);
#     }
#
# taken from:
#   - -DOPENYAMM_STATS_KEY_SOURCE=<path to the .cpp> (the maintainer's machine), or
#   - the OPENYAMM_STATS_KEY_SOURCE environment variable holding the source text (the CI, from a repository secret).
# Without either, the game seals with its built-in development key and labels such records "Development build".
set(OPENYAMM_STATS_KEY_SOURCE "" CACHE FILEPATH "Private C++ source of the playthrough statistics release key")

# Sets OPENYAMM_STATS_PRIVATE_KEY_SOURCE in the caller to the source to compile in, or empty.
function(openyamm_generate_playthrough_statistics_key headerFile)
    set(sourceText "")

    if (NOT OPENYAMM_STATS_KEY_SOURCE STREQUAL "")
        if (NOT EXISTS "${OPENYAMM_STATS_KEY_SOURCE}")
            message(FATAL_ERROR "OPENYAMM_STATS_KEY_SOURCE does not exist: ${OPENYAMM_STATS_KEY_SOURCE}")
        endif()
        file(READ "${OPENYAMM_STATS_KEY_SOURCE}" sourceText)
    elseif (DEFINED ENV{OPENYAMM_STATS_KEY_SOURCE} AND NOT "$ENV{OPENYAMM_STATS_KEY_SOURCE}" STREQUAL "")
        set(sourceText "$ENV{OPENYAMM_STATS_KEY_SOURCE}")
    endif()

    get_filename_component(generatedDirectory "${headerFile}" DIRECTORY)
    set(privateSource "${generatedDirectory}/PlaythroughStatisticsReleaseKey.cpp")
    set(header "// Generated by cmake/PlaythroughStatisticsKey.cmake. Never commit this file.\n#pragma once\n\n")

    if (sourceText STREQUAL "")
        string(APPEND header "#define OPENYAMM_HAS_RELEASE_STATS_KEY 0\n")
        file(REMOVE "${privateSource}")
        set(OPENYAMM_STATS_PRIVATE_KEY_SOURCE "" PARENT_SCOPE)
        message(STATUS "Playthrough statistics: development key (no release key source configured)")
    else()
        string(APPEND header "#define OPENYAMM_HAS_RELEASE_STATS_KEY 1\n")
        # Written as is (no variable substitution), and only when it changes, so a reconfigure rebuilds nothing.
        set(existingText "")
        if (EXISTS "${privateSource}")
            file(READ "${privateSource}" existingText)
        endif()
        if (NOT existingText STREQUAL sourceText)
            file(WRITE "${privateSource}" "${sourceText}")
        endif()
        set(OPENYAMM_STATS_PRIVATE_KEY_SOURCE "${privateSource}" PARENT_SCOPE)
        message(STATUS "Playthrough statistics: release key from the private key source")
    endif()

    file(CONFIGURE OUTPUT "${headerFile}" CONTENT "${header}" @ONLY)
endfunction()
