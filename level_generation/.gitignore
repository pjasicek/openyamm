# level_generation holds 716 GB of generation projects: models, images, renders, job outputs and copies of game
# data. Only the authored part is tracked: docs, scripts, review pages and small hand-written data. Heavy and generated
# folders are never entered, which keeps `git status` fast. Models and images need a separate backup.
#
# Git cannot ignore by size, so update_gitignore.py lists the files over 256 KB that these rules would let through
# (generated viewers, manifests, catalogues) at the end of this file. Run it after adding projects:
#     python3 level_generation/update_gitignore.py

/**
!/**/
!/.gitignore

# Folders that are never entered.
*venv/
site-packages/
node_modules/
plot_packages/
.pytest_cache/
/creatures/mm6_lzd_codex/work/python/
review/
review_root/
runtime_root/
work/
raw/
raw_returns/
render/
renders/
frames/
playtest/
capture/
captures/
screenshots/
tmp/
cache/
meshy/
return/
returns/
chat_returns/
chat_bundles/
incoming/
outputs/
runs/
receipts/
batches/
prepared_payloads/
sheets/
redo_2x/
iterations/
checkpoint*/
before*/
round[0-9]*/
assets/
assets_dev/
worlds/
maps/
events/

# Authored text everywhere.
!*.md
!*.py
!*.sh
!*.mjs
!*.css
!*.html
!*.js

# Small data, except in the creature, UI and sprite projects, whose data files are generated.
!*.yml
!*.yaml
!*.json
!*.txt
!*.csv
!*.tsv
!*.lua
/creatures/*/**/*.json
/creatures/*/**/*.txt
/creatures/*/**/*.csv
/creatures/*/**/*.tsv
/creatures/*/**/*.lua
/creatures/*/**/*.yml
!/creatures/claude_shared/**/*.json
!/creatures/claude_shared/**/*.yml
!/creatures/*/*progress*.json
!/creatures/*/*manifest*.json
!/creatures/*/*manifest*.yml
!/creatures/*/*config*.json
!/creatures/*/*config*.yml
/ui/**/*.json
/ui/**/*.txt
/ui/**/*.csv
/ui/**/*.tsv
/sprites/**/*.json
/sprites/**/*.txt
!/sprites/restoration_jobs/*.json

# Meshy task records (signed download links) and generated reports.
*task*.json
*_result*.json
gates.md

# Files that tracked tools, data tables and docs rely on, inside folders the rules above skip.
!/creatures/claude_shared/**/*.txt
!/creatures/mm6_remaining/redo_2x/
/creatures/mm6_remaining/redo_2x/*/
!/creatures/mm6_remaining/redo_2x/progress.json
!/creatures/mm6_remaining/quality_review/audit.json
!/creatures/mm6_packed_outline_collection_20261001/collection.json
!/ui/hud_inventory/finalization_20260926/placements.json
!/ui/hud_inventory/finalization_20260926/inventory_fit.json
!/terrain/mm6_ground_cover/review/
!/terrain/mm6_ground_cover/review/performance/

# --- Generated by update_gitignore.py: files over 256 KB and symbolic links. Do not edit below. ---
/catalogues/mm8_alvar/catalogue.json
/catalogues/mm8_garrote_gorge/catalogue.json
/catalogues/mm8_ravenshore/catalogue.json
