# Local editor payloads and original game extractions. Runtime assets belong in assets_dev; source assets are the
# assets_source submodule (openyamm-source-assets, see tools/ASSET_STORAGE.md).
/assets_editor_dev/
/data/
# MM9 imports and the optional world payload are local for now.
/mm9/
/assets_dev/worlds/mm9/

# Generation projects: level_generation/.gitignore tracks only their docs, scripts and small hand-written data.
# Local animation source library (humanoid set, Mixamo and Meshy clips); only its README is tracked.
/anim_library/*
!/anim_library/README.md
# Generated equipment catalogs, previews, reports and browser test outputs.
/tools/paperdoll_review/catalog.js
/tools/paperdoll_review/native_manifest.json
/tools/paperdoll_review/*/
# Optional creature analysis outputs, never source code.
/tools/creatures/quality_review/*/
/tools/creatures/quality_review/*.json

# Reusable tool sources stay portable; generated banks and experiments stay local.
/tools/font_upscale/*/
/tools/mm9_import_discovery/*/
/tools/upscaling/*/
/tools/upscaling/*.zip
/tools/upscaling/*.json
/tools/upscaling/realesrgan-ncnn-vulkan
