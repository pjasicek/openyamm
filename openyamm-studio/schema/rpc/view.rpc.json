    "terrain_query": {
      "summary": "The built land of an outdoor project, asked by place (S5_BROWSER_EDITOR.md 3.18: how agents read land a person made by hand, instead of reading its rows): the height and slope at points, and a profile along a line. From the current view's map (the stored heights, as the game has them); stale when the project's own revision does not lower.",
      "since": 1,
      "lane": "interactive",
      "backends": [
        "native",
        "wasm"
      ],
      "exposed": true,
      "writes": "none",
      "assets": "optional",
      "errors": [
        "not_a_project",
        "has_errors",
        "bad_request"
      ],
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "$ref": "common.rpc.json#/$defs/project_path"
          },
          "points": {
            "description": "Places [x, y] in cells (fractions allowed) to give the height and slope at.",
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "line": {
            "description": "A profile: heights every `step` cells from `from` to `to`.",
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "to": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "step": {
                "description": "Cells between samples, 0.25 to 16 (1 when left out).",
                "type": "number",
                "minimum": 0.25,
                "maximum": 16
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "revision",
          "view_revision",
          "stale",
          "points"
        ],
        "properties": {
          "revision": {
            "$ref": "common.rpc.json#/$defs/revision"
          },
          "view_revision": {
            "$ref": "common.rpc.json#/$defs/revision"
          },
          "stale": {
            "type": "boolean"
          },
          "skipped": {
            "$ref": "common.rpc.json#/$defs/strings"
          },
          "skipped_issues": {
            "type": "array",
            "items": {
              "$ref": "common.rpc.json#/$defs/issue"
            }
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "height",
                "slope"
              ],
              "properties": {
                "at": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "x-decimals": 3
                  }
                },
                "height": {
                  "description": "Map units, as stored (steps of 32 between the nodes, weighed by distance).",
                  "type": "integer"
                },
                "slope": {
                  "description": "Degrees from level, from the heights half a cell either way.",
                  "type": "number",
                  "x-decimals": 1
                }
              },
              "additionalProperties": false
            }
          },
          "profile": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "height"
              ],
              "properties": {
                "at": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "x-decimals": 3
                  }
                },
                "height": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "overlay": {
      "summary": "An overlay project's scene things on its base map (devdocs/map_studio/S6_PLAN.md, item O; S8a), for the plan view and agents: the base map's pulsing lights, ambient sounds, destructibles, water volumes, spawn points and ladders, each with its id in ids.lock.yml and what the project does to it (kept, changed, removed), and the project's own additions (objects.yml `scene`: also monsters and floor items, which the game appends after the base map's) where the built overlay puts them; with the base map's bounds and profile (region, city, dungeon), and its cinematics with what the project's of the same name do to them. Read from the session's asset root (the base map's own scene, without other overlays).",
      "since": 1,
      "lane": "interactive",
      "backends": [
        "native",
        "wasm"
      ],
      "exposed": true,
      "writes": "none",
      "assets": "required",
      "errors": [
        "not_a_project",
        "bad_request",
        "no_asset_root",
        "no_such_map"
      ],
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "$ref": "common.rpc.json#/$defs/project_path"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "base",
          "world",
          "profile",
          "bounds",
          "scene_keys",
          "things",
          "issues"
        ],
        "properties": {
          "base": {
            "description": "The base map's file.",
            "type": "string"
          },
          "world": {
            "type": "string"
          },
          "profile": {
            "enum": [
              "region",
              "city",
              "dungeon"
            ]
          },
          "bounds": {
            "description": "[min x, min y, max x, max y] of the base map's vertices.",
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "scene_keys": {
            "description": "The scene overlay's keys the project writes (empty: it changes no scene).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "things": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "origin",
                "state",
                "at",
                "label"
              ],
              "properties": {
                "id": {
                  "description": "Its id: in ids.lock.yml for a base thing, in objects.yml `scene` for an addition.",
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "light",
                    "sound",
                    "destructible",
                    "water",
                    "spawn",
                    "ladder",
                    "monster",
                    "item"
                  ]
                },
                "origin": {
                  "enum": [
                    "base",
                    "added"
                  ]
                },
                "state": {
                  "enum": [
                    "kept",
                    "changed",
                    "removed",
                    "added"
                  ]
                },
                "at": {
                  "description": "Its place [x, y, z]: a light's or sound's position, a destructible's centre, a water volume's middle at its surface, a spawn point, a ladder's foot, a monster's or an item's place.",
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "radius": {
                  "description": "A light's largest reach, a sound's hearing distance, a spawn's spread, a monster's body.",
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "polygons": {
                  "description": "A water volume's pieces on the plan.",
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "cinematics": {
            "description": "The base map's cinematics and the project's (wiring.yml `cinematics`, written as `<stem>_<project id>.cinematics.yml`, which the game merges by name after the map's own): a base one kept or replaced by the project's of its name, the project's others added. Absent when neither has any.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "state"
              ],
              "properties": {
                "id": {
                  "description": "`cinematic:<name>`.",
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "kept",
                    "replaced",
                    "added"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "issues": {
            "description": "What stops the overlay from building (its additions are then left out).",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "path",
                "message"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "view_point": {
      "description": "A point [x, y] in map units, rounded to integers.",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "view_box": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "max": {
          "$ref": "common.rpc.json#/$defs/point3i"
        }
      },
      "additionalProperties": false
    },
    "mesh_section": {
      "description": "A part of the mesh file: its byte offset and the number of its elements (floats or uint32).",
      "type": "object",
      "required": [
        "offset",
        "count"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "mesh_group": {
      "type": "object",
      "required": [
        "texture",
        "first",
        "count",
        "uv_unit",
        "kind"
      ],
      "properties": {
        "texture": {
          "description": "The texture's name as the map names it (lower case); empty for faces without one.",
          "type": "string"
        },
        "first": {
          "description": "The group's first place in `indices`.",
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "description": "How many indices (three per triangle).",
          "type": "integer",
          "minimum": 0
        },
        "uv_unit": {
          "enum": [
            "texel",
            "unit"
          ]
        },
        "kind": {
          "description": "surface: walls, floors, ceilings, models; liquid: a texture the game draws as a liquid (no picture); terrain: the outdoor land, one tile texture per cell; moving: the faces of a door, lift or mover.",
          "enum": [
            "surface",
            "liquid",
            "terrain",
            "moving"
          ]
        }
      },
      "additionalProperties": false
    },
    "mesh_owner": {
      "description": "The project object a face comes from: a top-level id, with the wall or part where the lowering knows it (room:hall/walls/3), and its file where the id alone is in more than one file.",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "file": {
          "$ref": "common.rpc.json#/$defs/file_name"
        }
      },
      "additionalProperties": false
    },
    "view_room": {
      "type": "object",
      "required": [
        "id",
        "sector",
        "outline",
        "floor",
        "ceiling"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sector": {
          "description": "The room's sector number in the built map.",
          "type": "integer",
          "minimum": 0
        },
        "outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view_point"
          }
        },
        "floor": {
          "type": "integer"
        },
        "ceiling": {
          "type": "integer"
        },
        "floor_to": {
          "description": "A floor that rises or falls: its other height.",
          "type": "integer"
        },
        "ceiling_to": {
          "description": "A ceiling that slopes: its other height.",
          "type": "integer"
        },
        "levels": {
          "description": "Parts of the floor at another height (levels, platforms, treads): outline and height.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "outline",
              "height"
            ],
            "properties": {
              "outline": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/view_point"
                }
              },
              "height": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "view_opening": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "bottom",
        "top"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "description": "The room it opens from.",
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "a": {
          "description": "A wall opening: its two ends on the plan, in the `from` room's wall.",
          "$ref": "#/$defs/view_point"
        },
        "b": {
          "$ref": "#/$defs/view_point"
        },
        "outline": {
          "description": "An opening in a floor: the hole's outline.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/view_point"
          }
        },
        "bottom": {
          "type": "integer"
        },
        "top": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "view_door": {
      "type": "object",
      "required": [
        "id",
        "opening"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "opening": {
          "type": "string"
        },
        "hinged": {
          "type": "boolean"
        },
        "leaves": {
          "type": "integer",
          "minimum": 1
        },
        "starts_open": {
          "description": "The map starts it open (a door), raised (a lift) or at its end (a mover).",
          "type": "boolean"
        },
        "moves": {
          "description": "How its faces move, one per mechanism (a door of two sliding leaves has two).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/view_move"
          }
        }
      },
      "additionalProperties": false
    },
    "view_lift": {
      "type": "object",
      "required": [
        "id",
        "mover"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mover": {
          "description": "A mover (objects.yml movers) rather than a lift.",
          "type": "boolean"
        },
        "starts_open": {
          "description": "The map starts it open (a door), raised (a lift) or at its end (a mover).",
          "type": "boolean"
        },
        "moves": {
          "description": "How its faces move, one per mechanism (a door of two sliding leaves has two).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/view_move"
          }
        }
      },
      "additionalProperties": false
    },
    "view_thing": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "at"
      ],
      "properties": {
        "id": {
          "description": "The project id, or a name the build gave it (an outdoor decoration of a scatter).",
          "type": "string"
        },
        "kind": {
          "enum": [
            "chest",
            "monster",
            "item",
            "decoration",
            "light",
            "spawn",
            "sound",
            "ladder",
            "entity",
            "switch",
            "exit"
          ]
        },
        "at": {
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "name": {
          "description": "What it is: a decoration's name, a monster's, a switch's kind (plate, lever, button).",
          "type": "string"
        },
        "radius": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "facing": {
          "description": "Degrees, counter-clockwise from east. A switch or an exit: the way its face looks (into the room); a plate on a block's top has none.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "view_start": {
      "type": "object",
      "required": [
        "at",
        "facing"
      ],
      "properties": {
        "at": {
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "facing": {
          "description": "Degrees, counter-clockwise from east.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "view_land": {
      "type": "object",
      "required": [
        "size",
        "cell",
        "height_unit",
        "heights",
        "water"
      ],
      "properties": {
        "size": {
          "description": "Cells along a side (128).",
          "type": "integer",
          "minimum": 1
        },
        "cell": {
          "description": "Map units per cell (512). Cell (0, 0) is the north-west corner; x east, y south in cells.",
          "type": "integer",
          "minimum": 1
        },
        "height_unit": {
          "description": "Map units per height step of `heights`.",
          "type": "integer",
          "minimum": 1
        },
        "heights": {
          "description": "size x size heights, row by row from the north, in height steps.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "water": {
          "description": "size x size flags, 1 where the cell's tile is water.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "view_model": {
      "type": "object",
      "required": [
        "id",
        "min",
        "max"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "min": {
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "max": {
          "$ref": "common.rpc.json#/$defs/point3i"
        }
      },
      "additionalProperties": false
    },
    "view_move": {
      "type": "object",
      "description": "How one mechanism of a door, lift or mover moves (S5b2: the 3D view's travel scrubber): the middle of its faces as view.mesh draws them (closed, at its start), and either the shift to open (to its end) or, a hinged leaf, the turn about its pivot.",
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "by": {
          "description": "From closed (its start) to open (its end), map units.",
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "pivot": {
          "description": "A hinged leaf: the foot of its vertical hinge line.",
          "$ref": "common.rpc.json#/$defs/point3i"
        },
        "degrees": {
          "description": "A hinged leaf: the turn to open, degrees counter-clockwise seen from above.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
