{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map Studio RPC: view",
  "description": "What the browser draws, made by the core from the project's own lowering (S5_BROWSER_EDITOR.md 2.9): view.layout gives every object's resolved place for the plan view, view.mesh the map's faces for the 3D view. Indoors both come from the lowering the core already ran for the revision (the edit's own lowering), not from a build: no compiler, BSP or GLB. Outdoors they come from a dry build. A project whose lowering stops at an error has no view of its own revision: the answer is the last view this core made of the project in the session, marked stale (view_revision names it), or the has_errors refusal when there is none. Positions are map units, x east, y north, z up.",
  "x-group": "view",
  "methods": {
    "layout": {
      "summary": "Every object's resolved place: rooms (outline, floor and ceiling as built), openings (where in which walls), doors, lifts and movers, things that stand somewhere (chests, monsters, items, decorations, lights, spawn points, the start; switches and exits at the middle of their faces), and outdoors the land's heights and the models' boxes. What the plan view draws and what a pick on the plan maps back to.",
      "since": 1,
      "lane": "interactive",
      "backends": [
        "native",
        "wasm"
      ],
      "exposed": true,
      "writes": "none",
      "assets": "optional",
      "errors": [
        "not_a_project",
        "has_errors"
      ],
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "$ref": "common.rpc.json#/$defs/project_path"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "revision",
          "view_revision",
          "stale",
          "kind",
          "world",
          "bounds",
          "rooms",
          "openings",
          "doors",
          "lifts",
          "things"
        ],
        "properties": {
          "revision": {
            "$ref": "common.rpc.json#/$defs/revision"
          },
          "view_revision": {
            "description": "The revision the layout was made from: equal to revision unless stale.",
            "$ref": "common.rpc.json#/$defs/revision"
          },
          "stale": {
            "description": "The project's own revision does not lower (it has errors): this is the last layout made of it.",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "indoor",
              "outdoor",
              "overlay"
            ]
          },
          "world": {
            "type": "string"
          },
          "bounds": {
            "$ref": "#/$defs/view_box"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/view_room"
            }
          },
          "openings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/view_opening"
            }
          },
          "doors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/view_door"
            }
          },
          "lifts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/view_lift"
            }
          },
          "things": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/view_thing"
            }
          },
          "start": {
            "$ref": "#/$defs/view_start"
          },
          "land": {
            "description": "Outdoors: the land as built.",
            "$ref": "#/$defs/view_land"
          },
          "models": {
            "description": "Outdoors: the models (buildings and other structures) and their boxes.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/view_model"
            }
          },
          "skipped": {
            "description": "A view build (S5_BROWSER_EDITOR.md 2.4.2): the objects the lowering could not lower, left out of this view with what depends on them; the issues carry a note (code skipped) for each. The client draws their last good mesh marked stale.",
            "$ref": "common.rpc.json#/$defs/strings"
          },
          "skipped_issues": {
            "description": "With skipped: a note (code skipped) per object left out, and the errors the view build reached that the full check had stopped before.",
            "$ref": "common.rpc.json#/$defs/issues"
          }
        },
        "additionalProperties": false
      }
    },
    "mesh": {
      "summary": "The map's visible faces as binary buffers, grouped by texture, with a provenance table naming the project object each face comes from. The bytes are written to a cache file under the project's .oymap/view/ (named by the view's revision and lock hash) and named in `file`; the host serves them on its byte route (/mesh/<project>/<name>) and the hosted worker hands them over as a buffer. Layout of the file (little-endian, each section 4-byte aligned, offsets and counts in `sections`): positions float32 x,y,z per vertex (map units); normals float32 x,y,z per vertex (unit length); uvs float32 u,v per vertex in texels of the face's texture (divide by the texture's own size, as the game does), except where the group says uv_unit unit (0..1 across the texture); indices uint32, three per triangle, each group's triangles contiguous; triangle_faces uint32, one per triangle, the face it belongs to; face_owners uint32, one per face, a place in `owners` (0: none).",
      "since": 1,
      "lane": "interactive",
      "backends": [
        "native",
        "wasm"
      ],
      "exposed": true,
      "writes": "none",
      "assets": "optional",
      "errors": [
        "not_a_project",
        "has_errors"
      ],
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "$ref": "common.rpc.json#/$defs/project_path"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "revision",
          "view_revision",
          "stale",
          "lock_hash",
          "kind",
          "world",
          "file",
          "bytes",
          "counts",
          "sections",
          "groups",
          "owners",
          "bounds"
        ],
        "properties": {
          "revision": {
            "$ref": "common.rpc.json#/$defs/revision"
          },
          "view_revision": {
            "description": "The revision the mesh was made from: equal to revision unless stale.",
            "$ref": "common.rpc.json#/$defs/revision"
          },
          "stale": {
            "description": "The project's own revision does not lower (it has errors): this is the last mesh made of it.",
            "type": "boolean"
          },
          "lock_hash": {
            "$ref": "common.rpc.json#/$defs/lock_hash"
          },
          "kind": {
            "enum": [
              "indoor",
              "outdoor",
              "overlay"
            ]
          },
          "world": {
            "description": "The world whose textures the faces name (project.yml world).",
            "type": "string"
          },
          "file": {
            "description": "The cache file, relative to the project: .oymap/view/<view revision>-<first 8 digits of the lock hash>-<first 12 digits of the bytes' hash>.mesh (a name never stands for two contents, as the host serves it immutable).",
            "type": "string",
            "pattern": "^\\.oymap/view/[0-9a-f]+-[0-9a-z]+-[0-9a-f]{12}\\.mesh$"
          },
          "bytes": {
            "description": "The file's size.",
            "type": "integer",
            "minimum": 0
          },
          "counts": {
            "type": "object",
            "required": [
              "vertices",
              "triangles",
              "faces"
            ],
            "properties": {
              "vertices": {
                "type": "integer",
                "minimum": 0
              },
              "triangles": {
                "type": "integer",
                "minimum": 0
              },
              "faces": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "sections": {
            "type": "object",
            "required": [
              "positions",
              "normals",
              "uvs",
              "indices",
              "triangle_faces",
              "face_owners"
            ],
            "properties": {
              "positions": {
                "$ref": "#/$defs/mesh_section"
              },
              "normals": {
                "$ref": "#/$defs/mesh_section"
              },
              "uvs": {
                "$ref": "#/$defs/mesh_section"
              },
              "indices": {
                "$ref": "#/$defs/mesh_section"
              },
              "triangle_faces": {
                "$ref": "#/$defs/mesh_section"
              },
              "face_owners": {
                "$ref": "#/$defs/mesh_section"
              }
            },
            "additionalProperties": false
          },
          "groups": {
            "description": "Runs of triangles that share a texture, in the order of `indices`.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/mesh_group"
            }
          },
          "owners": {
            "description": "The objects faces come from; the first entry is the empty owner (id \"\").",
            "type": "array",
            "items": {
              "$ref": "#/$defs/mesh_owner"
            }
          },
          "bounds": {
            "$ref": "#/$defs/view_box"
          },
          "skipped": {
            "description": "A view build (S5_BROWSER_EDITOR.md 2.4.2): the objects the lowering could not lower, left out of this view with what depends on them; the issues carry a note (code skipped) for each. The client draws their last good mesh marked stale.",
            "$ref": "common.rpc.json#/$defs/strings"
          },
          "skipped_issues": {
            "description": "With skipped: a note (code skipped) per object left out, and the errors the view build reached that the full check had stopped before.",
            "$ref": "common.rpc.json#/$defs/issues"
          }
        },
        "additionalProperties": false
      }
    },
    "render": {
      "summary": "A labelled drawing of a shipped map or a project from its data, as PNG: plan (top down) or iso. Indoor: sectors numbered and coloured, doors red with their numbers, portals green, S the party start, yellow dots spawn points. Outdoor: terrain by height, buildings numbered, clickable faces orange.",
      "since": 1,
      "lane": "jobs",
      "backends": [
        "native",
        "wasm"
      ],
      "exposed": false,
      "writes": "none",
      "assets": "required",
      "errors": [
        "no_asset_root",
        "not_a_project",
        "has_errors",
        "no_such_map",
        "bad_request",
        "no_mount"
      ],
      "params": {
        "type": "object",
        "required": [
          "map"
        ],
        "properties": {
          "map": {
            "$ref": "common.rpc.json#/$defs/map_target"
          },
          "world": {
            "description": "The world of a shipped map (mm6, mm7, mm8, mm9); a project names its own.",
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "built": {
            "description": "Read with the session's mount of installed builds in front of the asset root (after build.install).",
            "type": "boolean"
          },
          "view": {
            "enum": [
              "plan",
              "iso"
            ]
          },
          "size": {
            "description": "The longer side in pixels (default 1024).",
            "type": "integer",
            "minimum": 128,
            "maximum": 2048
          },
          "labels": {
            "description": "Numbers and names on the drawing (default true).",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "map",
          "width",
          "height",
          "png_base64"
        ],
        "properties": {
          "map": {
            "description": "The map file drawn (a project's built map).",
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "png_base64": {
            "description": "The PNG, base64 (no path: the picture is the answer).",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "original_mesh": {
      "summary": "The project's original (its map_stats.reference, or the shipped map it overlays) as the views draw a mesh, read from the session's asset root: indoor every visible face as the map file stores it, each owned by its sector (sector:<n>, no file); outdoor the land by its tiles and the models. Written beside the project's own view meshes (.oymap/view/); the Compare view draws it beside the rebuild, moved by compare.run's vertical_offset.",
      "since": 1,
      "lane": "interactive",
      "backends": [
        "native",
        "wasm"
      ],
      "exposed": true,
      "writes": "none",
      "assets": "required",
      "errors": [
        "not_a_project",
        "bad_request",
        "no_asset_root",
        "no_such_map",
        "failed"
      ],
      "params": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "$ref": "common.rpc.json#/$defs/project_path"
          },
          "original": {
            "description": "Another shipped map of the project's world instead of its own original. A shipped map's file name, never a path.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+\\.(blv|odm)$"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "original",
          "world",
          "kind",
          "file",
          "bytes",
          "counts",
          "sections",
          "groups",
          "owners",
          "bounds"
        ],
        "properties": {
          "original": {
            "description": "The original's map file.",
            "type": "string"
          },
          "world": {
            "description": "The world whose textures the faces name (project.yml world).",
            "type": "string"
          },
          "kind": {
            "enum": [
              "indoor",
              "outdoor",
              "overlay"
            ]
          },
          "file": {
            "description": "The cache file, relative to the project: .oymap/view/<view revision>-<first 8 digits of the lock hash>-<first 12 digits of the bytes' hash>.mesh (a name never stands for two contents, as the host serves it immutable).",
            "type": "string",
            "pattern": "^\\.oymap/view/[0-9a-f]+-[0-9a-z]+-[0-9a-f]{12}\\.mesh$"
          },
          "bytes": {
            "description": "The file's size.",
            "type": "integer",
            "minimum": 0
          },
          "counts": {
            "type": "object",
            "required": [
              "vertices",
              "triangles",
              "faces"
            ],
            "properties": {
              "vertices": {
                "type": "integer",
                "minimum": 0
              },
              "triangles": {
                "type": "integer",
                "minimum": 0
              },
              "faces": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "sections": {
            "type": "object",
            "required": [
              "positions",
              "normals",
              "uvs",
              "indices",
              "triangle_faces",
              "face_owners"
            ],
            "properties": {
              "positions": {
                "$ref": "#/$defs/mesh_section"
              },
              "normals": {
                "$ref": "#/$defs/mesh_section"
              },
              "uvs": {
                "$ref": "#/$defs/mesh_section"
              },
              "indices": {
                "$ref": "#/$defs/mesh_section"
              },
              "triangle_faces": {
                "$ref": "#/$defs/mesh_section"
              },
